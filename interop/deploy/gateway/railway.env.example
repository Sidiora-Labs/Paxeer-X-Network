# Railway service interop (project layerx, environment beta), image docker/interop-gateway/Dockerfile.
# The image runs as 4020; layerx-env-files writes the file rows below under /run/layerx before exec.
LAYERX_INTEROP_LISTENER=plain
PORT=9443
LAYERX_INTEROP_LISTEN=[::]:9443
LAYERX_INTEROP_CHAIN_ID=125
LAYERX_INTEROP_PROTOCOL_NETWORK_ID=125
LAYERX_INTEROP_WIRE_VERSION=3
LAYERX_INTEROP_TAP_CLOCK_SKEW_SECONDS=60
LAYERX_INTEROP_IDEMPOTENCY_SECONDS=604800
# Same value as the router's LAYERX_GATEWAY_NETWORK_ID; must match the x402_supported network in config.json.
LAYERX_INTEROP_NETWORK_ID=
# Milliseconds, 1 through 30000: the oldest readiness observation /readyz accepts.
LAYERX_INTEROP_READINESS_MAX_AGE_MS=
# HTTPS only (the client refuses http://); the router's TLS listener.
LAYERX_INTEROP_HOSTED_GATEWAY_URL=https://router.railway.internal:9443
# HTTPS only; the kernel receipt authority the router also uses.
LAYERX_INTEROP_RECEIPT_AUTHORITY_URL=https://kernel.paxeer.network:9445
# rediss only (TLS, verified against the outbound CA).
LAYERX_INTEROP_REDIS_URL=rediss://redis-internal.railway.internal:6379
LAYERX_INTEROP_CONFIG=/run/layerx/interop/config.json
LAYERX_INTEROP_MODULE_REGISTRY_FILE=/run/layerx/interop/registry.json
LAYERX_INTEROP_OUTBOUND_CA_DER=/run/layerx/trust/ca.crt.der
LAYERX_INTEROP_CLIENT_IDENTITY_PKCS12=/run/layerx/client/client.p12
LAYERX_INTEROP_CLIENT_IDENTITY_PASSWORD_FILE=/run/layerx/client/password
LAYERX_INTEROP_RECEIPT_AUTHORITY_TOKEN_FILE=/run/layerx/authority/token
LAYERX_INTEROP_SEQUENCER_PUBLIC_KEY_FILE=/run/layerx/authority/sequencer-public-key
LAYERX_INTEROP_SEQUENCER_ID_FILE=/run/layerx/authority/sequencer-id
LAYERX_INTEROP_SEQUENCER_FIRST_BATCH_FILE=/run/layerx/authority/sequencer-first-batch
LAYERX_INTEROP_SEQUENCER_LAST_BATCH_FILE=/run/layerx/authority/sequencer-last-batch
LAYERX_INTEROP_REDIS_USERNAME_FILE=/run/layerx/redis/username
LAYERX_INTEROP_REDIS_PASSWORD_FILE=/run/layerx/redis/password
# Must stay unset with LAYERX_INTEROP_LISTENER=plain (the service refuses either one beside plain).
# LAYERX_INTEROP_TLS_CERT_DER=
# LAYERX_INTEROP_TLS_KEY_DER=
# Optional (unset = migration V2 off): path to an owner-only (0600, owned by 4020) migration profile.
# LAYERX_INTEROP_MIGRATION_V2_CONFIG=
# Healthcheck: GET /readyz on $PORT.
# File secrets as base64 (docker/interop-gateway/files.tsv): render.py output, module registry, CA, client identity, authority and Redis credentials.
INTEROP_CONFIG=
INTEROP_MODULE_REGISTRY=
INTEROP_CLIENT_CA_DER=
INTEROP_CLIENT_P12=
INTEROP_CLIENT_PASSWORD=
INTEROP_AUTHORITY_TOKEN=
INTEROP_SEQUENCER_PUBLIC_KEY=
INTEROP_SEQUENCER_ID=
INTEROP_SEQUENCER_FIRST_BATCH=
INTEROP_SEQUENCER_LAST_BATCH=
INTEROP_REDIS_USERNAME=
INTEROP_REDIS_PASSWORD=
