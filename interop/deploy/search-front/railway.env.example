# Railway service search-front (project layerx, environment beta) from
# docker/search-front/Dockerfile: at least two replicas behind the edge; the
# healthcheck targets GET /healthz on PORT, GET /readyz answers 200 only
# while the selected serving node is ready.
PORT=8080
# Proxies whose X-Forwarded-For hops are trusted (comma separated addresses
# or CIDRs: the edge and Railway's proxy); the client address is the
# rightmost hop outside them. Required.
LAYERX_TRUSTED_PROXIES=
# Base64 of the upstream list tools/bringup/search-front.sh renders
# (split_clients on $xweb_client, $xweb_node and $xweb_eligible); decoded to
# /etc/nginx/search/upstreams.conf at start. Required.
SEARCH_FRONT_UPSTREAMS=
