# Railway service intent-ingester (project layerx, environment beta); one replica, volume at /data.
# Railway volumes mount root-owned; the image runs as 4020, so the service runs with RAILWAY_RUN_UID=0.
RAILWAY_RUN_UID=0
PORT=8490
INGESTER_LISTEN=[::]:8490
INGESTER_STATE_DIR=/data/intent-ingester
INGESTER_INTERVAL_MS=1000
# http:// or https:// node JSON-RPC the precompile logs are read from.
INGESTER_RPC_URL=
# http:// or https:// router JSON-RPC (lx_getSequence, lx_sendActivity).
LAYERX_INGESTER_GATEWAY_URL=
# Router API key with activity scope, sent as `Authorization: LayerX-Key <id>:<secret>`.
LAYERX_INGESTER_GATEWAY_KEY_ID=
LAYERX_INGESTER_GATEWAY_API_KEY=
LAYERX_INGESTER_NETWORK_ID=
LAYERX_INGESTER_FEE_LIMIT=
LAYERX_INGESTER_SIGNER_KEY_FILE=/run/secrets/intent-ingester/signer.key
LAYERX_INGESTER_MARKET_MAP=/run/secrets/intent-ingester/markets.json
# File secrets as base64 (docker/intent-ingester/files.tsv): hex signer seed and market map JSON.
INTENT_INGESTER_SIGNER_KEY=
INTENT_INGESTER_MARKET_MAP=
# Optional (unset = system roots only): PEM bundle path of extra roots (internal CA) for https upstreams.
# LAYERX_INGESTER_CA_BUNDLE=
# Optional.
# LAYERX_INGESTER_PROTOCOL_VERSION=
# INGESTER_START_BLOCK=
# INGESTER_RETENTION_WINDOW=100000
# INGESTER_MAX_RANGE=1000
# INGESTER_RPC_TIMEOUT_MS=10000
# Healthcheck: GET /readyz on $PORT.
