# Railway service gas-station (project layerx, environment beta) from
# docker/gas-station/Dockerfile: one replica, volume at /data, because its
# sponsor nonce and its journals under /data/gas-station have one writer.
# The init supervises the station and the rate publisher over that volume and
# refuses to start while any value below is missing. Railway's healthcheck
# targets GET /healthz on PORT.
PORT=8080
GAS_STATION_LISTEN=[::]:8080
GAS_STATION_CHAIN_ID=125
GAS_STATION_ENDPOINTS=https://api-mainnet-beta.paxeer.network/rpc https://api4.mainnet-beta.paxeer.network https://api5.mainnet-beta.paxeer.network
GAS_STATION_TOKEN=0x21f7b20a555199fa73A238B1a91FD0f549068fEe
GAS_STATION_DECIMALS=6
GAS_STATION_SPREAD_BPS=500
GAS_STATION_RELAYER_KEY_ENV=GAS_STATION_RELAYER_KEY
GAS_STATION_RATE_OWNER_KEY_ENV=GAS_STATION_RATE_OWNER_KEY
GAS_STATION_RATE_CADENCE_SECONDS=120
GAS_STATION_RATE_CONFIRMATION_RETRY_SECONDS=60
GAS_STATION_RATE_MAX_FEE_PER_GAS=2000000000
# Owner policy, set per deploy (no values in the repository).
# Deployed BatchCallAndSponsor address.
GAS_STATION_PAYMASTER=
# Seconds a published paymaster rate stays quotable (1..=300).
GAS_STATION_MAX_RATE_AGE=
GAS_STATION_MARGIN_BPS=
GAS_STATION_PER_QUOTE_LIMIT=
GAS_STATION_PER_ACCOUNT_LIMIT=
GAS_STATION_PER_INTERVAL_LIMIT=
GAS_STATION_INTERVAL_SECONDS=
GAS_STATION_BALANCE_FLOOR=
GAS_STATION_GAS_LIMIT=
GAS_STATION_MAX_PRIORITY_FEE_PER_GAS=
# Gas units per chain day and the PAX base-unit floor of the rate publisher.
GAS_STATION_RATE_GAS_BUDGET_PER_DAY=
GAS_STATION_RATE_BALANCE_FLOOR=
# Comma-separated https origins allowed to call /quote and /submit.
GAS_STATION_BROWSER_ORIGINS=
# Secrets: the sponsor key reaches only the station, the paymaster owner key
# (never the sponsor key) reaches only the publisher.
GAS_STATION_RELAYER_KEY=
GAS_STATION_RATE_OWNER_KEY=
# The owner's rate file is the fixed path /data/gas-station/rate.toml on the
# volume (rate, set_at, optional not_after); the publisher republishes it
# every GAS_STATION_RATE_CADENCE_SECONDS, strictly below max_rate_age.
