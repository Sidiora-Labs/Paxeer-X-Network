# Paxeer X Network explorer — run-time ENV preset.
#
# This file is the tracked source of truth. The container entrypoint reads
# ./configs/envs/.env.$ENVS_PRESET, so a deployment copies this file to
# configs/envs/.env.paxeer-x (dotfile name) and builds with ENVS_PRESET=paxeer-x.
#
# The public explorer is paxscan.io and its API is api.paxscan.io. Link lists
# that the app fetches at run time come from this repository's main branch.

# App
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_APP_HOST=paxscan.io
NEXT_PUBLIC_APP_PORT=3000
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_INSTANCE=paxeer-x

# API
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_HOST=api.paxscan.io
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss

# Chain
NEXT_PUBLIC_NETWORK_NAME=Paxeer X Network
NEXT_PUBLIC_NETWORK_SHORT_NAME=Paxeer X
NEXT_PUBLIC_NETWORK_ID=125
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Paxeer
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=PAX
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=validation
NEXT_PUBLIC_IS_TESTNET=false

# Branding
NEXT_PUBLIC_NETWORK_LOGO=file:///app/public/static/paxeer-x/logo.svg
NEXT_PUBLIC_NETWORK_LOGO_DARK=file:///app/public/static/paxeer-x/logo-dark.svg
NEXT_PUBLIC_NETWORK_ICON=file:///app/public/static/paxeer-x/icon.svg
NEXT_PUBLIC_NETWORK_ICON_DARK=file:///app/public/static/paxeer-x/icon-dark.svg
NEXT_PUBLIC_COLOR_THEME_OVERRIDES={'bg':{'primary':{'_light':{'value':'#F8F9FC'},'_dark':{'value':'#121317'}},'surface':{'_light':{'value':'#FFFFFF'},'_dark':{'value':'#18191D'}},'sunken':{'_light':{'value':'#EFF2F7'},'_dark':{'value':'#212226'}},'overlay':{'_light':{'value':'#FFFFFF'},'_dark':{'value':'#212226'}}},'text':{'primary':{'_light':{'value':'#121317'},'_dark':{'value':'#F8F9FC'}},'secondary':{'_light':{'value':'#45474D'},'_dark':{'value':'#B2BBC5'}},'muted':{'_light':{'value':'#45474D'},'_dark':{'value':'#B2BBC5'}}},'border':{'divider':{'_light':{'value':'rgba(33, 34, 38, 0.12)'},'_dark':{'value':'rgba(230, 234, 240, 0.12)'}},'strong':{'_light':{'value':'#BDC1C6'},'_dark':{'value':'#45474D'}}},'accent':{'primary':{'_light':{'value':'#2B4FDA'},'_dark':{'value':'#9DD2FF'}},'strong':{'_light':{'value':'#1E2867'},'_dark':{'value':'#DCF1FF'}},'soft':{'_light':{'value':'#DCF1FF'},'_dark':{'value':'#1E2867'}}},'hover':{'_light':{'value':'#1E2867'},'_dark':{'value':'#DCF1FF'}},'selected':{'control':{'text':{'_light':{'value':'#121317'},'_dark':{'value':'#F8F9FC'}},'bg':{'_light':{'value':'#E6EAF0'},'_dark':{'value':'#2F3034'}}},'option':{'bg':{'_light':{'value':'#2B4FDA'},'_dark':{'value':'#3C90FF'}}}},'icon':{'primary':{'_light':{'value':'#45474D'},'_dark':{'value':'#B2BBC5'}},'secondary':{'_light':{'value':'#80868B'},'_dark':{'value':'#80868B'}}},'button':{'primary':{'_light':{'value':'#121317'},'_dark':{'value':'#F8F9FC'},'text':{'_light':{'value':'#FFFFFF'},'_dark':{'value':'#121317'}},'hover':{'_light':{'value':'#2B2D31'},'_dark':{'value':'#DEDFE2'}}}},'link':{'primary':{'_light':{'value':'#2B4FDA'},'_dark':{'value':'#9DD2FF'}}},'graph':{'line':{'_light':{'value':'#2B4FDA'},'_dark':{'value':'#9DD2FF'}},'gradient':{'start':{'_light':{'value':'rgba(43, 79, 218, 0.3)'},'_dark':{'value':'rgba(157, 210, 255, 0.3)'}},'stop':{'_light':{'value':'rgba(43, 79, 218, 0)'},'_dark':{'value':'rgba(157, 210, 255, 0)'}}}},'navigation':{'bg':{'selected':{'_light':{'value':'#EFF2F7'},'_dark':{'value':'#212226'}}},'text':{'selected':{'_light':{'value':'#121317'},'_dark':{'value':'#F8F9FC'}}}},'stats':{'bg':{'_light':{'value':'#FFFFFF'},'_dark':{'value':'#18191D'}}},'topbar':{'bg':{'_light':{'value':'#FFFFFF'},'_dark':{'value':'#18191D'}}},'tabs':{'text':{'primary':{'_light':{'value':'#121317'},'_dark':{'value':'#F8F9FC'}}}},'table':{'header':{'bg':{'_light':{'value':'#F8F9FC'},'_dark':{'value':'#212226'}},'fg':{'_light':{'value':'#45474D'},'_dark':{'value':'#B2BBC5'}}}},'feedback':{'success':{'fg':{'_light':{'value':'#005143'},'_dark':{'value':'#9BE69A'}},'bg':{'_light':{'value':'#DAF9D4'},'_dark':{'value':'#005143'}}},'error':{'fg':{'_light':{'value':'#BE1C1B'},'_dark':{'value':'#FFACC2'}},'bg':{'_light':{'value':'#FFEEF7'},'_dark':{'value':'#990D0E'}}},'warning':{'fg':{'_light':{'value':'#9E3D02'},'_dark':{'value':'#FFF350'}},'bg':{'_light':{'value':'#FCFFAD'},'_dark':{'value':'#9E3D02'}}}}}
NEXT_PUBLIC_COLOR_THEME_DEFAULT=light
NEXT_PUBLIC_FONT_FAMILY_HEADING={'name':'Manrope','url':'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap'}
NEXT_PUBLIC_FONT_FAMILY_BODY={'name':'Manrope','url':'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap'}

# Meta
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false
NEXT_PUBLIC_OG_DESCRIPTION=Explorer for Paxeer X Network: blocks, transactions, accounts, contracts and the LayerX kernel domain.

# Navigation — the scan layout puts the menu in the brand row above the content
NEXT_PUBLIC_NAVIGATION_LAYOUT=horizontal
# The external links this deployment carries
NEXT_PUBLIC_OTHER_LINKS=[{'text':'Paxeer X Network','url':'https://paxeer.network'},{'text':'Docs','url':'https://docs.paxeer.app'},{'text':'GitHub','url':'https://github.com/Sidiora-Labs/Paxeer-X-Network'}]

NEXT_PUBLIC_FOOTER_LINKS=https://raw.githubusercontent.com/Sidiora-Labs/Paxeer-X-Network/main/explorer/frontend/configs/paxeer-x/footer.json

# Homepage
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_HOMEPAGE_STATS=['total_blocks','average_block_time','total_txs','wallet_addresses','gas_tracker']

# Misc — no market data source is configured for the native coin
NEXT_PUBLIC_HIDE_NATIVE_COIN_PRICE=true

# Disabled third-party surfaces
NEXT_PUBLIC_MARKETPLACE_ENABLED=false
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none

# Paxeer X unified surfaces
NEXT_PUBLIC_PAXEER_X_ENABLED=true
