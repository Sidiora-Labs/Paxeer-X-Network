# Backend (Blockscout release) environment for the local stack.
#
# docker-compose.local.yml reads this file verbatim and then overrides the
# wiring that depends on the compose network: DATABASE_URL, the four
# ETHEREUM_JSONRPC_* endpoints, the two MICROSERVICE_* URLs, CHAIN_ID,
# SECRET_KEY_BASE and PORT. Do not set those here; set CHAIN_ID,
# SECRET_KEY_BASE, RPC_HTTP_URL and RPC_WS_URL in the host environment.
#
# Every name used below also exists in
# explorer/backend/docker-compose/envs/common-blockscout.env, which is the
# upstream catalogue of every backend variable.
#
# One more name belongs to the deployment rather than to the release and is
# therefore not set here: EXPLORER_IMAGE_TAG picks which published image runs.
# It is the tag of ghcr.io/sidiora-labs/paxeer-x-explorer-backend, the image
# .github/workflows/explorer-images.yml publishes - `latest` or `main` for the
# main branch, `sha-<short commit>` to pin one build. docker-compose.local.yml
# defaults it to `latest`; on Railway it is part of the service's image source.
#
# No value in this file is an endpoint, a credential or a host. Each of those
# enters through the host environment or the deployment's variable store.

# --- chain identity -------------------------------------------------------
# The chain type names the Paxeer X Network feature set the release runs: the
# unified account, anchor, receipt, capability and transaction-status surfaces
# and the lx_* import runners behind them.
CHAIN_TYPE=paxeer_x

# --- node and transport ---------------------------------------------------
# paxeer_x is the Paxeer X Network adapter: it maps the Cosmos-originated
# transaction type into the transactions.type column, refetches a new head by
# hash instead of trusting the notification, and reads eth_syncing's refusal as
# synced. Tracing is delegated to the geth variant unchanged.
ETHEREUM_JSONRPC_VARIANT=paxeer_x
PAXEER_X_COSMOS_TRANSACTION_TYPE=127
PAXEER_X_NATIVE_COIN_DECIMALS=18
# JSON-RPC requests always travel over HTTP, also when the node is reached
# through a wss:// endpoint. TRANSPORT accepts http or ipc only and the release
# refuses to boot on any other value (ws and wss included). The HTTP endpoints
# (ETHEREUM_JSONRPC_HTTP_URL, _TRACE_URL, _ETH_CALL_URL and their _URLS and
# FALLBACK_ forms) must be http:// or https://; a ws:// or wss:// value there
# also stops the boot, because every eth_call on it - token names, symbols,
# decimals and tokenURI metadata among them - would fail. The ws:// or wss://
# endpoint belongs in ETHEREUM_JSONRPC_WS_URL, which only carries the newHeads
# subscription. A node that offers only wss:// cannot be indexed: give the
# explorer its https:// JSON-RPC endpoint as well.
ETHEREUM_JSONRPC_TRANSPORT=http
ETHEREUM_JSONRPC_DISABLE_ARCHIVE_BALANCES=true
ETHEREUM_JSONRPC_HTTP_TIMEOUT=30

# --- node request guard ---------------------------------------------------
# The explorer indexes one full node, so every request it makes passes a
# per-endpoint guard: a global in-flight cap, a per-second token bucket, and
# tighter caps for tracing and for historical state reads. Callers that cannot
# be admitted queue in arrival order; nothing is dropped.
ETHEREUM_JSONRPC_THROTTLE_MAX_INFLIGHT=32
ETHEREUM_JSONRPC_THROTTLE_RPS=200
ETHEREUM_JSONRPC_THROTTLE_TRACE_MAX_INFLIGHT=4
ETHEREUM_JSONRPC_THROTTLE_ARCHIVE_MAX_INFLIGHT=8
ETHEREUM_JSONRPC_THROTTLE_COALESCE_ENABLED=true
# The guard keys its budget by endpoint URL, and with the API and the indexer in
# one release the API's eth_call requests (token metadata, contract reads) queue
# behind catchup batches on the same URL. Pointing ETHEREUM_JSONRPC_ETH_CALL_URL
# at a second endpoint of the node gives those calls their own budget.
# Back-off the request coordinator applies before a call whose method has timed
# out recently, multiplied by the number of recent timeouts. A node that is slow
# to answer therefore holds every caller that asks it, which is why nothing in
# the supervision tree may ask it before it reports started.
ETHEREUM_JSONRPC_WAIT_PER_TIMEOUT=20s

# --- Paxeer X surfaces ----------------------------------------------------
# Capability discovery probes eth_getCode at the LayerX precompiles and one
# eth_call at the addr precompile, so a surface is offered only once the chain
# actually carries it. It is off here and stays off until a deployment turns it
# on: the probe costs one batch against the node on every refresh, and with it
# off every surface reads as absent, which is what the chain answers today.
# The settlement ladder turns the anchor's checkpoints into the sealed and
# final rungs; PAXEER_X_FINAL_CONFIRMATIONS is the confirmation-count fallback
# for the final rung and 0 leaves it off.
PAXEER_X_CAPABILITIES_ENABLED=false
PAXEER_X_CAPABILITIES_REFRESH_SECONDS=30
PAXEER_X_FINALITY_CACHE_MS=1000
PAXEER_X_FINALITY_PROBE_BATCHES=16
PAXEER_X_FINAL_CONFIRMATIONS=0

# --- database pools -------------------------------------------------------
POOL_SIZE=40
POOL_SIZE_API=20
ECTO_USE_SSL=false

# --- web endpoint ---------------------------------------------------------
NETWORK=Paxeer X Network
SUBNETWORK=Paxeer X Network
DISABLE_WEBAPP=true
API_V2_ENABLED=true
API_V1_READ_METHODS_DISABLED=false
API_V1_WRITE_METHODS_DISABLED=false
ADMIN_PANEL_ENABLED=false
API_RATE_LIMIT_DISABLED=true
RE_CAPTCHA_DISABLED=true
CHECKSUM_ADDRESS_HASHES=true

# --- native coin ----------------------------------------------------------
# COIN and COIN_NAME are display labels; the ledger denomination and its
# scaling are a property of the chain, not of the explorer.
COIN=PAX
COIN_NAME=PAX
DISABLE_MARKET=true
COIN_BALANCE_HISTORY_DAYS=90

# --- indexer --------------------------------------------------------------
DISABLE_INDEXER=false
DISABLE_REALTIME_INDEXER=false
DISABLE_CATCHUP_INDEXER=false
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_BLOCK_REWARD_FETCHER=true
INDEXER_DISABLE_ARCHIVAL_TOKEN_BALANCES_FETCHER=true
INDEXER_DISABLE_WITHDRAWALS_FETCHER=true
INDEXER_MEMORY_LIMIT=4Gb
# The chain produces blocks several times a second; these are the fork's own
# defaults, large enough for catchup to outrun the head.
INDEXER_CATCHUP_BLOCKS_BATCH_SIZE=100
INDEXER_CATCHUP_BLOCKS_CONCURRENCY=20
# The node keeps trace state for the last 10000 blocks, so pending operations
# below head minus this window are dropped instead of retried forever. 0
# disables the rule.
INDEXER_INTERNAL_TRANSACTIONS_LOOKBACK_BLOCKS=9000
INDEXER_RECEIPTS_BATCH_SIZE=250
INDEXER_RECEIPTS_CONCURRENCY=10
INDEXER_COIN_BALANCES_BATCH_SIZE=500
INDEXER_COIN_BALANCES_CONCURRENCY=4

# --- microservices --------------------------------------------------------
MICROSERVICE_SC_VERIFIER_ENABLED=true
MICROSERVICE_SC_VERIFIER_TYPE=sc_verifier
MICROSERVICE_SIG_PROVIDER_ENABLED=true
MICROSERVICE_VISUALIZE_SOL2UML_ENABLED=false
MICROSERVICE_ACCOUNT_ABSTRACTION_ENABLED=false
MICROSERVICE_BENS_ENABLED=false
# The metadata service supplies the public address tags shown on every list
# page and the proxy under /api/v2/proxy/metadata. Setting ENABLED=true also
# requires MICROSERVICE_METADATA_URL to be the service's http:// or https://
# base URL without the /api/v1 suffix (the backend appends it); the release
# refuses to boot when it is missing or malformed instead of answering 501
# "Service is disabled". The frontend reads the same service directly through
# NEXT_PUBLIC_METADATA_SERVICE_API_HOST. The block, transaction and token
# transfer lists wait for the tag lookup before they answer, so
# MICROSERVICE_METADATA_REQUESTS_TIMEOUT bounds what a slow or unreachable
# service adds to each list request; the tags are left out when it expires.
# MICROSERVICE_METADATA_PROXY_REQUESTS_TIMEOUT bounds the proxy calls alone.
# A 501 from /api/v2/proxy/account-abstraction/status is the expected answer
# while MICROSERVICE_ACCOUNT_ABSTRACTION_ENABLED is false; the explorer frontend
# never requests it. METADATA_CONTRACT and VALIDATORS_CONTRACT are unrelated:
# they read validator metadata from POA contracts and stay unset on this chain.
MICROSERVICE_METADATA_ENABLED=false
MICROSERVICE_METADATA_REQUESTS_TIMEOUT=1s
MICROSERVICE_METADATA_PROXY_REQUESTS_TIMEOUT=30s

# --- accounts and media ---------------------------------------------------
ACCOUNT_ENABLED=false
NFT_MEDIA_HANDLER_ENABLED=false

# --- runtime --------------------------------------------------------------
DISABLE_FILE_LOGGING=true
HEART_BEAT_TIMEOUT=30
TXS_STATS_DAYS_TO_COMPILE_AT_INIT=10
