ARG NODE_IMAGE=node@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
FROM ${NODE_IMAGE} AS build
RUN apk add --no-cache gcompat=1.1.0-r4 python3=3.14.8-r0 make=4.4.1-r4 g++=15.2.0-r5 && npm install -g pnpm@9.15.0
WORKDIR /src/client
ENV NEXT_TELEMETRY_DISABLED=1 CI=1
COPY security/control/cap-admission.ts /src/security/control/cap-admission.ts
COPY client/ /src/client/
RUN pnpm install --frozen-lockfile
RUN pnpm build:packages
ARG NEXT_PUBLIC_DATA_API_URL
ARG NEXT_PUBLIC_GATEWAY_URL
ARG NEXT_PUBLIC_METADATA_API_URL
ARG NEXT_PUBLIC_PNL_API_URL
ARG NEXT_PUBLIC_STATS_API_URL
ARG NEXT_PUBLIC_RPC_URL
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ARG NEXT_PUBLIC_LIVESTREAM_API_URL
ARG NEXT_PUBLIC_WALLET_IFRAME_ORIGIN
ARG NEXT_PUBLIC_RPC_URL_FALLBACK
ARG NEXT_PUBLIC_PAXEER_RPC_URL
ARG NEXT_PUBLIC_CANONICAL_ORIGIN
ARG NEXT_PUBLIC_STREAM_ORIGIN
ARG NEXT_PUBLIC_PRIVATE_API_ORIGIN
ARG NEXT_PUBLIC_PRIVATE_STREAM_ORIGIN
ARG NEXT_PUBLIC_EXPLORER_API
ARG NEXT_PUBLIC_PAXEER_WALLET_API
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_AUTH_REDIRECT_URL
ARG WEB_GATEWAY_UPSTREAM
ARG WEB_API_UPSTREAM
ARG WEB_CHARTS_UPSTREAM
ARG WEB_SOCKETS_UPSTREAM
ARG NEXT_PUBLIC_ACTION_ENVIRONMENT
ARG NEXT_PUBLIC_SOCIAL_WRITE_PREFIX
ARG NEXT_PUBLIC_SOCIAL_WS_PATH
ARG NEXT_PUBLIC_ANALYTICS_KEY
ARG NEXT_PUBLIC_MARKET_SOCIAL_ORIGINS
ARG NEXT_PUBLIC_PRIVATE_QUALIFICATION_AUTHORITY_PROFILE
ARG NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_SENTRY_ENV
ARG NEXT_PUBLIC_SENTRY_RELEASE
ARG NEXT_PUBLIC_SENTRY_REPLAY_ERROR_SAMPLE_RATE
ARG NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE
ARG NEXT_PUBLIC_SOCIAL_API_URL
ARG NEXT_PUBLIC_USER_API_URL
COPY deploy/web-build-env.sh /src/web-build-env.sh
RUN . /src/web-build-env.sh && pnpm --filter @sidiora/web build

FROM ${NODE_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build --chown=65532:65532 /src/client/apps/web/.next/standalone ./
COPY --from=build --chown=65532:65532 /src/client/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=65532:65532 /src/client/apps/web/public ./apps/web/public
USER 65532:65532
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
