{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/Dockerfile.svc",
    "watchPatterns": [
      "/launchpad/media/gateway/**",
      "/launchpad/shared/**",
      "/launchpad/protocol/**",
      "/launchpad/security/control/**",
      "/launchpad/security/supplychain/**",
      "/launchpad/deploy/Dockerfile.svc"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
