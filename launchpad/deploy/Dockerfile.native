ARG BUILD_IMAGE
ARG RUNTIME_IMAGE
ARG SOURCE_DATE_EPOCH=0
FROM ${BUILD_IMAGE} AS build
WORKDIR /src
ARG SERVICE
ARG BIN
COPY . .
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOWORK=off GOFLAGS=-mod=readonly SOURCE_DATE_EPOCH=0 GOMAXPROCS=2 GOCACHE=/tmp/build-cache GOMODCACHE=/tmp/mod-cache
RUN cd security/supplychain && python3 -c 'import sys; from build import NATIVE_TARGETS; sys.exit(0 if NATIVE_TARGETS.get(sys.argv[1])==sys.argv[2] else "unrecognized service/binary")' "$SERVICE" "$BIN" && cd /src && test "$(go env GOVERSION)" = "go1.26.4"
RUN cd "$SERVICE" && sha256sum go.mod go.sum > /tmp/module-graph.sha256 && go mod download && go mod verify && sha256sum -c /tmp/module-graph.sha256
RUN cd "$SERVICE" && go build -p 1 -mod=readonly -trimpath -buildvcs=false -ldflags="-s -w -buildid=" -o /out/app "./cmd/${BIN}" && sha256sum -c /tmp/module-graph.sha256
RUN python3 -c 'import ast,pathlib; source=ast.parse(pathlib.Path("security/supplychain/confinement.py").read_text()); value=next(n.value for n in source.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=="PROBE_SOURCE" for t in n.targets)); pathlib.Path("/tmp/runtime-probe.go").write_text(ast.literal_eval(value))' && cd /tmp && GOWORK=off GO111MODULE=off GOFLAGS= go build -p 1 -trimpath -buildvcs=false -ldflags="-s -w -buildid=" -o /out/confinement-probe runtime-probe.go
FROM ${RUNTIME_IMAGE} AS runtime
WORKDIR /app
COPY --from=build --chown=65532:65532 /out/app /app/app
USER 65532:65532
ENTRYPOINT ["/app/app"]
FROM runtime AS confinement
COPY --from=build --chown=65532:65532 /out/confinement-probe /app/confinement-probe
FROM runtime AS release
