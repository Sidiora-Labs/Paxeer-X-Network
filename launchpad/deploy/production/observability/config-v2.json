{
  "version": "2.0",
  "revision": 2,
  "environment": "qualification",
  "zones": [
    "zone-a",
    "zone-b",
    "zone-c"
  ],
  "services": [
    "apid_rest",
    "apid_sockets",
    "indexerd",
    "chartsd",
    "statsd",
    "pnld",
    "rankingd",
    "mediagatewayd",
    "userd",
    "sociald",
    "metadatad",
    "livestreamd"
  ],
  "series_per_instance": 20000,
  "success_sample_percent": 1,
  "failure_queue_mib": 512,
  "retention_days": 14,
  "exporter": {
    "endpoint_env": "OTEL_EXPORTER_OTLP_ENDPOINT",
    "ca_env": "OTEL_CA_FILE",
    "cert_env": "OTEL_CERT_FILE",
    "key_env": "OTEL_KEY_FILE"
  },
  "probes": [
    {
      "journey": "browse",
      "interval_seconds": 30,
      "timeout_seconds": 5,
      "economic_write": false,
      "identity": "nonprivileged-synthetic"
    },
    {
      "journey": "quote",
      "interval_seconds": 30,
      "timeout_seconds": 5,
      "economic_write": false,
      "identity": "nonprivileged-synthetic"
    },
    {
      "journey": "wallet_challenge",
      "interval_seconds": 30,
      "timeout_seconds": 5,
      "economic_write": false,
      "identity": "nonprivileged-synthetic"
    },
    {
      "journey": "metadata",
      "interval_seconds": 30,
      "timeout_seconds": 5,
      "economic_write": false,
      "identity": "nonprivileged-synthetic"
    },
    {
      "journey": "websocket_replay",
      "interval_seconds": 30,
      "timeout_seconds": 5,
      "economic_write": false,
      "identity": "nonprivileged-synthetic"
    }
  ],
  "alerts": [
    {
      "name": "read_burn_critical",
      "severity": "critical",
      "owner": "platform-oncall",
      "commander": "incident-commander",
      "runbook": "availability",
      "ack_seconds": 300,
      "update_seconds": 900
    },
    {
      "name": "read_burn_warning",
      "severity": "warning",
      "owner": "platform-oncall",
      "commander": "incident-commander",
