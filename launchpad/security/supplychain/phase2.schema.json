{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sidiora.dev/supplychain/release-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "provenance",
    "sboms",
    "scan",
    "build"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "workflow",
        "sbom",
        "image",
        "repository",
        "builder",
        "run_id",
        "ref",
        "issued",
        "expires",
        "event",
        "fork",
        "scanner_status",
        "vulnerabilities",
        "checks"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "workflow": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sbom": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "builder": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "issued": {
          "type": "integer",
          "minimum": 0
        },
        "expires": {
          "type": "integer",
          "minimum": 0
        },
        "event": {
          "const": "push"
        },
        "fork": {
          "const": false
        },
        "scanner_status": {
          "const": "success"
        },
        "vulnerabilities": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "severity",
              "reachable",
              "analysis"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "reachable": {
                "type": "boolean"
              },
              "analysis": {
                "type": "string",
                "minLength": 1
              },
              "exception": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "issued",
                  "expires",
                  "approved_by",
                  "controls"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "issued": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "expires": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "approved_by": {
                    "type": "string",
                    "minLength": 1
                  },
                  "controls": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verify",
            "contracts",
            "frontend",
            "policy",
            "scan",
            "signing"
          ],
          "properties": {
            "verify": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "result",
                "source"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "result": {
                  "const": "success"
                },
                "source": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "contracts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "result",
                "source"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "result": {
                  "const": "success"
                },
                "source": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "frontend": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "result",
                "source"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "result": {
                  "const": "success"
                },
                "source": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "policy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "result",
                "source"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "result": {
                  "const": "success"
                },
                "source": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "scan": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "result",
                "source"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "result": {
                  "const": "success"
                },
                "source": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "signing": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "result",
                "source"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "result": {
                  "const": "success"
                },
                "source": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "_type",
        "subject",
        "predicateType",
        "predicate"
      ],
      "properties": {
        "_type": {
          "const": "https://in-toto.io/Statement/v1"
        },
        "predicateType": {
          "const": "https://slsa.dev/provenance/v1"
        },
        "subject": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1
        },
        "predicate": {
          "type": "object"
        }
      }
    },
    "sboms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "sha256",
          "document"
        ],
        "properties": {
          "scope": {
            "enum": [
              "image",
              "javascript"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "document": {
            "type": "object"
          }
        }
      }
    },
    "scan": {
      "type": "object",
      "required": [
        "scanner_status",
        "tool_sha256",
        "database_sha256",
        "scanned_at",
        "image",
        "vulnerabilities"
      ],
      "properties": {
        "scanner_status": {
          "const": "success"
        },
        "tool_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "database_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scanned_at": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "vulnerabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "severity",
              "reachable",
              "analysis"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "reachable": {
                "type": "boolean"
              },
              "analysis": {
                "type": "string",
                "minLength": 1
              },
              "exception": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "issued",
                  "expires",
                  "approved_by",
                  "controls"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "issued": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "expires": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "approved_by": {
                    "type": "string",
                    "minLength": 1
                  },
                  "controls": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "source",
        "image",
        "binary_sha256",
        "service",
        "binary",
        "architecture"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "binary": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
