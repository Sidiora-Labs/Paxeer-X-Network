{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": [
      "../../apps/web/node_modules/@types"
    ],
    "paths": {
      "react": [
        "../../apps/web/node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "../../apps/web/node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "@/*": [
        "../../apps/web/src/*"
      ]
    }
  },
  "include": [
    "../../apps/web/src/widgets/profile/account-disclosure.ts",
    "../../apps/web/src/widgets/profile/account-disclosure-view.tsx",
    "../../apps/web/src/widgets/pnl/share-disclosure.ts",
    "../../apps/web/src/widgets/pnl/share-disclosure-preview.tsx",
    "../../apps/web/src/widgets/rewards/reward-disclosure.ts",
    "../../apps/web/src/widgets/profile/account-transport.ts",
    "../../apps/web/src/widgets/profile/use-account-session.ts",
    "../../apps/web/src/widgets/profile/profile-edit-state.ts",
    "../../apps/web/src/widgets/profile/watchlist-state.ts",
    "../../apps/web/src/widgets/profile/profile-edit-modal.tsx",
    "../../apps/web/src/widgets/profile/profile-view.tsx",
    "../../apps/web/src/widgets/profile/positions-tab.tsx",
    "../../apps/web/src/widgets/profile/referrals-tab.tsx",
    "../../apps/web/src/widgets/rewards/reward-claim-state.ts",
    "../../apps/web/src/hooks/ui/use-watchlist.ts",
    "../../apps/web/src/widgets/home/watchlist-grid.tsx",
    "../../apps/web/src/widgets/pnl/share-publication-state.ts",
    "../../apps/web/src/widgets/pnl/use-card-minter.ts",
    "../../apps/web/src/widgets/pnl/pnl-card-landing.tsx",
    "../../apps/web/src/widgets/profile/account-preferences.tsx",
    "../../apps/web/src/widgets/profile/use-private-account-query.ts",
    "../../apps/web/src/widgets/profile/net-worth-chart.tsx",
    "../../apps/web/src/widgets/pnl/share-transport.ts",
    "../../apps/web/src/widgets/pnl/share-pnl-modal.tsx",
    "../../apps/web/src/widgets/pnl/share-pnl-button.tsx",
    "../../apps/web/src/app/pnl/[cardId]/page.tsx",
    "../../apps/web/src/app/api/og/pnl/[cardId]/route.ts"
  ]
}
