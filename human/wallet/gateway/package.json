{
  "name": "@paxeer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paxeer Embedded Wallet API — Fastify backend signs and broadcasts on Paxeer. Zero runtime dependency on Supabase.",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: TODO (eslint config)'"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/sensible": "^6.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "^5.0.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino-pretty": "^11.2.2",
    "viem": "^2.21.19",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
