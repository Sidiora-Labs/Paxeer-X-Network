{
  "name": "@paxeer/wallet",
  "version": "0.1.0",
  "description": "Paxeer Universal Embedded Wallet SDK \u2014 drop-in for any Paxeer app. Email/social sign-in via Supabase, transparent server-side signing, no popups.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "pnpm run build:agent-sdk && tsc -p tsconfig.json",
    "build:agent-sdk": "npm --prefix ../../../agent/sdk/typescript ci --no-audit --no-fund && npm --prefix ../../../agent/sdk/typescript run build",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "pnpm run build:agent-sdk && vitest run",
    "typecheck": "pnpm run build:agent-sdk && tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: TODO (eslint config)'"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "dependencies": {
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "@sidiora/layerx-sdk": "link:../../../agent/sdk/typescript",
    "@supabase/supabase-js": "^2.45.4",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "react": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
