{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/types/*": [
        "./src/types/*"
      ],
      "@/core/*": [
        "./src/core/*"
      ],
      "@/hooks/*": [
        "./src/hooks/*"
      ],
      "@/ui/*": [
        "./src/ui/*"
      ],
      "@/widgets/*": [
        "./src/widgets/*"
      ],
      "@/page-modules/*": [
        "./src/page-modules/*"
      ],
      "@/app/*": [
        "./src/app/*"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "ui-storybook",
    "src/components/paxeer"
  ]
}
