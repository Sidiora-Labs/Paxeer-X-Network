# Hyperpax-UI production environment.
#
# Copy this file to .env.production at the repo root and edit values.
# .env.production is git-ignored.
#
# Two categories of variables exist:
#
# 1. NEXT_PUBLIC_*   — baked into the client JS bundle at build time.
#                       Changing these requires a fresh build (rerun deploy.sh).
#                       Anything in here is visible to anyone who loads the app.
#                       DO NOT put service-role keys or secrets here.
#
# 2. Server-only     — read at runtime by the Next.js server (API routes).
#                       Changing these only requires a container restart, not a rebuild.
#                       Safe to put secrets here.
#
# Values pre-filled below are the public production defaults that ship
# with the open-source app (block-explorer URLs, Paxeer Wallet API,
# Supabase anon/publishable key). They are intentionally not secrets —
# the publishable Supabase key authorizes anonymous reads and is
# validated server-side by the wallet API. Override only if you are
# pointing at your own infrastructure.

# ─── 1. NEXT_PUBLIC_* (build-time, client-visible) ─────────────────

# Primary RPC endpoint used by viem clients (mandatory).
NEXT_PUBLIC_PAXEER_RPC_URL=https://api1.mainnet-beta.paxeer.network

# Optional comma-separated list of fallback RPC endpoints. viem will
# rank by latency. Leave empty to use all 16 built-in mainnet-beta nodes.
NEXT_PUBLIC_PAXEER_RPC_URLS=

# Admin dashboard WebSocket for the network-status pill. If unset,
# the app falls back to eth_blockNumber polling.
NEXT_PUBLIC_NETWORK_STATUS_WS_URL=

# Logger level: "error" | "warn" | "info" | "debug". Production should
# be "warn" or "error" to keep noise out of the browser console.
NEXT_PUBLIC_LOG_LEVEL=warn

# Perps gateway origin (REST, WebSocket and GraphQL), mandatory.
NEXT_PUBLIC_PERPS_GATEWAY_URL=

# Chainflow market feed host. Leave empty for the built-in default.
NEXT_PUBLIC_MARKET_PROXY_HOST=

# Optional precompile address overrides for a local node. Leave empty
# for the release addresses.
NEXT_PUBLIC_PERPS_PRECOMPILE=
NEXT_PUBLIC_LAUNCHPAD_PRECOMPILE=
NEXT_PUBLIC_PECOR_MARKET_PRECOMPILE=
NEXT_PUBLIC_PECOR_ORDERS_PRECOMPILE=
NEXT_PUBLIC_PECOR_STOP_PRECOMPILE=
NEXT_PUBLIC_PECOR_QUOTER_PRECOMPILE=
NEXT_PUBLIC_PECOR_VAULT_PRECOMPILE=

# Spot release gate. 1 opens the spot route, its navigation entry and
# the markets spot mode; leave empty until post-rollout verification
# passes.
NEXT_PUBLIC_RELEASE_SPOT_OPEN=

# Paxscan block explorer endpoints (used for tx links and history).
NEXT_PUBLIC_PAXSCAN_API_URL=
NEXT_PUBLIC_PAXSCAN_WS_URL=
NEXT_PUBLIC_PAXSCAN_BASE_URL=https://paxscan.io

# Embedded wallet (Paxeer Wallet) API. Default points at the hosted
# production signer. Override only when running your own
# paxeer-embedded-wallet stack.
NEXT_PUBLIC_PAXEER_WALLET_API=https://connect.paxportwallet.com

# Supabase project backing the embedded wallet. The publishable key is
# the *anon* key — it is safe to expose in a client bundle and is what
# every Paxeer surface uses to talk to Supabase auth.
#
# If either of these is empty, the embedded-wallet sign-in section is
# hidden in the connect modal and users can only use injected wallets.
NEXT_PUBLIC_SUPABASE_URL=https://zezsqawedbikldiedlse.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable__EwIhZS4GjU0p7Ikom70dw_Ierj1Cey

# OAuth redirect URL — the embedded-wallet sign-in flow redirects here
# after completion. Must match a value registered with Supabase.
# Defaults to `${window.location.origin}/auth/callback` when blank,
# which works for any single-host deployment. Set it explicitly if you
# serve the app behind multiple hostnames.
NEXT_PUBLIC_AUTH_REDIRECT_URL=

# Trusted origin for postMessage to the wallet iframe (anti-spoof).
NEXT_PUBLIC_WALLET_IFRAME_ORIGIN=

# ─── 2. Server-only (runtime, can hold secrets) ─────────────────────

# Candle proxy upstream (the actual market data API the
# /api/candle/[...path] route forwards to).
PERPS_CANDLE_URL=

# Hostname allowlist for the candle proxy — set this to the host portion
# of PERPS_CANDLE_URL. Anything else gets rejected by the proxy as a
# defense against host-header forgery / SSRF.
MARKET_PROXY_HOST=data.feed.chainflowtrading.com

# ─── 3. Build metadata ──────────────────────────────────────────────

# Auto-populated by deploy.sh from `git rev-parse --short HEAD`. You
# don't need to set this manually unless you're building outside the
# deploy.sh path.
# BUILD_COMMIT_SHA=
