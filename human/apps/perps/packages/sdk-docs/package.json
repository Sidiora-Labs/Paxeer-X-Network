    "./src/version": "./src/version.ts",
    "./src/mcp-cli": "./src/mcp-cli.ts",
    "./src/facade": "./src/facade.ts",
    "./src/searchDocs": "./src/searchDocs.ts",
    "./src/componentDoc": "./src/componentDoc.ts",
    "./src/constants": "./src/constants.ts",
    "./src/bundle": "./src/bundle.ts",
    "./src/exactLookup": "./src/exactLookup.ts",
    "./src/narrative/qmdAdapter": "./src/narrative/qmdAdapter.ts",
