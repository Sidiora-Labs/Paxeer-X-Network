{
  "name": "@paxeer-network/sdk-docs",
  "version": "1.2.2",
  "type": "module",
  "description": "paxeer-network SDK documentation runtime: MCP server, exact indexes, and narrative (QMD) retrieval",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "paxeer-network-sdk-docs-mcp": "./dist/mcp-cli.js"
  },
  "files": [
    "dist",
    "bundled"
  ],
  "scripts": {
    "sync:bundle": "node scripts/sync-bundled-generated.mjs",
    "build": "pnpm run sync:bundle && tsup",
    "dev": "tsup --watch",
    "start:mcp": "node dist/mcp-cli.js",
    "smoke": "pnpm run build && node scripts/smoke.mjs",
    "exercise": "pnpm run build && node scripts/exercise-facade.mjs",
    "search-nl": "pnpm run build && node scripts/search-nl.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tobilu/qmd": "^2.5.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./paths": "./src/paths.ts",
    "./envelope": "./src/envelope.ts",
    "./entityResolve": "./src/entityResolve.ts",
    "./narrativeDocs": "./src/narrativeDocs.ts",
    "./types": "./src/types.ts",
    "./fetchSdkSource": "./src/fetchSdkSource.ts",
    "./index": "./src/index.ts",
    "./version": "./src/version.ts",
    "./mcp-cli": "./src/mcp-cli.ts",
    "./facade": "./src/facade.ts",
    "./searchDocs": "./src/searchDocs.ts",
    "./componentDoc": "./src/componentDoc.ts",
    "./constants": "./src/constants.ts",
    "./bundle": "./src/bundle.ts",
    "./exactLookup": "./src/exactLookup.ts",
    "./narrative/qmdAdapter": "./src/narrative/qmdAdapter.ts",
    "./narrative/narrativeRetrieval": "./src/narrative/narrativeRetrieval.ts",
    "./mcp-tools/registerDocsTools": "./src/mcp-tools/registerDocsTools.ts",
    "./install/report": "./src/install/report.ts",
    "./install/fs-write": "./src/install/fs-write.ts",
    "./install/types": "./src/install/types.ts",
    "./install/install.command": "./src/install/install.command.ts",
    "./install/spec": "./src/install/spec.ts",
    "./install/clients": "./src/install/clients.ts",
    "./install/adapterRegistry": "./src/install/adapterRegistry.ts",
    "./install/types_internal": "./src/install/types_internal.ts",
    "./src/paths": "./src/paths.ts",
    "./src/envelope": "./src/envelope.ts",
    "./src/entityResolve": "./src/entityResolve.ts",
