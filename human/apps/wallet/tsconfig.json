{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@paxeer/wallet": [
        "../../wallet/sdk/src/index.ts"
      ],
      "@sidiora/layerx-sdk": [
        "../../../agent/sdk/typescript/src/index.ts"
      ],
      "viem": [
        "./node_modules/viem"
      ],
      "@supabase/supabase-js": [
        "./node_modules/@supabase/supabase-js"
      ],
      "@scure/bip32": [
        "./node_modules/@scure/bip32"
      ],
      "@scure/bip39": [
        "./node_modules/@scure/bip39"
      ],
      "ws": [
        "./node_modules/@types/ws"
      ],
      "viem/*": [
        "./node_modules/viem/*"
      ],
      "@noble/curves/*": [
        "./node_modules/@noble/curves/*"
      ],
      "@noble/hashes/*": [
        "./node_modules/@noble/hashes/*"
      ],
      "@scure/bip39/*": [
        "./node_modules/@scure/bip39/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
