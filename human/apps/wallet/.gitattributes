# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source code
*.ts text diff=typescript
*.tsx text diff=typescript
*.js text diff=javascript
*.jsx text diff=javascript
*.json text diff=json
*.md text diff=markdown

# Shell scripts
*.sh text eol=lf

# Configuration files
.editorconfig text eol=lf
.eslintrc* text eol=lf
.prettierrc* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Fonts
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary

# Archives
*.zip binary
*.tar.gz binary
