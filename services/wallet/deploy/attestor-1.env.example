# Wallet attestor 1 on its own box (docker --env-file or systemd EnvironmentFile), data volume at /data.
# Peers and the gateway reach this node by host:port; TLS server name is the configured host, so tls.crt carries it as a SAN.
# File secrets are base64 values; layerx-env-files writes them to /run/secrets (docker/wallet-attestor/files.tsv).
ATTESTOR_NODE_ID=1
ATTESTOR_REGION=iad
ATTESTOR_LISTEN_ADDR=:8443
ATTESTOR_PEER_LISTEN_ADDR=:9443
ATTESTOR_PEERS=2=<attestor-2-host>:9443,3=<attestor-3-host>:9443,4=<attestor-4-host>:9443,5=<attestor-5-host>:9443
ATTESTOR_PEER_PINS=2=<attestor-2 SPKI sha256 hex>,3=<attestor-3 SPKI sha256 hex>,4=<attestor-4 SPKI sha256 hex>,5=<attestor-5 SPKI sha256 hex>
ATTESTOR_DATA_DIR=/data
ATTESTOR_BACKUP_DIR=/data/backup
ATTESTOR_SNAPSHOT_INTERVAL=15m
ATTESTOR_SNAPSHOT_RETAIN=96
ATTESTOR_CHAIN_ID=125
ATTESTOR_CEREMONY=false
ATTESTOR_RPC_URL=https://api-mainnet-beta.paxeer.network
ATTESTOR_JWT_AUDIENCE=authenticated
ATTESTOR_AUTHORITY_ISSUER=https://supabase.paxeer.app/auth/v1
ATTESTOR_AUTHORITY_TENANT=paxeer-x-mainnet-beta
ATTESTOR_POLICY_FILE=/etc/attestor/policy.json
ATTESTOR_KERNEL_POLICY_FILE=/etc/attestor/kernel-policy.json
ATTESTOR_ACTIVITY_TYPES=0x10005,0x10007,0x30002,0x90005
ATTESTOR_JWT_MAX_AGE=1h
ATTESTOR_NODE_KEY_FILE=/run/secrets/node.key
ATTESTOR_BACKUP_KEY_FILE=/run/secrets/backup.key
ATTESTOR_TLS_CERT_FILE=/run/secrets/tls.crt
ATTESTOR_TLS_KEY_FILE=/run/secrets/tls.key
ATTESTOR_TLS_CA_FILE=/run/secrets/ca.crt
ATTESTOR_OPERATOR_CA_FILE=/run/secrets/operator-ca.crt
ATTESTOR_AUTHORITY_PUBLIC_KEY_FILE=/run/secrets/wallet_identity_binding_public.pem
ATTESTOR_INVENTORY_PUBLIC_KEY_FILE=/run/secrets/wallet_custody_inventory_authority.pem
ATTESTOR_INVENTORY_FILE=/run/secrets/wallet_custody_inventory.jwt
ATTESTOR_REPLICA_ADDR=<replica-host>:22
ATTESTOR_REPLICA_USER=<replica user>
ATTESTOR_REPLICA_KEY_FILE=/run/secrets/replica.key
ATTESTOR_REPLICA_HOST_KEY_FILE=/run/secrets/replica-host.pub
ATTESTOR_REPLICA_REMOTE_DIR=/attestor-1
ATTESTOR_REPLICA_INTERVAL=5m
ATTESTOR_NODE_KEY=<base64>
ATTESTOR_BACKUP_KEY=<base64>
ATTESTOR_TLS_CERT=<base64>
ATTESTOR_TLS_KEY=<base64>
ATTESTOR_TLS_CA=<base64>
ATTESTOR_OPERATOR_CA=<base64>
ATTESTOR_REPLICA_KEY=<base64>
ATTESTOR_REPLICA_HOST_KEY=<base64>
WALLET_IDENTITY_BINDING_PUBLIC_KEY=<base64>
WALLET_CUSTODY_INVENTORY_PUBLIC_KEY=<base64>
WALLET_CUSTODY_INVENTORY=<base64>
