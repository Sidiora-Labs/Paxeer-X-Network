[module]
name = "read"
contract_major = 2
compatibility = "additive_only"

[type.VerifiedRead]
required = ["value","achieved_verification_level","freshness"]
value_constraint = "core_produced_only"
achieved_verification_level = "Rung for transaction evidence; null for ordinary reads, which claim no transaction rung."

[type.Freshness]
required = ["chain_head","value_height","relative_to"]
chain_head = "canonical_decimal_string u64 block height"
value_height = "canonical_decimal_string u64 block height"
relative_to = "The block tag or height the value was served at. Pending identifies the sequencer open branch; latest or an explicit height identifies committed state."

[operation.read.balance]
request_required = ["account","asset","requested_verification_level"]
response = "VerifiedRead<BalanceValue>"
response_required = ["account","asset","amount","canonical_state","height"]
height = "canonical_decimal_string u64"

[operation.read.account]
request_required = ["account","requested_verification_level"]
response = "VerifiedRead<AccountValue>"
response_required = ["canonical","height"]
height = "canonical_decimal_string u64"

[operation.read.module_state]
request_required = ["module","key","requested_verification_level"]
response = "VerifiedRead<ModuleStateValue>"
response_required = ["canonical","height"]
height = "canonical_decimal_string u64"

[operation.read.history]
request_required = ["range","cursor","page_limit","requested_verification_level"]
response = "VerifiedRead<HistoryValue>"
cursor_text = "The ordered (blockHeight, txIndex, logIndex) triple, encoded as exactly three canonical decimal u64 strings in a JSON array. The legacy kernel cursor, wrong arity, negative values, fractions, exponents, leading zeros, whitespace inside a value and overflow are refused as malformed."
cursor_type = "HistoryCursor"
page_limit_encoding = "canonical_decimal_string"
page_limit_bound = "A page_limit above 65535 is refused as malformed; it is never clamped."
response_required = ["items","cursor","height"]
response_cursor = "The returned page's (blockHeight, txIndex, logIndex) triple or null; its block position comes from that page, never from a second head read."
height = "canonical_decimal_string u64"

[type.HistoryCursor]
fields = ["blockHeight","txIndex","logIndex"]
encoding = "ordered_json_array"
integer_encoding = "canonical_decimal_string"
integer_type = "u64"
arity = 3
minimum = 0
maximum = "18446744073709551615"
refused = ["legacy_kernel_cursor","wrong_arity","negative","fraction","exponent","leading_zero","embedded_whitespace","overflow"]

[operation.read.batch]
request_required = ["batch","requested_verification_level"]
response = "VerifiedRead<BatchValue>"
response_required = ["block","height"]
height = "canonical_decimal_string u64"
batch = "Block height; served by eth_getBlockByNumber."

[operation.read.checkpoint]
request_required = ["checkpoint","requested_verification_level"]
response = "VerifiedRead<CheckpointValue>"
response_required = ["commit","validatorSet","height"]
height = "canonical_decimal_string u64"
checkpoint = "CometBFT commit at the requested height, verified against the validator set at that height."

[operation.read.proof_bundle]
request_required = ["target","requested_verification_level"]
response = "VerifiedRead<ProofBundle>"
request_type = "ReadRequest<ProofBundleTarget>"
target = "The transaction hash of the retained raw signed transaction; an AccountState target additionally binds the subject account at the requested block height."
target_refusals = "Zero or malformed identifiers, unknown kinds, extra fields, noncanonical encodings and trailing bytes are refused. The returned raw transaction and signed receipt must name the exact requested transaction hash."
response_required = ["format","verificationLevel","rawTransaction","signedReceipt","receiptDigest","receiptKey"]
response_committed_required = ["blockHeader","receiptInclusion","commit","validatorSet"]
response_optional = ["accountProof"]
requested_verification_level = "Rung"
requested_rungs = ["submitted","receipted","committed"]
achieved_rungs = ["receipted","committed"]
level_rule = "The returned verificationLevel and envelope achieved_verification_level agree. An achieved rung below the requested rung is refused, never downgraded. Submitted proves no receipt and is never returned as successful proof evidence."
ownership = "The owner requires an actual ReadProofBundle OperationPermit and revalidates its full session/token/generation boundary before and after acquisition. The bound subject must own the tenant's retained transaction index and signed outbox entry. Their transaction hash and idempotency key must agree, and the stored verified receipt must name that transaction. The recovered self-paid sender or the sponsored inner caller authenticated by its signed batch authorization must equal the subject's bound address; the relayer remains the sponsored transaction sender. Missing records or another principal are refused; public knowledge of a transaction hash grants no access."
account_binding = "AccountState targets must equal the subject's bound account. The account proof from eth_getProof is bound to that account and the same committed block height; an account proof alone never grants a transaction rung."
authority = "Receipt signatures verify against the independently pinned ReceiptKeys list, including keyId and the receipt height within firstHeight through lastHeight. Requests cannot supply an authority, key, header, proof or trust override. A returned receiptKey is evidence, never an independent trust anchor."
domain_binding = "The raw transaction chainId, signed receipt network_id and independently configured node chain domain must agree. Evidence from another network or protocol is refused."
head_binding = "The raw transaction hash must equal the signed receipt activity_id. At committed, the landing block height is at least the signed receipt batch_id height, its EVM receipt has equal status, gasUsed and logs, and its MsgSequenceBatch covers the signed receipt position. The header, receipt inclusion, commit and validator set all bind the same landing block, no later than the captured head. A second authenticated observation must have unchanged network, protocol, pinned receipt authority, head height and block hash, otherwise no response is served."
freshness_rule = "Freshness carries the captured chain head height and value_height of the evidence. Pending receipt evidence and committed block evidence are never represented as one unrelated common snapshot."
size_bound = "A proof bundle is at most 262144 bytes before hex encoding; oversized evidence is refused, never truncated or split. The complete JSON response must also obey the unchanged 1048576-byte transport limit."

[type.ProofBundleTarget]
variants = ["Activity","AccountState","Receipt"]
encoding = "Transaction hash for Activity and Receipt; transaction hash and bound account at a block height for AccountState. Legacy kernel selector bytes are refused."

[type.ProofBundle]
format = "layerx-receipt-proof-v2"
required = ["format","verificationLevel","rawTransaction","signedReceipt","receiptDigest","receiptKey"]
required_committed = ["blockHeader","receiptInclusion","commit","validatorSet"]
optional = ["accountProof"]
verificationLevel = ["receipted","committed"]
rawTransaction = "0x-prefixed hex of the exact raw signed EVM transaction; keccak256 of these bytes equals the signed receipt activity_id."
signedReceipt = "0x-prefixed hex of canonical ProtocolReceipt version 2 or 3 bytes; decode and byte-exact re-encode before verifying the ed25519 signature."
receiptDigest = "0x-prefixed hex, exactly 32 bytes: sha256 of the LXP/v1/receipt domain with its terminating zero byte and the unsigned receipt preimage."
receiptKey = "ReceiptKey; match keyId, publicKey and its height interval to the independently pinned ReceiptKeys list."
blockHeader = "CometBFT protobuf Header at the committed landing height."
receiptInclusion = "EVM receipt-trie proof under the landing block receiptsRoot, including the matching receipt status, gasUsed and logs."
commit = "CometBFT protobuf Commit at the landing height; strictly more than two thirds of the validator voting power must verify."
validatorSet = "CometBFT protobuf ValidatorSet at the same landing height."
accountProof = "Optional eth_getProof account evidence at the same committed height; independent of the receipt rung."
validation = "Known format, exact rung-specific field set, canonical encodings, bounded nonempty byte fields and no trailing bytes are required. Committed requires every committed field; receipted never claims committed evidence. Duplicate, orphan or mismatched evidence is refused. Parsing fields or reading verificationLevel does not establish cryptographic verification."
consumer_verification = "Consumers independently verify the receipt signature and key interval, transaction hash, returned fields, returnData digest and signed log effects. Committed additionally requires matching EVM receipt inclusion and the CometBFT commit against the validator set at the landing height. A status-0 receipt is a receipted revert, never a successful outcome."

[type.ReceiptKey]
required = ["keyId","publicKey","firstHeight","lastHeight"]
keyId = "0x-prefixed hex, exactly 32 bytes"
publicKey = "0x-prefixed hex, exactly 32 bytes; dedicated ed25519 receipt key, separate from validator keys"
firstHeight = "canonical_decimal_string u64"
lastHeight = "canonical_decimal_string u64, at least firstHeight; interval endpoints are inclusive"

[operation.availability.fetch]
request_required = ["selector","requested_verification_level","maximum_bytes","maximum_chunks","deadline"]
response = "VerifiedRead<AvailabilityReport>"
response_required = ["completion","classes","providers","height"]
height = "canonical_decimal_string u64"
selector = "Block height for eth_getBlockByNumber with full transactions."
provider_isolation = "A complete result names one provider. Partial reports remain provider attributed and bytes are never merged across providers."

[operation.export.offline]
request_required = ["fact_set","requested_verification_level"]
response = "VerifiedRead<OfflineExport>"
response_required = ["facts","bundles","height"]
height = "canonical_decimal_string u64"
settlement_domain = "Paxeer"
verification_environment = "layerx-proof_without_daemon_or_network"
request_type = "ReadRequest<FactRef[]>"
fact_set = "FactRef[] of 1 through 16 unique references in request order"
requested_verification_level = "Rung"
requested_rungs = ["submitted","receipted","committed"]
response_shape = "VerifiedRead object with value, achieved_verification_level and freshness; value holds facts, portable v2 bundles and height."
facts = "Exactly the requested fact references in request order."
bundles = "Committed portable v2 ProofBundle records with rawTransaction, signedReceipt, blockHeader, receiptInclusion, commit and validatorSet, and optional accountProof for a state fact."
binding = "Every requested fact binds a verified bundle at the reported height. Shared evidence must still bind every consuming fact; orphan, duplicate or mismatched evidence is refused. There is no partial success."
level_rule = "Offline export requires committed evidence for every fact; an achieved rung below the requested rung is refused, never downgraded."
freshness_rule = "Freshness names the captured head height and value_height; facts relative to unrelated block heights are not presented as one common snapshot."
size_bound = "The complete JSON response stays within the 1048576 byte transport body bound; a larger export is refused, never truncated."
offline_verification = "Verify portable v2 with an independent ReceiptKeys list and trusted validator-set context. Verify receipt signatures, transaction hashes and receipt inclusion, then the CometBFT commit with strictly more than two thirds voting power at the landing height. The response rung is never trusted as proof."

[operation.project]
response = "ProjectionResult"
forbidden_response = "VerifiedRead"
semantics = "An estimate is never core-produced, never receipt-shaped and never an executed outcome."
request = "FeeProjectionRequest"
request_required = ["protocol_activity_type","canonical_bytes","execution_units","storage_units"]
response_value = "ProjectionResult<FeeProjection>"
response_required = ["projected","rationale","observed_freshness"]
height = "observed_freshness.value_height"
fee_denom = "projected.denom"
verification_status = "A projection claims no transaction rung."
producer = "The pending node gas estimate and gas price, converted into the payer fee denom; a sponsored estimate names the sponsor denom. Program fees use the current fee and metering schedules. The estimate snapshot_height must equal the captured head height, otherwise the projection is refused."
legacy_policy_payload = "A request object of the earlier policy dry-run shape, context and canonical_intent, is refused as PolicyRefusal policy.legacy_project_payload. It is never read as a fee request; policy evaluation is policy.dry_run."

[type.HistoryItem]
required = ["height","txIndex","logIndex","kind","canonical","proof"]
height = "canonical_decimal_string u64"
txIndex = "canonical_decimal_string u64"
logIndex = "canonical_decimal_string u64"
canonical = "lowercase_hex"
proof = "lowercase hex or null"

[type.HistoryKind]
variants = ["Activity","Receipt","Event"]
wire_byte = ["Activity:1","Receipt:2","Event:3"]
exhaustive = "Any other kind byte is refused; there is no default kind."

[type.FactRef]
grammar = ["receipt:<activity_id>","activity:<activity_id>","state:<activity_id>:<account_id>","checkpoint:<activity_id>:<height>"]
activity_id = "64 lowercase hex characters of the transaction hash, not all zero"
account_id = "64 lowercase hex characters, not all zero"
height = "canonical decimal u64 with checked overflow; 0 is refused and never means latest"
maximum_bytes = "135"
refused = "Whitespace, uppercase hex, a 0x prefix, an unknown kind, extra fields, trailing bytes and duplicate references are refused."
parser = "One shared strict parser used by the daemon and every SDK."
ownership = "The activity_id of every kind is the tenant ownership anchor; a state reference is additionally bound to the subject account."

[type.FeeProjectionRequest]
required = ["protocol_activity_type","canonical_bytes","execution_units","storage_units"]
protocol_activity_type = "decimal_string u32: full protocol module and ordinal"
canonical_bytes = "decimal_string 0 through 1048576 inclusive; zero is accepted; a larger value is refused, never clamped"
execution_units = "decimal_string u64"
storage_units = "decimal_string u64"

[type.FeeProjection]
required = ["request","parameter_version","fee","gas_units","denom","canonical_schedule","snapshot_height","snapshot_state_root"]
request = "The FeeProjectionRequest exactly as sent."
parameter_version = "decimal_string u32, nonzero"
fee = "decimal_string u128, exact"
gas_units = "canonical_decimal_string u64"
denom = "Non-empty fee denomination of the payer; for a sponsored transaction this is the sponsor denomination."
canonical_schedule = "lowercase hex of the canonical fee schedule bytes"
snapshot_height = "canonical_decimal_string u64: the block height the estimate answered from, equal to observed_freshness.chain_head and observed_freshness.value_height"
snapshot_state_root = "64 lowercase hex characters, nonzero: snapshot provenance, not cryptographic verification and not an executed receipt"

[type.ProjectionResult]
required = ["projected","rationale","observed_freshness"]
rationale = "non-empty text"
constraint = "Never core-produced, never VerifiedRead and never an executed outcome."
