[module]
name = "approval"
contract_major = 1
contract_minor = 1
compatibility = "additive_only"

[guarantee.ApprovalHold]
enforcement = "daemon_enforced"
authority = "restriction_only"
notice = "An approval hold is a daemon-enforced restriction. It confers no protocol authority, and bypassing the daemon bypasses the restriction."

[type.StructuredActivityDisclosure]
required = ["canonical_digest","activity_type","actor","authority","counterparties","amounts","asset","fee_limit","expiry","idempotency_key"]
origin = "decoded_from_held_canonical_bytes"
roundtrip_rule = "Re-encoding the disclosure must reproduce the held canonical bytes digest before a decision is accepted."

[type.HoldReason]
required = ["code","message"]
message_rule = "The message is disclosure text only and carries no authority."

[type.ApprovalRecord]
required = ["approval_id","tenant","held_activity","canonical_bytes_digest","hold_reason","created_at","expires_at","state"]
created_at = "TimestampSeconds"
expires_at = "TimestampSeconds"
expiry_rule = "The policy engine computes expiry deterministically and bounds it by the held activity submission validity window."

[type.ApprovalState]
variants = ["Held","Granted","Rejected","Expired","Defective"]
terminal = ["Granted","Rejected","Expired","Defective"]

[type.ApprovalDecisionOutcome]
variants = ["Granted","Rejected","Expired","Defective","AlreadyDecided","Conflict"]

[type.ApprovalLifecycleEvent]
variants = ["Created","Granted","Rejected","Expired","Defective"]
required = ["event_id","tenant","approval_id","kind","at","record_digest"]
Created.required = ["hold_reason","expires_at"]
Granted.required = ["submission_ref"]
Rejected.required = ["reason"]
Expired.required = ["deterministic_expiry"]
Defective.required = ["defect_code"]

[operation.approval.list]
request = "ApprovalListRequest"
required = ["tenant","cursor","page_limit"]
response = "ApprovalPage"
response_required = ["approvals","next_cursor"]

[operation.approval.get]
request = "ApprovalGetRequest"
required = ["tenant","approval_id"]
response = "ApprovalRecord"

[operation.approval.approve]
request = "ApprovalApproveRequest"
required = ["tenant","approval_id","idempotency_key"]
response = "ApprovalDecision"
response_required = ["outcome","submission_ref"]

[operation.approval.reject]
request = "ApprovalRejectRequest"
required = ["tenant","approval_id","idempotency_key","reason"]
response = "ApprovalDecision"
response_required = ["outcome"]

