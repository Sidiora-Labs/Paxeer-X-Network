# Railway project layerx, environment beta: services relay-archive-a and relay-archive-b, the railway target of
# docker/relay-archive/Dockerfile, each with its own volume at /var/lib/layerx/relay-archive and the same variables;
# install.sh --railway-start does not tell the replicas apart. Public domain archive.paxeer.network on port 8080.
# The origin is the relay archive colocated with the sequencer on the kernel box, verified against the internal CA.
LAYERX_RELAY_ARCHIVE_NETWORK_ID=125
LAYERX_RELAY_ARCHIVE_DATA_DIR=/var/lib/layerx/relay-archive
LAYERX_RELAY_ARCHIVE_RUN_DIR=/run/layerx/relay-archive
LAYERX_RELAY_ARCHIVE_LISTEN=[::]:8080
LAYERX_HEALTH_ADDR=[::]:8080
PORT=8080
LAYERX_RELAY_ARCHIVE_PUBLIC_URL=https://archive.paxeer.network
LAYERX_RELAY_ARCHIVE_UPSTREAM=https://kernel.paxeer.network:9457
LAYERX_RELAY_ARCHIVE_ALLOW_RAILWAY_PRIVATE_NETWORK=0
LAYERX_RELAY_ARCHIVE_SUBMISSION_UPSTREAM=https://api-mainnet-beta.paxeer.network/v1/activities
LAYERX_RELAY_ARCHIVE_INTERNAL_CA=/etc/layerx/trust/ca.crt
LAYERX_RELAY_ARCHIVE_PUBLIC_ROOTS=/usr/share/ca-certificates/mozilla/ISRG_Root_X1.crt /usr/share/ca-certificates/mozilla/ISRG_Root_X2.crt
LAYERX_RELAY_ARCHIVE_CODEC=/usr/local/bin/layerx-archive-codec

# The kernel's pins: sha256 of genesis.manifest, and the sequencer id and public key of core.env and sequencer-public-key.
LAYERX_RELAY_ARCHIVE_GENESIS_SHA256=
LAYERX_RELAY_ARCHIVE_SEQUENCER_ID=
LAYERX_RELAY_ARCHIVE_SEQUENCER_PUBLIC_KEY=
# The base64 of the internal CA root certificate of tools/bringup/ca.sh, written to /etc/layerx/trust/ca.crt (docker/relay-archive/files.tsv).
LAYERX_INTERNAL_CA_ROOT=
