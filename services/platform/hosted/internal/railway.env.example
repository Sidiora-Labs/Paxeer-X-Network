# Railway project layerx, environment beta: five services from
# docker/platform-internal/Dockerfile, each with its own volume at /data.
# Token values are the base64 lines tools/bringup/mint-secrets.sh prints.

# service internal-kms (https://internal-kms.railway.internal:9443)
LAYERX_ROLE=kms
LAYERX_HEALTH_ADDR=[::]:8080
PORT=8080
INTERNAL_KMS_TOKEN=
INTERNAL_KMS_SEAL_SECRET=

# service internal-journeys (https://internal-journeys.railway.internal:9443)
LAYERX_ROLE=journeys
LAYERX_INTERNAL_UPSTREAM_URL=https://kernel.paxeer.network:9449
LAYERX_INTERNAL_UPSTREAM_ROOT=internal
LAYERX_HEALTH_ADDR=[::]:8080
PORT=8080
INTERNAL_JOURNEYS_TOKEN=
INTERNAL_JOURNEYS_PRODUCER_TOKEN=

# service internal-payments (https://internal-payments.railway.internal:9443)
LAYERX_ROLE=payments
LAYERX_INTERNAL_UPSTREAM_URL=https://api-mainnet-beta.paxeer.network
LAYERX_INTERNAL_UPSTREAM_ROOT=ISRG_Root_X1
LAYERX_HEALTH_ADDR=[::]:8080
PORT=8080
INTERNAL_PAYMENTS_TOKEN=
INTERNAL_PAYMENTS_PRODUCER_TOKEN=

# service internal-approvals (https://internal-approvals.railway.internal:9443)
LAYERX_ROLE=approvals
LAYERX_INTERNAL_UPSTREAM_URL=https://kernel.paxeer.network:9449
LAYERX_INTERNAL_UPSTREAM_ROOT=internal
LAYERX_HEALTH_ADDR=[::]:8080
PORT=8080
INTERNAL_APPROVALS_TOKEN=
INTERNAL_APPROVALS_PRODUCER_TOKEN=

# service internal-programs (https://internal-programs.railway.internal:9443)
LAYERX_ROLE=programs
LAYERX_INTERNAL_UPSTREAM_URL=https://api-mainnet-beta.paxeer.network
LAYERX_INTERNAL_UPSTREAM_ROOT=ISRG_Root_X1
LAYERX_HEALTH_ADDR=[::]:8080
PORT=8080
INTERNAL_PROGRAMS_TOKEN=
INTERNAL_PROGRAMS_PRODUCER_TOKEN=
