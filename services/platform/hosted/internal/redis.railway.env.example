# Railway project layerx, environment beta: service redis-internal from
# docker/redis/Dockerfile, volume at /data. Replaces the Fly app paxeer-internal-redis.
# Private address: rediss://<user>:<password>@redis-internal.railway.internal:6379
# File values are base64 (docker/redis/files.tsv): REDIS_TLS_* are the
# REDIS_TLS_CERT/KEY/CA lines of tools/bringup/ca.sh issue internal-redis, REDIS_ACL is the
# users.acl holding the ACL users the clients send, REDIS_CONF holds extra
# directives (base64 of an empty file for none); the rendered TLS, ACL,
# persistence and bind directives override it.

# service redis-internal
LAYERX_ROLE=redis-internal
REDIS_MAXMEMORY=0
REDIS_CONF=
REDIS_TLS_CERT=
REDIS_TLS_KEY=
REDIS_TLS_CA=
REDIS_ACL=
