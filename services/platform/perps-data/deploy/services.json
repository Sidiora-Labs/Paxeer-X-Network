{
  "project": "perps-data",
  "services": [
    {
      "name": "perps-data-indexer",
      "build": {
        "dockerfile": "services/platform/perps-data/deploy/Dockerfile",
        "service": "perps-indexer",
        "inputs": [
          "BUILD_IMAGE",
          "RUNTIME_IMAGE"
        ]
      },
      "run": "service",
      "replicas": 1,
      "restart": "always",
      "public": false,
      "healthcheck": {
        "kind": "http",
        "path": "/healthz/ready"
      },
      "variables": {
        "PERPS_CHAIN_ID": {
          "source": "input"
        },
        "PERPS_RPC_URLS": {
          "source": "input"
        },
        "PERPS_COMET_URLS": {
          "source": "input"
        },
        "DATABASE_URL": {
          "source": "reference",
          "service": "postgres",
          "variable": "DATABASE_URL"
        },
        "NATS_URL": {
          "source": "input"
        },
        "PORT": {
          "source": "input"
        },
        "PERPS_START_HEIGHT": {
          "source": "input"
        }
      }
    },
    {
      "name": "perps-gateway",
      "build": {
        "dockerfile": "services/platform/perps-data/deploy/Dockerfile",
        "service": "perps-gateway",
        "inputs": [
          "BUILD_IMAGE",
          "RUNTIME_IMAGE"
        ]
      },
      "run": "service",
      "replicas": 2,
      "restart": "always",
      "public": true,
      "healthcheck": {
        "kind": "http",
        "path": "/healthz/ready"
      },
      "variables": {
        "PERPS_CHAIN_ID": {
          "source": "input"
        },
        "PERPS_RPC_URLS": {
          "source": "input"
        },
        "DATABASE_URL": {
          "source": "reference",
          "service": "postgres",
          "variable": "DATABASE_URL"
        },
        "NATS_URL": {
          "source": "input"
        },
        "PORT": {
          "source": "input"
        },
        "PERPS_AUTH_SECRET": {
          "source": "input"
        }
      }
    },
    {
      "name": "perps-explorer",
      "build": {
        "dockerfile": "services/platform/perps-data/deploy/Dockerfile",
        "service": "perps-explorer",
        "inputs": [
          "BUILD_IMAGE",
          "RUNTIME_IMAGE"
        ]
      },
      "run": "service",
      "replicas": 1,
      "restart": "always",
      "public": true,
      "healthcheck": {
        "kind": "http",
        "path": "/healthz/ready"
      },
      "variables": {
        "PERPS_CHAIN_ID": {
          "source": "input"
        },
        "DATABASE_URL": {
          "source": "reference",
          "service": "postgres",
          "variable": "DATABASE_URL"
        },
        "PORT": {
          "source": "input"
        },
        "PERPS_EXPLORER_TX_BASE": {
          "source": "input"
        }
      }
    },
    {
      "name": "perps-portal",
      "build": {
        "dockerfile": "services/platform/perps-data/deploy/Dockerfile",
        "service": "perps-portal",
        "inputs": [
          "BUILD_IMAGE",
          "RUNTIME_IMAGE"
        ]
      },
      "run": "service",
      "replicas": 1,
      "restart": "always",
      "public": true,
      "healthcheck": {
        "kind": "http",
        "path": "/healthz/ready"
      },
      "variables": {
        "PERPS_CHAIN_ID": {
          "source": "input"
        },
        "PORT": {
          "source": "input"
        },
        "PERPS_EXPLORER_TX_BASE": {
          "source": "input"
        },
        "PERPS_GATEWAY_URL": {
          "source": "input"
        }
      }
    },
    {
      "name": "perps-replay",
      "build": {
        "dockerfile": "services/platform/perps-data/deploy/Dockerfile",
        "service": "perps-replay",
        "inputs": [
          "BUILD_IMAGE",
          "RUNTIME_IMAGE"
        ]
      },
      "run": "manual",
      "replicas": 0,
      "restart": "never",
      "public": false,
      "healthcheck": {
        "kind": "none"
      },
      "variables": {
        "PERPS_CHAIN_ID": {
          "source": "input"
        },
        "PERPS_RPC_URLS": {
          "source": "input"
        },
        "PERPS_COMET_URLS": {
          "source": "input"
        },
        "DATABASE_URL": {
          "source": "reference",
          "service": "postgres",
          "variable": "DATABASE_URL"
        }
      }
    },
    {
      "name": "postgres",
      "provider": "railway-postgres",
      "run": "service",
      "replicas": 1,
      "restart": "always",
      "public": false,
      "healthcheck": {
        "kind": "provider"
      },
      "volume": {
        "mount": "/var/lib/postgresql/data"
      },
      "variables": {}
    },
    {
      "name": "nats",
      "build": {
        "dockerfile": "services/platform/perps-data/deploy/nats/Dockerfile"
      },
      "members": [
        "nats-1",
        "nats-2",
        "nats-3"
      ],
      "run": "service",
      "replicas": 1,
      "restart": "always",
      "public": false,
      "healthcheck": {
        "kind": "monitoring",
        "path": "/healthz"
      },
      "volume": {
        "mount": "/data"
      },
      "variables": {
        "NATS_CLUSTER_PASSWORD": {
          "source": "input"
        },
        "NATS_GATEWAY_PASSWORD": {
          "source": "input"
        },
        "NATS_INDEXER_PASSWORD": {
          "source": "input"
        },
        "NATS_MAX_FILE_STORE": {
          "source": "input"
        },
        "NATS_ROUTES": {
          "source": "input"
        },
        "PORT": {
          "source": "input"
        }
      }
    }
  ]
}
