{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kindle-shared-capture-v1",
  "$defs": {
    "Bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "interface": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "topology": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generator": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "candidate",
        "interface",
        "topology",
        "generator"
      ]
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.(json|ndjson)$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "gateway_egress",
            "resource_pool",
            "fault_control",
            "source_commits",
            "source_arrivals",
            "expected_browser_delivery",
            "browser_delivery",
            "receiver_ledger",
            "socket_inventory",
            "calibration",
            "http_arrivals",
            "native_provider",
            "managed_playback",
            "cost_budget",
            "workload_definition",
            "authorization",
            "component_result",
            "scenario_definition"
          ]
        }
      },
      "required": [
        "name",
        "path",
        "sha256",
        "kind"
      ]
    },
    "GatewayInterval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boundary": {
          "const": "edge_socket_write"
        },
        "replica_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "capture_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "capture_version": {
          "const": "kindle-shared-capture-v1"
        },
        "metrics_authority_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "interval_start_utc_ns": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,29}$"
        },
        "interval_end_utc_ns": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,29}$"
        },
        "native_sample_before_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "native_sample_after_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "accepted_connections": {
          "type": "integer",
          "minimum": 0
        },
        "authenticated_connections": {
          "type": "integer",
          "minimum": 0
        },
        "public_connections": {
          "type": "integer",
          "minimum": 0
        },
        "subscriptions_total": {
          "type": "integer",
          "minimum": 0
        },
        "subscriptions_max_per_socket": {
          "type": "integer",
          "minimum": 0
        },
        "hot_subscriptions": {
          "type": "integer",
          "minimum": 0
        },
        "cold_subscriptions": {
          "type": "integer",
          "minimum": 0
        },
        "slow_readers": {
          "type": "integer",
          "minimum": 0
        },
        "slow_reader_queue_bytes_max": {
          "type": "integer",
          "minimum": 0
        },
        "delivered_frames": {
          "type": "integer",
          "minimum": 0
        },
        "chart_delivered_frames": {
          "type": "integer",
          "minimum": 0
        },
        "payload_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "chart_payload_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "websocket_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "tls_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "network_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "forced_closes": {
          "type": "integer",
          "minimum": 0
        },
        "resnapshot_requests": {
          "type": "integer",
          "minimum": 0
        },
        "reconnects": {
          "type": "integer",
          "minimum": 0
        },
        "source_accepted_events": {
          "type": "integer",
          "minimum": 0
        },
        "source_rejected_events": {
          "type": "integer",
          "minimum": 0
        },
        "oldest_consumer_lag_ns": {
          "type": "integer",
          "minimum": 0
        },
        "heap_after_gc_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "heap_gc_cycle": {
          "type": "integer",
          "minimum": 0
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "memory_limit_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "oom_kills": {
          "type": "integer",
          "minimum": 0
        },
        "queue_depth": {
          "type": "integer",
          "minimum": 0
        },
        "queue_capacity": {
          "type": "integer",
          "minimum": 0
        },
        "goroutines": {
          "type": "integer",
          "minimum": 0
        },
        "file_descriptors": {
          "type": "integer",
          "minimum": 0
        },
        "source_cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "durable_watermark": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generator_cpu_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "generator_nic_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "boundary",
        "replica_id",
        "capture_id",
        "run_id",
        "capture_version",
        "metrics_authority_sha256",
        "interval_start_utc_ns",
        "interval_end_utc_ns",
        "native_sample_before_sha256",
        "native_sample_after_sha256",
        "accepted_connections",
        "authenticated_connections",
        "public_connections",
        "subscriptions_total",
        "subscriptions_max_per_socket",
        "hot_subscriptions",
        "cold_subscriptions",
        "slow_readers",
        "slow_reader_queue_bytes_max",
        "delivered_frames",
        "chart_delivered_frames",
        "payload_bytes",
        "chart_payload_bytes",
        "websocket_bytes",
        "tls_bytes",
        "network_bytes",
        "forced_closes",
        "resnapshot_requests",
        "reconnects",
        "source_accepted_events",
        "source_rejected_events",
        "oldest_consumer_lag_ns",
        "heap_after_gc_bytes",
        "heap_gc_cycle",
        "memory_bytes",
        "memory_limit_bytes",
        "oom_kills",
        "queue_depth",
        "queue_capacity",
        "goroutines",
        "file_descriptors",
        "source_cursor",
        "durable_watermark",
        "generator_cpu_fraction",
        "generator_nic_fraction"
      ]
    },
    "FaultInterval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fault_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action": {
          "enum": [
            "pause",
            "replica_loss",
            "reconnect",
            "disconnect",
            "restore",
            "resnapshot"
          ]
        },
        "affected_replica_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "observed_start_utc_ns": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,29}$"
        },
        "observed_end_utc_ns": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,29}$"
        },
        "recovery_utc_ns": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,29}$"
        },
        "native_control_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "outcome": {
          "enum": [
            "recovered",
            "failed",
            "unknown"
          ]
        }
      },
      "required": [
        "run_id",
        "fault_id",
        "action",
        "affected_replica_ids",
        "observed_start_utc_ns",
        "observed_end_utc_ns",
        "recovery_utc_ns",
        "native_control_sha256",
        "outcome"
      ]
    },
    "ExpectedBrowserDelivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "receiver_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scheduled_utc_ns": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,29}$"
        },
        "deadline_utc_ns": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,29}$"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "run_id",
        "receiver_id",
        "event_id",
        "source_event_id",
        "topic",
        "scheduled_utc_ns",
        "deadline_utc_ns",
        "source_manifest_sha256"
      ]
    },
    "SourceCommit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_fact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "transaction_hash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "height": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "transaction_index": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "log_index": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "block_hash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "durable_commit_utc_ns": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,29}$"
        },
        "timestamp_authority": {
          "const": "postgres_transaction_commit"
        }
      },
      "required": [
        "event_id",
        "source_fact_digest",
        "transaction_hash",
        "height",
        "transaction_index",
        "log_index",
        "block_hash",
        "durable_commit_utc_ns",
        "timestamp_authority"
      ]
    },
    "CaptureManifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "capture_version": {
          "const": "kindle-shared-capture-v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope": {
          "enum": [
            "isolated_component",
            "final_shared"
          ]
        },
        "final_gate": {
          "const": "9.1"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "candidate": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "interface": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "topology": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "generator": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "candidate",
            "interface",
            "topology",
            "generator"
          ]
        },
        "workload_version": {
          "const": "kindle-500k-dau-v1"
        },
        "root_capacity_ledger_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "root_mix_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scenario_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "started_utc_ns": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,29}$"
        },
        "ended_utc_ns": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,29}$"
        },
        "artifact_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "minItems": 1,
          "maxItems": 512
        },
        "generator_hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 4,
          "uniqueItems": true
        },
        "gateway_replica_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 64
        },
        "required_lane_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^L[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "native_runtime_authority_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "clock_calibration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capacity_qualified": {
          "const": false
        },
        "monthly_availability_qualified": {
          "const": false
        }
      },
      "required": [
        "schema_version",
        "capture_version",
        "run_id",
        "scope",
        "final_gate",
        "bindings",
        "workload_version",
        "root_capacity_ledger_sha256",
        "root_mix_sha256",
        "scenario_manifest_sha256",
        "started_utc_ns",
        "ended_utc_ns",
        "artifact_root",
        "artifacts",
        "generator_hosts",
        "gateway_replica_ids",
        "required_lane_ids",
        "native_runtime_authority_sha256",
        "clock_calibration_sha256",
        "capacity_qualified",
        "monthly_availability_qualified"
      ]
    }
  },
  "$ref": "#/$defs/CaptureManifest"
}
