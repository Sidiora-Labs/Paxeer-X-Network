{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "signer",
    "signature"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "feature",
        "evidence_sha256",
        "records"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "feature": {
          "type": "string",
          "pattern": "^(?:PF[0-9]{2}|OC[0-9]{2})$"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "signer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "$defs": {
    "artifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "provider_id",
            "support_sha256",
            "license_sha256",
            "direction",
            "rail",
            "intent",
            "transaction",
            "receipt",
            "transfer",
            "registry"
          ],
          "properties": {
            "type": {
              "const": "provider_chain125"
            },
            "provider_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "support_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "license_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "direction": {
              "enum": [
                "deposit",
                "withdrawal"
              ]
            },
            "rail": {
              "$ref": "#/$defs/FundingRail"
            },
            "intent": {
              "$ref": "#/$defs/FundingIntent"
            },
            "transaction": {
              "type": "object"
            },
            "receipt": {
              "type": "object"
            },
            "transfer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sender",
                "recipient",
                "asset",
                "amount_raw"
              ],
              "properties": {
                "sender": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                },
                "recipient": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                },
                "asset": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{40}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "amount_raw": {
                  "$ref": "#/$defs/PositiveUInt256"
                }
              }
            },
            "registry": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "platform",
            "physical",
            "device_id",
            "build_sha256",
            "installed_build_sha256",
            "source_sha256",
            "application_id",
            "push_provider",
            "push_message_id",
            "push_delivered_at",
            "deep_link",
            "resolved_route",
            "auth_result_artifact",
            "trade_result_artifact",
            "trace_artifact"
          ],
          "properties": {
            "type": {
              "const": "native_device"
            },
            "platform": {
              "enum": [
                "ios",
                "android"
              ]
            },
            "physical": {
              "const": true
            },
            "device_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "build_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "installed_build_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "application_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "push_provider": {
              "enum": [
                "apns",
                "fcm"
              ]
            },
            "push_message_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "push_delivered_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "deep_link": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "resolved_route": {
              "const": "/notifications"
            },
            "auth_result_artifact": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "trade_result_artifact": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "trace_artifact": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "viewport_width",
            "browser",
            "trace_artifact",
            "state_artifact"
          ],
          "properties": {
            "type": {
              "const": "responsive_web"
            },
            "viewport_width": {
              "enum": [
                390,
                768,
                1440
              ]
            },
            "browser": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "trace_artifact": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "state_artifact": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "capabilities",
            "provider_id",
            "session_id",
            "join_receipt",
            "revocation_receipt",
            "end_receipt"
          ],
          "properties": {
            "type": {
              "const": "voice_provider"
            },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "listen",
                "requestSpeaker",
                "speak",
                "moderate",
                "end",
                "providerQualified"
              ],
              "properties": {
                "listen": {
                  "type": "boolean"
                },
                "requestSpeaker": {
                  "type": "boolean"
                },
                "speak": {
                  "type": "boolean"
                },
                "moderate": {
                  "type": "boolean"
                },
                "end": {
                  "type": "boolean"
                },
                "providerQualified": {
                  "type": "boolean"
                }
              }
            },
            "provider_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "join_receipt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "revocation_receipt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "end_receipt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "capabilities",
            "http_status",
            "reason",
            "owner",
            "dependency",
            "remediation",
            "review_date",
            "room_state",
            "provider_session"
          ],
          "properties": {
            "type": {
              "const": "voice_blocker"
            },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "listen",
                "requestSpeaker",
                "speak",
                "moderate",
                "end",
                "providerQualified"
              ],
              "properties": {
                "listen": {
                  "type": "boolean"
                },
                "requestSpeaker": {
                  "type": "boolean"
                },
                "speak": {
                  "type": "boolean"
                },
                "moderate": {
                  "type": "boolean"
                },
                "end": {
                  "type": "boolean"
                },
                "providerQualified": {
                  "type": "boolean"
                }
              }
            },
            "http_status": {
              "const": 503
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "dependency": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "remediation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "review_date": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "room_state": {
              "enum": [
                "draft",
                "scheduled"
              ]
            },
            "provider_session": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "feature",
            "registry",
            "contract_address",
            "code_sha256",
            "action",
            "transaction",
            "receipt",
            "transfers"
          ],
          "properties": {
            "type": {
              "const": "settlement"
            },
            "feature": {
              "type": "string",
              "pattern": "^(?:PF[0-9]{2}|OC[0-9]{2})$"
            },
            "registry": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "contract_address": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "code_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "action": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "transaction": {
              "type": "object"
            },
            "receipt": {
              "type": "object"
            },
            "transfers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sender",
                  "recipient",
                  "asset",
                  "amount_raw"
                ],
                "properties": {
                  "sender": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "recipient": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "asset": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^0x[0-9a-fA-F]{40}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "amount_raw": {
                    "$ref": "#/$defs/PositiveUInt256"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "FundingRail": {
      "additionalProperties": true,
      "description": "Optional onramp never presented as custody; provider amount/fee estimates separately sourced",
      "properties": {
        "assetAddress": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-fA-F]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "chainId": {
          "const": "125",
          "type": "string"
        },
        "decimals": {
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "limits": {
          "$ref": "#/$defs/FundingLimits"
        },
        "providerId": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "railId": {
          "maxLength": 64,
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "blocked",
            "maintenance"
          ],
          "type": "string"
        },
        "type": {
          "enum": [
            "native_transfer",
            "erc20_transfer",
            "provider_onramp"
          ],
          "type": "string"
        }
      },
      "required": [
        "railId",
        "type",
        "chainId",
        "assetAddress",
        "decimals",
        "status",
        "providerId",
        "limits"
      ],
      "type": "object"
    },
    "FundingIntent": {
      "additionalProperties": true,
      "description": "Provider completed callback not sufficient for onchain funding; sender/recipient/asset/amount verification binds settlement",
      "properties": {
        "accountId": {
          "format": "uuid",
          "type": "string"
        },
        "assetAddress": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-fA-F]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedRaw": {
          "$ref": "#/$defs/PositiveUInt256"
        },
        "fundingId": {
          "format": "uuid",
          "type": "string"
        },
        "railId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "receivedRaw": {
          "$ref": "#/$defs/UInt256"
        },
        "state": {
          "enum": [
            "created",
            "awaiting_transfer",
            "provider_pending",
            "committed",
            "failed",
            "expired"
          ],
          "type": "string"
        },
        "transactionHash": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "wallet": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "type": "string"
        }
      },
      "required": [
        "fundingId",
        "accountId",
        "wallet",
        "railId",
        "assetAddress",
        "expectedRaw",
        "receivedRaw",
        "state",
        "transactionHash"
      ],
      "type": "object"
    },
