# The network names of each tools/bringup/ca.sh row: ROW=<SAN list>, the row's
# name in upper case with - read as _. Railway services are reached as
# <service>.railway.internal; the kernel box as kernel.paxeer.network,
# machine.paxeer.network (agentd) and index.paxeer.network (registry).
# A client row carries no network name.
# Extra SANs of one row come from the environment of the ca.sh run, e.g. a
# Railway TCP proxy name the kernel box dials:
# LAYERX_EXTRA_SANS_IDENTITY=DNS:<name>.proxy.rlwy.net
PENDING_CORE=DNS:kernel.paxeer.network
PENDING_CORE_ADMIN=DNS:kernel.paxeer.network
RECEIPT_AUTHORITY=DNS:kernel.paxeer.network
AGENT_BOUNDARY=DNS:kernel.paxeer.network
AGENTD=DNS:kernel.paxeer.network,DNS:machine.paxeer.network
AGENTD_CLIENT=
PAXEER_BOUNDARY_LOOPBACK=DNS:kernel.paxeer.network
PAXEER_BOUNDARY_PUBLIC=DNS:kernel.paxeer.network
GUARANTOR=DNS:kernel.paxeer.network
HUMAN=DNS:kernel.paxeer.network
HUMAN_EVENT_CLIENT=
HUMAN_ATTESTOR_CLIENT=
HUMAN_KMS=DNS:kernel.paxeer.network
HUMAN_KMS_CLIENT=
HUMAN_KMS_EXECUTOR=
RELAY_ARCHIVE=DNS:kernel.paxeer.network
GATEWAY_REDIS=DNS:redis-router.railway.internal
GATEWAY_CLIENT=
IDENTITY=DNS:identity.railway.internal
INTERNAL_KMS=DNS:internal-kms.railway.internal
INTERNAL_JOURNEYS=DNS:internal-journeys.railway.internal
INTERNAL_PAYMENTS=DNS:internal-payments.railway.internal
INTERNAL_APPROVALS=DNS:internal-approvals.railway.internal
INTERNAL_PROGRAMS=DNS:internal-programs.railway.internal
INTERNAL_REDIS=DNS:redis-internal.railway.internal
REGISTRY=DNS:index.paxeer.network
REGISTRY_EVENT_CLIENT=
INDEXER=DNS:indexer.railway.internal
INTEROP_CLIENT=
DEVELOPER=DNS:webhooks-ingress.railway.internal,DNS:webhooks-public.railway.internal
DEVELOPER_CLIENT=
DASHBOARD_CLIENT=
RAMP_CLIENT=
