# Deploy input. Copy to /etc/paxeer-monitoring/hosts.env on the monitoring host and fill in.
# Never commit the filled copy.

# Space-separated name=address pairs. Every host is scraped on the CometBFT
# metrics port and the node_exporter port.
HOSTS="validator-a=validator-a.example.internal full-1=full-1.example.internal"
COMET_METRICS_PORT=26660
NODE_EXPORTER_PORT=9100

# Space-separated service metrics URLs (scheme, host:port and path are taken from each URL).
KEEPER_METRICS_URLS="https://keeper.example.internal/metrics"
FEEDER_METRICS_URLS="https://feeder.example.internal/metrics"
PAXAI_WORKER_METRICS_URLS="https://paxai-worker.example.internal/metrics"
AI_EVALUATOR_METRICS_URLS="https://ai-evaluator.example.internal/metrics"
X_WEBSEARCH_METRICS_URLS="https://x-websearch.example.internal/metrics"
WALLET_ATTESTOR_METRICS_URLS="https://attestor-1.example.internal/metrics https://attestor-2.example.internal/metrics"

SEQUENCER_PRIMARY_READYZ_URLS="https://sequencer-primary.example.internal/readyz"
SEQUENCER_STANDBY_READYZ_URLS="https://sequencer-standby.example.internal/readyz"
AUTHORITY_METRICS_URLS="https://receipt-authority.example.internal/metrics"

# Space-separated explorer index head and stream metering provider URLs (probed for HTTP 2xx).
EXPLORER_INDEX_HEAD_URLS="https://explorer-index.example.internal/head"
STREAM_METER_PROVIDER_URLS="https://stream-meter.example.internal/healthz"

# Space-separated edge HTTPS URLs whose certificate expiry is watched.
EDGE_CERT_URLS="https://edge.example.internal"

# Alert route: set ALERT_WEBHOOK_URL, or the ALERT_EMAIL_* block, or both.
ALERT_WEBHOOK_URL="https://hooks.example.internal/alerts"
ALERT_EMAIL_TO=""
ALERT_EMAIL_FROM=""
ALERT_SMTP_SMARTHOST=""
ALERT_SMTP_USERNAME=""
ALERT_SMTP_PASSWORD=""
