# Deploy input. Copy to /etc/paxeer-monitoring/hosts.env on the monitoring host and fill in.
# Never commit the filled copy.

# Space-separated name=address pairs. Every host is scraped on the CometBFT
# metrics port and the node_exporter port.
HOSTS="validator-a=validator-a.example.internal full-1=full-1.example.internal"
COMET_METRICS_PORT=26660
NODE_EXPORTER_PORT=9100

# Space-separated kernel readiness URLs (probed for HTTP 2xx).
KERNEL_READYZ_URLS="https://kernel.example.internal/readyz"

# Space-separated edge HTTPS URLs whose certificate expiry is watched.
EDGE_CERT_URLS="https://edge.example.internal"

# Alert route: set ALERT_WEBHOOK_URL, or the ALERT_EMAIL_* block, or both.
ALERT_WEBHOOK_URL="https://hooks.example.internal/alerts"
ALERT_EMAIL_TO=""
ALERT_EMAIL_FROM=""
ALERT_SMTP_SMARTHOST=""
ALERT_SMTP_USERNAME=""
ALERT_SMTP_PASSWORD=""
