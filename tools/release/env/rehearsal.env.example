# Operator input of the v6.12.0 upgrade rehearsal (tools/release/rehearse-v6120.sh).
# Copy to an untracked .env.rehearsal-v6120 in access-controlled storage and fill every key.
# Never commit the filled copy; the scripts refuse a run while any key they read is empty.

# Copy of the data directory of a stopped, synced full node.
SOURCE_DATA=
# Genesis file of that node.
SOURCE_GENESIS=
# Running release binary (old binary).
OLD_BIN=
# Release candidate binary (new binary).
NEW_BIN=
# Disposable work directory of the four local homes.
WORK=
# First port of the local homes; each home takes distinct ports above it.
PORT_BASE=
# Cosmos chain id of the copied state.
COSMOS_CHAIN_ID=
# Height E passed to paxd export.
EXPORT_HEIGHT=
# Halt height HR of the local network.
REHEARSAL_HALT_HEIGHT=
# Chainflow feed key file in access-controlled storage.
CHAINFLOW_KEY_FILE=
# Filled copy of tools/price-sidecar/config.template.json of each local sidecar.
PRICE_SIDECAR_CONFIG=
# Feed key file of each local sidecar (64 hex characters).
PRICE_SIDECAR_FEED_KEY_FILE=
# File holding the Chainflow feed API key.
PRICE_FEED_REST_API_KEY_FILE=
# State directory of each local sidecar.
PRICE_SIDECAR_STATE_DIR=
# Listen address of the sidecar health routes.
PRICE_SIDECAR_HEALTH_ADDR=
# CometBFT RPC URL of the local node the sidecar submits to.
PRICE_SIDECAR_CONSENSUS_RPC_URL=
# EVM JSON-RPC URL of the local node the sidecar reads.
PRICE_SIDECAR_EVM_RPC_URL=
