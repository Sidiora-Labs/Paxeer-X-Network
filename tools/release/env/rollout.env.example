# Operator input of the v6.12.0 rollout (spec/release-v6-12-0/docs/rollout-runbook.md).
# Copy to an untracked .env.rollout-v6120 in access-controlled storage and fill every key.
# Never commit the filled copy; the scripts refuse a run while any key they read is empty.
# List values are space-separated; the lists of homes, units and operator keys of one host are in the same order.

# Suffix of the retained previous binary.
RELEASE_ID=
# Release tag.
RELEASE_TAG=
# paxd-v6.12.0-linux-amd64 line of SHA256SUMS.
RELEASE_SHA256=
# price-sidecar-v6.12.0-linux-amd64 line of SHA256SUMS.
SIDECAR_SHA256=
# Halt height H, a literal number.
HALT_HEIGHT=
# Cosmos chain id.
CHAIN_ID=
# Keyring backend of the operator keys.
KEYRING_BACKEND=
# Directory of the installed paxd on this host.
BIN_DIR=
# Operations host: every validator host.
VALIDATOR_HOSTS=
# Validator homes on this host (empty on a full-node host).
VALIDATOR_HOMES=
# Service units of VALIDATOR_HOMES.
VALIDATOR_UNITS=
# Operator key names of VALIDATOR_HOMES.
OPERATOR_KEY_NAMES=
# Operations host: every full-node host.
FULLNODE_HOSTS=
# Full-node homes on this host (empty when none).
FULLNODE_HOMES=
# Service units of FULLNODE_HOMES.
FULLNODE_UNITS=
# Operations host: the archive node host.
ARCHIVE_HOST=
# Operations host: the edge.
EDGE_HOST=
# The operations host.
OPS_HOST=
# The build host.
BUILD_HOST=
# Directory for the home snapshots on this host.
SNAPSHOT_DIR=
# Access-controlled credential directory of the sidecar on this host.
CREDENTIAL_DIR=
# Operations host: watchdog and resync timers.
AUTOMATION_UNITS=
# layerx-oracle-feeder units on this host.
OLD_FEEDER_UNITS=
# price-sidecar units on this host, one per validator home.
SIDECAR_UNITS=
# Chainflow feed key file in access-controlled storage.
CHAINFLOW_KEY_FILE=
# CometBFT RPC of this host's node.
CONSENSUS_RPC=
# JSON-RPC of this host's node.
EVM_RPC=
# Operations host: base URLs of the four data services.
DATA_SERVICE_URLS=
# Operations host: base URL of the application.
APP_URL=
# Build id of the application release build.
APP_BUILD_ID=
# Operations host: file listing every node by role.
INVENTORY_FILE=
# Operations host: pool count the markets, full and post checks expect when no --rehearsal receipt is given.
POOL_COUNT=
# Receipt directory.
RECEIPT_DIR=
