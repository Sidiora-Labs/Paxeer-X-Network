[finding.7.1.8-delivery-throughput]
revision = 737cc685fde6e39eb7c9b94cd277c18b4cbc462b
command = go test -p 1 -count=1 ./services/platform/perps-data/internal/delivery/ ./services/platform/perps-data/internal/publish/
exit = 0
log = fleet/logs/release-7.1.8-fix-packages-4.log
observed = The relay claimed, budget-checked, published and marked one row at a time with five round trips per row and ordered claims by perps_seq over an index on (available_at, created_at), draining 13 to 27 rows per second against about 95 produced; it now claims a batch in perps_seq order, checks budgets, marks and retries per batch, pipelines the batch on one connection with the claimed perps_seq as Perps-Seq, and migration 0008 adds the partial pending index on perps_seq, after which pending stayed between 0 and 22 rows with published rate equal to the written rate.
assumption = A failed message in the middle of a batch is republished after the later acknowledged ones, which is the republish order the outbox already allowed; the delivery and publish tests reset the same perps schema and must run serialised.

[finding.7.1.8-store-write-rate]
revision = 737cc685fde6e39eb7c9b94cd277c18b4cbc462b
command = go test -count=1 ./services/platform/perps-data/internal/indexer/ -run 'TestIndexer'
exit = 1
log = fleet/logs/release-7.1.8-verify-4.log
observed = indexes_venue_block, resumes_from_cursor, readiness_lag and publishes_in_order pass while catch_up_batches times out: decoding takes 1 to 6 ms per block but store.WriteBlock takes 150 to 250 ms because insertFact and put send about 60 single-row statements per block with about 28 ms of server time, so the indexer manages about 2.4 blocks per second against a 200 ms block interval.
assumption = The fact writers of capability 7.2.4 must batch the inserts of a block; the 7.1.8 commit stays unlanded until that gate passes.

