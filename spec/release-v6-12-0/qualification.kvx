# Qualification findings for release-v6-12-0: one [finding.<task>] per failure outside the task scope.
# Keys: revision, command, exit_code, log_path, observed_and_assumption.

[finding.5.0.1]
revision = "3ce049b6ac3cb6b378e479a27d0d64e0f4a4d260"
command = "go test ./precompiles/pricefeed/ -run 'TestPriceFeedABIGolden'"
exit_code = 0
log_path = "fleet logs 5.0.1-verify-1"
observed_and_assumption = "do_3 asks precompiles/pricefeed/abi to go:embed ../abi.json, which go:embed cannot reference from a parent directory; the leaf package exports the ABI as an import-free constant pinned byte-equal to abi.json by the golden test. Assumption: the leaf constant satisfies the no-node-import rule for the indexer build; the spec step should name abi/abi.json as the embedded file."

[finding.2.0.1]
revision = "8d660f24e6ad6fc3dc26f8f96e006f3040073998"
command = "go test ./precompiles/launchpad/ -run 'TestCoreRoleABIFiles'"
exit_code = 0
log_path = "fleet logs 2.0.1-verify-2"
observed_and_assumption = "contracts/launchpad.md section 2 heads SidioraPool, SidioraFactory, SidioraERC20, SidioraNFT, Router, Quoter as N events, 0 errors with the event and error counts merged; the Launch-x artifacts hold 42/23/19/10/9/5 events and 19/16/7/22/21/18 distinct errors, each artifact listing one error twice. Assumption: the artifact counts bind and the contract headings are a presentation defect to be corrected in a later contract revision."

[finding.1.0.1]
revision = "4a6f083eb554f8c28fe1b04e5f54df1dd3b70faf"
command = "make test-lxphost"
exit_code = 0
log_path = "fleet logs 1.0.1-verify-1"
observed_and_assumption = "The paxd-build and paxd-version-check targets are implemented but the v6.12.0 version output depends on tools/release/version.json, which still reads v6.11.0 and belongs to the release lane. Assumption: the release-lane version bump task updates version.json and the version check passes once it lands."

[finding.2.0.7]
revision = "b5288adb0"
command = "go test ./precompiles/launchpad/legacy/v610/... -run 'TestRequiredGasIsPinned'"
exit_code = 0
log_path = "fleet logs 2.0.7-verify-2"
observed_and_assumption = "The frozen v6.10 launchpad types cannot call sdkerrors.Register or RegisterInterfaces beside the live module: Register panics on the duplicate codespace and code, and the frozen types carry no proto registration, so the legacy errors use sdkerrors.New with unchanged codespace, code and text and the legacy keeper tests call the msg server directly. Assumption: the legacy snapshot is read by the migration and legacy-precompile tasks through its keeper, never routed as live messages, so the missing registrations change no observable behaviour."

[finding.5.0.4]
revision = "7461b9dfdaec24c43293bc64f5180f0e4d4812f8"
command = "cargo test --locked --manifest-path platform/Cargo.toml -p layerx-oracle-feeder --test feeder"
exit_code = 0
log_path = "fleet logs 5.0.4-verify-1"
observed_and_assumption = "do_1 registers a price-sidecar [[bin]] whose main.rs is written by the wave-2 sidecar binary task, and cargo rejects a manifest naming a bin path that does not exist, so the [[bin]] block was not added here. Assumption: the sidecar binary task adds the [[bin]] block together with its main.rs; its dispatch note carries this."

[finding.7.0.1]
revision = "0d69291465ea5992ffb22a9b26bb02bb0feae5bb"
command = "go build ./platform/perps-data/..."
exit_code = 1
log_path = "fleet logs 7.0.1-build-1"
observed_and_assumption = "The NATS driver of 7.0.1 imports the delivery package that 7.0.2 creates, while 7.0.2 requires 7.0.1, and 7.0.3, 7.0.4, 7.0.6 and 7.0.7 import nats.go with no requires on 7.0.1; platform/perps-data does not exist before 7.0.2 and 7.0.5 land, so the build and verify of 7.0.1 cannot run first. Assumption: the module pins of 7.0.1 land first on their own, 7.0.2 and 7.0.5 build the package, and 7.0.1 completes its driver afterwards with the same gates."

[finding.7.0.4]
revision = "dbb544ed0945fcd49741e95d43f8c0e01622a348"
command = "go test -count=1 ./platform/perps-data/migrations/ -run 'TestSchemaFiles'"
exit_code = 0
log_path = "fleet logs 7.0.4-verify-2"
observed_and_assumption = "Acceptance 7.2.3 expects an insert of 1.5 into a numeric(78,0) column guarded by CHECK (x = trunc(x)) to be refused, but Postgres rounds the value to the column scale before CHECK constraints run, so 2 is stored and the check never fires. Assumption: refusing fractional input needs the columns declared as unconstrained numeric (or a domain over it) with the trunc and range checks, which is a schema ruling for the data-services contract."

[finding.7.0.9]
revision = "d7b899b1c4064f5bfd424a4fa7b001ba893b9c02"
command = "go test -count=1 ./platform/perps-data/internal/bigint/ -run 'TestBigint'"
exit_code = 0
log_path = "fleet logs 7.0.9-verify-1"
observed_and_assumption = "The origin ratelimit middleware wrote its 503 through a Launch-x shared http helper that has no counterpart under platform/perps-data, so the masked 5xx envelope is written inline; the origin BigintAdd did not refuse uint256 overflow, which acceptance 7.1.7 requires, so inputs are validated and results bounded at Uint256Max. Assumption: inline envelope and the bounded arithmetic are the intended port."

[finding.5.1.2]
revision = "21978f950f5dc3a117b530d5b659b6bbd78b5b15"
command = "go test ./modules/pricefeed/types/ -run 'TestLXPName'"
exit_code = 0
log_path = "fleet logs 5.1.2-verify-1"
observed_and_assumption = "No pricefeed task declares the module's ModuleName or StoreKey constants although the errors, keys and codec steps depend on them; ModuleName is now declared beside the errors. Assumption: StoreKey is declared by the first keeper or state task that needs it, with its line named in that task's report."

[finding.4.1.1]
revision = "bf08f2044bd1f0e335d0b7026ed7c8b4e93ce502"
command = "go test ./modules/spot/types/ -run '^(TestParamsValidate|TestParamsValidateBounds)$'"
exit_code = 0
log_path = "fleet logs 4.1.1-verify-1"
observed_and_assumption = "The native-pointer refusal of do_4 needs the msg server and EVM keeper owned by the spot msg-server task, and contracts/perps-parameters.md#spot-fees bounds priceImpactScalarBps at 10000 while contracts/spot.md and PECOR.sol bound it at 500. Assumption: the msg-server task implements the refusal, and 500 from PECOR.sol binds under ruling 9 (LP economics exactly PECOR.sol)."

[finding.6.0.2]
revision = "c9a0ed1e968ca68845e5c0d361a3bd97ee54a85f"
command = "node --test --import tsx tests/perps-abi.test.ts"
exit_code = 0
log_path = "fleet logs 6.0.2-verify-2"
observed_and_assumption = "Acceptance 6.2.5 and application.md ABI rule 5 say getMarkPrice returns markPrice, indexPrice, midPrice and fresh and getFundingState five named outputs, while contracts/perps.md and its abi.json give getMarkPrice one output and getFundingState four, with the extra fields on getMarkPriceDetails and getFundingDetails. Assumption: contracts/perps.md is the interface authority and the app ABI follows it; the application contract text should be aligned to the details views."

[finding.2.1.3]
revision = "c78019e61b14338833f0f536165694249ed8e9ab"
command = "go test ./modules/launchpad/types/... -run 'TestLaunchpadErrorStrings'"
exit_code = 0
log_path = "fleet logs 2.1.3-verify-1"
observed_and_assumption = "Keeper errors with no same-named Launch-x contract error were mapped to the nearest contract error (InvalidParams to FeeOutOfRange, InvalidMarket and InvalidGenesis to InvalidConfiguration, snapshot and airdrop basis errors to UnsupportedSnapshotToken, InvalidRange to IndexOutOfBounds, NotFeeRightsHolder to NotNftOwner, UnknownMarket to PoolNotFound), and the pool-token errors raised by the token contract itself get no keeper error. Assumption: the nearest-error mapping is accepted by the revert-data golden test of the launchpad precompile task."

[finding.2.1.2]
revision = "aca0a1fecf76719a779f089fc4c8695febdd7a32"
command = "go test ./modules/launchpad/types/... -run 'TestDynamicFeeGolden'"
exit_code = 0
log_path = "fleet logs 2.1.2-verify-2"
observed_and_assumption = "The keeper passes the eight price snapshots in raw storage order while SidioraPool orders them oldest first, so keeper volatility diverges from the contract once all eight slots are filled; keeper tests pinned to the old fee and volatility formulas were not run and may need new expected values. Assumption: the keeper market task that owns the caller orders the snapshots oldest first before calling the ported volatility."

[finding.2.2.15]
revision = "29ca8a10ca8b65230076719edbc4184de9fceb11"
command = "go test ./modules/launchpad/keeper/testdata/v6120/record/... -run 'TestRecordRefusesSupplyMismatch'"
exit_code = 0
log_path = "fleet logs 2.2.15-verify-1"
observed_and_assumption = "The golden recorder is written and its refusal test passes, but golden.json needs eth_call and debug_traceCall at the recorded height against a synced node with the debug API, which the fleet may not reach, and the recorder also waits on ProtocolConfig.json, Treasury.json and holders.json from sibling tasks; only the Router and SidioraPool swap paths have a golden caller plan, the permit, guardian, NFT and fee-claim traces do not. Assumption: an operator captures golden.json with the recorder once the sibling files exist, and the remaining trace families get a caller plan before the parity gate."

[finding.1.0.2]
revision = "f892a5d77cf284ec5ca35cee3874c3c2b2d743e5"
command = "scripts/ci/runner-routing-check.sh"
exit_code = 1
log_path = "fleet logs 1.0.2-verify-1"
observed_and_assumption = "The node build workflow carries the accepted runs-on form, but the runner routing check still exits 1 with 74 failure lines from workflows outside this task, because ci.yml and the other workflows end their runs-on fallback in a runner label the check rejects and two mirror workflows change runs-on values in excluded jobs. Assumption: the repository workflow tasks that own those files bring them to the accepted fallback, after which this verify command is rerun without further change here."

[finding.1.0.3]
revision = "bf8a75b84bf1b49e9bdc6ce59b0e2495644c4d51"
command = "go test ./node/ -run 'TestV6120IsAKnownPlanWithAHandler|TestV6120RefusesAnUnboundHook'"
exit_code = 1
log_path = "fleet logs 1.0.3-verify-1"
observed_and_assumption = "The v6.12.0 upgrade handler and hook table are written, but the node test package does not compile because this task deletes the v6.11 upgrade symbols that the custody, activation, v6.10 and v6.11 test files still reference, and those files belong to the dependent test retarget task. Assumption: the test retarget task is built on this task's branch and both land together, with this verify command rerun on the combined revision."

[finding.3.0.5]
revision = "f6b51b58c262e8ed786b28c9009afc9b1b16b3a7"
command = "go test ./modules/perps/types/ -run 'TestTiers'"
exit_code = 0
log_path = "fleet logs 3.0.5-verify-1"
observed_and_assumption = "The margin tier and market validation code passes its gate, but the capability text for the perps math task names UsdToUsdlDown and UsdToUsdlUp helpers that do not exist in the tree, so Market.Validate enforces the decimals bound directly against the collateral decimals constant. Assumption: the perps math task either adds those helpers under that name or its acceptance is read against the direct bound, with no change here."

[finding.7.0.5]
revision = "4f54cd7b570cb492aa732c7f77cf0a736e142616"
command = "PERPS_DATA_TEST_DATABASE_URL=<throwaway local cluster> go test -count=1 ./platform/perps-data/internal/store/ -run 'TestMigrate'"
exit_code = 1
log_path = "fleet logs 7.0.5-verify-2"
observed_and_assumption = "Eleven migrate subtests pass; the amount_columns_exact subtest fails because the facts migration types amounts as numeric(78,0), which rounds a fraction before any CHECK runs, so the fraction refusal in acceptance 7.2.3 can never fire against that column type, the same conflict already recorded for the facts migration; the schema test loader in the migrations package also stops on CREATE FUNCTION, CREATE TRIGGER and REVOKE statements that the delivery migration now carries. Assumption: the amount column type or the acceptance is ruled on once for the whole perps data schema, and the schema test loader is widened by the task that owns it, after which this verify command is rerun unchanged."

[finding.7.2.15]
revision = "75cbd334bd32cd96e38d77e81f714e9b80074ad0"
command = "go test -count=1 ./platform/perps-data/internal/rest/ -run 'TestSpotUsersREST'"
exit_code = -1
log_path = "none, stopped before the build stage"
observed_and_assumption = "The spot user REST routes need the average-cost fold package, the node RPC source client and the store projection that write the spot order tables, and all three come from pending tasks the block does not list in requires, so no code was written. Assumption: this task is re-queued after those three tasks land, with its requires read as including them."

[finding.6.2.10]
revision = "83ac606bf88e24c3f415f32856ebdf431bfd62b6"
command = "node --test --import tsx tests/precompiles.test.ts"
exit_code = 1
log_path = "fleet logs 6.2.10-verify-1"
observed_and_assumption = "Four of five precompile address checks pass; the one-address check fails because the address table carries no hex address yet for the native and SID denom pointer ERC20s, so the PAX entry keeps the native placeholder at 18 decimals, and the no-WPAX9 part of the acceptance is owned by the token removal task. Assumption: the baseline address table task records the two pointer addresses and the token removal task lands, after which this verify command is rerun unchanged."

[finding.6.2.4]
revision = "1e5f4b26fb60d48072dbe1846325275632a53eb3"
command = "node --test --import tsx tests/amounts.test.ts"
exit_code = 0
log_path = "fleet logs 6.2.4-verify-2"
observed_and_assumption = "The exact amount parsing passes its gate, but the acceptance scenario for the deposit amount states that the float path yields 289999 for 0.29 at six decimals, and in JavaScript that product floors to 290000, so the drift is demonstrated with 8.2 instead. Assumption: the scenario text is corrected to an input that actually drifts, with no change to the code."

[finding.1.0.5]
revision = "135a16e62c98494d816d18f40ed97541f9b65fa8"
command = "go test ./modules/layerxcustody/ -run 'TestCustodyProposalExecutesOnlyFromActivationHeight'"
exit_code = 1
log_path = "fleet logs 1.0.5-verify-2"
observed_and_assumption = "The custody activation constant now names the v6.12.0 plan, but the test helper applies that plan through the real upgrade keeper, whose v6.12.0 handler refuses while the pointer, launchpad, pricefeed, perps and spot hooks are unbound, so the gate panics on the unbound pointer hook. Assumption: the gate passes once the hook binding tasks land, and the custody test helper is not changed to bypass the handler."

[finding.2.3.9]
revision = "da9d819f293470bc578776f8f2ac81212c75e69d"
command = "go test ./protocol/... -run 'TestActiveAddresses'"
exit_code = 1
log_path = "fleet logs 2.3.9-verify-1"
observed_and_assumption = "In the Launch-x checkout the protocol coverage package embeds cmd/measure/*.go, which is absent at the pinned revision, so every build or test pattern over ./protocol/... fails at setup; the active address test itself passes, and the same embed fails the build command of the manifest and decode registry tasks whose own gates pass. Assumption: the missing measure command directory is restored in Launch-x by its owner, after which the ./protocol/... gate is rerun unchanged; the generation 2 Treasury role also waits on the factory layout file that this checkout lacks."

[finding.2.0.4]
revision = "c4c1d87547a9c1eb66724919d72fdae696ace16e"
command = "go test ./precompiles/launchpad/ -run 'TestDirectABIFile'"
exit_code = 0
log_path = "fleet logs 2.0.4-verify-2"
observed_and_assumption = "The direct ABI files pass their gate, but the new launchpad abi.json no longer carries the v6.10 event names that the precompile still emits by name, so the existing launchpad flow tests fail until the precompile rewrite task lands, and the launchpad contract text states nineteen events and no errors for ProtocolConfig where its own tables and the artifact give six events and thirteen errors. Assumption: the precompile rewrite task restores the flow tests and the contract summary line is corrected to match its tables."

[finding.1.0.6]
revision = "1bc4bc3f91ed84e90a9fffba5dd83eba352655f3"
command = "go test ./modules/evm/keeper/ ./rpc/ -run 'TestVenueSyntheticReceipt'"
exit_code = 1
log_path = "fleet logs 1.0.6-verify-3"
observed_and_assumption = "Synthetic venue receipts are written and the log, block body and keeper subtests pass, but the receipt endpoints fail because the RPC transaction index lookup matches a receipt's index against the block's transaction positions and cannot find the synthetic index, which lives in rpc/tx.go outside this task's files, and the proto Log has no transaction index field so the index is checked through the receipt. Assumption: the RPC task that owns rpc/tx.go adds the synthetic branch to the index lookup, after which this verify command is rerun unchanged."

[finding.2.3.6]
revision = "5fe93e843d06312c4b3b561784e5a81d17ac2481"
command = "go build ./shared/... ./core/indexer/... ./protocol/..."
exit_code = 1
log_path = "fleet/logs/2.3.6-build-1.log"
observed_and_assumption = "The manifest gate passes but the build command fails at protocol/coverage/measure.go because the embed pattern cmd/measure/*.go matches no files in the Launch-x checkout, the same defect recorded for the active-address task, and the activation height stays at the v6.11 value because the v6.12.0 upgrade height is an operator input. Assumption: the measure command is restored by the fix of that finding and the build command is rerun unchanged; the activation height is set by the release task that receives the upgrade height."

[finding.2.3.4]
revision = "8809336948050d0933dfdd981b8f0869b171f9cc"
command = "cargo test --locked --manifest-path platform/Cargo.toml -p layerx-platform-gateway --lib capabilities"
exit_code = 0
log_path = "fleet/logs/2.3.4-verify-1.log"
observed_and_assumption = "The gate exits 0 while running zero tests, because the capabilities module belongs to the gateway binary and a --lib filter selects nothing, so the launchpad probe test only compiles under --all-targets and never runs. Assumption: the verify command is corrected to the binary target and the task is qualified on that run."

[finding.5.1.15]
revision = "3529f63d3aea6d52cedaa84b3efd09c54e0778ea"
command = "cargo clippy --locked --manifest-path platform/Cargo.toml -p layerx-oracle-feeder --all-targets"
exit_code = 1
log_path = "fleet/logs/5.1.15-build-1.log"
observed_and_assumption = "The feeder gate passes but clippy refuses the crate on the pre-existing struct_field_names lint for Observation.observation_sequence in the feeder library, so no feeder test target can be linted. Assumption: the field is renamed so the lint passes without an allow attribute, with every caller and test updated."
