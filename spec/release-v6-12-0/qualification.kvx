[fix.7.0.4]
revision = "609507210f23758aea7958d2fe0a4903150ae513"
command = "go test -count=1 ./platform/perps-data/migrations/ -run 'TestSchemaFiles' && PERPS_DATA_TEST_DATABASE_URL=<local throwaway cluster> go test -count=1 ./platform/perps-data/internal/store/ -run 'TestMigrate'"
