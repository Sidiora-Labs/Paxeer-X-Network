do_1 = "Declare IPerps in precompiles/perps/Perps.sol in the style of precompiles/layerxexchange/LayerXExchange.sol with the 64 functions of contracts/perps.md."
do_2 = "Load abi.json through MustGetABI (precompiles/common/precompiles.go:449) as precompiles/launchpad/launchpad.go:180 does."
do_3 = "Keep application selectors of Hyperpax:src/hooks/perps/usePosition.ts:29-121 and Hyperpax:src/hooks/perps/usePerpsOrders.ts:10-91 (symbol IPerps)."
do_4 = "Freeze selectors and topics in testdata/abi_golden.txt checked by TestABIGoldenFile, with tuple order from Hyperpax:src/hooks/perps/useQuoter.ts:7-42 (symbol OpenPositionQuote)."

[capability.3.1.2]
title = "Types, errors and parameters"
reqs = ["3020.1", "3022.1", "3022.2", "3021.3"]
touches = ["modules/perps/types/errors.go", "modules/perps/types/keys.go", "modules/perps/types/params.go", "modules/perps/types/state.go", "modules/perps/types/genesis.go", "modules/perps/types/events.go", "modules/perps/types/expected_keepers.go", "modules/perps/types/math.go"]
tests = ["modules/perps/types/errors_test.go", "modules/perps/types/params_test.go", "modules/perps/types/math_test.go"]
verification_contract = "go test ./modules/perps/types/..."
do_1 = "Register LXP_PERPS errors (symbol PerpsCode) with sdkerrors.Register as modules/launchpad/types/errors.go:7-9."
