ac_7 = "The gateway mounts /graphql-ws (contracts/data-services.md:823)."
ac_8 = "Gateway readiness needs Postgres, the consumer and at most 10 seconds lag (contracts/data-services.md:823)."
ac_9 = "While not ready the gateway closes new sockets with 1013 and retry-after (contracts/data-services.md:823)."

