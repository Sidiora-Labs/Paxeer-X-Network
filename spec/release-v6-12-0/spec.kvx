[capability.7.4.3]
title = "Railway project layout for the perps data services"
reqs = ["7021.2", "7021.3", "7021.4", "7021.5"]
touches = ["platform/perps-data/deploy/services.json", "platform/perps-data/deploy/services_test.go"]
tests = ["platform/perps-data/deploy/services_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/deploy/ -run TestServices"
do_1 = "deploy/services.json declares the dedicated project perps-data with the services perps-indexer (one replica, restart always), perps-gateway (two or more replicas), perps-explorer, perps-portal, perps-replay (manual run, restart never), postgres (the Railway Postgres service with a volume) and nats-1, nats-2 and nats-3, each built from deploy/Dockerfile with SERVICE set, the image shape of Launch-x:deploy/Dockerfile.svc:18 (contracts/data-services.md:850)."
do_2 = "Each service names its healthcheck path (/healthz/ready), its variables by name only (PERPS_CHAIN_ID, PERPS_RPC_URLS, DATABASE_URL, NATS_URL, PORT, PERPS_EXPLORER_TX_BASE, PERPS_GATEWAY_URL, PERPS_START_HEIGHT) with values supplied as Railway references or operator inputs, and no host name, address or fixed port (contracts/data-services.md:850)."
do_3 = "Only perps-gateway, perps-explorer and perps-portal have a public domain; postgres and the NATS services are reachable on the private network only (contracts/data-services.md:850)."
do_4 = "TestServices parses services.json and asserts the service set, the healthcheck of every long-running service, that no value contains a scheme, a dotted host or a port, and that every variable a binary reads in config.Load is declared (contracts/data-services.md:850)."

[capability.7.4.4]
title = "NATS JetStream cluster image and configuration"
reqs = ["7021.6", "7021.7"]
touches = ["platform/perps-data/deploy/nats/nats.conf", "platform/perps-data/deploy/nats/Dockerfile", "platform/perps-data/deploy/nats_test.go"]
tests = ["platform/perps-data/deploy/nats_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/deploy/ -run TestNATS"
do_1 = "deploy/nats/nats.conf enables jetstream with store_dir /data on the service volume (Launch-x:deploy/production/bootstrap/nats.conf:10-11) and max_file_store set from NATS_MAX_FILE_STORE at 90 percent of the volume (Launch-x:deploy/production/topology/README.md:26)."
do_2 = "The cluster block names cluster perps-data with routes taken from NATS_ROUTES so the three services form one JetStream cluster for the three-replica stream; accounts give the indexer publish rights on perps.> and the gateway subscribe rights only (contracts/data-services.md:850)."
do_3 = "max_payload is 1048576 bytes, the envelope bound of Launch-x:shared/delivery/envelope.go:17; credentials come from variables and are never in the file."
do_4 = "deploy/nats/Dockerfile copies nats.conf onto a nats image pinned by digest and runs as a non-root user (contracts/data-services.md:850)."
do_5 = "TestNATS parses nats.conf and asserts jetstream, store_dir, the cluster block, the payload bound, the per-service permissions and that no literal password or host appears (contracts/data-services.md:850)."

[capability.7.4.5]
title = "Load test of sockets, reconnect storms and book frames"
reqs = ["7022.1", "7022.2", "7022.3", "7022.4"]
touches = ["platform/perps-data/loadtest/load.go", "platform/perps-data/loadtest/load_test.go", "platform/perps-data/cmd/perps-loadtest/main.go"]
tests = ["platform/perps-data/loadtest/load_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/loadtest/ -run TestLoadProfile"
do_1 = "loadtest.Profile defines 140000 concurrent sockets across the gateway replicas, each subscribing to <SYMBOL>@perp_orderbook, <SYMBOL>@perp_trade and markets@all for the eighteen symbols (Hyperpax:src/core/feeds.ts:4)."
do_2 = "The reconnect storm drops 20 percent of the sockets at once and reconnects them at no more than 6000 per second; every socket returns to a guarded live stream within 60 seconds (contracts/data-services.md:866)."
do_3 = "Book topics deliver at most 10 frames per second with 20 levels per side, and a checksum frame at least every 5 seconds that matches the CRC32 of the client-side book (contracts/data-services.md:866)."
do_4 = "Report checks every frame with the sequence rule of the application (Hyperpax:src/core/net/realtime.ts:29-47) and fails on any gap that is not followed by a resync, on p99 frame delay above 250 ms, and on any 1013 close without a retry-after reason."
do_5 = "TestLoadProfile runs the profile scaled to 2000 sockets against one gateway built from gateway.NewServer with an in-process nats-server and PERPS_DATA_TEST_DATABASE_URL; cmd/perps-loadtest runs the full profile against the gateway named by PERPS_GATEWAY_URL (contracts/data-services.md:866)."

[capability.7.4.6]
title = "Completion: the whole perps data package set passes end to end"
reqs = ["7001.1", "7012.20"]
touches = ["platform/perps-data/e2e_test.go"]
tests = ["platform/perps-data/e2e_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/..."
do_1 = "TestEndToEnd starts the indexer, gateway, explorer and portal handlers in-process against the node of PERPS_DATA_TEST_RPC (chain.mk:278), the Postgres of PERPS_DATA_TEST_DATABASE_URL and an in-process nats-server (contracts/data-services.md:5)."
do_2 = "It sends a deposit, a limit order, a fill, a funding settlement and a withdrawal to the perpetuals precompile 0x1015 and a spot market order to 0x1021, then asserts the rows in Postgres, the JetStream messages with increasing Perps-Seq, the REST and GraphQL answers and the WebSocket frames with dense seq (contracts/data-services.md:5)."
do_3 = "It restarts the gateway mid-stream and asserts a new snapshotId, a fresh snapshot and no gap on the guarded client (contracts/data-services.md:5)."
do_4 = "It runs perps-replay over the test heights and asserts identical rows and no duplicate JetStream entries (contracts/data-services.md:5)."

