do_1 = "Write getPrice, getPriceBySymbol and getPrices (at most 64 ids) over keeper GetPrice and GetPriceBySymbol, refusing ids above the largest uint64."
do_2 = "Write getMarket, getMarketCount and marketIdOf over the stored params, the view shape of precompiles/xweb/xweb.go:276-282."
do_3 = "Write getObservation, getFeedKey, getValidatorByFeedAccount and getParams returning zero values when nothing is stored."
do_4 = "Write precompiles/pricefeed/setup.go GetVersioned(latestUpgrade, keepers), the generated shape of precompiles/xweb/setup.go:10-14."
do_5 = "Write the TestView tests with the view helpers of precompiles/xweb/xweb_test.go:181 and precompiles/xweb/xweb_test.go:192."

[capability.5.5.1]
title = "Chainflow feed source"
reqs = ["5012.1", "5012.2", "5012.3", "5012.4", "5012.5", "5012.6"]
touches = ["platform/hosted/feeder/src/chainflow.rs", "platform/hosted/feeder/tests/chainflow.rs"]
tests = ["platform/hosted/feeder/tests/chainflow.rs"]
verification_contract = "cargo test --locked --manifest-path platform/Cargo.toml -p layerx-oracle-feeder --test chainflow"
do_1 = "Write ChainflowConfig {base_url, api_key_env, timeout_ms, max_quote_age_ms} and api_key() reading the variable or the file its _FILE variable names, since SourceConfig carries no header (platform/hosted/feeder/src/lib.rs:83-97)."
do_2 = "Write ticker_request(symbol) for GET /api/markets/ticker/{symbol} with X-API-Key on the agent of http_agent (platform/hosted/feeder/src/lib.rs:578), replacing the bare GET of fetch_quote (platform/hosted/feeder/src/lib.rs:603-624) for this source."
do_3 = "Write parse_ticker(body, market, now_ms) requiring symbol PERP_<SYMBOL>_USDC (Hyperpax:src/core/feeds.ts:5-7), reading index_price and mark_price as serde_json RawValue tokens and converting them with parse_json_number_fixed(token, 18), since Chainflow sends float64 numbers (chainflow/go/market.go:387-390) and parse_fixed refuses exponent forms (platform/hosted/feeder/src/lib.rs:191-225), and taking updated_at as the observation time."
do_4 = "Write FetchError {Stale, RateLimited, Symbol, NoPrice, Transport} mapping 503, 429, a symbol mismatch, a missing price and an age over max_quote_age_ms."
do_5 = "Write the chainflow integration tests over recorded fixtures under platform/hosted/feeder/tests/fixtures, the fixture reader of platform/hosted/feeder/tests/feeder.rs:14."

[capability.5.5.2]
title = "Cosmos transaction encoding and signing"
reqs = ["5013.1", "5013.2", "5013.3"]
touches = ["platform/hosted/feeder/Cargo.toml", "platform/hosted/feeder/src/cosmos_tx.rs", "platform/hosted/feeder/tests/cosmos_tx.rs"]
tests = ["platform/hosted/feeder/tests/cosmos_tx.rs", "modules/pricefeed/types/sidecar_vector_test.go"]
verification_contract = "cargo test --locked --manifest-path platform/Cargo.toml -p layerx-oracle-feeder --test cosmos_tx"
do_1 = "Add k256 at the pin of platform/hosted/internal/Cargo.toml:22 and base64 to platform/hosted/feeder/Cargo.toml (platform/hosted/feeder/Cargo.toml:1-28); both are already in the lock file."
do_2 = "Write the protobuf encoders of Observation, MsgSubmitPrices, Any, TxBody, SignerInfo, AuthInfo, SignDoc and TxRaw in platform/hosted/feeder/src/cosmos_tx.rs."
do_3 = "Write sign_doc(secret, doc) producing the 64-byte low-s r || s signature of sha256(SignDoc), the prehash signing of EvmSender::sign_prehash (platform/hosted/internal/src/evm_sender.rs:194), and compressed_public_key, which EvmSender does not expose (platform/hosted/internal/src/evm_sender.rs:70)."
do_4 = "Write the bech32 encoding of the feed account with the pax prefix (node/const.go:5)."
do_5 = "Write tests/fixtures/cosmos_tx_vector.json and tests/cosmos_tx.rs; the Go side decodes the same vector in modules/pricefeed/types/sidecar_vector_test.go."

[capability.5.5.3]
title = "price-sidecar binary"
reqs = ["5013.4", "5013.5", "5013.6", "5014.1", "5014.2", "5014.3", "5014.4", "5014.5"]
touches = ["platform/hosted/feeder/src/bin/price-sidecar/main.rs", "platform/hosted/feeder/src/bin/price-sidecar/round.rs", "platform/hosted/feeder/src/bin/price-sidecar/health.rs"]
tests = ["platform/hosted/feeder/src/bin/price-sidecar/round.rs", "platform/hosted/feeder/src/bin/price-sidecar/health.rs"]
verification_contract = "cargo test --locked --manifest-path platform/Cargo.toml -p layerx-oracle-feeder --bin price-sidecar"
do_1 = "Write main reading PRICE_SIDECAR_CONFIG and the key files, the env reading of platform/hosted/feeder/src/main.rs:44-49, with --check-config that loads and validates the config and exits."
do_2 = "Write start checking getValidatorByFeedAccount on 0x1020 for the configured validator, the role of check_sender (platform/hosted/feeder/src/lib.rs:783), and syncing each market's next sequence to max(journal, getObservation sequence + 1) with the journal of platform/hosted/feeder/src/lib.rs:523-572."
do_3 = "Write the round in round.rs: every cadence_ms (platform/hosted/feeder/src/main.rs:56-72) fetch every market, build one MsgSubmitPrices of the markets that answered, read the account with abci_query (consensus/internal/rpc/core/routes.go:70) and broadcast with broadcast_tx_sync (consensus/internal/rpc/core/routes.go:66)."
do_4 = "Write RetryPlan: a sequence mismatch (sdk/x/auth/ante/sigverify.go:273-274) re-reads the account once, LXP_PRICEFEED_RATE_LIMITED waits for the next round, transport failures back off doubling up to retry_max_attempts."
do_5 = "Write health.rs serving /healthz, /readyz within three cadences as health_status and ready do (platform/hosted/feeder/src/lib.rs:27-41, platform/hosted/feeder/src/lib.rs:629-633) and /metrics, on the listener shape of serve_health (platform/hosted/feeder/src/main.rs:25-41)."
do_6 = "Write the unit tests of round.rs and health.rs over recorded RPC and feed response bodies."

