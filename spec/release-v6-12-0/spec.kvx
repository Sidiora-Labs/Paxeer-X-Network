[feature.7]
name = "perps-data-services"
scope = "The data services of the perpetuals and spot venues of Paxeer X Network under platform/perps-data in the root module: the perps-indexer that follows the node head, decodes the perpetuals, spot and oracle precompile logs into a Postgres fact and projection schema and publishes every block to a NATS JetStream stream; the perps-replay tool that rebuilds any height range; the perps-gateway that serves the REST routes, the data socket, the spot user socket, wallet sign-in, the account routes and the GraphQL endpoint and subscriptions the Hyperpax application reads; the perps-explorer REST views; the server-rendered perps-portal; the container images and the Railway layout; and the load profile. The precompiles themselves, the price feed and the application changes are other features."
requirements = ["7001", "7002", "7003", "7004", "7005", "7006", "7007", "7008", "7009", "7010", "7011", "7012", "7013", "7014", "7015", "7016", "7017", "7018", "7019", "7020", "7021", "7022", "7023", "7024", "7025", "7026"]
completion_task = "7.3.99"

[req.7001]
title = "The perps data services build in the root module and load their configuration"
ac_1 = "platform/perps-data is a package tree of the root module go.mod:1 on go go.mod:3, using go-ethereum through the pax-geth replace (go.mod:27, go.mod:280), gorilla/websocket (go.mod:44), lib/pq (go.mod:55) and client_golang (go.mod:69), with nats.go and graphql-go added to the same go.mod (contracts/data-services.md:5)."
ac_2 = "config.Load reads PERPS_CHAIN_ID into the chain id of every subject and block row, replacing the literal 125 of Launch-x:core/indexer/internal/source/committed.go:634."
ac_3 = "Load refuses a missing or non-numeric PERPS_CHAIN_ID, an RPC list without an http or https entry and a non-numeric PORT, unlike the launchpad BaseEnv which requires Redis variables these services do not read (Launch-x:shared/config/env.go:31-34)."
ac_4 = "An RPC entry with a scheme other than http or https is refused, so the follower never dials a websocket or file endpoint by mistake (Launch-x:core/indexer/internal/source/evm.go:21)."
ac_5 = "A non-numeric PORT is refused before any listener opens (contracts/data-services.md:880)."
ac_6 = "Config.String and every log line print DATABASE_URL and NATS_URL as redacted, matching the redacted json tag of the launchpad config (Launch-x:shared/config/env.go:32)."
ac_7 = "bigint.Add, Sub and MulDiv compute on decimal strings exactly as Launch-x:shared/db/bigint.go:60 and Launch-x:shared/db/bigint.go:90, flooring division."
ac_8 = "ValidateRaw refuses a fraction, an exponent or a negative value for unsigned columns (Launch-x:shared/db/bigint.go:129) and ValidateRawInt256 accepts the int256 range for signed columns."

[req.7002]
title = "Schema perps holds append-only facts, projections, candles and the delivery tables"
ac_1 = "Every fact table is keyed (block, tx_index, log_index) and unique on (tx_hash, log_index), as the launchpad swaps table is unique on its log position (Launch-x:core/indexer/migrations/00001_init.sql:202)."
ac_2 = "perps.blocks holds number, hash, parent_hash, time, proposer and tx_count, the BlockRecord fields (Launch-x:core/indexer/internal/source/committed.go:64), and perps.cursors holds the follower cursor (Launch-x:core/indexer/migrations/00001_init.sql:13)."
ac_3 = "Amount columns are numeric(78,0) with a CHECK refusing a fraction, and account columns are bytea of length 20 (contracts/data-services.md:26)."
ac_4 = "The projection tables positions_current, orders, account_margin, user_stats, user_pnl_daily, market_stats_rolling, leaderboard, oi_snapshots, market_snapshots and protocol_snapshots exist with the indexes of section 2 (contracts/data-services.md:26)."
ac_5 = "candles is keyed (market_id, series, interval, bucket_start) with a seq column, the shape of the launchpad candles table with the pool key replaced (Launch-x:core/trading-charts/migrations/00001_init.sql:10)."
ac_6 = "delivery_outbox, delivery_inbox and delivery_quarantine exist in schema perps with the immutable envelope trigger (Launch-x:shared/delivery/schema.sql:2, Launch-x:shared/delivery/schema.sql:26-34)."
ac_7 = "Migrate refuses to run when a recorded migration hash differs from the embedded file (contracts/data-services.md:26)."
ac_8 = "Migrate is idempotent (contracts/data-services.md:26)."

[req.7003]
title = "The indexer follows the chain head with parent-hash continuity and rewinds on a fork"
ac_1 = "The follower polls the head every 100 ms with 10 ms jitter (Launch-x:core/indexer/internal/source/committed.go:830) and writes each new height once."
ac_2 = "Logs are fetched for the venue addresses only (0x1015, 0x1020, 0x1021 to 0x1025 and every share pointer address that spot_tokens holds from ShareTokenCreated) (Launch-x:core/indexer/internal/source/evm.go:204) and keep the block, transaction and log indexes the node fills (precompiles/common/evm_events.go:36-37)."
ac_3 = "A block whose parent hash differs from the stored hash of the previous height is detected (Launch-x:core/indexer/internal/source/committed.go:1037)."
ac_4 = "On a fork the follower deletes facts and projections above the fork height, rebuilds affected projections and moves the cursor in one transaction (Launch-x:core/indexer/internal/source/committed.go:648)."
ac_5 = "A rewind enqueues one perps.<chain>.chain.rewind message carrying the fork height (contracts/data-services.md:420)."
ac_6 = "RPC calls fall back across the configured endpoints in health rank order (Launch-x:core/indexer/internal/source/evm.go:410, Launch-x:core/indexer/internal/source/evm.go:499)."
ac_7 = "The indexer resumes from the cursor plus one after a restart and from PERPS_START_HEIGHT on an empty database (contracts/data-services.md:420)."
ac_8 = "Catch-up reads at most 500 blocks per batch before returning to the head cadence (contracts/data-services.md:420)."
ac_9 = "Readiness is false while the lag to the node head exceeds 30 blocks or an outbox row is older than 30 seconds (contracts/data-services.md:823)."
ac_10 = "A block indexed by the indexer is published to JetStream in block, transaction and log order (contracts/data-services.md:412)."
ac_11 = "A venue block with logs ends in Postgres and on the stream, the path of Processor.ProcessBatch (Launch-x:core/indexer/internal/processor/processor.go:202)."

