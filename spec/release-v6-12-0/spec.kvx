[req.2016]
title = "The launchpad events of the EventEmitter family are emitted at 0x1017"
ac_1 = "EventEmitter event `Swap(bytes32,address,bool,uint256,uint256,uint256,uint256,uint256,uint256)` (topic0 0xa234ab85728295548823d8a26077ecc77aa5815f9ed8f4c5e6fd390ac851d4cc, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:21) is emitted at 0x1017 by the precompile wherever the contract flow called emitSwap (Launch-x:contracts/contracts/core/SidioraPool.sol:273), with the arguments emitSwap adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:365); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_2 = "EventEmitter event `PoolStateUpdated(bytes32,uint256,uint256,uint256,uint256,uint256,uint256)` (topic0 0x8155a4b38a877d212b271811786986f8f7d78074c82fce4526c58defcc6d7ebd, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:70) is emitted at 0x1017 by the precompile wherever the contract flow called emitPoolStateUpdated (Launch-x:contracts/contracts/core/SidioraPool.sol:288), with the arguments emitPoolStateUpdated adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:409); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_3 = "EventEmitter event `TokenDeployed(address,address,address,bytes32,string,string,uint8,uint256,uint256,uint256)` (topic0 0xad187874b793634c55d977f35d4828526eb48170a9531c71d88f8fd10cf9c237, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:619) is emitted at 0x1017 by the precompile wherever the contract flow called emitTokenDeployed (Launch-x:contracts/contracts/core/SidioraFactory.sol:159), with the arguments emitTokenDeployed adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:831); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_4 = "EventEmitter event `MarketCreated(bytes32,address,address,address,address,uint256,uint256)` (topic0 0xb0a9c7605389f1127c2299d4a3ed85f0b2fc19894ab5411d76b453bb29f9f47b, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:11) is emitted at 0x1017 by the precompile wherever the contract flow called emitMarketCreated (Launch-x:contracts/contracts/core/SidioraFactory.sol:160), with the arguments emitMarketCreated adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:354); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_5 = "EventEmitter event `NftMint(uint256,address,address,uint8,uint256,uint256)` (topic0 0xd2917d37031c0dfe5016665c7a83360cbf2ff32063096b2caf61ba66c06832e5, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:600) is emitted at 0x1017 by the precompile wherever the contract flow called emitNftMint (Launch-x:contracts/contracts/core/SidioraNFT.sol:81), with the arguments emitNftMint adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:800); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_6 = "EventEmitter event `FeeStrategyChanged(bytes32,uint256,uint8,uint8,uint256,uint256)` (topic0 0x337fd9f9304e9da4c04886a5b8bf56e74032b459758212a860bc61d3544353dd, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:52) is emitted at 0x1017 by the precompile wherever the contract flow called emitFeeStrategyChanged (Launch-x:contracts/contracts/core/SidioraNFT.sol:123), with the arguments emitFeeStrategyChanged adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:399); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_7 = "EventEmitter event `NftTransfer(address,address,address,uint256,uint256,uint256)` (topic0 0x021f03e8a1315704c74c03e8c022c12bc80c4a2bd4fec8bd36b217322c340ad3, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:482) is emitted at 0x1017 by the precompile wherever the contract flow called emitNftTransfer (Launch-x:contracts/contracts/core/SidioraNFT.sol:144), with the arguments emitNftTransfer adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:700); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_8 = "EventEmitter event `PoolRegistered(address,address,address,address,uint256,uint256,uint256)` (topic0 0xda5568642b67660133b1de538c867c58f3037a5722b0e231a959ee8ca11b2ed7, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:609) is emitted at 0x1017 by the precompile wherever the contract flow called emitPoolRegistered (Launch-x:contracts/contracts/data/PoolRegistry.sol:68), with the arguments emitPoolRegistered adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:813); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_9 = "EventEmitter event `RouterTrade(uint8,address,address,address,address,uint256,uint256,uint256,uint256,uint256)` (topic0 0x17c1899a3fd431f2b2200b90e738d270bb856a4222040c5650bfa208acb3b650, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:587) is emitted at 0x1017 by the precompile wherever the contract flow called emitRouterTrade (Launch-x:contracts/contracts/periphery/Router.sol:282), with the arguments emitRouterTrade adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:782); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_10 = "EventEmitter event `ConfigUpdated(bytes32,uint256,uint256,uint256,uint256)` (topic0 0x2903b3642d2105b7fbd127326de888ab50e8d975bf819398337fb58407c1b10e, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:80) is emitted at 0x1017 by the precompile wherever the contract flow called emitConfigUpdated (Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:63), with the arguments emitConfigUpdated adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:431); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_11 = "EventEmitter event `FeeFlow(uint8,address,address,uint256,uint256,uint256,uint256,uint256,uint256)` (topic0 0x626e3fd5d9323ca4b7ffa3ca51c21c02766b638d15eb8896a36a4e0e97ae6de4, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:573) is emitted at 0x1017 by the precompile wherever the contract flow called emitFeeFlow (Launch-x:contracts/contracts/data/FeeAccumulator.sol:470), with the arguments emitFeeFlow adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:766); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_12 = "EventEmitter event `FeeDistributed(bytes32,uint256,uint8,uint256,address,uint256,uint256)` (topic0 0xf7ab826cedf9d005102eddf95e65f43597aef36a55ff09ee4f452204c83f4afc, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:42) is emitted at 0x1017 by the precompile wherever the contract flow called emitFeeDistributed (Launch-x:contracts/contracts/periphery/FeesRouter.sol:124), with the arguments emitFeeDistributed adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:388); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."

[req.2017]
title = "Optical hooks are called with the contract callers and flags"
ac_1 = "The precompile calls `getFlags()` (selector 0x6cc7149d, implemented at Launch-x:contracts/contracts/opticals/presets/LaunchpadOptical.sol:151) on the market optical through evm.Call with caller the pool address, at the point of the contract flow Launch-x:contracts/contracts/core/SidioraPool.sol:179, only when the optical flags carry every flag (Launch-x:contracts/contracts/libraries/BitFlag.sol:16); the optical code stays deployed unchanged and its sender checks pass (Launch-x:contracts/contracts/opticals/BaseOptical.sol:86)."
ac_2 = "The precompile calls `beforeSwap(address,address,bool,uint256)` (selector 0xae7e71d9, implemented at Launch-x:contracts/contracts/opticals/presets/LaunchpadOptical.sol:159) on the market optical through evm.Call with caller the pool address, at the point of the contract flow Launch-x:contracts/contracts/core/SidioraPool.sol:188, only when the optical flags carry BEFORE_SWAP (1) (Launch-x:contracts/contracts/libraries/BitFlag.sol:16); the optical code stays deployed unchanged and its sender checks pass (Launch-x:contracts/contracts/opticals/BaseOptical.sol:86)."
ac_3 = "The precompile calls `afterSwap(address,address,bool,uint256,uint256)` (selector 0xf74c1c1a, implemented at Launch-x:contracts/contracts/opticals/presets/LaunchpadOptical.sol:172) on the market optical through evm.Call with caller the pool address, at the point of the contract flow Launch-x:contracts/contracts/core/SidioraPool.sol:262, only when the optical flags carry AFTER_SWAP (2) (Launch-x:contracts/contracts/libraries/BitFlag.sol:16); the optical code stays deployed unchanged and its sender checks pass (Launch-x:contracts/contracts/opticals/BaseOptical.sol:86)."
ac_4 = "The precompile calls `beforeFeeDistribution(address,uint256)` (selector 0xf80d2cc7, implemented at Launch-x:contracts/contracts/opticals/presets/LaunchpadOptical.sol:208) on the market optical through evm.Call with caller the market generation FeeAccumulator address, at the point of the contract flow Launch-x:contracts/contracts/data/FeeAccumulator.sol:134, only when the optical flags carry BEFORE_FEE_DISTRIBUTION (4) (Launch-x:contracts/contracts/libraries/BitFlag.sol:16); the optical code stays deployed unchanged and its sender checks pass (Launch-x:contracts/contracts/opticals/BaseOptical.sol:86)."
ac_5 = "The precompile calls `afterFeeDistribution(address,uint256)` (selector 0xae3bd4bd, implemented at Launch-x:contracts/contracts/opticals/BaseOptical.sol:72) on the market optical through evm.Call with caller the market generation FeeAccumulator address, at the point of the contract flow Launch-x:contracts/contracts/data/FeeAccumulator.sol:161, only when the optical flags carry AFTER_FEE_DISTRIBUTION (8) (Launch-x:contracts/contracts/libraries/BitFlag.sol:16); the optical code stays deployed unchanged and its sender checks pass (Launch-x:contracts/contracts/opticals/BaseOptical.sol:86)."
ac_6 = "The precompile calls `beforeTokenTransfer(address,address,address,uint256)` (selector 0x37be75a0, implemented at Launch-x:contracts/contracts/opticals/presets/LaunchpadOptical.sol:179) on the market optical through evm.Call with caller the pool-token address, at the point of the contract flow Launch-x:contracts/contracts/core/SidioraERC20.sol:30, only when the optical flags carry BEFORE_TOKEN_TRANSFER (16) (Launch-x:contracts/contracts/libraries/BitFlag.sol:16); the optical code stays deployed unchanged and its sender checks pass (Launch-x:contracts/contracts/opticals/BaseOptical.sol:86)."

[req.2018]
title = "The quote asset is uusdl, the bank form of USDL, reached through the old USDL address"
ac_1 = "Params.QuoteDenom is \"uusdl\" (modules/launchpad/types/params.go:31) from H+1: MigrateV6120 sets it back from the base coin that the v6.10 handler wrote (node/upgrades.go:351), through UpdateParams (modules/launchpad/keeper/keeper.go:76)."
ac_2 = "uusdl has six decimals, the settlement asset of the deployment manifest (Launch-x:shared/config/deployment/current.json:97-Launch-x:shared/config/deployment/current.json:98); its bank metadata is set with display \"USDL\" and exponent 6, and GetERC20NativePointer(ctx, \"uusdl\") (precompiles/utils/expected_keepers.go:127) returns 0x85FcD13735F4309833A503EE804ea32395851479."
ac_3 = "Every pool, FeeAccumulator, Treasury and account holds its USDL as uusdl in the bank account of its EVM address (GetPaxAddressOrDefault, modules/evm/keeper/address.go:58), so the pay-first balance check of the pool (Launch-x:contracts/contracts/core/SidioraPool.sol:178) reads the bank balance of the pool address and contracts that call transfer on USDL keep working through the pointer."
ac_4 = "The launchpad keeper moves quote and pool tokens with BankKeeper.SendCoins (modules/launchpad/types/expected_keepers.go:16) between the bank accounts of the EVM addresses of the contract flow (caller, pool, FeeAccumulator, recipient, Treasury, `0x000000000000000000000000000000000000dEaD`); no escrow in the module account is kept for pool reserves."
ac_5 = "Router and Factory surfaces move the caller's own uusdl and pool tokens without consulting an allowance, because the caller is authenticated by the surface; the contract transferFrom calls (Launch-x:contracts/contracts/periphery/Router.sol:188, Launch-x:contracts/contracts/periphery/Router.sol:165) become bank sends from the caller, and the *WithPermit variants decode the permit tuple and then run as their plain variant."

[req.2019]
title = "Swaps reproduce the pool arithmetic, fee, volume and snapshot rules exactly"
ac_1 = "Swap checks in contract order: deadline (Launch-x:contracts/contracts/core/SidioraPool.sol:171), zero input (Launch-x:contracts/contracts/core/SidioraPool.sol:172), zero recipient (Launch-x:contracts/contracts/core/SidioraPool.sol:173), prepaid input (Launch-x:contracts/contracts/core/SidioraPool.sol:178), then the optical beforeSwap reduction rules (Launch-x:contracts/contracts/core/SidioraPool.sol:186-195), each reverting with the same custom error."
ac_2 = "The fee is taken on the input with mulDiv(amountIn, feeBps, 10000) (Launch-x:contracts/contracts/core/SidioraPool.sol:201); a buy prices amountIn minus fee against virtual plus real USDL (Launch-x:contracts/contracts/core/SidioraPool.sol:208-213), moves the fee to the FeeAccumulator of the market generation and records it (Launch-x:contracts/contracts/core/SidioraPool.sol:220-224); a sell keeps fee tokens in the pool (Launch-x:contracts/contracts/core/SidioraPool.sol:241-244)."
ac_3 = "A sell whose output exceeds real USDL reverts VirtualFloorBreached() (Launch-x:contracts/contracts/core/SidioraPool.sol:232); a buy whose output exceeds the token reserve reverts InsufficientLiquidity() (Launch-x:contracts/contracts/core/SidioraPool.sol:211); zero output reverts InsufficientInput() and output below minAmountOut reverts SlippageExceeded() (Launch-x:contracts/contracts/core/SidioraPool.sol:247-248)."
ac_4 = "USDL volume is paidInput on buys and amountOut on sells, added to cumulativeVolume and to the buy or sell cumulative field (Launch-x:contracts/contracts/core/SidioraPool.sol:250-254); the price snapshot is taken only when volume is at least 1 bps of effective USDL and 60 seconds passed since the last snapshot (Launch-x:contracts/contracts/core/SidioraPool.sol:406-415), into an eight-slot ring."
ac_5 = "After the swap the precompile emits InputAdjustment when paidInput differs from amountIn (Launch-x:contracts/contracts/core/SidioraPool.sol:257), calls afterSwap and requires its selector (Launch-x:contracts/contracts/core/SidioraPool.sol:259-263), checks the bank balances of the pool against realUsdlBalance and tokenReserve (Launch-x:contracts/contracts/core/SidioraPool.sol:268), and emits Swap at 0x1017 (Launch-x:contracts/contracts/core/SidioraPool.sol:273)."
ac_6 = "The dynamic fee uses ProtocolConfig parameters with the holder concentration term fixed at 0 (Launch-x:contracts/contracts/core/SidioraPool.sol:375-396) through FeeLib (Launch-x:contracts/contracts/libraries/FeeLib.sol:22), which the keeper implements in CalculateDynamicFee (modules/launchpad/types/math.go:179)."
ac_7 = "syncReserves sets realUsdlBalance and tokenReserve to the bank balances of the pool address and emits PoolStateUpdated at 0x1017 (Launch-x:contracts/contracts/core/SidioraPool.sol:279-291)."

[req.2020]
title = "Market creation mints a pool token, a pool surface and a fee right as the Factory did"
ac_1 = "createMarket through the Router or Factory surface or 0x1017 validates name and symbol (modules/launchpad/types/market.go:36), charges the creation fee in uusdl from the caller to the Treasury address of the generation 2 Factory (Factory slot 6, the field at Launch-x:contracts/contracts/core/SidioraFactory.sol:30), and reverts with the contract error when the fee cannot be paid."
ac_2 = "The pool token is a tokenfactory denom with subdenom \"lp\"+index (modules/launchpad/keeper/market.go:18) minted to the pool account with the virtual token default supply; its ERC20 address is the native pointer from UpsertERCNativePointer (modules/evm/keeper/pointer_upgrade.go:49) when the optical has no BEFORE_TOKEN_TRANSFER flag, and a token surface at the CREATE2 address of 0x1017 with salt keccak256(name,symbol,creator,nonce) (Launch-x:contracts/contracts/core/SidioraFactory.sol:121) otherwise."
ac_3 = "The pool address of a new market is the CREATE2 address of 0x1017 with salt keccak256(token) (Launch-x:contracts/contracts/core/SidioraFactory.sol:143) and the surface runtime hash, registered as a surface and in the PoolRegistry role at 0x1017 with metadata creator, token, optical, nftId, createdAt and createdBlock (Launch-x:contracts/contracts/interfaces/IPoolRegistry.sol:15)."
ac_4 = "The fee right is minted in the generation 2 collection with id nextTokenId (collection slot 11) and its fee strategy (slot 12) and pool (slot 13); NftMint, TokenDeployed, MarketCreated and PoolRegistered are emitted at 0x1017 in the contract order (Launch-x:contracts/contracts/core/SidioraFactory.sol:159, Launch-x:contracts/contracts/core/SidioraFactory.sol:160)."

[req.2021]
title = "Fees split, accrue and distribute as FeeAccumulator and FeesRouter did"
ac_1 = "recordFee splits the buy fee into protocol cut protocolFeeBps/10000 and pool cut, applies the optical beforeFeeDistribution adjustment with InsufficientSurplus when it raises the pool cut (Launch-x:contracts/contracts/data/FeeAccumulator.sol:135), calls afterFeeDistribution and requires its selector (Launch-x:contracts/contracts/data/FeeAccumulator.sol:161) and emits FeeRecorded (Launch-x:contracts/contracts/data/FeeAccumulator.sol:164) at the generation FeeAccumulator address."
ac_2 = "claim pays the accumulated pool fees to the recipient and reverts NoFeesAccumulated() at zero (Launch-x:contracts/contracts/data/FeeAccumulator.sol:169-184); burn sends them to `0x000000000000000000000000000000000000dEaD` (Launch-x:contracts/contracts/data/FeeAccumulator.sol:187-200); sendLpRewards moves them to the pool reserve (Launch-x:contracts/contracts/data/FeeAccumulator.sol:272-286)."
ac_3 = "The FeesRouter role checks the caller holds the fee right of the pool in the collection of its market (ownerOf) and the strategy of that fee right, and emits FeeDistributed at 0x1017 (Launch-x:contracts/contracts/periphery/FeesRouter.sol:124); the keeper requireFeeRightsHolder (modules/launchpad/keeper/fees.go:12) reads the fee-right store keyed by collection and id."
ac_4 = "Each FeeAccumulator role keeps totalLiabilities and requires its uusdl bank balance to cover it plus the new amount (Launch-x:contracts/contracts/data/FeeAccumulator.sol:478-480); the mirror FeeFlow event is emitted at 0x1017 (Launch-x:contracts/contracts/data/FeeAccumulator.sol:470)."

[req.2022]
title = "Airdrops snapshot holdings and pay pro rata with the contract rounding"
ac_1 = "triggerAirdrop opens epoch e+1 for the pool with the airdrop balance, the eligible supply and the snapshot height (Launch-x:contracts/contracts/data/FeeAccumulator.sol:203-230); the keeper records the epoch through OpenHoldingHistory (modules/launchpad/keeper/history.go:83)."
ac_2 = "claimAirdrop pays holder balance at the snapshot times the epoch amount over the eligible supply, refuses the pool, the `0x000000000000000000000000000000000000dEaD` address and zero (Launch-x:contracts/contracts/data/FeeAccumulator.sol:250), refuses a second claim with AlreadyClaimed() (Launch-x:contracts/contracts/data/FeeAccumulator.sol:251) and gives the rounding residue to the final claimant (Launch-x:contracts/contracts/data/FeeAccumulator.sol:248-269); balances at the snapshot come from EpochBalance (modules/launchpad/keeper/history.go:155)."
ac_3 = "Open airdrop epochs of migrated pools keep their snapshot: MigrateV6120 writes each holder entitlement from the token checkpoint array (SidioraERC20 slot 6) at airdropSnapshotBlock (FeeAccumulator slot 15) into the airdrop basis store (modules/launchpad/keeper/keeper.go:302), so a claim after the upgrade pays what the contract would have paid."
ac_4 = "claimLegacyAirdrop verifies the Merkle proof over keccak256(pool, epoch, holder, amount) (Launch-x:contracts/contracts/data/FeeAccumulator.sol:453) against legacyAirdropRoot (slot 23) and legacyAirdropRemaining (slot 24), both migrated."

[req.2023]
title = "Step 1 of MigrateV6120 turns the USDL ERC20 into bank uusdl with a native pointer at its address"
ac_1 = "migrateUSDL reads the holder list of modules/launchpad/keeper/testdata/v6120/holders.json, reads each balance from the USDL contract storage with GetState (modules/evm/keeper/state.go:10) at keccak256(holder, balanceSlot), with the balance slot and total-supply slot taken from modules/launchpad/keeper/testdata/v6120/usdl.json, and refuses with \"upgrade v6.12.0: launchpad: usdl holder list incomplete\" when the sum differs from the total-supply slot."
ac_2 = "For each holder with a nonzero balance it mints the balance in uusdl to the launchpad module account and sends it to the bank account of the holder address (modules/evm/keeper/address.go:58); the bank supply of uusdl after the step equals the total-supply slot exactly."
ac_3 = "The step clears the storage of the old USDL address with IterateState and SetState (modules/evm/keeper/state.go:39, modules/evm/keeper/state.go:30), records 0x85FcD13735F4309833A503EE804ea32395851479 as the native pointer of uusdl with SetERC20NativePointer (modules/evm/keeper/pointer.go:29) and then runs UpsertERCNativePointer, whose existing-pointer branch writes the pointer runtime at that address (modules/evm/keeper/pointer_upgrade.go:101-108)."
ac_4 = "Allowances and permit nonces of the USDL contract are not migrated: `allowance(address,address)` returns 0 after the step and holders approve again; the migration record of contracts/launchpad.md lists both."
ac_5 = "The step runs before pool migration inside MigrateV6120, its module account needs Minter permission and BankKeeper needs MintCoins (required change to modules/launchpad/types/expected_keepers.go:15), and the uusdl bank metadata (base uusdl, display USDL, exponent 6) is written once."

[req.2024]
title = "Step 2 migrates every generation 1 and generation 2 pool and its pool token"
ac_1 = "migratePools lists the pools of each generation from the PoolRegistry _allPools array (slot 6, Launch-x:contracts/contracts/data/PoolRegistry.sol:23) of 0x7684…BA0b and 0x1dC3…4Ba7 and refuses when a pool code hash is not the code hash of a generation pool proxy recorded in modules/launchpad/keeper/testdata/v6120/layout.json."
ac_2 = "Each pool state field is read from its slot (tokenAddress 0, usdlAddress 1, opticalAddress 2, feeAccumulator 3, eventEmitter 4, protocolConfig 5, guardian 6, virtualUsdlReserve 7, realUsdlBalance 8, tokenReserve 9, creationTimestamp 10, cumulativeVolume 11, priceSnapshots 12-19, snapshotIndex 20, snapshotCount 21, accumulatedUsdlFees 22, accumulatedTokenFees 23, factory 24, pendingGuardian 25, lastSnapshotTimestamp 26, cumulativeBuyUsdlVolume 27, cumulativeSellUsdlVolume 28) as layout.json records them for the generation implementation, into the keeper Market record."
ac_3 = "Each pool token becomes the tokenfactory denom of its market: holders from holders.json are verified against balanceOf (SidioraERC20 slot 3, Launch-x:contracts/contracts/base/ERC20Base.sol:13) with their sum equal to totalSupply (slot 2), the balances are minted to the holder accounts, and the old token address becomes the native pointer of the denom or, for markets with the BEFORE_TOKEN_TRANSFER flag, a token surface."
ac_4 = "The uusdl balance of each pool address after step 1 equals its realUsdlBalance plus any surplus the contract held, and the pool-token balance of the pool address equals its tokenReserve plus surplus, so InvalidBalance (Launch-x:contracts/contracts/core/SidioraPool.sol:268) holds for every migrated pool."
ac_5 = "Pool-token allowances (slot 4), permit nonces (slot 5) and the checkpoint arrays (slots 6 and 7) are not carried as storage; past balances needed by open airdrop epochs are written as entitlements, and getPastBalance, getPastTotalSupply, getPastVotes, permit, nonces, DOMAIN_SEPARATOR and PERMIT_TYPEHASH are listed as not served in the migration record."

[req.2025]
title = "Step 3 migrates fee rights, roles, FeeAccumulator accounting and optical bindings"
ac_1 = "Fee rights of both collections migrate keyed by (collection, id): holder from _owners (slot 2), approval from _tokenApprovals (slot 4), operator approvals from _operatorApprovals (slot 5) for the operators listed in the fixture, strategy from _feeStrategy (slot 12), pool from _poolAddress (slot 13) and nextTokenId (slot 11), declared at Launch-x:contracts/contracts/core/SidioraNFT.sol:30 and its base Launch-x:contracts/contracts/base/ERC721Base.sol:11."
ac_2 = "Role memberships other than DEFAULT_ADMIN_ROLE migrate from each role _roles mapping (slot 0, or slot 10 in the collection) for the accounts listed in the fixture and verified by storage read; DEFAULT_ADMIN_ROLE is not carried, so registeredDefaultAdminCount() returns 0 at every role address."
ac_3 = "FeeAccumulator accounting migrates per generation: _accumulatedFees, _protocolFeesPending, _airdropBalance, _airdropEpoch, _airdropEpochAmount, _airdropClaimed (for the fixture claimants), _lpRewardsBalance, _opticalSurplus, totalLiabilities, the airdrop snapshot fields (slots 15 to 18), accountingInitialized and the legacy airdrop fields (slots 22 to 24)."
ac_4 = "Each pool keeps its optical address; optical contracts stay deployed and unchanged and are called by the precompile with the callers they accept (Launch-x:contracts/contracts/opticals/BaseOptical.sol:86), and the PoolRegistry metadata (slot 4) of every pool migrates with nftId, createdAt and createdBlock."
ac_5 = "MigrateV6120 returns its first error wrapped as \"upgrade v6.12.0: launchpad: <error>\" by the caller in the upgrade handler; it writes nothing outside the launchpad, bank and EVM stores, and the whole migration is one cached context committed only on success."

[req.2026]
title = "Gas follows the existing schedule extended to every served method"
ac_1 = "RequiredGas stays Gas(inputBytes, writes, pointers) with BaseGas 3000, GasPerByte 16, GasPerWrite 5000 and GasPerPointer 9000000 (precompiles/launchpad/launchpad.go:15-18, precompiles/launchpad/launchpad.go:224), and the Writes table (precompiles/launchpad/launchpad.go:196) lists every state-changing method of the ten roles."
ac_2 = "Pointers counts 1 for createMarket and createMarketWithPermit, the methods that register a new pointer (precompiles/launchpad/launchpad.go:216); nested evm.Call gas for optical hooks is metered by the EVM, as the xweb precompile meters its callback (precompiles/xweb/xweb.go:482)."
ac_3 = "The current pinned gas test (precompiles/launchpad/launchpad_test.go:177) moves to the legacy version with its precompile and keeps its values there."

[req.2027]
title = "The new precompile is served from the v6.12.0 height and the previous one is kept below it"
ac_1 = "GetVersioned (precompiles/launchpad/setup.go:10) returns the new precompile for the latest upgrade and the current one under \"v6.10\" from precompiles/launchpad/legacy/v610, following the pattern of precompiles/p256/setup.go:22; precompiles/launchpad/versions gains v6.12.0 after v6.5 (precompiles/launchpad/versions:1)."
ac_2 = "0x1017 stays behind activationPrecompileGate (node/upgrades.go:498), the registration of precompiles/setup.go:14 is unchanged, and the plan names v6.9 (node/upgrades.go:93) and v6.10 (node/upgrades.go:102) stay as they are."
ac_3 = "The v6.12.0 handler calls launchpad MigrateV6120 first and then pricefeed InitV6120, perps SeedV6120 and spot InitV6120, wrapping each error as \"upgrade v6.12.0: <hook>: <error>\"; this domain supplies MigrateV6120 and its EVMReader interface only."

[req.2028]
title = "Invariants bind bank balances to the contract accounting"
ac_1 = "SolvencyInvariant (modules/launchpad/keeper/invariants.go:20) checks, for every market, that the uusdl bank balance of the pool address is at least realUsdlBalance and the pool-token balance is at least tokenReserve, the condition of Launch-x:contracts/contracts/core/SidioraPool.sol:268."
ac_2 = "A second invariant checks that the uusdl bank balance of each FeeAccumulator address is at least its totalLiabilities, the condition of Launch-x:contracts/contracts/data/FeeAccumulator.sol:478-480, and is registered in RegisterInvariants (modules/launchpad/keeper/invariants.go:13)."
ac_3 = "The pool-token supply of every market equals the sum of holder balances, and the bank supply of uusdl changes only by mint in step 1 of MigrateV6120 and by sends afterwards."

[req.2029]
title = "Module parameters equal the ProtocolConfig values of the active generation"
ac_1 = "DefaultParams (modules/launchpad/types/params.go:34) sets ConcentrationWeight 0 and CreationFee 1000000, the ProtocolConfig values (Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:45-54); today it holds 100 and 100000000, a required change."
ac_2 = "MigrateV6120 writes the parameters read from the generation 2 ProtocolConfig storage (slots 2 to 11) and refuses when they fail Validate (modules/launchpad/types/params.go:50)."
ac_3 = "Validate adds the ProtocolConfig bounds: concentrationWeight must be 0 (Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:84), virtual defaults fit uint112 (Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:100), protocolFeeBps at most 5000 (modules/launchpad/types/params.go:11) and baseFeeBps within min and max (Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:60)."
ac_4 = "Parameters change only through MsgUpdateParams from the governance authority (modules/launchpad/keeper/msg_server.go:14), which emits ConfigUpdated at 0x1017 for each changed key."

[req.2030]
title = "The intents crate decodes the launchpad events of the new interface"
ac_1 = "The launchpad decode of the intents crate (human/crates/layerx-intents/src/precompile.rs:557) decodes the twelve EventEmitter launchpad events emitted at LAUNCHPAD_PRECOMPILE (human/crates/layerx-intents/src/precompile.rs:24) and PrecompileEventKind (human/crates/layerx-intents/src/precompile.rs:28) lists them with their topic0."
ac_2 = "The intent map (human/crates/layerx-intents/src/precompile.rs:1005-1014) maps Swap to LaunchpadSwap, MarketCreated to LaunchpadCreate, FeeStrategyChanged to LaunchpadFeeStrategy and FeeDistributed by strategy to LaunchpadFeesClaim, LaunchpadFeesBurn, LaunchpadAirdropExecute and LaunchpadLpRewards, with the vocabulary variants of human/crates/layerx-intents/src/vocabulary.rs:134-145."
ac_3 = "every_abi_event_is_declared_with_its_computed_topic (human/crates/layerx-intents/tests/precompile_router.rs:203) keeps passing with LAUNCHPAD_ABI (human/crates/layerx-intents/tests/precompile_router.rs:26) now the new abi.json."

[req.2031]
title = "The hosted indexer and gateway read the new launchpad interface"
ac_1 = "The hosted indexer registry entry (\"launchpad\", 0x1017) (platform/hosted/indexer/src/abi.rs:41) loads the new abi.json, and signatures_and_topics_match_solidity (platform/hosted/indexer/src/abi.rs:637) covers the twelve launchpad events."
ac_2 = "The gateway launchpad probe changes from getMarketCount() (platform/hosted/gateway/src/capabilities.rs:40) to getPoolCount() of the new interface, selector 0x8eec5d70, sent to LAUNCHPAD_PRECOMPILE (platform/hosted/gateway/src/evm.rs:47), and its answer still decodes as one word (platform/hosted/gateway/src/capabilities.rs:87)."
ac_3 = "The indexer ingest test replays a Swap and a MarketCreated log at 0x1017 and stores one row each."

[req.2032]
title = "The launchpad backend binds the precompile through its manifest roles"
ac_1 = "The deployment manifest gains role kind \"precompile\" for roles served at 0x1017: Validate (Launch-x:shared/config/deployment/manifest.go:113) accepts it for the nine contract roles, exempts it from role_address_conflict (Launch-x:shared/config/deployment/manifest.go:160) and from the runtime hash check, and requires the implementation fields to be empty as for \"direct\" (Launch-x:shared/config/deployment/manifest.go:177)."
ac_2 = "current.json (Launch-x:shared/config/deployment/current.json:107) gains a third generation entry with the nine roles at 0x1017 kind \"precompile\", SidioraNFT kept at the generation 2 collection with kind \"surface\", USDL kept at 0x85FcD13735F4309833A503EE804ea32395851479 kind \"direct\" (Launch-x:shared/config/deployment/current.json:86), and settlement USDL six decimals unchanged."
ac_3 = "The decode registry (Launch-x:core/indexer/internal/decode/registry.go:158) accepts several roles at one address with overlapping epochs when the deployment kind is \"precompile\" and dispatches each log by topic0 to its role, instead of refusing (Launch-x:core/indexer/internal/decode/registry.go:234)."
ac_4 = "parseContractAddresses (Launch-x:shared/chain/contracts.go:67) accepts the same address for several roles, and CreateContracts (Launch-x:shared/chain/contracts.go:93) binds each role to 0x1017 with its role ABI."
ac_5 = "protocol/addresses.go keeps the generation 1 addresses (Launch-x:protocol/addresses.go:23) for historical decoding and adds the precompile address as the active address of the nine roles."

[req.2033]
title = "The domain completes with the launchpad package set passing"
ac_1 = "Task 2.3.99 runs go test ./modules/launchpad/... ./precompiles/launchpad/... once after every other task of the domain is done."
ac_2 = "TestLaunchpadDomainWiring builds the keeper and the precompile together and runs createMarket, buy, sell, claimFees and a migrated pool read in one store."

