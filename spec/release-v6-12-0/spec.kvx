do_1 = "spot.go registers every event of the Events heading of contracts/spot.md from the ABIs that precompiles/spot exports, at PECOR 0x1021, PECOROrders 0x1022, PECORStopOrders 0x1023, PECORVault 0x1025 and the share pointer addresses that spot_tokens holds from ShareTokenCreated, named as the Hyperpax spot ABI names them, from MarketOrderExecuted (Hyperpax:src/core/network/spot_abi/PECOR.ts:852) to Transfer at the share pointers (Hyperpax:src/core/network/spot_abi/PECORVaultShare.ts:319); no decoder is registered for BestRouteSwap or MultiHopSwap of the PECORRouter ABI because 0x1027 carries no code."
do_2 = "PECORQuoter 0x1024 is view-only and has no decoder; a log from it is a raw_logs row with decoded false (contracts/data-services.md:429)."
do_3 = "oracle.go registers PriceUpdated, PricesUpdated and MaxPriceStalenessUpdated (Hyperpax:src/core/network/abi/OracleFacet.json:82, Hyperpax:src/core/network/abi/OracleFacet.json:107, Hyperpax:src/core/network/abi/OracleFacet.json:18) at the oracle address 0x1020 from the ABI the oracle precompile exports; PricesUpdated expands into one oracle_prices row per array element with element index as the sub key."
do_4 = "A PricesUpdated whose marketIds and prices arrays differ in length is refused by the decoder and written as a raw_logs row with decoded false and failure_class length_mismatch (contracts/data-services.md:429)."
do_5 = "Add TestSpotDecoders with one subtest per spot event and per oracle event, packing the arguments with the exported ABIs and asserting the typed rows, plus quoter_log and prices_length_mismatch (contracts/data-services.md:429)."

[capability.7.2.4]
title = "Fact writers in one transaction per block"
reqs = ["7006.1", "7006.2", "7006.3", "7006.4", "7006.5"]
touches = ["platform/perps-data/internal/store/facts.go", "platform/perps-data/internal/store/facts_test.go"]
tests = ["platform/perps-data/internal/store/facts_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/internal/store/ -run TestFactWriters"
do_1 = "Add store.WriteBlock(ctx, tx, block, rows) that inserts the perps.blocks row, every decoded fact row and every raw_logs row of the block and advances perps.cursors, in the order of CommitCanonical (Launch-x:core/indexer/internal/store/canonical.go:66) and under the single-writer lease of AcquireLease (Launch-x:core/indexer/internal/store/canonical.go:257)."
do_2 = "Inserts use ON CONFLICT (tx_hash, log_index) DO NOTHING, so a block written twice leaves one row per log and the second write changes nothing (contracts/data-services.md:420)."
do_3 = "Every decoded row also lands in perps.protocol_events (event_name, args jsonb) and every venue transaction in perps.tx_actions with its explorer action; the watermark read of GetCanonicalWatermark (Launch-x:core/indexer/internal/store/canonical.go:453) becomes store.Cursor."
do_4 = "Each fact row is enqueued on the outbox in the same transaction through delivery.Store.Enqueue (Launch-x:shared/delivery/store.go:137), so a row exists in Postgres if and only if its message is pending or published."
do_5 = "Add TestFactWriters with subtests one_row_per_log, duplicate_block_noop, outbox_in_same_tx, cursor_advances and lease_refuses_second_writer against PERPS_DATA_TEST_DATABASE_URL (contracts/data-services.md:420)."

