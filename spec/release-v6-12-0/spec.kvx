[feature.2]
name = "launchpad"
scope = "The launchpad of Paxeer X Network at 0x1017 rebuilt to the exact interface of the Launch-x contracts of the manifest-active generation, with uusdl as the bank form of USDL, opticals, ERC721 fee rights and ERC20 pool tokens, and the v6.12.0 migration of every generation 1 and generation 2 pool into it."
requirements = ["2001", "2002", "2003", "2004", "2005", "2006", "2007", "2008", "2009", "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "2025", "2026", "2027", "2028", "2029", "2030", "2031", "2032", "2033"]
completion_task = "2.3.99"

[req.2001]
title = "The interface is frozen as one ABI file per contract role with a golden selector file"
ac_1 = "precompiles/launchpad/abi/ holds the compiled ABI of each of the ten served roles (SidioraPool, SidioraFactory, SidioraERC20, SidioraNFT, Router, Quoter, FeesRouter, FeeAccumulator, PoolRegistry, ProtocolConfig) copied from the Launch-x build at c5eb7c7 (the sources of Launch-x:contracts/contracts), and each file is loaded with MustGetABI (precompiles/common/precompiles.go:449) through the embed.FS of precompiles/launchpad/launchpad.go:94."
ac_2 = "precompiles/launchpad/testdata/abi_golden.txt lists one line per function (role, signature, 4-byte selector), per event (role, signature, topic0) and per custom error (role, signature, selector), 547 lines for the ten roles plus the twelve EventEmitter launchpad events; any change to a role file that alters a line fails the test."
ac_3 = "precompiles/launchpad/abi.json becomes the ABI of direct calls to 0x1017: the union of the Router, SidioraFactory, Quoter, PoolRegistry, FeesRouter, FeeAccumulator and ProtocolConfig functions taken in that order with the first role winning a shared signature (113 distinct selectors, the 22 shared signatures listed in contracts/launchpad.md section 3), plus the twelve EventEmitter launchpad events; the current abi.json and Launchpad.sol (precompiles/launchpad/launchpad.go:94) move to precompiles/launchpad/legacy/v610."
ac_4 = "Two signatures with one selector never appear in one role or at 0x1017; the golden test asserts the selector set of each role and of 0x1017 has no duplicate."

[req.2002]
title = "Contract addresses become surfaces that forward to 0x1017 with the caller appended"
ac_1 = "MigrateV6120 replaces the runtime code at every pool address of generations 1 and 2, at both fee-right collections and at the Factory, Router, Quoter, FeesRouter, FeeAccumulator, PoolRegistry and ProtocolConfig addresses of both generations (Launch-x:protocol/addresses.go:22, Launch-x:shared/config/deployment/current.json:37) with the 41-byte surface runtime 0x363d3d373360601b36523d3d601436013d3d6110175af13d600060003e6024573d6000fd5b3d6000f3, written with SetCode (modules/evm/keeper/code.go:23); the runtime copies calldata, appends CALLER and CALLs 0x1017 with all gas, returning or reverting with the callee data."
ac_2 = "The precompile treats the last 20 bytes of calldata as the original caller only when its own caller is a registered surface address (a keeper set written by MigrateV6120 and by market creation, keyed as MarketPointerPrefix is in modules/launchpad/types/keys.go:41); for any other caller the calldata is decoded whole and the caller is the EVM caller, so no account can claim another caller by appending bytes."
ac_3 = "A call arriving from a surface selects the role ABI of that surface (pool, collection, token, or the generation role of the address) and the market generation of the address, so the same selector resolves per role; direct calls to 0x1017 resolve through abi.json in the order Router, SidioraFactory, Quoter, PoolRegistry, FeesRouter, FeeAccumulator, ProtocolConfig."
ac_4 = "Delegatecall into 0x1017 reverts and a write under staticcall reverts, as precompiles/launchpad/launchpad.go:232 does today; a view selector under staticcall is served; value attached to any call reverts, matching ValidateNonPayable (precompiles/common/precompiles.go:374) and the non-payable functions of the contracts (the only payable function, upgradeToAndCall, reverts for every caller)."
ac_5 = "An unknown selector at a surface or at 0x1017 reverts with empty revert data, as a contract without a fallback does; the registered surface set is exported and imported by genesis (modules/launchpad/keeper/genesis.go:53)."

[req.2003]
title = "The SidioraPool surface serves every SidioraPool function"
