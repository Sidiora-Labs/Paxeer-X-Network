do_4 = "Add tools/release/tests/workflows.test.sh that loads both files with python3 and yaml.safe_load and asserts check_installs_rust, publish_installs_rust, check_pins_cc, publish_title_names_paxeer_x, publish_tag_must_match_version (running the validate script of .github/workflows/paxeer-release-publish.yml:33-44 with RELEASE_TAG paxeer-network/v6.12.1), check_paths_cover_native_inputs and identity_greps_v6120_constant."
do_5 = "Change the build-essential steps of .github/workflows/paxeer-release-check.yml:72-75 and .github/workflows/paxeer-release-publish.yml:49-52 to install the compiler version of tools/release/toolchain.env and print cc -dumpfullversion."

