capabilities = ["9.0.1"]
do_1 = "Create tools/spec/check_resolutions.py with load(path) reading spec/<feature>/spec.kvx under the section, key and quoted-list rules of tools/specgen/kvx.go:45-84 (parse) and tools/specgen/kvx.go:228-244 (splitList), so a list value parses as the Go reader parses it."
do_2 = "Add known_ids(doc) returning the ids of every [task.*] and [capability.*] section, and resolve(ref, ids) that accepts an exact id or a wildcard <prefix>.* matching at least one id; the clause rule of tools/specgen/validate.go:132-148 stays as it is for the repository linter."
do_3 = "Add check(doc) that reports resolution.<id>: unknown <ref> for every unresolved applies_to id, resolution.<id>: applies to no task when none of its ids is a task, and decision.<N>: no resolution when no source equals decision D<N>, then exits 1 when any line was printed and 0 otherwise."
do_4 = "Accept --feature <slug> to pick spec/<slug>/spec.kvx in place of the active feature that tools/specgen/main.go:57 reads from workflow.kvx, and print one summary line resolutions <n> decisions <m> unresolved <k>."
do_5 = "Create tools/spec/check_resolutions_test.py with test_unknown_id_fails, test_wildcard_needs_a_match, test_decision_without_resolution_fails and test_release_feature_passes over small kvx strings and the real spec/release-v6-12-0/spec.kvx."
do_6 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["load", "known_ids", "resolve", "check", "main", "test_unknown_id_fails", "test_wildcard_needs_a_match", "test_decision_without_resolution_fails", "test_release_feature_passes"]
touches = ["tools/spec/check_resolutions.py", "tools/spec/check_resolutions_test.py"]
build_cmd = "python3 -m py_compile tools/spec/check_resolutions.py tools/spec/check_resolutions_test.py"
verify_cmd = "python3 tools/spec/check_resolutions.py --feature release-v6-12-0"
gate_kind = "planned"
planned_paths = ["tools/spec/check_resolutions.py", "tools/spec/check_resolutions_test.py"]
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark complete without the declared evidence."
path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to their current equivalents before the gate can run; historical references never authorize a duplicate implementation tree. Complete scoped path reconciliation without dropping acceptance criteria."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."
