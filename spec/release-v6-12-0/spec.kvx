touches = ["Hyperpax:src/core/network/gateway.ts", "Hyperpax:src/core/perps/config.ts", "Hyperpax:src/core/spot/api.ts", "Hyperpax:src/core/perfdb/client.ts"]
tests = ["Hyperpax:tests/gateway-config.test.ts"]
verification_contract = "node --test --import tsx tests/gateway-config.test.ts"
do_1 = "Derive INDEXER_BASE_URL and REST_API_URL (Hyperpax:src/core/perps/config.ts:23-25, :33) from gatewayUrls(), keeping the orderbook, open-interest and ticker paths (Hyperpax:src/widgets/trading/Orderbook.tsx:148, Hyperpax:src/hooks/perps/useQuoter.ts:54, :82)."
do_2 = "Derive SPOT_API_BASE (Hyperpax:src/core/spot/api.ts:14-16) from gatewayUrls().spotApiBase, keeping the user routes of :283-361."
do_3 = "Derive PERFDB_URL and PERFDB_GRAPHQL (Hyperpax:src/core/perfdb/client.ts:12-14, :117-120) from gatewayUrls(), keeping the auth paths of Hyperpax:src/hooks/perps/usePerfdbAuth.ts:168, :175 and :201."
do_4 = "Keep FEED_ORIGIN and candleFeedUrl (Hyperpax:src/core/feeds.ts:2, :8-14) for chart candles."
symbols = ["gatewayUrls", "REST_API_URL", "SPOT_API_BASE", "PERFDB_URL"]

[capability.6.5.2]
title = "WebSocket snapshot and sequence resume"
reqs = ["6015.1", "6015.2", "6015.3", "6015.4", "6015.5", "6015.6"]
touches = ["Hyperpax:src/core/net/orderbookStream.ts", "Hyperpax:src/widgets/trading/Orderbook.tsx", "Hyperpax:src/hooks/perps/useMarketsStream.ts", "Hyperpax:src/hooks/perps/useSidPaxMarketStream.ts", "Hyperpax:src/hooks/spot/useSpotMarketStream.ts", "Hyperpax:src/hooks/spot/useSpotUserStream.ts", "Hyperpax:src/hooks/chain/useExplorerStream.ts"]
tests = ["Hyperpax:tests/orderbook-stream.test.ts", "Hyperpax:tests/realtime.test.ts"]
verification_contract = "node --test --import tsx tests/orderbook-stream.test.ts"
do_1 = "Create src/core/net/orderbookStream.ts holding one shared socket per gateway origin, the subscribe frame {event, topic} of Hyperpax:data_api.md:29 and the per-topic book state."
do_2 = "Replace the action and channel subscribe frame of Hyperpax:src/widgets/trading/Orderbook.tsx:230-235 with a subscription to <SYMBOL>@perp_orderbook (Hyperpax:data_api.md:341) through the shared stream."
do_3 = "Pass every frame through sequenceGuard (Hyperpax:src/core/net/realtime.ts:29-47); on a gap close with code 4000 as Hyperpax:src/hooks/perps/useSidPaxMarketStream.ts:294 does, fetch the REST snapshot, resubscribe and drop deltas at or below the snapshot seq."
do_4 = "Drop all topic state when snapshotId changes (Hyperpax:data_api.md:70-82) and reconnect through scheduleActive and watchSocket (Hyperpax:src/core/net/realtime.ts:8-22, :50-87)."
do_5 = "Derive MARKETS_WS_URL (Hyperpax:src/hooks/perps/useMarketsStream.ts:29), the stream URLs of Hyperpax:src/hooks/perps/useSidPaxMarketStream.ts:70, Hyperpax:src/hooks/spot/useSpotMarketStream.ts:34, EXPLORER_WS_URL (Hyperpax:src/hooks/chain/useExplorerStream.ts:29) and SPOT_USER_WS_URL (Hyperpax:src/hooks/spot/useSpotUserStream.ts:32-34) from gatewayUrls()."
symbols = ["orderbookStream", "sequenceGuard", "watchSocket", "scheduleActive", "MARKETS_WS_URL"]

