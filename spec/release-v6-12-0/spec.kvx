[capability.4.2.1]
title = "Add the spot module keys and the governed parameter set with its validation"
reqs = ["4008.1", "4008.2", "4008.3", "4008.4", "4008.5", "4008.6", "4008.7", "4008.8", "4008.9", "4008.10", "4008.11", "4008.12", "4008.13", "4008.14", "4008.15", "4008.16", "4008.17", "4008.18", "4008.19", "4008.20", "4008.21", "4008.22", "4008.23", "4008.24", "4008.25", "4008.26", "4008.27", "4008.28", "4008.29", "4008.30", "4008.31", "4008.32", "4008.33", "4008.34", "4008.35", "4008.36", "4008.37", "4008.38", "4008.39", "4012.1", "4012.2", "4012.3", "4012.4", "4012.5", "4012.6", "4012.7", "4012.8", "4012.9", "4012.10", "4012.11", "4012.12", "4012.13", "4012.14", "4012.15", "4012.16", "4012.17", "4012.18", "4012.19", "4012.20", "4012.21", "4012.22", "4012.23", "4012.24", "4012.25", "4012.26", "4012.27", "4012.28", "4012.29", "4012.30", "4012.31", "4012.32", "4012.33", "4012.34", "4012.35", "4012.36", "4012.37", "4012.38", "4012.39", "4012.40", "4012.41", "4012.42", "4012.43", "4012.44", "4012.45", "4012.46", "4012.47", "4012.48", "4012.49", "4012.50", "4012.51", "4012.52", "4012.53", "4012.54", "4012.55", "4012.56", "4021.1", "4021.2", "4021.3", "4021.4", "4021.5", "4008.40", "3.2"]
touches = ["modules/spot/types/keys.go", "modules/spot/types/params.go", "modules/spot/types/params_test.go"]
tests = ["modules/spot/types/params_test.go"]
verification_contract = "go test ./modules/spot/types/ -run '^(TestParamsValidate|TestParamsValidateBounds)$'"
do_1 = "Add modules/spot/types/keys.go with ModuleName \"spot\", StoreKey, the rail addresses 0x...1021 to 0x...1025 and the one-byte store prefixes 0x01 to 0x14 of contracts/spot.md#storage, in the shape of modules/launchpad/types/keys.go:7-48."
do_2 = "Add Params in modules/spot/types/params.go with swapFeeBps, tier1FeeBps, tier2FeeBps, priceImpactEnabled, priceImpactScalarBps, the order pricing set orderFeeBps, orderTier1FeeBps, orderTier2FeeBps, orderPriceImpactEnabled and orderPriceImpactScalarBps, feeCollector, swapPaused, ordersPaused, keeperOpen, keepers, fillQualityTwapPeriod, twapSanityEnabled, twapSanityPeriod, maxTwapDeviationBps, twapMaxPeriod, minOrderNotional, maxActiveOrdersPerUser, maxExpiriesPerBlock, activationScanPerBlock, fillScanPerBlock, maxFillsPerBlock, maxFillBackoffBlocks and tokens, beside launchpad Params (modules/launchpad/types/params.go:16)."
do_3 = "TokenParams carries address, kind (TokenKind ERC20 or NATIVE), isStablecoin, decimals, pricefeed marketId, paused and maxUtilizationBps; DefaultParams (modules/launchpad/types/params.go:34 shape) takes its fee values from contracts/perps-parameters.md#spot-fees and the other defaults of contracts/spot.md#governance-parameters: minOrderNotional 10e18, maxActiveOrdersPerUser 100, EndBlock budgets 200, 500, 500 and 200, maxFillBackoffBlocks 256, cap 9000 for the opening tokens and DEFAULT_MAX_UTILIZATION_BPS 10000 otherwise."
do_4 = "Params.Validate (modules/launchpad/types/params.go:50 shape) returns FeeTooHigh and Tier2BelowTier1 by the rules of Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:187-205, ScalarTooHigh by Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:208-216, the order pricing set bounds of Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:502-509 (Tier2BelowTier1, FeeExceedsMax, ScalarTooHigh), InvalidTWAPPeriod, ZeroAddress and TokenAlreadyRegistered, and refuses a zero EndBlock budget, a zero maxActiveOrdersPerUser, a zero maxFillBackoffBlocks, a maxUtilizationBps of 0 or above 10000 and a token without a kind; the UpdateParams handler also refuses a NATIVE token whose address is not a native pointer."
do_5 = "TestParamsValidate covers each fee and TWAP refusal and TestParamsValidateBounds each budget, cap and kind refusal, both checking that DefaultParams validates, as the launchpad parameter tests do for Params.Validate (modules/launchpad/types/params.go:50)."

[capability.4.2.2]
