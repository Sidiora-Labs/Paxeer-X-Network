ac_6 = "The PerfDB REST routes /v2/alerts and DELETE /v2/alerts/<id> (Hyperpax:src/hooks/perps/usePerfdbAlerts.ts:138, :154-155), /v2/referrals/generate and /v2/referrals/apply (Hyperpax:src/hooks/perps/usePerfdbReferrals.ts:178-179, :194), /v2/competitions/<id>/join (Hyperpax:src/hooks/perps/usePerfdbCompetitions.ts:245-246), /v2/user/<address>/daily-pnl (Hyperpax:src/hooks/perps/useDailyPnl.ts:67-68) and /v2/leaderboard (Hyperpax:src/page-modules/leaderboard/index.tsx:84-85) resolve under the PERFDB base as contracts/data-services.md section 26 serves them."

[req.6015]
title = "WebSocket streams resume from a snapshot with sequence checks"
ac_1 = "The perpetual venue book subscribes with {event: \"subscribe\", topic: \"<SYMBOL>@perp_orderbook\"} on the gateway /ws socket instead of the action/channel frame (Hyperpax:src/widgets/trading/Orderbook.tsx:217-235)."
ac_2 = "Every stream passes frames through sequenceGuard (Hyperpax:src/core/net/realtime.ts:29-47) and a snapshot frame resets the per-topic baseline."
ac_3 = "A gap (seq greater than last + 1) closes the socket with code 4000 as at Hyperpax:src/hooks/perps/useSidPaxMarketStream.ts:294, fetches the REST snapshot, resubscribes and drops deltas at or below the snapshot seq."
ac_4 = "A changed snapshotId drops local state for every topic of that socket and resubscribes (Hyperpax:data_api.md:70-82; contracts/data-services.md section 8)."
ac_5 = "Reconnect uses scheduleActive and the retry-after and 1013 handling of watchSocket (Hyperpax:src/core/net/realtime.ts:8-22, :84-85)."
ac_6 = "The gateway socket URLs (/ws and the spot user /v1/ws of SPOT_USER_WS_URL, Hyperpax:src/hooks/spot/useSpotUserStream.ts:32-34) derive from the gateway module and every gateway topic of one origin shares one socket; the Chainflow socket URLs (Hyperpax:src/hooks/perps/useMarketsStream.ts:29, Hyperpax:src/hooks/perps/useSidPaxMarketStream.ts:70, Hyperpax:src/hooks/spot/useSpotMarketStream.ts:34, Hyperpax:src/hooks/chain/useExplorerStream.ts:29) derive from FEED_ORIGIN."

