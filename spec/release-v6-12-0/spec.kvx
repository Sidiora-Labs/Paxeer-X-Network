ac_2 = "DIAMOND_ADDRESS (Hyperpax:src/env/.env.template:26, Hyperpax:src/env/.env.node:19, Hyperpax:src/env/.env.remix:19), NEXT_PUBLIC_DIAMOND_ADDRESS (Hyperpax:src/env/.env.local.nextjs:19), USID_ADDRESS, USDC_ADDRESS and USDT_ADDRESS (Hyperpax:src/env/.env.template:29-31), NEXT_PUBLIC_INDEXER_URL, NEXT_PUBLIC_INDEXER_WS_URL and NEXT_PUBLIC_PERFDB_URL (Hyperpax:deploy/Dockerfile:68-70, :84-86; Hyperpax:deploy/docker-compose.yml:33-35; Hyperpax:deploy/.env.production.example:42-46), NEXT_PUBLIC_SPOT_API_BASE, NEXT_PUBLIC_SPOT_USER_WS and the NEXT_PUBLIC_SPOT_* address overrides leave every file, and USDL_ADDRESS (Hyperpax:src/env/.env.template:32) carries 0x85FcD13735F4309833A503EE804ea32395851479."
ac_3 = "Hyperpax:src/env/deployed.json, which only comments of Hyperpax:src/core/perps/config.ts:89-90 and :119 name, is deleted with the Diamond-era spot tables."
ac_4 = "A build without NEXT_PUBLIC_PERPS_GATEWAY_URL fails at module load with the variable name."

