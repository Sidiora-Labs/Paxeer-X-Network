[req.7016]
title = "GraphQL subscriptions run over graphql-transport-ws on /graphql-ws"
ac_1 = "Subscription.indexerStatusUpdated (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:80) returns IndexerStatus, fed from changes of perps.cursors."
ac_2 = "Subscription.latestPricesUpdated (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:108) returns [LatestPrice!]!, fed from changes of perps.oracle_prices."
ac_3 = "Subscription.priceUpdated (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:135) returns PriceUpdate with argument marketId: Int!, fed from changes of perps.oracle_prices."
ac_4 = "Subscription.positionChanged (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:164) returns [Position!]! with argument userAddress: String!, fed from changes of perps.positions_current."
ac_5 = "Subscription.orderChanged (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:197) returns Order with argument userAddress: String!, fed from changes of perps.orders."
ac_6 = "Subscription.tradeCreated (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:228) returns Trade with argument marketId: Int!, fed from changes of perps.trade_settlements."
ac_7 = "Subscription.liquidationCreated (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:259) returns Liquidation with argument marketId: Int!, fed from changes of perps.liquidations."
ac_8 = "connection_init must arrive within 10 seconds or the socket closes with 4408; the client sends it on open (Hyperpax:src/core/graphql/client.ts:347)."
ac_9 = "One socket multiplexes many subscriptions by id (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:5-7)."
ac_10 = "At most 100 subscriptions per socket (contracts/data-services.md:756)."

[req.7017]
title = "The explorer serves blocks, venue transactions and histories linked to the network explorer"
ac_1 = "Blocks limit is clamped to [1, 50] with default 20 (Hyperpax:data_api.md:562)."
ac_2 = "Transactions limit is clamped to [1, 200] with default 50 (Hyperpax:data_api.md:580)."
ac_3 = "action takes one of the six documented values (Hyperpax:data_api.md:600-601) by the mapping of contracts/data-services.md."
ac_4 = "Account history pages with a keyset cursor (block, tx_index, log_index) (contracts/data-services.md:775)."
ac_5 = "Market history pages with the same cursor (contracts/data-services.md:775)."
ac_6 = "Rows link to the network explorer through PERPS_EXPLORER_TX_BASE with /tx/ and /address/; with it empty the link is omitted (contracts/data-services.md:775)."
ac_7 = "Route /api/chain/blocks answers the documented JSON (contracts/data-services.md:775)."
ac_8 = "Route /api/chain/transactions answers the documented JSON (contracts/data-services.md:775)."
ac_9 = "Route /api/chain/health answers status, ts, chain_connected, blocks_seen and txs_seen (Hyperpax:data_api.md:606)."
ac_10 = "Route /api/chain/accounts/<key>/history answers the documented JSON (contracts/data-services.md:775)."
ac_11 = "Route /api/chain/markets/<key>/history answers the documented JSON (contracts/data-services.md:775)."
ac_12 = "Route /api/chain/tx answers the documented JSON (contracts/data-services.md:775)."
ac_13 = "An unknown transaction hash answers 404 (contracts/data-services.md:775)."
ac_14 = "Excess requests per client key answer 429 (Launch-x:core/api/internal/ratelimit/ratelimit.go:49)."
ac_15 = "Topic chain@blocks delivers one frame per item with a snapshot of the last 20 (Hyperpax:data_api.md:611)."
ac_16 = "Topic chain@transactions delivers one frame per item with a snapshot of the last 50 (Hyperpax:data_api.md:647)."

[req.7018]
title = "The portal renders markets, accounts, leaderboard and statistics on the server"
ac_1 = "Page / with the markets table and totals renders from the gateway REST and GraphQL (contracts/data-services.md:801)."
ac_2 = "Page /markets/<symbol> with trades, funding and candles renders from the gateway REST and GraphQL (contracts/data-services.md:801)."
ac_3 = "Page /accounts/<address> with positions, orders, fills, funding, liquidations and margin events renders from the gateway REST and GraphQL (contracts/data-services.md:801)."
ac_4 = "Page /leaderboard for all, 30d and 7d renders from the gateway REST and GraphQL (contracts/data-services.md:801)."
ac_5 = "Page /stats with global statistics, snapshots and indexer status renders from the gateway REST and GraphQL (contracts/data-services.md:801)."
ac_6 = "Readiness follows the gateway readiness (Launch-x:shared/http/health.go:46)."
ac_7 = "An unknown symbol or malformed address answers 404 inside the page layout (contracts/data-services.md:801)."
ac_8 = "Every response sets Content-Security-Policy default-src self (contracts/data-services.md:801)."
ac_9 = "All five pages are mounted on the portal server (contracts/data-services.md:801)."

[req.7019]
title = "Realised profit and loss, account history and the leaderboard are exact"
ac_1 = "Realised profit and loss is computed on close from entry and exit price and size in exact integers (contracts/data-services.md:815)."
ac_2 = "TradeSettled components (fees, funding) are kept apart in user_pnl_daily (contracts/data-services.md:815)."
ac_3 = "Spot realised profit uses average cost (contracts/data-services.md:815)."
ac_4 = "Leaderboard ranks by realised profit, ties ordered by lower account bytes (contracts/data-services.md:815)."
ac_5 = "History is ordered by (block, tx_index, log_index) descending (contracts/data-services.md:815)."

[req.7020]
title = "Every service exposes liveness, readiness and Prometheus metrics"
ac_1 = "/healthz/live answers 200 while the process runs (Launch-x:shared/http/health.go:29)."
ac_2 = "/healthz/ready answers 503 naming the failing check (contracts/data-services.md:823)."
ac_3 = "/metrics serves the text exposition (Launch-x:shared/telemetry/metrics.go:124)."
