[meta]
name = "Paxeer X Network release v6.12.0: launchpad parity, perpetuals and spot precompiles, perps data services"
slug = "release-v6-12-0"
version = "1.0.0"
status = "draft"
goal = "One coordinated upgrade of the Paxeer X Network to v6.12.0 in which the launchpad precompile 0x1017 presents the exact interface of the deployed launchpad contracts and absorbs their pools, the perpetuals and spot venue runs natively in the chain as precompiles with a validator-run price sidecar, the Hyperpax application trades against those precompiles, and a dedicated indexer, gateway and portal serve the venue's data; the upgrade is applied by every validator and full node at one halt height and released as the first tagged build."
scope = "The node binary paxd (Cosmos SDK, EVM, precompiles, upgrade handler), the launchpad, perpetuals and spot precompiles and the pricefeed precompile at 0x1020 with their keepers (modules/launchpad, modules/perps, modules/spot, modules/pricefeed), the price sidecar, the perps data services in this repository, the launchpad backend bindings in github.com/Sidiora-Labs/Launch-x, the Hyperpax application in github.com/paxlabs-inc/Hyperpax, the release pipeline and the fleet upgrade runbook."
revision = "211acbc6c"
completion = "Every task verify_cmd passes at one revision; every acceptance criterion of req.1 to req.9 holds on that revision; the upgrade rehearsal on a local network applies plan v6.12.0 at a height, migrates the launchpad pools, opens the eighteen perpetual markets with sidecar prices after every validator operator registers its feed key, and the Hyperpax application completes a deposit, order, fill, funding payment and withdrawal through the precompiles."

[design]
flow = "Hyperpax application (wagmi/viem) or launchpad backend (abigen bindings) -> JSON-RPC of a full node -> EVM call to a precompile (0x1017 launchpad, 0x1015 perpetuals, 0x1020 pricefeed and the spot addresses 0x1021-0x1025 fixed in contracts/address-table.md) -> keeper state in the chain store -> EVM logs in the receipt -> indexer (this repository, platform/perps-data) -> Postgres and NATS JetStream -> gateway (REST, WebSocket, GraphQL) and portal. Charts, prices, candles and order-book snapshots reach the application from the Chainflow feed; the gateway streams the venue's own fills and order book for perps and spot and serves account-scoped state and history."
domains = "One execution domain, paxd. Trading state lives in Go keepers and is exposed only through precompiles whose ABI is the public contract; no Solidity venue contract is deployed for the venue. Prices enter the chain through fee-free MsgSubmitPrices transactions of modules/pricefeed submitted by validator-run sidecars that read the Chainflow feed, aggregated deterministically per block. USDL is the existing ERC20 contract (contracts/libraries/Constants.sol:14, six decimals at :16) and is never minted, given a bank denom or given a pointer; PAX (uhpx) and SID (the denom returned by SidioraDenom, modules/layerxbridge/types/keys.go:53-59) are bank denoms with ERC20 native pointers."
native_constructs = "Existing: launchpad 0x1017 (rebuilt to the contract interface), layerxexchange 0x1015 (replaced by the perpetuals precompile from the v6.12.0 height, the previous implementation kept in the versioned precompile map keyed to v6.12.0 so heights below it resolve to it through GetCustomPrecompilesVersions, modules/evm/keeper/keeper.go:356-385). New: spot precompile set at 0x1021-0x1025 with 0x1026 and 0x1027 carrying no code, pricefeed precompile at 0x1020 and its module modules/pricefeed (modules/oracle stays unchanged), fee-right ERC721 and pool-token ERC20 surfaces served by the launchpad keeper."
activation = "One upgrade plan named v6.12.0 registered in node/upgrades.go; its handler runs RunMigrations, the SID mint-authority move and the SID holder migration of the retired v6.11 plan (node/upgrades_v611.go:98-141), then the five hooks pointers, launchpad, pricefeed, perps and spot in that order (native pointers and bank metadata for uhpx and SID, pool migration, market table, eighteen perpetual markets, spot pools) and then switches the v6.12.0 precompile set live explicitly, as the activation handler switches xweb (node/upgrades.go:304-318, node/upgrades.go:276-282); no node/tags entry is added and the handler never reads its own done height, which is written only after the handler returns (sdk/x/upgrade/keeper/keeper.go:369-395). The handler registers no feed key: each validator operator registers its sidecar key with registerFeedKey at 0x1020 after the upgrade. Every validator and full node halts at the plan height and restarts on the v6.12.0 binary; rollback is the pre-upgrade snapshot of every validator and full node plus the pre-upgrade binary kept on every host."
data_services = "A new Railway project hosts the perps data services with their own Postgres and NATS; the services are Go programs in this repository that reuse the launchpad backend packages where the shapes match (shared/config, shared/ethclient, NATS JetStream helpers, abigen-by-role bindings)."

[execution]
planning_state = "Task completion requires the declared implementation and its verify_cmd evidence at one revision. A specification or task status alone establishes no runtime result."
task_policy = "Read the exact declared source and contract section, keep code that already meets the contract, implement every unmet criterion of the task, then run one bounded qualification pass. Implementation, qualification and activation evidence are recorded separately."
gate_policy = "Every planned gate is implemented by the task that owns its acceptance criteria. A verify_cmd names a target that exists at the revision or is listed in planned_paths with gate_kind planned; unknown, empty or skipped selectors are refused."
candidate_policy = "A passing gate is reused only while its source, inputs, scope and environment stay the same. Aggregate, sanitizer, cluster and upgrade-rehearsal gates run once per wave on the merged wave revision, not per task."
parallelism = "tasks in the same wave with disjoint touches run in parallel"
privacy = "Credentials, key material, operational inventories, host names and raw execution logs stay in access-controlled storage. Everything in this feature directory is public and is reviewed before publication."
ownership = "every path appears in the touches of exactly one task per wave"
citation_policy = "every do_n names the path:line it changes or reproduces; paths in the Launch-x repository carry the prefix Launch-x: and paths in the Hyperpax repository carry the prefix Hyperpax:"
requirement_ids = "req.1 to req.9 are the programme requirements. Each feature N declares its own requirements as req.<N><kkk> (N*1000+k, so req.3007 is requirement 7 of feature 3); a task reqs entry <id>.<a> names acceptance criterion a of that requirement."
external_revisions = "Launch-x citations are at commit c5eb7c7 of github.com/Sidiora-Labs/Launch-x; Hyperpax citations are at commit 242152b of github.com/paxlabs-inc/Hyperpax."

[req.1]
title = "The launchpad precompile presents the deployed contract interface and holds every pool"
ac_1 = "Every function, event and custom error of the launchpad contracts at their current deployment generation is served by the precompile with the same selector, argument encoding, return encoding and revert data."
ac_2 = "The quote asset is the USDL ERC20 with six decimals; USDL is never minted and has no bank denom and no pointer; pool creation, swaps and fee accrual move USDL by ERC20 transferFrom from the user's allowance to the precompile address and by ERC20 transfer from the module EVM address, and the v6.12.0 handler moves the USDL of every first-generation pool to the module EVM address by ERC20 transfer."
ac_3 = "Every pool of the first and the current deployment generation exists in the precompile after the upgrade with its reserves, pool-token supply and holders, fee-right holders, accrued fees and hook configuration, and a read through the precompile returns the same values a read of the contract returned at the halt height."
ac_4 = "Fee rights are ERC721 tokens and pool tokens are ERC20 tokens whose transfer, approval and balance surfaces are served by the chain and visible to the explorer."
ac_5 = "The launchpad backend binds to the precompile address through its manifest role and every indexer, stats, chart, pnl and ranking service produces the same rows for a swap against the precompile as for a swap against the contract."

[req.2]
title = "The perpetuals venue runs natively as a precompile"
ac_1 = "Market, limit, stop-market, stop-limit, take-profit and stop-loss orders with good-till-cancel, immediate-or-cancel, fill-or-kill and post-only time in force, reduce-only, partial close and position-attached take-profit and stop-loss execute in the precompile with deterministic matching."
ac_2 = "Cross margin across every market, initial and maintenance margin tiers by notional, collateral deposit, withdrawal and top-up in the USDL ERC20; leverage up to 1000x holds on all eighteen markets and transferMargin reverts LXP_PERPS_CROSS_MARGIN_ONLY."
ac_3 = "Maker and taker fees by volume tier, no borrowing fee, funding every hour from the premium against the oracle price, a fee recipient account, an insurance fund, liquidation with partial close, backstop liquidation and auto-deleveraging follow the parameter sheet of contracts/perps-parameters.md."
ac_4 = "The eighteen opening markets exist at the activation height with the parameters of contracts/perps-markets.md and trade only while the oracle price is fresh."
ac_5 = "Every state change emits an EVM log with the signature of contracts/perps.md so the indexer reconstructs every position, order, fill, funding payment and liquidation from logs alone."

[req.3]
title = "The spot venue runs natively as a precompile"
ac_1 = "The spot interface the Hyperpax application calls (market buy and sell with slippage and deadline, limit and stop orders, quotes, liquidity info and vault shares) is served by the spot precompile set with the selectors the application already encodes."
ac_2 = "Spot fills settle atomically inside the precompile with maker and taker fees from the parameter sheet: USDL moves as the ERC20 (transferFrom under the user's allowance to the precompile address into the spot module EVM address, transfer out of the spot module EVM address) and PAX and SID move as native bank transfers."
ac_3 = "Every spot state change emits an EVM log with the signature of contracts/spot.md."

[req.4]
title = "Prices come from validator-run sidecars reading the Chainflow feed"
ac_1 = "Each validator runs a sidecar that reads the Chainflow feed for every listed symbol and submits signed price transactions to the chain at the configured cadence."
ac_2 = "The chain aggregates the submissions of the active validator set deterministically per block into one index and one mark price per market with a freshness window, and refuses trading and liquidation on a stale price."
ac_3 = "MsgSubmitPrices transactions from registered sidecar feed keys pay no fee and are bounded in size and rate."

[req.5]
title = "The Hyperpax application trades against the precompiles"
ac_1 = "Every contract call of the application resolves to a precompile address and the application completes deposit, order placement, cancel, fill display, position management, funding display and withdrawal against a node running v6.12.0."
ac_2 = "The application reads charts, prices, candles and order-book snapshots from the Chainflow feed, and reads the venue's own fills and order book for perps and spot and its account-scoped state and history from the gateway of this programme through REST, WebSocket and GraphQL; the gateway serves no chart endpoint."
ac_3 = "The audited amount, approval (USDL allowances target the precompile addresses), time-in-force and take-profit and stop-loss handling of the application is corrected to the precompile semantics."

[req.6]
title = "The perps data services index and serve the venue"
ac_1 = "An indexer in this repository follows the chain head, decodes every precompile log into Postgres tables and publishes every row change on NATS JetStream with a monotonic sequence."
ac_2 = "A gateway streams the venue's own fills and order book for perps and spot and serves markets, positions, orders, fills, funding, liquidations, account-scoped state and history and leaderboards over REST, a shared WebSocket with snapshot and sequence resume, and GraphQL; charts, candles and market prices come from the Chainflow feed and not from the gateway."
ac_3 = "A chain explorer service serves per-account and per-market trading history with transaction links, and a portal renders markets, accounts and venue statistics."
ac_4 = "The services deploy as container images from this repository to a dedicated Railway project with its own Postgres and NATS, with health endpoints and a replay-from-height tool."

[req.7]
title = "The node binary builds, tests and ships as v6.12.0"
ac_1 = "paxd builds from the main branch of this repository with the kernel library linked, in CI and in the release pipeline."
ac_2 = "The upgrade plan v6.12.0 is registered, its handler is covered by a test that applies it to a store seeded from a halt-height export, and the binary reports version v6.12.0."
ac_3 = "The release pipeline produces the tagged build v6.12.0 with its checksum and the upgrade-info document."

[req.8]
title = "The fleet applies the upgrade at one height"
ac_1 = "The runbook snapshots the full home of every validator and full node before the plan height and keeps the pre-upgrade binary on every host, halts every node at the plan height, installs the v6.12.0 binary, restarts the fleet, installs the price sidecar on every validator, has each operator register its feed key, and verifies the precompile set, the migrated pools, the opening markets and fresh sidecar prices; rollback halts every node, restores its snapshot and restarts the pre-upgrade binary."
ac_2 = "The runbook names each operator input (halt height, maintenance window, public notice, build host, node homes and units, feed-key credentials) as a field filled in before execution."

[req.9]
title = "Every decision of this programme is recorded and normative"
ac_1 = "Every decision below is referenced by at least one resolution and every resolution applies to at least one task."

[decision.1]
title = "Previous unapplied plan"
value = "Only the plan name v6.11 is dropped: V611Upgrade and its registration leave the plan table, and the work it carried (the SID holder migration of node/upgrades_v611.go and the move of the SID mint authority to the bridge) ships inside the v6.12.0 handler."
basis = "A plan that was registered but never applied carries no chain state (node/upgrades.go:104-112, node/upgrades.go:204-206, node/upgrades.go:532-534)."
affects = ["node/upgrades.go", "tools/release/version.json"]

[decision.2]
title = "Launchpad generation and pool migration"
value = "The precompile is built to the interface of the current deployment generation (the manifest-active generation) and the v6.12.0 handler migrates the pools of both deployment generations into it; every first-generation pool becomes a generation 2 pool, and every pool of either generation is served at the generation 2 role surfaces."
basis = "The current manifest names the active generation (Launch-x:shared/config/deployment/current.json) and the first generation still holds the larger pool set (Launch-x:protocol/addresses.go)."
affects = ["precompiles/launchpad", "modules/launchpad", "node/upgrades.go"]

[decision.3]
title = "Launchpad quote asset, hooks and fee rights"
value = "The quote asset is the existing USDL ERC20 contract at 0x85FcD13735F4309833A503EE804ea32395851479 (six decimals); nothing mints USDL, no uusdl denom exists and no pointer is installed at the USDL address. USDL is held at the module EVM addresses and moves by transferFrom (a user allowance to the precompile address) and by transfer (CallEVM from the module address in EndBlock or the handler, a nested EVM call inside a precompile run); PAX and SID move as native bank transfers. The v6.12.0 handler moves the USDL of the first-generation pools and of the FeeAccumulator to the launchpad module EVM address by USDL.transfer called through CallEVM with from set to the holding contract, which has no withdraw function, and moves Treasury USDL through Treasury.withdraw called from the DEFAULT_ADMIN_ROLE holder. The hook system (opticals) is part of this release; fee rights are ERC721 tokens."
basis = "The USDL address and decimals are fixed in contracts/libraries/Constants.sol:14-16 and Launch-x:shared/config/deployment/current.json:86-99; CallEVM takes any from address (modules/evm/keeper/evm.go:81); the pool pays out only through safeTransfer (Launch-x:contracts/contracts/core/SidioraPool.sol:217, Launch-x:contracts/contracts/core/SidioraPool.sol:239) and the Treasury withdraws under DEFAULT_ADMIN_ROLE (Launch-x:contracts/contracts/protocol/Treasury.sol:58-71)."
affects = ["precompiles/launchpad", "modules/launchpad"]

[decision.4]
title = "Perpetuals economics"
value = "Maker and taker fees, volume tiers, funding (no borrowing fee), margin tiers, liquidation and auto-deleveraging follow the structure of the Hyperliquid venue as written in contracts/perps-parameters.md; margin is cross; leverage reaches 1000x on every market; the opening markets are PAX, SID, NAS100, ETH, SPX500, BTC, BNB, SOL, HYPE, TSLA, GOOGL, XAU, NVDA, ASTER, LINK, XRP, TRUMP and AVAX."
basis = "The parameter sheet is derived from the published rules of that venue and recorded in the contract file with its formulas."
affects = ["precompiles/perps", "modules/perps", "contracts/perps-parameters.md", "contracts/perps-markets.md"]

[decision.5]
title = "Price oracle"
value = "A validator-run sidecar reads the Chainflow feed and submits MsgSubmitPrices on chain with the feed key its operator registered at 0x1020; modules/pricefeed aggregates per block; modules/oracle stays unchanged."
basis = "The application already reads the Chainflow feed (Hyperpax:src/core/feeds.ts) for charts and market data, and the chain already runs validator-side sidecars for the web module."
affects = ["modules/pricefeed", "precompiles/pricefeed", "platform/hosted/feeder"]

[decision.6]
title = "Spot model"
value = "The spot venue is the PECOR interface the application calls, rebuilt as a precompile set where its semantics are expressible in keeper state; where the feasibility record in contracts/spot.md shows a method cannot be served, the continuous order book serves that method."
basis = "No spot contract has code on the chain; the application encodes the PECOR selectors (Hyperpax:src/core/network/spot_abi)."
affects = ["precompiles/spot", "modules/spot", "contracts/spot.md"]

[decision.7]
title = "Portal shape and explorer"
value = "Charts, prices, candles and order-book snapshots come from the Chainflow feed and the gateway serves no chart endpoint; the gateway streams the venue's own fills and order book for perps and spot and serves account-scoped state and history over REST, the shared WebSocket of the application's data protocol and a GraphQL endpoint with the account and venue operations of the application's schema; the chain explorer service is built in this repository and links each row to the network explorer."
basis = "Serving every protocol the application already speaks keeps every data path of the application live and gives the portal the richest data set."
affects = ["platform/perps-data"]

[decision.8]
title = "Hosting of the perps data services"
value = "A dedicated Railway project with its own Postgres and NATS hosts the perps data services."
basis = "The launchpad services keep their own project; separate projects isolate load and credentials."
affects = ["platform/perps-data/deploy"]

[decision.9]
title = "Code home of the data services"
value = "The indexer, gateway, explorer and portal live in this repository under platform/perps-data."
basis = "One repository builds the binary and the services that read its logs, so the ABI and the decoders change in one commit."
affects = ["platform/perps-data"]

[decision.10]
title = "Precompile version switch"
value = "From the v6.12.0 height the perpetuals precompile serves 0x1015 and the generation 2 launchpad serves 0x1017; the versioned precompile maps of both addresses are keyed to v6.12.0, so heights below it resolve to the previous implementation and historical blocks replay. The v6.12.0 handler switches the set live explicitly and a node restarted after the upgrade restores it from state; no node/tags entry is added and the handler never reads GetDoneHeight."
basis = "Versioned precompiles resolve by upgrade name through GetCustomPrecompilesVersions (modules/evm/keeper/keeper.go:356-385); the done height is written after the handler returns (sdk/x/upgrade/keeper/keeper.go:369-395); xweb is switched live the same way (node/upgrades.go:216-236, node/upgrades.go:276-282)."
affects = ["precompiles/layerxexchange", "precompiles/perps", "precompiles/launchpad", "node/upgrades.go", "node/app.go"]

[decision.11]
title = "Operator inputs of the rollout"
value = "The halt height, the maintenance window, the public notice and the build host are operator inputs recorded in the runbook before execution; the specification carries them as fields, not values."
basis = "These values are chosen at execution time and stay in access-controlled storage."
affects = ["spec/release-v6-12-0/docs/rollout-runbook.md"]

[acceptance.1.1]
feature = "2"
req = "1.1"
scenario = "Given the rehearsal chain upgraded at H1, when every selector of the golden selector file of feature 2 is called at its surface address, then each call returns the contract's return or revert encoding; feature 2 realises the criterion and its completion gate is task 2.3.99."
contract = "contracts/launchpad.md"
test = "tools/release/rehearse-v6120.sh::check_launchpad_interface (planned)"
qualification = "UNRUN"

[acceptance.1.2]
feature = "2"
req = "1.2"
scenario = "Given the rehearsal chain upgraded at H1, when a buy through the generation 2 Router runs with a USDL allowance to 0x1017, then USDL.balanceOf of the buyer falls and that of the launchpad module EVM address rises by the same amount, the bank supply has no uusdl denom, GetERC20NativePointer finds no pointer at the USDL address and no mint event exists in the block."
contract = "contracts/launchpad.md"
test = "tools/release/rehearse-v6120.sh::check_usdl_erc20_custody (planned)"
qualification = "UNRUN"

[acceptance.1.3]
feature = "2"
req = "1.3"
scenario = "Given the halt-height export and the rehearsal chain at H1+1, when pool parity reads getPoolCount, getReserves, pool-token supply and holders, fee-right owners and accrued fees of every pool of both generations, then each value equals the halt-height read, and every first-generation pool answers at the generation 2 role surfaces."
contract = "contracts/launchpad.md"
test = "tools/release/rehearse-v6120.sh::check_pool_parity (planned)"
qualification = "UNRUN"

[acceptance.1.4]
feature = "2"
req = "1.4"
scenario = "Given the rehearsal chain at H1+1, when ownerOf of a migrated fee right and balanceOf, transfer and approve of a migrated pool token are called, then each answers from chain state and emits the Transfer or Approval log the explorer indexes."
contract = "contracts/launchpad.md"
test = "tools/release/rehearse-v6120.sh::check_fee_right_and_pool_token (planned)"
qualification = "UNRUN"

[acceptance.1.5]
feature = "2"
req = "1.5"
scenario = "Given the launchpad backend configured with the manifest roles pointing at the precompile surfaces, when the backend indexer processes a rehearsal swap, then its pnl, stats, chart and ranking rows equal those of the same swap against the contract; feature 2 realises the criterion with its completion gate task 2.3.99."
contract = "contracts/launchpad.md"
test = "Launch-x:shared/config/deployment/manifest_test.go::TestPrecompileRolesShareAddress (planned)"
qualification = "UNRUN"

[acceptance.2.1]
feature = "3"
req = "2.1"
scenario = "Given the rehearsal chain with fresh prices, when one order of each type and time in force, a reduce-only order, a partial close and an attached take-profit and stop-loss are sent to 0x1015, then each executes or rests as contracts/perps.md specifies and two nodes report the same app hash."
contract = "contracts/perps.md"
test = "tools/release/rehearse-v6120.sh::check_perps_order_types (planned)"
qualification = "UNRUN"

[acceptance.2.2]
feature = "3"
req = "2.2"
scenario = "Given the rehearsal chain, when an account deposits USDL by allowance to 0x1015, opens a 1000x position on each of the eighteen markets within the margin tiers, tops up and withdraws, then the USDL ERC20 balance of the perps module EVM address follows each move and transferMargin reverts LXP_PERPS_CROSS_MARGIN_ONLY."
contract = "contracts/perps.md"
test = "tools/release/rehearse-v6120.sh::check_perps_margin (planned)"
qualification = "UNRUN"

[acceptance.2.3]
feature = "3"
req = "2.3"
scenario = "Given the rehearsal chain over one funding hour, when fills, a liquidation, a backstop liquidation and an auto-deleveraging run, then fees by tier, the funding payment, the insurance-fund and fee-recipient balances follow contracts/perps-parameters.md and no borrowing fee is charged."
contract = "contracts/perps-parameters.md"
test = "tools/release/rehearse-v6120.sh::check_perps_economics (planned)"
qualification = "UNRUN"

[acceptance.2.4]
