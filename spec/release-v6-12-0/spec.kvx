[req.2016]
title = "The launchpad events of the EventEmitter family are emitted at 0x1017"
ac_1 = "EventEmitter event `Swap(bytes32,address,bool,uint256,uint256,uint256,uint256,uint256,uint256)` (topic0 0xa234ab85728295548823d8a26077ecc77aa5815f9ed8f4c5e6fd390ac851d4cc, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:21) is emitted at 0x1017 by the precompile wherever the contract flow called emitSwap (Launch-x:contracts/contracts/core/SidioraPool.sol:273), with the arguments emitSwap adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:365); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_2 = "EventEmitter event `PoolStateUpdated(bytes32,uint256,uint256,uint256,uint256,uint256,uint256)` (topic0 0x8155a4b38a877d212b271811786986f8f7d78074c82fce4526c58defcc6d7ebd, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:70) is emitted at 0x1017 by the precompile wherever the contract flow called emitPoolStateUpdated (Launch-x:contracts/contracts/core/SidioraPool.sol:288), with the arguments emitPoolStateUpdated adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:409); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_3 = "EventEmitter event `TokenDeployed(address,address,address,bytes32,string,string,uint8,uint256,uint256,uint256)` (topic0 0xad187874b793634c55d977f35d4828526eb48170a9531c71d88f8fd10cf9c237, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:619) is emitted at 0x1017 by the precompile wherever the contract flow called emitTokenDeployed (Launch-x:contracts/contracts/core/SidioraFactory.sol:159), with the arguments emitTokenDeployed adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:831); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_4 = "EventEmitter event `MarketCreated(bytes32,address,address,address,address,uint256,uint256)` (topic0 0xb0a9c7605389f1127c2299d4a3ed85f0b2fc19894ab5411d76b453bb29f9f47b, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:11) is emitted at 0x1017 by the precompile wherever the contract flow called emitMarketCreated (Launch-x:contracts/contracts/core/SidioraFactory.sol:160), with the arguments emitMarketCreated adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:354); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_5 = "EventEmitter event `NftMint(uint256,address,address,uint8,uint256,uint256)` (topic0 0xd2917d37031c0dfe5016665c7a83360cbf2ff32063096b2caf61ba66c06832e5, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:600) is emitted at 0x1017 by the precompile wherever the contract flow called emitNftMint (Launch-x:contracts/contracts/core/SidioraNFT.sol:81), with the arguments emitNftMint adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:800); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
ac_6 = "EventEmitter event `FeeStrategyChanged(bytes32,uint256,uint8,uint8,uint256,uint256)` (topic0 0x337fd9f9304e9da4c04886a5b8bf56e74032b459758212a860bc61d3544353dd, declared at Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:52) is emitted at 0x1017 by the precompile wherever the contract flow called emitFeeStrategyChanged (Launch-x:contracts/contracts/core/SidioraNFT.sol:123), with the arguments emitFeeStrategyChanged adds (block.timestamp and block.number, Launch-x:contracts/contracts/data/EventEmitter.sol:399); the EventEmitter contracts stay deployed and unchanged for the other systems that use them."
