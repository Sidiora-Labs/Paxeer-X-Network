[feature.9]
name = "resolutions"
scope = "The normative resolutions of release v6.12.0: one resolution per decision of the head and per cross-feature rule the domain features rely on (the USDL, PAX and SID token model, the shared market ids, the 0x1015 version switch, the end-block order, venue logs and their decoding, the shared fee volume, the spot address set, the feed key registry, operator inputs and the precompile-only venue), the shared contract index and address table, and the conformance check that binds each resolution to existing tasks."
requirements = ["9001"]
completion_task = "9.0.99"

[req.9001]
title = "Every decision of this programme is recorded and normative"
ac_1 = "decision 1 is applied by resolution 9.1, 9.2, 9.3, 9.4 and referenced by tasks 1.0.3, 1.0.4, 1.2.1, 1.2.3, 1.0.5, 8.4.1, 8.4.5, 8.4.14, 1.0.1."
