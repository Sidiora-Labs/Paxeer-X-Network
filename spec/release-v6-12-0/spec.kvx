[contract_context.7.module]
home = "Every package lives under platform/perps-data of the root module go.mod:1; binaries under platform/perps-data/cmd (contracts/data-services.md section 1)."
reuse = "Delivery, health and metrics packages are copied from the launchpad backend with their origin named, for example the relay of Launch-x:shared/delivery/natsdriver/driver.go:27 (Launch-x:shared/delivery/natsdriver/driver.go:27)."

[contract_context.7.schema]
tables = "One schema perps with fact, chain, projection, account and delivery tables (contracts/data-services.md section 2); amounts are numeric(78,0) raw integers."
migrations = "Embedded migrations 0001 to 0005 are applied in lexical order by store.Migrate and refuse start on a changed hash (contracts/data-services.md section 2)."

[contract_context.7.stream]
subjects = "One JetStream stream PERPS_V1 with subjects perps.<chain>.> built by stream.Subject for the market, user, chain and spot families (contracts/data-services.md section 3)."
sequence = "The stream sequence orders every message; consumers resume from their stored sequence and a rewind is published as its own message (contracts/data-services.md section 4)."

[contract_context.7.events]
source = "Decoders are generated from the leaf ABI packages precompiles/perps/abi, precompiles/pricefeed/abi and precompiles/spot/abi of the same commit, plus the ERC20 Transfer of USDL and the pricefeed Cosmos block events of block_results; every row of the decoding table decodes into its fact table (contracts/data-services.md section 6)."

[contract_context.7.gateway]
routes = "REST, the data socket, the spot user socket on /v1/ws, sign-in and account routes under /v2, and GraphQL on /graphql with the alias /api/subgraph (contracts/data-services.md section 24, contracts/data-services.md section 25, contracts/data-services.md section 26)."
application_base = "The spot client writes its paths beginning with /v1/users (Hyperpax:src/core/spot/api.ts:283), so its base is the bare gateway origin (contracts/data-services.md section 25)."
graphql_ws = "graphql-transport-ws is answered on /graphql-ws and on /graphql, the wsUrl of the PerfDB client (Hyperpax:src/core/perfdb/client.ts:120)."

[contract_context.7.operations]
deploy = "One Dockerfile builds every binary and one Railway project holds the services, Postgres and a three-node NATS cluster, with variables named only (contracts/data-services.md section 20, contracts/data-services.md section 21)."

[task.7.0.1]
title = "Add the JetStream and GraphQL modules to the root module and copy the NATS driver"
status = "done"
mode = "BUILD"
wave = 0
requires = ["7.0.2"]
reqs = ["7001.1", "7007.9"]
capabilities = ["7.1.1"]
do_1 = "Add github.com/nats-io/nats.go v1.47.0 (the version of Launch-x:shared/go.mod:123), github.com/nats-io/nats-server/v2 for the in-process test broker and github.com/graph-gophers/graphql-go to the root module with go get at pinned versions and commit both go.sum lines (h1 and go.mod) of each; the require block lists none of them today (go.mod:27-55) and go.sum:1287 holds only the graphql-go go.mod line without a module hash (contracts/data-services.md section 1). The go.mod edit lands after the layerx-merge go.mod task 0.154 and rebases onto it; the module path stays go.mod:1 so platform/perps-data imports the leaf ABI packages of the same commit."
do_2 = "Copy Publisher and NewPublisher (Launch-x:shared/delivery/natsdriver/driver.go:22, Launch-x:shared/delivery/natsdriver/driver.go:27) into internal/delivery/natsdriver/driver.go, origin Launch-x shared/delivery/natsdriver, keeping the subject pattern Launch-x:shared/delivery/natsdriver/driver.go:17 and the 5 second publish timeout Launch-x:shared/delivery/natsdriver/driver.go:20."
do_3 = "Keep Publish (Launch-x:shared/delivery/natsdriver/driver.go:38) publishing with WithMsgID and WithExpectStream (Launch-x:shared/delivery/natsdriver/driver.go:45) and refusing an acknowledgement with a foreign stream or a zero sequence (Launch-x:shared/delivery/natsdriver/driver.go:52)."
