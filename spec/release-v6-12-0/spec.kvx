[contract_context.2.interface]
address = "The launchpad is served at 0x0000000000000000000000000000000000001017 (modules/launchpad/types/keys.go:26), registered at precompiles/setup.go:14."
roles = "Eleven contract roles are served with their Launch-x ABIs: SidioraPool 42 functions, SidioraFactory 23, SidioraNFT 37, Router 23, Quoter 19, FeesRouter 20, FeeAccumulator 54, PoolRegistry 22, ProtocolConfig 27 and Treasury 17 (Launch-x:contracts/contracts/protocol/Treasury.sol:13); the SidioraERC20 file (19 functions) encodes nested calls to the pool-token contracts, which stay deployed (the pool entry point at Launch-x:contracts/contracts/core/SidioraPool.sol:147)."
direct_calls = "Direct calls to 0x1017 resolve through abi.json, 113 selectors, role order Router, SidioraFactory, Quoter, PoolRegistry, FeesRouter, FeeAccumulator, ProtocolConfig with first-role-wins for the 21 shared signatures, replacing the method set of precompiles/launchpad/launchpad.go:46."
generations = "Every market reads generation 2 after the upgrade: the generation 2 role addresses of Launch-x:shared/config/deployment/current.json:9-79 (SidioraFactory at :37) serve every pool, those of generation 1 (Launch-x:protocol/addresses.go:20-29) are retired (requirement 2.36), and markets created after the upgrade join the same generation 2 set."
fee_rights = "Fee rights are ERC721 tokens of the generation 2 collection 0xe8Dc…409B (Launch-x:shared/config/deployment/current.json:58); generation 1 rights are imported under new ids from nextTokenId with an id map, and markets created after the upgrade mint from nextTokenId (base Launch-x:contracts/contracts/base/ERC721Base.sol:11)."
pool_tokens = "Pool tokens stay the deployed SidioraERC20 contracts with their code and storage; new markets deploy one by CREATE2 from the generation 2 SidioraFactory (Launch-x:contracts/contracts/core/SidioraFactory.sol:120-125)."

[contract_context.2.surfaces]
runtime = "Every generation 2 role address and every pool address holds the 41-byte runtime 0x363d3d373360601b36523d3d601436013d3d6110175af13d600060003e6024573d6000fd5b3d6000f3 after the upgrade, written with SetCode (modules/evm/keeper/code.go:23); retired generation 1 addresses hold the same runtime and revert Retired(address)."
caller = "The precompile reads the original caller from the last 20 bytes only when its EVM caller is a registered surface, otherwise the EVM caller (precompiles/launchpad/launchpad.go:232)."
call_kinds = "Delegatecall reverts, writes under staticcall revert and value reverts (precompiles/common/precompiles.go:374)."
unknown_selector = "An unknown selector reverts with empty revert data."

[contract_context.2.quote_asset]
token = "The quote asset is the USDL ERC20 contract at 0x85FcD13735F4309833A503EE804ea32395851479 (Launch-x:shared/config/deployment/current.json:86), six decimals (Launch-x:shared/config/deployment/current.json:98), named by Params.QuoteToken; it has no bank denom and no native pointer, and its code and storage stay the contract's."
custody = "The launchpad module EVM address holds the launchpad USDL as an ERC20 balance, split in the keeper ledgers HeldQuote per pool, FeeHeld and TreasuryHeld; USDL.balanceOf(launchpad module EVM address) covers their sum."
flows = "USDL moves only by nested ERC20 calls: transferFrom(user, launchpad module EVM address, amount) and transfer(to, amount) with caller the launchpad module EVM address inside the precompile run through evm.Call (precompiles/xweb/xweb.go:482), and CallEVM (modules/evm/keeper/evm.go:81) in the upgrade handler; moves between ledgers write no log."
allowances = "Router and Factory surfaces pull the caller's USDL with the allowance granted to 0x1017; allowances granted to the old Router contracts stay on USDL but are not spent, so a user grants a new allowance to 0x1017 once."

[contract_context.2.storage]
markets = "Market records extend modules/launchpad/types/market.go:58 under MarketPrefix (modules/launchpad/types/keys.go:39)."
surfaces = "Surface, role, custody, Treasury, book-held delta, fee-right id map and retired records are new prefixes beside modules/launchpad/types/keys.go:48."
history = "Holding history stays under HoldingHistoryPrefix (modules/launchpad/types/keys.go:45) for the reads of tasks 3.2.10 and 12.3.29; airdrops read past balances from the pool-token checkpoints."
pool_slots = "Pool storage slots read by the migration are those of contracts/launchpad.md section 14, from the Launch-x build of each generation implementation; old storage is left in place."

[contract_context.2.errors]
revert_data = "Every refusal returns the contract custom error selector and ABI arguments as revert data; keeper errors keep their LXP_LAUNCHPAD_ codes (modules/launchpad/types/errors.go:7)."
admin = "DEFAULT_ADMIN_ROLE methods (grantRole, revokeRole, upgradeToAndCall and every admin setter) revert `AccessControlUnauthorizedAccount(address,bytes32)` (0xe2517d3f) carrying the caller and 0x00 (ruling 7); non-admin role checks revert MissingRole(caller, role) (0x0161a64a, Launch-x:contracts/contracts/base/AccessControl.sol:73); initialize reverts AlreadyInitialized() (0x0dc149f0)."
pool_guardian = "Guardian functions revert Unauthorized() (0x82b42900, Launch-x:contracts/contracts/core/SidioraPool.sol:43) for other callers, and migrateFactory reverts it for every caller (Launch-x:contracts/contracts/core/SidioraPool.sol:126-129)."

[contract_context.2.events]
native = "Contract-native events are emitted at the generation 2 address of the role, or at the pool address, through EmitEVMLog (precompiles/common/evm_events.go:16); ERC20 logs of USDL and pool tokens come from those contracts."
emitter = "The twelve EventEmitter launchpad events are emitted at 0x1017 with block timestamp and number appended (Launch-x:contracts/contracts/data/EventEmitter.sol:365); the EventEmitter contracts stay deployed for the other systems."
order = "Logs of one call appear in the contract order of the call, nested contract logs included."

[contract_context.2.gas]
schedule = "RequiredGas is Gas(inputBytes, writes) with BaseGas 3000, GasPerByte 16 and GasPerWrite 5000 (precompiles/launchpad/launchpad.go:15-17); the pointer term of precompiles/launchpad/launchpad.go:18 goes."
nested = "Optical, USDL, pool-token and receiver-hook calls are nested EVM calls metered by the EVM (precompiles/xweb/xweb.go:482)."

[contract_context.2.activation]
gate = "0x1017 stays behind activationPrecompileGate (node/upgrades.go:498)."
versions = "GetVersioned (precompiles/launchpad/setup.go:10) keeps the current precompile under v6.10 in legacy/v610 over the copied keeper and types, and the handler switches the versioned set to v6.12.0 explicitly."
handler = "The v6.12.0 handler (baseline task 1.0.3) runs RunMigrations, moveSidioraMintAuthority and migrateSIDHolders, then its hook table in the order the createV6120Pointers hook of baseline task 1.2.4, launchpad MigrateV6120(ctx, k, evm), pricefeed InitV6120, perps SeedV6120 and spot InitV6120, so MigrateV6120 is the first domain hook; MigrateV6120 uses CallEVM as its nested caller and wraps its error as \"upgrade v6.12.0: launchpad: <error>\"; the launchpad module account gains no new permission."

[contract_context.2.invariants]
pool_solvency = "HeldQuote(pool) covers realUsdlBalance and token.balanceOf(pool) covers tokenReserve (Launch-x:contracts/contracts/core/SidioraPool.sol:268, modules/launchpad/keeper/invariants.go:20)."
liabilities = "FeeHeld covers totalLiabilities (Launch-x:contracts/contracts/data/FeeAccumulator.sol:478-480) and TreasuryHeld covers the Treasury ledger."
custody = "USDL.balanceOf(launchpad module EVM address) covers the sum of HeldQuote, FeeHeld and TreasuryHeld(USDL); USDL totalSupply is unchanged by the upgrade."

[contract_context.2.parameters]
values = "Parameters equal ProtocolConfig.initialize (Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:45-54); ConcentrationWeight 0 and CreationFee 1000000 are required changes to modules/launchpad/types/params.go:34, and QuoteToken names USDL."
bounds = "Validate enforces the ProtocolConfig setter bounds (Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:84, Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:100, Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:67)."
governance = "Parameters, role grants and revokes change through MsgUpdateParams only (modules/launchpad/keeper/msg_server.go:14); Treasury payouts run through MsgTreasuryWithdraw."

[contract_context.2.migration]
order = "MigrateV6120 runs step 1 (USDL custody), step 2 (pools and pool tokens), step 3 (fee rights, roles, accounting, pause state) and step 4 (surfaces and retirement) in one cached context, once."
usdl = "Step 1 moves the USDL of every pool and FeeAccumulator to the launchpad module EVM address by USDL.transfer through CallEVM from the holding address, drains both Treasuries by withdraw and recoverSurplus through CallEVM from the fixture admin, and credits the ledgers; USDL code and storage outside those balances are unchanged."
pools = "Step 2 enumerates pools from each PoolRegistry (Launch-x:contracts/contracts/data/PoolRegistry.sol:23), reads every pool slot, sets reserves to min(book, held) and records the book-held delta with no top-up."
not_carried = "DEFAULT_ADMIN_ROLE memberships, the factory link of migrateFactory and the old contract storage behind the surfaces are not carried; pool-token storage, USDL allowances and nonces stay in their contracts."

[contract_context.2.head_alignment]
decision_2 = "Decision 2 is met by building to the generation 2 interface and migrating both generations into it (req 2.24, req 2.25)."
decision_3 = "Decision 3 is met by USDL staying the ERC20 contract held in custody at the launchpad module EVM address (req 2.18, req 2.23), opticals (req 2.17) and ERC721 fee rights (req 2.11)."
req_1_ac_1 = "Programme req 1 ac 1 is met by req 2.1 to req 2.17 and req 2.34 to req 2.35."
req_1_ac_2 = "Programme req 1 ac 2 is met by req 2.18 to req 2.21: the pool lifecycle is exactly the one the Launch-x contracts and manifest define (Launch-x:shared/config/deployment/current.json:107), with no stage the contracts do not have."
req_1_ac_3 = "Programme req 1 ac 3 is met by req 2.23 to req 2.25 and req 2.36 to req 2.40."
req_1_ac_4 = "Programme req 1 ac 4 is met by req 2.11 and req 2.12."
req_1_ac_5 = "Programme req 1 ac 5 is met by req 2.30 to req 2.32."

[task.2.0.1]
title = "Copy the role ABIs of SidioraPool, SidioraFactory, SidioraERC20 and test their counts"
status = "done"
mode = "BUILD"
wave = 0
requires = []
