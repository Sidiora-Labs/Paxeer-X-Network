[contract_context.6.addresses]
interface = "PRECOMPILES in src/core/network/precompiles.ts (planned) is the only source of chain addresses: perps 0x1015, launchpad 0x1017 as an allowance spender and spot 0x1021 to 0x1025, each overridable through the envAddress pattern of Hyperpax:src/core/spot/addresses.ts:23-27 with the variables of contracts/application.md#address-table."
storage = "No address is persisted; overrides are build-time environment values and a malformed value fails module load."
errors = "An override that is not 20 bytes throws with the variable name."
gate = "tests/precompiles.test.ts"
invariants = "USDL has one address, 0x85FcD13735F4309833A503EE804ea32395851479 at 6 decimals; chain id 125 comes from paxeerChain (Hyperpax:src/core/chain.ts:16-17); the application has no pricefeed entry and no NEXT_PUBLIC_SPOT_* override."

[contract_context.6.abi]
interface = "PerpsPrecompileABI is generated from contracts/perps.md with its tuples, enumerations, section 18 events and the custom errors of contracts/perps.md#19-errors; the spot ABI files keep the selectors and errors of contracts/spot.md."
storage = "The generated modules are as-const TypeScript in the shape of Hyperpax:src/core/network/abi/PositionFacet.ts:1-2."
errors = "A selector drift fails tests/spot-abi.test.ts and an argument drift fails pnpm tsc --noEmit."
gate = "tests/perps-abi.test.ts, tests/spot-abi.test.ts and tests/abi-barrel.test.ts"
invariants = "The barrel holds the precompile ABI and IERC20 only; no facet ABI and no spot ABI without a precompile remains."

[contract_context.6.perps_calls]
interface = "Pure builders in src/core/perps/calls.ts return { address, abi, functionName, args } for every perpetuals method of contracts/application.md#perpetual-call-sites on placeOrder, closePositionWithParams, setPositionTpSl, cancelOrder and cancelByCloid."
storage = "Builders hold no state; hooks pass their output to writeContract (Hyperpax:src/hooks/perps/useContract.ts:49-101)."
errors = "Builders reject a zero amount, a leverage below 1x and an inverted TP/SL pair before any call is built."
gate = "tests/perps-calls.test.ts"
invariants = "Every market-priced write carries acceptablePrice and deadline; collateral amounts are USDL base units at 6 decimals."

[contract_context.6.order_plan]
interface = "buildOrderPlan(formState, quote) in src/core/perps/orderPlan.ts returns the ordered calls handleSubmit (Hyperpax:src/widgets/trading/PerpsOrderForm.tsx:444-506) sends, and buildConfirmation the quoted content shown before signing."
storage = "The form keeps its React state; the plan is recomputed on every submit."
errors = "An invalid input returns an error code and no calls."
gate = "tests/order-plan.test.ts"
invariants = "A scaled ladder has 2 to 20 rungs whose sizes sum exactly to the order size and whose cloids derive from one ladder id; no market order encodes GTC."

[contract_context.6.account]
interface = "The connected address holds one USDL cross-margin account at 0x1015 read with getAccount(account) and the account-argument views of contracts/perps.md section 3; useAccount (planned) replaces the per-user vault of Hyperpax:src/hooks/perps/useVault.ts:8-24."
storage = "Balances live in the perpetuals precompile; the application caches nothing between renders."
errors = "Withdraw above withdrawable reverts and is classified; transferMargin stays in the generated ABI and reverts CROSS_MARGIN_ONLY, and the application has no caller."
gate = "tests/perps-calls.test.ts and tests/account-hook.test.ts"
invariants = "No createVault, setMarginMode, transferMargin or emergencyWithdraw caller and no Multicall3 read remains."

[contract_context.6.amounts]
interface = "USDL amounts use 6 decimals through safeParseUnits (Hyperpax:src/core/perps/amounts.ts:26-38); prices, sizeUsd and leverage use 18; the PAX and SID pointers use 6."
storage = "Amounts are bigint from parse to encode."
errors = "getCollateralDecimals throws for an unknown token instead of returning 18 (Hyperpax:src/core/perps/amounts.ts:45)."
gate = "tests/amounts.test.ts"
invariants = "No Number multiplication touches an on-chain amount."

[contract_context.6.approvals]
interface = "planApproval returns at most one approve call for exactly the amount of the call it precedes, to PERPS_SPENDER, LAUNCHPAD_SPENDER or SPOT_SPENDERS, and none for the PAX and SID pointers or native value, which move by bank transfer."
storage = "Allowances are read fresh before each ERC20 write."
errors = "An approve failure stops the plan before the trading call."
gate = "tests/approvals.test.ts and tests/spot-approvals.test.ts"
invariants = "No approval equals 2^256 - 1 and no allowance is requested for a native coin."

[contract_context.6.time_in_force]
interface = "OrderType and TimeInForce of contracts/perps.md section 2 ride on placeOrder with the reduceOnly flag; the spot IOC and FOK limit takes minTokenAmount from the limit price."
storage = "Form toggles map one to one onto call arguments."
errors = "A spot IOC fill beyond the limit reverts InsufficientOutput (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:78)."
gate = "tests/order-plan.test.ts and tests/spot-tif.test.ts"
invariants = "No form option is accepted without reaching a call argument; a market order carries IOC or FOK."

[contract_context.6.tp_sl]
interface = "takeProfitPrice and stopLossPrice ride on placeOrder; an open position changes them with setPositionTpSl(positionId, tp, sl); 0 means unset."
storage = "Attached prices live with the position or order in the precompile."
errors = "An inverted pair returns TRADE_TP_SL_INVALID (Hyperpax:src/core/errors/classify.ts:251-253)."
gate = "tests/order-plan.test.ts and tests/positions-panel.test.ts"
invariants = "For a long SL < reference < TP; for a short TP < reference < SL."

[contract_context.6.price_bound]
interface = "acceptablePrice from the quote entryPrice or exitPrice and DEFAULT_SLIPPAGE_BPS (Hyperpax:src/core/perps/config.ts:354); deadline from buildDeadline (Hyperpax:src/core/spot/slippage.ts:75), 0 meaning none."
storage = "The quote is re-fetched when older than QUOTE_MAX_AGE_MS (Hyperpax:src/widgets/trading/PerpsOrderForm.tsx:178)."
errors = "A breached bound or passed deadline reverts and is classified."
gate = "tests/perps-calls.test.ts"
invariants = "Opens round against the trader's side by the bps, closes the opposite way, in integer arithmetic."

[contract_context.6.spot_calls]
interface = "Spot builders in src/core/spot/calls.ts and src/core/spot/quoterCalls.ts target 0x1021 market, 0x1022 limit, 0x1023 stop and 0x1024 quoter with the argument lists of contracts/spot.md."
storage = "No spot state is held in the application beyond the user stream cache."
errors = "Spot custom errors are classified by classifyError."
gate = "tests/spot-calls.test.ts and tests/spot-quoter.test.ts"
invariants = "The spot route stays gated (Hyperpax:src/pages/spot.tsx:2-3); no wrap step precedes a sell."

[contract_context.6.spot_tokens]
interface = "SPOT_TOKENS holds USDL, PAX and SID and SPOT_MARKETS holds PAX/USDL and SID/USDL as contracts/application.md#spot-tokens-and-markets lists them."
storage = "Token and market tables are build-time constants."
errors = "An unknown market symbol resolves to no entry and the form shows no market."
gate = "tests/spot-tokens.test.ts"
invariants = "PAX and SID are the uhpx and SID denom pointers at 6 decimals; no WPAX9, WETH, WBNB, USDC or USDT entry remains."

[contract_context.6.gas]
interface = "gasWithMargin(estimate) in src/core/network/gas.ts sends eth_estimateGas times 12/10 on every write of writeContract (Hyperpax:src/hooks/perps/useContract.ts:49-101)."
storage = "No gas value is cached between writes."
errors = "A failed estimate stops the write and is classified."
gate = "tests/gas.test.ts and tests/e2e-local-node.test.ts"
invariants = "The estimate covers the fixed gas of contracts/perps.md section 21."

[contract_context.6.data_surfaces]
interface = "Chainflow through FEED_ORIGIN (Hyperpax:src/core/feeds.ts:2) serves charts, prices, candles, tickers, open interest and reference books; the gateway serves the venue's own fills and book and account state and history, as contracts/application.md#data-surfaces assigns them."
storage = "Origins are build-time values in src/core/feeds.ts and src/core/network/gateway.ts."
errors = "A missing gateway variable fails module load with the variable name."
gate = "tests/rest-bases.test.ts and tests/socket-urls.test.ts"
invariants = "No module outside the constant modules names a data or chain endpoint host."

[contract_context.6.gateway_rest]
interface = "gatewayUrls() derives the REST, spot user, PerfDB and indexer GraphQL bases from NEXT_PUBLIC_PERPS_GATEWAY_URL; route paths are unchanged."
storage = "Bases are build-time values."
errors = "A missing gateway variable fails module load with the variable name."
gate = "tests/gateway-config.test.ts and tests/rest-bases.test.ts"
invariants = "Chart candles keep FEED_ORIGIN (Hyperpax:src/core/feeds.ts:2); the only gateway book route the application reads is /api/orderbook/<SYMBOL> for resync."

[contract_context.6.websocket]
interface = "The gateway /ws socket speaks the {event, topic} frames of contracts/data-services.md section 8 with snapshot, seq and snapshotId; the spot user socket is the gateway /v1/ws; Chainflow streams derive from FEED_ORIGIN."
storage = "Per-topic book and fill state with its last seq."
errors = "A gap closes with 4000 and resyncs from REST; 1013 and retry-after delay the reconnect (Hyperpax:src/core/net/realtime.ts:84-85)."
gate = "tests/venue-stream.test.ts, tests/socket-urls.test.ts and tests/realtime.test.ts"
invariants = "No delta at or below the applied snapshot seq is applied."

[contract_context.6.venue_streams]
interface = "venueStream.ts (planned src/core/net/venueStream.ts) subscribes <SYMBOL>@perp_orderbook, <SYMBOL>@perp_trade, <SYMBOL>@orderbook and <SYMBOL>@trade on the gateway /ws as contracts/application.md#venue-streams lists them."
storage = "One socket per origin shared across topics."
errors = "A symbol the venue does not list shows the Chainflow reference book."
gate = "tests/venue-stream.test.ts and tests/spot-venue-stream.test.ts"
invariants = "A socket stays within 200 subscriptions and every topic is unsubscribed on unmount."

[contract_context.6.graphql]
interface = "The 51 queries, the subscriptions and the PerfDB operations keep their names on the gateway GraphQL endpoint, with the gateway-only fields nullable."
storage = "The golden list in tests/graphql-operations.test.ts is the pinned operation set."
errors = "An operation missing from the gateway list fails the golden test."
gate = "tests/graphql-operations.test.ts"
invariants = "The application operation set is a subset of the operations contracts/data-services.md section 13 serves."

[contract_context.6.wallet]
interface = "The embedded wallet signs as today; the auth client uses PKCE and exchanges the code only on the callback page; chain id and RPC come from the chain modules."
storage = "Sessions are stored by the auth client after the callback exchange."
errors = "A failed exchange leaves no session and returns to sign-in."
gate = "tests/embedded-auth.test.ts and tests/embedded-wallet.test.ts"
invariants = "Chain id 125 from paxeerChain; transactions target the address table only."

[contract_context.6.errors]
interface = "classifyError decodes custom errors against the precompile ABIs before its string rules."
storage = "The mapping is a constant table in classify.ts."
errors = "Undecodable revert data keeps RPC_REVERT (Hyperpax:src/core/errors/classify.ts:153-160)."
gate = "tests/classify-precompile.test.ts"
invariants = "Every custom error of contracts/perps.md#19-errors and contracts/spot.md has one application code."

[contract_context.6.deploy]
interface = "Every NEXT_PUBLIC_* variable the application reads is declared in the template and deploy files of contracts/application.md#deploy-configuration."
storage = "Variables are build-time values; deployed.json is removed."
errors = "A build without NEXT_PUBLIC_PERPS_GATEWAY_URL fails at module load with the variable name."
gate = "tests/deploy-config.test.ts"
invariants = "No Diamond-era, legacy indexer, PerfDB or spot base variable remains in any deploy file."

[contract_context.6.end_to_end]
interface = "tests/e2e-local-node.test.ts runs the trading round trip against a local node at v6.12.0 and the gateway."
storage = "The test key and node endpoint come from LOCAL_NODE_RPC and LOCAL_NODE_KEY in the environment."
errors = "A missing endpoint fails the test with the variable name; it never skips."
gate = "tests/e2e-local-node.test.ts"
invariants = "USDL balance arithmetic closes to the base unit net of the fees in the receipts' events."

