[req.7005]
title = "Every spot and oracle event decodes into its fact table"
ac_1 = "MarketOrderExecuted (Hyperpax:src/core/network/spot_abi/PECOR.ts:852) from PECOR 0x1021 with the signature MarketOrderExecuted(address indexed user, address indexed stablecoin, address indexed token, uint256 stablecoinAmount, uint256 tokenAmount, bool isBuy) decodes into perps.spot_swaps with kind market_order and every argument, plus one perps.protocol_events row."
