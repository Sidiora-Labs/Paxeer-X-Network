[capability.2.1.1]
title = "ABI freeze per role"
reqs = ["2001.1", "2001.2", "2001.3", "2001.4"]
touches = ["precompiles/launchpad/abi/", "precompiles/launchpad/abi.json", "precompiles/launchpad/testdata/abi_golden.txt"]
tests = ["precompiles/launchpad/abi_test.go"]
verification_contract = "go test ./precompiles/launchpad/... -run TestRoleABIGolden"
do_1 = "Copy the ABI arrays of the ten role artifacts of the Launch-x build into precompiles/launchpad/abi/<Role>.json (symbol roleABIs), the SidioraPool artifact compiled from Launch-x:contracts/contracts/core/SidioraPool.sol:147."
do_2 = "Load each role file with MustGetABI (precompiles/common/precompiles.go:449) through an embed.FS as precompiles/launchpad/launchpad.go:94 does (symbol loadRoleABIs)."
do_3 = "Build abi.json for 0x1017 from the seven direct roles in the order Router, SidioraFactory, Quoter, PoolRegistry, FeesRouter, FeeAccumulator, ProtocolConfig, first role winning, plus the twelve EventEmitter launchpad events declared in Launch-x:contracts/contracts/interfaces/IEventEmitter.sol:21 (symbol directABI)."
do_4 = "Write testdata/abi_golden.txt with role, signature and selector per line and TestRoleABIGolden recomputing each with crypto.Keccak256, replacing the current pinned interface of precompiles/launchpad/launchpad.go:46 (symbol TestRoleABIGolden)."

[capability.2.1.2]
title = "Parameters aligned with ProtocolConfig"
reqs = ["2029.1", "2029.2", "2029.3", "2029.4"]
touches = ["modules/launchpad/types/params.go", "modules/launchpad/types/params_test.go"]
tests = ["modules/launchpad/types/params_test.go"]
verification_contract = "go test ./modules/launchpad/types/... -run TestDefaultParamsMatchProtocolConfig"
do_1 = "Set ConcentrationWeight 0 and CreationFee 1000000 in DefaultParams (modules/launchpad/types/params.go:34) to match Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:53 and Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:54 (symbol DefaultParams)."
do_2 = "Extend Validate (modules/launchpad/types/params.go:50) with concentrationWeight == 0 (Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:84), uint112 virtual defaults (Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:100) and baseFeeBps within min and max (Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:60) (symbol Params.Validate)."
do_3 = "Keep MaxProtocolFeeBps 5000 (modules/launchpad/types/params.go:11) as Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:67 (symbol MaxProtocolFeeBps)."
do_4 = "Emit ConfigUpdated with keccak256 of the key name, old and new values from UpdateParams (modules/launchpad/keeper/keeper.go:76) as Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:109 does (symbol emitConfigUpdated)."

[capability.2.2.1]
title = "Market model, surfaces and roles in the keeper"
reqs = ["2002.2", "2002.3", "2002.5", "2013.1", "2013.2", "2013.3", "2013.4", "2013.5", "2013.6", "2013.7", "2013.8", "2013.9"]
touches = ["modules/launchpad/types/market.go", "modules/launchpad/types/keys.go", "modules/launchpad/keeper/roles.go", "modules/launchpad/keeper/surfaces.go"]
tests = ["modules/launchpad/keeper/keeper_test.go"]
verification_contract = "go test ./modules/launchpad/keeper/... -run TestSurfaceRegistry"
do_1 = "Extend Market (modules/launchpad/types/market.go:58) with Generation, PoolAddress, TokenAddress, Optical, FeeAccumulator, Guardian, PendingGuardian, LastSnapshotTimestamp, CumulativeBuyQuoteVolume, CumulativeSellQuoteVolume, FeeRightCollection and FeeRightID, the pool fields of Launch-x:contracts/contracts/core/SidioraPool.sol:53-59 (symbol Market)."
do_2 = "Add SurfacePrefix and RolePrefix keys next to MarketPointerPrefix (modules/launchpad/types/keys.go:41) mapping a surface address to (role, generation, market) and (contract, role, account) to membership (symbol SurfaceKey)."
do_3 = "Implement HasRole, RoleAdmin and the DEFAULT_ADMIN_ROLE refusal with MissingRole(caller, 0x00) as AccessControl does at Launch-x:contracts/contracts/base/AccessControl.sol:48 and Launch-x:contracts/contracts/base/AccessControl.sol:42 (symbol Keeper.HasRole)."
do_4 = "Return 0 from RegisteredDefaultAdminCount, as no admin is carried (Launch-x:contracts/contracts/base/AccessControl.sol:32) (symbol Keeper.RegisteredDefaultAdminCount)."

[capability.2.2.2]
title = "Swap engine in uusdl"
reqs = ["2019.1", "2019.2", "2019.3", "2019.4", "2019.5", "2019.6", "2019.7", "2018.3", "2018.4"]
touches = ["modules/launchpad/keeper/swap.go", "modules/launchpad/keeper/swap_test.go", "modules/launchpad/types/math.go"]
tests = ["modules/launchpad/keeper/swap_test.go"]
verification_contract = "go test ./modules/launchpad/keeper/... -run TestSwapGoldenVectors"
do_1 = "Rewrite Swap (modules/launchpad/keeper/swap.go:129) into the contract order of Launch-x:contracts/contracts/core/SidioraPool.sol:168-248: deadline, input, recipient, prepaid input from the bank balance of the pool address (symbol Keeper.Swap)."
do_2 = "Apply the fee on input with MulDiv (modules/launchpad/types/math.go:49) and the buy and sell branches with GetAmountOut (modules/launchpad/types/math.go:76) (symbol quote)."
do_3 = "Update cumulative volume per side and the snapshot ring under the 60 s and 1 bps gate of Launch-x:contracts/contracts/core/SidioraPool.sol:406-413 (symbol updateSnapshot)."
do_4 = "Send the buy fee to the bank account of the generation FeeAccumulator with SendCoins (modules/launchpad/types/expected_keepers.go:16) and record it through RecordFee (symbol Keeper.RecordFee)."

[capability.2.2.3]
title = "Market creation"
reqs = ["2020.1", "2020.2", "2020.3", "2020.4"]
touches = ["modules/launchpad/keeper/market.go", "modules/launchpad/keeper/market_test.go"]
tests = ["modules/launchpad/keeper/market_test.go"]
verification_contract = "go test ./modules/launchpad/keeper/... -run TestCreateMarket"
do_1 = "Rewrite CreateMarket (modules/launchpad/keeper/market.go:27) to charge the creation fee to the generation 2 Treasury account as Launch-x:contracts/contracts/periphery/Router.sol:165 does (symbol Keeper.CreateMarket)."
do_2 = "Create the denom with Subdenom (modules/launchpad/keeper/market.go:18) and register the pointer through registerPointer (modules/launchpad/keeper/market.go:99) or a token surface for BEFORE_TOKEN_TRANSFER markets (symbol registerTokenAddress)."
do_3 = "Derive the pool address with CREATE2 over keccak256(token) as Launch-x:contracts/contracts/core/SidioraFactory.sol:143 (symbol poolAddress)."
do_4 = "Mint the fee right at nextTokenId of the generation 2 collection and write the PoolRegistry metadata of Launch-x:contracts/contracts/interfaces/IPoolRegistry.sol:15 (symbol mintFeeRight)."

[capability.2.2.4]
title = "Fees and fee rights"
reqs = ["2021.1", "2021.2", "2021.3", "2021.4", "2011.1", "2011.2", "2011.3", "2011.4", "2011.5", "2011.6", "2011.7", "2011.8", "2011.9", "2011.10", "2011.11", "2011.12", "2011.13", "2011.14", "2011.15", "2011.16", "2011.17", "2011.18", "2011.19", "2011.20", "2011.21", "2011.22", "2011.23", "2011.24", "2011.25", "2011.26", "2011.27", "2011.28"]
