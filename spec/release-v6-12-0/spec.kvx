capabilities = ["4.1.1"]
do_1 = "Write precompiles/spot/abi/pecor.json as the JSON form of the application ABI PECOR (Hyperpax:src/core/network/spot_abi/PECOR.ts:313), keeping every entry, name, input, output, indexed flag and state mutability."
do_2 = "Write precompiles/spot/testdata/pecor.golden.json with one row per function (selector), event (topic0) and error (selector) computed as keccak256 of the canonical signature as go-ethereum abi computes Method.ID (precompiles/common/precompiles.go:227 dispatch by selector), for example 0x77a61952 for `marketBuy(address,address,uint256,uint256,uint256)`."
do_3 = "Add TestPECORABIGolden in precompiles/spot/abi_pecor_test.go that parses the ABI with go-ethereum abi.JSON, as pcommon.MustGetABI does for launchpad (precompiles/launchpad/launchpad.go:190), and compares Method.ID, Event.ID and Error.ID with every golden row."
do_4 = "The test fails on any row missing from either side, so the served ABI cannot drift from the application ABI the Hyperpax application encodes (Hyperpax:src/hooks/spot/useSpotOrders.ts:164-167)."
do_5 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["TestPECORABIGolden", "pecor.json", "pecor.golden.json"]
touches = ["precompiles/spot/abi/pecor.json", "precompiles/spot/testdata/pecor.golden.json", "precompiles/spot/abi_pecor_test.go"]
build_cmd = "go vet ./precompiles/spot/"
verify_cmd = "go test ./precompiles/spot/ -run TestPECORABIGolden"
gate_kind = "planned"
planned_paths = ["precompiles/spot/abi/pecor.json", "precompiles/spot/testdata/pecor.golden.json", "precompiles/spot/abi_pecor_test.go"]
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark complete without the declared evidence."
path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to their current equivalents before the gate can run; historical references never authorize a duplicate implementation tree. Complete scoped path reconciliation without dropping acceptance criteria."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

