do_1 = "Add api/spot/tx.proto with service Msg { rpc UpdateParams } and MsgUpdateParams{authority, params}, in the shape of api/launchpad/tx.proto:5 and api/launchpad/tx.proto:22, go_package modules/spot/types (api/launchpad/tx.proto:4)."
do_2 = "Generate modules/spot/types/tx.pb.go from it with the repository buf configuration of api/buf.gen.yaml, keeping the MsgUpdateParams message shape of api/launchpad/tx.proto:22."
do_3 = "Add modules/spot/types/msgs.go with Route, Type, GetSigners, GetSignBytes and ValidateBasic calling Params.Validate, as modules/launchpad/types/msgs.go:9-22."
do_4 = "GetSigners returns the authority, so only the governance module account can sign the message (modules/launchpad/types/msgs.go:11)."

[capability.4.2.4]
title = "Add the spot keeper and bank custody of uusdl, uhpx and usid through the module account"
reqs = ["4002.1", "4002.2", "4002.3", "4002.4", "4002.5", "4002.6", "4002.7", "4002.8", "4002.9", "3.2"]
touches = ["modules/spot/keeper/keeper.go", "modules/spot/keeper/custody.go", "modules/spot/keeper/custody_test.go"]
tests = ["modules/spot/keeper/custody_test.go"]
verification_contract = "go test ./modules/spot/keeper/ -run TestCustody"
do_1 = "Add Keeper in modules/spot/keeper/keeper.go with storeKey, bank, EVM, pricefeed keepers and the authority, in the shape of modules/launchpad/keeper/keeper.go:19-48, with GetParams and UpdateParams checking the authority as modules/launchpad/keeper/keeper.go:76-86."
do_2 = "CustodyAddress returns the spot module account (modules/launchpad/keeper/keeper.go:40 derivation); denomOf(ctx, token) resolves a token argument through GetNativePointee (modules/evm/keeper/pointer.go:444) and the stable token through GetERC20NativePointer(ctx, \"uusdl\") (precompiles/utils/expected_keepers.go:127)."
do_3 = "pullTokens(ctx, token, from, amount) moves the denom by bank SendCoins (precompiles/utils/expected_keepers.go:100) from the caller to the module account with no allowance read, and returns SafeERC20FailedOperation(token) when the send fails (Launch-x:contracts/contracts/meta-ag/vault/PECORVault.sol:284-298 target behaviour)."
do_4 = "pushTokens(ctx, token, to, amount) moves the denom from the module account to the recipient; a token that is not a native pointer returns UnsupportedTransfer() (Launch-x:contracts/contracts/meta-ag/vault/PECORVault.sol:554-565 target behaviour); pullNative converts an attached value to uhpx at value / 1e12 and refuses a remainder with UnsupportedInputTransfer()."
do_5 = "A re-entry flag in the transient store refuses a nested spot call with ReentrancyGuardReentrantCall(), the guard of Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:54."

[capability.4.2.5]
title = "Price every trade from the pricefeed index price"
reqs = ["4003.1", "4003.2", "4003.3", "4003.4", "4003.5", "4003.6", "4003.7", "4003.8", "4003.9", "4003.10", "3.2"]
touches = ["modules/spot/keeper/pricing.go", "modules/spot/keeper/pricing_test.go"]
tests = ["modules/spot/keeper/pricing_test.go"]
verification_contract = "go test ./modules/spot/keeper/ -run TestPricing|TestIndexPrice|TestStable|TestStale|TestGross|TestTokenWithout"
do_1 = "Add IndexPrice(ctx, token) reading modules/pricefeed/keeper GetPrice(ctx, marketId) with marketId from TokenParams; stablecoins return 1e18, replacing the oracle read of Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:303."
do_2 = "A fresh false result returns StalePrice() (Launch-x:contracts/contracts/meta-ag/oracle/PriceOracle.sol:161); a zero marketId on a non-stable returns InvalidOracle()."
do_3 = "Convert(amount, priceIn, priceOut, decIn, decOut, up) follows PECORMath convert (Launch-x:contracts/contracts/meta-ag/engine/PECORMath.sol:12) with full 512-bit precision (Launch-x:contracts/contracts/meta-ag/engine/PECORMath.sol:53)."
do_4 = "VolumeUSD(amount, price, dec) is amount x price / 10^dec as the engine computes it (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:743-747 input)."

