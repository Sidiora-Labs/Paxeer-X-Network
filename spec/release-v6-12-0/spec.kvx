do_3 = "Add AbiError in modules/spot/types/errors.go: a Go error carrying the 4-byte selector and packed arguments of each error of contracts/spot.md#errors, registered next to sdkerrors codes as launchpad registers its errors (modules/launchpad/types/errors.go:11-34)."
do_4 = "Add GenesisState with params, tokens, orders, counters, accruals and TWAP rings, and DefaultGenesis and Validate in the shape of modules/launchpad/types/genesis.go:56-72."

[capability.4.2.3]
title = "Add MsgUpdateParams for the spot module"
reqs = ["4008.1", "4008.2", "4008.3", "4008.4", "4008.5", "4008.6", "4008.7", "4008.8", "4008.9", "4008.10", "4008.11", "4008.12", "4008.13", "4008.14", "4008.15", "4008.16", "4008.17", "4008.18", "4008.19", "4008.20", "4008.21", "4008.22", "4008.23", "4008.24", "4008.25", "4008.26", "4008.27", "4008.28", "4008.29", "4008.30", "4008.31", "4008.32", "4008.33", "4008.34", "4008.35", "4008.36", "4008.37", "4008.38", "4008.39", "3.2"]
