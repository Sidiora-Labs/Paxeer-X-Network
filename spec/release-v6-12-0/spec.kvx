ac_16 = "`getEffectiveReserves()` (selector 0x6e7f1e46, view, returns `(uint256,uint256)`) declared at Launch-x:contracts/contracts/core/SidioraPool.sol:338 is served at every pool address of generations 1 and 2 and every pool created after the upgrade and returns the value the contract returned at the halt height for migrated state and the value of the launchpad keeper state afterwards, with identical ABI encoding."
ac_17 = "`getPoolInfo()` (selector 0x60246c88, view, returns `((address,address,uint256,uint256,uint256,uint256,uint256))`) declared at Launch-x:contracts/contracts/core/SidioraPool.sol:350 is served at every pool address of generations 1 and 2 and every pool created after the upgrade and returns the value the contract returned at the halt height for migrated state and the value of the launchpad keeper state afterwards, with identical ABI encoding."
ac_18 = "`getPrice()` (selector 0x98d5fdca, view, returns `(uint256)`) declared at Launch-x:contracts/contracts/core/SidioraPool.sol:346 is served at every pool address of generations 1 and 2 and every pool created after the upgrade and returns the value the contract returned at the halt height for migrated state and the value of the launchpad keeper state afterwards, with identical ABI encoding."
ac_19 = "`getPriceSnapshots()` (selector 0x680aef93, view, returns `(uint256[8])`) declared at Launch-x:contracts/contracts/core/SidioraPool.sol:362 is served at every pool address of generations 1 and 2 and every pool created after the upgrade and returns the value the contract returned at the halt height for migrated state and the value of the launchpad keeper state afterwards, with identical ABI encoding."
ac_20 = "`getReserves()` (selector 0x0902f1ac, view, returns `(uint256,uint256,uint256)`) declared at Launch-x:contracts/contracts/core/SidioraPool.sol:328 is served at every pool address of generations 1 and 2 and every pool created after the upgrade and returns the value the contract returned at the halt height for migrated state and the value of the launchpad keeper state afterwards, with identical ABI encoding."
