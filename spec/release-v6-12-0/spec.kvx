do_1 = "Set version to v6.12.0 and upgrade to v6.12.0 in tools/release/version.json:2-3, the values decision.1 folds v6.11 into; no other key is added (tools/release/version.json:1-4)."
do_2 = "Add tools/release/tests/identity.test.sh function version_and_upgrade_are_v6120 that reads both fields with jq -er, the reader of tools/release/build-paxd.sh:19 and .github/workflows/paxeer-release-check.yml:39."
do_3 = "Add upgrade_name_is_declared grepping node and modules for the exact declaration V6120Upgrade = \"v6.12.0\" that task 1.0.3 adds in node/upgrades_v6120.go, the grep task 8.4.4 puts in .github/workflows/paxeer-release-check.yml:46-49, so the test fails until that constant exists and the custody constant of task 1.0.5 does not satisfy it."
do_4 = "Add version_is_newer_than_latest_tag reproducing the semver pattern of .github/workflows/paxeer-release-check.yml:40 and the sort -V comparison of .github/workflows/paxeer-release-check.yml:57-65 in a scratch git repository with tags paxeer-network/v6.8.0 and paxeer-network/v6.10.0."
do_5 = "Add tag_is_free_and_derived asserting refs/tags/paxeer-network/v6.12.0 is absent (.github/workflows/paxeer-release-check.yml:51-55) and equals the tag of tools/release/build-paxd.sh:20."

[capability.8.1.2]
