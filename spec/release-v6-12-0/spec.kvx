reqs = ["6001.1", "6014.1", "6014.2", "6014.3", "6014.4", "6014.5", "6014.6", "6015.5", "6015.6", "6016.1", "6021.1", "6021.2", "6021.3", "6021.4", "6022.4"]
touches = ["Hyperpax:src/core/perps/config.ts", "Hyperpax:src/core/spot/api.ts", "Hyperpax:src/core/perfdb/client.ts", "Hyperpax:src/core/wagmi.ts", "Hyperpax:src/hooks/spot/useSpotUserStream.ts", "Hyperpax:src/hooks/chain/useExplorerStream.ts", "Hyperpax:src/hooks/spot/useSpotMarketStream.ts", "Hyperpax:src/hooks/perps/useMarketsStream.ts", "Hyperpax:src/hooks/perps/useSidPaxMarketStream.ts"]
tests = ["Hyperpax:tests/rest-bases.test.ts", "Hyperpax:tests/feeds.test.ts", "Hyperpax:tests/socket-urls.test.ts", "Hyperpax:tests/realtime.test.ts"]
verification_contract = "node --test --import tsx tests/rest-bases.test.ts"
do_1 = "Keep charts, prices, candles, tickers, open interest and reference books on Chainflow through FEED_ORIGIN and read only the venue's own fills, book and account state and history from the gateway."
symbols = ["gatewayUrls", "INDEXER_GRAPHQL", "SPOT_API_BASE", "PERFDB_URL", "PERFDB_GRAPHQL", "EXPLORER_URL", "SPOT_USER_WS_URL", "EXPLORER_WS_URL", "FEED_ORIGIN", "MARKETS_WS_URL", "watchSocket", "scheduleActive"]

[capability.6.6.1]
title = "Embedded wallet"
reqs = ["6001.6", "6014.5", "6017.1", "6017.2", "6017.3", "6017.4", "6017.5"]
touches = ["Hyperpax:src/core/wallet/embedded/sdk/index.ts", "Hyperpax:src/pages/auth/callback.tsx", "Hyperpax:src/core/wallet/embedded/client.ts"]
tests = ["Hyperpax:tests/embedded-auth.test.ts", "Hyperpax:tests/embedded-wallet.test.ts"]
verification_contract = "node --test --import tsx tests/embedded-auth.test.ts"
do_1 = "Use the PKCE flow with a callback-only code exchange and take the chain id and RPC from the chain modules."
symbols = ["createClient", "exchangeCodeForSession", "resolvePaxeerConfig", "paxeerChain"]

[capability.6.6.2]
title = "Precompile error classification"
reqs = ["6018.1", "6018.2", "6018.3", "6018.4", "6018.5"]
touches = ["Hyperpax:src/core/errors/classify.ts"]
tests = ["Hyperpax:tests/classify-precompile.test.ts"]
verification_contract = "node --test --import tsx tests/classify-precompile.test.ts"
do_1 = "Decode precompile custom errors before the string rules and give every error of both ABIs an application code."
symbols = ["classifyError", "PRECOMPILE_ERROR_CODES", "decodeErrorResult"]

[capability.6.6.3]
title = "Invariants, end-to-end round trip and domain completion"
reqs = ["6001.5", "6002.2", "6003.7", "6004.5", "6005.1", "6005.2", "6005.3", "6005.4", "6006.2", "6006.5", "6007.1", "6010.4", "6010.5", "6013.4", "6014.5", "6019.1", "6019.2", "6019.3", "6019.4", "6019.5", "6019.6", "6019.7", "6023.2"]
touches = ["Hyperpax:package.json"]
tests = ["Hyperpax:tests/v6120-invariants.test.ts", "Hyperpax:tests/e2e-local-node.test.ts"]
verification_contract = "node --test --import tsx tests/v6120-invariants.test.ts"
do_1 = "Pin the release invariants over the application tree, run the trading round trip against a local node and run the whole test set once at completion."
symbols = ["v6120Invariants", "e2eLocalNode", "LOCAL_NODE_RPC", "LOCAL_NODE_KEY", "verify:v6120"]

[capability.6.6.4]
title = "Deploy configuration"
reqs = ["6024.1", "6024.2", "6024.3"]
touches = ["Hyperpax:src/env/.env.template", "Hyperpax:src/env/.env.node", "Hyperpax:src/env/.env.remix", "Hyperpax:src/env/.env.local.nextjs", "Hyperpax:src/env/deployed.json", "Hyperpax:deploy/.env.production.example", "Hyperpax:deploy/docker-compose.yml", "Hyperpax:deploy/Dockerfile", "Hyperpax:deploy/README.md"]
tests = ["Hyperpax:tests/deploy-config.test.ts"]
verification_contract = "node --test --import tsx tests/deploy-config.test.ts"
do_1 = "Declare the gateway and precompile variables in the template and deploy files, remove the Diamond-era and legacy variables and delete deployed.json."
symbols = ["NEXT_PUBLIC_PERPS_GATEWAY_URL"]

[acceptance.6.1.1]
feature = "6"
req = "6001.1"
scenario = "Given the module loaded with no environment overrides, when PRECOMPILES.perps is read, then it equals 0x0000000000000000000000000000000000001015 and PRECOMPILES.spot.PECOROrders equals 0x0000000000000000000000000000000000001022."
contract = "contracts/application.md#address-table"
test = "Hyperpax:tests/precompiles.test.ts::defaultsAreTheReleaseAddresses (planned)"
qualification = "UNRUN"

[acceptance.6.1.2]
