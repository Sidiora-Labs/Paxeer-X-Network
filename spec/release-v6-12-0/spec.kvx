do_3 = "holdings reads the native balance and the balanceOf of every token of perps.spot_token_seen from the node through PERPS_RPC_URLS at the latest height and lists the tokens with a non-zero balance; positions, closed legs and pnl come from the average-cost fold of internal/pnl over spot_swaps and the spot order events; identity carries trading24h from the same rows (contracts/data-services.md section 25)."
do_4 = "/v1/leaderboards/<kind> for pnl, volume and win-rate (Hyperpax:src/core/spot/api.ts:357-361) answers {kind, items: [{rank, address, value}]}; an error answers {error: <message>} with the HTTP status, the field the client reads (Hyperpax:src/core/spot/api.ts:264) (contracts/data-services.md section 25)."
do_5 = "Add TestSpotUsersREST with one subtest per route plus address_case, trades_cursor, closed_legs_cursor and unknown_kind_404 (contracts/data-services.md section 25)."

[capability.7.3.16]
title = "Spot user socket on /v1/ws"
reqs = ["7024.17", "7024.18", "7024.19", "7024.20", "7024.21", "7024.22", "7024.23", "7024.24", "7024.25"]
touches = ["platform/perps-data/internal/ws/spotuser.go", "platform/perps-data/internal/ws/spotuser_test.go"]
