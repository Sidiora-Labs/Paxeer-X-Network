reqs = ["7010.9", "7010.10", "7010.11", "7010.12", "7010.13", "7010.14", "7010.15", "7010.16", "7010.17", "7010.18", "7010.19", "7010.20", "7011.7", "7011.8", "7011.9", "7017.15", "7017.16"]
