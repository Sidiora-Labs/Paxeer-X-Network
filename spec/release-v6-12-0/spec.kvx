[contract_context.3.interface]
address = "The perpetuals venue is served at 0x0000000000000000000000000000000000001015, the address the exchange precompile holds today (modules/layerxexchange/types/ids.go:15, precompiles/layerxexchange/layerxexchange.go:71), from the v6.12.0 activation height."
surface = "IPerps in precompiles/perps/Perps.sol declares 67 methods (63 names, four of them with an account overload: getBalance, getLockedBalance, getAccountSummary and getMarginMode), 30 events, 44 parameterless custom errors and the eleven structures OrderParams, AccountSummary, AccountState, PositionMargin, MarginTier, OrderDetails, PositionDetails, MarketConfig, MarketQuote, OpenPositionQuote and ClosePositionQuote; its compiled abi.json is embedded by the leaf package precompiles/perps/abi and loaded with MustGetABI (precompiles/common/precompiles.go:449)."
compatibility = "Every one of the 32 distinct methods the Hyperpax application calls keeps its selector and tuple order: positions (Hyperpax:src/hooks/perps/usePosition.ts:29-121), orders (Hyperpax:src/hooks/perps/usePerpsOrders.ts:10-91), vault calls (Hyperpax:src/hooks/perps/useVault.ts:12-58), margin views (Hyperpax:src/hooks/perps/useMarginMode.ts:41-283), quotes (Hyperpax:src/hooks/perps/useQuoter.ts:119-146) and portfolio balances (Hyperpax:src/hooks/perps/usePortfolioStats.ts:154-155); the Diamond shapes of getMarkPrice, getFundingState, getFees and getLiquidationPrice are kept and the borrowing views are not declared (contracts/perps.md section 25)."
vault_address = "createVault and getVault return 0x0000000000000000000000000000000000001015 for an account that exists and the zero address otherwise, so the application's vault-address calls (Hyperpax:src/hooks/perps/useVault.ts:28-58) reach the precompile; no vault contract is deployed."
caller = "The account of every write is the EVM caller; any DELEGATECALL reverts with PerpsDelegatecall() and a write under STATICCALL reverts with PerpsStaticCall(), the refusals of precompiles/layerxexchange/layerxexchange.go:205-206 and :213-214; value transfers are refused by ValidateNonPayable (precompiles/common/precompiles.go:374)."
collateral = "Collateral is the USDL ERC20 0x85FcD13735F4309833A503EE804ea32395851479 (6 decimals; Hyperpax:src/core/perps/config.ts:75-79) held in Params.CollateralToken; the one USDL balance of the perps module EVM address backs every store balance, deposit legs run transferFrom into it from the precompile address against the holder's allowance to 0x1015 and withdrawal legs run transfer with the perps module EVM address as caller, each through a nested EVM call capped at 100,000 gas as precompiles/xweb/xweb.go:482 calls the EVM, and a failed leg reverts with PerpsTokenTransferFailed(); no bank coin of USDL exists."

[contract_context.3.storage]
store = "One KV store under store key perps with the prefixes 0x01 to 0x15 of contracts/perps.md section 20, including MarginRatioIndex 0x12, AdlRankIndex 0x13, SweepCursor 0x14 and VenueBooks 0x15 (residueUsd and the sum of deficits); parameters as JSON as modules/launchpad/keeper/keeper.go:50-60 stores them."
book_keys = "Book keys are marketId, side, a 32-byte price key (bids 2^256-1 minus price) and the sequence, so ascending iteration gives price-time priority as better_match orders it (src/modules/perps/lx_perps_book.c:71)."
records = "Order, Position and MarketState replace the C records lx_perps_order, lx_perps_position and lx_perps_funding_state (include/layerx/lx_perps.h:85, :116, :196) with fixed binary encodings; a position carries its reference price, cost basis and funding basis, and a market carries listedAt."
genesis = "InitGenesis and ExportGenesis cover every prefix and ValidateGenesis refuses duplicate ids, orphan book entries and counters below stored ids with LXP_PERPS_INVALID_GENESIS, wired as modules/launchpad/module.go:106-113."
module_accounts = "perps_fees and perps_insurance are store accounts keyed by the EVM form of their module addresses (authtypes.NewModuleAddress, as modules/launchpad/keeper/keeper.go:40 derives one); they hold no bank coins and no USDL of their own, and the module needs no bank permission."

[contract_context.3.errors]
registry = "44 errors with codes 2 to 45 registered under module perps with description LXP_PERPS_<NAME>, as modules/launchpad/types/errors.go:7-9 registers launchpad errors; each maps one to one to a parameterless custom error of contracts/perps.md section 19 whose selectors TestErrorsSelectorsFrozen pins."
revert_text = "The precompile is built without WithLXPReasons (precompiles/common/precompiles.go:107), so Run (precompiles/common/precompiles.go:187-216) keeps the 4-byte custom error selector the executor returns as the whole revert data; the keeper error is unwrapped with errors.Is, Prepare failures (precompiles/common/precompiles.go:227) revert with empty data, and InvalidParams, Unauthorized and InvalidGenesis are keeper-only."
pause = "A paused venue reverts with PerpsPaused() (code 45, selector 0xe0753633); LXP_PAUSED_SCOPE (modules/layerxgov/types/proposal.go:26) is not used by this venue."

[contract_context.3.events]
emission = "30 events are logged from 0x1015 through EmitEVMLog (precompiles/common/evm_events.go:16) inside transactions, with indexed address topics built as addressTopic (precompiles/launchpad/launchpad.go:434); token legs add the USDL contract's own Transfer log."
endblock_receipt = "Events of the EndBlock pass are ABI-packed by the leaf package precompiles/perps/abi and written as one synthetic receipt with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36), logs converted by ConvertSyntheticEthLog (modules/evm/keeper/log.go:109-113), shaped as the shell receipt of node/receipt.go:144-153; its hash is SyntheticReceiptHash(SyntheticReceiptPerps, height), keccak256(\"perps-endblock\" followed by the height as 8 big-endian bytes), it is written under SyntheticReceiptContext at the provisional index math.MaxUint32 - 2, and baseline task 1.0.6 serves it to eth_getLogs and pax_getLogs."
reconstruction = "The fields of the events are sufficient to rebuild every account, order and position, the obligation the data services rely on; modules/perps/keeper/events_reconstruct_test.go checks it."

[contract_context.3.gas]
table = "Each method is charged DefaultGasCost(input, write) plus its surcharge through WithGasTable (precompiles/common/precompiles.go:115-118), DefaultGasCost as precompiles/common/precompiles.go:59-70 and 441-447 compute it from the KV flat and per-byte costs (sdk/store/types/gas.go:349-358)."
refusal = "A method without a gas row is refused before execution, and EndBlock work is charged to no transaction and bounded by the per-block limits of contracts/perps.md section 23."

[contract_context.3.activation]
version_map = "Baseline task 1.2.1 adds exchangeVersionSwitch with the explicit live flag set by the v6.12.0 upgrade handler, and baseline task 1.3.100 passes precompiles/perps NewPrecompile and the unchanged precompiles/layerxexchange NewPrecompile (precompiles/layerxexchange/layerxexchange.go:140) to it at node/app.go:961-965; traced heights resolve through GetCustomPrecompilesVersions (modules/evm/keeper/keeper.go:356-385)."
legacy = "precompiles/layerxexchange stays unchanged; this feature makes no copy of it, adds no GetVersioned entry, leaves precompiles/layerxexchange/versions and node/tags unchanged, and the generated layout of precompiles/common/legacy is owned by layerx-merge task 3.7.5, which lands first."
seed = "SeedV6120(ctx sdk.Context, k Keeper) error writes DefaultParams with CollateralToken the USDL ERC20 address, the eighteen markets with ids 0 to 17 of Hyperpax:src/core/perps/config.ts:168-185 at max leverage 1000 with listedAt the activation block time, the ids the pricefeed uses (contracts/pricefeed.md#markets-and-chainflow-symbols), and the perps_fees and perps_insurance store accounts."
wiring = "Baseline task 1.3.101 adds PerpsK() beside the keepers of node/precompiles.go:98-107, baseline task 1.3.102 the perps store key beside node/app.go:1437, baseline task 1.3.103 the EndBlocker call in node/legacyabci/end_block.go:22-28, and baseline task 1.3.100 keeps the 0x1015 gate of node/upgrades.go:489-503."

[contract_context.3.invariants]
solvency = "balanceOf(perps module EVM address) of the USDL ERC20 x 1e12 equals 1e12 x (sum of collateral, perps_fees and perps_insurance included) - sum of deficits - sum of side x cost basis + sum of side x funding basis + residueUsd, checked against StaticCallEVM balanceOf (modules/evm/keeper/evm.go:157)."
open_interest = "Long open interest equals short open interest per market and equals the sum of position sizes of each side."
book = "Every resting order has one book entry and every book entry points to a resting order of the same market, side and price."
registration = "The nine invariants of contracts/perps.md section 24 are registered in modules/perps/keeper/invariants.go on the pattern of modules/launchpad/keeper/invariants.go:13-20."

[contract_context.3.parameters]
defaults = "DefaultParams in modules/perps/types/params.go carries the figures of contracts/perps-parameters.md sections 1 to 8, CollateralToken, ClassEOiCaps, SweepPositionsPerBlock 512 and LiquidationScanPerBlock 1,024, in the JSON shape of modules/launchpad/types/params.go:16-28."
governance = "Params and markets change only by upgrade handlers through Keeper.UpdateParams and Keeper.SetMarket with the authority check of modules/launchpad/keeper/keeper.go:76-85."
cap = "The venue leverage cap is 1000x on all eighteen markets; the consequences for maintenance margin, liquidation distance and funding are contracts/perps-parameters.md section 9."

[contract_context.3.pause]
exit_set = "While Params.Paused is true only closePosition, partialClose, closePositionWithParams, cancelOrder, cancelByCloid, deposit, addCollateral and topUpPosition run among the state-changing methods; every other one, withdraw, emergencyWithdraw, removeCollateral and liquidate as a transaction included, reverts with PerpsPaused(), while views and the EndBlock steps keep running."
pattern = "CheckPause mirrors CheckPauseScope (modules/layerxgov/types/proposal.go:38-49) and the exchange PauseCheck (modules/layerxexchange/keeper/msg_server.go:52); the exit set lives in modules/perps/keeper/pause.go because pauseExitPaths (modules/layerxgov/types/proposal.go:28) has no perps entry."

[contract_context.3.endblock]
entry = "modules/perps/abci.go EndBlocker(ctx sdk.Context, k keeper.Keeper) runs once per block, called by baseline task 1.3.103 from node/legacyabci/end_block.go:22-28; EndBlock moves no token."
steps = "Nine bounded steps: prices and mark, premium samples, the hourly funding index, triggers (at most 256, in key order), expiries (at most 256), the position sweep (Params.SweepPositionsPerBlock), liquidation (Params.LiquidationScanPerBlock accounts visited, at most 64 accounts and 256 slices) with backstop, deficits and ADL (at most 64 counterparties), then backstop position closes, each market step in its own cached context."
price_read = "Each market reads GetPrice(ctx, marketId) of modules/pricefeed/keeper per contracts/pricefeed.md#freshness-and-read-api, replacing oracle_price_current (src/modules/perps/lx_perps_dispatch.c:294); a market that is not Fresh skips triggers and liquidation for the block."
receipt_index = "The synthetic receipt is written at the provisional index math.MaxUint32 - 2 of SyntheticReceiptContext; flushTransientReceipts (modules/evm/keeper/receipt.go:142) rewrites its TransactionIndex and the TxIndex of its logs to N, the number of transactions of the block (len of txResults, set at node/app.go:2236), so it is the highest real index + 1 and 0 in a block without transactions (baseline req 1.12 ac_3), flushed in HandlePreCommit (node/app.go:1279-1281)."

[contract_context.3.markets]
ids = "Eighteen markets with ids 0 to 17 and the symbols of Hyperpax:src/core/perps/config.ts:168-185, all at max leverage 1000, the same ids as contracts/pricefeed.md#markets-and-chainflow-symbols; class E (native and new listings: PAX, SID, ASTER, TRUMP) takes its OI cap from the listing-age table of contracts/perps-markets.md section 3.1."
tiers = "Tier classes and the deduction recurrence of contracts/perps-markets.md sections 3 and 4; maintenance margin = notional x MMR(tier) - deduction(tier) replaces the single-rate check of lx_perps_maintenance_check (src/modules/perps/lx_perps_liquidate.c:23)."
mark = "The venue mark is median(Index + EMA150s(mid - Index), median(bid, ask, last), pricefeed Mark) with the pricefeed Mark of contracts/pricefeed.md#mark-price; the mid is the book mid as book_mid_price computes it (src/modules/perps/lx_perps_dispatch.c:1511)."

[task.3.0.1]
title = "Declare the perpetuals interface in Perps.sol and embed its ABI in the leaf package precompiles/perps/abi"
status = "done"
mode = "BUILD"
wave = 0
requires = []
reqs = ["3001.1", "3001.2", "3001.3", "3001.4"]
capabilities = ["3.1.1"]
do_1 = "Write precompiles/perps/Perps.sol with interface IPerps at address 0x0000000000000000000000000000000000001015 declaring the 67 methods (63 names; getBalance, getLockedBalance, getAccountSummary and getMarginMode each also take an explicit `address account` overload, decision D9), the 30 events, the 44 parameterless custom errors and the 11 structures OrderParams, AccountSummary, AccountState, PositionMargin, MarginTier, OrderDetails, PositionDetails, MarketConfig, MarketQuote, OpenPositionQuote and ClosePositionQuote of contracts/perps.md sections 2 to 19 in that order, in the style of precompiles/layerxexchange/LayerXExchange.sol."
do_2 = "Keep the application signatures exactly: positions (Hyperpax:src/hooks/perps/usePosition.ts:29-121), orders (Hyperpax:src/hooks/perps/usePerpsOrders.ts:10-91), vault calls (Hyperpax:src/hooks/perps/useVault.ts:12-58), margin views (Hyperpax:src/hooks/perps/useMarginMode.ts:41-283), quotes and their tuples (Hyperpax:src/hooks/perps/useQuoter.ts:7-42, :119-146) and portfolio balances (Hyperpax:src/hooks/perps/usePortfolioStats.ts:154-155); declare no borrowing method, event or field."
do_3 = "Generate precompiles/perps/abi/abi.json from Perps.sol with solc --abi and create precompiles/perps/abi/abi.go, a leaf package that embeds abi.json with //go:embed as precompiles/launchpad/launchpad.go:94-95 does and exposes func ABI() returning the parsed ABI, parsed with abi.JSON as MustGetABI does (precompiles/common/precompiles.go:449-456), so the package imports only embed, bytes and go-ethereum accounts/abi and builds with CGO_ENABLED=0 for the data services."
do_4 = "Add precompiles/perps/abi/abi_test.go with TestABIEmbedLoads asserting ABI() parses and holds 67 methods, 30 events and 44 errors."
do_5 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
