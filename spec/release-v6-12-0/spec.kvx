do_2 = "Deploy the pool token as a SidioraERC20 contract by a nested CREATE2 with caller 0x3993…8830, salt keccak256(abi.encodePacked(creator, name, symbol, nonce)) and init code SidioraERC20(name, symbol, virtualToken, factory) (Launch-x:contracts/contracts/core/SidioraFactory.sol:120-125) (symbol deployPoolToken)."
do_3 = "Derive the pool address as predictPoolAddress does (Launch-x:contracts/contracts/core/SidioraFactory.sol:166-173) and install the surface there (symbol poolAddress)."
do_4 = "Mint the fee right at nextTokenId of the generation 2 collection, authorize the pool at the generation 2 FeeAccumulator, write the PoolRegistry metadata of Launch-x:contracts/contracts/interfaces/IPoolRegistry.sol:15 and run bindPool and transfer(pool, virtualToken) on the token with caller 0x3993…8830 in the order of Launch-x:contracts/contracts/core/SidioraFactory.sol:147-163 (symbol mintFeeRight)."

