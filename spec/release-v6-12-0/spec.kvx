[task.4.1.4]
title = "Add the spot keeper and the ERC20 and native custody of the module"
status = "done"
mode = "BUILD"
wave = 1
requires = ["4.1.1", "4.1.2", "5.1.9"]
reqs = ["4002.1", "4002.2", "4002.3", "4002.4", "4002.5", "4002.6", "4002.7", "4002.8", "4002.9", "4002.10", "3.2"]
capabilities = ["4.2.4"]
do_1 = "Add Keeper in modules/spot/keeper/keeper.go with storeKey, bank, EVM, pricefeed keepers and the authority, in the shape of modules/launchpad/keeper/keeper.go:19-48, with GetParams and UpdateParams checking the authority as modules/launchpad/keeper/keeper.go:76-86."
do_2 = "CustodyAddress returns the spot module account (authtypes.NewModuleAddress(\"spot\"), modules/launchpad/keeper/keeper.go:40 derivation) and CustodyEVMAddress its EVM address (GetEVMAddressOrDefault, modules/evm/keeper/address.go:41); tokenOf(ctx, token) returns the registered TokenParams with its kind, resolving a NATIVE token argument to its denom through GetNativePointee (modules/evm/keeper/pointer.go:444), and an argument with no registered kind or a CW20 pointer returns UnsupportedTransfer()."
do_3 = "pullTokens(ctx, rail, token, from, amount): for an ERC20 token a nested evm.Call with the rail address as msg.sender to transferFrom(from, CustodyEVMAddress, amount), the pattern of precompiles/xweb/xweb.go:482, crediting the balanceOf delta of the custody address (Launch-x:contracts/contracts/meta-ag/vault/PECORVault.sol:446-459), a zero receipt returning ZeroAmount(); for a NATIVE token bank SendCoins (precompiles/utils/expected_keepers.go:100) from the caller to the module account; an ERC20 call that reverts or returns false, or a failed send, returns SafeERC20FailedOperation(token)."
do_4 = "pushTokens(ctx, token, to, amount): for an ERC20 token transfer(to, amount) from CustodyEVMAddress by a nested evm.Call inside a transaction and by CallEVM (modules/evm/keeper/evm.go:81) outside one; for a NATIVE token bank SendCoins from the module address, not SendCoinsFromModuleToAccount; both balance deltas must equal amount, and a payout to the custody address returns UnsupportedTransfer() (Launch-x:contracts/contracts/meta-ag/vault/PECORVault.sol:554-565)."
do_5 = "CustodyBalance(ctx, token) reads balanceOf of CustodyEVMAddress through StaticCallEVM (modules/evm/keeper/evm.go:157) outside a transaction and by a nested static call inside one, and the module bank balance for a NATIVE token; pullNative converts an attached value to uhpx at value / 1e12 and refuses a remainder with UnsupportedInputTransfer() (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:429)."
do_6 = "A re-entry flag in the transient store refuses a nested spot call with ReentrancyGuardReentrantCall(), the guard of Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:54."
do_7 = "modules/spot/keeper/custody_test.go covers the module custody, TestERC20PullNeedsAllowanceToRail, the exact payout, the atomic failure, TestPayoutOutsideTransactionUsesCallEVM, the native value and TestModuleAccountReceivesNative against the bank and EVM keepers of the test application."
do_8 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["Keeper", "NewKeeper", "CustodyAddress", "CustodyEVMAddress", "tokenOf", "pullTokens", "pushTokens", "CustodyBalance", "pullNative", "TestCustodyAddressIsModuleAccount", "TestPayoutIsExact", "TestFailedTransferRevertsAtomically", "TestNativeValueIsUhpx"]
