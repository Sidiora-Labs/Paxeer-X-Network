title = "Decoder registry and the perpetuals event decoders"
status = "done"
mode = "BUILD"
wave = 1
requires = ["7.0.9"]
reqs = ["7004.1", "7004.2", "7004.3", "7004.4", "7004.5", "7004.6", "7004.7", "7004.8", "7004.9", "7004.10", "7004.11", "7004.12", "7004.13", "7004.14", "7004.15", "7004.16", "7004.17", "7004.18", "7004.19", "7004.20", "7004.21", "7004.22", "7004.23", "7004.24", "7004.25", "7004.26", "7004.27", "7004.28", "7004.29", "7004.30", "7004.31", "7004.32", "7004.33", "7004.34", "7004.35", "7004.36"]
