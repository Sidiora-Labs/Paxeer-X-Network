[capability.2.3.3]
title = "Events and custom errors"
reqs = ["2014.1", "2014.2", "2014.3", "2014.4", "2014.5", "2014.6", "2014.7", "2014.8", "2014.9", "2014.10", "2014.11", "2014.12", "2014.13", "2014.14", "2014.15", "2014.16", "2014.17", "2014.18", "2014.19", "2014.20", "2014.21", "2014.22", "2014.23", "2014.24", "2014.25", "2014.26", "2014.27", "2014.28", "2014.29", "2014.30", "2014.31", "2014.32", "2014.33", "2014.34", "2014.35", "2014.36", "2014.37", "2014.38", "2014.39", "2015.1", "2015.2", "2015.3", "2015.4", "2015.5", "2015.6", "2015.7", "2015.8", "2015.9", "2015.10", "2015.11", "2015.12", "2015.13", "2015.14", "2015.15", "2015.16", "2015.17", "2015.18", "2015.19", "2015.20", "2015.21", "2015.22", "2015.23", "2015.24", "2015.25", "2015.26", "2015.27", "2015.28", "2015.29", "2015.30", "2015.31", "2015.32", "2015.33", "2015.34", "2015.35", "2015.36", "2015.37", "2015.38", "2015.39", "2015.40", "2015.41", "2015.42", "2015.43", "2015.44", "2015.45", "2015.46", "2015.47", "2015.48", "2015.49", "2015.50", "2015.51", "2015.52", "2015.53", "2015.54", "2015.55", "2015.56", "2015.57", "2015.58", "2015.59", "2015.60", "2016.1", "2016.2", "2016.3", "2016.4", "2016.5", "2016.6", "2016.7", "2016.8", "2016.9", "2016.10", "2016.11", "2016.12"]
touches = ["precompiles/launchpad/events.go", "precompiles/launchpad/errors.go", "modules/launchpad/types/errors.go"]
tests = ["precompiles/launchpad/events_test.go", "precompiles/launchpad/errors_test.go"]
verification_contract = "go test ./precompiles/launchpad/... -run TestLogsMatchContractEvents"
do_1 = "Emit every contract-native log at its contract address through EmitEVMLog (precompiles/common/evm_events.go:16), replacing the 0x1017-only log helper (precompiles/launchpad/launchpad.go:422) (symbol emitAt)."
do_2 = "Emit the twelve EventEmitter launchpad events at 0x1017 with the block timestamp and number appended as Launch-x:contracts/contracts/data/EventEmitter.sol:365 does (symbol emitFamily)."
do_3 = "Map each keeper error to its contract custom error with ABI-encoded arguments, keeping the LXP_LAUNCHPAD_ codes of modules/launchpad/types/errors.go:7 as the wrapped error (symbol revertData)."
do_4 = "Return revert data through the revert path of NewPrecompileWithKeeper (precompiles/launchpad/launchpad.go:189) as raw custom-error bytes, not as a string reason (symbol customRevert)."

[capability.2.3.4]
title = "Optical hooks"
reqs = ["2017.1", "2017.2", "2017.3", "2017.4", "2017.5", "2017.6"]
touches = ["precompiles/launchpad/hooks.go", "precompiles/launchpad/optical_test.go"]
tests = ["precompiles/launchpad/optical_test.go"]
verification_contract = "go test ./precompiles/launchpad/... -run TestOpticalHooksSeeTheContractCallers"
do_1 = "Call getFlags then beforeSwap and afterSwap with evm.Call from the pool address as Launch-x:contracts/contracts/core/SidioraPool.sol:188 and Launch-x:contracts/contracts/core/SidioraPool.sol:262 do, following the nested call of precompiles/xweb/xweb.go:482 (symbol callOptical)."
do_2 = "Call beforeFeeDistribution and afterFeeDistribution from the FeeAccumulator address of the market generation (Launch-x:contracts/contracts/data/FeeAccumulator.sol:161) (symbol callFeeOptical)."
do_3 = "Call beforeTokenTransfer from the token address on every transfer of a BEFORE_TOKEN_TRANSFER token as Launch-x:contracts/contracts/core/SidioraERC20.sol:30 does, then mark and send (symbol callTransferOptical)."
do_4 = "Test flags with BitFlag semantics (Launch-x:contracts/contracts/libraries/BitFlag.sol:16) against LaunchpadOptical (Launch-x:contracts/contracts/opticals/presets/LaunchpadOptical.sol:151) (symbol hasFlag)."

[capability.2.3.5]
title = "Gas and versions"
reqs = ["2026.1", "2026.2", "2026.3", "2027.1", "2027.2", "2027.3"]
touches = ["precompiles/launchpad/gas.go", "precompiles/launchpad/setup.go", "precompiles/launchpad/legacy/v610/launchpad.go"]
tests = ["precompiles/launchpad/gas_test.go", "precompiles/launchpad/setup_test.go"]
verification_contract = "go test ./precompiles/launchpad/... -run TestVersionedLaunchpad"
do_1 = "Move the Writes table (precompiles/launchpad/launchpad.go:196) into gas.go and list every state-changing method of the ten roles (symbol Writes)."
do_2 = "Keep Gas and RequiredGas (precompiles/launchpad/launchpad.go:224, precompiles/launchpad/launchpad.go:228) with the four constants (symbol RequiredGas)."
do_3 = "Copy the current package into legacy/v610 and register it in GetVersioned (precompiles/launchpad/setup.go:10) as precompiles/p256/setup.go:22 (symbol GetVersioned)."
do_4 = "Add v6.12.0 to precompiles/launchpad/versions after precompiles/launchpad/versions:1 (symbol versions)."

[capability.2.4.1]
title = "USDL migration step"
reqs = ["2023.1", "2023.2", "2023.3", "2023.4", "2023.5", "2018.1", "2018.2"]
touches = ["modules/launchpad/keeper/migrate_v6120_usdl.go", "modules/launchpad/keeper/migrate_v6120_usdl_test.go"]
tests = ["modules/launchpad/keeper/migrate_v6120_usdl_test.go"]
verification_contract = "go test ./modules/launchpad/keeper/... -run TestUsdlGoldenVector"
do_1 = "Read every holder balance with GetState (modules/evm/keeper/state.go:10) at the mapping slot of usdl.json and require the sum to equal the total-supply slot (symbol migrateUSDL)."
do_2 = "Mint uusdl to the module account and send it to each holder account from GetPaxAddressOrDefault (modules/evm/keeper/address.go:58) (symbol mintToHolders)."
do_3 = "Clear the old storage with IterateState (modules/evm/keeper/state.go:39) and SetState (modules/evm/keeper/state.go:30) (symbol clearContractState)."
do_4 = "Record the pointer with SetERC20NativePointer (modules/evm/keeper/pointer.go:29) and write its runtime through UpsertERCNativePointer (modules/evm/keeper/pointer_upgrade.go:101-108) (symbol installUSDLPointer)."

[capability.2.4.2]
title = "Pool and pool-token migration"
reqs = ["2024.1", "2024.2", "2024.3", "2024.4", "2024.5"]
touches = ["modules/launchpad/keeper/migrate_v6120.go", "modules/launchpad/keeper/migrate_v6120_read.go"]
tests = ["modules/launchpad/keeper/migrate_v6120_test.go"]
verification_contract = "go test ./modules/launchpad/keeper/... -run TestEveryPoolMigrates"
do_1 = "Enumerate pools from _allPools of each PoolRegistry (Launch-x:contracts/contracts/data/PoolRegistry.sol:23) and check each code hash with GetCodeHash (modules/evm/keeper/code.go:39) against layout.json (symbol listPools)."
do_2 = "Read every pool slot of layout.json into Market, the fields of Launch-x:contracts/contracts/core/SidioraPool.sol:53-79 (symbol readPool)."
do_3 = "Move token balances from slot 3 and supply from slot 2 of Launch-x:contracts/contracts/base/ERC20Base.sol:13 into the denom and install the token pointer or surface (symbol migrateToken)."
do_4 = "Install the pool surface with SetCode (modules/evm/keeper/code.go:23) and register it (symbol installPoolSurface)."

[capability.2.4.3]
title = "Fee rights, roles and accounting migration"
reqs = ["2025.1", "2025.2", "2025.3", "2025.4", "2025.5", "2022.3"]
touches = ["modules/launchpad/keeper/migrate_v6120.go", "modules/launchpad/keeper/migrate_v6120_read.go"]
tests = ["modules/launchpad/keeper/migrate_v6120_test.go"]
verification_contract = "go test ./modules/launchpad/keeper/... -run TestFeeRightsMatchGolden"
do_1 = "Read fee rights from the collection slots 2, 4, 5, 11, 12 and 13 of Launch-x:contracts/contracts/core/SidioraNFT.sol:30 and Launch-x:contracts/contracts/base/ERC721Base.sol:11 (symbol readFeeRights)."
do_2 = "Read role memberships of the fixture accounts from _roles of Launch-x:contracts/contracts/base/AccessControl.sol:11 and skip DEFAULT_ADMIN_ROLE (symbol readRoles)."
do_3 = "Read FeeAccumulator accounting slots 6 to 24 declared from Launch-x:contracts/contracts/data/FeeAccumulator.sol:46 and the airdrop snapshot entitlements from the token checkpoints (symbol readAccounting)."
do_4 = "Wrap the run in a cached context and return errors to the handler, which wraps them as \"upgrade v6.12.0: launchpad: <error>\" (symbol MigrateV6120)."

