verification_contract = "go test ./modules/spot/keeper/ -run '^(TestNAV|TestShareMint|TestShareBurn|TestTradeUpdatesReserves|TestDepositRefusedAtZeroNAV|TestDonationDoesNotInflateShares|TestTokenParamsEmitLogs)$'"
do_1 = "Spendable(token) is max(0, min(custody - escrow, book) - reserved) with custody read by CustodyBalance (Launch-x:contracts/contracts/meta-ag/vault/PECORVault.sol:541-550), NAV is Spendable, and HasLiquidity(token, amount) requires a registered unpaused token, amount at most spendable and amount x 10000 at most spendable x maxUtilizationBps (9000 for the opening tokens, DEFAULT_MAX_UTILIZATION_BPS 10000 otherwise), the cap defined by contracts/spot.md#vault-share-accounting."
do_2 = "Deposit credits the measured receipt (Launch-x:contracts/contracts/meta-ag/vault/PECORVault.sol:446-459): a first deposit of at most MINIMUM_SHARES 1000 returns ZeroAmount() and a larger one mints amount - 1000 to the depositor and 1000 to the module account; a later deposit with supply above zero and NAV 0 returns InsufficientLiquidity() and otherwise mints amount x supply / NAV rounded down; DepositBatch refuses unequal lengths with InvalidArrayLength (Launch-x:contracts/contracts/meta-ag/vault/PECORVault.sol:246-266)."
do_3 = "Withdraw burns shares and pays shares x NAV / supply rounded down, WithdrawNative burns amount x supply / NAV rounded up, and a payout above spendable returns InsufficientLiquidity(); SyncReserves runs only from MsgSyncReserves, as the source restricts it to DEFAULT_ADMIN_ROLE (Launch-x:contracts/contracts/meta-ag/vault/PECORVault.sol:211-228), reconciling custody - escrow with the book as Launch-x:contracts/contracts/meta-ag/vault/PECORVault.sol:464-482 and reporting ReservesSync."
do_4 = "RegisterToken records the kind, reads ERC20 decimals through decimals() and refuses more than 36 with UnsupportedToken as Launch-x:contracts/contracts/meta-ag/vault/PECORVault.sol:499-509, and reads NATIVE decimals from the denom metadata; each book change reports ReservesUpdated."
do_5 = "The vault tests cover TestNAV, the share mint and burn, TestTradeUpdatesReserves, TestDepositRefusedAtZeroNAV, TestDonationDoesNotInflateShares and the token parameter logs."

[capability.4.2.11]
title = "Create share denoms with ERC20 pointers and mint and burn shares"
reqs = ["4020.1", "4020.2", "4020.3", "4020.4", "4020.5", "4020.6", "4020.7", "4020.8", "4020.9", "4020.10", "4020.11", "4020.12", "4020.13", "4020.14", "4020.15", "4020.16", "4020.17", "4020.18", "4020.19", "4020.20", "4020.21", "4020.22", "4020.23", "4020.24", "4020.25", "4020.26", "3.2"]
