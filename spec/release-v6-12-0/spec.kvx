do_2 = "Before the go build of tools/release/build-paxd.sh:43-44 run make --no-print-directory paxd-native-libs, the target task 1.0.1 makes depend on build/liblayerx.a (Makefile:46, Makefile:211) and programs-release-build, which builds programs/target/release/liblayerx_programs_sandbox.a (Makefile:3406, Makefile:3422-3425), with the C prefix map of tools/release/build-paxd.sh:64-65 and RUSTFLAGS --remap-path-prefix."
do_3 = "Write native-libs.sha256 with sha256sum of build/liblayerx.a and programs/target/release/liblayerx_programs_sandbox.a, the libraries modules/lxphost/host.go:7 links after task 1.0.1, before the touch and SHA256SUMS step of tools/release/build-paxd.sh:69-70."
do_4 = "Build price-sidecar with cargo build --locked --release --manifest-path platform/Cargo.toml -p layerx-oracle-feeder --bin price-sidecar and copy it to price-sidecar-v6.12.0-linux-amd64 before SHA256SUMS."
do_5 = "After SHA256SUMS call python3 tools/release/upgrade_info.py release --sums $out/SHA256SUMS --tag $tag --out $out/upgrade-info.json, regenerate SHA256SUMS with the find and sort line of tools/release/build-paxd.sh:70, then touch every file with SOURCE_DATE_EPOCH again."
do_6 = "Add --print-tag to build-paxd.sh that prints the tag of tools/release/build-paxd.sh:20 and exits 0, used by tools/release/tests/identity.test.sh."
do_7 = "Add tools/release/tests/build.test.sh with kernel_library_built_first, sandbox_library_built_first, rust_pin_enforced, cc_pin_enforced, native_library_sums_recorded, sidecar_artifact_listed, release_directory_contents, epoch_after_last_write and binary_reports_v6120; the last starts the built paxd on a local paxd init home and reads abci_info (consensus/internal/rpc/core/routes.go:71) for version v6.12.0 (sdk/baseapp/abci.go:98)."

