[req.7016]
title = "GraphQL subscriptions run over graphql-transport-ws on /graphql-ws"
ac_1 = "Subscription.indexerStatusUpdated (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:80) returns IndexerStatus, fed from changes of perps.cursors."
ac_2 = "Subscription.latestPricesUpdated (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:108) returns [LatestPrice!]!, fed from inserts into perps.mark_prices with price the index_price (contracts/data-services.md section 15)."
ac_3 = "Subscription.priceUpdated (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:135) returns PriceUpdate with argument marketId: Int, nullable, fed from inserts into perps.index_prices of kind aggregate (contracts/data-services.md section 15)."
ac_4 = "Subscription.positionChanged (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:164) returns [Position!]! with argument userAddress: String!, fed from changes of perps.positions_current."
ac_5 = "Subscription.orderChanged (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:197) returns Order with argument userAddress: String!, fed from changes of perps.orders."
ac_6 = "Subscription.tradeCreated (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:228) returns Trade with argument marketId: Int!, fed from changes of perps.trade_settlements."
ac_7 = "Subscription.liquidationCreated (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:259) returns Liquidation with argument marketId: Int!, fed from changes of perps.liquidations."
ac_8 = "connection_init must arrive within 10 seconds or the socket closes with 4408; the client sends it on open (Hyperpax:src/core/graphql/client.ts:347)."
ac_9 = "One socket multiplexes many subscriptions by id (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:5-7)."
ac_10 = "At most 100 subscriptions per socket (contracts/data-services.md section 15)."

[req.7017]
title = "The explorer serves blocks, venue transactions and histories linked to the network explorer"
ac_1 = "Blocks limit is clamped to [1, 50] with default 20 (Hyperpax:data_api.md:562)."
ac_2 = "Transactions limit is clamped to [1, 200] with default 50 (Hyperpax:data_api.md:580)."
ac_3 = "action takes one of the six documented values (Hyperpax:data_api.md:600-601) by the action mapping of contracts/data-services.md section 16: Place Order, Cancel Order, Modify Order, OROB Fill one per Fill and spot execution or swap, Oracle Updated one per block with pricefeed_aggregate events, Sealed Batch Executed one per end-block receipt."
ac_4 = "Account history pages with a keyset cursor (block, tx_index, log_index) (contracts/data-services.md section 16)."
ac_5 = "Market history pages with the same cursor (contracts/data-services.md section 16)."
ac_6 = "Rows link to the network explorer through PERPS_EXPLORER_TX_BASE with /tx/ and /address/; with it empty the link is omitted (contracts/data-services.md section 16)."
ac_7 = "Route /api/chain/blocks answers the documented JSON (contracts/data-services.md section 16)."
ac_8 = "Route /api/chain/transactions answers the documented JSON (contracts/data-services.md section 16)."
ac_9 = "Route /api/chain/health answers status, ts, chain_connected, blocks_seen and txs_seen (Hyperpax:data_api.md:606)."
ac_10 = "Route /api/chain/accounts/<key>/history answers the documented JSON (contracts/data-services.md section 16)."
ac_11 = "Route /api/chain/markets/<key>/history answers the documented JSON (contracts/data-services.md section 16)."
ac_12 = "Route /api/chain/tx answers the documented JSON (contracts/data-services.md section 16)."
ac_13 = "An unknown transaction hash answers 404 (contracts/data-services.md section 16)."
ac_14 = "Excess requests per client key answer 429 (Launch-x:core/api/internal/ratelimit/ratelimit.go:49)."
ac_15 = "Topic chain@blocks delivers one frame per item with a snapshot of the last 20 (Hyperpax:data_api.md:611)."
ac_16 = "Topic chain@transactions delivers one frame per item with a snapshot of the last 50 (Hyperpax:data_api.md:647)."
ac_17 = "Explorer rows carry user as the bech32 form with prefix pax (node/const.go:5) of the row account, blocks carry proposer as the upper-case hex of the CometBFT header, and a synthetic receipt hash renders from the stored rows without calling eth_getTransactionByHash (contracts/data-services.md section 16)."
ac_18 = "GET /api/explorer/health answers {latest_block, chain_connected}, the shape the application network indicator reads (Hyperpax:src/widgets/network-pill/NetworkPill.tsx:38) (contracts/data-services.md section 16)."
ac_19 = "A socket opened on /ws/explorer receives chain@blocks with a snapshot of 20 and chain@transactions with a snapshot of 50 without subscribing (Hyperpax:src/hooks/chain/useExplorerStream.ts:29) (contracts/data-services.md section 16)."

[req.7018]
title = "The portal renders markets, accounts, leaderboard and statistics on the server"
ac_1 = "Page / with the markets table and totals renders from the gateway REST and GraphQL (contracts/data-services.md section 17)."
ac_2 = "Page /markets/<symbol> with the market record, the last 100 perpetual fills, funding history and the hourly market snapshots of 7 days renders from the gateway REST and GraphQL (contracts/data-services.md section 17)."
ac_3 = "Page /accounts/<address> with positions, orders, fills, funding, liquidations and collateral events renders from GetPositions, GetAllOrdersV2, GetTradeSettlements, GetFundingPayments, GetLiquidations and GetVaultEvents of the gateway (contracts/data-services.md section 17)."
ac_4 = "Page /leaderboard for all, 30d and 7d renders from the gateway REST and GraphQL (contracts/data-services.md section 17)."
ac_5 = "Page /stats with global statistics, snapshots and indexer status renders from the gateway REST and GraphQL (contracts/data-services.md section 17)."
ac_6 = "Readiness follows the gateway readiness (Launch-x:shared/http/health.go:46)."
ac_7 = "An unknown symbol or malformed address answers 404 inside the page layout (contracts/data-services.md section 17)."
ac_8 = "Every response sets Content-Security-Policy default-src self (contracts/data-services.md section 17)."
ac_9 = "All five pages are mounted on the portal server (contracts/data-services.md section 17)."

[req.7019]
title = "Realised profit and loss, account history and the leaderboard are exact"
ac_1 = "Realised profit and loss is computed on close from entry and exit price and size in exact integers (contracts/data-services.md section 18)."
ac_2 = "TradeSettled components (fees, funding, trading) are kept apart in user_pnl_daily, with volume the sum of size_usd and trades the count of the day (contracts/data-services.md section 18)."
ac_3 = "Spot realised profit uses average cost (contracts/data-services.md section 18)."
ac_4 = "Leaderboard ranks by realised profit, ties ordered by lower account bytes (contracts/data-services.md section 18)."
ac_5 = "History is ordered by (block, tx_index, log_index) descending (contracts/data-services.md section 18)."
ac_6 = "A PositionClosed with realizedPnl above 0 counts as a win and below 0 as a loss, and win_rate is wins / (wins + losses) x 100 (contracts/data-services.md section 18)."

[req.7020]
title = "Every service exposes liveness, readiness and Prometheus metrics"
ac_1 = "/healthz/live answers 200 while the process runs (Launch-x:shared/http/health.go:29)."
ac_2 = "/healthz/ready answers 503 naming the failing check (contracts/data-services.md section 19)."
ac_3 = "/metrics serves the text exposition (Launch-x:shared/telemetry/metrics.go:124)."
ac_4 = "The gateway mounts the REST routes (contracts/data-services.md section 19)."
ac_5 = "The gateway mounts /graphql and /api/subgraph (contracts/data-services.md section 19)."
ac_6 = "The gateway mounts the data socket on /ws and /, and the socket paths /ws/<symbol>, /ws/markets and /ws/explorer the application opens (contracts/data-services.md section 8)."
ac_7 = "The gateway mounts /graphql-ws (contracts/data-services.md section 19)."
ac_8 = "Gateway readiness needs Postgres, the consumer and at most 10 seconds lag (contracts/data-services.md section 19)."
ac_9 = "While not ready the gateway closes new sockets with 1013 and retry-after (contracts/data-services.md section 19)."

[req.7021]
title = "Images, the Railway layout and the NATS cluster are declared without host data"
ac_1 = "deploy/Dockerfile builds every binary from one file with SERVICE, the shape of Launch-x:deploy/Dockerfile.svc:18 (contracts/data-services.md section 20)."
ac_2 = "services.json declares the services perps-data-indexer (SERVICE=perps-indexer), perps-gateway, perps-explorer, perps-portal and perps-replay built from deploy/Dockerfile, postgres, and nats built from deploy/nats/Dockerfile as the three members nats-1, nats-2 and nats-3, with healthchecks (contracts/data-services.md section 21)."
ac_3 = "No value in services.json contains a scheme, a dotted host or a port (contracts/data-services.md section 21)."
ac_4 = "Every variable read by config.Load is declared (contracts/data-services.md section 21)."
ac_5 = "Only the gateway, explorer and portal have public domains (contracts/data-services.md section 21)."
ac_6 = "nats.conf enables JetStream on the volume (Launch-x:deploy/production/bootstrap/nats.conf:10-11) with a cluster block and max_payload equal to Launch-x:shared/delivery/envelope.go:17."
ac_7 = "The indexer may publish on perps.> and the gateway may only subscribe; no literal password or host appears (contracts/data-services.md section 21)."

[req.7022]
title = "The gateway holds the load profile of the eighteen markets"
ac_1 = "The profile holds 140000 sockets on book, trade and markets topics of Hyperpax:src/core/feeds.ts:4, scaled to 2000 in the test."
ac_2 = "A reconnect storm of 20 percent at no more than 6000 per second recovers within 60 seconds (contracts/data-services.md section 22)."
ac_3 = "Every frame passes the sequence rule of the application (Hyperpax:src/core/net/realtime.ts:29-47) and p99 frame delay is at most 250 ms."
ac_4 = "Book checksums match the CRC32 of the client-side book (contracts/data-services.md section 22)."

