do_1 = "MarketBuy and MarketSell validate the pair as Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:625-626, check the deadline (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:132-135), price, check the gross output against the spendable book and the utilization cap of the output token through HasLiquidity (the gross rule of Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:719-720 before Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:281-282 and Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:355-356, checked directly at Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:450) and settle (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:325-404)."
do_2 = "SwapExactIn and SwapExactOut follow Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:256-322, refusing SameToken (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:263) and ExcessiveInput (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:305)."
do_3 = "SwapNative takes or pays uhpx as the PAX token and refuses UseWethDeposit (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:423) and UseWethWithdraw (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:474)."
do_4 = "Each settlement runs in a cached context (modules/launchpad/keeper/swap.go:129 shape) and writes pull, payout, book and accrual together: the input adds to the book of the input token and the net output leaves the book of the output token, the retained part staying as a reservation."
do_5 = "TestSwapLiquidityCheckedOnGross covers a trade whose net fits the book but whose gross does not."

[capability.4.2.8]
title = "Store limit orders with placement bounds, escrow, cancel, modify, expire and fill"
reqs = ["4009.1", "4009.2", "4009.3", "4009.4", "4009.5", "4009.6", "4009.7", "4009.8", "4009.9", "4009.10", "4009.11", "4009.12", "4009.13", "4009.14", "4009.15", "4009.16", "4010.1", "4010.2", "4010.3", "4010.4", "4010.5", "4010.6", "4010.7", "4010.8", "4010.9", "4010.10", "4010.11", "4009.17", "4009.18", "4009.19", "4009.22", "3.2"]
touches = ["modules/spot/keeper/orders.go", "modules/spot/keeper/orders_test.go"]
tests = ["modules/spot/keeper/orders_test.go"]
verification_contract = "go test ./modules/spot/keeper/ -run '^(TestPlaceLimitEscrows|TestLimitStatusTransitions|TestEscrowIsReserved|TestActiveListSwapAndPop|TestMinOrderNotional|TestMaxActiveOrdersPerUser|TestOrderMinOutput|TestLimitExpire)$'"
do_1 = "PlaceLimit validates every argument before any token move (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:226-229 before the pull at Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:231), refusing an escrow value below minOrderNotional with OrderBelowMinimumNotional() and a user at maxActiveOrdersPerUser with TooManyActiveOrders(); it pulls the escrow with rail 0x1022, takes the id from the shared counter (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:95), records orderMinOutput 0, appends to the user and active lists (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:99-102), adds the expiry index entry and raises the active count of the user."
do_2 = "CancelLimit refunds a PENDING order to its user (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:548-582), with NotOrderOwner (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:565) and CannotCancel for a final order, the ABI name of the source OrderNotPending() (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:566)."
do_3 = "ModifyLimit sets targetPrice and expiresAt of a PENDING order and leaves the escrow unchanged (Hyperpax:src/hooks/spot/useSpotOrders.ts:351-359)."
do_4 = "ExecuteLimit fills at the index price by Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:410-429 with PriceAboveTarget and PriceBelowTarget for Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:417-418, checks the gross output with HasLiquidity (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:450) and the net output against orderMinOutput with InsufficientOutput() (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:449), then removes the id by swap and pop (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:643-655); no STOP_LOSS order is ever in the limit lists."
do_5 = "ExpireLimit and BatchExpire expire PENDING orders whose non-zero expiresAt is at or before the block time (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:538-545), refund the escrow, remove the active, expiry and back-off entries, lower the active count of the user and report LimitOrderExpired."
do_6 = "The orders tests cover placement (TestPlaceLimitEscrows, TestMinOrderNotional, TestMaxActiveOrdersPerUser), TestOrderMinOutput, TestLimitExpire and the status, escrow and active-list rules."

[capability.4.2.9]
title = "Store stop-limit and stop-loss orders with activation and fills"
