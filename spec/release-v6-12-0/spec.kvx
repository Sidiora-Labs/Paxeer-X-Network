do_1 = "EffectiveFeeBps(base, volume) adds tier1FeeBps from 10,000e18 and tier2FeeBps from 100,000e18 (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:743-747)."
do_2 = "ApplyImpact caps the impact at MAX_IMPACT_BPS 500 (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:68, Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:711), with reserveUSD the spendable book of the output token at its index price, and returns the deduction emitted by PriceImpactApplied (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:716)."
do_3 = "Price(rail, in, out, amount) returns gross, net, feeBps, feeAmount, impactBps and deduction, with swapFeeBps, tier1FeeBps, tier2FeeBps, priceImpactEnabled and priceImpactScalarBps for 0x1021 and the order pricing set for the order rails (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:114-118)."
do_4 = "QuoteExactOut searches the tier bands as Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:648-686; AccrueFees reserves the retained fee plus deduction in the rail accrual of the output token (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:719-720, Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:452-456), an accrual that belongs to feeCollector."
do_5 = "TieredFeeApplied (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:706) and PriceImpactApplied (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:716) are reported only on the exact-input paths of 0x1021; swapExactOut and order fills report neither."

[capability.4.2.7]
