[contract_context.1.build]
interface = "paxd builds with make paxd-build, which orders paxd-native-libs before the chain build (chain.mk:185-186); the shim links through modules/lxphost/host.go:6-7."
storage = "Native outputs are build/liblayerx.a (Makefile:46), build/generated (Makefile:28) and the release sandbox library (Makefile:3406)."
errors = "A missing native library fails the Go link of modules/lxphost; the target order makes that impossible on a clean checkout."
gate = "The node build workflow ends in node-build-gate; runs-on routes as .github/workflows/ci.yml:22."
invariants = "GOPROXY=off holds for the Go step (Makefile:3141-3142); required change in the release domain: tools/release/build-paxd.sh runs make paxd-native-libs before its go build (tools/release/build-paxd.sh:44)."

[contract_context.1.plan]
interface = "Plan name \"v6.12.0\" (V6120Upgrade); knownUpgradePlans returns Activation, v6.10, v6.12.0, Merge (node/upgrades.go:532-534)."
storage = "The plan adds the perps, spot and pricefeed stores and deletes none (node/app.go:1407-1421); the three names are in kvStoreKeyNames and MemIAVLStoreKeys (storage/common/keys/store_keys.go:47)."
errors = "\"upgrade v6.12.0: hook <name> is not bound\" and \"upgrade v6.12.0: <hook>: <error>\"; an unmounted store panics as at node/upgrades.go:597-600."
hooks = "Order: pointers (uhpx and SID native pointers), launchpad MigrateV6120, pricefeed InitV6120, perps SeedV6120, spot InitV6120, after RunMigrations and the SID steps (node/upgrades_v611.go:98-110); then setV6120Live(true)."
document = "upgrade-info.json {\"name\":\"v6.12.0\",\"height\":H+1} under <home>/data (sdk/x/upgrade/keeper/keeper.go:434-442, sdk/x/upgrade/keeper/keeper.go:479-486)."
invariants = "The plan applies once, in the block the document names, only while pending (node/upgrades.go:594); the name v6.11 is not in the table and its SID work ships inside v6.12.0 (decision.1); v6.12.0 has no node/tags entry, so LatestUpgrade stays v6.8 (node/upgrades.go:47-55)."

[contract_context.1.activation]
interface = "0x1020 pricefeed and 0x1021-0x1027 spot are gated by v6120PrecompileGate; 0x1015 stays gated by activationPrecompileGate (node/upgrades.go:496)."
switch = "0x1015 serves the legacy exchange version below the v6.12.0 done height and the perps version at and above it, keyed ActivationUpgrade and V6120Upgrade for tracing (modules/evm/keeper/keeper.go:356-385; decision.10)."
giga = "0x1015 and 0x1020-0x1027 are fail-fast in the giga executor from gigaLatePrecompileHeight (node/app.go:2559, engine/executor/precompiles/failfast.go:101)."
invariants = "No address is named by two activation entries (modules/evm/keeper/keeper.go:230-233); a withheld address behaves as an account with no code (modules/evm/keeper/keeper.go:333-350)."

[contract_context.1.versioning]
interface = "paxd version prints version.Version (sdk/version/command.go:22-24)."
source = "The version key of tools/release/version.json (tools/release/version.json:2) feeds both make paxd-build and the release script (tools/release/build-paxd.sh:19)."
check = "make paxd-version-check fails when the binary and the file disagree."
invariants = "The base app version (node/app.go:593) equals the CLI version."

