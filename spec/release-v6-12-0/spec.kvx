[contract_context.5.interface]
address = "The precompile lives at 0x0000000000000000000000000000000000001020, beside xweb at 0x1019 (precompiles/xweb/XWeb.sol:4); its constructor is NewPrecompile(keepers) with the shape of precompiles/xweb/xweb.go:151-157 and GetVersioned of precompiles/xweb/setup.go:10-14."
writes = "registerFeedKey(bytes pubKey) returns (address feedAccount) and revokeFeedKey(); the caller is a bonded validator operator resolved through GetPaxAddressOrDefault (modules/evm/keeper/address.go:58)."
views = "getPrice(uint256), getPriceBySymbol(string), getPrices(uint256[]) with at most 64 ids, getMarket(uint256), getMarketCount(), marketIdOf(string), getObservation(uint256, address), getFeedKey(address), getValidatorByFeedAccount(address) and getParams()."
read_api = "Go modules read GetPrice(ctx, marketId uint64) (Price, error) and GetPriceBySymbol(ctx, symbol) of modules/pricefeed/keeper; Price carries Index, Mark, TimestampMs, Height, Sources and Fresh."
market_ids = "Market ids are the uint256 ids of the perpetuals venue, 0 to 17 in the order of Hyperpax:src/core/perps/config.ts:168-185; the spot venue reads by symbol."
submission = "Prices arrive only through the Cosmos message MsgSubmitPrices of api/pricefeed/tx.proto; the EVM fee check refuses a fee cap below the base fee (modules/evm/ante/fee.go:53-58), so no precompile method submits prices."

[contract_context.5.storage]
params = "0x01 holds the Params JSON, read with the defaults fallback of modules/xweb/keeper/keeper.go:112-118."
feed_keys = "0x02 || operator holds FeedKey {pubKey, feedAccount}; 0x03 || feedAccount holds the operator."
observations = "0x04 || market id (8 bytes big-endian) || operator holds ObservationRecord {sequence, indexPrice, markPrice, sourceTimestampMs, height}."
aggregates = "0x05 || market id holds Aggregate {indexPrice, markPrice, basis, timestampMs, height, sources}."
rate = "0x06 || operator holds the last submission height."
encoding = "Records are JSON with the helpers of modules/xweb/keeper/keeper.go:29-46 and keys use the big-endian helpers of modules/xweb/types/keys.go:41-53."

[contract_context.5.errors]
codespace = "Module errors are registered under codespace pricefeed with codes 2 to 16 (modules/xweb/types/errors.go:10-17 pattern) and named by LXPName (modules/xweb/types/errors.go:36-48)."
module_codes = "LXP_PRICEFEED_UNAUTHORIZED, LXP_PRICEFEED_INVALID_PARAMS, LXP_PRICEFEED_INVALID_GENESIS, LXP_PRICEFEED_NOT_VALIDATOR, LXP_PRICEFEED_INVALID_KEY, LXP_PRICEFEED_KEY_IN_USE, LXP_PRICEFEED_NO_KEY, LXP_PRICEFEED_UNKNOWN_MARKET, LXP_PRICEFEED_UNREGISTERED_FEEDER, LXP_PRICEFEED_RATE_LIMITED, LXP_PRICEFEED_TOO_MANY_OBSERVATIONS, LXP_PRICEFEED_SUBMISSION_TOO_LARGE, LXP_PRICEFEED_DUPLICATE_MARKET, LXP_PRICEFEED_SUBMISSION_ALONE, LXP_PRICEFEED_INVALID_OBSERVATION."
precompile_codes = "LXP_PRICEFEED_DELEGATECALL, LXP_PRICEFEED_STATICCALL, LXP_PRICEFEED_KEEPER_MISSING and LXP_PRICEFEED_BATCH_TOO_LARGE from the guard of precompiles/xweb/xweb.go:297-310; LXP_PRECOMPILE_NON_PAYABLE and LXP_PRECOMPILE_ARG_COUNT as precompiles/xweb/xweb.go:236-238 and precompiles/xweb/xweb.go:253-255."
revert_data = "Reverts carry ABI Error(string) starting with the code, the WithRevertReasons constructor of precompiles/xweb/xweb.go:169."
refusals = "A refused observation is not an error: it emits pricefeed_observation_refused and the message continues."

[contract_context.5.events]
evm_logs = "FeedKeyRegistered(address indexed validator, address indexed feedAccount, bytes pubKey, address previousFeedAccount) and FeedKeyRevoked(address indexed validator, address indexed feedAccount), emitted through pcommon.EmitEVMLog (precompiles/common/evm_events.go:16)."
cosmos_events = "pricefeed_observation, pricefeed_observation_refused, pricefeed_aggregate, pricefeed_aggregate_skipped, pricefeed_feed_key, pricefeed_feed_key_revoked and pricefeed_params on the context event manager."
refusal_reasons = "unknown_market, market_disabled, sequence, future, stale, bounds, deviation, in check order."

[contract_context.5.gas]
views = "3000 + 16 * len(input), the view base of precompiles/xweb/xweb.go:62-64."
writes = "30000 + 16 * len(input) for registerFeedKey and revokeFeedKey, the formula of precompiles/xweb/xweb.go:185-194."
submissions = "MsgSubmitPrices of a registered feed account of a bonded validator, once per height, pays no fee through SubmissionIsGasless, the role of oracleVoteIsGasless (node/antedecorators/gasless.go:106-132); the gas meter still bounds the tx at max_submission_bytes."

[contract_context.5.parameters]
fields = "staleness_window_ms 10000, max_clock_skew_ms 2000, min_sources 1, max_divergence_bps 50, max_deviation_bps 1000, max_observations_per_submission 32, max_submission_bytes 8192, mark_ema_tau_ms 150000, max_mark_basis_bps 500, max_price_age_ms 15000."
markets = "Eighteen markets with min_price 1 and max_price 10^30 at 18 decimals; listing appends the next id and ids and symbols never change."
authority = "The governance module account (modules/xweb/types/genesis.go:21-23 pattern); MsgSetParams from any other signer returns LXP_PRICEFEED_UNAUTHORIZED (modules/xweb/keeper/keeper.go:131-138 rule)."
feeder_bounds = "The staleness window and divergence bound match the feeder fixture (platform/hosted/feeder/tests/fixtures/feeder.json:9-10)."

[contract_context.5.activation]
upgrade = "The v6.12.0 handler calls modules/pricefeed/keeper.InitV6120(ctx, k); task 1.3.100 adds the call beside runXWebUpgrade (node/upgrades.go:212) and the store key with the case of node/app.go:1413."
seeding = "InitV6120 stores DefaultParams when no params exist and registers no feed key; every market reads Fresh false until the bonded majority submits."
wiring = "Task 1.3.100 adds the decorators beside node/ante.go:80-84, the gasless case beside node/antedecorators/gasless.go:86-102, the sequencer paths of node/sequencer/layers.go:288-297 and node/sequencer/layers.go:329-335, the check paths of node/ante/cosmos_checktx.go:85 and node/ante/cosmos_delivertx.go:37, the mid-block order of node/app.go:1043-1045 and the precompile gate of precompiles/setup.go:190-192."
oracle = "modules/oracle and its decorators (modules/oracle/ante.go:11-100) stay registered and unchanged."

[contract_context.5.invariants]
determinism = "The aggregate depends only on the store and block time; delivery order inside a block never changes it."
one_key = "A validator has at most one feed key and a feed account maps to one validator."
once_per_height = "A validator's observations apply at most once per height, checked in the ante decorator and again in the message server."
sequence = "A stored observation's sequence only grows per validator and market (src/modules/perps/lx_oracle_intake.c:150-152 rule)."
freshness = "Fresh implies the aggregate is no older than max_price_age_ms and no later than block time plus max_clock_skew_ms."
mark_bound = "The mark never leaves I * (1 +- max_mark_basis_bps / 10000) and is at least 1."

[contract_context.5.sidecar]
binary = "price-sidecar in crate layerx-oracle-feeder (platform/hosted/feeder/Cargo.toml:1-10), beside the existing feeder main (platform/hosted/feeder/src/main.rs:75)."
source = "The Chainflow feed route /api/markets/ticker/{symbol} with header X-API-Key; the request symbol is upper case and the response symbol PERP_<SYMBOL>_USDC (Hyperpax:src/core/feeds.ts:5-7)."
transaction = "One MsgSubmitPrices per round signed with sign mode direct by the registered secp256k1 feed key, read with abci_query and sent with broadcast_tx_sync (consensus/internal/rpc/core/routes.go:66, consensus/internal/rpc/core/routes.go:70)."
health = "/healthz, /readyz within three cadences (platform/hosted/feeder/src/lib.rs:27-41) and /metrics."
environment = "PRICE_SIDECAR_CONFIG, PRICE_SIDECAR_FEED_KEY_FILE, PRICE_FEED_REST_API_KEY_FILE, PRICE_SIDECAR_STATE_DIR, PRICE_SIDECAR_HEALTH_ADDR, PRICE_SIDECAR_CONSENSUS_RPC_URL, PRICE_SIDECAR_EVM_RPC_URL."

[contract_context.5.install]
unit = "tools/price-sidecar/price-sidecar.service with the user, credential, restart and sandbox directives of interop/deploy/x-websearch/x-websearch.service:1-51."
template = "tools/price-sidecar/config.template.json carries field names and empty host values only; the loader refuses each empty field by name."
check = "tools/price-sidecar/tests/packaging-check.sh runs offline, the pattern of interop/deploy/x-websearch/tests/packaging-check.sh:1-30."

[task.5.0.1]
title = "Write the 0x1020 Solidity interface, ABI and golden test"
status = "pending"
mode = "BUILD"
wave = 0
requires = []
reqs = ["5008.6", "5004.7"]
capabilities = ["5.4.1"]
do_1 = "Write precompiles/pricefeed/PriceFeed.sol with the address constant, the four structs, the two events and the twelve functions of the contract file, the layout of precompiles/xweb/XWeb.sol:4-6 and precompiles/xweb/XWeb.sol:73-91."
do_2 = "Write precompiles/pricefeed/abi.json as the ABI of that interface."
do_3 = "Write TestPriceFeedABIGolden in precompiles/pricefeed/abi_test.go loading abi.json with the go-ethereum ABI reader and pinning every selector and topic."
do_4 = "Assert that no method of the ABI submits prices, since submissions stay Cosmos messages (modules/evm/ante/fee.go:53-58)."
do_5 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["PRICEFEED_PRECOMPILE_ADDRESS", "IPriceFeed", "TestPriceFeedABIGolden"]
touches = ["precompiles/pricefeed/PriceFeed.sol", "precompiles/pricefeed/abi.json", "precompiles/pricefeed/abi_test.go"]
build_cmd = "go vet ./precompiles/pricefeed/"
verify_cmd = "go test ./precompiles/pricefeed/ -run TestPriceFeedABIGolden"
gate_kind = "planned"
planned_paths = ["precompiles/pricefeed/PriceFeed.sol", "precompiles/pricefeed/abi.json", "precompiles/pricefeed/abi_test.go"]
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark complete without the declared evidence."
path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to their current equivalents before the gate can run; historical references never authorize a duplicate implementation tree. Complete scoped path reconciliation without dropping acceptance criteria."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

