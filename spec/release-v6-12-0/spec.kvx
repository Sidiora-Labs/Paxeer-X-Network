do_1 = "POST /v2/auth/challenge with {address} answers {nonce, message} (Hyperpax:src/hooks/perps/usePerfdbAuth.ts:167-171, Hyperpax:src/hooks/perps/usePerfdbAuth.ts:24-27); the nonce is 32 random bytes stored in perps.auth_challenges with a 5 minute expiry and is single-use."
do_2 = "POST /v2/auth/verify with {address, signature, message} (Hyperpax:src/hooks/perps/usePerfdbAuth.ts:175-181) recovers the signer of the EIP-191 personal message with go-ethereum crypto (go.mod:27); on a match it answers {token, expires_in} (Hyperpax:src/hooks/perps/usePerfdbAuth.ts:29-32), an HS256 token for the lower-case address signed with PERPS_AUTH_SECRET, expiring after 3600 seconds."
do_3 = "POST /v2/auth/refresh with the bearer token (Hyperpax:src/hooks/perps/usePerfdbAuth.ts:201-207) answers a new {token, expires_in} while the presented token is valid and at most 24 hours old in total; otherwise 401."
do_4 = "auth.Middleware puts the address of a valid bearer token on the request context and answers 401 {error} otherwise; signatures, tokens and the secret are never logged (contracts/data-services.md:937)."
do_5 = "Add TestAuth with subtests challenge_single_use, verify_recovers_signer, verify_refuses_wrong_signer, verify_refuses_expired_nonce, refresh_valid, refresh_refuses_expired and middleware_401, signing with a real secp256k1 key (contracts/data-services.md:937)."

