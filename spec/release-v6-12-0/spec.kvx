[contract_context.4.interface]
addresses = "PECOR is served at 0x0000000000000000000000000000000000001021, PECOROrders at 0x1022, PECORStopOrders at 0x1023, PECORQuoter at 0x1024 and PECORVault at 0x1025, the five contracts the Hyperpax application resolves (Hyperpax:src/core/spot/addresses.ts:31-51); 0x1026 and 0x1027 carry no code."
constructor = "precompiles/spot NewPrecompileSet returns the address map of the five precompiles and an error, and is registered in node/app.go after GetCustomPrecompiles by the baseline wiring task 1.3.100, which returns the constructor error."
abi = "Each rail embeds the JSON form of its application ABI (Hyperpax:src/core/network/spot_abi/PECOR.ts:5 shape) through go:embed as launchpad does (precompiles/launchpad/launchpad.go:94-95), frozen by the golden fixtures under precompiles/spot/testdata."
caller = "The account of every write is the EVM caller mapped to its bank address by GetPaxAddressOrDefault (precompiles/utils/expected_keepers.go:117); value is refused on every non-payable method by ValidateNonPayable (precompiles/common/precompiles.go:374)."
tokens = "Every token has a kind in TokenParams: USDL and every bridged ERC20 are kind ERC20, their argument the token contract, pulled by transferFrom against an allowance to the rail that pulls and paid by transfer through the EVM keeper; uhpx and the SID denom are kind NATIVE, their argument the native pointer resolved by GetNativePointee (modules/evm/keeper/pointer.go:444), moved by bank SendCoins (precompiles/utils/expected_keepers.go:100)."
compatibility = "Every call of the Hyperpax application keeps its selector and argument list: market calls (Hyperpax:src/hooks/spot/useSpotOrders.ts:164-167), limit calls (Hyperpax:src/hooks/spot/useSpotOrders.ts:297-300), stop calls (Hyperpax:src/hooks/spot/useSpotOrders.ts:425-428) and quotes (Hyperpax:src/hooks/spot/useSpotQuoter.ts:139-142)."

[contract_context.4.storage]
store = "The spot module owns one KV store under StoreKey \"spot\" with one-byte prefixes in the shape of modules/launchpad/types/keys.go:7-48; the prefix table is contracts/spot.md#storage."
orders = "Limit, stop-limit and stop-loss records each have their own prefix and keep the field order of the application tuples (Launch-x:contracts/contracts/meta-ag/interfaces/IPECOROrders.sol:45-70), with orderMinOutput per order and one shared id counter (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:95)."
active_lists = "Active lists are kept per kind and removed by swap and pop (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:643-655), so EndBlock scans only live orders."
book = "Each token keeps book reserves, total deposited, total withdrawn, escrow and per-rail fee accruals (Launch-x:contracts/contracts/meta-ag/vault/PECORVault.sol:83-85 shape)."
twap = "Each non-stable token keeps a ring of 1000 index samples, the depth of Launch-x:contracts/contracts/meta-ag/oracle/PriceOracle.sol:46."
genesis = "GenesisState carries every prefix of contracts/spot.md#storage, the expiry index, cursors, back-off records and active counts included, and round-trips as modules/launchpad/keeper/genesis.go:11 and modules/launchpad/keeper/genesis.go:53."

[contract_context.4.errors]
encoding = "A failed call returns the 4-byte selector of the ABI error followed by its encoded arguments, written by the spot Run before vm.ErrExecutionReverted (precompiles/common/precompiles.go:187-216), instead of Error(string) of RevertReason (precompiles/common/precompiles.go:121-128)."
governance = "Every administrative method reverts OwnableUnauthorizedAccount(caller) (Hyperpax:src/core/network/spot_abi/PECOR.ts:1134); parameters change only through MsgUpdateParams (api/launchpad/tx.proto:22 shape)."
engine_strings = "Engine conditions without an ABI error map to ABI errors listed in contracts/spot.md#errors, as the limit-price checks of Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:417-418."
table = "The full list of 63 errors with selectors and causes is contracts/spot.md#errors, and contracts/spot.md#added-error-entries lists the entries each address serves beyond its application ABI (Hyperpax:src/core/network/spot_abi/PECOROrders.ts:5 source)."

[contract_context.4.events]
emission = "Every state change writes an EVM log at the rail that changed state through EmitEVMLog (precompiles/common/evm_events.go:16), with indexed fields as topics in ABI order."
endblock = "EndBlock logs go to the spot synthetic receipt and activation logs to the activation synthetic receipt of baseline task 1.0.6, appended through GetTransientReceipt and SetTransientReceipt (modules/evm/keeper/receipt.go:28-38) and converted by ConvertSyntheticEthLog (modules/evm/keeper/log.go:109)."
revert = "A reverted call writes no log, because the event list is dropped with its cached context (modules/launchpad/keeper/swap.go:129 shape)."
table = "The 36 events with full signature and topic0 are contracts/spot.md#events; the market event is MarketOrderExecuted (Hyperpax:src/core/network/spot_abi/PECOR.ts:852)."

[contract_context.4.gas]
table = "Each method is charged from one row of a GasTable (precompiles/common/precompiles.go:64-65) set by WithGasTable (precompiles/common/precompiles.go:115); the rows are contracts/spot.md#gas."
formula = "Rows follow the launchpad constants BaseGas 3000, GasPerByte 16 and GasPerWrite 5000 (precompiles/launchpad/launchpad.go:88-91)."
meter = "Bank moves, nested ERC20 calls and store reads and writes are charged through the context gas meter and the call gas on top of the row, as Run converts Cosmos gas (precompiles/common/precompiles.go:187-216)."
endblock = "EndBlock work, its CallEVM legs included, runs at gas price zero and is bounded by maxExpiriesPerBlock, activationScanPerBlock, fillScanPerBlock and maxFillsPerBlock with persisted cursors rather than by transaction gas, in the shape of the oracle EndBlocker (modules/oracle/abci.go:152-169)."

[contract_context.4.activation]
hook = "modules/spot/keeper/init_v6120.go func InitV6120(ctx sdk.Context, k Keeper) error runs in the hook table of baseline task 1.3.100 after createV6120Pointers (baseline task 1.2.4), launchpad MigrateV6120, pricefeed InitV6120 and perps SeedV6120, before the v6120Live flag is set."
tokens = "It registers USDL with kind ERC20 at contracts/libraries/Constants.sol:14 with the pinned 6 decimals (contracts/libraries/Constants.sol:16), uhpx (modules/evm/keeper/params.go:22) with kind NATIVE and pricefeed market 11 and the SID denom layerxbridgetypes.SidioraDenom() (modules/layerxbridge/types/keys.go:53-59) with kind NATIVE and market 12, reading native decimals from denom metadata as precompiles/pointer/pointer.go:107-124 and requiring the pinned 6."
shares = "It creates the three share denoms and their pointers through UpsertERCNativePointer (modules/evm/keeper/pointer_upgrade.go:49-57)."
gate = "The baseline wiring task 1.3.100 keys 0x1021 to 0x1027 to v6.12.0 in the versioned precompile maps, switches them live through the v6120Live flag the handler sets and adds the spot EndBlocker to the legacy end block keepers (node/legacyabci/end_block.go:15-28)."
once = "A second run returns an error because the params key is set (modules/launchpad/types/keys.go:36 key shape)."

[contract_context.4.invariants]
solvency = "For each token the custody, balanceOf of the module EVM address for an ERC20 token and the module bank balance for a native token, is at least book reserves plus escrow, and book reserves are at least the fee accruals, registered as launchpad registers its solvency invariant (modules/launchpad/keeper/invariants.go:13)."
shares = "The bank supply of a share denom is zero exactly when its pool never took a deposit and at least MINIMUM_SHARES after the first (contracts/src/NativePaxTokensERC20.sol:41-43 supply source)."
escrow = "Every escrow equals the sum of amounts of the active orders that hold it (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:99-102 index source)."
atomicity = "Each call and each EndBlock fill writes pull, payout, book and accrual in one cached context (modules/launchpad/keeper/swap.go:129 shape)."
conservation = "Every trade and fill adds amountIn to the input book and removes the net output from the output book, with the USD value at the index of amountIn equal to that of gross within the rounding of gross."

[contract_context.4.parameters]
fees = "swapFeeBps (taker, 0x1021), orderFeeBps (maker, 0x1022 and 0x1023), tier1FeeBps and tier2FeeBps take the values of contracts/perps-parameters.md#spot-fees; tiers start at 10,000 and 100,000 USD volume (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:743-747)."
impact = "priceImpactEnabled and priceImpactScalarBps set the impact deduction capped at MAX_IMPACT_BPS 500 (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:68, Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:711); the order rails use the order pricing set (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:114-118)."
pause = "swapPaused, ordersPaused and per-token paused flags change by MsgUpdateParams and emit Paused, Unpaused and TokenPauseUpdated (Hyperpax:src/core/network/spot_abi/PECOR.ts:436 shape)."
keepers = "keeperOpen and keepers decide who may call the execute and batch methods (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:110)."
twap = "fillQualityTwapPeriod, twapSanityEnabled, twapSanityPeriod, maxTwapDeviationBps and twapMaxPeriod set the TWAP rules (Launch-x:contracts/contracts/meta-ag/oracle/PriceOracle.sol:183-206)."
caps = "maxUtilizationBps per token is defined by contracts/spot.md#vault-share-accounting (9000 for the opening tokens, DEFAULT_MAX_UTILIZATION_BPS 10000 otherwise); maxExpiriesPerBlock, activationScanPerBlock, fillScanPerBlock and maxFillsPerBlock bound EndBlock work, maxFillBackoffBlocks caps the fill back-off, and minOrderNotional and maxActiveOrdersPerUser bound placement."
validation = "Params.Validate refuses FeeTooHigh and Tier2BelowTier1 by Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:187-205, ScalarTooHigh by Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:208-216 and the order pricing set bounds of Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:502-509, plus the budget, cap and kind bounds of contracts/spot.md#governance-parameters, in the shape of modules/launchpad/types/params.go:50."

