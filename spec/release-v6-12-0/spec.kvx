[contract_context.2.interface]
address = "The launchpad is served at 0x0000000000000000000000000000000000001017 (modules/launchpad/types/keys.go:26), registered at precompiles/setup.go:14."
roles = "Ten contract roles are served with their Launch-x ABIs: SidioraPool 42 functions, SidioraFactory 23, SidioraERC20 19, SidioraNFT 37, Router 23, Quoter 19, FeesRouter 20, FeeAccumulator 54, PoolRegistry 22, ProtocolConfig 27 (the pool entry point at Launch-x:contracts/contracts/core/SidioraPool.sol:147)."
direct_calls = "Direct calls to 0x1017 resolve through abi.json, 113 selectors, role order Router, SidioraFactory, Quoter, PoolRegistry, FeesRouter, FeeAccumulator, ProtocolConfig, replacing the method set of precompiles/launchpad/launchpad.go:46."
generations = "Each market carries generation 1 (Launch-x:protocol/addresses.go:22), generation 2 (Launch-x:shared/config/deployment/current.json:37) or 3 (created after the upgrade, roles at 0x1017); role surfaces of a generation answer for that generation."
fee_rights = "Fee rights are ERC721 tokens in the generation 1 collection 0xDF73…e190 and the generation 2 collection 0xe8Dc…409B; markets created after the upgrade mint in the generation 2 collection from nextTokenId (base Launch-x:contracts/contracts/base/ERC721Base.sol:11)."
pool_tokens = "Pool tokens are ERC20 tokens whose bank denoms are tokenfactory denoms with subdenom lp<index> (modules/launchpad/keeper/market.go:18) and whose old addresses are native pointers or token surfaces."

[contract_context.2.surfaces]
runtime = "Every contract address of the launchpad holds the 41-byte runtime 0x363d3d373360601b36523d3d601436013d3d6110175af13d600060003e6024573d6000fd5b3d6000f3 after the upgrade, written with SetCode (modules/evm/keeper/code.go:23)."
caller = "The precompile reads the original caller from the last 20 bytes only when its EVM caller is a registered surface, otherwise the EVM caller (precompiles/launchpad/launchpad.go:232)."
call_kinds = "Delegatecall reverts, writes under staticcall revert and value reverts (precompiles/common/precompiles.go:374)."
unknown_selector = "An unknown selector reverts with empty revert data."

[contract_context.2.quote_asset]
denom = "The quote denom is uusdl (modules/launchpad/types/params.go:31), six decimals (Launch-x:shared/config/deployment/current.json:98)."
pointer = "The ERC20 native pointer of uusdl is 0x85FcD13735F4309833A503EE804ea32395851479 (Launch-x:shared/config/deployment/current.json:86), returned by GetERC20NativePointer (precompiles/utils/expected_keepers.go:127)."
accounts = "Each EVM address holds uusdl in its bank account from GetPaxAddressOrDefault (modules/evm/keeper/address.go:58); pools keep reserves in the bank account of the pool address."
flows = "Quote moves with BankKeeper.SendCoins (modules/launchpad/types/expected_keepers.go:16) between the accounts of the contract flow."
allowances = "Router and Factory surfaces move the caller's own funds without an allowance; allowances held on the old USDL contract are not carried."

[contract_context.2.storage]
markets = "Market records extend modules/launchpad/types/market.go:58 under MarketPrefix (modules/launchpad/types/keys.go:39)."
surfaces = "Surface and role records are new prefixes beside modules/launchpad/types/keys.go:48."
history = "Holding history stays under HoldingHistoryPrefix (modules/launchpad/types/keys.go:45) and backs past balances of airdrops."
pool_slots = "Pool storage slots read by the migration are those of contracts/launchpad.md section 14, from the Launch-x build of each generation implementation."

[contract_context.2.errors]
revert_data = "Every refusal returns the contract custom error selector and ABI arguments as revert data; keeper errors keep their LXP_LAUNCHPAD_ codes (modules/launchpad/types/errors.go:7)."
admin = "Admin-gated writes revert MissingRole(caller, 0x00) (0x0161a64a, Launch-x:contracts/contracts/base/AccessControl.sol:42); initialize reverts AlreadyInitialized() (0x0dc149f0)."
pool_guardian = "Guardian functions revert Unauthorized() (0x82b42900, Launch-x:contracts/contracts/core/SidioraPool.sol:297) for other callers."

[contract_context.2.events]
native = "Contract-native events are emitted at the address that emitted them before, through EmitEVMLog (precompiles/common/evm_events.go:16)."
emitter = "The twelve EventEmitter launchpad events are emitted at 0x1017 with block timestamp and number appended (Launch-x:contracts/contracts/data/EventEmitter.sol:365); the EventEmitter contracts stay deployed for the other systems."
order = "Logs of one call appear in the contract order of the call."

[contract_context.2.gas]
schedule = "RequiredGas is Gas(inputBytes, writes, pointers) with BaseGas 3000, GasPerByte 16, GasPerWrite 5000, GasPerPointer 9000000 (precompiles/launchpad/launchpad.go:15-18)."
nested = "Optical calls are nested EVM calls metered by the EVM (precompiles/xweb/xweb.go:482)."

[contract_context.2.activation]
gate = "0x1017 stays behind activationPrecompileGate (node/upgrades.go:498)."
versions = "GetVersioned (precompiles/launchpad/setup.go:10) keeps the current precompile under v6.10 in legacy/v610."
handler = "The v6.12.0 handler calls MigrateV6120(ctx, k, evm) first and wraps its error as \"upgrade v6.12.0: launchpad: <error>\"."

[contract_context.2.invariants]
pool_solvency = "Bank balances of each pool cover realUsdlBalance and tokenReserve (Launch-x:contracts/contracts/core/SidioraPool.sol:268, modules/launchpad/keeper/invariants.go:20)."
liabilities = "Bank uusdl of each FeeAccumulator covers totalLiabilities (Launch-x:contracts/contracts/data/FeeAccumulator.sol:478-480)."
supply = "The uusdl supply after step 1 equals the USDL total-supply slot at the halt height."

[contract_context.2.parameters]
values = "Parameters equal ProtocolConfig.initialize (Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:45-54); ConcentrationWeight 0 and CreationFee 1000000 are required changes to modules/launchpad/types/params.go:34."
bounds = "Validate enforces the ProtocolConfig setter bounds (Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:84, Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:100, Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:67)."
governance = "Parameters change through MsgUpdateParams only (modules/launchpad/keeper/msg_server.go:14)."

[contract_context.2.migration]
order = "MigrateV6120 runs step 1 (USDL), step 2 (pools and pool tokens), step 3 (fee rights, roles, accounting) in one cached context."
usdl = "Step 1 reads holder balances with GetState (modules/evm/keeper/state.go:10), mints uusdl, clears the contract storage and installs the native pointer at 0x85FcD13735F4309833A503EE804ea32395851479 (modules/evm/keeper/pointer.go:29)."
pools = "Step 2 enumerates pools from each PoolRegistry (Launch-x:contracts/contracts/data/PoolRegistry.sol:23) and reads every pool slot."
not_carried = "Allowances, permit nonces, token checkpoint arrays (beyond open airdrop entitlements) and DEFAULT_ADMIN_ROLE memberships are not carried."

[contract_context.2.head_alignment]
decision_2 = "Decision 2 is met by building to the generation 2 interface and migrating both generations (req 2.24, req 2.25)."
decision_3 = "Decision 3 is met by uusdl as the bank form of the USDL ERC20 with its pointer at the USDL address (req 2.18, req 2.23), opticals (req 2.17), ERC721 fee rights (req 2.11)."
req_1_ac_1 = "Programme req 1 ac 1 is met by req 2.1 to req 2.17."
req_1_ac_2 = "Programme req 1 ac 2 is met by req 2.18 to req 2.21; graduation is not part of the contracts or the manifest (Launch-x:shared/config/deployment/current.json:107), so no graduation path is served."
req_1_ac_3 = "Programme req 1 ac 3 is met by req 2.23 to req 2.25."
req_1_ac_4 = "Programme req 1 ac 4 is met by req 2.11 and req 2.12."
req_1_ac_5 = "Programme req 1 ac 5 is met by req 2.30 to req 2.32."

