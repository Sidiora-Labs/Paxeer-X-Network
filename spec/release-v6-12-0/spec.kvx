[req.3006]
title = "One price-time priority book per market matches orders deterministically"
ac_1 = "Matching crosses on price (crosses, src/modules/perps/lx_perps_book.c:63), picks the best maker by price then sequence (better_match and best_match, src/modules/perps/lx_perps_book.c:71 and :84) and fills at the maker price, as lx_perps_book_match (src/modules/perps/lx_perps_book.c:121) does."
ac_2 = "POST_ONLY orders that would cross return LXP_PERPS_POST_ONLY_WOULD_CROSS and FOK orders that cannot fill completely return LXP_PERPS_FOK_NOT_FILLED with no state change, the rules at src/modules/perps/lx_perps_book.c:253 and :262."
ac_3 = "Self-trade prevention cancels the resting order of the same account and continues; at most 32 fills per taker order and the IOC remainder is cancelled."
ac_4 = "Book keys order bids by 2^256-1 minus price and asks by price, each followed by the 8-byte placement sequence, so ascending iteration of prefix 0x06 yields best price then earliest order (contracts/perps.md section 20), the order better_match applies (src/modules/perps/lx_perps_book.c:71)."
ac_5 = "A MARKET order against an empty opposite side returns LXP_PERPS_NO_LIQUIDITY; a fill beyond the slippage bound stops matching and an order with no fill returns LXP_PERPS_SLIPPAGE_EXCEEDED."
ac_6 = "The Go engine reproduces the golden vectors in modules/perps/keeper/testdata/matching_golden.json: for each recorded sequence of placements and cancels the fills, remaining book and events are identical; the book compaction of compact_book (src/modules/perps/lx_perps_book.c:102) has no observable effect."
ac_7 = "`event OrderExecuted(uint256 indexed orderId, uint256 indexed positionId, uint256 executionPrice)` is logged from 0x0000000000000000000000000000000000001015 on whenever an order's fills change a position, once per order per transaction or EndBlock pass, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_8 = "`event Fill(uint256 indexed marketId, uint256 indexed makerOrderId, uint256 indexed takerOrderId, address maker, address taker, bool takerIsLong, uint256 price, uint256 sizeUsd, int256 makerFeeUsd, uint256 takerFeeUsd)` is logged from 0x0000000000000000000000000000000000001015 on every maker-taker match, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_9 = "LXP_PERPS_POST_ONLY_WOULD_CROSS is registered with code 18 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when a post-only order would take liquidity."
ac_10 = "LXP_PERPS_FOK_NOT_FILLED is registered with code 19 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when a fill-or-kill order cannot fill completely."
ac_11 = "LXP_PERPS_NO_LIQUIDITY is registered with code 20 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when a market order finds no resting order within its price bound."

[req.3007]
title = "Trigger orders and attached TP/SL execute at mark in EndBlock or by executeOrder"
ac_1 = "Trigger conditions follow contracts/perps.md section 7 and are evaluated against the mark of the current block after the mark update."
ac_2 = "At most 256 triggered orders per block, in ascending trigger time then order id; the rest wait for the next block."
ac_3 = "An attached TP/SL pair is one-cancels-other and is removed when the position closes."
ac_4 = "STOP_LIMIT orders become resting limit orders when triggered and keep their sequence of trigger time for priority."
ac_5 = "`function placeTakeProfitOrder(uint256 positionId, uint256 triggerPrice) external returns (uint256 orderId)` is declared in precompiles/perps/abi.json and served by precompiles/perps/orders.go as a state-changing method, charged DefaultGasCost(input, true) plus 60,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePerpsOrders.ts:81."
ac_6 = "`function placeStopLossOrder(uint256 positionId, uint256 triggerPrice) external returns (uint256 orderId)` is declared in precompiles/perps/abi.json and served by precompiles/perps/orders.go as a state-changing method, charged DefaultGasCost(input, true) plus 60,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePerpsOrders.ts:91."
ac_7 = "`function setPositionTpSl(uint256 positionId, uint256 takeProfitPrice, uint256 stopLossPrice) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/orders.go as a state-changing method, charged DefaultGasCost(input, true) plus 60,000 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_8 = "`function executeOrder(uint256 orderId) external returns (uint256 positionId)` is declared in precompiles/perps/abi.json and served by precompiles/perps/orders.go as a state-changing method, charged DefaultGasCost(input, true) plus 250,000 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_9 = "`event OrderTriggered(uint256 indexed orderId, uint256 indexed marketId, uint256 markPrice)` is logged from 0x0000000000000000000000000000000000001015 on EndBlock trigger evaluation and executeOrder, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_10 = "`event PositionTpSlSet(uint256 indexed positionId, uint256 takeProfitPrice, uint256 stopLossPrice)` is logged from 0x0000000000000000000000000000000000001015 on setPositionTpSl and placeOrder with takeProfitPrice or stopLossPrice, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_11 = "LXP_PERPS_INVALID_TRIGGER_PRICE is registered with code 29 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when a trigger price is zero, off tick or on the wrong side of mark for its kind."
ac_12 = "LXP_PERPS_TRIGGER_NOT_REACHED is registered with code 30 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when executeOrder names an order whose trigger mark has not reached."

[req.3008]
title = "Positions net per account and market with weighted entry and realised PnL"
ac_1 = "One position per account and market; an opposite fill reduces, closes or flips it, the netting of execute_position_open and execute_position_close (src/modules/perps/lx_perps_dispatch.c:1252 and :1405)."
ac_2 = "Realised PnL is size x (exit - entry) x side, computed as lx_perps_pnl_compute (src/modules/perps/lx_perps_funding.c:20) does, and settles net of fees, funding and borrowing fee of the closed share."
ac_3 = "Entry price on increase is the size-weighted average rounded half up at 1e-18 USD."
ac_4 = "Reduce-only orders never increase or flip a position; a resting reduce-only order larger than the position is shrunk or cancelled after each fill."
ac_5 = "`function openPosition(uint256 marketId, address collateralToken, uint256 collateralAmount, uint256 leverage, bool isLong) external returns (uint256 positionId)` is declared in precompiles/perps/abi.json and served by precompiles/perps/positions.go as a state-changing method, charged DefaultGasCost(input, true) plus 250,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePosition.ts:63."
ac_6 = "`function addSize(uint256 positionId, uint256 additionalCollateral, uint256 leverage) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/positions.go as a state-changing method, charged DefaultGasCost(input, true) plus 250,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePosition.ts:121."
ac_7 = "`function addCollateral(uint256 positionId, uint256 amount) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/positions.go as a state-changing method, charged DefaultGasCost(input, true) plus 30,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePosition.ts:100."
ac_8 = "`function removeCollateral(uint256 positionId, uint256 amount) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/positions.go as a state-changing method, charged DefaultGasCost(input, true) plus 30,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePosition.ts:110."
ac_9 = "`function closePosition(uint256 positionId) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/positions.go as a state-changing method, charged DefaultGasCost(input, true) plus 250,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePosition.ts:79."
ac_10 = "`function partialClose(uint256 positionId, uint256 closeSizeUsd) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/positions.go as a state-changing method, charged DefaultGasCost(input, true) plus 250,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePosition.ts:89."
ac_11 = "`function closePositionWithParams(uint256 positionId, uint256 closeSizeUsd, uint256 acceptablePrice, uint64 deadline) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/positions.go as a state-changing method, charged DefaultGasCost(input, true) plus 250,000 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_12 = "`function getPosition(uint256 positionId) external view returns (address user, uint256 marketId, bool isLong, uint256 sizeUsd, uint256 collateralUsd, address collateralToken, uint256 collateralAmount, uint256 entryPrice, uint256 timestamp, bool active)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePosition.ts:29."
ac_13 = "`function getPositionDetails(uint256 positionId) external view returns (PositionDetails memory details)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_14 = "`function getUserPositionIds(address user) external view returns (uint256[] memory positionIds)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePosition.ts:38."
ac_15 = "`function getUserMarketPosition(address user, uint256 marketId) external view returns (uint256 positionId)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_16 = "`event PositionOpened(uint256 indexed positionId, address indexed user, uint256 indexed marketId, bool isLong, uint256 sizeUsd, uint256 leverage, uint256 entryPrice, address collateralToken, uint256 collateralAmount)` is logged from 0x0000000000000000000000000000000000001015 on the first fill that gives an account a position in a market, and a fill that flips a position's side, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_17 = "`event PositionModified(uint256 indexed positionId, uint256 newSizeUsd, uint256 newCollateralUsd, uint256 newCollateralAmount)` is logged from 0x0000000000000000000000000000000000001015 on every fill that increases or reduces a position without closing it, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_18 = "`event PositionEntryPriceChanged(uint256 indexed positionId, uint256 oldEntryPrice, uint256 newEntryPrice)` is logged from 0x0000000000000000000000000000000000001015 on every fill that increases a position, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_19 = "`event PositionClosed(uint256 indexed positionId, address indexed user, uint256 indexed marketId, uint256 closedSizeUsd, uint256 exitPrice, int256 realizedPnl, bool isFullClose)` is logged from 0x0000000000000000000000000000000000001015 on every fill that reduces or closes a position, including liquidation and ADL fills, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_20 = "`event TradeSettled(uint256 indexed positionId, address indexed user, uint256 indexed marketId, uint8 tradeType, uint256 sizeUsd, uint256 executionPrice, int256 grossPnl, uint256 totalFeesUsd, uint256 borrowingFeeUsd, int256 fundingPaidUsd, uint256 netPayoutTokens)` is logged from 0x0000000000000000000000000000000000001015 on every fill applied to a position; tradeType 0 open, 1 increase, 2 reduce, 3 close, 4 liquidation, 5 ADL, 6 backstop, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_21 = "LXP_PERPS_UNKNOWN_POSITION is registered with code 27 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when a position id names no open position."
ac_22 = "LXP_PERPS_NOT_POSITION_OWNER is registered with code 28 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when the caller does not own the position."
ac_23 = "LXP_PERPS_CLOSE_SIZE_EXCEEDS_POSITION is registered with code 40 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when a partial close asks more than the position notional."

[req.3009]
title = "Trading fees follow the 14-day volume tiers with maker rebates"
ac_1 = "Fee tier is the highest tier whose threshold the account's rolling 14-day volume exceeds, from 14 daily buckets keyed by floor(blockTime / 86400)."
ac_2 = "Fees round up to the uusdl unit and rebates round down; a rebate is paid from perps_fees."
ac_3 = "Buckets older than 14 days drop out of the volume; venue volume buckets give the maker share for rebate tiers."
ac_4 = "Liquidation fee is 0 and the insurance share of trading fees is 0; the split helper of lx_perps_liquidation_fee_split (src/modules/perps/lx_perps_liquidate.c:46) is not reproduced."
ac_5 = "`function getFees() external view returns (uint256 takerFeePpm, uint256 makerFeePpm, uint256 liquidationFeePpm, uint256 insuranceSharePpm)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_6 = "`function getFeeTier(address account) external view returns (uint8 tier, uint256 takerFeePpm, int256 makerFeePpm, uint256 volume14dUsd)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_7 = "`function getProtocolAccounts() external view returns (address feeRecipient, address insuranceFund)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_8 = "`event FeeCollected(uint256 indexed positionId, address indexed user, uint256 indexed marketId, uint8 feeType, uint256 feeUsd, uint256 feeTokens, address token)` is logged from 0x0000000000000000000000000000000000001015 on every taker fee, maker fee, maker rebate and borrowing fee booking; feeType 0 taker, 1 maker, 2 maker rebate paid, 3 borrowing, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."

[req.3010]
title = "The mark price combines the order book with the pricefeed module"
ac_1 = "The keeper reads GetPrice(ctx, marketId) of modules/pricefeed/keeper through PricefeedKeeper in modules/perps/types/expected_keepers.go, replacing the kernel price read oracle_price_current (src/modules/perps/lx_perps_dispatch.c:294)."
ac_2 = "Mark = median(Index + EMA150s(mid - Index), median(bid, ask, last), pricefeed Mark as contracts/pricefeed.md#mark-price defines it), with missing components replaced by Index; the mid uses the book as book_mid_price does (src/modules/perps/lx_perps_dispatch.c:1511)."
ac_3 = "A stale price refuses opening orders, market closes and liquidations of that market with LXP_PERPS_PRICE_STALE and EndBlock skips its triggers and liquidations; cancels and deposits stay open."
ac_4 = "MarkPriceUpdated is emitted once per market per block in which the mark changes."
ac_5 = "`function getMarkPrice(uint256 marketId) external view returns (uint256 markPrice, uint256 indexPrice, uint256 midPrice, bool fresh)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_6 = "`function quoteMarket(uint256 marketId) external view returns (MarketQuote memory quote)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useQuoter.ts:119."
ac_7 = "`event MarkPriceUpdated(uint256 indexed marketId, uint256 markPrice, uint256 indexPrice, uint256 midPrice)` is logged from 0x0000000000000000000000000000000000001015 on EndBlock once per market per block in which the mark changes, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_8 = "LXP_PERPS_PRICE_STALE is registered with code 5 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when GetPrice reports fresh false for an order, open, close-at-market or liquidation."

[req.3011]
title = "Funding samples the premium every 5 seconds and settles hourly with a 4 percent cap"
ac_1 = "Premium samples follow contracts/perps-parameters.md section 3 using the impact bid and ask of the market's impact notional."
ac_2 = "The 8-hour rate F = P + clamp(I - P, -0.0005, 0.0005) and the hourly rate F / 8 capped at 4 percent, replacing the bps clamp of lx_perps_funding_rate (src/modules/perps/lx_perps_funding.c:54, clamp at :83-84)."
ac_3 = "Settlement advances a cumulative index per unit of base (lx_perps_funding_index_update, src/modules/perps/lx_perps_funding.c:90) and a position owes size x index difference (lx_perps_funding_owed, src/modules/perps/lx_perps_funding.c:200), replacing the tick command execute_funding_tick (src/modules/perps/lx_perps_dispatch.c:1468)."
ac_4 = "Payments owed round up and payments received round down; the residue credits perps_insurance."
ac_5 = "Funding settlement runs before the liquidation pass of the same EndBlock."
ac_6 = "`function getCurrentFundingRate(uint256 marketId) external view returns (int256 ratePerSecond)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_7 = "`function getFundingState(uint256 marketId) external view returns (int256 cumulativeFundingPerUnit, uint256 lastSettleTime, int256 lastHourlyRate, int256 premiumSampleSum, uint256 premiumSampleCount)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_8 = "`function getPositionFunding(uint256 positionId) external view returns (int256 fundingOwedUsd)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_9 = "`event FundingRateUpdated(uint256 indexed marketId, int256 newRatePerSecond, int256 fundingRate24h)` is logged from 0x0000000000000000000000000000000000001015 on EndBlock at each hourly settlement, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_10 = "`event FundingSettled(uint256 indexed marketId, int256 fundingRate, int256 longPayment, int256 shortPayment)` is logged from 0x0000000000000000000000000000000000001015 on EndBlock at each hourly settlement, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_11 = "`event PositionFundingApplied(uint256 indexed positionId, address indexed user, uint256 indexed marketId, int256 fundingPaymentUsd, uint256 newCollateralUsd, uint256 newCollateralAmount)` is logged from 0x0000000000000000000000000000000000001015 on every position touched by an hourly settlement, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."

[req.3012]
title = "Open interest carries a kinked borrowing fee and a per-side cap"
ac_1 = "Utilisation U = max(long OI, short OI) / OI cap, capped at 1; APY = 0.05 + 4.75 x max(0, U - 0.8); hourly rate APY / 8760."
ac_2 = "Accrued fee = notional x (index now - index at open or last settlement), split 10 percent to perps_fees and 90 percent to perps_insurance."
ac_3 = "A fill that would take one side's OI above the cap returns LXP_PERPS_OPEN_INTEREST_CAP; reducing fills are always allowed."
ac_4 = "OpenInterestChanged is emitted on every fill that changes OI, with both sides after the fill."
ac_5 = "`function getBorrowingFeeRate() external view returns (uint256 ratePerSecond)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_6 = "`function getBorrowingRate(uint256 marketId) external view returns (uint256 hourlyRate, uint256 utilisation)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_7 = "`function getPendingBorrowingFee(uint256 positionId) external view returns (uint256 feeUsd)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_8 = "`function getOpenInterest(uint256 marketId) external view returns (uint256 longOI, uint256 shortOI)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePosition.ts:47."
ac_9 = "`event BorrowingFeeAccrued(uint256 indexed marketId, uint256 hourlyRate, uint256 utilisation, uint256 totalFeeUsd)` is logged from 0x0000000000000000000000000000000000001015 on EndBlock at each hourly borrowing index update, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_10 = "`event OpenInterestChanged(uint256 indexed marketId, uint256 longOI, uint256 shortOI, uint256 deltaUsd, bool isIncrease)` is logged from 0x0000000000000000000000000000000000001015 on every fill that changes a market's open interest, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_11 = "LXP_PERPS_OPEN_INTEREST_CAP is registered with code 15 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when an opening fill would lift a side above the market cap."

[req.3013]
title = "Accounts below maintenance are liquidated against the book in slices"
ac_1 = "Liquidation is account level and triggered by equity < maintenance margin; the order sweep and closing orders replace the leg builder of lx_perps_liquidation_legs_build and lx_perps_liquidate_execute (src/modules/perps/lx_perps_liquidate.c:82 and :177)."
ac_2 = "Positions above 100,000 USD close in 20 percent slices, one per 30 seconds of block time; a second slice inside the window returns LXP_PERPS_LIQUIDATION_COOLDOWN."
ac_3 = "EndBlock liquidates at most 64 accounts and 256 slices per block in ascending margin ratio; the rest carry to the next block."
ac_4 = "Liquidation price follows contracts/perps-parameters.md section 6 with the other positions held constant."
ac_5 = "A healthy account returns LXP_PERPS_NOT_LIQUIDATABLE and the caller is never paid."
ac_6 = "`function liquidate(uint256 positionId) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/positions.go as a state-changing method, charged DefaultGasCost(input, true) plus 300,000 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_7 = "`function getLiquidationPrice(uint256 positionId) external view returns (uint256 liquidationPrice)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_8 = "`event Liquidation(uint256 indexed positionId, address indexed user, uint256 indexed marketId, uint256 liquidationPrice, uint256 penalty, address keeper)` is logged from 0x0000000000000000000000000000000000001015 on each market liquidation slice, from liquidate or EndBlock (keeper is the zero address in EndBlock), through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_9 = "LXP_PERPS_NOT_LIQUIDATABLE is registered with code 33 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when liquidate names a position of an account at or above maintenance."
ac_10 = "LXP_PERPS_LIQUIDATION_COOLDOWN is registered with code 34 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when liquidate names a large position inside its partial-liquidation cooldown."

[req.3014]
title = "The insurance fund backstops accounts below two thirds of maintenance"
ac_1 = "When equity < 2/3 x maintenance margin, perps_insurance takes over every position at mark and the remaining collateral, emitting BackstopLiquidation and InsuranceContribution source 2."
ac_2 = "The insurance fund closes its backstop positions in EndBlock under the slice rule, crediting profit as InsuranceContribution source 3."
ac_3 = "A negative account balance after closing is covered from perps_insurance with InsuranceDraw, the role of lx_perps_insurance_cover (src/modules/perps/lx_perps_insurance.c:42)."
ac_4 = "When the fund cannot cover a deficit, VaultDeficit is emitted and ADL starts, the role of lx_perps_deficit_record (src/modules/perps/lx_perps_insurance.c:58)."
ac_5 = "`function getInsuranceBalance(address token) external view returns (uint256 balance)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_6 = "`event BackstopLiquidation(address indexed account, uint256 indexed marketId, uint256 sizeUsd, uint256 markPrice, uint256 marginTakenUsd)` is logged from 0x0000000000000000000000000000000000001015 on each position the insurance fund takes over, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_7 = "`event InsuranceContribution(address indexed token, uint256 amount, uint8 source)` is logged from 0x0000000000000000000000000000000000001015 on every credit to the insurance fund; source 0 trading-fee share, 1 borrowing-fee share, 2 backstop margin, 3 backstop position profit, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_8 = "`event InsuranceDraw(uint256 indexed marketId, uint256 amount, uint256 newBalance)` is logged from 0x0000000000000000000000000000000000001015 on every debit of the insurance fund to cover a negative account, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_9 = "`event VaultDeficit(address indexed token, uint256 deficit)` is logged from 0x0000000000000000000000000000000000001015 on when the insurance fund cannot cover a negative account and ADL starts, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."

[req.3015]
title = "Auto-deleveraging ranks opposite profitable positions and executes at the previous mark"
ac_1 = "Rank = (mark / entry for a long, entry / mark for a short) x (position notional / account value), descending, ties by ascending position id, replacing candidate_compare and candidate_sort (src/modules/perps/lx_perps_insurance.c:95 and :102)."
ac_2 = "ADL reduces the deficit position and ranked counterparties by the same size at the previous block's mark until the deficit is closed, as lx_perps_adl_execute (src/modules/perps/lx_perps_insurance.c:117) and execute_adl (src/modules/perps/lx_perps_dispatch.c:1676) apply it."
ac_3 = "ADL never reduces a losing position and runs only after the insurance fund is exhausted."
ac_4 = "ADL scenarios replay the vectors in modules/perps/keeper/testdata/adl_golden.json."
ac_5 = "`function getADLRank(uint256 positionId) external view returns (uint256 rankScore, bool profitable)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_6 = "`event ADLExecuted(uint256 indexed positionId, uint256 deleveragedSizeUsd)` is logged from 0x0000000000000000000000000000000000001015 on each deficit position reduced by ADL, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_7 = "`event ADLMatched(uint256 indexed marketId, uint256 indexed positionId, address indexed account, uint256 sizeUsd, uint256 price, uint256 rankScore)` is logged from 0x0000000000000000000000000000000000001015 on each counterparty position reduced by ADL, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."

[req.3016]
title = "Quotes predict execution exactly without changing state"
ac_1 = "quoteOpenPosition walks the book with the same matching code as execution on a cached context that is discarded."
ac_2 = "quoteClosePosition and quotePartialClose return exit price, PnL, fees, funding and payout equal to the close executed in the same state."
ac_3 = "Quotes never write state: the store hash before and after any quote is identical."
ac_4 = "quoteMarket returns priceStale true when the pricefeed price is not fresh."
ac_5 = "`function quoteOpenPosition(uint256 marketId, address collateralToken, uint256 collateralAmount, uint256 leverage, bool isLong) external view returns (OpenPositionQuote memory quote)` is declared in precompiles/perps/abi.json and served by precompiles/perps/quotes.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useQuoter.ts:136."
ac_6 = "`function quoteClosePosition(uint256 positionId) external view returns (ClosePositionQuote memory quote)` is declared in precompiles/perps/abi.json and served by precompiles/perps/quotes.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useQuoter.ts:146."
ac_7 = "`function quotePartialClose(uint256 positionId, uint256 closeSizeUsd) external view returns (uint256 exitPrice, int256 closedPnl, uint256 fee, uint256 estimatedPayout)` is declared in precompiles/perps/abi.json and served by precompiles/perps/quotes.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."

[req.3017]
title = "The precompile enforces gas, call kind, value and pause rules uniformly"
ac_1 = "NewPrecompile builds the precompile with WithLXPReasons (precompiles/common/precompiles.go:107-111) and WithGasTable (precompiles/common/precompiles.go:115-118); RequiredGas (precompiles/common/precompiles.go:165) charges DefaultGasCost (precompiles/common/precompiles.go:441-447) plus the surcharge of contracts/perps.md section 21."
ac_2 = "Writes under STATICCALL return LXP_PERPS_STATIC_CALL and any DELEGATECALL returns LXP_PERPS_DELEGATECALL, the checks of the exchange Execute (precompiles/layerxexchange/layerxexchange.go:205-206 and :213-214)."
ac_3 = "Value sent to any method fails ValidateNonPayable (precompiles/common/precompiles.go:374)."
ac_4 = "With Params.Paused true every write outside the exit set returns LXP_PAUSED_SCOPE (modules/layerxgov/types/proposal.go:26), mirroring CheckPauseScope (modules/layerxgov/types/proposal.go:38) and the exchange PauseCheck (modules/layerxexchange/keeper/msg_server.go:52), with the perps exit set kept in modules/perps/keeper/pause.go because pauseExitPaths (modules/layerxgov/types/proposal.go:28) has no perps entry."
ac_5 = "The precompile reaches the keeper only through PerpsKeepers { PerpsK() } on the application keepers, the type-assertion pattern of XWebKeepers (precompiles/utils/expected_keepers.go:57-61, precompiles/xweb/xweb.go:153); keepers without it make every call revert."
ac_6 = "LXP_PERPS_STATIC_CALL is registered with code 36 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when a write method is reached through STATICCALL."
ac_7 = "LXP_PERPS_DELEGATECALL is registered with code 37 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when any method is reached through DELEGATECALL."

[req.3018]
title = "EndBlock runs the venue's periodic work and publishes its logs as a synthetic receipt"
ac_1 = "modules/perps/abci.go EndBlocker(ctx, k) runs the steps of contracts/perps.md section 23 in order; the baseline wiring task 1.3.100 calls it from EndBlock (node/legacyabci/end_block.go:22-28) before EvmKeeper.EndBlock."
ac_2 = "EndBlock logs are written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36) as one shell receipt shaped as node/receipt.go:144-153, each log converted with ConvertSyntheticEthLog (modules/evm/keeper/log.go:109-113) and flushed by HandlePreCommit (node/app.go:1279-1281)."
ac_3 = "The receipt tx hash is keccak256 of perps-endblock and the height as 8 big-endian bytes, and its TransactionIndex is one above the highest TxIndex of GetAllEVMTxDeferredInfo (modules/evm/keeper/deferred.go:13, read in EVM EndBlock at modules/evm/keeper/abci.go:126)."
ac_4 = "A failure in one market's step is isolated in a cached context: that market's writes of the step are dropped, the error is emitted as an event and the chain continues."
ac_5 = "A block with no state to process emits no receipt."

[req.3019]
title = "The v6.9 exchange implementation is kept under legacy/v69 for historical heights"
ac_1 = "precompiles/layerxexchange/legacy/v69 holds an unchanged copy of the current layerxexchange.go, abi.json and errors.go in package layerxexchangev69, in the layout of precompiles/xweb/legacy/v68/xweb.go."
ac_2 = "precompiles/layerxexchange/setup.go GetVersioned (precompiles/layerxexchange/setup.go:10-14) adds the entry v6.9 for layerxexchangev69.NewPrecompile, and the versions file gains v6.9, matching ActivationUpgrade (node/upgrades.go:93)."
ac_3 = "Calls at heights below the v6.12.0 done height resolve to the legacy contract through GetCustomPrecompilesVersions (modules/evm/keeper/keeper.go:356-385)."
ac_4 = "Replaying a recorded v6.9 call sequence on the legacy contract produces the recorded return data and logs."

[req.3020]
title = "Every perps error is a registered LXP_PERPS code returned first in the revert text"
ac_1 = "modules/perps/types/errors.go registers each error with sdkerrors.Register(ModuleName, code, LXP_PERPS_<NAME>) on the pattern of modules/launchpad/types/errors.go:7-9, codes 2 to 43 without gaps."
ac_2 = "The precompile returns the code first, LXP_PERPS_<NAME>: detail, so LXPReason passes it through unchanged (precompiles/common/precompiles.go:134-143); a wrapped keeper error is unwrapped to its registered code with errors.Is."
ac_3 = "Every error of contracts/perps.md section 19 is reachable through the precompile and has a revert test."

[req.3021]
title = "State is deterministic, exported and checked by invariants"
ac_1 = "Genesis exports and imports every store prefix of contracts/perps.md section 20 and ValidateGenesis refuses duplicate ids, orphan book entries and stale counters with LXP_PERPS_INVALID_GENESIS."
ac_2 = "The invariants of contracts/perps.md section 24 are registered as crisis invariants as the launchpad registers its own (modules/launchpad/keeper/invariants.go:13-20)."
ac_3 = "Arithmetic is 256-bit integer with explicit rounding; overflow returns LXP_PERPS_OVERFLOW and no float type appears in the keeper."
ac_4 = "Two keepers that apply the same scenario produce identical stores and logs; the scenarios cover open, fill, funding, liquidation, backstop and ADL."
ac_5 = "Events alone reconstruct positions and collateral: replaying the logs of a scenario gives every account's collateral and positions."
ac_6 = "LXP_PERPS_OVERFLOW is registered with code 38 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when an intermediate fixed-point product exceeds 256 bits."
ac_7 = "LXP_PERPS_INVALID_GENESIS is registered with code 39 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when genesis state fails validation."

[req.3022]
title = "Parameters have validated defaults and change only by upgrade handler"
ac_1 = "modules/perps/types/params.go DefaultParams carries the figures of contracts/perps-parameters.md sections 1 to 8, stored as JSON like the launchpad params (modules/launchpad/types/params.go:16, modules/launchpad/keeper/keeper.go:50-60)."
ac_2 = "Params.Validate refuses inverted fee tiers, a maker above taker, negative caps and zero bounds with LXP_PERPS_INVALID_PARAMS."
ac_3 = "Keeper.UpdateParams(ctx, authority, params) accepts only the governance authority (modules/launchpad/keeper/keeper.go:76-85) and refuses others with LXP_PERPS_UNAUTHORIZED."
ac_4 = "LXP_PERPS_INVALID_PARAMS is registered with code 2 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when params or a market config fail Validate."
ac_5 = "LXP_PERPS_UNAUTHORIZED is registered with code 35 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when UpdateParams or SetMarket is signed by an account other than the governance module account."

[req.3023]
title = "Domain completion runs the whole perps package set"
ac_1 = "TestPerpsDomainWiring in modules/perps/module_test.go builds the module, the keeper and the precompile together and runs one deposit, order, fill, funding hour and close."
ac_2 = "go test ./modules/perps/... ./precompiles/perps/... ./precompiles/layerxexchange/... passes in one run."
ac_3 = "An EVM transaction sequence in the order the Hyperpax application sends it (createVault, deposit, openPosition, setPositionTpSl, partialClose, closePosition, withdraw) succeeds against 0x1015 through the EVM, with receipts carrying the events of contracts/perps.md section 18."
ac_4 = "The module follows the launchpad module shape: RegisterServices, RegisterInvariants, InitGenesis and ConsensusVersion 1 (modules/launchpad/module.go:98-113, :128)."

[capability_group.3.1]
title = "Interface and schema"
children = ["3.1.1", "3.1.2", "3.1.3"]

[capability.3.1.1]
title = "ABI freeze"
reqs = ["3001.1", "3001.2", "3001.3", "3001.4"]
touches = ["precompiles/perps/Perps.sol", "precompiles/perps/abi.json", "precompiles/perps/testdata/abi_golden.txt"]
tests = ["precompiles/perps/abi_test.go"]
