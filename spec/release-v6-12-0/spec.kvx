[capability.7.1.1]
title = "Add the JetStream and GraphQL modules to the root module and copy the NATS driver"
reqs = ["7001.1", "7007.9"]
touches = ["go.mod", "go.sum", "platform/perps-data/internal/delivery/natsdriver/driver.go", "platform/perps-data/internal/delivery/natsdriver/driver_test.go"]
tests = ["platform/perps-data/internal/delivery/natsdriver/driver_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/internal/delivery/natsdriver/ -run 'TestNATSDriver'"
do_1 = "Add github.com/nats-io/nats.go v1.47.0 (the version of Launch-x:shared/go.mod:123), github.com/nats-io/nats-server/v2 for the in-process test broker and github.com/graph-gophers/graphql-go to the root module with go get at pinned versions and commit both go.sum lines (h1 and go.mod) of each; the require block lists none of them today (go.mod:27-55) and go.sum:1287 holds only the graphql-go go.mod line without a module hash (contracts/data-services.md section 1). The go.mod edit lands after the layerx-merge go.mod task 0.154 and rebases onto it; the module path stays go.mod:1 so platform/perps-data imports the leaf ABI packages of the same commit."
do_2 = "Copy Publisher and NewPublisher (Launch-x:shared/delivery/natsdriver/driver.go:22, Launch-x:shared/delivery/natsdriver/driver.go:27) into internal/delivery/natsdriver/driver.go, origin Launch-x shared/delivery/natsdriver, keeping the subject pattern Launch-x:shared/delivery/natsdriver/driver.go:17 and the 5 second publish timeout Launch-x:shared/delivery/natsdriver/driver.go:20 (contracts/data-services.md section 1)."
do_3 = "Keep Publish (Launch-x:shared/delivery/natsdriver/driver.go:38) publishing with WithMsgID and WithExpectStream (Launch-x:shared/delivery/natsdriver/driver.go:45) and refusing an acknowledgement with a foreign stream or a zero sequence (Launch-x:shared/delivery/natsdriver/driver.go:52) (contracts/data-services.md section 1)."
do_4 = "Copy ConsumerConfig, NewConsumer, Fetch, Run and BrokerPosition (Launch-x:shared/delivery/natsdriver/driver.go:58, Launch-x:shared/delivery/natsdriver/driver.go:93, Launch-x:shared/delivery/natsdriver/driver.go:151, Launch-x:shared/delivery/natsdriver/driver.go:209, Launch-x:shared/delivery/natsdriver/driver.go:238); the import of the Launch-x delivery package is rewritten to platform/perps-data/internal/delivery (contracts/data-services.md section 1)."
do_5 = "Required change against the copy: the replace of go-ethereum by pax-geth (go.mod:280) stays the only go-ethereum source, so the driver and the decoders use one ethtypes.Log type (contracts/data-services.md section 1)."
do_6 = "Add TestNATSDriver with subtests publish_ack, refuses_foreign_stream, refuses_zero_sequence, dedup_msg_id and consumer_fetch against an in-process nats-server/v2 with JetStream enabled, so the pinned modules are compiled and exercised by the task gate (contracts/data-services.md section 1)."

[capability.7.1.2]
title = "Copy the delivery envelope, outbox store and relay onto database/sql"
reqs = ["7007.10"]
touches = ["platform/perps-data/internal/delivery/envelope.go", "platform/perps-data/internal/delivery/store.go", "platform/perps-data/internal/delivery/relay.go", "platform/perps-data/internal/delivery/store_test.go"]
tests = ["platform/perps-data/internal/delivery/store_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/internal/delivery/ -run 'TestDeliveryStore'"
do_1 = "Copy MaxEnvelopeBytes, SourceOrder, Envelope, Policy and Validate (Launch-x:shared/delivery/envelope.go:17, Launch-x:shared/delivery/envelope.go:29, Launch-x:shared/delivery/envelope.go:35, Launch-x:shared/delivery/envelope.go:49, Launch-x:shared/delivery/envelope.go:56) into internal/delivery/envelope.go, origin Launch-x shared/delivery (contracts/data-services.md section 1)."
do_2 = "Copy Store with NewStore, Enqueue, Claim, MarkPublished, Retry and Consume (Launch-x:shared/delivery/store.go:31, Launch-x:shared/delivery/store.go:38, Launch-x:shared/delivery/store.go:137, Launch-x:shared/delivery/store.go:173, Launch-x:shared/delivery/store.go:205, Launch-x:shared/delivery/store.go:230, Launch-x:shared/delivery/store.go:279) into internal/delivery/store.go (contracts/data-services.md section 1)."
do_3 = "Required change against the copy: NewStore takes *sql.DB and Enqueue takes *sql.Tx instead of pgxpool.Pool and pgx.Tx (Launch-x:shared/delivery/store.go:38, Launch-x:shared/delivery/store.go:137), because the root module drives Postgres through lib/pq (go.mod:55) (contracts/data-services.md section 1)."
do_4 = "Copy Relay and RunOnce (Launch-x:shared/delivery/relay.go:16, Launch-x:shared/delivery/relay.go:27) into internal/delivery/relay.go; the relay claims pending outbox rows, publishes them through natsdriver.Publisher.Publish and records the broker stream and sequence with MarkPublished (contracts/data-services.md section 1)."
do_5 = "Add TestDeliveryStore with subtests enqueue_in_tx, claim_mark_published, retry_backoff, consume_inbox_dedup and relay_run_once against the Postgres of PERPS_DATA_TEST_DATABASE_URL migrated by store.Migrate and an in-process nats-server/v2; the test fails with the message requires PERPS_DATA_TEST_DATABASE_URL when the variable is empty (contracts/data-services.md section 1)."

[capability.7.1.3]
title = "Stream PERPS_V1 configuration and the subject layout"
reqs = ["7007.1", "7007.2", "7007.3", "7007.4", "7007.5", "7007.6", "7007.13"]
touches = ["platform/perps-data/internal/stream/layout.go", "platform/perps-data/internal/stream/layout_test.go"]
tests = ["platform/perps-data/internal/stream/layout_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/internal/stream/ -run 'TestStreamLayout'"
do_1 = "Add stream.Config returning the PERPS_V1 jetstream.StreamConfig: file storage, three replicas, 72 hour max age, discard new, deny delete and purge, a 2 minute duplicate window and a 1048576 byte message bound, the stream contract of the launchpad backend production topology (Launch-x:deploy/production/topology/README.md:28), and subjects perps.<chain>.> where <chain> is the configured chain id that replaces the literal 125 of Launch-x:core/indexer/internal/source/committed.go:634 (contracts/data-services.md section 3)."
do_2 = "Add stream.Subject and the builders MarketSubject(chain, market, kind) for kinds fill, order, funding, index, liq, mark, oi and market, UserSubject(chain, account, kind) for position, order, fill, margin, funding and ledger, ChainSubject(chain, kind) for block, tx and rewind, and SpotSubject(chain, token, kind) for swap, order and vault; stream.Subject refuses a kind outside the table of contracts/data-services.md section 3 with an error naming it, and every token matches the subject pattern Launch-x:shared/delivery/natsdriver/driver.go:17."
do_3 = "Copy ValidSubjectFilter and SubjectMatches (Launch-x:shared/delivery/stream.go:257, Launch-x:shared/delivery/stream.go:274) as stream.ValidFilter and stream.Matches, origin Launch-x shared/delivery/stream.go, used by the gateway to bind a topic to its subject filter (contracts/data-services.md section 3)."
do_4 = "Accounts are written as lower-case 0x hex of the 20-byte address, the form the topics of precompiles/common/evm_events.go:32-35 carry once decoded, and markets as the decimal marketId (contracts/data-services.md section 3)."
do_5 = "Add TestStreamLayout with subtests config, market_subjects, user_subjects, chain_subjects, spot_subjects, unknown_kind and filters asserting the strings, the refusal of an unknown kind and the stream configuration of contracts/data-services.md section 3."

[capability.7.1.4]
title = "Fact, chain and projection tables of schema perps"
reqs = ["7002.1", "7002.2", "7002.3", "7002.4", "7002.5"]
touches = ["platform/perps-data/migrations/0001_facts.sql", "platform/perps-data/migrations/0002_projections.sql", "platform/perps-data/migrations/embed.go", "platform/perps-data/migrations/schema_test.go"]
tests = ["platform/perps-data/migrations/schema_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/migrations/ -run 'TestSchemaFiles'"
do_1 = "Write migrations/0001_facts.sql creating schema perps with the common fact columns of contracts/data-services.md section 2 (row_id, block, block_hash, tx_index, log_index, sub, tx_hash, receipt_kind, block_time, emitter, kind, account, tx_from), every fact table of that section, perps.raw_logs, perps.protocol_events and perps.tx_actions; each fact table has primary key (block, tx_index, log_index, sub) and unique indexes (tx_hash, log_index, sub) and (row_id), extending the swap key of Launch-x:core/indexer/migrations/00001_init.sql:202 with sub so CollateralTransferred and other multi-row events keep every row."
do_2 = "receipt_kind carries a CHECK on tx, perps_endblock, spot_endblock, activation and block_event, and a CHECK keeps tx_from null for every receipt kind other than tx; the signed columns named in section 6 carry CHECK (x >= -2^255 AND x < 2^255) and unsigned columns CHECK (x >= 0) (contracts/data-services.md section 2)."
do_3 = "0001_facts.sql also creates the chain tables perps.blocks (number, hash, parent_hash, time, proposer as the upper-case hex of the CometBFT header ProposerAddress, tx_count) with the fields of BlockRecord (Launch-x:core/indexer/internal/source/committed.go:64), perps.cursors in the shape of the launchpad cursor table (Launch-x:core/indexer/migrations/00001_init.sql:13), perps.writer_lease, perps.markets and perps.fee_config, the last two keyed market_id with a unique symbol and id 1 (contracts/data-services.md section 2)."
do_4 = "Write migrations/0002_projections.sql with positions_current, orders, spot_orders, account_margin, user_stats, user_pnl_daily, market_stats_rolling, leaderboard, spot_token_seen, market_snapshots, protocol_snapshots and keeper_cycles in the columns and keys of section 2, and the view perps.account_ledger over collateral_events, fees, funding_payments and trade_settlements; no candle table and no oi_snapshots table exist, open interest history being read from perps.open_interest (contracts/data-services.md section 2)."
do_5 = "Every amount column is numeric(78,0) holding the raw uint256 or int256 value of the log, refused by a CHECK when it has a fraction, so no scaling happens before the gateway; every account column is bytea of length 20 (contracts/data-services.md section 2)."
do_6 = "Add migrations/embed.go declaring the package migrations with //go:embed *.sql into FS, so internal/store applies the files in lexical order (contracts/data-services.md section 2)."
do_7 = "Add TestSchemaFiles in migrations/schema_test.go with subtests fact_columns, fact_keys, receipt_kind_check, chain_tables, projections_and_view and no_candle_table, reading the embedded SQL of migrations.FS and asserting the statements of section 2 without a database (contracts/data-services.md section 2)."

[capability.7.1.5]
title = "Migration runner and the delivery tables"
reqs = ["7002.1", "7002.2", "7002.3", "7002.4", "7002.5", "7002.6", "7002.7", "7002.8", "7002.9", "7009.14"]
touches = ["platform/perps-data/migrations/0003_delivery.sql", "platform/perps-data/internal/store/migrate.go", "platform/perps-data/internal/store/migrate_test.go"]
tests = ["platform/perps-data/internal/store/migrate_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/internal/store/ -run 'TestMigrate'"
do_1 = "Write migrations/0003_delivery.sql from the delivery template with schema perps substituted: delivery_outbox, its pending index and immutable trigger, delivery_inbox and delivery_quarantine (Launch-x:shared/delivery/schema.sql:2, Launch-x:shared/delivery/schema.sql:25, Launch-x:shared/delivery/schema.sql:34, Launch-x:shared/delivery/schema.sql:35, Launch-x:shared/delivery/schema.sql:43) (contracts/data-services.md section 2)."
do_2 = "Add store.Open(databaseURL) returning *sql.DB through lib/pq (go.mod:55) and store.Migrate(ctx, db) that applies migrations.FS in order inside one transaction per file and records each file name and sha256 in perps.schema_migrations (contracts/data-services.md section 2)."
