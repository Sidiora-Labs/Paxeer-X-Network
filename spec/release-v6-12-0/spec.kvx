do_4 = "Logs (symbol logFromEvent) packed by PackEvent of precompiles/perps/abi and emitted through EmitEVMLog (precompiles/common/evm_events.go:16) with addressTopic (precompiles/launchpad/launchpad.go:434)."

[capability.3.3.3]
title = "EndBlock and synthetic receipt"
reqs = ["3018.1", "3018.4", "3018.2", "3018.3", "3018.5"]
touches = ["modules/perps/abci.go", "modules/perps/keeper/endblock.go", "modules/perps/keeper/evmlogs.go"]
tests = ["modules/perps/keeper/endblock_test.go", "modules/perps/keeper/evmlogs_test.go"]
verification_contract = "go test ./modules/perps/keeper/... -run 'TestEndblock|TestEvmlogs'"
do_1 = "EndBlocker (symbol EndBlocker) runs the nine bounded steps of contracts/perps.md section 23 and is called from node/legacyabci/end_block.go:22-28 by baseline task 1.3.103."
do_2 = "SetTransientReceipt (modules/evm/keeper/receipt.go:28-36) writes the receipt (symbol WriteEndBlockReceipt)."
do_3 = "ConvertSyntheticEthLog (modules/evm/keeper/log.go:109-113) marks logs synthetic (symbol WriteEndBlockReceipt)."
do_4 = "The synthetic receipt hash is SyntheticReceiptHash(SyntheticReceiptPerps, height), keccak256(\"perps-endblock\" ‖ 8-byte big-endian height), written under SyntheticReceiptContext at the provisional index math.MaxUint32 - 2 and rewritten to N, the number of transactions of the block, by flushTransientReceipts (modules/evm/keeper/receipt.go:142); baseline task 1.0.6 serves it to eth_getLogs and pax_getLogs, and ABI packing comes from precompiles/perps/abi so the keeper never imports precompiles/perps (symbol WriteEndBlockReceipt)."

[capability.3.3.4]
title = "Seed, genesis, invariants and module"
reqs = ["3002.1", "3002.2", "3021.1", "3021.2", "3023.1", "3023.2", "3023.4"]
