verification_contract = "go test -count=1 ./platform/perps-data/internal/ws/ -run 'TestSpotUserSocket'"
do_1 = "On connect the server sends {type: hello, service: websocket, streams: [trade, position, pnl, order, closed-leg], protocolVersion: 1} (Hyperpax:src/hooks/spot/useSpotUserStream.ts:10-12) (contracts/data-services.md section 25)."
do_2 = "The client sends {op: subscribe|unsubscribe, stream, address} and {op: ping} (Hyperpax:src/hooks/spot/useSpotUserStream.ts:15-17); the server answers subscribed, unsubscribed and pong control frames with type set (contracts/data-services.md section 25)."
do_3 = "Data frames carry stream, the lower-case address and data (Hyperpax:src/hooks/spot/useSpotUserStream.ts:162-164); data has the shape of the matching REST item: trade as SpotTrade, position as SpotPosition, pnl as SpotPnlSummary, order as SpotOrder, closed-leg as SpotClosedLeg (contracts/data-services.md section 25)."
do_4 = "Frames are fed from the perps.<chain>.spot.> and user subjects through the hub consumer; at most 50 subscriptions per socket and the 30 second ping of the data socket apply (contracts/data-services.md section 25)."
do_5 = "Add TestSpotUserSocket with subtests hello, subscribe_unsubscribe, ping, one per stream, and subscription_cap over a real websocket against an in-process nats-server (contracts/data-services.md section 25)."

[capability.7.3.17]
title = "Wallet sign-in: challenge, verify and refresh"
reqs = ["7025.1", "7025.2", "7025.3", "7025.4", "7025.5", "7025.6", "7025.7"]
touches = ["platform/perps-data/internal/auth/auth.go", "platform/perps-data/internal/auth/auth_test.go"]
tests = ["platform/perps-data/internal/auth/auth_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/internal/auth/ -run 'TestAuth'"
do_1 = "POST /v2/auth/challenge with {address} answers {nonce, message} (Hyperpax:src/hooks/perps/usePerfdbAuth.ts:167-171, Hyperpax:src/hooks/perps/usePerfdbAuth.ts:24-27); the nonce is 32 random bytes stored in perps.auth_challenges with a 5 minute expiry and is single-use (contracts/data-services.md section 26)."
do_2 = "POST /v2/auth/verify with {address, signature, message} (Hyperpax:src/hooks/perps/usePerfdbAuth.ts:175-181) recovers the signer of the EIP-191 personal message with go-ethereum crypto (go.mod:27); on a match it answers {token, expires_in} (Hyperpax:src/hooks/perps/usePerfdbAuth.ts:29-32), an HS256 token for the lower-case address signed with PERPS_AUTH_SECRET, expiring after 3600 seconds (contracts/data-services.md section 26)."
do_3 = "POST /v2/auth/refresh with the bearer token (Hyperpax:src/hooks/perps/usePerfdbAuth.ts:201-207) answers a new {token, expires_in} while the presented token is valid and at most 24 hours old in total; otherwise 401 (contracts/data-services.md section 26)."
do_4 = "auth.Middleware puts the address of a valid bearer token on the request context and answers 401 {error} otherwise; signatures, tokens and the secret are never logged (contracts/data-services.md section 26)."
do_5 = "Add TestAuth with subtests challenge_single_use, verify_recovers_signer, verify_refuses_wrong_signer, verify_refuses_expired_nonce, refresh_valid, refresh_refuses_expired and middleware_401, signing with a real secp256k1 key (contracts/data-services.md section 26)."

