[task.7.1.1]
title = "Head follower with parent-hash continuity and rewind"
status = "pending"
mode = "BUILD"
wave = 1
requires = ["7.0.5", "7.0.7", "7.1.3", "7.1.9", "1.0.6"]
reqs = ["7003.1", "7003.2", "7003.3", "7003.4", "7003.5", "7003.6", "7003.12", "7003.13", "7003.14", "7003.15"]
capabilities = ["7.2.1"]
do_1 = "Copy EVMOptions, EVMSource, NewEVM, Head, FetchLogs, toLog, getBlock, callWithFallback, rankedIndices, markSuccess, markFailure, runHealthCheck and parseHexUint64 (Launch-x:core/indexer/internal/source/evm.go:21, Launch-x:core/indexer/internal/source/evm.go:53, Launch-x:core/indexer/internal/source/evm.go:76, Launch-x:core/indexer/internal/source/evm.go:182, Launch-x:core/indexer/internal/source/evm.go:204, Launch-x:core/indexer/internal/source/evm.go:346, Launch-x:core/indexer/internal/source/evm.go:376, Launch-x:core/indexer/internal/source/evm.go:410, Launch-x:core/indexer/internal/source/evm.go:499, Launch-x:core/indexer/internal/source/evm.go:528, Launch-x:core/indexer/internal/source/evm.go:541, Launch-x:core/indexer/internal/source/evm.go:552, Launch-x:core/indexer/internal/source/evm.go:633) into internal/source/rpc.go as RPC, origin Launch-x core/indexer/internal/source."
do_2 = "RPC.Logs filters on the address set of contracts/data-services.md section 1: 0x1015, 0x1020, 0x1021 to 0x1025, every share pointer of the pointer set and the USDL contract 0x85FcD13735F4309833A503EE804ea32395851479, in the FetchOptions and FetchResult shapes of Launch-x:core/indexer/internal/source/source.go:30 and Launch-x:core/indexer/internal/source/source.go:43; 0x1026 and 0x1027 carry no code and are not read. Block, transaction and log indexes are filled by the node because the precompile adds only address, topics and data (precompiles/common/evm_events.go:32-38)."
do_3 = "Catch-up reads at most 500 blocks per eth_getLogs call, below MaxBlocksForLog 2000 and MaxLogNoBlock 10000 (rpc/config/config.go:195-196), and halves the range and retries when the node refuses a response for size."
do_4 = "Logs of end blocks and of the activation arrive in the synthetic receipts served by baseline task 1.0.6; Follower.checkSynthetic compares each against the table of section 1 (perps_endblock at the highest real TxIndex plus 1, spot_endblock plus 2, activation plus 3, hash keccak256 of the tag and the 8-byte height) and stops the follower with the height, the expected and the served values on a mismatch, storing nothing under a guessed key."
do_5 = "Comet reads, per height over PERPS_COMET_URLS with fallback, the CometBFT header route for the proposer (consensus/internal/rpc/core/routes.go:44, consensus/types/block.go:423), written to perps.blocks.proposer as upper-case hex, and the block_results route for finalize_block_events (consensus/internal/rpc/core/routes.go:48, consensus/rpc/coretypes/responses.go:93), passed to the pricefeed decoder."
do_6 = "Share pointer discovery is two-pass per block: pass one decodes the logs of 0x1025 and records each ShareTokenCreated, pass two fetches the logs of the pointers known after pass one; at start the pointer set is seeded from getRegisteredTokens() (0x14cbd993) and shareTokens(address) (0x96153f07) on 0x1025."
do_7 = "Follower.Step polls the head every 100 ms with 10 ms jitter, the cadence of Launch-x:core/indexer/internal/source/committed.go:830, and for each next height fetches the block and its logs; it checks the parent hash against the stored perps.blocks row of height n-1 as Launch-x:core/indexer/internal/source/committed.go:1037 does."
do_8 = "On a parent-hash mismatch or a stored hash that differs at the same height (the conflict of Launch-x:core/indexer/internal/source/committed.go:648), Follower.rewind walks back to the highest height whose stored hash equals the node hash; the fork height is that height plus one, the first height whose stored hash differs. In one transaction it deletes every fact and projection row at and above the fork height, moves the cursor to the fork height minus one and enqueues one perps.<chain>.chain.rewind message carrying the fork height; perps.markets and perps.fee_config are never deleted."
do_9 = "Projections are rebuilt for the affected accounts and markets from the remaining facts in the same transaction, so a read after the rewind never mixes rows of two branches."
do_10 = "Add TestFollower with subtests follows_head, detects_parent_mismatch, rewinds_to_fork, publishes_rewind, rpc_fallback, synthetic_receipt_check, comet_header_and_results, two_pass_pointers and rewind_keeps_markets against the node named by PERPS_DATA_TEST_RPC and PERPS_DATA_TEST_COMET (a node started with make run-local-node, chain.mk:278) and the Postgres of PERPS_DATA_TEST_DATABASE_URL; the mismatch case writes a perps.blocks row with a different hash at a real height and asserts the rewind."
do_11 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["source.RPC", "source.NewRPC", "source.RPC.Head", "source.RPC.Block", "source.RPC.Logs", "source.Follower", "source.Follower.Step", "source.Follower.rewind", "source.Comet", "source.Comet.Header", "source.Comet.BlockResults", "source.Follower.checkSynthetic"]
touches = ["platform/perps-data/internal/source/rpc.go", "platform/perps-data/internal/source/comet.go", "platform/perps-data/internal/source/follower.go", "platform/perps-data/internal/source/follower_test.go"]
build_cmd = "go build ./platform/perps-data/..."
verify_cmd = "go test -count=1 ./platform/perps-data/internal/source/ -run 'TestFollower'"
