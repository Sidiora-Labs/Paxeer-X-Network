[capability.7.1.1]
title = "Add the JetStream client to the root module and copy the NATS driver"
reqs = ["7001.1", "7007.9"]
touches = ["go.mod", "go.sum", "platform/perps-data/internal/delivery/natsdriver/driver.go"]
tests = ["None"]
verification_contract = "go build ./platform/perps-data/..."
do_1 = "Add github.com/nats-io/nats.go v1.47.0 (the version of Launch-x:shared/go.mod:123) and github.com/nats-io/nats-server/v2 for the in-process test broker to the require block that already holds go-ethereum, gorilla/websocket, lib/pq and client_golang (go.mod:27, go.mod:44, go.mod:55, go.mod:69); the module path stays go.mod:1 so platform/perps-data imports the precompile ABIs of the same commit (contracts/data-services.md:5)."
do_2 = "Copy Publisher and NewPublisher (Launch-x:shared/delivery/natsdriver/driver.go:22, Launch-x:shared/delivery/natsdriver/driver.go:27) into internal/delivery/natsdriver/driver.go, origin Launch-x shared/delivery/natsdriver, keeping the subject pattern Launch-x:shared/delivery/natsdriver/driver.go:17 and the 5 second publish timeout Launch-x:shared/delivery/natsdriver/driver.go:20."
do_3 = "Keep Publish (Launch-x:shared/delivery/natsdriver/driver.go:38) publishing with WithMsgID and WithExpectStream (Launch-x:shared/delivery/natsdriver/driver.go:45) and refusing an acknowledgement with a foreign stream or a zero sequence (Launch-x:shared/delivery/natsdriver/driver.go:52)."
do_4 = "Copy ConsumerConfig, NewConsumer, Fetch, Run and BrokerPosition (Launch-x:shared/delivery/natsdriver/driver.go:58, Launch-x:shared/delivery/natsdriver/driver.go:93, Launch-x:shared/delivery/natsdriver/driver.go:151, Launch-x:shared/delivery/natsdriver/driver.go:209, Launch-x:shared/delivery/natsdriver/driver.go:238); the import of the Launch-x delivery package is rewritten to platform/perps-data/internal/delivery."
do_5 = "Required change against the copy: the replace of go-ethereum by pax-geth (go.mod:280) stays the only go-ethereum source, so the driver and the decoders use one ethtypes.Log type (contracts/data-services.md:5)."

[capability.7.1.2]
title = "Copy the delivery envelope, outbox store and relay onto database/sql"
reqs = ["7007.10"]
touches = ["platform/perps-data/internal/delivery/envelope.go", "platform/perps-data/internal/delivery/store.go", "platform/perps-data/internal/delivery/relay.go"]
tests = ["None"]
verification_contract = "go build ./platform/perps-data/..."
do_1 = "Copy MaxEnvelopeBytes, SourceOrder, Envelope, Policy and Validate (Launch-x:shared/delivery/envelope.go:17, Launch-x:shared/delivery/envelope.go:29, Launch-x:shared/delivery/envelope.go:35, Launch-x:shared/delivery/envelope.go:49, Launch-x:shared/delivery/envelope.go:56) into internal/delivery/envelope.go, origin Launch-x shared/delivery."
do_2 = "Copy Store with NewStore, Enqueue, Claim, MarkPublished, Retry and Consume (Launch-x:shared/delivery/store.go:31, Launch-x:shared/delivery/store.go:38, Launch-x:shared/delivery/store.go:137, Launch-x:shared/delivery/store.go:173, Launch-x:shared/delivery/store.go:205, Launch-x:shared/delivery/store.go:230, Launch-x:shared/delivery/store.go:279) into internal/delivery/store.go."
do_3 = "Required change against the copy: NewStore takes *sql.DB and Enqueue takes *sql.Tx instead of pgxpool.Pool and pgx.Tx (Launch-x:shared/delivery/store.go:38, Launch-x:shared/delivery/store.go:137), because the root module drives Postgres through lib/pq (go.mod:55)."
do_4 = "Copy Relay and RunOnce (Launch-x:shared/delivery/relay.go:16, Launch-x:shared/delivery/relay.go:27) into internal/delivery/relay.go; the relay claims pending outbox rows, publishes them through natsdriver.Publisher.Publish and records the broker stream and sequence with MarkPublished."

[capability.7.1.3]
title = "Stream PERPS_V1 configuration and the subject layout"
reqs = ["7007.1", "7007.2", "7007.3", "7007.4", "7007.5", "7007.6"]
touches = ["platform/perps-data/internal/stream/layout.go", "platform/perps-data/internal/stream/layout_test.go"]
tests = ["platform/perps-data/internal/stream/layout_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/internal/stream/ -run TestStreamLayout"
do_1 = "Add stream.Config returning the PERPS_V1 jetstream.StreamConfig: file storage, three replicas, 72 hour max age, discard new and deny delete and purge, the stream contract of the launchpad backend production topology (Launch-x:deploy/production/topology/README.md:28), and subjects perps.<chain>.> where <chain> is the configured chain id that replaces the literal 125 of Launch-x:core/indexer/internal/source/committed.go:634."
do_2 = "Add MarketSubject(chain, market, kind) for kinds fill, order, funding, oracle, liq, mark, oi and market, UserSubject(chain, account, kind) for position, order, fill, margin, funding and ledger, ChainSubject(chain, kind) for block, tx and rewind, and SpotSubject(chain, token, kind) for swap, order and vault; every token matches the subject pattern Launch-x:shared/delivery/natsdriver/driver.go:17."
do_3 = "Copy ValidSubjectFilter and SubjectMatches (Launch-x:shared/delivery/stream.go:257, Launch-x:shared/delivery/stream.go:274) as stream.ValidFilter and stream.Matches, origin Launch-x shared/delivery/stream.go, used by the gateway to bind a topic to its subject filter."
do_4 = "Accounts are written as lower-case 0x hex of the 20-byte address, the form the topics of precompiles/common/evm_events.go:32-35 carry once decoded, and markets as the decimal marketId."
do_5 = "Add TestStreamLayout with subtests config, market_subjects, user_subjects, chain_subjects, spot_subjects and filters asserting the strings and the stream configuration of contracts/data-services.md section 3 (contracts/data-services.md:386)."

[capability.7.1.4]
title = "Fact and projection tables of schema perps"
reqs = ["7002.1", "7002.2", "7002.3", "7002.4", "7002.5"]
touches = ["platform/perps-data/migrations/0001_facts.sql", "platform/perps-data/migrations/0002_projections.sql", "platform/perps-data/migrations/embed.go"]
tests = ["None"]
verification_contract = "go build ./platform/perps-data/..."
do_1 = "Write migrations/0001_facts.sql creating schema perps with the append-only fact tables of contracts/data-services.md section 2, each keyed by (block, tx_index, log_index) and unique on (tx_hash, log_index) as the launchpad indexer keys its swaps (Launch-x:core/indexer/migrations/00001_init.sql:202)."
do_2 = "Include perps.blocks (number, hash, parent_hash, time, proposer, tx_count) carrying the fields of BlockRecord (Launch-x:core/indexer/internal/source/committed.go:64) and perps.cursors in the shape of the launchpad indexer cursor table (Launch-x:core/indexer/migrations/00001_init.sql:13)."
do_3 = "Write migrations/0002_projections.sql with positions_current, orders, account_margin, user_stats, user_pnl_daily, market_stats_rolling, leaderboard, oi_snapshots, market_snapshots, protocol_snapshots and candles; candles keep the primary key and sequence column of Launch-x:core/trading-charts/migrations/00001_init.sql:10 with market_id and series in place of the pool address."
do_4 = "Every amount column is numeric(78,0) holding the raw uint256 or int256 value of the log, refused by a CHECK when it has a fraction, so no scaling happens before the gateway; every account column is bytea of length 20 (contracts/data-services.md:26)."
do_5 = "Add migrations/embed.go declaring the package migrations with //go:embed *.sql into FS, so internal/store applies the files in lexical order (contracts/data-services.md:26)."

[capability.7.1.5]
title = "Migration runner and the delivery tables"
reqs = ["7002.1", "7002.2", "7002.3", "7002.4", "7002.5", "7002.6", "7002.7", "7002.8"]
touches = ["platform/perps-data/migrations/0003_delivery.sql", "platform/perps-data/internal/store/migrate.go", "platform/perps-data/internal/store/migrate_test.go"]
