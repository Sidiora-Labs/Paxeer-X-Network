[capability.7.3.1]
title = "WebSocket frame codec, control frames, error codes and per-socket limits"
reqs = ["7012.1", "7012.2", "7012.3", "7012.4", "7012.5", "7012.6", "7012.7", "7012.8", "7012.9", "7012.10", "7012.11", "7012.12", "7012.13"]
touches = ["platform/perps-data/internal/ws/protocol.go", "platform/perps-data/internal/ws/protocol_test.go"]
tests = ["platform/perps-data/internal/ws/protocol_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/internal/ws/ -run TestWSProtocol"
do_1 = "Add ParseClientFrame accepting subscribe, unsubscribe and ping with an optional limit (Hyperpax:data_api.md:29, Hyperpax:data_api.md:30-35, Hyperpax:data_api.md:38) and returning the error codes invalid_json, missing_topic, unknown_event, subscribe_rate_limit and too_many_subscriptions (Hyperpax:data_api.md:52-53)."
do_2 = "Add the control frames welcome, subscribed, unsubscribed, pong and error with ts and snapshotId (Hyperpax:data_api.md:44-50) and DataFrame with topic, ts, snapshotId, seq, snapshot and data (Hyperpax:data_api.md:59-68); snapshot is omitted on live frames."
do_3 = "Add Limits with 200 subscriptions per socket and 50 subscribe operations per second (Hyperpax:data_api.md:88) and a 30 second server ping (Hyperpax:data_api.md:86); a socket that answers no ping within two intervals is closed."
do_4 = "When the gateway sheds load it closes with code 1013 and the reason retry-after=<seconds>, which the application client parses (Hyperpax:src/core/net/realtime.ts:84-85), with a jittered value between 5 and 30 seconds."
do_5 = "Add TestWSProtocol with subtests one per client event, one per error code, control_frames, data_envelope, subscription_cap, subscribe_rate and close_1013 over a real gorilla/websocket connection to an httptest server running the codec (contracts/data-services.md:531)."

[capability.7.3.2]
title = "Topic hub with snapshot, dense sequence and resume from JetStream"
reqs = ["7012.14", "7012.15", "7012.16", "7012.17", "7012.18", "7012.19"]
touches = ["platform/perps-data/internal/ws/hub.go", "platform/perps-data/internal/ws/hub_test.go"]
tests = ["platform/perps-data/internal/ws/hub_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/internal/ws/ -run TestHub"
do_1 = "Add Hub keyed by topic, with one topicState per topic holding the per-process snapshotId, the dense seq of the topic and the last applied Perps-Seq; seq increases by exactly 1 per delta (Hyperpax:data_api.md:72-82)."
do_2 = "Subscribe sends subscribed, then exactly one frame with snapshot true carrying the seq of the last broadcast at build time, then every delta with a greater seq; the application guard accepts this order and drops nothing (Hyperpax:src/core/net/realtime.ts:29-47)."
do_3 = "The hub consumes PERPS_V1 through natsdriver.NewConsumer with an ordered ephemeral consumer per gateway process (Launch-x:shared/delivery/natsdriver/driver.go:93); on start or after a consumer reset it resumes from the JetStream sequence recorded with the last applied message (Launch-x:shared/delivery/natsdriver/driver.go:238), so no message between snapshot and live stream is skipped."
do_4 = "A perps.<chain>.chain.rewind message makes every affected topic rebuild its snapshot and send it with snapshot true and the next seq; a gap the hub cannot fill closes the socket with 1013 so the client resyncs through REST (Hyperpax:src/core/net/realtime.ts:42)."
do_5 = "A Provider per topic family (book, trade, stats, kline, market, totals, chain) builds the snapshot from Postgres and maps messages to deltas; frames older than 60 seconds are never sent because the client closes on them ({c(RT+\":68\",\"60000\")}) (contracts/data-services.md:412)."
do_6 = "Add TestHub with subtests snapshot_then_deltas, dense_seq, resume_from_stream_seq, rewind_resnapshot, gap_closes_1013 and stale_frame_dropped against an in-process nats-server and PERPS_DATA_TEST_DATABASE_URL (contracts/data-services.md:412)."

