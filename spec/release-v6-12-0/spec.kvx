do_2 = "Copy the abi array of each Launch-x artifact of SidioraNFT, Router and Quoter into precompiles/launchpad/abi/<Role>.json unchanged; the sources are core/SidioraNFT.sol, periphery/Router.sol and periphery/Quoter.sol under Launch-x contracts at c5eb7c7 (first function of the first file at Launch-x:contracts/contracts/base/AccessControl.sol:9)."
do_3 = "Copy the abi array of each Launch-x artifact of FeesRouter, FeeAccumulator and PoolRegistry into precompiles/launchpad/abi/<Role>.json unchanged; the sources are periphery/FeesRouter.sol, data/FeeAccumulator.sol and data/PoolRegistry.sol under Launch-x contracts at c5eb7c7 (first function of the first file at Launch-x:contracts/contracts/base/AccessControl.sol:9)."
do_4 = "Copy the ProtocolConfig artifact ABI into abi/ProtocolConfig.json (27/6/13, setters from Launch-x:contracts/contracts/protocol/ProtocolConfig.sol:59) and the Treasury artifact ABI into abi/Treasury.json (17/8/19, Launch-x:contracts/contracts/protocol/Treasury.sol:13)."

