scenario = "Given the rehearsal chain, when the Hyperpax spot call sequence (market buy and sell with slippage and deadline, limit and stop orders, quotes, liquidity info, vault shares) runs against 0x1021-0x1025, then every call is served with the selectors the application encodes, and eth_getCode returns 0x at 0x1026 and 0x1027."
contract = "contracts/spot.md"
test = "tools/release/rehearse-v6120.sh::check_spot_interface (planned)"
