[contract_context.3.interface]
address = "The perpetuals venue is served at 0x0000000000000000000000000000000000001015, the address the exchange precompile holds today (modules/layerxexchange/types/ids.go:15, precompiles/layerxexchange/layerxexchange.go:71), from the v6.12.0 activation height."
surface = "IPerps in precompiles/perps/Perps.sol declares 64 functions (25 state-changing, 39 views), 31 events and the structures OrderParams, AccountSummary, PositionMargin, MarketQuote, OpenPositionQuote and ClosePositionQuote, loaded from abi.json with MustGetABI (precompiles/common/precompiles.go:449)."
compatibility = "Every method the Hyperpax application calls keeps its selector and tuple order: positions (Hyperpax:src/hooks/perps/usePosition.ts:29-121), orders (Hyperpax:src/hooks/perps/usePerpsOrders.ts:10-91), vault calls (Hyperpax:src/hooks/perps/useVault.ts:12-58), margin views (Hyperpax:src/hooks/perps/useMarginMode.ts:121, :241) and quotes (Hyperpax:src/hooks/perps/useQuoter.ts:7-42)."
vault_address = "createVault and getVault return 0x0000000000000000000000000000000000001015 for an account that exists and the zero address otherwise, so the application's vault-address calls (Hyperpax:src/hooks/perps/useVault.ts:28-58) reach the precompile; no vault contract is deployed."
caller = "The account of every write is the EVM caller; delegatecall reverts LXP_PERPS_DELEGATECALL and a write under staticcall reverts LXP_PERPS_STATIC_CALL, the refusals of precompiles/layerxexchange/layerxexchange.go:205-206 and :213-214; value transfers are refused by ValidateNonPayable (precompiles/common/precompiles.go:374)."
collateral = "Collateral is uusdl (modules/launchpad/types/params.go:31), moved with BankKeeper.SendCoins (modules/launchpad/types/expected_keepers.go:15-16) between the caller's address from GetPaxAddressOrDefault (precompiles/utils/expected_keepers.go:117) and the perps module account; the token argument equals GetERC20NativePointer(ctx, uusdl) (precompiles/utils/expected_keepers.go:127)."

[contract_context.3.storage]
store = "One KV store under store key perps with the prefixes 0x01 to 0x11 of contracts/perps.md section 20; parameters as JSON as modules/launchpad/keeper/keeper.go:50-60 stores them."
book_keys = "Book keys are marketId, side, a 32-byte price key (bids 2^256-1 minus price) and the sequence, so ascending iteration gives price-time priority as better_match orders it (src/modules/perps/lx_perps_book.c:71)."
records = "Order, Position and MarketState replace the C records lx_perps_order, lx_perps_position and lx_perps_funding_state (include/layerx/lx_perps.h:85, :116, :196) with fixed binary encodings."
genesis = "InitGenesis and ExportGenesis cover every prefix and ValidateGenesis refuses duplicate ids, orphan book entries and counters below stored ids with LXP_PERPS_INVALID_GENESIS, wired as modules/launchpad/module.go:106-113."
module_accounts = "perps holds every coin; perps_fees and perps_insurance are perps accounts in the store, derived as module addresses as modules/launchpad/keeper/keeper.go:40 derives one."

[contract_context.3.errors]
registry = "42 errors with codes 2 to 43 registered under module perps with description LXP_PERPS_<NAME>, as modules/launchpad/types/errors.go:7-9 registers launchpad errors."
revert_text = "The precompile is built WithLXPReasons (precompiles/common/precompiles.go:107-111); LXPReason passes a text that starts with LXP_ unchanged (precompiles/common/precompiles.go:134-143), so the revert reason is LXP_PERPS_<NAME>: detail and the keeper error is unwrapped with errors.Is."
pause = "A paused venue returns LXP_PAUSED_SCOPE, the registered govtypes.ErrPausedScope (modules/layerxgov/types/proposal.go:26), not a perps code."

[contract_context.3.events]
emission = "31 events are logged from 0x1015 through EmitEVMLog (precompiles/common/evm_events.go:16) inside transactions, with indexed address topics built as addressTopic (precompiles/launchpad/launchpad.go:434)."
endblock_receipt = "Events of the EndBlock pass are written as one synthetic receipt with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36), logs converted by ConvertSyntheticEthLog (modules/evm/keeper/log.go:109-113), shaped as the shell receipt of node/receipt.go:144-153."
reconstruction = "The fields of the events are sufficient to rebuild every account, order and position, the obligation the data services rely on; modules/perps/keeper/events_reconstruct_test.go checks it."

[contract_context.3.gas]
table = "Each method is charged DefaultGasCost(input, write) plus its surcharge through WithGasTable (precompiles/common/precompiles.go:115-118), DefaultGasCost as precompiles/common/precompiles.go:59-70 and 441-447 compute it from the KV flat and per-byte costs (sdk/store/types/gas.go:349-358)."
refusal = "A method without a gas row is refused before execution, and EndBlock work is charged to no transaction and bounded by the per-block limits of contracts/perps.md section 23."

[contract_context.3.activation]
version_map = "The baseline wiring task 1.3.100 maps 0x1015 to the perps contract under LatestUpgrade and v6.12.0 and to the v6.9 exchange under ActivationUpgrade (node/upgrades.go:93); heights resolve through GetCustomPrecompilesVersions (modules/evm/keeper/keeper.go:356-385)."
legacy = "precompiles/layerxexchange/legacy/v69 keeps the v6.9 implementation unchanged and GetVersioned (precompiles/layerxexchange/setup.go:10-14) gains v6.9, the legacy pattern of precompiles/p256/setup.go:15-24."
seed = "SeedV6120(ctx sdk.Context, k Keeper) error writes DefaultParams and the eighteen markets with ids 0 to 17 of Hyperpax:src/core/perps/config.ts:168-185, the ids the pricefeed uses (contracts/pricefeed.md#markets-and-chainflow-symbols)."
wiring = "The baseline wiring task 1.3.100 adds PerpsK() beside the keepers of node/precompiles.go:98-107, the perps store key beside node/app.go:1437, the EndBlocker call in node/legacyabci/end_block.go:22-28 and keeps the 0x1015 gate of node/upgrades.go:489-503."

[contract_context.3.invariants]
solvency = "The uusdl bank balance of the perps module account equals the sum of all account collateral."
open_interest = "Long open interest equals short open interest per market and equals the sum of position sizes of each side."
book = "Every resting order has one book entry and every book entry points to a resting order of the same market, side and price."
registration = "The eight invariants of contracts/perps.md section 24 are registered in modules/perps/keeper/invariants.go on the pattern of modules/launchpad/keeper/invariants.go:13-20."

[contract_context.3.parameters]
defaults = "DefaultParams in modules/perps/types/params.go carries the figures of contracts/perps-parameters.md sections 1 to 8 in the JSON shape of modules/launchpad/types/params.go:16-28."
governance = "Params and markets change only by upgrade handlers through Keeper.UpdateParams and Keeper.SetMarket with the authority check of modules/launchpad/keeper/keeper.go:76-85."
cap = "The venue leverage cap is 1000x; the consequences for maintenance margin, liquidation distance and funding are contracts/perps-parameters.md section 9."

[contract_context.3.pause]
exit_set = "While Params.Paused is true only cancelOrder, cancelByCloid, closePosition, partialClose, closePositionWithParams, withdraw, emergencyWithdraw and removeCollateral run; others return LXP_PAUSED_SCOPE (modules/layerxgov/types/proposal.go:26)."
pattern = "CheckPause mirrors CheckPauseScope (modules/layerxgov/types/proposal.go:38-49) and the exchange PauseCheck (modules/layerxexchange/keeper/msg_server.go:52); the exit set lives in the perps keeper because pauseExitPaths (modules/layerxgov/types/proposal.go:28) has no perps entry."

[contract_context.3.endblock]
entry = "modules/perps/abci.go EndBlocker(ctx sdk.Context, k keeper.Keeper) runs once per block, called by the baseline wiring task 1.3.100 from node/legacyabci/end_block.go:22-28."
steps = "Prices and mark, premium samples, hourly funding and borrowing, triggers (at most 256), expiries, liquidation scan (at most 64 accounts and 256 slices) with backstop and ADL, then backstop position closes, each market step in its own cached context."
price_read = "Each market reads GetPrice(ctx, marketId) of modules/pricefeed/keeper per contracts/pricefeed.md#freshness-and-read-api, replacing oracle_price_current (src/modules/perps/lx_perps_dispatch.c:294); a market that is not Fresh skips triggers and liquidation for the block."
receipt_index = "The synthetic receipt index is one above the highest TxIndex of GetAllEVMTxDeferredInfo (modules/evm/keeper/deferred.go:13), flushed in HandlePreCommit (node/app.go:1279-1281)."

[contract_context.3.markets]
ids = "Eighteen markets with ids 0 to 17, symbols and max leverage of Hyperpax:src/core/perps/config.ts:168-185, the same ids as contracts/pricefeed.md#markets-and-chainflow-symbols."
tiers = "Tier classes and the deduction recurrence of contracts/perps-markets.md sections 3 and 4; maintenance margin = notional x MMR(tier) - deduction(tier) replaces the single-rate check of lx_perps_maintenance_check (src/modules/perps/lx_perps_liquidate.c:23)."
mark = "The venue mark is median(Index + EMA150s(mid - Index), median(bid, ask, last), pricefeed Mark) with the pricefeed Mark of contracts/pricefeed.md#mark-price; the mid is the book mid as book_mid_price computes it (src/modules/perps/lx_perps_dispatch.c:1511)."

