do_1 = "Write migrations/0003_delivery.sql from the delivery template with schema perps substituted: delivery_outbox, its pending index and immutable trigger, delivery_inbox and delivery_quarantine (Launch-x:shared/delivery/schema.sql:2, Launch-x:shared/delivery/schema.sql:25, Launch-x:shared/delivery/schema.sql:34, Launch-x:shared/delivery/schema.sql:35, Launch-x:shared/delivery/schema.sql:43)."
do_2 = "Add store.Open(databaseURL) returning *sql.DB through lib/pq (go.mod:55) and store.Migrate(ctx, db) that applies migrations.FS in order inside one transaction per file and records each file name and sha256 in perps.schema_migrations (contracts/data-services.md:26)."
do_3 = "Migrate refuses to start when a recorded file hash differs from the embedded file, so a changed migration never applies silently (contracts/data-services.md:26)."
do_4 = "Add TestMigrate with subtests applies_all, idempotent, refuses_changed_hash and tables_and_indexes against the Postgres named by PERPS_DATA_TEST_DATABASE_URL; the test fails with the message requires PERPS_DATA_TEST_DATABASE_URL when the variable is empty (contracts/data-services.md:26)."

