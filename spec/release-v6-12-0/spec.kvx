do_1 = "PlaceStopLimit validates every argument before any token move (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:249-254 before the pull at Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:256), applies minOrderNotional and maxActiveOrdersPerUser, maps a zero price (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:251) to InvalidPrices and the range check (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:253) to LimitMustBeAboveStopBuy or LimitMustBeBelowStopSell."
do_2 = "ActivateStopLimit follows Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:291-307; ExecuteStopLimit follows Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:431-444 with NotActivated (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:433) and PriceAboveLimit or PriceBelowLimit (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:437)."
do_3 = "PlaceStopLoss writes its own StopLossOrder record (prefix 0x0F) and active stop-loss index, pulled with rail 0x1023, where the source kept a STOP_LOSS limit record (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:200-202); no limit list holds it."
do_4 = "CancelStopLimit accepts PENDING or ACTIVATED and otherwise returns CannotCancel, the ABI name of the source OrderCannotCancel() (Launch-x:contracts/contracts/meta-ag/engine/PECOROrders.sol:557); CancelStopLoss accepts PENDING and otherwise returns NotPending; a stop-limit expiry reports StopLimitCancelled and a stop-loss expiry StopLossOrderCancelled with the record status EXPIRED."

