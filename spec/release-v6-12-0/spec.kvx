[capability.7.3.2]
title = "Topic hub with snapshot, dense sequence and resume from JetStream"
reqs = ["7012.14", "7012.15", "7012.16", "7012.17", "7012.18", "7012.19"]
touches = ["platform/perps-data/internal/ws/hub.go", "platform/perps-data/internal/ws/hub_test.go"]
tests = ["platform/perps-data/internal/ws/hub_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/internal/ws/ -run 'TestHub'"
do_1 = "Add Hub keyed by topic, with one topicState per topic holding the per-process snapshotId, the dense seq of the topic and the last applied Perps-Seq; seq increases by exactly 1 per delta (Hyperpax:data_api.md:72-82) (contracts/data-services.md section 4)."
do_2 = "Subscribe sends subscribed, then exactly one frame with snapshot true carrying the seq of the last broadcast at build time, then every delta with a greater seq; the application guard accepts this order and drops nothing (Hyperpax:src/core/net/realtime.ts:29-47) (contracts/data-services.md section 4)."
do_3 = "The hub consumes PERPS_V1 through natsdriver.NewConsumer with an ordered ephemeral consumer per gateway process (Launch-x:shared/delivery/natsdriver/driver.go:93); on start or after a consumer reset it resumes from the JetStream sequence recorded with the last applied message (Launch-x:shared/delivery/natsdriver/driver.go:238), so no message between snapshot and live stream is skipped (contracts/data-services.md section 4)."
do_4 = "A perps.<chain>.chain.rewind message makes every affected topic rebuild its snapshot and send it with snapshot true and the next seq; a gap the hub cannot fill closes the socket with 1013 so the client resyncs through REST (Hyperpax:src/core/net/realtime.ts:42) (contracts/data-services.md section 4)."
do_5 = "A Provider per topic family (book, trade, stats, market, totals, chain) builds the snapshot from Postgres and maps messages to deltas; frames whose data is older than 60 seconds are never sent and the topic sends a fresh snapshot instead, because the client closes on them (Hyperpax:src/core/net/realtime.ts:68, the 60000 ms stale bound) (contracts/data-services.md section 4)."
do_6 = "Add TestHub with subtests snapshot_then_deltas, dense_seq, resume_from_stream_seq, rewind_resnapshot, gap_closes_1013 and stale_frame_dropped against an in-process nats-server and PERPS_DATA_TEST_DATABASE_URL (contracts/data-services.md section 4)."

