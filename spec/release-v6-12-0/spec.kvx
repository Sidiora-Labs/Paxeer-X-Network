requires = ["1.0.1", "1.0.2", "1.3.99", "2.3.99", "3.3.99", "4.3.99", "5.3.99", "6.3.99", "7.3.99", "9.5.99", "8.4.1", "8.4.2", "8.4.3", "8.4.4", "8.4.5", "8.4.6", "8.4.7", "8.4.8", "8.4.9", "8.4.10", "8.4.11", "8.4.12", "8.4.13", "8.4.14", "8.4.15", "8.4.16", "8.4.17", "8.4.18", "8.4.19", "8.4.20", "8.5.1", "8.5.2", "8.5.3", "8.5.4", "8.5.5", "8.5.6", "8.5.7", "8.5.8", "8.5.9", "8.5.10", "8.5.11", "8.5.12", "8.5.13"]
reqs = ["8013.3", "8013.4", "8009.5", "8012.3", "8.1", "8.2"]
capabilities = ["8.5.2"]
do_1 = "Write tools/release/rollout/v6.12.0/completion.json with tag paxeer-network/v6.12.0, plan v6.12.0 and release_sha256 of SHA256SUMS (tools/release/build-paxd.sh:70)."
do_2 = "Write tools/release/tests/completion-check.sh with every_task_done, reading spec/release-v6-12-0/spec.kvx and requiring status done for every task other than 8.5.99, completion_receipt_matches_release and rollback_rehearsed, after one run of tools/release/tests/run-all.sh."
do_3 = "Run tools/release/tests/completion-check.sh once."
do_4 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["completion.json", "completion-check.sh", "every_task_done", "completion_receipt_matches_release", "rollback_rehearsed"]
touches = ["tools/release/rollout/v6.12.0/completion.json", "tools/release/tests/completion-check.sh", "tools/release/tests/run-all.sh"]
build_cmd = "bash -n tools/release/tests/completion-check.sh"
verify_cmd = "bash tools/release/tests/completion-check.sh"
gate_kind = "planned"
planned_paths = ["tools/release/rollout/v6.12.0/completion.json", "tools/release/tests/completion-check.sh"]
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark complete without the declared evidence."
path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to their current equivalents before the gate can run; historical references never authorize a duplicate implementation tree. Complete scoped path reconciliation without dropping acceptance criteria."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."
[feature.9]
name = "resolutions"
scope = "The normative resolutions of release v6.12.0: one resolution per decision of the head and per cross-feature rule the domain features rely on (USDL as the existing ERC20 with PAX and SID through native pointers, the shared market ids, the 0x1015 version switch on the explicit live flag, the MidBlock price aggregate and the end-block order, venue logs on synthetic receipts and their decoding, the perpetuals-only 14-day fee volume, the spot address set, the feed key registry, operator inputs, the precompile-only venue and venue custody at the module EVM addresses), the shared contract index and address table, and the conformance check that binds each resolution to existing tasks and runs their gates."
requirements = ["9001"]
completion_task = "9.5.99"

[req.9001]
title = "Every decision of this programme is recorded and normative"
ac_1 = "decision 1 is applied by resolution 9.1, 9.2, 9.3, 9.4 and referenced by tasks 1.0.3, 1.0.4, 1.2.1, 1.2.3, 1.0.5, 8.4.1, 8.4.5, 8.4.14, 1.0.1."
ac_2 = "decision 2 is applied by resolution 9.5, 9.6, 9.7 and referenced by tasks 2.0.1, 2.0.2, 2.0.3, 2.0.4, 2.0.5, 2.2.1, 2.2.2, 2.2.3, 2.2.4, 2.2.5, 2.2.6, 2.2.7, 2.3.6, 2.3.9, 2.2.14, 2.2.15, 2.2.16, 2.2.17, 2.2.18, 1.0.3, 1.3.100, 1.2.4, 8.4.10, 8.4.12, 8.4.13, 8.5.11."
ac_3 = "decision 3 is applied by resolution 9.8, 9.9, 9.10 and referenced by tasks 2.1.2, 2.1.5, 2.1.6, 2.1.7, 2.2.3, 2.2.16, 2.1.1, 2.2.10, 2.2.17, 2.1.9, 2.2.7."
ac_4 = "decision 4 is applied by resolution 9.11, 9.12, 9.13, 9.14, 9.15, 9.16, 9.17, 9.18 and referenced by tasks 3.0.4, 3.1.10, 3.2.6, 3.0.5, 3.1.4, 3.2.3, 3.1.7, 3.2.11, 6.2.17, 3.1.12, 3.2.9, 3.1.13, 3.1.14, 3.2.5, 3.1.15, 3.1.16, 8.4.10."
ac_5 = "decision 5 is applied by resolution 9.19, 9.20, 9.21, 9.22, 9.23 and referenced by tasks 5.2.4, 5.2.5, 5.2.6, 5.2.7, 5.0.3, 5.1.3, 5.1.10, 5.1.14, 5.1.15, 5.3.2, 5.1.7, 5.1.8, 5.3.1, 5.1.9, 3.1.11, 4.1.5, 5.1.12."
ac_6 = "decision 6 is applied by resolution 9.24, 9.25, 9.26 and referenced by tasks 4.0.1, 4.0.2, 4.0.3, 4.0.4, 4.0.5, 4.0.6, 6.0.3, 4.2.1, 4.2.2, 4.2.3, 4.2.4, 4.2.5, 4.2.6, 4.1.8, 4.1.9, 4.2.9."
ac_7 = "decision 7 is applied by resolution 9.27, 9.28, 9.29, 9.30 and referenced by tasks 7.2.1, 7.2.2, 7.2.3, 7.2.4, 7.2.5, 7.2.13, 7.2.14, 7.2.15, 7.2.16, 7.2.6, 7.2.7, 7.2.8, 7.2.9, 7.2.10, 7.2.19, 6.3.7, 7.2.11, 7.2.12, 7.3.1, 7.3.2."
ac_8 = "decision 8 is applied by resolution 9.31 and referenced by tasks 7.3.3, 7.3.4, 7.0.6."
ac_9 = "decision 9 is applied by resolution 9.32 and referenced by tasks 7.0.1, 7.0.2, 7.1.2, 7.1.3, 7.3.99."
ac_10 = "decision 10 is applied by resolution 9.33, 9.34, 9.35 and referenced by tasks 1.2.1, 1.3.100, 3.2.1, 3.0.8, 3.3.4, 3.2.13."
ac_11 = "decision 11 is applied by resolution 9.36, 9.37 and referenced by tasks 8.5.1, 8.4.15, 8.5.2, 8.5.3, 8.5.4, 8.5.5, 8.5.6, 8.5.7."
ac_12 = "The cross-feature rule of USDL as the existing ERC20 contract with no bank denom, no pointer and no minting, held as ERC20 balances at the venue module EVM addresses is applied by resolution 9.38, 9.39, 9.40, 9.41 and referenced by tasks 2.2.14, 2.2.16, 1.0.3, 4.1.14, 1.2.4, 3.1.20, 3.1.3, 3.2.3, 4.1.4, 6.2.4, 6.2.5, 6.2.6, 6.2.10."
ac_13 = "The cross-feature rule of PAX as uhpx and SID as the SID denom through the native pointers of task 1.2.4 is applied by resolution 9.42, 9.43 and referenced by tasks 4.1.4, 4.1.7, 4.1.14, 4.2.6, 1.2.4, 4.2.2, 6.2.10, 6.2.11."
ac_14 = "The cross-feature rule of pricefeed market ids 0-17 in the application's market order is applied by resolution 9.44, 9.45, 9.46, 9.47 and referenced by tasks 5.0.2, 5.1.11, 5.2.3, 3.0.5, 3.1.11, 3.2.11, 4.1.5, 4.1.14, 7.0.3, 7.1.2, 7.1.3."
ac_15 = "The cross-feature rule of the 0x1015 version switch on the explicit v6120Live flag with the unchanged v6.9 exchange below the upgrade height is applied by resolution 9.48 and referenced by tasks 1.2.1, 1.3.100, 3.0.8, 3.2.13, 3.3.4."
ac_16 = "The cross-feature rule of the MidBlock price aggregate followed by the end-block order oracle, perps, spot, EVM is applied by resolution 9.49, 9.50, 9.51 and referenced by tasks 1.3.103, 3.2.9, 4.2.9, 5.1.8, 5.1.13, 3.2.10, 4.1.14, 1.0.6, 1.0.3, 1.3.100, 2.2.17, 2.2.18, 3.2.11, 5.1.11, 1.2.4."
ac_17 = "The cross-feature rule of every venue state change as an EVM log decoded by the indexer is applied by resolution 9.52, 9.53 and referenced by tasks 3.2.8, 4.2.7, 5.2.1, 2.2.8, 2.3.1, 2.3.3, 7.1.2, 7.1.3, 7.1.4, 7.1.8, 3.3.3."
ac_18 = "The cross-feature rule that spot fees follow the PECOR per-trade tier model while the 14-day volume buckets belong to the perps keeper alone is applied by resolution 9.54, 9.55 and referenced by tasks 4.1.6, 4.1.13, 3.1.10."
ac_19 = "The cross-feature rule of the spot set at 0x1021-0x1025 with 0x1026 and 0x1027 not served is applied by resolution 9.56, 9.57 and referenced by tasks 1.2.1, 4.2.1, 6.0.1, 6.2.10, 4.1.11, 4.2.7, 7.1.3, 1.2.2, 1.3.100."
ac_20 = "The cross-feature rule of feed keys registered per validator with registerFeedKey is applied by resolution 9.58, 9.59 and referenced by tasks 5.1.5, 5.2.1, 5.2.2, 5.1.11, 5.3.1, 8.5.7."
ac_21 = "The cross-feature rule of operator inputs of the rollout as blank fields is applied by resolution 9.60 and referenced by tasks 8.5.1, 7.3.3, 5.2.7."
ac_22 = "The cross-feature rule of no Solidity venue contract deployed is applied by resolution 9.61, 9.62 and referenced by tasks 3.0.1, 5.0.1, 6.3.1, 6.3.3, 6.2.10, 6.2.12."
ac_23 = "The cross-feature rule of activation gating of the new addresses and stores at plan v6.12.0 is applied by resolution 9.63, 9.64, 9.65 and referenced by tasks 1.2.1, 1.2.2, 4.2.1, 5.2.3, 1.3.102, 3.2.12, 4.1.15, 5.1.13, 2.2.12, 2.2.13."
ac_24 = "The cross-feature rule of revert data per contract file, classified by the application is applied by resolution 9.66 and referenced by tasks 3.2.2, 4.2.8, 5.2.2, 6.2.9, 2.1.3, 2.2.9."
ac_25 = "The cross-feature rule of venue custody at the perps, spot and launchpad module accounts and their module EVM addresses is applied by resolution 9.67, 9.68 and referenced by tasks 3.0.4, 3.1.3, 3.1.19, 4.1.4, 4.3.2, 2.1.4, 2.2.16."
ac_26 = "The cross-feature rule of release work on the wired tree is applied by resolution 9.69 and referenced by tasks 1.3.100, 8.4.1, 8.4.2, 8.4.10, 1.3.99, 8.5.99."
ac_27 = "Resolution 9.1 holds: The plan table registers ActivationUpgrade, V610Upgrade, V6120Upgrade and MergeUpgrade: the V611Upgrade constant (node/upgrades.go:104-112), its handler registration (node/upgrades.go:204-206) and its entry in knownUpgradePlans (node/upgrades.go:532-534) are removed, and no store, tag line or test names v6.11 as a plan."
ac_28 = "Resolution 9.2 holds: runV6120Upgrade runs the module migrations, moveSidioraMintAuthority (node/upgrades_v611.go:115) and migrateSIDHolders (node/upgrades_v611.go:141) once, before the first hook of its hook table, so the mint authority of the SID denom layerxbridgetypes.SidioraDenom() (modules/layerxbridge/types/keys.go:53-59) and the legacy SID balances of the SID proxy (node/upgrades_v611.go:24-26) move at the v6.12.0 height."
ac_29 = "Resolution 9.3 holds: GovernanceActivationUpgrade (modules/layerxcustody/types/governance_activation.go:5) names v6.12.0, so the custody proposal executes from the v6.12.0 done height that the folded v6.11 change set used to gate."
ac_30 = "Resolution 9.4 holds: tools/release/version.json (tools/release/version.json:2-3) carries version v6.12.0 and upgrade v6.12.0; the release build, the upgrade-info document and the tag read that identity and none of them names v6.11."
ac_31 = "Resolution 9.5 holds: The launchpad precompile at 0x1017 (modules/launchpad/types/keys.go:26) presents the function, event and error set of the deployment generation whose manifest status is active (Launch-x:shared/config/deployment/current.json:7), with the same selectors, encodings and revert data."
ac_32 = "Resolution 9.6 holds: The launchpad hook MigrateV6120(ctx sdk.Context, k Keeper, evm EVMReader) error in modules/launchpad/keeper/migrate_v6120.go reads the pools of the first and the current deployment generation at the halt height, moves their USDL by ERC20 transfer to the launchpad module EVM address and writes them into keeper state as generation 2 pools; the baseline handler runs RunMigrations, moveSidioraMintAuthority and migrateSIDHolders, then the five hooks createV6120Pointers (task 1.2.4), MigrateV6120, pricefeed InitV6120, perps SeedV6120 and spot InitV6120, so MigrateV6120 is the first domain hook, and aborts the plan on its error."
ac_33 = "Resolution 9.7 holds: For every migrated pool, getReserves() (Launch-x:contracts/contracts/interfaces/ISidioraPool.sol:65-69) through the precompile at the first post-upgrade height returns virtualUsdl equal to the contract read at the halt height and realUsdl and tokenReserve equal to the smaller of the book value and the held amount, so they equal the halt-height read word for word wherever book and held agree and each difference is a book-held delta record of contracts/launchpad.md section 8; the rehearsal and the fleet check assert it."
ac_34 = "Resolution 9.8 holds: Pool creation, swaps and fee accrual move USDL, the existing ERC20 contract named by Params.QuoteToken in place of the denom field Params.QuoteDenom (modules/launchpad/types/params.go:17, value at modules/launchpad/types/params.go:31), in ERC20 units of six decimals read by balanceOf: inbound by transferFrom(user, launchpad module EVM address, amount) with msg.sender 0x1017 against the user's allowance to 0x1017, outbound by transfer from the launchpad module EVM address, as nested calls of the precompile run (precompiles/xweb/xweb.go:482) or through CallEVM (modules/evm/keeper/evm.go:81) in the upgrade handler; HeldQuote per pool, FeeHeld and TreasuryHeld are keeper ledgers over that one balance, and no code mints, burns or converts USDL."
ac_35 = "Resolution 9.9 holds: The optical hooks of the launchpad contracts (Launch-x:contracts/contracts/opticals/BaseOptical.sol:12, Launch-x:contracts/contracts/opticals/OpticalRegistry.sol:14) are called by the launchpad precompile through evm.Call at the points of the contract flow, against the committed outer state and under the per-pool re-entrancy lock that reverts ReentrancyGuardReentrantCall(); each migrated pool keeps its optical address and the optical contracts stay deployed and unchanged."
ac_36 = "Resolution 9.10 holds: Fee rights keep the ERC721 surface of SidioraNFT (Launch-x:contracts/contracts/core/SidioraNFT.sol:14) at the generation 2 collection, keyed by collection and id, with every generation 1 fee right minted again there and the old-to-new id map stored; pool tokens stay the deployed SidioraERC20 contracts with code and storage unchanged, so transfer, approval and balance calls and their logs come from the token contracts and are visible to the explorer."
ac_37 = "Resolution 9.11 holds: Taker and maker fees of the perpetuals venue are the tier rates of the account's 14-day volume, the sum of the daily buckets of the UTC days d-13 to d inclusive with d = floor(blockTime / 86400), as written in the parameter sheet; a taker fee rounds up to the USDL unit and a negative maker rate is a rebate paid from perps_fees, rounded down."
ac_38 = "Resolution 9.12 holds: Every account has one USDL cross-margin balance over all markets; initial and maintenance margin come from the per-market notional tier tables, and setMarginMode accepts only the cross mode."
ac_39 = "Resolution 9.13 holds: No order or position exceeds 1000x leverage; the maximum leverage of each of the eighteen markets is 1000x (contracts/perps-markets.md, market table), and the application's maxLeverage of every PERPS_MARKETS entry (Hyperpax:src/core/perps/config.ts:167-186) is set to 1000 to match."
ac_40 = "Resolution 9.14 holds: Premium samples are taken against the pricefeed index at least five seconds of block time apart, and funding settles once per hour of block time with the formula of the parameter sheet."
ac_41 = "Resolution 9.15 holds: The perpetuals venue charges no borrowing fee and keeps no borrowing index anywhere; funding (parameter sheet section 3) is the only carry, as on the Hyperliquid venue, and open interest is bounded by the per-side caps of parameter sheet section 4, under which an opening fill above the cap in force reverts PerpsOpenInterestCap()."
ac_42 = "Resolution 9.16 holds: An account whose equity is below its maintenance margin is liquidated against the book in slices, starting with partial closes, within the per-block bounds of the EndBlock pass."
ac_43 = "Resolution 9.17 holds: An account below two thirds of maintenance is taken over by the insurance fund perps_insurance; a deficit the fund cannot cover is closed by auto-deleveraging of ranked counterparties."
ac_44 = "Resolution 9.18 holds: SeedV6120(ctx sdk.Context, k Keeper) error in modules/perps/keeper/seed_v6120.go writes PAX, SID, NAS100, ETH, SPX500, BTC, BNB, SOL, HYPE, TSLA, GOOGL, XAU, NVDA, ASTER, LINK, XRP, TRUMP and AVAX with the market table and tier classes of contracts/perps-markets.md, and the fleet check reads all eighteen after the upgrade."
ac_45 = "Resolution 9.19 holds: The price-sidecar binary built from platform/hosted/feeder reads the Chainflow ticker of every listed market, accepts a ticker only when its symbol field equals the response symbol, and is installed per validator from tools/price-sidecar."
ac_46 = "Resolution 9.20 holds: The sidecar signs at most one MsgSubmitPrices per block with its feed key, encoded by the Cosmos transaction encoder of the feeder crate and decoded byte for byte by the Go side of the cross-language vector."
ac_47 = "Resolution 9.21 holds: Per enabled market in id order, the index is the two-pass median of fresh observations of the bonded set with required = max(min_sources, floor(bonded / 2) + 1), and the mark follows the smoothed-basis formula; below the required count the aggregate is not updated."
ac_48 = "Resolution 9.22 holds: GetPrice(ctx, marketId) returns a Fresh flag; the perpetuals and spot keepers refuse orders, fills and liquidations on a market while Fresh is false."
ac_49 = "Resolution 9.23 holds: A MsgSubmitPrices from a registered feed account of a bonded validator pays no fee and passes the alone rule and the rate bound that CosmosCheckTxAnte and CosmosDeliverTxAnte apply on the function-based CheckTx and DeliverTx path (node/ante/cosmos_checktx.go:62-121, node/ante/cosmos_delivertx.go:16-74) through keeper functions of the pricefeed module; any other submission is refused there."
ac_50 = "Resolution 9.24 holds: Every selector, event topic and error selector served by the spot precompile set equals the PECOR ABI the Hyperpax application encodes (Hyperpax:src/core/network/spot_abi/PECOR.ts:5); the golden fixtures freeze it."
ac_51 = "Resolution 9.25 holds: Pools, vault shares, order records, active lists and fee accruals are keeper records of modules/spot; the feasibility record maps every PECOR method to a keeper path, replaces the relayer price oracle with modules/pricefeed GetPrice and the transaction tracker with the EVM logs of every state change."
ac_52 = "Resolution 9.26 holds: Limit, stop-limit and stop-loss orders execute in the spot EndBlocker against the pricefeed index price; the execute and batch methods stay callable and apply the same rule inside a transaction."
ac_53 = "Resolution 9.27 holds: perps-gateway serves the symbol, markets, venue and spot user REST routes and the shared WebSocket with snapshot, dense sequence and resume from JetStream, in the data protocol the Hyperpax application already speaks; it streams the venue's own perpetual and spot fills and book and serves account-scoped state and history, while chart candles, prices and book snapshots of the application stay on Chainflow and the gateway mounts no candle route."
ac_54 = "Resolution 9.28 holds: The GraphQL endpoint answers every query, mutation and subscription of the application's operation set unchanged, and the application pins that set against the gateway contract."
ac_55 = "Resolution 9.29 holds: perps-explorer serves per-account and per-market trading history from the fact tables and attaches to each row the transaction link built from PERPS_EXPLORER_TX_BASE."
ac_56 = "Resolution 9.30 holds: perps-portal renders the markets, account, leaderboard and venue statistics pages server-side from the gateway."
ac_57 = "Resolution 9.31 holds: The project perps-data declares perps-indexer, perps-gateway, perps-explorer, perps-portal, perps-replay, its own Postgres and a three-node NATS JetStream cluster; variables are named only, and only the gateway, explorer and portal have a public domain."
ac_58 = "Resolution 9.32 holds: The indexer, replay tool, gateway, explorer and portal are packages of the root module under platform/perps-data, and the decoders load the ABIs that precompiles/perps, precompiles/spot and precompiles/pricefeed export, so an ABI change and its decoder change land in one commit."
ac_59 = "Resolution 9.33 holds: From the v6.12.0 upgrade height a call to 0x1015 (modules/layerxexchange/types/ids.go:15) executes precompiles/perps; the address keeps its activation entry (node/upgrades.go:496) and is switched by exchangeVersionSwitch(perps, legacy, perpsLive) of task 1.2.1 in the shape of precompiles/p256/setup.go:15-24."
ac_60 = "Resolution 9.34 holds: The legacy value of exchangeVersionSwitch is the unchanged v6.9 exchange constructor precompiles/layerxexchange NewPrecompile (precompiles/layerxexchange/layerxexchange.go:140), so heights below the v6.12.0 upgrade height keep the v6.9 behaviour byte for byte and recorded v6.9 calls replay on it with identical return data and logs."
ac_61 = "Resolution 9.35 holds: GetCustomPrecompilesVersions (modules/evm/keeper/keeper.go:356-385) resolves a traced or replayed height below the v6.12.0 upgrade height to the legacy v6.9 exchange through the versioned map keyed {LatestUpgrade, ActivationUpgrade, V6120Upgrade}; precompiles/layerxexchange/setup.go gets no GetVersioned entry and precompiles/layerxexchange/versions is unchanged."
ac_62 = "Resolution 9.36 holds: Halt height, upgrade height, maintenance window, public notice text, build host and release id appear in docs/rollout-runbook.md as table rows without values; a release test refuses a public copy with any of them filled."
ac_63 = "Resolution 9.37 holds: Every rollout step takes its heights and hosts from the env file named on its command line (--env-file .env.rollout-v6120) and writes receipts with counts only under tools/release/rollout/v6.12.0."
ac_64 = "Resolution 9.38 holds: USDL is the existing ERC20 contract 0x85FcD13735F4309833A503EE804ea32395851479 with six decimals (contracts/libraries/Constants.sol:14-16): it has no bank denom and no native pointer, getNativePointer of 0x100A (precompiles/pointerview/pointerview.go:18) never returns its address, and no v6.12.0 code mints, burns, converts or records a shortfall of it; its code, storage, allowances and permit nonces stay the contract's."
ac_65 = "Resolution 9.39 holds: A token argument of 0x1015 must equal Params.CollateralToken, the USDL ERC20 address; any other address reverts PerpsUnsupportedCollateral() before a token move. Deposits pull by transferFrom(caller, perps module EVM address, amount) in a nested evm.Call with msg.sender 0x1015 against the caller's allowance to 0x1015, and withdrawals and payouts are transfer calls from the perps module EVM address, nested inside a transaction and through CallEVM (modules/evm/keeper/evm.go:81) outside one."
ac_66 = "Resolution 9.40 holds: The spot venue registers USDL as its stable token with kind ERC20 at price 1e18 and the pinned six decimals; ERC20 inputs are pulled by transferFrom(caller, spot module EVM address, amount) from the rail that pulls (0x1021, 0x1022, 0x1023 or 0x1025) against the caller's allowance to that rail, credited by the balanceOf delta, and paid out by transfer from the spot module EVM address."
ac_67 = "Resolution 9.41 holds: The perpetuals collateral entry (Hyperpax:src/core/perps/config.ts:75-79) and the spot USDL entry name the one USDL address of contracts/libraries/Constants.sol:14 with six decimals, every collateral amount is parsed at six decimals, and the allowance planner requests exactly the amount of the call from the precompile address that pulls it."
ac_68 = "Resolution 9.42 holds: The PAX token argument is the ERC20 native pointer of the base denom uhpx (modules/evm/keeper/params.go:22) and the SID token argument is the native pointer of the SID denom layerxbridgetypes.SidioraDenom() (modules/layerxbridge/types/keys.go:53-59), both created with their bank metadata by task 1.2.4; a token argument resolves to its denom through GetNativePointee (modules/evm/keeper/pointer.go:444), decimals come from denom metadata, and both move by bank transfer with no allowance."
ac_69 = "Resolution 9.43 holds: No wrapped PAX exists: native value attached to a spot call moves value / 1e12 uhpx, WETH() returns the uhpx pointer, and the application sells PAX from the native balance without a wrap step."
ac_70 = "Resolution 9.44 holds: Market id k of modules/pricefeed is the marketId k the Hyperpax application lists (Hyperpax:src/core/perps/config.ts:168-185): 0 BTC, 1 ETH, 2 SOL, 3 AVAX, 4 LINK, 5 TSLA, 6 NVDA, 7 NAS100, 8 XAU, 9 SPX500, 10 GOOGL, 11 PAX, 12 SID, 13 HYPE, 14 XRP, 15 ASTER, 16 TRUMP, 17 BNB; ids are dense and never reused."
ac_71 = "Resolution 9.45 holds: Perpetual market k reads GetPrice(ctx, k) of the same symbol; the eighteen seeded markets carry the ids of the pricefeed table."
ac_72 = "Resolution 9.46 holds: The spot keeper prices uhpx from pricefeed market 11 and the SID denom from market 12, and spot InitV6120 registers them with those ids."
ac_73 = "Resolution 9.47 holds: The indexer subjects, fact rows and gateway routes key a market by the pricefeed market id, so a perpetual fill, a mark update and an oracle aggregate of one symbol share one key."
ac_74 = "Resolution 9.48 holds: A call to 0x1015 below the v6.12.0 upgrade height executes the unchanged v6.9 exchange of precompiles/layerxexchange and from it precompiles/perps; perpsLive reads the explicit v6120Live flag that the v6.12.0 handler sets when it switches the set live and that a restarted node restores from state, as the xweb switch does (node/upgrades.go:216-236, node/upgrades.go:276-282); no node/tags line is added and the handler never reads GetDoneHeight."
ac_75 = "Resolution 9.49 holds: The pricefeed aggregates in MidBlock after the block's transactions (SetOrderMidBlockers(oracle, pricefeed) at node/app.go:1043-1045; MidBlock runs at node/app.go:2227, before EndBlock) and returns without work while its store holds no params; EndBlock then runs oracle.EndBlocker, the perps EndBlocker, the spot EndBlocker and EvmKeeper.EndBlock in that order (node/legacyabci/end_block.go:22-28), the two venue steps only while V6120Live() is true, so the venues read the prices of the same block and their logs land before the EVM end block builds the bloom."
ac_76 = "Resolution 9.50 holds: Logs emitted by the perps and spot EndBlock passes and the spot activation are written as one synthetic receipt per pass with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36), each log converted by ConvertSyntheticEthLog (modules/evm/keeper/log.go:109-113); the tx hash is keccak256 of perps-endblock, spot-endblock or v6120-activation followed by the 8-byte big-endian height, the TransactionIndex is N, N + 1 and N + 2 with N the number of transactions of the block, and task 1.0.6 serves them through eth_getLogs, pax_getLogs, eth_getBlockReceipts, eth_getTransactionReceipt and the block bloom."
ac_77 = "Resolution 9.51 holds: runV6120Upgrade runs RunMigrations, moveSidioraMintAuthority and migrateSIDHolders, then createV6120Pointers (task 1.2.4), MigrateV6120, pricefeed InitV6120, SeedV6120 and spot InitV6120 in that order, then sets the v6120Live flag; it refuses the plan when any hook is unbound and wraps each hook error as upgrade v6.12.0: <hook>: <error>."
ac_78 = "Resolution 9.52 holds: Each state change of the launchpad, perpetuals and spot precompiles and each feed key change at 0x1020, in a transaction or in EndBlock, emits the EVM log whose signature its contract file lists, from the address that owns the state; the pricefeed aggregate of each block is the Cosmos block event pricefeed_aggregate, or pricefeed_aggregate_skipped, of contracts/pricefeed.md."
ac_79 = "Resolution 9.53 holds: The indexer decodes every log of 0x1015, 0x1017, 0x1020, the spot set and the vault share pointers, the USDL Transfer logs whose from or to is the perps or spot module EVM address, and the pricefeed_aggregate block events read through block_results, into the fact tables in one transaction per block; positions, orders and accounts are reconstructed from those events, the only state read being the eth_call at the event height that resolves the token of a spot order event."
ac_80 = "Resolution 9.54 holds: The fee in bps of one spot trade is the rail base (swapFeeBps at 0x1021, orderFeeBps at 0x1022 and 0x1023) plus the rail's tier-1 fee (tier1FeeBps on the swap rail, orderTier1FeeBps on the order rails) from 10,000e18 USD of that trade and its tier-2 fee on top from 100,000e18, per trade with no rolling volume (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:743-747); fees and impact accrue to feeCollector."
ac_81 = "Resolution 9.55 holds: Only the perps keeper writes and reads the perpetuals volume buckets keyed by the UTC day d = floor(blockTime / 86400); the 14-day volume on day d is the sum of the buckets of days d-13 to d inclusive, so a fill counts toward the account's next order on the same day; the spot keeper keeps no volume buckets and reads none."
ac_82 = "Resolution 9.56 holds: PECOR 0x1021, PECOROrders 0x1022, PECORStopOrders 0x1023, PECORQuoter 0x1024 and PECORVault 0x1025 are served from the v6.12.0 done height, and the application address module defaults to exactly these five addresses."
ac_83 = "Resolution 9.57 holds: 0x1026 (PECORVaultShare) and 0x1027 (PECORRouter) are in no activation entry and carry no code before or after activation, outside the giga fail-fast set; vault share Transfer and Approval logs come from the share pointer addresses returned by shareTokens(address), and the indexer decodes them by those addresses rather than by 0x1026."
ac_84 = "Resolution 9.58 holds: A bonded validator operator registers one 33-byte compressed secp256k1 key through registerFeedKey(bytes) at 0x1020; a key replaces the previous one, a feed account belongs to one validator, and only keys of bonded validators count."
ac_85 = "Resolution 9.59 holds: InitV6120 registers no feed key; after activation each operator associates its operator EVM address, registers a key with registerFeedKey and starts the sidecar, and the rollout oracle phase checks one registered key per validator and a fresh price on every market."
ac_86 = "Resolution 9.60 holds: Deployment and install files of this release carry variable names and empty host fields only: the runbook input rows, the data-services Railway layout and the sidecar config template name inputs without values."
ac_87 = "Resolution 9.61 holds: The .sol files of precompiles/perps and precompiles/pricefeed are interface declarations that generate abi.json; the release deploys no venue contract, and the application drops the Diamond address (Hyperpax:src/core/perps/config.ts:10-11) and the per-user vault hook."
ac_88 = "Resolution 9.62 holds: The spot contract table of the application (Hyperpax:src/core/spot/addresses.ts:31-59) points PECOR, Quoter, Orders, StopOrders and Vault at the precompile set and removes the PriceOracle and TransactionTracker entries (Hyperpax:src/core/spot/addresses.ts:52-59); the application makes no oracle call."
ac_89 = "Resolution 9.63 holds: 0x1020 to 0x1025 sit under v6120PrecompileGate of task 1.2.1 through SetCustomPrecompileActivation (modules/evm/keeper/keeper.go:207-241) and answer as accounts without code below the v6.12.0 upgrade height; 0x1026 and 0x1027 carry no code at any height; the giga executor hands 0x1015, 0x1017 and 0x1020-0x1025 to the ordinary path through gigaV6120FailFast, built from AllCustomPrecompilesFailFastLate (engine/executor/precompiles/failfast.go:128) with 0x1020-0x1025 mapped to FailFastSingleton (engine/executor/precompiles/failfast.go:101)."
ac_90 = "Resolution 9.64 holds: The v6.12.0 store upgrades add the perps, spot and pricefeed store keys beside activationStoreUpgrades (node/upgrades.go:398-402), and each module registers with consensus version 1."
ac_91 = "Resolution 9.65 holds: 0x1017 stays behind activationPrecompileGate (node/upgrades.go:498); GetVersioned of precompiles/launchpad (precompiles/launchpad/setup.go:10-14) returns the new precompile under the key v6.12.0 and the current one under v6.10 from precompiles/launchpad/legacy/v610, in the shape of precompiles/p256/setup.go:15-24, and the v6.12.0 handler switches the set live explicitly with no node/tags entry."
ac_92 = "Resolution 9.66 holds: Perpetuals, spot and launchpad reverts carry the typed custom error data of their ABIs (contracts/perps.md section 19, contracts/spot.md Revert encoding, contracts/launchpad.md section 12); pricefeed reverts carry Error(string) whose text starts with the LXP code, the xweb convention (precompiles/xweb/xweb.go:288-310); the application decodes the custom errors with decodeErrorResult over the perps and spot ABIs before its string rules (Hyperpax:src/core/errors/classify.ts:239-266)."
ac_93 = "Resolution 9.67 holds: The perps module EVM address holds every USDL of the perpetuals venue as its USDL ERC20 balance, including the balances behind perps_fees and perps_insurance; the spot module account holds uhpx and the SID denom as bank balances and its module EVM address holds USDL and every registered ERC20 as ERC20 balances, with book reserves, escrows, vault pools and fee accruals kept as keeper records over those balances."
ac_94 = "Resolution 9.68 holds: The launchpad module account (modules/launchpad/keeper/keeper.go:40, modules/launchpad/types/keys.go:10) stays out of maccPerms with no Minter (node/app.go:296-299); step 1 of MigrateV6120 moves the USDL of every pool and FeeAccumulator to the launchpad module EVM address by ERC20 transfer through CallEVM from the holding address, pool tokens stay at the pool addresses, and launchpad_treasury (modules/launchpad/types/keys.go:14) stays as it is."
ac_95 = "Resolution 9.69 holds: The baseline wiring task 1.3.100 requires the domain completion tasks 2.3.99, 3.3.99, 4.3.99 and 5.3.99; the release build requires the wiring task; and the release completion task 8.5.99 requires 1.0.1, 1.0.2, 1.3.99, every other domain completion task, the conformance task 9.5.99 and every release task, so the release candidate is built from a tree where every domain package set passed once and the release closes only when every task of every feature is done."
ac_96 = "Every applies_to id of every [resolution.9.k] names a task or capability that exists in the assembled spec/release-v6-12-0/spec.kvx; tools/spec/check_resolutions.py prints each unresolved id as resolution.<id>: unknown <ref> and exits 1."
ac_97 = "Every [decision.N] of the head (decision.1 to decision.11) is named by the source \"decision DN\" of at least one resolution, and every resolution applies to at least one task id (a capability alone does not satisfy it)."
ac_98 = "contracts/address-table.md lists every precompile address of the resolutions (0x1015, 0x1017, 0x1020 to 0x1027) with its constructor and activation rule, and contracts/README.md lists every contract file under parts/contracts with its reading order."

[contract_context.9.address_table]
launchpad = "0x0000000000000000000000000000000000001017 is the launchpad precompile (modules/launchpad/types/keys.go:26), registered in the versioned set (precompiles/setup.go:183) and activated with module launchpad under ActivationUpgrade v6.9 (node/upgrades.go:93, node/upgrades.go:498); from the v6.12.0 upgrade height it serves the generation 2 precompile of precompiles/launchpad NewPrecompile and below it the current precompile (precompiles/launchpad/launchpad.go:180) kept under precompiles/launchpad/legacy/v610, selected by launchpadVersionSwitch on the same live flag."
perps = "0x0000000000000000000000000000000000001015 (modules/layerxexchange/types/ids.go:15) keeps its activation entry with module layerxexchange (node/upgrades.go:496); from the v6.12.0 upgrade height it is served by precompiles/perps NewPrecompile and below it by the unchanged v6.9 exchange constructor precompiles/layerxexchange NewPrecompile (precompiles/layerxexchange/layerxexchange.go:140), selected by exchangeVersionSwitch on the explicit v6120Live flag."
pricefeed = "0x0000000000000000000000000000000000001020 is served by precompiles/pricefeed NewPrecompile with module pricefeed behind v6120PrecompileGate; it has no code below the v6.12.0 upgrade height."
spot = "0x0000000000000000000000000000000000001021 to 0x0000000000000000000000000000000000001025 are served by the entries of precompiles/spot NewPrecompileSet with module spot behind v6120PrecompileGate; 0x1026 and 0x1027 are in no activation entry and carry no code at any height."
activation = "Every new address is gated in the shape of activationPrecompileGate (node/upgrades.go:489-503) through SetCustomPrecompileActivation (modules/evm/keeper/keeper.go:207-241); the versioned set is resolved per height by GetCustomPrecompilesVersions (modules/evm/keeper/keeper.go:356-385)."
module_accounts = "Every module account is authtypes.NewModuleAddress(name) and its module EVM address is the address GetEVMAddressOrDefault (modules/evm/keeper/address.go:41) returns for it. The launchpad module account (modules/launchpad/keeper/keeper.go:40, modules/launchpad/types/keys.go:10) gains no permission and holds the launchpad USDL as the ERC20 balance of its module EVM address, beside launchpad_treasury (modules/launchpad/types/keys.go:14); the perps module adds perps, perps_fees and perps_insurance with no permission, the USDL of the venue being the ERC20 balance of the perps module EVM address; the spot module adds spot with Minter and Burner limited by the keeper to spot/share/* denoms and an entry in allowedReceivingModAcc."
tokens = "USDL is the existing ERC20 contract of contracts/libraries/Constants.sol:14 with six decimals, with no bank denom and no pointer; uhpx is the base denom (modules/evm/keeper/params.go:22) and the SID denom is layerxbridgetypes.SidioraDenom() (modules/layerxbridge/types/keys.go:53-59), which receives the legacy SID balances of the SID proxy (node/upgrades_v611.go:24-26); task 1.2.4 creates the uhpx and SID native pointers, read with GetERC20NativePointer (precompiles/utils/expected_keepers.go:127) and resolved back with GetNativePointee (modules/evm/keeper/pointer.go:444)."

[contract_context.9.conformance]
clause_check = "The repository spec linter already refuses a resolution whose applies_to names an unknown clause (tools/specgen/validate.go:117-125, clauseExists at tools/specgen/validate.go:132); the release check resolves applies_to against task and capability ids, which that clause lookup does not."
parser = "The check reads the kvx with the section, key and list rules of tools/specgen/kvx.go (ParseFile at tools/specgen/kvx.go:36, List at tools/specgen/kvx.go:137, SectionsWithPrefix at tools/specgen/kvx.go:204)."
shape = "A resolution carries title, contract, applies_to and source, the shape of the resolutions of spec/layerx-merge/spec.kvx."
source = "A source is either decision DN, naming [decision.N] of the head, or contract <file>#<heading>, naming a heading of a file under contracts/ or docs/ of the feature."

[resolution.9.1]
title = "Plan v6.11 leaves the plan table"
contract = "The plan table registers ActivationUpgrade, V610Upgrade, V6120Upgrade and MergeUpgrade: the V611Upgrade constant (node/upgrades.go:104-112), its handler registration (node/upgrades.go:204-206) and its entry in knownUpgradePlans (node/upgrades.go:532-534) are removed, and no store, tag line or test names v6.11 as a plan."
applies_to = ["1.0.3", "1.0.4", "1.2.1"]
source = "decision D1"

[resolution.9.2]
title = "The v6.12.0 handler carries every change of v6.11"
contract = "runV6120Upgrade runs the module migrations, moveSidioraMintAuthority (node/upgrades_v611.go:115) and migrateSIDHolders (node/upgrades_v611.go:141) once, before the first hook of its hook table, so the mint authority of the SID denom layerxbridgetypes.SidioraDenom() (modules/layerxbridge/types/keys.go:53-59) and the legacy SID balances of the SID proxy (node/upgrades_v611.go:24-26) move at the v6.12.0 height."
applies_to = ["1.0.3", "1.0.4", "1.2.3"]
source = "decision D1"

[resolution.9.3]
title = "The custody governance gate moves to v6.12.0"
contract = "GovernanceActivationUpgrade (modules/layerxcustody/types/governance_activation.go:5) names v6.12.0, so the custody proposal executes from the v6.12.0 done height that the folded v6.11 change set used to gate."
applies_to = ["1.0.5"]
source = "decision D1"

[resolution.9.4]
title = "Release identity is v6.12.0"
contract = "tools/release/version.json (tools/release/version.json:2-3) carries version v6.12.0 and upgrade v6.12.0; the release build, the upgrade-info document and the tag read that identity and none of them names v6.11."
applies_to = ["8.4.1", "8.4.5", "8.4.14", "1.0.1"]
source = "decision D1"

[resolution.9.5]
title = "The launchpad precompile serves the manifest-active generation"
contract = "The launchpad precompile at 0x1017 (modules/launchpad/types/keys.go:26) presents the function, event and error set of the deployment generation whose manifest status is active (Launch-x:shared/config/deployment/current.json:7), with the same selectors, encodings and revert data."
applies_to = ["2.0.1", "2.0.2", "2.0.3", "2.0.4", "2.0.5", "2.2.1", "2.2.2", "2.2.3", "2.2.4", "2.2.5", "2.2.6", "2.2.7", "2.3.6", "2.3.9"]
source = "decision D2"

[resolution.9.6]
title = "Both deployment generations migrate into the precompile"
contract = "The launchpad hook MigrateV6120(ctx sdk.Context, k Keeper, evm EVMReader) error in modules/launchpad/keeper/migrate_v6120.go reads the pools of the first and the current deployment generation at the halt height, moves their USDL by ERC20 transfer to the launchpad module EVM address and writes them into keeper state as generation 2 pools; the baseline handler runs RunMigrations, moveSidioraMintAuthority and migrateSIDHolders, then the five hooks createV6120Pointers (task 1.2.4), MigrateV6120, pricefeed InitV6120, perps SeedV6120 and spot InitV6120, so MigrateV6120 is the first domain hook, and aborts the plan on its error."
applies_to = ["2.2.14", "2.2.15", "2.2.16", "2.2.17", "2.2.18", "1.0.3", "1.3.100", "1.2.4"]
source = "decision D2"

[resolution.9.7]
title = "Migrated pools read the same through 0x1017"
contract = "For every migrated pool, getReserves() (Launch-x:contracts/contracts/interfaces/ISidioraPool.sol:65-69) through the precompile at the first post-upgrade height returns virtualUsdl equal to the contract read at the halt height and realUsdl and tokenReserve equal to the smaller of the book value and the held amount, so they equal the halt-height read word for word wherever book and held agree and each difference is a book-held delta record of contracts/launchpad.md section 8; the rehearsal and the fleet check assert it."
applies_to = ["8.4.10", "8.4.12", "8.4.13", "8.5.11", "2.2.15", "2.2.18"]
source = "decision D2"

[resolution.9.8]
title = "Launchpad quotes in USDL ERC20 units at its module EVM address"
contract = "Pool creation, swaps and fee accrual move USDL, the existing ERC20 contract named by Params.QuoteToken in place of the denom field Params.QuoteDenom (modules/launchpad/types/params.go:17, value at modules/launchpad/types/params.go:31), in ERC20 units of six decimals read by balanceOf: inbound by transferFrom(user, launchpad module EVM address, amount) with msg.sender 0x1017 against the user's allowance to 0x1017, outbound by transfer from the launchpad module EVM address, as nested calls of the precompile run (precompiles/xweb/xweb.go:482) or through CallEVM (modules/evm/keeper/evm.go:81) in the upgrade handler; HeldQuote per pool, FeeHeld and TreasuryHeld are keeper ledgers over that one balance, and no code mints, burns or converts USDL."
applies_to = ["2.1.2", "2.1.5", "2.1.6", "2.1.7", "2.2.3", "2.2.16"]
source = "decision D3"

[resolution.9.9]
title = "The hook system ships with the release"
contract = "The optical hooks of the launchpad contracts (Launch-x:contracts/contracts/opticals/BaseOptical.sol:12, Launch-x:contracts/contracts/opticals/OpticalRegistry.sol:14) are called by the launchpad precompile through evm.Call at the points of the contract flow, against the committed outer state and under the per-pool re-entrancy lock that reverts ReentrancyGuardReentrantCall(); each migrated pool keeps its optical address and the optical contracts stay deployed and unchanged."
applies_to = ["2.1.1", "2.2.10", "2.2.17"]
source = "decision D3"

[resolution.9.10]
title = "Fee rights are ERC721 at the generation 2 collection and pool tokens stay ERC20 contracts"
contract = "Fee rights keep the ERC721 surface of SidioraNFT (Launch-x:contracts/contracts/core/SidioraNFT.sol:14) at the generation 2 collection, keyed by collection and id, with every generation 1 fee right minted again there and the old-to-new id map stored; pool tokens stay the deployed SidioraERC20 contracts with code and storage unchanged, so transfer, approval and balance calls and their logs come from the token contracts and are visible to the explorer."
applies_to = ["2.1.9", "2.2.7", "2.2.17"]
source = "decision D3"

[resolution.9.11]
title = "Trading fees follow the volume tier table"
contract = "Taker and maker fees of the perpetuals venue are the tier rates of the account's 14-day volume, the sum of the daily buckets of the UTC days d-13 to d inclusive with d = floor(blockTime / 86400), as written in the parameter sheet; a taker fee rounds up to the USDL unit and a negative maker rate is a rebate paid from perps_fees, rounded down."
applies_to = ["3.0.4", "3.1.10", "3.2.6"]
source = "contract contracts/perps-parameters.md#1-trading-fees"

[resolution.9.12]
title = "Margin is cross with tiered maintenance"
contract = "Every account has one USDL cross-margin balance over all markets; initial and maintenance margin come from the per-market notional tier tables, and setMarginMode accepts only the cross mode."
applies_to = ["3.0.5", "3.1.4", "3.2.3"]
source = "contract contracts/perps-parameters.md#2-margin"

[resolution.9.13]
title = "Leverage is capped at 1000x on every market"
contract = "No order or position exceeds 1000x leverage; the maximum leverage of each of the eighteen markets is 1000x (contracts/perps-markets.md, market table), and the application's maxLeverage of every PERPS_MARKETS entry (Hyperpax:src/core/perps/config.ts:167-186) is set to 1000 to match."
applies_to = ["3.0.5", "3.1.7", "3.2.11", "6.2.17"]
source = "contract contracts/perps-parameters.md#9-consequences-of-the-1000x-cap"

[resolution.9.14]
title = "Funding settles every hour from the premium"
contract = "Premium samples are taken against the pricefeed index at least five seconds of block time apart, and funding settles once per hour of block time with the formula of the parameter sheet."
applies_to = ["3.1.12", "3.2.9"]
source = "contract contracts/perps-parameters.md#3-funding"

[resolution.9.15]
title = "No borrowing fee: funding is the only carry"
contract = "The perpetuals venue charges no borrowing fee and keeps no borrowing index anywhere; funding (parameter sheet section 3) is the only carry, as on the Hyperliquid venue, and open interest is bounded by the per-side caps of parameter sheet section 4, under which an opening fill above the cap in force reverts PerpsOpenInterestCap()."
applies_to = ["3.1.13", "3.2.9"]
source = "contract contracts/perps-parameters.md#4-open-interest-caps"

[resolution.9.16]
title = "Liquidation is account-level with partial close"
contract = "An account whose equity is below its maintenance margin is liquidated against the book in slices, starting with partial closes, within the per-block bounds of the EndBlock pass."
applies_to = ["3.1.14", "3.2.5", "3.2.9"]
source = "contract contracts/perps-parameters.md#6-liquidation"

[resolution.9.17]
title = "Backstop, insurance and auto-deleveraging"
contract = "An account below two thirds of maintenance is taken over by the insurance fund perps_insurance; a deficit the fund cannot cover is closed by auto-deleveraging of ranked counterparties."
applies_to = ["3.1.15", "3.1.16"]
source = "contract contracts/perps-parameters.md#7-insurance-fund-and-auto-deleveraging"

[resolution.9.18]
title = "Eighteen markets open at activation"
contract = "SeedV6120(ctx sdk.Context, k Keeper) error in modules/perps/keeper/seed_v6120.go writes PAX, SID, NAS100, ETH, SPX500, BTC, BNB, SOL, HYPE, TSLA, GOOGL, XAU, NVDA, ASTER, LINK, XRP, TRUMP and AVAX with the market table and tier classes of contracts/perps-markets.md, and the fleet check reads all eighteen after the upgrade."
applies_to = ["3.0.5", "3.2.11", "8.4.10"]
source = "decision D4"

[resolution.9.19]
title = "Each validator runs a sidecar on the Chainflow feed"
contract = "The price-sidecar binary built from platform/hosted/feeder reads the Chainflow ticker of every listed market, accepts a ticker only when its symbol field equals the response symbol, and is installed per validator from tools/price-sidecar."
applies_to = ["5.2.4", "5.2.5", "5.2.6", "5.2.7"]
source = "decision D5"

[resolution.9.20]
title = "One signed submission per validator per block"
contract = "The sidecar signs at most one MsgSubmitPrices per block with its feed key, encoded by the Cosmos transaction encoder of the feeder crate and decoded byte for byte by the Go side of the cross-language vector."
applies_to = ["5.0.3", "5.1.3", "5.1.10", "5.1.14", "5.1.15", "5.3.2"]
source = "decision D5"

[resolution.9.21]
title = "The chain aggregates per block over the bonded set"
contract = "Per enabled market in id order, the index is the two-pass median of fresh observations of the bonded set with required = max(min_sources, floor(bonded / 2) + 1), and the mark follows the smoothed-basis formula; below the required count the aggregate is not updated."
applies_to = ["5.1.7", "5.1.8", "5.3.1"]
source = "decision D5"

[resolution.9.22]
title = "Venues refuse trading on a stale price"
contract = "GetPrice(ctx, marketId) returns a Fresh flag; the perpetuals and spot keepers refuse orders, fills and liquidations on a market while Fresh is false."
applies_to = ["5.1.9", "3.1.11", "4.1.5"]
source = "decision D5"

[resolution.9.23]
title = "Price submissions pay no fee and are bounded"
contract = "A MsgSubmitPrices from a registered feed account of a bonded validator pays no fee and passes the alone rule and the rate bound that CosmosCheckTxAnte and CosmosDeliverTxAnte apply on the function-based CheckTx and DeliverTx path (node/ante/cosmos_checktx.go:62-121, node/ante/cosmos_delivertx.go:16-74) through keeper functions of the pricefeed module; any other submission is refused there."
applies_to = ["5.1.12"]
source = "decision D5"

[resolution.9.24]
title = "The spot ABI equals the application ABI"
contract = "Every selector, event topic and error selector served by the spot precompile set equals the PECOR ABI the Hyperpax application encodes (Hyperpax:src/core/network/spot_abi/PECOR.ts:5); the golden fixtures freeze it."
applies_to = ["4.0.1", "4.0.2", "4.0.3", "4.0.4", "4.0.5", "4.0.6", "6.0.3"]
source = "decision D6"

[resolution.9.25]
title = "PECOR state lives in the spot keeper"
contract = "Pools, vault shares, order records, active lists and fee accruals are keeper records of modules/spot; the feasibility record maps every PECOR method to a keeper path, replaces the relayer price oracle with modules/pricefeed GetPrice and the transaction tracker with the EVM logs of every state change."
applies_to = ["4.2.1", "4.2.2", "4.2.3", "4.2.4", "4.2.5", "4.2.6"]
source = "decision D6"

[resolution.9.26]
title = "Resting spot orders execute in EndBlock"
contract = "Limit, stop-limit and stop-loss orders execute in the spot EndBlocker against the pricefeed index price; the execute and batch methods stay callable and apply the same rule inside a transaction."
applies_to = ["4.1.8", "4.1.9", "4.2.9"]
source = "contract contracts/spot.md#endblock-execution"

[resolution.9.27]
title = "The gateway serves REST and the shared WebSocket"
contract = "perps-gateway serves the symbol, markets, venue and spot user REST routes and the shared WebSocket with snapshot, dense sequence and resume from JetStream, in the data protocol the Hyperpax application already speaks; it streams the venue's own perpetual and spot fills and book and serves account-scoped state and history, while chart candles, prices and book snapshots of the application stay on Chainflow and the gateway mounts no candle route."
applies_to = ["7.2.1", "7.2.2", "7.2.3", "7.2.4", "7.2.5", "7.2.13", "7.2.14", "7.2.15", "7.2.16"]
source = "decision D7"

[resolution.9.28]
title = "GraphQL serves the full operation set"
contract = "The GraphQL endpoint answers every query, mutation and subscription of the application's operation set unchanged, and the application pins that set against the gateway contract."
applies_to = ["7.2.6", "7.2.7", "7.2.8", "7.2.9", "7.2.10", "7.2.19", "6.3.7"]
source = "decision D7"

[resolution.9.29]
title = "The chain explorer service links each row to the network explorer"
contract = "perps-explorer serves per-account and per-market trading history from the fact tables and attaches to each row the transaction link built from PERPS_EXPLORER_TX_BASE."
applies_to = ["7.2.11", "7.2.12"]
source = "decision D7"

[resolution.9.30]
title = "The portal renders markets, accounts and venue statistics"
contract = "perps-portal renders the markets, account, leaderboard and venue statistics pages server-side from the gateway."
applies_to = ["7.3.1", "7.3.2"]
source = "decision D7"

[resolution.9.31]
title = "A dedicated Railway project hosts the data services"
contract = "The project perps-data declares perps-indexer, perps-gateway, perps-explorer, perps-portal, perps-replay, its own Postgres and a three-node NATS JetStream cluster; variables are named only, and only the gateway, explorer and portal have a public domain."
applies_to = ["7.3.3", "7.3.4", "7.0.6"]
source = "decision D8"

[resolution.9.32]
title = "The data services live under platform/perps-data"
contract = "The indexer, replay tool, gateway, explorer and portal are packages of the root module under platform/perps-data, and the decoders load the ABIs that precompiles/perps, precompiles/spot and precompiles/pricefeed export, so an ABI change and its decoder change land in one commit."
applies_to = ["7.0.1", "7.0.2", "7.1.2", "7.1.3", "7.3.99"]
source = "decision D9"

[resolution.9.33]
title = "The perpetuals precompile serves 0x1015 from the done height"
contract = "From the v6.12.0 upgrade height a call to 0x1015 (modules/layerxexchange/types/ids.go:15) executes precompiles/perps; the address keeps its activation entry (node/upgrades.go:496) and is switched by exchangeVersionSwitch(perps, legacy, perpsLive) of task 1.2.1 in the shape of precompiles/p256/setup.go:15-24."
applies_to = ["1.2.1", "1.3.100", "3.2.1"]
source = "decision D10"

[resolution.9.34]
title = "The v6.9 exchange stays unchanged as the legacy value"
contract = "The legacy value of exchangeVersionSwitch is the unchanged v6.9 exchange constructor precompiles/layerxexchange NewPrecompile (precompiles/layerxexchange/layerxexchange.go:140), so heights below the v6.12.0 upgrade height keep the v6.9 behaviour byte for byte and recorded v6.9 calls replay on it with identical return data and logs."
applies_to = ["3.0.8", "3.3.4"]
source = "decision D10"

[resolution.9.35]
title = "Historical heights select the version by height"
contract = "GetCustomPrecompilesVersions (modules/evm/keeper/keeper.go:356-385) resolves a traced or replayed height below the v6.12.0 upgrade height to the legacy v6.9 exchange through the versioned map keyed {LatestUpgrade, ActivationUpgrade, V6120Upgrade}; precompiles/layerxexchange/setup.go gets no GetVersioned entry and precompiles/layerxexchange/versions is unchanged."
applies_to = ["3.2.13", "1.2.1"]
source = "decision D10"

[resolution.9.36]
title = "Operator inputs are blank fields in the public runbook"
contract = "Halt height, upgrade height, maintenance window, public notice text, build host and release id appear in docs/rollout-runbook.md as table rows without values; a release test refuses a public copy with any of them filled."
applies_to = ["8.5.1", "8.4.15"]
source = "decision D11"

[resolution.9.37]
title = "Rollout commands read inputs from an untracked env file"
contract = "Every rollout step takes its heights and hosts from the env file named on its command line (--env-file .env.rollout-v6120) and writes receipts with counts only under tools/release/rollout/v6.12.0."
applies_to = ["8.5.2", "8.5.3", "8.5.4", "8.5.5", "8.5.6", "8.5.7"]
source = "decision D11"

[resolution.9.38]
title = "USDL stays the existing ERC20 contract"
contract = "USDL is the existing ERC20 contract 0x85FcD13735F4309833A503EE804ea32395851479 with six decimals (contracts/libraries/Constants.sol:14-16): it has no bank denom and no native pointer, getNativePointer of 0x100A (precompiles/pointerview/pointerview.go:18) never returns its address, and no v6.12.0 code mints, burns, converts or records a shortfall of it; its code, storage, allowances and permit nonces stay the contract's."
applies_to = ["2.2.14", "2.2.16", "1.0.3", "4.1.14", "1.2.4"]
source = "contract contracts/spot.md#token-model"

[resolution.9.39]
title = "Perpetuals collateral is only the USDL ERC20"
contract = "A token argument of 0x1015 must equal Params.CollateralToken, the USDL ERC20 address; any other address reverts PerpsUnsupportedCollateral() before a token move. Deposits pull by transferFrom(caller, perps module EVM address, amount) in a nested evm.Call with msg.sender 0x1015 against the caller's allowance to 0x1015, and withdrawals and payouts are transfer calls from the perps module EVM address, nested inside a transaction and through CallEVM (modules/evm/keeper/evm.go:81) outside one."
applies_to = ["3.1.20", "3.1.3", "3.2.3"]
source = "contract contracts/perps.md#2-units-and-encodings"

[resolution.9.40]
title = "The spot stable token is the USDL ERC20"
contract = "The spot venue registers USDL as its stable token with kind ERC20 at price 1e18 and the pinned six decimals; ERC20 inputs are pulled by transferFrom(caller, spot module EVM address, amount) from the rail that pulls (0x1021, 0x1022, 0x1023 or 0x1025) against the caller's allowance to that rail, credited by the balanceOf delta, and paid out by transfer from the spot module EVM address."
applies_to = ["4.1.4", "4.1.14"]
source = "contract contracts/spot.md#token-model"

[resolution.9.41]
title = "The application uses one six-decimal USDL"
contract = "The perpetuals collateral entry (Hyperpax:src/core/perps/config.ts:75-79) and the spot USDL entry name the one USDL address of contracts/libraries/Constants.sol:14 with six decimals, every collateral amount is parsed at six decimals, and the allowance planner requests exactly the amount of the call from the precompile address that pulls it."
applies_to = ["6.2.4", "6.2.5", "6.2.6", "6.2.10"]
source = "contract contracts/application.md#amounts"

[resolution.9.42]
title = "PAX is uhpx and SID is the SID denom through native pointers"
contract = "The PAX token argument is the ERC20 native pointer of the base denom uhpx (modules/evm/keeper/params.go:22) and the SID token argument is the native pointer of the SID denom layerxbridgetypes.SidioraDenom() (modules/layerxbridge/types/keys.go:53-59), both created with their bank metadata by task 1.2.4; a token argument resolves to its denom through GetNativePointee (modules/evm/keeper/pointer.go:444), decimals come from denom metadata, and both move by bank transfer with no allowance."
applies_to = ["4.1.4", "4.1.7", "4.1.14", "4.2.6", "1.2.4"]
source = "contract contracts/spot.md#token-model"

[resolution.9.43]
title = "Native PAX and the PAX token are one balance"
contract = "No wrapped PAX exists: native value attached to a spot call moves value / 1e12 uhpx, WETH() returns the uhpx pointer, and the application sells PAX from the native balance without a wrap step."
applies_to = ["4.1.7", "4.2.2", "6.2.10", "6.2.11"]
source = "contract contracts/spot.md#token-model"

[resolution.9.44]
title = "Pricefeed market ids 0-17 follow the application's order"
contract = "Market id k of modules/pricefeed is the marketId k the Hyperpax application lists (Hyperpax:src/core/perps/config.ts:168-185): 0 BTC, 1 ETH, 2 SOL, 3 AVAX, 4 LINK, 5 TSLA, 6 NVDA, 7 NAS100, 8 XAU, 9 SPX500, 10 GOOGL, 11 PAX, 12 SID, 13 HYPE, 14 XRP, 15 ASTER, 16 TRUMP, 17 BNB; ids are dense and never reused."
applies_to = ["5.0.2", "5.1.11", "5.2.3"]
source = "contract contracts/pricefeed.md#markets-and-chainflow-symbols"

[resolution.9.45]
title = "Perpetual market ids equal pricefeed market ids"
contract = "Perpetual market k reads GetPrice(ctx, k) of the same symbol; the eighteen seeded markets carry the ids of the pricefeed table."
applies_to = ["3.0.5", "3.1.11", "3.2.11"]
source = "contract contracts/perps-markets.md#2-market-table"

[resolution.9.46]
title = "Spot prices PAX from market 11 and SID from market 12"
contract = "The spot keeper prices uhpx from pricefeed market 11 and the SID denom from market 12, and spot InitV6120 registers them with those ids."
applies_to = ["4.1.5", "4.1.14"]
source = "contract contracts/spot.md#token-model"

[resolution.9.47]
title = "Data services key market rows by the same id"
contract = "The indexer subjects, fact rows and gateway routes key a market by the pricefeed market id, so a perpetual fill, a mark update and an oracle aggregate of one symbol share one key."
applies_to = ["7.0.3", "7.1.2", "7.1.3"]
source = "contract contracts/data-services.md#3-nats-jetstream-stream-and-subjects"

[resolution.9.48]
title = "0x1015 switches version on the explicit live flag"
contract = "A call to 0x1015 below the v6.12.0 upgrade height executes the unchanged v6.9 exchange of precompiles/layerxexchange and from it precompiles/perps; perpsLive reads the explicit v6120Live flag that the v6.12.0 handler sets when it switches the set live and that a restarted node restores from state, as the xweb switch does (node/upgrades.go:216-236, node/upgrades.go:276-282); no node/tags line is added and the handler never reads GetDoneHeight."
applies_to = ["1.2.1", "1.3.100", "3.0.8", "3.2.13", "3.3.4"]
source = "contract contracts/perps.md#22-activation-and-versioning"

[resolution.9.49]
title = "Prices aggregate in MidBlock; EndBlock runs oracle, perps, spot, EVM"
contract = "The pricefeed aggregates in MidBlock after the block's transactions (SetOrderMidBlockers(oracle, pricefeed) at node/app.go:1043-1045; MidBlock runs at node/app.go:2227, before EndBlock) and returns without work while its store holds no params; EndBlock then runs oracle.EndBlocker, the perps EndBlocker, the spot EndBlocker and EvmKeeper.EndBlock in that order (node/legacyabci/end_block.go:22-28), the two venue steps only while V6120Live() is true, so the venues read the prices of the same block and their logs land before the EVM end block builds the bloom."
applies_to = ["1.3.103", "3.2.9", "4.2.9", "5.1.8", "5.1.13"]
source = "contract contracts/perps.md#23-endblock"

[resolution.9.50]
title = "EndBlock logs land in a synthetic receipt"
contract = "Logs emitted by the perps and spot EndBlock passes and the spot activation are written as one synthetic receipt per pass with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36), each log converted by ConvertSyntheticEthLog (modules/evm/keeper/log.go:109-113); the tx hash is keccak256 of perps-endblock, spot-endblock or v6120-activation followed by the 8-byte big-endian height, the TransactionIndex is N, N + 1 and N + 2 with N the number of transactions of the block, and task 1.0.6 serves them through eth_getLogs, pax_getLogs, eth_getBlockReceipts, eth_getTransactionReceipt and the block bloom."
applies_to = ["3.2.10", "4.2.9", "4.1.14", "1.0.6"]
source = "contract contracts/perps.md#23-endblock"

[resolution.9.51]
title = "Upgrade hooks run pointers, launchpad, pricefeed, perps, spot"
contract = "runV6120Upgrade runs RunMigrations, moveSidioraMintAuthority and migrateSIDHolders, then createV6120Pointers (task 1.2.4), MigrateV6120, pricefeed InitV6120, SeedV6120 and spot InitV6120 in that order, then sets the v6120Live flag; it refuses the plan when any hook is unbound and wraps each hook error as upgrade v6.12.0: <hook>: <error>."
applies_to = ["1.0.3", "1.3.100", "2.2.17", "2.2.18", "3.2.11", "4.1.14", "5.1.11", "1.2.4"]
source = "contract contracts/spot.md#activation"

[resolution.9.52]
title = "Every venue state change emits an EVM log"
contract = "Each state change of the launchpad, perpetuals and spot precompiles and each feed key change at 0x1020, in a transaction or in EndBlock, emits the EVM log whose signature its contract file lists, from the address that owns the state; the pricefeed aggregate of each block is the Cosmos block event pricefeed_aggregate, or pricefeed_aggregate_skipped, of contracts/pricefeed.md."
applies_to = ["3.2.8", "4.2.7", "5.2.1", "2.2.8", "2.3.1", "2.3.3"]
source = "contract contracts/perps.md#18-events"

[resolution.9.53]
title = "The indexer rebuilds venue state from logs alone"
contract = "The indexer decodes every log of 0x1015, 0x1017, 0x1020, the spot set and the vault share pointers, the USDL Transfer logs whose from or to is the perps or spot module EVM address, and the pricefeed_aggregate block events read through block_results, into the fact tables in one transaction per block; positions, orders and accounts are reconstructed from those events, the only state read being the eth_call at the event height that resolves the token of a spot order event."
applies_to = ["7.1.2", "7.1.3", "7.1.4", "7.1.8", "3.3.3"]
source = "contract contracts/data-services.md#6-event-decoding"

[resolution.9.54]
title = "Spot fees follow the PECOR per-trade tier model"
contract = "The fee in bps of one spot trade is the rail base (swapFeeBps at 0x1021, orderFeeBps at 0x1022 and 0x1023) plus the rail's tier-1 fee (tier1FeeBps on the swap rail, orderTier1FeeBps on the order rails) from 10,000e18 USD of that trade and its tier-2 fee on top from 100,000e18, per trade with no rolling volume (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:743-747); fees and impact accrue to feeCollector."
applies_to = ["4.1.6", "4.1.13"]
source = "contract contracts/spot.md#fees"

[resolution.9.55]
title = "The 14-day volume buckets belong to the perps keeper alone"
contract = "Only the perps keeper writes and reads the perpetuals volume buckets keyed by the UTC day d = floor(blockTime / 86400); the 14-day volume on day d is the sum of the buckets of days d-13 to d inclusive, so a fill counts toward the account's next order on the same day; the spot keeper keeps no volume buckets and reads none."
applies_to = ["3.1.10", "4.1.6"]
source = "contract contracts/perps-parameters.md#1-trading-fees"

[resolution.9.56]
title = "The spot set serves 0x1021-0x1025"
contract = "PECOR 0x1021, PECOROrders 0x1022, PECORStopOrders 0x1023, PECORQuoter 0x1024 and PECORVault 0x1025 are served from the v6.12.0 done height, and the application address module defaults to exactly these five addresses."
applies_to = ["1.2.1", "4.2.1", "6.0.1", "6.2.10"]
source = "contract contracts/spot.md#address-set"

[resolution.9.57]
title = "0x1026 and 0x1027 are not served"
contract = "0x1026 (PECORVaultShare) and 0x1027 (PECORRouter) are in no activation entry and carry no code before or after activation, outside the giga fail-fast set; vault share Transfer and Approval logs come from the share pointer addresses returned by shareTokens(address), and the indexer decodes them by those addresses rather than by 0x1026."
applies_to = ["4.1.11", "4.2.7", "7.1.3", "1.2.2", "1.2.1", "1.3.100"]
source = "contract contracts/spot.md#address-set"

[resolution.9.58]
title = "Feed keys are registered per validator with registerFeedKey"
contract = "A bonded validator operator registers one 33-byte compressed secp256k1 key through registerFeedKey(bytes) at 0x1020; a key replaces the previous one, a feed account belongs to one validator, and only keys of bonded validators count."
applies_to = ["5.1.5", "5.2.1", "5.2.2"]
source = "contract contracts/pricefeed.md#feed-key-registry"

[resolution.9.59]
title = "Rollout registers a key per validator before prices count"
contract = "InitV6120 registers no feed key; after activation each operator associates its operator EVM address, registers a key with registerFeedKey and starts the sidecar, and the rollout oracle phase checks one registered key per validator and a fresh price on every market."
applies_to = ["5.1.11", "5.3.1", "8.5.7"]
source = "contract contracts/pricefeed.md#activation"

[resolution.9.60]
title = "Operator inputs stay blank in every public file"
contract = "Deployment and install files of this release carry variable names and empty host fields only: the runbook input rows, the data-services Railway layout and the sidecar config template name inputs without values."
applies_to = ["8.5.1", "7.3.3", "5.2.7"]
source = "contract contracts/release.md#rollout"

[resolution.9.61]
title = "No Solidity venue contract is deployed"
contract = "The .sol files of precompiles/perps and precompiles/pricefeed are interface declarations that generate abi.json; the release deploys no venue contract, and the application drops the Diamond address (Hyperpax:src/core/perps/config.ts:10-11) and the per-user vault hook."
applies_to = ["3.0.1", "5.0.1", "6.3.1", "6.3.3"]
source = "contract contracts/perps.md#25-divergences-from-the-hyperpax-diamond-interface"

[resolution.9.62]
title = "Spot contract addresses move to the precompiles"
contract = "The spot contract table of the application (Hyperpax:src/core/spot/addresses.ts:31-59) points PECOR, Quoter, Orders, StopOrders and Vault at the precompile set and removes the PriceOracle and TransactionTracker entries (Hyperpax:src/core/spot/addresses.ts:52-59); the application makes no oracle call."
applies_to = ["6.2.10", "6.2.12"]
source = "contract contracts/application.md#address-table"

[resolution.9.63]
title = "0x1020-0x1025 have no code before the upgrade height"
contract = "0x1020 to 0x1025 sit under v6120PrecompileGate of task 1.2.1 through SetCustomPrecompileActivation (modules/evm/keeper/keeper.go:207-241) and answer as accounts without code below the v6.12.0 upgrade height; 0x1026 and 0x1027 carry no code at any height; the giga executor hands 0x1015, 0x1017 and 0x1020-0x1025 to the ordinary path through gigaV6120FailFast, built from AllCustomPrecompilesFailFastLate (engine/executor/precompiles/failfast.go:128) with 0x1020-0x1025 mapped to FailFastSingleton (engine/executor/precompiles/failfast.go:101)."
applies_to = ["1.2.1", "1.2.2", "4.2.1", "5.2.3"]
source = "contract contracts/pricefeed.md#activation"

[resolution.9.64]
title = "Plan v6.12.0 adds the perps, spot and pricefeed stores"
contract = "The v6.12.0 store upgrades add the perps, spot and pricefeed store keys beside activationStoreUpgrades (node/upgrades.go:398-402), and each module registers with consensus version 1."
applies_to = ["1.3.102", "3.2.12", "4.1.15", "5.1.13"]
source = "contract contracts/release.md#build-and-plan"

[resolution.9.65]
title = "0x1017 keeps its gate and the current launchpad becomes legacy v6.10"
contract = "0x1017 stays behind activationPrecompileGate (node/upgrades.go:498); GetVersioned of precompiles/launchpad (precompiles/launchpad/setup.go:10-14) returns the new precompile under the key v6.12.0 and the current one under v6.10 from precompiles/launchpad/legacy/v610, in the shape of precompiles/p256/setup.go:15-24, and the v6.12.0 handler switches the set live explicitly with no node/tags entry."
applies_to = ["2.2.12", "2.2.13"]
source = "contract contracts/launchpad.md#16-activation"

[resolution.9.66]
title = "Revert data follows each contract file and the application classifies it"
contract = "Perpetuals, spot and launchpad reverts carry the typed custom error data of their ABIs (contracts/perps.md section 19, contracts/spot.md Revert encoding, contracts/launchpad.md section 12); pricefeed reverts carry Error(string) whose text starts with the LXP code, the xweb convention (precompiles/xweb/xweb.go:288-310); the application decodes the custom errors with decodeErrorResult over the perps and spot ABIs before its string rules (Hyperpax:src/core/errors/classify.ts:239-266)."
applies_to = ["3.2.2", "4.2.8", "5.2.2", "6.2.9", "2.1.3", "2.2.9"]
source = "contract contracts/application.md#errors"

[resolution.9.67]
title = "Module accounts hold all venue custody"
contract = "The perps module EVM address holds every USDL of the perpetuals venue as its USDL ERC20 balance, including the balances behind perps_fees and perps_insurance; the spot module account holds uhpx and the SID denom as bank balances and its module EVM address holds USDL and every registered ERC20 as ERC20 balances, with book reserves, escrows, vault pools and fee accruals kept as keeper records over those balances."
applies_to = ["3.0.4", "3.1.3", "3.1.19", "4.1.4", "4.3.2"]
source = "contract contracts/perps.md#20-storage"

[resolution.9.68]
title = "The launchpad module account gains no permission"
contract = "The launchpad module account (modules/launchpad/keeper/keeper.go:40, modules/launchpad/types/keys.go:10) stays out of maccPerms with no Minter (node/app.go:296-299); step 1 of MigrateV6120 moves the USDL of every pool and FeeAccumulator to the launchpad module EVM address by ERC20 transfer through CallEVM from the holding address, pool tokens stay at the pool addresses, and launchpad_treasury (modules/launchpad/types/keys.go:14) stays as it is."
applies_to = ["2.1.4", "2.2.16"]
source = "contract contracts/launchpad.md#5-quote-asset"

[resolution.9.69]
title = "Release work starts on the wired tree and closes on every task"
contract = "The baseline wiring task 1.3.100 requires the domain completion tasks 2.3.99, 3.3.99, 4.3.99 and 5.3.99; the release build requires the wiring task; and the release completion task 8.5.99 requires 1.0.1, 1.0.2, 1.3.99, every other domain completion task, the conformance task 9.5.99 and every release task, so the release candidate is built from a tree where every domain package set passed once and the release closes only when every task of every feature is done."
applies_to = ["1.3.100", "8.4.1", "8.4.2", "8.4.10", "1.3.99", "8.5.99"]
source = "contract contracts/release.md#build-and-plan"

