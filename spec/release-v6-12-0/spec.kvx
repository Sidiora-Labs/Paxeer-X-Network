ac_4 = "SimpleSwap (Hyperpax:src/core/network/spot_abi/PECOR.ts:995) from PECOR 0x1021 with the signature SimpleSwap(address user, address tokenIn, address tokenOut, uint256 amountIn, uint256 amountOut, uint256 executionPrice) decodes into perps.spot_swaps with kind simple_swap and every argument, plus one perps.protocol_events row."
ac_5 = "TieredFeeApplied (Hyperpax:src/core/network/spot_abi/PECOR.ts:1038) from PECOR 0x1021 with the signature TieredFeeApplied(address user, address tokenOut, uint256 volumeUSD, uint256 feeBps, uint256 feeAmount) decodes into perps.spot_fee_events with kind tiered_fee and every argument, plus one perps.protocol_events row."
ac_6 = "LimitOrderCancelled (Hyperpax:src/core/network/spot_abi/PECOROrders.ts:777) from PECOROrders 0x1022 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_order_events with kind limit_cancelled and every argument, plus one perps.protocol_events row."
ac_7 = "LimitOrderCreated (Hyperpax:src/core/network/spot_abi/PECOROrders.ts:790) from PECOROrders 0x1022 with the signature LimitOrderCreated(uint256 orderId, address user, uint8 orderType, uint256 amount, uint256 targetPrice) decodes into perps.spot_order_events with kind limit_created and every argument, plus one perps.protocol_events row."
ac_8 = "LimitOrderExecuted (Hyperpax:src/core/network/spot_abi/PECOROrders.ts:827) from PECOROrders 0x1022 with the signature LimitOrderExecuted(uint256 orderId, uint256 executionPrice) decodes into perps.spot_order_events with kind limit_executed and every argument, plus one perps.protocol_events row."
ac_9 = "LimitOrderExpired (Hyperpax:src/core/network/spot_abi/PECOROrders.ts:846) from PECOROrders 0x1022 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_order_events with kind limit_expired and every argument, plus one perps.protocol_events row."
ac_10 = "LimitOrderModified (Hyperpax:src/core/network/spot_abi/PECOROrders.ts:859) from PECOROrders 0x1022 with the signature LimitOrderModified(uint256 orderId, uint256 targetPrice, uint256 expiresAt) decodes into perps.spot_order_events with kind limit_modified and every argument, plus one perps.protocol_events row."
ac_11 = "StopLimitActivated (Hyperpax:src/core/network/spot_abi/PECORStopOrders.ts:1084) from PECORStopOrders 0x1023 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_order_events with kind stop_limit_activated and every argument, plus one perps.protocol_events row."
ac_12 = "StopLimitCancelled (Hyperpax:src/core/network/spot_abi/PECORStopOrders.ts:1103) from PECORStopOrders 0x1023 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_order_events with kind stop_limit_cancelled and every argument, plus one perps.protocol_events row."
ac_13 = "StopLimitExecuted (Hyperpax:src/core/network/spot_abi/PECORStopOrders.ts:1116) from PECORStopOrders 0x1023 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_order_events with kind stop_limit_executed and every argument, plus one perps.protocol_events row."
ac_14 = "StopLimitOrderCreated (Hyperpax:src/core/network/spot_abi/PECORStopOrders.ts:1135) from PECORStopOrders 0x1023 with the signature StopLimitOrderCreated(uint256 orderId, address user, uint8 orderType, uint256 amount, uint256 stopPrice, uint256 limitPrice) decodes into perps.spot_order_events with kind stop_limit_created and every argument, plus one perps.protocol_events row."
ac_15 = "StopLossOrderCancelled (Hyperpax:src/core/network/spot_abi/PECORStopOrders.ts:1178) from PECORStopOrders 0x1023 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_order_events with kind stop_loss_cancelled and every argument, plus one perps.protocol_events row."
ac_16 = "StopLossOrderCreated (Hyperpax:src/core/network/spot_abi/PECORStopOrders.ts:1191) from PECORStopOrders 0x1023 with the signature StopLossOrderCreated(uint256 orderId, address user, uint256 amount, uint256 triggerPrice) decodes into perps.spot_order_events with kind stop_loss_created and every argument, plus one perps.protocol_events row."
ac_17 = "StopLossOrderExecuted (Hyperpax:src/core/network/spot_abi/PECORStopOrders.ts:1222) from PECORStopOrders 0x1023 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_order_events with kind stop_loss_executed and every argument, plus one perps.protocol_events row."
ac_18 = "Deposit (Hyperpax:src/core/network/spot_abi/PECORVault.ts:802) from PECORVault 0x1025 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_vault_events with kind deposit and every argument, plus one perps.protocol_events row."
ac_19 = "LPWithdrawal (Hyperpax:src/core/network/spot_abi/PECORVault.ts:833) from PECORVault 0x1025 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_vault_events with kind lp_withdrawal and every argument, plus one perps.protocol_events row."
ac_20 = "NativeDeposit (Hyperpax:src/core/network/spot_abi/PECORVault.ts:864) from PECORVault 0x1025 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_vault_events with kind native_deposit and every argument, plus one perps.protocol_events row."
ac_21 = "NativeWithdrawal (Hyperpax:src/core/network/spot_abi/PECORVault.ts:889) from PECORVault 0x1025 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_vault_events with kind native_withdrawal and every argument, plus one perps.protocol_events row."
ac_22 = "ReservesSync (Hyperpax:src/core/network/spot_abi/PECORVault.ts:952) from PECORVault 0x1025 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_vault_events with kind reserves_sync and every argument, plus one perps.protocol_events row."
ac_23 = "ReservesUpdated (Hyperpax:src/core/network/spot_abi/PECORVault.ts:983) from PECORVault 0x1025 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_vault_events with kind reserves_updated and every argument, plus one perps.protocol_events row."
ac_24 = "ShareTokenCreated (Hyperpax:src/core/network/spot_abi/PECORVault.ts:1008) from PECORVault 0x1025 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_tokens with kind share_token_created and every argument, plus one perps.protocol_events row."
ac_25 = "TokenRegistered (Hyperpax:src/core/network/spot_abi/PECORVault.ts:1046) from PECORVault 0x1025 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_tokens with kind token_registered and every argument, plus one perps.protocol_events row."
ac_26 = "Withdrawal (Hyperpax:src/core/network/spot_abi/PECORVault.ts:1103) from PECORVault 0x1025 with the signature of the Events heading of contracts/spot.md decodes into perps.spot_vault_events with kind withdrawal and every argument, plus one perps.protocol_events row."
ac_27 = "Approval (Hyperpax:src/core/network/spot_abi/PECORVaultShare.ts:275) from a share pointer address that spot_tokens holds from ShareTokenCreated with the signature of the Events heading of contracts/spot.md decodes into perps.spot_share_transfers with kind approval and every argument, plus one perps.protocol_events row."
ac_28 = "Transfer (Hyperpax:src/core/network/spot_abi/PECORVaultShare.ts:319) from a share pointer address that spot_tokens holds from ShareTokenCreated with the signature of the Events heading of contracts/spot.md decodes into perps.spot_share_transfers with kind transfer and every argument, plus one perps.protocol_events row."
ac_29 = "A log from 0x1026 or 0x1027 is kept as raw_logs with decoded false, because neither address carries code (contracts/spot.md, Address set); no decoder exists for BestRouteSwap or MultiHopSwap of the Hyperpax PECORRouter ABI and spot_swaps has no best_route or multi_hop kind."
ac_30 = "A spot_share_transfers row carries the share pointer address as share_token and the registered token it was created for, resolved from the ShareTokenCreated row of spot_tokens; a Transfer or Approval log from an address that no spot_tokens row names is kept as raw_logs with decoded false."
ac_31 = "PriceUpdated (Hyperpax:src/core/network/abi/OracleFacet.json:82) from the oracle address 0x1020 with the signature PriceUpdated(uint256 indexed marketId, uint256 price, uint256 timestamp) decodes into perps.oracle_prices with kind price."
ac_32 = "PricesUpdated (Hyperpax:src/core/network/abi/OracleFacet.json:107) from the oracle address 0x1020 with the signature PricesUpdated(uint256[] marketIds, uint256[] prices, uint256 timestamp) decodes into perps.oracle_prices with kind batch."
ac_33 = "MaxPriceStalenessUpdated (Hyperpax:src/core/network/abi/OracleFacet.json:18) from the oracle address 0x1020 with the signature of the oracle Events heading decodes into perps.market_events with kind staleness_updated."
ac_34 = "PECORQuoter 0x1024 is view-only; a log from it is kept as raw_logs with decoded false (contracts/data-services.md:429)."
ac_35 = "A PricesUpdated whose arrays differ in length is refused and kept with failure_class length_mismatch (contracts/data-services.md:429)."

[req.7006]
title = "Writers commit each block once and keep projections consistent with the facts"
ac_1 = "A block written twice leaves one row per log: inserts use ON CONFLICT (tx_hash, log_index) DO NOTHING (contracts/data-services.md:26)."
ac_2 = "Each fact row and its outbox message commit in the same transaction (Launch-x:shared/delivery/store.go:137)."
ac_3 = "Only the holder of the writer lease writes (Launch-x:core/indexer/internal/store/canonical.go:257)."
ac_4 = "The cursor advances to the written block in the same transaction (contracts/data-services.md:420)."
ac_5 = "Every decoded row also lands in protocol_events and every venue transaction in tx_actions with its explorer action (contracts/data-services.md:775)."
ac_6 = "positions_current follows PositionOpened, PositionModified, PositionEntryPriceChanged, PositionClosed and Liquidation (Hyperpax:src/core/network/abi/PositionFacet.json:387, Hyperpax:src/core/network/abi/PositionFacet.json:227)."
ac_7 = "orders moves through active, filled, cancelled, expired and failed, the status values the application filters on (Hyperpax:src/hooks/perps/useSubgraph.ts:110, Hyperpax:src/hooks/perps/useSubgraph.ts:195)."
ac_8 = "account_margin folds deposits, withdrawals, locks, releases, transfers and the margin mode per account and token (contracts/data-services.md:815)."
ac_9 = "user_stats and market_stats_rolling fold settlements, fees, funding and liquidations over rolling 24 hour, 7 day and 30 day windows (contracts/data-services.md:588)."
ac_10 = "oi_snapshots and market_snapshots per market and one protocol_snapshots row are written at each UTC hour boundary crossed by a block time (contracts/data-services.md:815)."

[req.7007]
title = "Every row change is published once on JetStream with a monotonic sequence"
ac_1 = "PERPS_V1 uses file storage, three replicas, 72 hour max age, discard new and deny delete and purge (Launch-x:deploy/production/topology/README.md:28)."
ac_2 = "Market subjects are perps.<chain>.<market>.<kind> for fill, order, funding, oracle, liq, mark, oi and market, each token matching Launch-x:shared/delivery/natsdriver/driver.go:17."
ac_3 = "User subjects are perps.<chain>.user.<account>.<kind> for position, order, fill, margin, funding and ledger with the account in lower-case hex (contracts/data-services.md:386)."
ac_4 = "Chain subjects are perps.<chain>.chain.block, .tx and .rewind (contracts/data-services.md:386)."
ac_5 = "Spot subjects are perps.<chain>.spot.<token>.<kind> for swap, order and vault (contracts/data-services.md:386)."
ac_6 = "Topic filters are checked with ValidSubjectFilter and matched with SubjectMatches (Launch-x:shared/delivery/stream.go:257, Launch-x:shared/delivery/stream.go:274)."
ac_7 = "EnsureStream refuses to start when the live stream configuration differs from stream.Config (contracts/data-services.md:386)."
ac_8 = "EnsureStream creates PERPS_V1 when it does not exist (contracts/data-services.md:386)."
ac_9 = "A message republished with the same event id inside the duplicate window is acknowledged without a second entry (Launch-x:shared/delivery/natsdriver/driver.go:45)."
ac_10 = "Perps-Seq and the JetStream stream sequence are strictly increasing in block, transaction and log order (Launch-x:shared/delivery/store.go:205)."
ac_11 = "An envelope above 1 MiB is refused before publishing (Launch-x:shared/delivery/envelope.go:17)."
ac_12 = "A rewind message is published on perps.<chain>.chain.rewind before any message of the rewritten heights (contracts/data-services.md:412)."

[req.7008]
title = "The replay tool rewrites a height range from the node without duplicates"
ac_1 = "A replay request names from and to heights and is validated before any write (Launch-x:core/indexer/internal/store/replay.go:47)."
ac_2 = "A from height above the indexer cursor is refused (contracts/data-services.md:522)."
ac_3 = "Replay deletes facts and projections in the range and rewrites them from the node, yielding rows identical to the first index (Launch-x:core/indexer/internal/processor/replay.go:151)."
ac_4 = "--dry-run reports the row counts that would change and writes nothing (contracts/data-services.md:522)."
ac_5 = "Replay holds the writer lease for its duration so the indexer pauses (Launch-x:core/indexer/internal/store/canonical.go:257)."
ac_6 = "Replayed messages reuse the first event ids, so the stream and the consumer inbox deduplicate them (Launch-x:shared/delivery/schema.sql:35)."

[req.7009]
title = "Candles aggregate every interval of the application and back the UDF datafeed"
ac_1 = "Interval 1m (Hyperpax:data_api.md:290) has a bucket of 60 seconds and is a valid kline topic suffix and candle interval."
ac_2 = "Interval 2m (Hyperpax:data_api.md:290) has a bucket of 120 seconds and is a valid kline topic suffix and candle interval."
ac_3 = "Interval 3m (Hyperpax:data_api.md:290) has a bucket of 180 seconds and is a valid kline topic suffix and candle interval."
ac_4 = "Interval 5m (Hyperpax:data_api.md:290) has a bucket of 300 seconds and is a valid kline topic suffix and candle interval."
ac_5 = "Interval 15m (Hyperpax:data_api.md:290) has a bucket of 900 seconds and is a valid kline topic suffix and candle interval."
ac_6 = "Interval 30m (Hyperpax:data_api.md:290) has a bucket of 1800 seconds and is a valid kline topic suffix and candle interval."
ac_7 = "Interval 1h (Hyperpax:data_api.md:290) has a bucket of 3600 seconds and is a valid kline topic suffix and candle interval."
ac_8 = "Interval 4h (Hyperpax:data_api.md:290) has a bucket of 14400 seconds and is a valid kline topic suffix and candle interval."
ac_9 = "Interval 8h (Hyperpax:data_api.md:290) has a bucket of 28800 seconds and is a valid kline topic suffix and candle interval."
ac_10 = "Interval 1D (Hyperpax:data_api.md:290) has a bucket of 86400 seconds and is a valid kline topic suffix and candle interval."
ac_11 = "Interval 1W (Hyperpax:data_api.md:290) has a bucket of 604800 seconds and is a valid kline topic suffix and candle interval."
ac_12 = "Weekly and daily buckets align as BucketStart aligns them (Launch-x:core/trading-charts/internal/engine/exact.go:208)."
ac_13 = "Fold computes open, high, low, close, volume and trade count exactly (Launch-x:core/trading-charts/internal/engine/exact.go:243)."
ac_14 = "A candle closes when a fill or a block time lands in a later bucket (Hyperpax:data_api.md:337-339)."
ac_15 = "The mark series is built from MarkPriceChanged and kept apart from the trade series (contracts/data-services.md:606)."
ac_16 = "History fills empty buckets with the previous close and zero volume (Launch-x:core/trading-charts/internal/engine/series.go:95)."
ac_17 = "GET /api/<symbol>/config implements the UDF config endpoint (Hyperpax:data_api.md:199)."
ac_18 = "GET /api/<symbol>/time implements the UDF time endpoint (Hyperpax:data_api.md:200)."
ac_19 = "GET /api/<symbol>/symbols implements the UDF symbols endpoint (Hyperpax:data_api.md:201)."
ac_20 = "GET /api/<symbol>/search implements the UDF search endpoint (Hyperpax:data_api.md:202)."
ac_21 = "GET /api/<symbol>/history implements the UDF history endpoint (Hyperpax:data_api.md:203)."
ac_22 = "GET /api/<symbol>/quotes implements the UDF quotes endpoint (Hyperpax:data_api.md:208)."
ac_23 = "UDF resolution 1 maps to the 1m candle interval (Hyperpax:data_api.md:204-205)."
ac_24 = "UDF resolution 2 maps to the 2m candle interval (Hyperpax:data_api.md:204-205)."
ac_25 = "UDF resolution 3 maps to the 3m candle interval (Hyperpax:data_api.md:204-205)."
ac_26 = "UDF resolution 5 maps to the 5m candle interval (Hyperpax:data_api.md:204-205)."
ac_27 = "UDF resolution 15 maps to the 15m candle interval (Hyperpax:data_api.md:204-205)."
ac_28 = "UDF resolution 30 maps to the 30m candle interval (Hyperpax:data_api.md:204-205)."
ac_29 = "UDF resolution 60 maps to the 1h candle interval (Hyperpax:data_api.md:204-205)."
ac_30 = "UDF resolution 240 maps to the 4h candle interval (Hyperpax:data_api.md:204-205)."
ac_31 = "UDF resolution 480 maps to the 8h candle interval (Hyperpax:data_api.md:204-205)."
ac_32 = "UDF resolution D maps to the 1D candle interval (Hyperpax:data_api.md:204-205)."
ac_33 = "UDF resolution W maps to the 1W candle interval (Hyperpax:data_api.md:204-205)."
ac_34 = "History answers s no_data for a range without candles and s error with errmsg for an unknown resolution (contracts/data-services.md:606)."
ac_35 = "GET /api/<symbol>/marks, allowed by the candle proxy of the application (Hyperpax:src/pages/api/candle/[...path].ts:31-40), answers [] because the venue has no chart marks (contracts/data-services.md:606)."
ac_36 = "GET /api/<symbol>/timescale_marks, allowed by the candle proxy of the application (Hyperpax:src/pages/api/candle/[...path].ts:31-40), answers [] because the venue has no chart marks (contracts/data-services.md:606)."
ac_37 = "The chart feed paths /api/<symbol>/config, /symbols and /history with the symbol query (Hyperpax:src/core/feeds.ts:8-14) are answered by the gateway, so the chart reads venue candles."

[req.7010]
title = "Symbol REST routes and symbol WebSocket topics follow the application data protocol"
ac_1 = "GET /api/<symbol>/price answers symbol, price, timestamp, open, high, low (Hyperpax:data_api.md:103)."
ac_2 = "GET /api/<symbol>/stats answers symbol, volume_24h, open_interest, est_funding_rate, last_funding_rate (Hyperpax:data_api.md:118)."
ac_3 = "GET /api/<symbol>/perp_stats answers the /stats fields plus mark_price, index_price, basis_bps, long_short_ratio, liq_volume_24h (Hyperpax:data_api.md:132)."
ac_4 = "GET /api/<symbol>/trades/<symbol> answers symbol, count and trades with id, side, price, size, trade_time newest first (Hyperpax:data_api.md:151)."
ac_5 = "GET /api/<symbol>/perp_trades/<symbol> answers symbol, count and trades with id, side, price, contracts, notional, liquidation, trade_time (Hyperpax:data_api.md:166)."
ac_6 = "GET /api/<symbol>/health answers status, backfill, lastCandle, symbol (Hyperpax:data_api.md:188)."
ac_7 = "limit on the trade routes is clamped to [1, 1000] with default 100 (Hyperpax:data_api.md:154)."
ac_8 = "An unknown symbol answers 404 with the error Unknown symbol, the symbol set being Hyperpax:src/core/feeds.ts:4."
ac_9 = "Topic <SYMBOL>@orderbook delivers asks ascending and bids descending, up to 100 levels per side, each level [price, size] (Hyperpax:data_api.md:214)."
ac_10 = "Topic <SYMBOL>@trade delivers one frame per spot trade; the subscribe snapshot carries the most recent 100 trades newest first (Hyperpax:data_api.md:234)."
ac_11 = "Topic <SYMBOL>@stats delivers the /stats fields every 30 seconds and on subscribe (Hyperpax:data_api.md:267)."
ac_12 = "Topic <SYMBOL>@kline_<interval> delivers [t, o, h, l, c, v, closed] per interval with t in seconds (Hyperpax:data_api.md:287)."
ac_13 = "Topic <SYMBOL>@perp_orderbook delivers the book with mark_price, index_price and basis_bps, sizes in contracts (Hyperpax:data_api.md:341)."
ac_14 = "Topic <SYMBOL>@perp_trade delivers one frame per perpetual trade with contracts, notional and liquidation; snapshot of the last 100 (Hyperpax:data_api.md:364)."
ac_15 = "Topic <SYMBOL>@perp_stats delivers the /perp_stats fields every 30 seconds and on subscribe (Hyperpax:data_api.md:388)."
ac_16 = "Book levels are aggregated from active limit orders: bids from long orders, asks from short orders, asks ascending and bids descending (contracts/data-services.md:574)."
ac_17 = "Live book frames are coalesced to at most 10 per second with the top 20 levels per side (contracts/data-services.md:866)."
ac_18 = "Every 5 seconds a book frame carries checksum, the CRC32 IEEE of the top 20 levels as price:size pairs joined by commas, asks then bids (contracts/data-services.md:866)."
ac_19 = "Kline snapshots honour limit with default 1000 and maximum 5000 (Hyperpax:data_api.md:292-293)."
ac_20 = "On rollover the kline topic sends the previous candle with closed 1 and then the new candle with closed 0 (contracts/data-services.md:574)."

[req.7011]
title = "The markets table, totals and market topics are served for the eighteen markets"
ac_1 = "GET /api/markets returns one record per market with the 23 fields of Hyperpax:data_api.md:424-461, at the path the application reads (Hyperpax:src/core/feeds.ts:3)."
ac_2 = "GET /api/markets/<symbol> is case-insensitive (Hyperpax:data_api.md:463)."
ac_3 = "An unknown symbol answers 404 with Unknown symbol (Hyperpax:data_api.md:471)."
ac_4 = "GET /api/totals returns total_trades, volume_24h, volume_7d, volume_30d and total_oi (Hyperpax:data_api.md:473)."
ac_5 = "GET /api/markets/health returns ok, service, symbols and uptimeSec (Hyperpax:data_api.md:490)."
ac_6 = "funding_8h is eight times the latest hourly rate, perp_next_funding_ms the next whole UTC hour, perp_basis_bps (mark - index) / index times 10000 (contracts/data-services.md:588)."
ac_7 = "Topic markets@all delivers the full markets array every 5 seconds and on subscribe (Hyperpax:data_api.md:498)."
ac_8 = "Topic markets@totals delivers the totals object every 5 seconds and on subscribe (Hyperpax:data_api.md:513)."
ac_9 = "Topic <SYMBOL>@market delivers one market record every 5 seconds while subscribed (Hyperpax:data_api.md:534)."

[req.7012]
title = "One shared WebSocket carries every topic with snapshots, dense sequences and resume"
ac_1 = "The client event subscribe is accepted as documented (Hyperpax:data_api.md:32)."
ac_2 = "The client event unsubscribe is accepted as documented (Hyperpax:data_api.md:33)."
ac_3 = "The client event ping is accepted as documented (Hyperpax:data_api.md:34)."
ac_4 = "The error code invalid_json is sent as documented (Hyperpax:data_api.md:52-53)."
ac_5 = "The error code missing_topic is sent as documented (Hyperpax:data_api.md:52-53)."
ac_6 = "The error code unknown_event is sent as documented (Hyperpax:data_api.md:52-53)."
ac_7 = "The error code subscribe_rate_limit is sent as documented (Hyperpax:data_api.md:52-53)."
ac_8 = "The error code too_many_subscriptions is sent as documented (Hyperpax:data_api.md:52-53)."
ac_9 = "welcome, subscribed, unsubscribed and pong carry ts and snapshotId as documented (Hyperpax:data_api.md:44-50)."
ac_10 = "Data frames carry topic, ts, snapshotId, seq, snapshot and data (Hyperpax:data_api.md:59-68); snapshot is omitted on live frames."
ac_11 = "Per socket at most 200 subscriptions and 50 subscribe operations per second (Hyperpax:data_api.md:88)."
ac_12 = "The server pings every 30 seconds (Hyperpax:data_api.md:86) and closes a socket that answers no ping within two intervals."
ac_13 = "Shedding closes with 1013 and a retry-after reason the application parses (Hyperpax:src/core/net/realtime.ts:84-85)."
ac_14 = "subscribe sends subscribed, then one snapshot frame carrying the seq of the last broadcast, then deltas with greater seq (Hyperpax:data_api.md:77-79)."
ac_15 = "seq increases by exactly 1 per delta per topic (Hyperpax:data_api.md:75-76), so the application guard accepts every frame (Hyperpax:src/core/net/realtime.ts:29-47)."
ac_16 = "After a consumer reset the hub resumes from the JetStream sequence of the last applied message (Launch-x:shared/delivery/natsdriver/driver.go:238)."
ac_17 = "A rewind message makes every affected topic send a fresh snapshot with the next seq (contracts/data-services.md:412)."
ac_18 = "A gap the hub cannot fill closes the socket with 1013 so the client resyncs, the rule of Hyperpax:src/core/net/realtime.ts:42."
ac_19 = "Frames older than 60 seconds are never sent because the client closes on them (Hyperpax:src/core/net/realtime.ts:68)."
ac_20 = "A gateway restart yields a new snapshotId and the client drops local state (Hyperpax:data_api.md:72-74)."

[req.7013]
title = "Every perpetuals GraphQL query root resolves from the indexed tables"
ac_1 = "Query.position (Hyperpax:src/core/perps/perpetual.graphql:571) returns Position (Hyperpax:src/core/perps/perpetual.graphql:29) from perps.positions_current."
ac_2 = "Query.positions (Hyperpax:src/core/perps/perpetual.graphql:572) returns Position (Hyperpax:src/core/perps/perpetual.graphql:29) from perps.positions_current."
ac_3 = "Query.trades (Hyperpax:src/core/perps/perpetual.graphql:581) returns Trade (Hyperpax:src/core/perps/perpetual.graphql:56) from perps.trade_settlements."
ac_4 = "Query.order (Hyperpax:src/core/perps/perpetual.graphql:591) returns Order (Hyperpax:src/core/perps/perpetual.graphql:76) from perps.orders."
