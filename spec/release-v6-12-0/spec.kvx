mode = "BUILD"
wave = 3
requires = ["7.0.1", "7.0.2", "7.0.3", "7.0.4", "7.0.5", "7.0.6", "7.0.7", "7.0.8", "7.0.9", "7.1.1", "7.1.2", "7.1.3", "7.1.4", "7.1.5", "7.1.6", "7.1.7", "7.1.8", "7.1.9", "7.1.10", "7.2.1", "7.2.2", "7.2.3", "7.2.4", "7.2.5", "7.2.6", "7.2.7", "7.2.8", "7.2.9", "7.2.10", "7.2.11", "7.2.12", "7.2.13", "7.3.1", "7.3.2", "7.3.3", "7.3.4", "7.3.5", "7.2.14", "7.2.15", "7.2.16", "7.2.17", "7.2.18", "7.2.19"]
reqs = ["7001.1", "7012.20", "6.2", "6.3", "6.4"]
capabilities = ["7.4.6"]
do_1 = "TestEndToEnd starts the indexer, gateway, explorer and portal handlers in-process against the node of PERPS_DATA_TEST_RPC and PERPS_DATA_TEST_COMET (chain.mk:278), the Postgres of PERPS_DATA_TEST_DATABASE_URL and an in-process nats-server."
do_2 = "It sends a deposit, a limit order, a fill, a funding settlement and a withdrawal to the perpetuals precompile 0x1015 and a spot market order to 0x1021, then asserts the rows in Postgres including the perps_endblock synthetic receipt rows and the index_prices rows of the pricefeed block events, the JetStream messages with increasing Perps-Seq, the REST and GraphQL answers and the WebSocket frames with dense seq."
do_3 = "It restarts the gateway mid-stream and asserts a new snapshotId, a fresh snapshot and no gap on the guarded client."
do_4 = "It runs perps-replay over the test heights and asserts identical rows and no duplicate JetStream entries."
do_5 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["perpsdata.TestEndToEnd"]
touches = ["platform/perps-data/e2e_test.go"]
build_cmd = "go build ./platform/perps-data/..."
verify_cmd = "go test -count=1 ./platform/perps-data/ -run 'TestEndToEnd'"
gate_kind = "planned"
planned_paths = ["platform/perps-data/e2e_test.go"]
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark complete without the declared evidence."
path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to their current equivalents before the gate can run; historical references never authorize a duplicate implementation tree. Complete scoped path reconciliation without dropping acceptance criteria."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

[service.perps-data-indexer]
purpose = "Follow the node head, decode venue logs into Postgres facts and projections, and publish every committed block to JetStream through the outbox."
route = "/healthz/live, /healthz/ready and /metrics only"
inputs = "Blocks, logs and synthetic receipts from the node over PERPS_RPC_URLS; CometBFT header and block_results over PERPS_COMET_URLS; the stored cursor"
outputs = "Fact, projection and chain rows; JetStream messages perps.<chain>.>"
state = "perps.cursors, perps.writer_lease, perps.delivery_outbox"
dependencies = ["postgres", "nats"]
failure_policy = "One writer through the lease; a reorg rewinds to the first divergent height and moves the cursor to the fork height minus one; a synthetic receipt that differs from the table stops the follower; readiness drops while lag exceeds 30 blocks or an outbox row is older than 30 seconds."
contract = "contracts/data-services.md#5-indexer-head-follower-and-reorg-handling"
completion_task = "7.1.8"
operation_task = "7.3.3"

[service.perps-gateway]
purpose = "Serve the REST routes, the data and spot user sockets, sign-in, account routes and GraphQL that the Hyperpax application reads."
route = "/api/*, /api/markets/* including the venue routes, /v1/users/*, /v1/leaderboards/*, /v1/ws, /v2/*, /ws, /ws/<symbol>, /ws/markets, /ws/explorer, /, /graphql, /api/subgraph, /graphql-ws"
inputs = "Postgres reads; the JetStream consumer; node reads for spot holdings"
outputs = "JSON responses, socket frames and GraphQL answers"
state = "perps.delivery_inbox consumer position; account tables of migration 0004"
dependencies = ["postgres", "nats", "perps-data-indexer"]
failure_policy = "Not ready without Postgres, the consumer or within 10 seconds of the stream head; new sockets then close 1013 with retry-after; database failures answer 503."
contract = "contracts/data-services.md#8-shared-websocket-protocol"
completion_task = "7.2.13"
operation_task = "7.3.3"

[service.perps-explorer]
purpose = "Serve the chain explorer REST views of venue blocks, transactions and histories."
route = "/api/chain/* and /api/explorer/health"
inputs = "Postgres reads of blocks and tx_actions"
outputs = "JSON lists with explorer links"
state = "none"
dependencies = ["postgres", "perps-data-indexer"]
failure_policy = "Not ready without Postgres; excess requests answer 429 with Retry-After."
contract = "contracts/data-services.md#16-chain-explorer-routes"
completion_task = "7.2.12"
operation_task = "7.3.3"

[service.perps-portal]
purpose = "Render the server-side portal pages of markets, accounts, the leaderboard and statistics."
route = "/, /markets/<symbol>, /accounts/<address>, /leaderboard, /stats"
inputs = "Gateway REST and GraphQL over PERPS_GATEWAY_URL"
outputs = "HTML pages"
state = "five second page cache in memory"
dependencies = ["perps-gateway"]
failure_policy = "Readiness follows the gateway; unknown keys answer 404 inside the layout."
contract = "contracts/data-services.md#17-portal-pages"
completion_task = "7.3.2"
operation_task = "7.3.3"

[service.postgres]
purpose = "Hold the perps schema of facts, projections, account rows and the delivery tables."
route = "none; private network only"
inputs = "Writes of the indexer, the replay tool and the account routes"
outputs = "Reads of the gateway, explorer and replay tool"
state = "the Railway volume of the postgres service"
dependencies = []
failure_policy = "Migrations refuse start on a changed hash; projections are rebuilt from facts by store.Rebuild."
contract = "contracts/data-services.md#2-postgres-schema"
completion_task = "7.0.5"
operation_task = "7.3.3"

[service.nats]
purpose = "Run the JetStream cluster of three members nats-1, nats-2 and nats-3 built from deploy/nats/Dockerfile, carrying the stream PERPS_V1."
route = "none; private network only"
inputs = "Publishes of the indexer user"
outputs = "Pull consumers of the gateway user"
state = "store_dir /data on the volume of each member"
dependencies = []
failure_policy = "Messages carry MsgID for deduplication; the publisher refuses an acknowledgement from a foreign stream or a zero sequence."
contract = "contracts/data-services.md#3-nats-jetstream-stream-and-subjects"
completion_task = "7.1.6"
operation_task = "7.3.4"

[service.perps-replay]
purpose = "Rebuild facts and projections for a height range; its messages reuse the event ids of the first index, so the stream and the inbox deduplicate them."
route = "none; manual run"
inputs = "Node blocks, logs and synthetic receipts over PERPS_RPC_URLS and block_results over PERPS_COMET_URLS for the range"
outputs = "Fact and projection rows and stream messages for the range"
state = "perps.writer_lease while running"
dependencies = ["postgres", "nats"]
failure_policy = "Takes the writer lease; refuses a range whose from exceeds to or the indexer cursor with exit code 2; --dry-run writes nothing."
contract = "contracts/data-services.md#7-replay-tool"
completion_task = "7.1.7"
operation_task = "7.3.3"
[feature.8]
name = "release-rollout"
scope = "The v6.12.0 release of paxd: release identity on the V6120Upgrade constant, retirement of the v6.11 name with its SID work shipped inside v6.12.0, the reproducible build with the kernel and release sandbox libraries linked and pinned Go, Rust and C toolchains, the price-sidecar artifact, the release workflows and assets, upgrade-info generation, the four-validator upgrade rehearsal from a halt-height export with the programme checks and a rollback leg, the stage, swap, snapshot, rollback, feed-key and fleet verification tooling and the operator env templates under tools/release, the Hyperpax spot route gate, and the operator-executed fleet rollout at one halt height with the sidecar install, feed-key registration, data services and application cut-over and the snapshot rollback of every node."
requirements = ["8001", "8002", "8003", "8004", "8005", "8006", "8007", "8008", "8009", "8010", "8011", "8012", "8013", "8014", "8015", "8016", "8017", "8018"]
completion_task = "8.5.99"

[req.8001]
title = "Release identity of v6.12.0"
ac_1 = "tools/release/version.json holds version v6.12.0 and upgrade v6.12.0 in place of v6.11.0 and v6.11 (tools/release/version.json:2-3), the plan named in the head activation and decision.1."
ac_2 = "The Release Check identity step finds the declaration V6120Upgrade = \"v6.12.0\" that task 1.0.3 adds in node/upgrades_v6120.go beside the existing plan constants (node/upgrades.go:93, node/upgrades.go:112): task 8.4.4 replaces the generic grep for = \"$upgrade\" of .github/workflows/paxeer-release-check.yml:46-49 with a grep for that exact declaration, so the custody gate constant that task 1.0.5 sets to v6.12.0 (modules/layerxcustody/types/governance_activation.go:5) does not satisfy it."
ac_3 = "v6.12.0 matches the semantic version pattern of .github/workflows/paxeer-release-check.yml:39-44 and is newer than the latest paxeer-network/v* tag by sort -V (.github/workflows/paxeer-release-check.yml:57-65)."
ac_4 = "The tag paxeer-network/v6.12.0 is absent before the release (.github/workflows/paxeer-release-check.yml:51-55) and equals the tag build-paxd.sh derives from version.json (tools/release/build-paxd.sh:19-20)."
ac_5 = "The built binary reports v6.12.0: the Version linker flag (tools/release/build-paxd.sh:35-41) feeds version.Version, the application sets it (node/app.go:593) and the ABCI info response returns it as version (sdk/baseapp/abci.go:98) on the abci_info route (consensus/internal/rpc/core/routes.go:71)."

[req.8002]
title = "The release build links the kernel libraries"
ac_1 = "build-paxd.sh runs make paxd-native-libs, the Makefile target that baseline task 1.0.1 makes depend on build/liblayerx.a (Makefile:46, Makefile:211), the checkpoint header and programs-release-build, before the Go build of ./daemon/paxd (tools/release/build-paxd.sh:43-44)."
ac_2 = "The same make paxd-native-libs run builds programs/target/release/liblayerx_programs_sandbox.a through programs-release-build (Makefile:3406, Makefile:3422-3425), and task 1.0.1 puts -L programs/target/release ahead of the debug directory on the link line of modules/lxphost/host.go:7, so paxd links the release sandbox library and the release build never reads programs/target/debug."
ac_3 = "build-paxd.sh keeps the Go pin check (tools/release/build-paxd.sh:11-17, go.mod:3) and adds a Rust pin check: rustc --version must name the channel of rust-toolchain.toml:2, else the script exits 1 with build-paxd: rust-toolchain.toml pins 1.91.1, found <version>."
ac_4 = "build-paxd.sh writes native-libs.sha256 with one line for build/liblayerx.a and one for programs/target/release/liblayerx_programs_sandbox.a, the two static libraries linked into paxd, and the file is listed in SHA256SUMS (tools/release/build-paxd.sh:69-70)."
ac_5 = "The release directory is dist/paxeer-network/v6.12.0 (tools/release/build-paxd.sh:25) and the three libwasmvm copies stay checked against wasm-runtime/libwasmvm-linux.sha256 (tools/release/build-paxd.sh:46-58)."
ac_6 = "build-paxd.sh pins the C compiler: cc -dumpfullversion must equal CC_VERSION of tools/release/toolchain.env, else the script exits 1 with build-paxd: toolchain.env pins cc <pinned>, found <version>; the Go and Rust pins stay as in ac_3."

[req.8003]
title = "Reproducible release build with checksums"
ac_1 = "Two builds of one commit produce byte-identical SHA256SUMS (tools/release/reproducible-check.sh:9-20)."
ac_2 = "The second build starts from clean native libraries: the check removes build/liblayerx.a, build/generated and programs/target before it, beside the empty GOCACHE of tools/release/reproducible-check.sh:10."
ac_3 = "C sources are compiled with -ffile-prefix-map of the repository root to . as the layerxd build already does (tools/release/build-paxd.sh:64-65), and Rust sources with RUSTFLAGS --remap-path-prefix of the repository root and of CARGO_HOME, so no absolute build path enters a library."
ac_4 = "SOURCE_DATE_EPOCH is the commit time of RELEASE_COMMIT (tools/release/build-paxd.sh:22), and build-paxd.sh touches every file of the release directory with that time again after it writes upgrade-info.json and regenerates SHA256SUMS, so the last write of the directory is followed by a touch and every release file carries that time (the first touch is tools/release/build-paxd.sh:69)."
ac_5 = "The check fails when SHA256SUMS carries no paxd line (tools/release/reproducible-check.sh:21-24) and when native-libs.sha256 is missing from either build."
ac_6 = "The build host and the publish runner build the same commit with the same pinned Go (go.mod:3), Rust (rust-toolchain.toml:2) and C compiler (tools/release/toolchain.env), and verify-release.sh compares the publish runner's SHA256SUMS with the build host's SHA256SUMS line by line; one differing line fails the release."

[req.8004]
title = "Release workflows build the kernel and publish v6.12.0"
ac_1 = "Release Check installs the pinned Rust toolchain before the reproducible build step (.github/workflows/paxeer-release-check.yml:76-79) with the rustup command shape of .github/workflows/programs-conformance.yml:95-96."
ac_2 = "Release Publish installs the same Rust toolchain before the build step (.github/workflows/paxeer-release-publish.yml:53-56)."
ac_3 = "The release title is Paxeer X Network $version and the step summary heading is Paxeer X Network release $RELEASE_TAG, in place of the titles at .github/workflows/paxeer-release-publish.yml:71 and .github/workflows/paxeer-release-publish.yml:75."
ac_4 = "The release assets are every file of dist/$RELEASE_TAG (.github/workflows/paxeer-release-publish.yml:73), so upgrade-info.json and native-libs.sha256 are published beside the binaries and SHA256SUMS."
ac_5 = "Release Publish runs on a paxeer-network/v* tag push (.github/workflows/paxeer-release-publish.yml:3-6) and refuses a tag that differs from version.json (.github/workflows/paxeer-release-publish.yml:41-44)."
ac_6 = "Release Check runs on pull requests touching src/**, include/**, Makefile, rust-toolchain.toml, programs/**, platform/Cargo.toml, platform/Cargo.lock, platform/hosted/feeder/**, tools/price-sidecar/** and the publish workflow, added to the path list of .github/workflows/paxeer-release-check.yml:5-17, since each changes a release binary."
ac_7 = "Release Check and Release Publish install build-essential at the version that tools/release/toolchain.env pins (.github/workflows/paxeer-release-check.yml:72-75, .github/workflows/paxeer-release-publish.yml:49-52) and run the C compiler pin check of build-paxd.sh before the build."

[req.8005]
title = "Upgrade-info generation"
ac_1 = "tools/release/upgrade_info.py release writes upgrade-info.json as {name, info} where info is the binaries JSON of the form docs/runbooks/paxeer-x-fork.md:127 naming the release asset of paxd-v6.12.0-linux-amd64 with ?checksum=sha256:<sha256>."
ac_2 = "The checksum in the release document equals the paxd-v6.12.0-linux-amd64 line of SHA256SUMS, and upgrade_info.py exits 1 when SHA256SUMS has no such line."
ac_3 = "tools/release/upgrade_info.py node --home <home> --height <H1> writes <home>/data/upgrade-info.json with exactly the name and height fields of store.UpgradeInfo (sdk/store/types/store.go:56-59) and mode 0600 as the keeper writes it (sdk/x/upgrade/keeper/keeper.go:430), and the keeper read ReadUpgradeInfoFromDisk (sdk/x/upgrade/keeper/keeper.go:453-475) returns name v6.12.0 and height H1."
ac_4 = "The node file height is the halt height plus one: applyNamedUpgrade applies a pending plan only when info.Height equals the block height (node/upgrades.go:594-596) and requires the activation stores mounted at process start (node/upgrades.go:597-600), so upgrade_info.py node takes --halt-height H and writes H + 1."
ac_5 = "upgrade_info.py refuses a name other than the upgrade field of tools/release/version.json (tools/release/version.json:3), a height below 1, and a checksum that is not 64 lowercase hex digits."

[req.8006]
title = "Rehearsal network from a halt-height export"
ac_1 = "The rehearsal exports a copy of a stopped full node's data with the previous binary through paxd export --height E (sdk/server/export.go:191), the export step shape of platform/hosted/paxeer/fork-rehearsal.sh:334-358."
ac_2 = "rewrite_genesis.py turns the export into a four-validator genesis: each bonded validator keeps its operator, tokens and delegations and takes a local consensus key, the CometBFT validator list, last_validator_powers and slashing signing infos follow the new keys, and the previous binary's validate-genesis passes (platform/hosted/paxeer/fork-rehearsal.sh:444-445)."
ac_3 = "The four local nodes start on the previous binary with --halt-height HR (sdk/server/start.go:46) and each commits HR and halts itself (sdk/baseapp/abci.go:310, sdk/baseapp/abci.go:322), logging halting node per configuration (sdk/baseapp/abci.go:360); its priv_validator_state.json then records HR, or HR+1 with round 0, step 1 and one signed proposal (sign bytes of type PROPOSAL 0x20), and never a prevote or precommit at HR+1 nor any height above HR+1."
ac_4 = "Each home receives the node upgrade file for HR+1 from upgrade_info.py node, and the new binary applies plan v6.12.0 once in block HR+1, logging applying upgrade (node/upgrades.go:602)."
ac_5 = "Every host-specific value of the rehearsal comes from flags or an untracked env file and nothing contacts a remote host, the rule of platform/hosted/paxeer/fork-rehearsal.sh:25-31; rehearse-v6120.sh --check validates syntax, flags and tools and touches nothing."
ac_6 = "The rehearsal writes rehearsal-result.env with the keys of platform/hosted/paxeer/fork-rehearsal.sh:568-576 plus pools, markets, oracle_fresh, feed_keys, precompiles_served and rollback_rehearsed, and new_bin_sha256 equals the paxd line of the release SHA256SUMS."

[req.8007]
title = "Rehearsal coverage of the v6.12.0 handler"
ac_1 = "paxd q upgrade applied v6.12.0 reports height HR+1 on every rehearsal node, the query shape of platform/hosted/paxeer/fork-rehearsal.sh:536-540."
ac_2 = "The pool count served by the launchpad precompile 0x1017 (modules/launchpad/types/keys.go:26) through getPoolCount() (Launch-x:contracts/contracts/interfaces/IPoolRegistry.sol:63) at HR+1 equals the sum of the pool counts of the two deployment-generation registries read at HR (Launch-x:contracts/contracts/data/PoolRegistry.sol:111-113; Launch-x:shared/config/deployment/current.json:44; Launch-x:protocol/addresses.go:21)."
ac_3 = "Every migrated pool returns at HR+1 through the precompile the reserves its contract returned at HR through getReserves() (Launch-x:contracts/contracts/interfaces/ISidioraPool.sol:65-69): virtualUsdl, realUsdl and tokenReserve equal word for word."
ac_4 = "The perpetuals precompile 0x1015 (modules/layerxexchange/types/ids.go:15) serves eighteen markets at HR+1 with the symbols of contracts/perps-markets.md, seeded by SeedV6120 of the head contract."
ac_5 = "The feed-key registry holds one key per rehearsal validator, each registered by that validator's operator EVM address with registerFeedKey after InitV6120 seeded the parameters and markets, and once the four local sidecars run getPrice(m).fresh of 0x1020 is true for every market m below getMarketCount(), the time-window rule of contracts/pricefeed.md (Freshness and read API)."
ac_6 = "Every served address of contracts/address-table.md (0x1015, 0x1017 and 0x1020-0x1025) answers its view call without revert at HR+1 and each address new in v6.12.0 answers 0x at HR, the before-and-after reachability rule of tools/chain/upgrade-replay/replay.go:338-358 checked over JSON-RPC; 0x1026 and 0x1027 carry no code, so eth_getCode returns 0x for both at HR and at HR+1 and no view call is made to them."
ac_7 = "Block HR+1 and every later block carry the same hash on the four nodes through the block route (consensus/internal/rpc/core/routes.go:46) and the chain passes HR+10."
ac_8 = "Every rehearsal node reports version v6.12.0 in the ABCI info response (sdk/baseapp/abci.go:98) and no node log carries panic."
ac_9 = "The rehearsal runs a rollback leg on the same fixture: after HR+10 it halts the four nodes, restores each home's snapshot taken at HR and the previous binary with rollback.sh --execute, restarts them, and requires the application hash reported at HR after the restore to equal the one recorded at HR before the upgrade and the chain to pass HR+5 on the previous binary, so the memiavl reopen of restored data is proven before the fleet window."

[req.8008]
title = "Stage and swap tooling"
ac_1 = "stage.sh installs the release binary as paxd.v6.12.0 beside the installed paxd, checks it against the release sha256 with sha256sum --check --strict, and keeps a copy of the installed binary as paxd.pre-<RELEASE_ID>, creating it only when absent."
ac_2 = "swap.sh replaces paxd atomically with cp -p to paxd.new in the same directory and mv -f, and refuses to start a unit when sha256 of the installed paxd differs from RELEASE_SHA256."
ac_3 = "swap.sh on a host whose binary is shared refuses to replace paxd while any validator home of that host still runs, checked with pgrep -a -x paxd filtered by --home, the exact-name check that never matches a wrapper's command line."
ac_4 = "swap.sh writes the node upgrade file through upgrade_info.py node --halt-height H with the name of the release upgrade-info.json and mode 0600 (sdk/x/upgrade/keeper/keeper.go:430), refuses when the checksum of that release document differs from RELEASE_SHA256, and resets halt-height to 0 in app.toml (sdk/server/config/toml.go:42) for validator homes."
ac_5 = "swap.sh runs against a real local single-node chain started from paxd init whose genesis is then seeded with the evm codes and states and the launchpad state of the mainnet halt export node/testdata/v6120-halt-export.json, the only state MigrateV6120 accepts, and halted with --halt-height, and with --service-manager foreground it stops and starts the process itself, so the test exercises the same code path as systemd hosts."
ac_6 = "stage.sh and swap.sh run ldd on paxd.v6.12.0 and refuse with stage: unresolved shared library <name> when any line reads not found, because paxd links libssl and libcrypto dynamically (modules/lxphost/host.go:7)."
ac_7 = "stage.sh --receipt and swap.sh --receipt write their receipt with keys of the receipt key set only: hosts_staged and result for stage.sh, nodes_checked, nodes_passed and result for swap.sh."

[req.8009]
title = "Snapshot and rollback tooling"
ac_1 = "snapshot.sh writes one tar --zstd archive of the whole data directory, priv_validator_state.json included, of every validator home and every full-node home after that node halted or was stopped at H, and checks each archive with tar --zstd -tf; --receipt writes homes_archived and result."
ac_2 = "rollback.sh --execute halts and stops every unit of the env file, moves each home's data to data.v6.12.0-<RELEASE_ID>, extracts the home's snapshot, restores paxd.pre-<RELEASE_ID> with the atomic swap, removes data/upgrade-info.json read by ReadUpgradeInfoFromDisk (sdk/x/upgrade/keeper/keeper.go:453-475), sets halt-height = 0 (sdk/server/config/toml.go:42) and restarts every unit on the previous binary."
ac_3 = "The restored priv_validator_state.json records height H, or height H1 with round 0, step 1 and the signature of one proposal (sign bytes of type PROPOSAL 0x20) that the previous binary's halt (sdk/baseapp/abci.go:322) may sign before the process stops, and never a prevote or precommit at H1 (steps 2 or 3) nor any height above H1; every validator and full node of the fleet is restored together in one window, and the set-aside data, which holds any block or vote produced after H, is never started or served; the restored validators sign H1 again on the previous binary."
ac_4 = "rollback.sh --readiness exits 0 only when every host of the env file has paxd.pre-<RELEASE_ID> and every validator and full-node home has its snapshot archive, and the script never deletes set-aside data; --receipt writes readiness, rollback_executed and result."
ac_5 = "The rollback leg of the rehearsal (req 8.7 ac_9) passes before the fleet window, recorded as rollback_rehearsed true in rehearsal.json."

[req.8010]
title = "Fleet verification script"
ac_1 = "fleet_check.py reads the version of every node from the abci_info route (consensus/internal/rpc/core/routes.go:71), whose version field is the base application version (sdk/baseapp/abci.go:98), and requires v6.12.0 in phases validators, full and post."
ac_2 = "fleet_check.py requires paxd q upgrade applied v6.12.0 to report height H1 and the status route (consensus/internal/rpc/core/routes.go:38) to report catching_up false and a height above H1."
ac_3 = "fleet_check.py checks presence of every served address of contracts/address-table.md (0x1015, 0x1017, 0x1020-0x1025) by eth_call of the view named for it in tools/release/fleet-views.json, because precompiles hold no code-store entry (modules/evm/keeper/code.go:15-21) and eth_getCode returns that store (rpc/state.go:66-81); for 0x1026 and 0x1027 it requires eth_getCode 0x; it reads the uhpx and SID pointers through getNativePointer of the pointer view precompile 0x100A (precompiles/pointerview/pointerview.go:18, precompiles/pointerview/pointerview.go:24) and requires exists true and decimals() 6, and it requires decimals() 6 at the USDL ERC20 0x85FcD13735F4309833A503EE804ea32395851479."
ac_4 = "fleet_check.py reads getPoolCount() of 0x1017 (modules/launchpad/types/keys.go:26; Launch-x:contracts/contracts/interfaces/IPoolRegistry.sol:63) and requires the pools value of the rehearsal receipt."
ac_5 = "fleet_check.py reads totalMarkets() of the perpetuals precompile 0x1015 (contracts/perps.md) and getMarketCount() of 0x1020 and requires 18 for both."
ac_6 = "fleet_check.py reads getPrice(m) of the pricefeed precompile 0x1020 for every market m below getMarketCount() and requires the fresh field of the returned Price true, the time-window rule of contracts/pricefeed.md; it reads getFeedKey(v) for every validator operator v and counts feed_keys as the validators with a 33-byte key."
ac_7 = "fleet_check.py requires the block hash at H1 from the block route (consensus/internal/rpc/core/routes.go:46) to be equal on every node."
ac_8 = "fleet_check.py --receipt writes only keys of the receipt key set of contracts/release.md#post-rollout-verification (version, plan, nodes_checked, nodes_passed, precompiles_served, pools, markets, oracle_fresh, feed_keys, homes_archived, hosts_staged, units_active, services_ready, readiness, rollback_executed, rollback_rehearsed, new_bin_sha256, inputs_sha256, inputs_approved, tag, release_sha256 and result); no height, endpoint or host enters it."
ac_9 = "fleet_check.py computes selectors with an in-file keccak-256 so it needs no external tool; the test pins keccak256 of the empty string to c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470 and transfer(address,uint256) to a9059cbb."

[req.8011]
title = "Rollout execution at one height"
ac_1 = "Fleet automation that restarts, reclones or replaces binaries is stopped before the freeze and resumed only after the full phase passes, and stage.sh --automation-status reports every automation unit of the env file."
ac_2 = "Validators are frozen one home at a time with halt-height = H in app.toml (sdk/server/config/toml.go:42) and a restart, so at least three of the four equal-power validators sign every block until H."
ac_3 = "Every full node runs v6.12.0 with its upgrade file before any validator restarts, so no full node executes H1 on the previous binary; on a host whose binary is shared, the swap waits for every validator home of the host."
ac_4 = "Lagging nodes keep the previous binary with halt-height = H until they halt at H, then are snapshotted and swapped by hand; the archive node is snapshotted and swapped this way and never recloned; data moves and age-based deletion never run together."
ac_5 = "The halt height, maintenance window, public notice text, build host and every other operator value are blank fields of docs/rollout-runbook.md and blank keys of tools/release/env/rollout.env.example, filled only in the access-controlled copy (decision.11), and no receipt carries them."
ac_6 = "Self-remediation may be set off for the window by blocks-behind-threshold = 0 (consensus/config/toml.go:627; consensus/config/config.go:1514) with a backup of config.toml restored at the resume step."
ac_7 = "Every full node and every validator home is stopped at H and snapshotted before any swap, so each node of the fleet has a pre-H1 archive."
ac_8 = "The earlier feeder units layerx-oracle-feeder, which send pushOracle to 0x1015 (platform/hosted/feeder/src/lib.rs:2, platform/hosted/feeder/src/lib.rs:62, platform/hosted/feeder/src/lib.rs:647), are stopped and disabled on every host before the freeze, and stage.sh --automation-status reports them inactive."

[req.8012]
title = "Post-rollout verification and release publication"
ac_1 = "fleet_check.py --phase post passes on every node of the inventory: version v6.12.0, plan applied at H1, one hash at H1, every served address answering and 0x1026 and 0x1027 without code, both pointers present, pool count equal to the rehearsal count, eighteen markets, every price fresh and one feed key per validator."
ac_2 = "The GitHub release paxeer-network/v6.12.0 exists with the assets of the build host's release directory and verify-release.sh compares every SHA256SUMS line."
ac_3 = "Each rollout step writes a receipt under tools/release/rollout/v6.12.0 with counts and pass flags only; credentials, inventories and raw logs stay in access-controlled storage (head execution privacy)."
ac_4 = "Nodes stop cleanly for the swap: App.Close stops the EVM servers before the base application closes (node/app.go:1273-1276), so the restart on v6.12.0 binds the JSON-RPC listener once."

[req.8013]
title = "Domain completion of the release"
ac_1 = "tools/release/tests/run-all.sh runs every test of tools/release/tests, tools/release/rehearsal and go test ./tools/release/upgradeinfo/ once and exits non-zero when any fails."
ac_2 = "Every receipt of the window under tools/release/rollout/v6.12.0 carries result pass before the completion task closes."
ac_3 = "The completion receipt names the release tag, the release sha256 and the plan, and run-all.sh refuses it when its sha differs from the paxd line of SHA256SUMS."
ac_4 = "tools/release/tests/completion-check.sh runs run-all.sh once, requires every task of spec/release-v6-12-0/spec.kvx other than 8.5.99 at status done, and refuses completion.json when its release_sha256 differs from the paxd line of SHA256SUMS; it is the gate of 8.5.99 and differs from the gate of 8.4.15."

[req.8014]
title = "Retire the v6.11 name; its SID work ships inside v6.12.0"
ac_1 = "No release, governance or bring-up file names the plan v6.11: tools/paxeer-x/gov/templates/01-software-upgrade.json:2,5,6, tools/paxeer-x/gov/README.md:3,19, tools/paxeer-x/gov/test.sh:19,45, tools/paxeer-x/sid-snapshot/README.md:3, tools/bringup/sync-fleet.test.sh:639-727, hpx/publish.sh:20, RELEASE.md:7 and the comments of contracts/src/SidioraNativeERC20.sol:31,70 name v6.12.0."
ac_2 = "The SID holder migration and the SID mint-authority move of the v6.11 work run as hooks of the v6.12.0 handler (baseline task 1.0.3, req 1.4 ac_8), and tools/paxeer-x/sid-snapshot/README.md and RELEASE.md describe them as v6.12.0 work (RELEASE.md:7 names modules/layerxcustody/types/governance_activation.go), so no release ships them separately."
ac_3 = "tools/paxeer-x/gov/test.sh asserts that the rendered proposal names v6.12.0 as .name of the software-upgrade plan and fails on v6.11."

[req.8015]
title = "Price sidecar artifact and feed keys"
ac_1 = "build-paxd.sh builds price-sidecar with cargo build --locked --release --manifest-path platform/Cargo.toml -p layerx-oracle-feeder --bin price-sidecar (platform/Cargo.toml:23, platform/hosted/feeder/Cargo.toml:8-10 and the bin of task 5.2.6), copies it to price-sidecar-v6.12.0-linux-amd64 in the release directory and lists it in SHA256SUMS."
ac_2 = "tools/release/feed_key.py new writes a 64-hex secp256k1 secret to the named file with mode 0600, the key file format of load_key (platform/hosted/feeder/src/lib.rs:492-511), and prints the 33-byte compressed public key; feed_key.py payload <pubkey> prints the registerFeedKey(bytes) calldata of contracts/pricefeed.md (Precompile interface); keys are computed in the file with no external tool."
ac_3 = "Each validator operator associates its operator EVM address with paxd tx evm associate-address (modules/evm/client/cli/tx.go:81), sends the payload to 0x0000000000000000000000000000000000001020 with paxd tx evm call-contract (modules/evm/client/cli/tx.go:304), and checks getFeedKey(validator) and getValidatorByFeedAccount(feedAccount) before the sidecar starts."
ac_4 = "The sidecar is installed from tools/price-sidecar (price-sidecar.service, config.template.json) with the feed key and the Chainflow key loaded as credentials feed.key and chainflow.key (contracts/pricefeed.md, Install), and its /readyz answers 200 before the oracle phase passes."

[req.8016]
title = "Data services and application cut-over"
ac_1 = "After the validators phase the operator deploys perps-data-indexer with PERPS_START_HEIGHT = H1 (contracts/data-services.md), then perps-gateway, perps-explorer and perps-portal, and each answers 200 on /healthz/ready (contracts/data-services.md) before the next starts."
ac_2 = "The Hyperpax release build of feature 6 is deployed with Hyperpax:deploy/scripts/deploy.sh and answers /api/build-id with the release build id (Hyperpax:deploy/scripts/deploy.sh:147); the spot-open build is deployed only after the post phase passes."
ac_3 = "The Hyperpax spot route is gated by NEXT_PUBLIC_RELEASE_SPOT_OPEN: unset, getServerSideProps of Hyperpax:src/pages/spot.tsx returns notFound and neither the navigation nor the markets mode toggle offers spot; set to 1, the page composes the widgets of Hyperpax:src/widgets/spot and both entries appear."
ac_4 = "fleet_check.py --phase services reads /healthz/ready of every DATA_SERVICE_URLS entry and /api/build-id of APP_URL against APP_BUILD_ID and writes services_ready and result."

[req.8017]
title = "Operator env templates and the halt height approval"
ac_1 = "tools/release/env/rehearsal.env.example and tools/release/env/rollout.env.example declare every key that rehearse-v6120.sh, stage.sh, swap.sh, snapshot.sh, rollback.sh, fleet_check.py and docs/rollout-runbook.md read, each with an empty value."
ac_2 = "The operator copies rollout.env.example to .env.rollout-v6120 and rehearsal.env.example to .env.rehearsal-v6120 in access-controlled storage and fills them; the scripts refuse a run with any key empty, naming the key."
ac_3 = "Before staging, the chosen halt height and its approval are recorded: halt-height.json holds inputs_sha256, the sha256 of the filled access-controlled input table, and inputs_approved true, and no height; every wave 5 task after it requires it."

[req.8018]
title = "Programme checks of the rehearsal"
ac_1 = "rehearse-v6120.sh check_launchpad_interface, check_usdl_erc20_custody, check_pool_parity and check_fee_right_and_pool_token run the programme scenarios of req 1.1 to 1.4 against the four rehearsal nodes after HR+1."
ac_2 = "check_perps_order_types, check_perps_margin, check_perps_economics, check_perps_markets and check_perps_log_rebuild run the programme scenarios of req 2.1 to 2.5."
ac_3 = "check_spot_interface, check_spot_settlement and check_spot_logs run the programme scenarios of req 3.1 to 3.3."
ac_4 = "check_sidecar_submissions, check_price_freshness and check_price_submission_bounds run the programme scenarios of req 4.1 to 4.3 with the four local sidecars."
ac_5 = "check_plan_and_version runs the programme scenario of req 7.2 and every check writes PASS <name> or FAIL <name> with a non-zero exit."

