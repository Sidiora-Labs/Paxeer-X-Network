[contract_context.8.build]
plan = "The plan is v6.12.0, declared as V6120Upgrade = \"v6.12.0\" in node/upgrades_v6120.go by task 1.0.3, listed in knownUpgradePlans (node/upgrades.go:530-534) and registered with SetUpgradeHandler beside node/upgrades.go:200-209; the identity check greps for that declaration because GovernanceActivationUpgrade (modules/layerxcustody/types/governance_activation.go:5) carries the same string."
identity = "tools/release/version.json (tools/release/version.json:1-4) holds version v6.12.0 and upgrade v6.12.0; the Release Check identity step (.github/workflows/paxeer-release-check.yml:36-67) accepts it."
tag = "The release tag is paxeer-network/v6.12.0 (tools/release/build-paxd.sh:20), the namespace chain.mk:9 resolves."
toolchain = "Go is pinned by go.mod:3 and checked at tools/release/build-paxd.sh:11-17; Rust is pinned by rust-toolchain.toml:2; the C compiler is pinned by CC_VERSION of tools/release/toolchain.env and checked by build-paxd.sh and both release workflows."
kernel_libraries = "make paxd-native-libs builds build/liblayerx.a (Makefile:46, Makefile:211) and the release sandbox library programs/target/release/liblayerx_programs_sandbox.a through programs-release-build (Makefile:3406, Makefile:3422-3425) before the go build of tools/release/build-paxd.sh:43-44, satisfying the link line of modules/lxphost/host.go:7; task 1.0.1 points the native target at the release library."
version_stamp = "Version, Commit and BuildTags are set by the linker flags of tools/release/build-paxd.sh:35-41; node/app.go:593 sets the version that abci_info returns (sdk/baseapp/abci.go:98)."
sidecar = "price-sidecar is a binary of the workspace member hosted/feeder (platform/Cargo.toml:23), added by task 5.2.6 beside the layerx-oracle-feeder binary of platform/hosted/feeder/Cargo.toml:8-10, built with cargo build --locked --release under the pinned Rust toolchain."

[contract_context.8.artifacts]
directory = "dist/paxeer-network/v6.12.0 (tools/release/build-paxd.sh:25) holds nine files: paxd, layerxd (tools/release/build-paxd.sh:61-67), the pinned libwasmvm copies (tools/release/build-paxd.sh:46-58), price-sidecar-v6.12.0-linux-amd64, native-libs.sha256, upgrade-info.json and SHA256SUMS (tools/release/build-paxd.sh:69-70), every file touched with SOURCE_DATE_EPOCH after the last write."
upgrade_document = "upgrade-info.json of the release is {name, info} with the binaries JSON of docs/runbooks/paxeer-x-fork.md:127 and the checksum of the paxd SHA256SUMS line."
node_file = "A node's data/upgrade-info.json carries name and height (sdk/store/types/store.go:56-59) at the path of sdk/x/upgrade/keeper/keeper.go:434-441 with mode 0600 (sdk/x/upgrade/keeper/keeper.go:430); height is halt height + 1 (node/upgrades.go:594-596)."
reproducibility = "Two builds compare equal (tools/release/reproducible-check.sh:9-20) with the native libraries rebuilt from clean and the paxd line present (tools/release/reproducible-check.sh:21-24)."
publication = "Release Publish validates the tag (.github/workflows/paxeer-release-publish.yml:32-44), builds (.github/workflows/paxeer-release-publish.yml:53-56) after the Rust step and uploads every release file (.github/workflows/paxeer-release-publish.yml:69-73) under the title Paxeer X Network v6.12.0."

[contract_context.8.rehearsal]
export = "paxd export --height (sdk/server/export.go:191) of a stopped node copy, the step of platform/hosted/paxeer/fork-rehearsal.sh:334-358."
validators = "Four validators of equal power with local keys; validate-genesis passes (platform/hosted/paxeer/fork-rehearsal.sh:444-445)."
halt = "--halt-height (sdk/server/start.go:46) stops each node after committing HR (sdk/baseapp/abci.go:310, sdk/baseapp/abci.go:322)."
apply = "The new binary applies v6.12.0 in HR+1 (node/upgrades.go:574-604) once per node."
assertions = "Applied height, version, block hashes, served precompiles (tools/chain/upgrade-replay/replay.go:338-358 rule) with 0x1026 and 0x1027 answering 0x, pool count and reserves (Launch-x:contracts/contracts/interfaces/IPoolRegistry.sol:63; Launch-x:contracts/contracts/interfaces/ISidioraPool.sol:65-69), eighteen markets, getPrice(m).fresh for every market, one feed key per validator, the programme checks of task 8.4.20 and the rollback leg restoring the application hash at HR."
result = "rehearsal-result.env extends the keys of platform/hosted/paxeer/fork-rehearsal.sh:568-576 with pools, markets, oracle_fresh, feed_keys, precompiles_served and rollback_rehearsed."

[contract_context.8.rollout]
mechanism = "Operator-file path: halt-height (sdk/server/config/toml.go:42) at H, upgrade file at H1, restart on v6.12.0; the governance path of docs/runbooks/paxeer-x-fork.md:119-214 is not used."
order = "Halt-height approval, preflight, stage, old feeder stop and automation pause, freeze at H, snapshot of every validator and full-node home, full-node swap, validator swap, feed-key registration and sidecar install, cut-over of data services and application, lagging nodes, resume automation, rollback readiness, post-rollout verification and the spot-open build."
invariants = "No v6.12.0 unit runs before every validator committed H; exact-name process checks; atomic swaps with sha check; automation paused for the window; the archive node never recloned."
self_remediation = "blocks-behind-threshold (consensus/config/toml.go:627; consensus/config/config.go:1514) may be set to 0 for the window and restored after."
inputs = "Every rollout variable is a key of tools/release/env/rollout.env.example and every rehearsal variable a key of tools/release/env/rehearsal.env.example, each empty in the tree; the chosen halt height and the filled operator input table live in access-controlled storage and halt-height.json records only their sha256 and approval (decision.11)."

[contract_context.8.rollback]
procedure = "On a failed check every node halts; rollback.sh --execute on every validator and full-node home stops the units, moves data to data.v6.12.0-<RELEASE_ID>, extracts the snapshot taken at H with priv_validator_state.json, restores paxd.pre-<RELEASE_ID> atomically, removes data/upgrade-info.json, sets halt-height = 0 and restarts; the whole fleet is restored in one window and validators sign H1 again on the previous binary."
set_aside = "data.v6.12.0-<RELEASE_ID> is kept and never started."
material = "Previous binaries and the snapshots of every home are kept until post-rollout verification passes; rollback.sh --readiness checks them after the snapshot step."

[contract_context.8.verification]
script = "python3 tools/release/fleet_check.py --env-file <file> --phase <phase> exits 0 only when every check of every node passes."
checks = "Version from abci_info (consensus/internal/rpc/core/routes.go:71), height and catching_up from status (consensus/internal/rpc/core/routes.go:38), block hash from block (consensus/internal/rpc/core/routes.go:46), presence by view call since GetCode reads only the code store (modules/evm/keeper/code.go:15-21), 0x1026 and 0x1027 without code, pools at 0x1017 (modules/launchpad/types/keys.go:26), totalMarkets() at 0x1015 and getMarketCount() at 0x1020, getPrice(m).fresh, getFeedKey per validator, the uhpx and SID pointers through getNativePointer of 0x100A (precompiles/pointerview/pointerview.go:18, precompiles/pointerview/pointerview.go:24), USDL decimals() 6, and /healthz/ready of every data service and /api/build-id of the application."
receipt = "Every receipt uses keys of one set only: version, plan, nodes_checked, nodes_passed, precompiles_served, pools, markets, oracle_fresh, feed_keys, homes_archived, hosts_staged, units_active, services_ready, readiness, rollback_executed, rollback_rehearsed, new_bin_sha256, inputs_sha256, inputs_approved, tag, release_sha256 and result."

[task.8.4.1]
title = "Set the release identity to v6.12.0 and test it"
status = "pending"
mode = "BUILD"
wave = 4
requires = ["1.0.3", "1.0.5", "8.4.2"]
reqs = ["8001.1", "8001.2", "8001.3", "8001.4"]
capabilities = ["8.1.1"]
do_1 = "Set version v6.12.0 and upgrade v6.12.0 in tools/release/version.json:2-3 (decision.1)."
do_2 = "Write tools/release/tests/identity.test.sh with version_and_upgrade_are_v6120 reading the file as tools/release/build-paxd.sh:19 does."
do_3 = "Add upgrade_name_is_declared grepping node and modules for the exact declaration V6120Upgrade = \"v6.12.0\" of node/upgrades_v6120.go (task 1.0.3), so the custody constant of task 1.0.5 alone does not satisfy it."
do_4 = "Add version_is_newer_than_latest_tag in a scratch repository with the logic of .github/workflows/paxeer-release-check.yml:57-65, and tag_is_free_and_derived against .github/workflows/paxeer-release-check.yml:51-55 and tools/release/build-paxd.sh:20 through build-paxd.sh --print-tag of task 8.4.2."
do_5 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["version_and_upgrade_are_v6120", "upgrade_name_is_declared", "version_is_newer_than_latest_tag", "tag_is_free_and_derived"]
touches = ["tools/release/version.json", "tools/release/tests/identity.test.sh"]
build_cmd = "bash -n tools/release/tests/identity.test.sh"
verify_cmd = "bash tools/release/tests/identity.test.sh"
gate_kind = "planned"
planned_paths = ["tools/release/tests/identity.test.sh"]
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark complete without the declared evidence."
path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to their current equivalents before the gate can run; historical references never authorize a duplicate implementation tree. Complete scoped path reconciliation without dropping acceptance criteria."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

[task.8.4.2]
title = "Build paxd and price-sidecar for release with the kernel libraries, pinned toolchains and the upgrade document"
status = "pending"
mode = "BUILD"
wave = 4
requires = ["1.0.1", "1.3.100", "5.3.99", "8.4.5"]
reqs = ["8002.1", "8002.2", "8002.3", "8002.4", "8002.5", "8002.6", "8001.5", "8003.4", "8015.1"]
