[task.7.1.3]
title = "Spot, pricefeed and USDL event decoders"
status = "pending"
mode = "BUILD"
wave = 1
requires = ["7.1.2"]
reqs = ["7004.37", "7005.1", "7005.2", "7005.3", "7005.4", "7005.5", "7005.6", "7005.7", "7005.8", "7005.9", "7005.10", "7005.11", "7005.12", "7005.13", "7005.14", "7005.15", "7005.16", "7005.17", "7005.18", "7005.19", "7005.20", "7005.21", "7005.22", "7005.23", "7005.24", "7005.25", "7005.26", "7005.27", "7005.28", "7005.29", "7005.30", "7005.31", "7005.32", "7005.33", "7005.34", "7005.35", "7005.36", "7005.37", "7005.38", "7005.39", "7005.40", "7005.41", "7005.42", "7005.43", "7005.44", "7005.45", "7005.46", "7005.47", "7005.48", "7005.49", "7005.50", "7005.51"]
capabilities = ["7.2.3"]
do_1 = "spot.go registers the spot rows of the decoding table of contracts/data-services.md section 6 at PECOR 0x1021, PECOROrders 0x1022, PECORStopOrders 0x1023, PECORVault 0x1025 and the share pointers, from the leaf ABI package precompiles/spot/abi of the same commit; PriceImpactApplied and TieredFeeApplied are matched by topic0 at any of 0x1021 to 0x1025, and no decoder exists for 0x1024 (view only, no logs), 0x1026 or 0x1027 (no code)."
do_2 = "The spot order events carry no token: the decoder resolves token and stablecoin by eth_call at the event height with getLimitOrder(uint256) (0x53061026) on 0x1022 and getStopLimitOrder(uint256) (0x307ff324) and getStopLossOrder(uint256) (0x4c34cf02) on 0x1023, calls the latest height when that height is pruned on every node, and writes a zero record to raw_logs with failure_class order_lookup; side is buy for limit orderType 0, sell for 1, and sell for a stop-loss order."
do_3 = "ShareTokenCreated and TokenRegistered decode into perps.spot_token_registry; Transfer and Approval at a share pointer decode into perps.spot_share_transfers with share_token the emitter and token resolved from the pointer set, a Transfer from or to the zero address being a mint with account to or a burn with account from, and a pointer log whose token cannot be resolved goes to raw_logs with failure_class share_lookup."
do_4 = "pricefeed.go registers FeedKeyRegistered and FeedKeyRevoked at 0x1020 from the leaf ABI package precompiles/pricefeed/abi, and decodes each pricefeed_aggregate and pricefeed_aggregate_skipped of the finalize_block_events that Comet returns into one perps.index_prices row with receipt_kind block_event, tx_index -1, log_index its position, tx_hash the block hash and emitter 0x1020, basis signed; the other pricefeed Cosmos events are not decoded."
do_5 = "usdl.go declares the ERC20 Transfer event and decodes the Transfer logs of the USDL contract 0x85FcD13735F4309833A503EE804ea32395851479 whose from or to is the perps module EVM address or the spot module EVM address (contracts/address-table.md, module accounts) into perps.usdl_transfers with kind in when the custody address receives and out when it sends and venue that custody address; other USDL transfers are not stored."
do_6 = "Add TestDecoderColumnsMatchABI in decode/abi_test.go checking every row of the decoding table against the leaf ABI files (name, argument order, types, indexed flags) and asserting that go list -deps of internal/decode names no precompiles package other than the three abi packages and no modules/lxphost."
do_7 = "Add TestSpotDecoders with one subtest per spot and share pointer event plus order_token_lookup, order_token_latest_fallback, order_lookup_failure, order_side, share_pointer_passes, share_mint_burn, fee_events_by_topic and address_set against the node of PERPS_DATA_TEST_RPC; TestPricefeedDecoders with one subtest per pricefeed event plus other_events; and TestUSDLDecoder with subtests Transfer and venue_filter_and_tvl."
do_8 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
