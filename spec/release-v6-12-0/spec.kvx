verification_contract = "go test -count=1 ./platform/perps-data/internal/feeds/ -run 'TestFeeds'"
do_1 = "The perpetual book aggregates the perps.orders rows with status active, a non-zero limit_price and remaining_size_usd above 0 per market and limit_price, bids from is_long orders and asks from the others, each level summing remaining_size_usd, from orders and the OrderPlaced, OrderOptions, Fill, OrderCancelled and OrderExpired deltas; snapshots carry up to 100 levels per side, asks ascending and bids descending (Hyperpax:data_api.md:214, Hyperpax:data_api.md:341) (contracts/data-services.md section 10)."
do_2 = "Live book frames are coalesced to at most 10 per second per topic and carry the top 20 levels per side; every 5 seconds a frame carries checksum, the CRC32 (IEEE) of the top 20 levels written as price:size pairs joined by commas, asks then bids (contracts/data-services.md section 10)."
do_3 = "topics.go registers <SYMBOL>@perp_orderbook, @perp_trade (one frame per Fill), @perp_stats and @market for every market, <SYMBOL>@orderbook, @trade and @stats for PAX and SID only (the book from the open spot_orders of the token, bids from buy and asks from sell orders at target_price; trades from spot_swaps and executed spot orders), markets@all, markets@totals, chain@blocks (snapshot of 20) and chain@transactions (snapshot of 50), with the payloads of Hyperpax:data_api.md:234, Hyperpax:data_api.md:287, Hyperpax:data_api.md:364, Hyperpax:data_api.md:388, Hyperpax:data_api.md:498, Hyperpax:data_api.md:513, Hyperpax:data_api.md:534, Hyperpax:data_api.md:611 and Hyperpax:data_api.md:647 (contracts/data-services.md section 10)."
do_4 = "No kline topic exists and candles stay on the Chainflow feed (contracts/data-services.md section 12); a subscribe to <SYMBOL>@kline_<interval>, to a spot topic of a symbol other than PAX and SID or to an unknown symbol answers the error unknown_topic. The socket paths /ws/<symbol>, /ws/markets and /ws/explorer subscribe on open to the topics of the symbol, to markets@all and markets@totals, and to chain@blocks and chain@transactions."
do_5 = "Stats and market providers broadcast every 30 seconds and every 5 seconds respectively and on subscribe; @market broadcasts only while it has a subscriber (contracts/data-services.md section 10)."
do_6 = "Add TestFeeds with one subtest per topic family plus book_ordering, book_rate_limit, book_checksum, perp_trade_once_per_fill, spot_unknown_symbol, unknown_symbol_topic, no_kline_topic, symbol_socket_autosubscribe and explorer_socket (contracts/data-services.md section 10)."

[capability.7.3.6]
title = "GraphQL schema and the graphql-go dependency"
reqs = ["7001.1", "7013.42", "7015.21", "7015.23"]
touches = ["platform/perps-data/internal/graphql/schema.go", "platform/perps-data/internal/graphql/schema_test.go"]
tests = ["platform/perps-data/internal/graphql/schema_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/internal/graphql/ -run 'TestSchemaSDL'"
do_1 = "The graphql-go module comes from task 7.0.1, which adds it with go get at a pinned version and both go.sum lines; this task changes neither go.mod nor go.sum (contracts/data-services.md section 14)."
do_2 = "graphql.SDL is the schema of the application (Hyperpax:src/core/perps/perpetual.graphql:569) with every type from Market to SpotBatchClearFailure (Hyperpax:src/core/perps/perpetual.graphql:13, Hyperpax:src/core/perps/perpetual.graphql:988) (contracts/data-services.md section 14)."
do_3 = "Required change against the application schema: add Query.leaderboard(limit: Int, offset: Int): [LeaderboardEntry!]! and UserVault.marginMode: Int, which the application reads but the schema lacks (Hyperpax:src/hooks/perps/useSubgraph.ts:236, Hyperpax:src/hooks/perps/useSubgraph.ts:205), and a Subscription type with the seven subscription fields of Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:10-16 (contracts/data-services.md section 14)."
do_4 = "Required change for the PerfDB operations on the same endpoint (Hyperpax:src/core/perfdb/client.ts:117-120): Query.userStats takes userAddress or address, both optional, exactly one required (Hyperpax:src/core/perps/perpetual.graphql:655), and UserStats (Hyperpax:src/core/perps/perpetual.graphql:454) gains address, totalPnl, totalVolume, totalFeesPaid, winCount, lossCount and liquidationCount; Query gains user, userBalances, userDailyPnl, userAlerts, userReferrals, referralTiers, competitions and competition; Subscription.priceUpdated takes marketId: Int, nullable, and Subscription gains tradeExecuted(marketId: Int) (Hyperpax:src/hooks/perps/usePerfdbSubscriptions.ts:35, Hyperpax:src/hooks/perps/usePerfdbSubscriptions.ts:68) (contracts/data-services.md section 14)."
do_5 = "NewSchema(db) parses SDL with the Resolver and graphql.UseFieldResolvers, MaxDepth 10 and MaxParallelism 20, so an over-deep query is refused before any database read (contracts/data-services.md section 14)."
do_6 = "Add TestSchemaSDL with subtests parses, leaderboard_root, margin_mode_field, subscription_fields, perfdb_roots and depth_limit, parsing SDL through NewSchema and asserting the added fields and the refusal of a query deeper than 10 (contracts/data-services.md section 14)."

[capability.7.3.7]
title = "Perpetuals query resolvers"
reqs = ["7013.1", "7013.2", "7013.3", "7013.4", "7013.5", "7013.6", "7013.7", "7013.8", "7013.9", "7013.10", "7013.11", "7013.12", "7013.13", "7013.14", "7013.15", "7013.16", "7013.17", "7013.18", "7013.19", "7013.20", "7013.21", "7013.22", "7013.23", "7013.24", "7013.25", "7013.26", "7013.27", "7013.28", "7013.29", "7013.30", "7013.31", "7013.32", "7013.33", "7013.34", "7013.35", "7013.36", "7013.37", "7013.38", "7013.39", "7013.40", "7013.41", "7013.42", "7013.43", "7013.44"]
touches = ["platform/perps-data/internal/graphql/perps.go", "platform/perps-data/internal/graphql/perps_test.go"]
