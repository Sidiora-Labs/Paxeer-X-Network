do_3 = "Remap the intent table (human/crates/layerx-intents/src/precompile.rs:1005-1014) and the vocabulary variants (human/crates/layerx-intents/src/vocabulary.rs:134-145) (symbol IntentKind)."
do_4 = "Extend precompile_router.rs next to human/crates/layerx-intents/tests/precompile_router.rs:203 with the new decode cases (symbol launchpad_v6120_events_decode)."

