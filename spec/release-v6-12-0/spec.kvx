do_1 = "SeedV6120 (symbol SeedV6120) writes the 18 markets of Hyperpax:src/core/perps/config.ts:168-185 at 1000x, with listedAt set to the activation block time."
do_2 = "InitGenesis and ExportGenesis (symbol InitGenesis) as modules/launchpad/module.go:106-113."
do_3 = "RegisterInvariants (symbol RegisterInvariants) as modules/launchpad/keeper/invariants.go:13-20."
do_4 = "AppModule (symbol AppModule) with ConsensusVersion 1 as modules/launchpad/module.go:128."

[capability.3.3.5]
title = "v6.9 service through the baseline version switch"
reqs = ["3019.2", "3019.3", "3019.1", "3019.4"]
touches = ["precompiles/perps/testdata/v69_vectors.json", "precompiles/perps/switch_test.go"]
tests = ["precompiles/perps/switch_test.go"]
verification_contract = "go test ./precompiles/perps/... -run 'TestVersionSwitch'"
do_1 = "Record the v6.9 call vectors from precompiles/layerxexchange/layerxexchange_test.go into testdata/v69_vectors.json (symbol TestVersionSwitchV69Vectors); precompiles/layerxexchange stays unchanged."
do_2 = "Replay the vectors through exchangeVersionSwitch of baseline task 1.2.1 with the live flag false and compare return data and logs (symbol TestVersionSwitchV69Vectors); no GetVersioned entry and no versions edit."
do_3 = "With the live flag true, selectors the perps ABI does not declare, pushOracle(bytes,bytes) included, revert with empty data (symbol TestVersionSwitchV69Vectors)."
do_4 = "Constructors reach the switch through baseline task 1.3.100 at node/app.go:961-965 (precompiles/layerxexchange/layerxexchange.go:140 beside precompiles/perps NewPrecompile); node/tags gets no line and the generated legacy layout is owned by layerx-merge task 3.7.5 (symbol exchangeVersionSwitch)."

[capability_group.3.4]
title = "Integration"
children = ["3.4.1", "3.4.2"]

[capability.3.4.1]
title = "Integration and replay"
reqs = ["3023.3", "3021.4", "3021.5", "3019.1", "3019.4"]
touches = ["precompiles/perps/integration_test.go", "modules/perps/keeper/scenario_test.go", "modules/perps/keeper/events_reconstruct_test.go"]
tests = ["precompiles/perps/integration_test.go", "modules/perps/keeper/scenario_test.go", "modules/perps/keeper/events_reconstruct_test.go", "precompiles/perps/switch_test.go"]
verification_contract = "go test ./modules/perps/... ./precompiles/perps/... -run 'TestIntegration|TestScenario|TestEventsReconstruct|TestVersionSwitch'"
do_1 = "Drive the application flow (approve USDL to 0x1015, createVault, deposit, openPosition, setPositionTpSl, partialClose, closePosition, withdraw) as signed EVM transactions in committed blocks of a real application (testutil/processblock/common.go:36, :72), read the receipts back and find the EndBlock receipt through getTxHashesFromBlock (rpc/utils.go:533-553) of baseline task 1.0.6 (symbol TestIntegrationApplicationFlow)."
do_2 = "Replay scenarios twice for determinism (symbol TestScenarioDeterminism) with the invariants of modules/launchpad/keeper/invariants.go:20 as pattern."
do_3 = "Reconstruct from events (symbol TestEventsReconstruct) emitted through precompiles/common/evm_events.go:16."
do_4 = "Replay v6.9 vectors (symbol TestVersionSwitchV69Vectors) through the switch of baseline task 1.2.1 to the executor of precompiles/layerxexchange/layerxexchange.go:198."

[capability.3.4.2]
title = "Domain completion"
