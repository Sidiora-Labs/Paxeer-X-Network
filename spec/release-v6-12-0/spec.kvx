do_2 = "Pay claims from EpochBalance (modules/launchpad/keeper/history.go:155) with the residue rule of Launch-x:contracts/contracts/data/FeeAccumulator.sol:248-267 (symbol Keeper.ClaimAirdropForEpoch)."
do_3 = "Record balance changes in BeforeBalanceChange (modules/launchpad/keeper/history.go:110) and refuse bank sends of BEFORE_TOKEN_TRANSFER denoms not marked by the precompile (symbol Keeper.BeforeBalanceChange)."
