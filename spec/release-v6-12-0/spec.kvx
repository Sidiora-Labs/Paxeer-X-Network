[capability.7.3.10]
title = "GraphQL subscriptions over graphql-transport-ws"
reqs = ["7016.1", "7016.2", "7016.3", "7016.4", "7016.5", "7016.6", "7016.7", "7016.8", "7016.9", "7016.10", "7026.12", "7026.13"]
touches = ["platform/perps-data/internal/graphql/subscriptions.go", "platform/perps-data/internal/graphql/transportws.go", "platform/perps-data/internal/graphql/subscriptions_test.go"]
tests = ["platform/perps-data/internal/graphql/subscriptions_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/internal/graphql/ -run 'TestSubscriptions'"
do_1 = "transportws.go serves /graphql-ws with the graphql-transport-ws subprotocol (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:5): connection_init and connection_ack within 10 seconds, subscribe, next, error, complete, ping and pong; one socket multiplexes many subscriptions (contracts/data-services.md section 15)."
do_2 = "The same transport answers a graphql-transport-ws upgrade on /graphql, the wsUrl the PerfDB client builds (Hyperpax:src/core/perfdb/client.ts:120); priceUpdated with marketId null streams every market (contracts/data-services.md section 15)."
do_3 = "subscriptions.go resolves indexerStatusUpdated (changes of perps.cursors), latestPricesUpdated (inserts into perps.mark_prices), priceUpdated(marketId) (inserts into perps.index_prices of kind aggregate), positionChanged(userAddress), orderChanged(userAddress), tradeCreated(marketId) (inserts into perps.trade_settlements) and liquidationCreated(marketId) (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:80, Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:135, Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:164, Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:197, Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:228, Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:259) from the JetStream subjects of contracts/data-services.md section 3 through the hub of internal/ws."
do_4 = "positionChanged and latestPricesUpdated return lists (Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:182, Hyperpax:src/hooks/perps/useIndexerSubscriptions.ts:121); the others return one object per event (contracts/data-services.md section 15)."
do_5 = "At most 100 subscriptions per socket; a rewind message sends the current state again on every affected subscription (contracts/data-services.md section 15)."
do_6 = "Add TestSubscriptions with one subtest per subscription field plus init_timeout and multiplex over a real websocket against an in-process nats-server (contracts/data-services.md section 15)."

[capability.7.3.11]
title = "Chain explorer queries with network explorer links"
reqs = ["7017.1", "7017.2", "7017.3", "7017.4", "7017.5", "7017.6", "7017.17"]
touches = ["platform/perps-data/internal/explorer/explorer.go", "platform/perps-data/internal/explorer/explorer_test.go"]
tests = ["platform/perps-data/internal/explorer/explorer_test.go"]
verification_contract = "go test -count=1 ./platform/perps-data/internal/explorer/ -run 'TestExplorer'"
do_1 = "Blocks(limit) reads perps.blocks newest first with limit clamped to [1, 50], default 20 (Hyperpax:data_api.md:560, Hyperpax:data_api.md:562); Transactions(limit) reads perps.tx_actions with limit clamped to [1, 200], default 50 (Hyperpax:data_api.md:578) (contracts/data-services.md section 16)."
do_2 = "Action maps the rows to the six action values of Hyperpax:data_api.md:600-601 by the action mapping of contracts/data-services.md section 16: Place Order (OrderPlaced, LimitOrderCreated, StopLimitOrderCreated, StopLossOrderCreated), Cancel Order (OrderCancelled, OrderExpired, LimitOrderCancelled, LimitOrderExpired, StopLimitCancelled, StopLossOrderCancelled), Modify Order (LimitOrderModified, PositionTpSlSet, OrderTriggered, StopLimitActivated), OROB Fill (one row per Fill with user the taker, and the executed spot orders, MarketOrderExecuted, NativeSwap and SimpleSwap), Oracle Updated (one row per block with pricefeed_aggregate events, hash the block hash) and Sealed Batch Executed (one row per perps_endblock and spot_endblock receipt)."
do_3 = "Rows carry user as the bech32 form with prefix pax (node/const.go:5) of the row account and blocks carry proposer as the upper-case hex of the CometBFT header; a synthetic receipt hash is rendered from the stored rows only, never through eth_getTransactionByHash (contracts/data-services.md section 16)."
do_4 = "AccountHistory(account, cursor, limit) and MarketHistory(market, cursor, limit) page through pnl.History and tx_actions with a keyset cursor (block, tx_index, log_index) (contracts/data-services.md section 16)."
do_5 = "TxLink(hash) and AddressLink(addr) prefix PERPS_EXPLORER_TX_BASE with /tx/ and /address/, so each row links to the network explorer; with the variable empty the link field is omitted (contracts/data-services.md section 16)."
do_6 = "Add TestExplorer with subtests blocks_clamp, transactions_clamp, action_mapping, user_proposer_synthetic, account_history_paging, market_history_paging and tx_links against PERPS_DATA_TEST_DATABASE_URL (contracts/data-services.md section 16)."

