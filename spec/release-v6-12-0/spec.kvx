test = "Hyperpax:tests/e2e-local-node.test.ts::withdrawalBalances (planned)"
qualification = "UNRUN"

[contract_context.6.addresses]
interface = "PRECOMPILES in src/core/network/precompiles.ts (planned) is the only source of chain addresses: perps 0x1015, pricefeed 0x1020, spot 0x1021 to 0x1025, each overridable through the envAddress pattern of Hyperpax:src/core/spot/addresses.ts:23-27."
storage = "No address is persisted; overrides are build-time environment values and a malformed value fails module load."
errors = "An override that is not 20 bytes throws with the variable name."
gate = "tests/precompiles.test.ts"
invariants = "USDL has one address (contracts/libraries/Constants.sol:14-16); chain id 125 comes from paxeerChain (Hyperpax:src/core/chain.ts:16-17); PECORVaultShare and PECORRouter have no caller in the application."

[contract_context.6.abi]
interface = "PerpsPrecompileABI is generated from contracts/perps.md; the spot ABI files keep the selectors listed in contracts/spot.md."
storage = "The generated modules are as-const TypeScript in the shape of Hyperpax:src/core/network/abi/PositionFacet.ts:1-2."
errors = "A selector drift fails tests/spot-abi.test.ts and an argument drift fails pnpm tsc --noEmit."
gate = "tests/perps-abi.test.ts and tests/spot-abi.test.ts"
invariants = "No hook imports a facet ABI (Hyperpax:src/core/network/abi/index.ts:2-15)."

[contract_context.6.perps_calls]
interface = "Pure builders in src/core/perps/calls.ts return { address, abi, functionName, args } for every perpetuals method the application calls, as the call-site table of contracts/application.md#perpetual-call-sites lists them."
storage = "Builders hold no state; hooks pass their output to writeContract (Hyperpax:src/hooks/perps/useContract.ts:49-101)."
errors = "Builders reject a zero amount, a leverage below 1x and an inverted TP/SL pair before any call is built."
gate = "tests/perps-calls.test.ts"
invariants = "Every market-priced write carries acceptablePrice and deadline; collateral amounts are USDL base units at 6 decimals."

[contract_context.6.order_plan]
interface = "buildOrderPlan(formState, quote) in src/core/perps/orderPlan.ts returns the ordered calls handleSubmit (Hyperpax:src/widgets/trading/PerpsOrderForm.tsx:444-506) sends."
storage = "The form keeps its React state; the plan is recomputed on every submit."
errors = "An invalid input returns an error code and no calls."
gate = "tests/order-plan.test.ts"
invariants = "A scaled ladder has 2 to 20 rungs whose sizes sum exactly to the order size."

[contract_context.6.account]
interface = "The connected address holds one USDL cross-margin account at 0x1015; useAccount (planned) replaces the per-user vault of Hyperpax:src/hooks/perps/useVault.ts:8-24."
storage = "Balances live in the perpetuals precompile; the application caches nothing between renders."
errors = "Withdraw above the available balance reverts and is classified, never retried with a larger approval."
gate = "tests/perps-calls.test.ts"
invariants = "No createVault, setMarginMode or emergencyWithdraw call remains (decision.4)."

[contract_context.6.amounts]
interface = "USDL amounts use 6 decimals through safeParseUnits (Hyperpax:src/core/perps/amounts.ts:26-38); prices, sizeUsd and leverage use 18."
storage = "Amounts are bigint from parse to encode."
errors = "getCollateralDecimals throws for an unknown token instead of returning 18 (Hyperpax:src/core/perps/amounts.ts:45)."
gate = "tests/amounts.test.ts"
invariants = "No Number multiplication touches an on-chain amount."

[contract_context.6.approvals]
interface = "planApproval returns at most one approve call for exactly the amount of the call it precedes, to the spender SPOT_SPENDERS or PRECOMPILES.perps names."
storage = "Allowances are read fresh before each write."
errors = "An approve failure stops the plan before the trading call."
gate = "tests/approvals.test.ts"
invariants = "No approval equals 2^256 - 1 (Hyperpax:src/hooks/spot/useSpotApprovals.ts:32 is no longer used)."

[contract_context.6.time_in_force]
interface = "TimeInForce GTC, IOC, FOK, PostOnly and the reduceOnly flag ride on placeLimitOrder and placeStopLimitOrder; the spot IOC and FOK limit takes minTokenAmount from the limit price."
storage = "Form toggles map one to one onto call arguments."
errors = "A spot IOC fill beyond the limit reverts InsufficientOutput (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:78)."
gate = "tests/order-plan.test.ts and tests/spot-tif.test.ts"
invariants = "No form option is accepted without reaching a call argument."

[contract_context.6.tp_sl]
interface = "takeProfitPrice and stopLossPrice ride on openPosition, placeLimitOrder and placeStopLimitOrder; 0 means unset."
storage = "Attached prices live with the position or order in the precompile."
errors = "An inverted pair returns TRADE_TP_SL_INVALID (Hyperpax:src/core/errors/classify.ts:251-253)."
gate = "tests/order-plan.test.ts"
invariants = "For a long SL < reference < TP; for a short TP < reference < SL."

[contract_context.6.price_bound]
interface = "acceptablePrice from the quote entryPrice or exitPrice and DEFAULT_SLIPPAGE_BPS (Hyperpax:src/core/perps/config.ts:354); deadline from buildDeadline (Hyperpax:src/core/spot/slippage.ts:75)."
storage = "The quote is re-fetched when older than QUOTE_MAX_AGE_MS (Hyperpax:src/widgets/trading/PerpsOrderForm.tsx:178)."
errors = "A breached bound or passed deadline reverts and is classified."
gate = "tests/perps-calls.test.ts"
invariants = "Opens round against the trader's side by the bps, closes the opposite way, in integer arithmetic."

[contract_context.6.spot_calls]
interface = "Spot builders in src/core/spot/calls.ts target 0x1021 market, 0x1022 limit, 0x1023 stop and 0x1024 quoter with the argument lists of the current ABI files."
storage = "No spot state is held in the application beyond the user stream cache."
errors = "Spot custom errors are classified by classifyError."
gate = "tests/spot-calls.test.ts"
invariants = "The spot route stays gated (Hyperpax:src/pages/spot.tsx:2-3)."

[contract_context.6.gateway_rest]
interface = "gatewayUrls() derives every REST base from NEXT_PUBLIC_PERPS_GATEWAY_URL; route paths are unchanged."
storage = "Bases are build-time values."
errors = "A missing gateway variable fails module load with the variable name."
gate = "tests/gateway-config.test.ts"
invariants = "Chart candles keep FEED_ORIGIN (Hyperpax:src/core/feeds.ts:2)."

[contract_context.6.websocket]
interface = "One shared socket per origin speaks the frames of Hyperpax:data_api.md:24-84 with snapshot, seq and snapshotId."
storage = "Per-topic book state with its last seq."
errors = "A gap closes with 4000 and resyncs from REST; 1013 and retry-after delay the reconnect (Hyperpax:src/core/net/realtime.ts:84-85)."
gate = "tests/orderbook-stream.test.ts and tests/realtime.test.ts"
invariants = "No delta at or below the applied snapshot seq is applied."

[contract_context.6.graphql]
interface = "The 51 queries, seven subscriptions and the PerfDB operations keep their names on the gateway GraphQL endpoint."
storage = "The golden list in tests/graphql-operations.test.ts is the pinned operation set."
errors = "An operation missing from the gateway list fails the golden test."
gate = "tests/graphql-operations.test.ts"
invariants = "The application operation set is a subset of the operations contracts/data-services.md serves."

[contract_context.6.wallet]
interface = "The embedded wallet signs as today; the auth client uses PKCE and exchanges the code only on the callback page."
storage = "Sessions are stored by the auth client after the callback exchange."
errors = "A failed exchange leaves no session and returns to sign-in."
gate = "tests/embedded-auth.test.ts and tests/embedded-wallet.test.ts"
invariants = "Chain id 125 from paxeerChain; transactions target the address table only."

[contract_context.6.errors]
interface = "classifyError decodes custom errors against the precompile ABIs before its string rules."
storage = "The mapping is a constant table in classify.ts."
errors = "Undecodable revert data keeps RPC_REVERT (Hyperpax:src/core/errors/classify.ts:153-160)."
gate = "tests/classify-precompile.test.ts"
invariants = "Every custom error of contracts/perps.md#errors has one application code."

[contract_context.6.end_to_end]
interface = "tests/e2e-local-node.test.ts runs the trading round trip against a local node at v6.12.0 and the gateway."
storage = "The test key and node endpoint come from LOCAL_NODE_RPC and LOCAL_NODE_KEY in the environment."
errors = "A missing endpoint fails the test with the variable name; it never skips."
gate = "tests/e2e-local-node.test.ts"
invariants = "USDL balance arithmetic closes to the base unit net of the fees in the receipts' events."

