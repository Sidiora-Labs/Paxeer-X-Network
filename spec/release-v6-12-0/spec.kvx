[req.6017]
title = "The embedded wallet signs as today with a callback-only PKCE session"
ac_1 = "getWallet, signTransaction, sendTransaction and signMessage (Hyperpax:src/core/wallet/embedded/sdk/index.ts:105, :118, :123, :128) and the EIP-1193 cases (Hyperpax:src/core/wallet/embedded/eip1193.ts:224, :239, :254, :261, :268-275) are unchanged."
ac_2 = "The auth client is created with flowType pkce instead of the default flow of the options at Hyperpax:src/core/wallet/embedded/sdk/index.ts:47-53."
ac_3 = "detectSessionInUrl is false (Hyperpax:src/core/wallet/embedded/sdk/index.ts:51) and Hyperpax:src/pages/auth/callback.tsx performs the code exchange explicitly."
ac_4 = "The embedded wallet chain id comes from paxeerChain (Hyperpax:src/core/chain.ts:16-17) instead of the literal at Hyperpax:src/core/wallet/embedded/client.ts:41."
ac_5 = "Embedded-wallet transactions target the addresses of the address table only."

[req.6018]
title = "Precompile revert data is classified into the application's error codes"
ac_1 = "classifyError (Hyperpax:src/core/errors/classify.ts:266) decodes custom error names from revert data before the string rules at :239-255."
ac_2 = "InsufficientLiquidity (Hyperpax:src/core/network/spot_abi/PECOROrders.ts:949) maps to TRADE_INSUFFICIENT_LIQUIDITY and PriceAboveTarget and PriceBelowTarget (:1036, :1041) to TRADE_SLIPPAGE_EXCEEDED."
ac_3 = "Expired (Launch-x:contracts/contracts/meta-ag/engine/PECOR.sol:77) maps to RPC_REVERT with the deadline message and LimitMustBeAboveStopBuy and LimitMustBeBelowStopSell (Hyperpax:src/core/network/spot_abi/PECORStopOrders.ts:1309, :1314) to TRADE_TP_SL_INVALID."
ac_4 = "Each custom error of contracts/perps.md#errors maps to the code named beside it, and undecodable revert data keeps the RPC_REVERT path (Hyperpax:src/core/errors/classify.ts:153-160)."

[req.6019]
title = "The application completes the trading round trip against a local node"
ac_1 = "tests/e2e-local-node.test.ts (planned) deposits 100 USDL after an exact approval to 0x1015 and reads the balance back."
ac_2 = "It opens a 20x market long on market 0 with TP and SL, places and cancels a limit order and adds 10 USDL collateral."
ac_3 = "It partially closes half the size and closes the rest with price bounds."
ac_4 = "It reads a funding payment for the account through the gateway GetFundingPayments operation (Hyperpax:src/hooks/perps/useSubgraph.ts:291)."
ac_5 = "It withdraws the available balance and the USDL balance arithmetic matches to the base unit net of the fees in the receipts' events."

