[meta]
name = "Paxeer X Network release v6.12.0: launchpad parity, perpetuals and spot precompiles, perps data services"
slug = "release-v6-12-0"
version = "1.0.0"
status = "draft"
goal = "One coordinated upgrade of the Paxeer X Network to v6.12.0 in which the launchpad precompile 0x1017 presents the exact interface of the deployed launchpad contracts and absorbs their pools, the perpetuals and spot venue runs natively in the chain as precompiles with a validator-run price sidecar, the Hyperpax application trades against those precompiles, and a dedicated indexer, gateway and portal serve the venue's data; the upgrade is applied by every validator and full node at one halt height and released as the first tagged build."
scope = "The node binary paxd (Cosmos SDK, EVM, precompiles, upgrade handler), the launchpad, perpetuals, spot and oracle precompiles and their keepers, the price sidecar, the perps data services in this repository, the launchpad backend bindings in github.com/Sidiora-Labs/Launch-x, the Hyperpax application in github.com/paxlabs-inc/Hyperpax, the release pipeline and the fleet upgrade runbook."
revision = "211acbc6c"
completion = "Every task verify_cmd passes at one revision; every acceptance criterion of req.1 to req.9 holds on that revision; the upgrade rehearsal on a local network applies plan v6.12.0 at a height, migrates the launchpad pools, opens the eighteen perpetual markets with sidecar prices, and the Hyperpax application completes a deposit, order, fill, funding payment and withdrawal through the precompiles."

[design]
flow = "Hyperpax application (wagmi/viem) or launchpad backend (abigen bindings) -> JSON-RPC of a full node -> EVM call to a precompile (0x1017 launchpad, 0x1015 perpetuals, spot and oracle addresses fixed in contracts/address-table.md) -> keeper state in the chain store -> EVM logs in the receipt -> indexer (this repository, platform/perps-data) -> Postgres and NATS JetStream -> gateway (REST, WebSocket, GraphQL) and portal."
domains = "One execution domain, paxd. Trading state lives in Go keepers and is exposed only through precompiles whose ABI is the public contract; no Solidity venue contract is deployed for the venue. Prices enter the chain through oracle transactions submitted by validator-run sidecars that read the Chainflow feed, aggregated deterministically per block."
native_constructs = "Existing: launchpad 0x1017 (rebuilt to the contract interface), layerxexchange 0x1015 (replaced by the perpetuals precompile at the activation height, the previous version kept below it under the legacy versioning pattern of precompiles/p256/legacy). New: spot precompile set, oracle precompile and its module, fee-right ERC721 and pool-token ERC20 surfaces served by the launchpad keeper."
activation = "One upgrade plan named v6.12.0 registered in node/upgrades.go; its handler migrates the launchpad pools, seeds the eighteen perpetual markets, registers the oracle set and switches the precompile versions. Every validator and full node halts at the plan height and restarts on the v6.12.0 binary."
data_services = "A new Railway project hosts the perps data services with their own Postgres and NATS; the services are Go programs in this repository that reuse the launchpad backend packages where the shapes match (shared/config, shared/ethclient, NATS JetStream helpers, abigen-by-role bindings)."

[execution]
planning_state = "Task completion requires the declared implementation and its verify_cmd evidence at one revision. A specification or task status alone establishes no runtime result."
task_policy = "Read the exact declared source and contract section, keep code that already meets the contract, implement every unmet criterion of the task, then run one bounded qualification pass. Implementation, qualification and activation evidence are recorded separately."
gate_policy = "Every planned gate is implemented by the task that owns its acceptance criteria. A verify_cmd names a target that exists at the revision or is listed in planned_paths with gate_kind planned; unknown, empty or skipped selectors are refused."
candidate_policy = "A passing gate is reused only while its source, inputs, scope and environment stay the same. Aggregate, sanitizer, cluster and upgrade-rehearsal gates run once per wave on the merged wave revision, not per task."
parallelism = "tasks in the same wave with disjoint touches run in parallel"
privacy = "Credentials, key material, operational inventories, host names and raw execution logs stay in access-controlled storage. Everything in this feature directory is public and is reviewed before publication."
ownership = "every path appears in the touches of exactly one task per wave"
citation_policy = "every do_n names the path:line it changes or reproduces; paths in the Launch-x repository carry the prefix Launch-x: and paths in the Hyperpax repository carry the prefix Hyperpax:"
requirement_ids = "req.1 to req.9 are the programme requirements. Each feature N declares its own requirements as req.<N><kkk> (N*1000+k, so req.3007 is requirement 7 of feature 3); a task reqs entry <id>.<a> names acceptance criterion a of that requirement."
external_revisions = "Launch-x citations are at commit c5eb7c7 of github.com/Sidiora-Labs/Launch-x; Hyperpax citations are at commit 242152b of github.com/paxlabs-inc/Hyperpax."

[req.1]
title = "The launchpad precompile presents the deployed contract interface and holds every pool"
ac_1 = "Every function, event and custom error of the launchpad contracts at their current deployment generation is served by the precompile with the same selector, argument encoding, return encoding and revert data."
ac_2 = "The quote asset is the USDL ERC20 with six decimals; pool creation, swaps and fee accrual move USDL through the precompile's module account."
ac_3 = "Every pool of the first and the current deployment generation exists in the precompile after the upgrade with its reserves, pool-token supply and holders, fee-right holders, accrued fees and hook configuration, and a read through the precompile returns the same values a read of the contract returned at the halt height."
ac_4 = "Fee rights are ERC721 tokens and pool tokens are ERC20 tokens whose transfer, approval and balance surfaces are served by the chain and visible to the explorer."
ac_5 = "The launchpad backend binds to the precompile address through its manifest role and every indexer, stats, chart, pnl and ranking service produces the same rows for a swap against the precompile as for a swap against the contract."

[req.2]
title = "The perpetuals venue runs natively as a precompile"
ac_1 = "Market, limit, stop-market, stop-limit, take-profit and stop-loss orders with good-till-cancel, immediate-or-cancel, fill-or-kill and post-only time in force, reduce-only, partial close and position-attached take-profit and stop-loss execute in the precompile with deterministic matching."
ac_2 = "Cross margin across every market with leverage up to 1000x, initial and maintenance margin tiers by notional, collateral deposit, withdrawal, top-up and transfer in USDL."
ac_3 = "Maker and taker fees by volume tier, a borrowing fee on open interest, funding every hour from the premium against the oracle price, a fee recipient account, an insurance fund, liquidation with partial close, backstop liquidation and auto-deleveraging follow the parameter sheet of contracts/perps-parameters.md."
ac_4 = "The eighteen opening markets exist at the activation height with the parameters of contracts/perps-markets.md and trade only while the oracle price is fresh."
ac_5 = "Every state change emits an EVM log with the signature of contracts/perps.md so the indexer reconstructs every position, order, fill, funding payment and liquidation from logs alone."

[req.3]
title = "The spot venue runs natively as a precompile"
ac_1 = "The spot interface the Hyperpax application calls (market buy and sell with slippage and deadline, limit and stop orders, quotes, liquidity info and vault shares) is served by the spot precompile set with the selectors the application already encodes."
ac_2 = "Spot fills settle USDL and the base token atomically inside the precompile with maker and taker fees from the parameter sheet."
ac_3 = "Every spot state change emits an EVM log with the signature of contracts/spot.md."

[req.4]
title = "Prices come from validator-run sidecars reading the Chainflow feed"
ac_1 = "Each validator runs a sidecar that reads the Chainflow feed for every listed symbol and submits signed price transactions to the chain at the configured cadence."
ac_2 = "The chain aggregates the submissions of the active validator set deterministically per block into one index and one mark price per market with a freshness window, and refuses trading and liquidation on a stale price."
ac_3 = "Oracle transactions from registered sidecar keys pay no fee and are bounded in size and rate."

[req.5]
title = "The Hyperpax application trades against the precompiles"
ac_1 = "Every contract call of the application resolves to a precompile address and the application completes deposit, order placement, cancel, fill display, position management, funding display and withdrawal against a node running v6.12.0."
ac_2 = "The application's data hooks read the gateway of this programme through REST, WebSocket and GraphQL with the operation set the application already issues."
ac_3 = "The audited amount, approval, time-in-force and take-profit and stop-loss handling of the application is corrected to the precompile semantics."

[req.6]
title = "The perps data services index and serve the venue"
ac_1 = "An indexer in this repository follows the chain head, decodes every precompile log into Postgres tables and publishes every row change on NATS JetStream with a monotonic sequence."
ac_2 = "A gateway serves markets, order books, trades, candles, positions, orders, fills, funding, liquidations, account history and leaderboards over REST, a shared WebSocket with snapshot and sequence resume, and GraphQL."
ac_3 = "A chain explorer service serves per-account and per-market trading history with transaction links, and a portal renders markets, accounts and venue statistics."
ac_4 = "The services deploy as container images from this repository to a dedicated Railway project with its own Postgres and NATS, with health endpoints and a replay-from-height tool."

[req.7]
title = "The node binary builds, tests and ships as v6.12.0"
ac_1 = "paxd builds from the main branch of this repository with the kernel library linked, in CI and in the release pipeline."
ac_2 = "The upgrade plan v6.12.0 is registered, its handler is covered by a test that applies it to a store seeded from a halt-height export, and the binary reports version v6.12.0."
ac_3 = "The release pipeline produces the tagged build v6.12.0 with its checksum and the upgrade-info document."

[req.8]
title = "The fleet applies the upgrade at one height"
ac_1 = "The runbook halts every validator and full node at the plan height, snapshots the validator homes, installs the v6.12.0 binary, restarts the fleet and verifies the precompile set, the migrated pools, the opening markets and the sidecar prices."
ac_2 = "The runbook names each operator input (halt height, maintenance window, public notice, build host) as a field filled in before execution."

[req.9]
title = "Every decision of this programme is recorded and normative"
ac_1 = "Every decision below is referenced by at least one resolution and every resolution applies to at least one task."

[decision.1]
title = "Previous unapplied plan"
value = "The unapplied plan v6.11 is removed from the plan table; every change it carried is folded into the v6.12.0 handler."
basis = "A plan that was registered but never applied carries no chain state (node/upgrades.go knownUpgradePlans)."
affects = ["node/upgrades.go", "tools/release/version.json"]

[decision.2]
title = "Launchpad generation and pool migration"
value = "The precompile is built to the interface of the current deployment generation (the manifest-active generation) and the v6.12.0 handler migrates the pools of both deployment generations into it."
basis = "The current manifest names the active generation (Launch-x:shared/config/deployment/current.json) and the first generation still holds the larger pool set (Launch-x:protocol/addresses.go)."
affects = ["precompiles/launchpad", "modules/launchpad", "node/upgrades.go"]

[decision.3]
title = "Launchpad quote asset, hooks and fee rights"
value = "The quote asset is the USDL ERC20 (six decimals); the hook system (opticals) is part of this release; fee rights are ERC721 tokens."
basis = "The contracts quote in USDL and expose hooks and fee-right tokens (Launch-x:contracts/contracts)."
affects = ["precompiles/launchpad", "modules/launchpad"]

[decision.4]
title = "Perpetuals economics"
value = "Maker and taker fees, volume tiers, borrowing fee, funding, margin tiers, liquidation and auto-deleveraging follow the structure of the Hyperliquid venue as written in contracts/perps-parameters.md; margin is cross; leverage is capped at 1000x; the opening markets are PAX, SID, NAS100, ETH, SPX500, BTC, BNB, SOL, HYPE, TSLA, GOOGL, XAU, NVDA, ASTER, LINK, XRP, TRUMP and AVAX."
basis = "The parameter sheet is derived from the published rules of that venue and recorded in the contract file with its formulas."
affects = ["precompiles/perps", "modules/perps", "contracts/perps-parameters.md", "contracts/perps-markets.md"]

[decision.5]
title = "Price oracle"
value = "A validator-run sidecar reads the Chainflow feed and submits prices on chain; the chain aggregates per block."
basis = "The application already reads the Chainflow feed (Hyperpax:src/core/feeds.ts) and the chain already runs validator-side sidecars for the web module."
affects = ["modules/pricefeed", "precompiles/pricefeed", "platform/hosted/feeder"]

[decision.6]
title = "Spot model"
value = "The spot venue is the PECOR interface the application calls, rebuilt as a precompile set where its semantics are expressible in keeper state; where the feasibility record in contracts/spot.md shows a method cannot be served, the continuous order book serves that method."
basis = "No spot contract has code on the chain; the application encodes the PECOR selectors (Hyperpax:src/core/network/spot_abi)."
affects = ["precompiles/spot", "modules/spot", "contracts/spot.md"]

[decision.7]
title = "Portal shape and explorer"
value = "The gateway serves REST and the shared WebSocket of the application's data protocol and a GraphQL endpoint with the full operation set of the application's schema; the chain explorer service is built in this repository and links each row to the network explorer."
basis = "Serving every protocol the application already speaks keeps every data path of the application live and gives the portal the richest data set."
affects = ["platform/perps-data"]

[decision.8]
title = "Hosting of the perps data services"
value = "A dedicated Railway project with its own Postgres and NATS hosts the perps data services."
basis = "The launchpad services keep their own project; separate projects isolate load and credentials."
affects = ["platform/perps-data/deploy"]

[decision.9]
title = "Code home of the data services"
value = "The indexer, gateway, explorer and portal live in this repository under platform/perps-data."
basis = "One repository builds the binary and the services that read its logs, so the ABI and the decoders change in one commit."
affects = ["platform/perps-data"]

[decision.10]
title = "Precompile version switch"
value = "The perpetuals precompile replaces 0x1015 at the activation height; the previous implementation stays registered below that height under the legacy versioning pattern so historical blocks replay."
basis = "The chain keeps a legacy precompile version per activation (precompiles/p256/legacy)."
affects = ["precompiles/layerxexchange", "precompiles/perps", "node/app.go"]

[decision.11]
title = "Operator inputs of the rollout"
value = "The halt height, the maintenance window, the public notice and the build host are operator inputs recorded in the runbook before execution; the specification carries them as fields, not values."
basis = "These values are chosen at execution time and stay in access-controlled storage."
affects = ["spec/release-v6-12-0/docs/rollout-runbook.md"]
# Domain 1: baseline build, upgrade plan v6.12.0, activation gating and node wiring.

[feature.1]
name = "baseline-build"
scope = "The paxd binary builds from main with the kernel library linked, a node build workflow gates every change, the plan table carries v6.12.0 in place of v6.11 with a handler that runs the four domain hooks, the binary reports v6.12.0, the upgrade-info document has a fixed shape, the new precompiles at 0x1015 and 0x1020-0x1027 are gated by the plan, and the new modules, precompiles and hooks are wired into node/app.go and node/upgrades.go."
requirements = ["1001", "1002", "1003", "1004", "1005", "1006", "1007", "1008", "1009", "1010"]
completion_task = "1.3.99"

[req.1001]
title = "paxd links the kernel library on every build path"
ac_1 = "The cgo host shim links liblayerx and the programs sandbox library through modules/lxphost/host.go:7 and includes the generated headers through modules/lxphost/host.go:6; every file of the shim is built only with cgo (modules/lxphost/host.go:1), and precompiles/layerxexchange/errors.go:7 places the shim in the dependency graph of paxd."
ac_2 = "A make target builds liblayerx (Makefile:46, Makefile:216-218), the generated checkpoint settlement header (Makefile:28, Makefile:232-235) and the release sandbox library (Makefile:3406, Makefile:3423-3425) before any Go build of paxd; required change: today no target orders the native libraries before the chain build (Makefile:3141-3142 forwards build to chain.mk without them)."
ac_3 = "The shim searches programs/target/release before `programs/target/debug`, so a release build of the sandbox library (Makefile:3406) satisfies the link without a debug build; required change at modules/lxphost/host.go:7."
ac_4 = "make test-lxphost builds the native libraries, then runs go test ./modules/lxphost/..., and TestHostLinksKernel (modules/lxphost/host_test.go:210) passes."
ac_5 = "make paxd-build produces build/paxd through the chain build (chain.mk:185-186) with the native libraries in place, and GOPROXY=off holds for the Go step as in paxeer-build (Makefile:3141-3142)."

[req.1002]
title = "A node build workflow gates every change to the node"
ac_1 = "A workflow .github/workflows/node-build.yml runs on push to main and on pull requests that touch node, modules, precompiles, engine, sdk, daemon, src, include, programs, Makefile or chain.mk; a new workflow file is enabled by default, unlike the cross-architecture build workflow whose build step (.github/workflows/paxeer-cross-arch-build.yml:176-186) is disabled in the repository Actions settings."
ac_2 = "Every job routes runs-on through the same expression as .github/workflows/ci.yml:22, so scripts/ci/runner-routing-check.sh accepts the file."
ac_3 = "The jobs are native-libs (make paxd-native-libs), paxd (make paxd-build then make paxd-version-check), lxphost (make test-lxphost) and node-tests (go test ./node/... ./modules/layerxcustody/...)."
ac_4 = "A final job node-build-gate needs every other job and fails when any of them did not succeed, so a required check names one job."

[req.1003]
title = "The plan table carries v6.12.0 and no longer carries v6.11"
ac_1 = "V611Upgrade (node/upgrades.go:104-112) and its handler registration (node/upgrades.go:204-206) are removed, per decision.1."
ac_2 = "node declares const V6120Upgrade = \"v6.12.0\", which satisfies the release check that greps node and modules for the upgrade name (.github/workflows/paxeer-release-check.yml:45-49)."
ac_3 = "knownUpgradePlans (node/upgrades.go:532-534) returns ActivationUpgrade, V610Upgrade, V6120Upgrade, MergeUpgrade in that order."
ac_4 = "RegisterUpgradeHandlers (node/upgrades.go:130-210) registers app.runV6120Upgrade under V6120Upgrade next to the v6.10 registration (node/upgrades.go:203)."
ac_5 = "The custody governance gate constant GovernanceActivationUpgrade (modules/layerxcustody/types/governance_activation.go:5) carries \"v6.12.0\", so GovernanceExecutionActive (modules/layerxcustody/keeper/keeper.go:38-46) opens at the v6.12.0 height."
ac_6 = "The governance activation test TestCustodyGovernanceV611ActivationBoundaries (node/upgrades_v611_test.go:26) is retargeted to V6120Upgrade with the same height boundaries."

[req.1004]
title = "The v6.12.0 handler runs the folded v6.11 work and the four domain hooks"
ac_1 = "runV6120Upgrade runs RunMigrations, then moveSidioraMintAuthority (node/upgrades_v611.go:115-134), then migrateSIDHolders (node/upgrades_v611.go:141), in the order runV611Upgrade uses today (node/upgrades_v611.go:98-110)."
ac_2 = "migrateSIDHolders keeps its rules: a chain that already migrated is skipped (node/upgrades_v611.go:142), the slot value wins over the listed balance (node/upgrades_v611.go:152-157), and a holder whose slot reads zero mints nothing (node/upgrades_v611.go:158-160); the holder list node/testdata/sid-holders.json (node/upgrades_v611.go:19-22) is a release input."
ac_3 = "After the folded steps the handler calls, in this order, launchpad MigrateV6120(ctx, k, evm), pricefeed InitV6120(ctx, k), perps SeedV6120(ctx, k) and spot InitV6120(ctx, k), so the price feed is initialised before the perpetuals markets that read it are seeded."
ac_4 = "A hook error aborts the plan: the handler returns \"upgrade v6.12.0: <hook>: <error>\" and the version map is not returned, so the upgrade keeper does not record a done height."
ac_5 = "While a hook is unbound the handler returns \"upgrade v6.12.0: hook <name> is not bound\" before any state is written, so the plan cannot apply partially."
ac_6 = "runV611Upgrade (node/upgrades_v611.go:98-110) is deleted; the SID helpers it calls stay in node/upgrades_v611.go."

[req.1005]
title = "The binary reports version v6.12.0"
ac_1 = "paxd version prints version.Version (sdk/version/command.go:15-24, sdk/version/version.go:26-34), which the build sets through -X github.com/Sidiora-Labs/Paxeer-X-Network/sdk/version.Version (chain.mk:65-69)."
ac_2 = "make paxd-build passes LDFLAGS carrying -X github.com/Sidiora-Labs/Paxeer-X-Network/sdk/version.Version set from the version key of tools/release/version.json (tools/release/version.json:2), appended to the chain ldflags (chain.mk:80), so the CI build and the release build (tools/release/build-paxd.sh:19) read one source."
ac_3 = "make paxd-version-check runs build/paxd version and fails unless the output equals the version key of tools/release/version.json; with that key at v6.12.0 the output is v6.12.0."
ac_4 = "The application version recorded by the base app comes from the same variable (node/app.go:593), so the node info and the CLI agree."

[req.1006]
title = "The upgrade-info document has a fixed shape"
ac_1 = "The document is upgrade-info.json (sdk/x/upgrade/keeper/keeper.go:28-29) under <home>/data (sdk/x/upgrade/keeper/keeper.go:434-442), written with mode 0600 (sdk/x/upgrade/keeper/keeper.go:414-431)."
ac_2 = "Its keys are name, height and the optional info (sdk/x/upgrade/keeper/keeper.go:479-486; sdk/store/types/store.go:56-59); for this release name is \"v6.12.0\" and height is the halt height plus one."
ac_3 = "A missing document means no upgrade (sdk/x/upgrade/keeper/keeper.go:453-476), and applyNamedUpgrade (node/upgrades.go:574-604) applies v6.12.0 only in the block whose height equals the document height and only when the plan is still pending (node/upgrades.go:594)."
ac_4 = "A test writes the document through DumpUpgradeInfoToDisk (sdk/x/upgrade/keeper/keeper.go:406-408), as writeV610UpgradeInfo does (node/upgrades_v610_test.go:20-27), reads it back and asserts exactly {\"name\":\"v6.12.0\",\"height\":<H+1>}."

[req.1007]
title = "The plan gates the new precompiles and switches 0x1015"
ac_1 = "A second activation entry v6120PrecompileGate names Upgrade V6120Upgrade with 0x1020 serving the pricefeed module and 0x1021-0x1027 serving the spot module, passed to SetCustomPrecompileActivation (modules/evm/keeper/keeper.go:207-241) beside activationPrecompileGate (node/upgrades.go:489-503)."
ac_2 = "0x1015 stays only in activationPrecompileGate (node/upgrades.go:496), because SetCustomPrecompileActivation refuses two entries naming one address (modules/evm/keeper/keeper.go:230-233)."
ac_3 = "Below the v6.12.0 done height the entry at 0x1015 serves the previous exchange implementation under precompiles/layerxexchange/legacy; at and above it the entry serves precompiles/perps NewPrecompile, following the legacy version map pattern of precompiles/p256/setup.go:15-24 (decision.10)."
ac_4 = "Ordinary execution serves versioned[latestUpgrade] (modules/evm/keeper/keeper.go:172-188), so the 0x1015 version map is reselected from state in RefreshPrecompiles (node/upgrades.go:271) as the xweb entry is (node/upgrades.go:266-295); tracing picks the version by done height (modules/evm/keeper/keeper.go:356-385) from keys ActivationUpgrade (legacy) and V6120Upgrade (perps)."
ac_5 = "A call to 0x1020-0x1027 before the v6.12.0 done height is not served: the address behaves as an account with no code, as for every address withheld by customPrecompileReached (modules/evm/keeper/keeper.go:333-350)."
ac_6 = "The giga executor hands 0x1020-0x1027 to the ordinary path: gigaCustomPrecompiles (node/app.go:2564-2569) returns, at and above gigaLatePrecompileHeight (node/app.go:2559), AllCustomPrecompilesFailFastLate (engine/executor/precompiles/failfast.go:128) plus the eight new addresses mapped to FailFastSingleton (engine/executor/precompiles/failfast.go:101)."

[req.1008]
title = "The plan mounts the new module stores"
ac_1 = "v6120StoreUpgrades adds the store keys of modules/perps, modules/spot and modules/pricefeed and deletes and renames none, in the shape of activationStoreUpgrades (node/upgrades.go:398-402)."
ac_2 = "layerxStoreUpgrades (node/app.go:1407-1421) returns v6120StoreUpgrades for V6120Upgrade, so SetStoreUpgradeHandlers (node/app.go:1321-1404) mounts the stores at the plan height through its layerx branch (node/app.go:1400-1403)."
ac_3 = "applyNamedUpgrade refuses to apply v6.12.0 when one of its stores is not mounted, as it refuses the activation plan (node/upgrades.go:597-600, node/upgrades.go:633-644), with the panic message naming the store."

[req.1009]
title = "The new modules, precompiles and hooks are wired and the plan applies to a halt-height export"
ac_1 = "ModuleBasics (node/app.go:268-279), the store keys (node/app.go:318-330), the keeper fields (node/app.go:476-482), keeper construction (node/app.go:802-811), the module manager (node/app.go:994-1003) and SetOrderInitGenesis (node/app.go:1052-1083) carry perps, spot and pricefeed beside launchpad (node/app.go:275, node/app.go:326, node/app.go:480, node/app.go:806-807, node/app.go:1000)."
ac_2 = "The custom precompile set built at node/app.go:961-965 adds precompiles/perps NewPrecompile, precompiles/pricefeed NewPrecompile and every entry of precompiles/spot NewPrecompileSet to the result of GetCustomPrecompiles (precompiles/setup.go:160-201), and launchpad keeps its registration (precompiles/setup.go:183)."
ac_3 = "PrecompileKeepers (node/precompiles.go:17-41) and NewPrecompileKeepers (node/precompiles.go:43-69) carry the perps, spot and pricefeed keepers."
ac_4 = "The v6.12.0 hook table binds modules/launchpad/keeper MigrateV6120, modules/pricefeed/keeper InitV6120, modules/perps/keeper SeedV6120 and modules/spot/keeper InitV6120, so no hook reports \"is not bound\"."
ac_5 = "TestV6120AppliesThePlanOnTheHaltExport seeds a test application from node/testdata/v6120-halt-export.json, writes the upgrade-info document for height H+1, runs BeginBlock at H+1 (node/abci.go:59) and asserts the v6.12.0 done height H+1, the four hooks' state, 0x1015 serving the perps version and 0x1020-0x1027 served."

[req.1010]
title = "The node domain passes its package test set once"
ac_1 = "make test-paxd-domain runs make test-lxphost and go test ./node/... ./modules/layerxcustody/... once against the wired tree and exits 0."
ac_2 = "The target depends on paxd-native-libs, so it runs on a clean checkout without a prior build."

[capability_group.1.1]
title = "Build and version"
children = ["1.1.1", "1.1.2", "1.1.3"]

[capability_group.1.2]
title = "Plan v6.12.0"
children = ["1.2.1", "1.2.2", "1.2.3", "1.2.4"]

[capability_group.1.3]
title = "Activation gating"
children = ["1.3.1", "1.3.2", "1.3.3"]

[capability_group.1.4]
title = "Wiring and domain completion"
children = ["1.4.1", "1.4.2", "1.4.3"]

[capability.1.1.1]
title = "Kernel link targets for paxd"
reqs = ["1001.1", "1001.2", "1001.3", "1001.4", "1001.5"]
touches = ["Makefile", "modules/lxphost/host.go"]
tests = ["modules/lxphost/host_test.go"]
verification_contract = "make test-lxphost"
do_1 = "Add target paxd-native-libs to Makefile depending on $(LIBRARY) (Makefile:46, rule Makefile:216-218), $(CHECKPOINT_SETTLEMENT_HEADER) (Makefile:28, rule Makefile:232-235) and programs-release-build (Makefile:3423-3425), so build/liblayerx.a, build/generated and programs/target/release/liblayerx_programs_sandbox.a (Makefile:3406) exist before Go builds."
do_2 = "In modules/lxphost/host.go:7 add -L${SRCDIR}/../../programs/target/release before the debug search path, keeping the library order -llayerx -llayerx_programs_sandbox -llayerx so the cyclic references resolve."
do_3 = "Add target paxd-build depending on paxd-native-libs that runs GOPROXY=off $(PAXEER_MAKE) build (Makefile:25, Makefile:3141-3142) with LDFLAGS carrying -X github.com/Sidiora-Labs/Paxeer-X-Network/sdk/version.Version from the version key of tools/release/version.json, which chain.mk appends (chain.mk:80)."
do_4 = "Add target test-lxphost depending on paxd-native-libs that runs CGO_ENABLED=1 go test ./modules/lxphost/..., covering TestHostLinksKernel (modules/lxphost/host_test.go:210) through TestHostAccountsRestore (modules/lxphost/host_test.go:589)."
do_5 = "Add target paxd-version-check that runs ./build/paxd version and compares it with the version key of tools/release/version.json, exiting 1 with both values printed when they differ (sdk/version/command.go:22-24 prints the short version)."
do_6 = "Add test-paxd-domain later in the completion task; keep paxd-release (Makefile:1447-1449) unchanged, since tools/release/build-paxd.sh belongs to the release domain."
symbols = ["paxd-native-libs", "paxd-build", "test-lxphost", "paxd-version-check"]

[capability.1.1.2]
title = "Node build workflow with a single gate job"
reqs = ["1002.1", "1002.2", "1002.3", "1002.4"]
touches = [".github/workflows/node-build.yml"]
tests = ["scripts/ci/runner-routing-check.sh"]
verification_contract = "scripts/ci/runner-routing-check.sh"
do_1 = "Create .github/workflows/node-build.yml with on.push.branches [main] and on.pull_request.paths covering node/**, modules/**, precompiles/**, engine/**, sdk/**, daemon/**, src/**, include/**, programs/**, Makefile and chain.mk."
do_2 = "Route runs-on of every job with the expression of .github/workflows/ci.yml:22 so fork pull requests use the hosted runner and the rest use vars.CI_LINUX_RUNNER."
do_3 = "Job native-libs runs make paxd-native-libs; job paxd runs make paxd-build and make paxd-version-check, the same check the cross-architecture workflow runs with ./build/paxd version --long (.github/workflows/paxeer-cross-arch-build.yml:176-186)."
do_4 = "Job lxphost runs make test-lxphost; job node-tests runs make paxd-native-libs then go test ./node/... ./modules/layerxcustody/..."
do_5 = "Job node-build-gate with if: always() needs native-libs, paxd, lxphost and node-tests and exits 1 unless every needs.<job>.result is success."
symbols = ["node-build.yml", "native-libs", "paxd", "lxphost", "node-tests", "node-build-gate"]

[capability.1.1.3]
title = "Version source shared by CI and release"
reqs = ["1005.1", "1005.2", "1005.3", "1005.4"]
touches = ["Makefile"]
tests = ["Makefile"]
verification_contract = "make paxd-version-check"
do_1 = "paxd-build reads the version key of tools/release/version.json (tools/release/version.json:2) with jq -r .version, the file build-paxd.sh reads (tools/release/build-paxd.sh:19)."
do_2 = "The value reaches version.Version (sdk/version/version.go:26-34) through the chain ldflags list (chain.mk:65-69, chain.mk:80); the git describe default (chain.mk:7-17) is overridden only for Version."
do_3 = "paxd-version-check compares the printed short version (sdk/version/command.go:22-24) with the version key and exits 1 on difference."
do_4 = "The base app version (node/app.go:593) and the node version info (node/app.go:614) read the same variable, so no node code changes for version reporting."
symbols = ["paxd-build", "paxd-version-check", "version.Version"]

[capability.1.2.1]
title = "Plan table without v6.11 and with v6.12.0"
reqs = ["1003.1", "1003.2", "1003.3", "1003.4", "1003.5", "1003.6"]
touches = ["node/upgrades.go", "node/upgrades_v611.go", "node/upgrades_v6120.go", "modules/layerxcustody/types/governance_activation.go", "modules/layerxcustody/handler.go"]
tests = ["node/upgrades_v611_test.go", "node/upgrades_v610_test.go", "node/upgrades_v6120_test.go", "modules/layerxcustody/handler_test.go"]
verification_contract = "go test ./node/ -run 'V6120|V610|CustodyGovernance'"
do_1 = "Delete V611Upgrade and its comment (node/upgrades.go:104-112) and the registration with its comment (node/upgrades.go:204-206)."
do_2 = "Declare const V6120Upgrade = \"v6.12.0\" in node/upgrades_v6120.go with a comment naming what the plan does: the folded custody and SID steps, the four hooks and the new stores."
do_3 = "Register app.UpgradeKeeper.SetUpgradeHandler(V6120Upgrade, app.runV6120Upgrade) in RegisterUpgradeHandlers after the v6.10 line (node/upgrades.go:203)."
do_4 = "Change knownUpgradePlans (node/upgrades.go:532-534) to []string{ActivationUpgrade, V610Upgrade, V6120Upgrade, MergeUpgrade}."
do_5 = "Set GovernanceActivationUpgrade (modules/layerxcustody/types/governance_activation.go:5) to \"v6.12.0\" and update the activation comment of modules/layerxcustody/handler.go:18-20 to name v6.12.0."
do_6 = "Retarget the plan list assertion (node/upgrades_v610_test.go:56) and the boundary test (node/upgrades_v611_test.go:26-27) to V6120Upgrade."
symbols = ["V6120Upgrade", "knownUpgradePlans", "RegisterUpgradeHandlers", "GovernanceActivationUpgrade"]

[capability.1.2.2]
title = "Handler skeleton with an ordered hook table"
reqs = ["1004.1", "1004.2", "1004.3", "1004.4", "1004.5", "1004.6"]
touches = ["node/upgrades_v6120.go", "node/upgrades_v611.go", "node/upgrades_v6120_test.go"]
tests = ["node/upgrades_v6120_test.go"]
verification_contract = "go test ./node/ -run V6120"
do_1 = "Add func (app *App) runV6120Upgrade(ctx sdk.Context, plan upgradetypes.Plan, fromVM module.VersionMap) (module.VersionMap, error) that runs RunMigrations, moveSidioraMintAuthority (node/upgrades_v611.go:115-134) and migrateSIDHolders (node/upgrades_v611.go:141) in the order of node/upgrades_v611.go:98-110."
do_2 = "Add type v6120Hook struct{ name string; run func(sdk.Context) error } and func (app *App) v6120Hooks() []v6120Hook returning launchpad MigrateV6120, pricefeed InitV6120, perps SeedV6120, spot InitV6120 in that order, each with a nil run until the wiring task binds it."
do_3 = "Before RunMigrations the handler walks v6120Hooks and returns fmt.Errorf(\"upgrade v6.12.0: hook %s is not bound\", name) for the first nil run, so no state is written."
do_4 = "After migrateSIDHolders the handler runs each hook and wraps a failure as fmt.Errorf(\"upgrade v6.12.0: %s: %w\", name, err), returning a nil version map."
do_5 = "Delete runV611Upgrade (node/upgrades_v611.go:98-110) and keep SidioraProxyAddress (node/upgrades_v611.go:26), the holder snapshot embed (node/upgrades_v611.go:19-22) and the two helpers."
do_6 = "Retarget TestV611IsAKnownPlanWithAHandler (node/upgrades_v611_test.go:102), TestV611MintsTheSlotBalancesZeroesThemAndMovesTheMintAuthority (node/upgrades_v611_test.go:110), TestV611RecordsTheUncoveredSupplyAsAClaimableShortfall (node/upgrades_v611_test.go:160) and TestV611RefusesAMintAboveTheLegacySupply (node/upgrades_v611_test.go:188) to the v6.12.0 handler with the same assertions."
symbols = ["runV6120Upgrade", "v6120Hook", "v6120Hooks", "moveSidioraMintAuthority", "migrateSIDHolders"]

[capability.1.2.3]
title = "Upgrade-info document for v6.12.0"
reqs = ["1006.1", "1006.2", "1006.3", "1006.4"]
touches = ["node/upgrades_v6120_test.go"]
tests = ["node/upgrades_v6120_test.go"]
verification_contract = "go test ./node/ -run TestV6120UpgradeInfoShape"
do_1 = "Add writeV6120UpgradeInfo(t, app, height) using DumpUpgradeInfoToDisk (sdk/x/upgrade/keeper/keeper.go:406-408), as writeV610UpgradeInfo does (node/upgrades_v610_test.go:20-27)."
do_2 = "TestV6120UpgradeInfoShape reads the file from GetUpgradeInfoPath (sdk/x/upgrade/keeper/keeper.go:434-442), decodes it into map[string]any and asserts exactly the keys name and height with values \"v6.12.0\" and H+1 (sdk/x/upgrade/keeper/keeper.go:479-486)."
do_3 = "The same test asserts the file mode 0600 written at sdk/x/upgrade/keeper/keeper.go:414-431."
do_4 = "TestV6120IsAppliedOnlyInTheNamedBlock runs BeginBlock at H and H+1 (node/abci.go:59) with the document present and asserts the done height is 0 after H and H+1 after H+1, following node/upgrades_v610_test.go:74-150."
symbols = ["writeV6120UpgradeInfo", "TestV6120UpgradeInfoShape", "TestV6120IsAppliedOnlyInTheNamedBlock"]

[capability.1.2.4]
title = "Store upgrades of the plan"
reqs = ["1008.1", "1008.2", "1008.3"]
touches = ["node/upgrades.go"]
tests = ["node/upgrades_v6120_test.go"]
verification_contract = "go test ./node/ -run 'V6120Store'"
do_1 = "Add func v6120StoreUpgrades() storetypes.StoreUpgrades with Added = perpstypes.StoreKey, spottypes.StoreKey, pricefeedtypes.StoreKey, beside activationStoreUpgrades (node/upgrades.go:398-402)."
do_2 = "Extend unmountedActivationStores (node/upgrades.go:633-644) into a per-plan helper unmountedPlanStores(name) and call it from applyNamedUpgrade (node/upgrades.go:597-600) for V6120Upgrade."
do_3 = "Add case V6120Upgrade: return v6120StoreUpgrades(), true to layerxStoreUpgrades (node/app.go:1407-1421) in the wiring task, since node/app.go is touched once per wave."
do_4 = "TestV6120StoreUpgradesAddOnlyTheNewModules asserts Added equals the three keys and Deleted and Renamed are empty."
symbols = ["v6120StoreUpgrades", "unmountedPlanStores", "applyNamedUpgrade", "layerxStoreUpgrades"]

[capability.1.3.1]
title = "Activation entry for 0x1020-0x1027"
reqs = ["1007.1", "1007.2", "1007.5"]
touches = ["node/precompiles_v6120.go", "node/precompiles_v6120_test.go"]
tests = ["node/precompiles_v6120_test.go"]
verification_contract = "go test ./node/ -run TestV6120PrecompileGate"
do_1 = "Add func v6120PrecompileGate() evmkeeper.CustomPrecompileActivation with Upgrade V6120Upgrade and Modules mapping 0x0000000000000000000000000000000000001020 to {\"pricefeed\"} and 0x...1021-0x...1027 to {\"spot\"}, in the shape of activationPrecompileGate (node/upgrades.go:489-503)."
do_2 = "Keep 0x1015 out of the entry: it is already gated by activationPrecompileGate (node/upgrades.go:496) and a second entry would panic at modules/evm/keeper/keeper.go:230-233."
do_3 = "TestV6120PrecompileGate passes {activationPrecompileGate(), v6120PrecompileGate()} to SetCustomPrecompileActivation (modules/evm/keeper/keeper.go:207-241) on a test application (node/test_helpers.go:128) and asserts no panic."
do_4 = "The same test asserts CustomPrecompiles (modules/evm/keeper/keeper.go:248-262) at a height below the v6.12.0 done height leaves out 0x1020-0x1027, and at the done height includes them (modules/evm/keeper/keeper.go:333-350)."
symbols = ["v6120PrecompileGate", "TestV6120PrecompileGate"]

[capability.1.3.2]
title = "Version switch at 0x1015"
reqs = ["1007.3", "1007.4"]
touches = ["node/precompiles_v6120.go", "node/precompiles_v6120_test.go"]
tests = ["node/precompiles_v6120_test.go"]
verification_contract = "go test ./node/ -run TestV6120ExchangeVersionSwitch"
do_1 = "Add func exchangeVersionSwitch(perps, legacy vm.PrecompiledContract, perpsLive bool) putils.VersionedPrecompiles returning {LatestUpgrade: perps, V6120Upgrade: perps, ActivationUpgrade: legacy} when perpsLive and {LatestUpgrade: legacy, ActivationUpgrade: legacy} otherwise, following precompiles/p256/setup.go:15-24."
do_2 = "Add func v6120PrecompileSet(all map[common.Address]putils.VersionedPrecompiles, xwebLive, perpsLive bool) that applies xwebPrecompileSet (node/upgrades.go:285) and replaces the 0x1015 entry (modules/layerxexchange/types/ids.go:15) through exchangeVersionSwitch."
do_3 = "Add func (app *App) perpsLive(ctx sdk.Context) bool returning app.UpgradeKeeper.GetDoneHeight(ctx, V6120Upgrade) > 0, the rule xwebLive uses first (node/upgrades.go:255-263)."
do_4 = "The wiring task routes setXWebPrecompile (node/upgrades.go:276) through v6120PrecompileSet so RefreshPrecompiles (node/upgrades.go:271) reselects 0x1015 from state; the latest version is what ordinary execution serves (modules/evm/keeper/keeper.go:172-188) and tracing picks by done height (modules/evm/keeper/keeper.go:356-385)."
do_5 = "TestV6120ExchangeVersionSwitch asserts both maps, and that GetCustomPrecompilesVersions returns the legacy contract at a height below the v6.12.0 done height and the perps contract at it."
symbols = ["exchangeVersionSwitch", "v6120PrecompileSet", "perpsLive", "TestV6120ExchangeVersionSwitch"]

[capability.1.3.3]
title = "Giga fail-fast set for the new addresses"
reqs = ["1007.6"]
touches = ["node/giga_v6120.go", "node/giga_precompiles_test.go"]
tests = ["node/giga_precompiles_test.go"]
verification_contract = "go test ./node/ -run TestGigaCustomPrecompilesSwitchAtHeight"
do_1 = "Add var gigaV6120FailFast map[common.Address]vm.PrecompiledContract in node/giga_v6120.go, built in init from AllCustomPrecompilesFailFastLate (engine/executor/precompiles/failfast.go:128) plus 0x1020-0x1027 mapped to FailFastSingleton (engine/executor/precompiles/failfast.go:101)."
do_2 = "0x1015 is already in LateFailFastPrecompileAddresses (engine/executor/precompiles/failfast.go:116-123), so the perps version reaches the ordinary path with no change to that list."
do_3 = "The wiring task makes gigaCustomPrecompiles (node/app.go:2564-2569) return gigaV6120FailFast at and above gigaLatePrecompileHeight (node/app.go:2559)."
do_4 = "Extend TestGigaCustomPrecompilesSwitchAtHeight (node/giga_precompiles_test.go:12-28) to assert gigaV6120FailFast holds every address of the late set and the eight new addresses, each mapped to FailFastSingleton."
symbols = ["gigaV6120FailFast", "gigaCustomPrecompiles", "TestGigaCustomPrecompilesSwitchAtHeight"]

[capability.1.4.1]
title = "Module, keeper and precompile wiring"
reqs = ["1009.1", "1009.2", "1009.3", "1009.4", "1008.2", "1007.1", "1007.4", "1007.6"]
touches = ["node/app.go", "node/precompiles.go", "node/upgrades_v6120.go"]
tests = ["node/upgrades_v6120_test.go"]
verification_contract = "go test ./node/ -run TestV6120AppliesThePlanOnTheHaltExport"
do_1 = "Add perps, spot and pricefeed to ModuleBasics (node/app.go:268-279), store keys (node/app.go:318-330), keeper fields (node/app.go:476-482), keeper construction after LaunchpadKeeper (node/app.go:806-807), the module manager (node/app.go:994-1003) and SetOrderInitGenesis (node/app.go:1052-1083)."
do_2 = "Add keeper fields and accessors to PrecompileKeepers (node/precompiles.go:17-41) and NewPrecompileKeepers (node/precompiles.go:43-69)."
do_3 = "After GetCustomPrecompiles at node/app.go:962 add the perps entry through exchangeVersionSwitch, the pricefeed NewPrecompile entry and every spot NewPrecompileSet entry, then pass {activationPrecompileGate(), v6120PrecompileGate()} at node/app.go:963 and select the set through v6120PrecompileSet at node/app.go:964."
do_4 = "Add case V6120Upgrade to layerxStoreUpgrades (node/app.go:1407-1421) and return gigaV6120FailFast from gigaCustomPrecompiles (node/app.go:2564-2569) at the late height."
do_5 = "Bind the four hooks in v6120Hooks to modules/launchpad/keeper MigrateV6120 with the EVM keeper as EVMReader, modules/pricefeed/keeper InitV6120, modules/perps/keeper SeedV6120 and modules/spot/keeper InitV6120, then call app.RefreshPrecompiles(ctx) at the end of runV6120Upgrade as runXWebUpgrade refreshes (node/upgrades.go:212-295)."
symbols = ["ModuleBasics", "PerpsKeeper", "SpotKeeper", "PricefeedKeeper", "PrecompileKeepers", "v6120Hooks", "runV6120Upgrade"]

[capability.1.4.2]
title = "Handler test on a halt-height export"
reqs = ["1009.5", "1006.3"]
touches = ["node/testdata/v6120-halt-export.json", "node/v6120_seed_helpers_test.go", "node/upgrades_v6120_test.go"]
tests = ["node/upgrades_v6120_test.go"]
verification_contract = "go test ./node/ -run TestV6120AppliesThePlanOnTheHaltExport"
do_1 = "node/testdata/v6120-halt-export.json is the state exported with paxd export --height H (sdk/server/export.go:24, sdk/server/export.go:88) from a test chain that applied the activation and v6.10 plans, with the launchpad state the migration hook reads."
do_2 = "node/v6120_seed_helpers_test.go adds seedV6120FromExport(t, path) that builds a test application with NewTestWrapper (node/test_helpers.go:128) and initialises it from the exported genesis."
do_3 = "TestV6120AppliesThePlanOnTheHaltExport writes the upgrade-info document for H+1, records the previous proposer (node/upgrades_activation_test.go:308) and runs a.BeginBlock at H+1 as node/upgrades_v610_test.go:74-150 does."
do_4 = "It asserts GetDoneHeight(V6120Upgrade) is H+1, the four hook effects are present, 0x1015 serves the perps version, 0x1020-0x1027 are served, and the SID mint authority sits with the bridge module account."
symbols = ["seedV6120FromExport", "TestV6120AppliesThePlanOnTheHaltExport"]

[capability.1.4.3]
title = "Domain completion target"
reqs = ["1010.1", "1010.2"]
touches = ["Makefile"]
tests = ["Makefile"]
