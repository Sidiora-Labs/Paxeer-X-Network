tests = ["node/upgrades_v6120_test.go"]
verification_contract = "go test ./node/ -run TestV6120AppliesThePlanOnTheHaltExport"
do_1 = "node/testdata/v6120-halt-export.json is the state exported with paxd export --height H (sdk/server/export.go:24, sdk/server/export.go:88) from a test chain that applied the activation and v6.10 plans, with the launchpad state the migration hook reads; the upgrade module exports \"{}\" (sdk/x/upgrade/module.go:104-131), so the fixture carries no done heights."
do_2 = "node/v6120_seed_helpers_test.go adds seedV6120FromExport(t, path) that builds a test application with NewTestWrapper (node/test_helpers.go:128), initialises it from the exported genesis and then writes the activation and v6.10 done heights recorded beside the fixture into the live upgrade store with SetDone, since the genesis cannot carry them."
do_3 = "TestV6120AppliesThePlanOnTheHaltExport writes the upgrade-info document for H+1, records the previous proposer (node/upgrades_activation_test.go:308) and runs a.BeginBlock at H+1 as node/upgrades_v610_test.go:74-150 does."
do_4 = "It asserts GetDoneHeight(V6120Upgrade) is H+1, the five hook effects are present, 0x1015 serves the perps version and 0x1017 the G2 version, 0x1020-0x1025 are served, 0x1026 and 0x1027 have no code, the SID mint authority sits with the bridge module account, and a call to 0x1015 at H+2 in the same process returns the perps result."
symbols = ["seedV6120FromExport", "TestV6120AppliesThePlanOnTheHaltExport"]

[capability.1.4.3]
title = "Domain completion target"
reqs = ["1010.1", "1010.2"]
touches = ["Makefile"]
tests = ["Makefile"]
verification_contract = "make test-paxd-domain"
do_1 = "Add target test-paxd-domain depending on paxd-native-libs (added by task 1.0.1 beside Makefile:216-218)."
do_2 = "The recipe runs $(MAKE) test-lxphost, covering modules/lxphost/host_test.go:210-589."
do_3 = "The recipe then runs CGO_ENABLED=1 go test ./node/... ./modules/layerxcustody/... ./modules/evm/keeper/... ./rpc/..., covering node/upgrades_v6120_test.go, modules/layerxcustody/handler_test.go:158 and the synthetic receipt tests."
do_4 = "The recipe stops at the first failing step with its exit code, so the gate reports one result."
symbols = ["test-paxd-domain"]

[capability.1.4.4]
title = "Synthetic venue and activation receipts"
reqs = ["1012.1", "1012.2", "1012.3", "1012.4", "1012.5", "1012.6", "1012.7"]
touches = ["modules/evm/keeper/synthetic_receipts.go", "modules/evm/keeper/receipt.go", "modules/evm/keeper/abci.go", "rpc/utils.go", "rpc/filter.go", "rpc/block.go", "rpc/tx.go", "modules/evm/keeper/synthetic_receipts_test.go", "rpc/synthetic_receipts_test.go"]
tests = ["modules/evm/keeper/synthetic_receipts_test.go", "rpc/synthetic_receipts_test.go"]
verification_contract = "go test ./modules/evm/keeper/ ./rpc/ -run 'TestVenueSyntheticReceipt'"
do_1 = "Add SyntheticReceiptHash, SyntheticReceiptContext and the three kinds in modules/evm/keeper/synthetic_receipts.go."
do_2 = "Normalise the TransactionIndex of the synthetic receipts and their logs in flushTransientReceipts (modules/evm/keeper/receipt.go:142)."
do_3 = "Add their blooms to allBlooms and evmOnlyBlooms in the EVM EndBlock (modules/evm/keeper/abci.go:190-214)."
do_4 = "Append the synthetic hashes in getTxHashesFromBlock (rpc/utils.go:533-553), so the log, block receipt and receipt endpoints serve them."
symbols = ["SyntheticReceiptHash", "SyntheticReceiptContext", "SyntheticReceiptPerps", "SyntheticReceiptSpot", "SyntheticReceiptActivation", "TestVenueSyntheticReceipt"]

