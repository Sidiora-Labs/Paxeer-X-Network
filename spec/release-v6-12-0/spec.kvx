[acceptance.4.1.1]
feature = "4"
req = "4001.1"
scenario = "Given the spot fixture of contracts/spot.md#hyperpax-call-sequence, when eth_getCode is read at 0x1021 through 0x1025 at the v6.12.0 done height, then each address is served by a precompile and a call of `vault()` at 0x1021 returns 0x0000000000000000000000000000000000001025."
contract = "contracts/spot.md#address-set"
test = "precompiles/spot/spot_test.go::TestNewPrecompileSetAddresses (planned)"
qualification = "UNRUN"

[acceptance.4.1.2]
feature = "4"
req = "4001.2"
