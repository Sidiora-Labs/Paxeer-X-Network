verification_contract = "go test -count=1 ./platform/perps-data/internal/publish/ -run 'TestPublisher'"
do_1 = "Add publish.EnsureStream creating or verifying PERPS_V1 from stream.Config and refusing to start when the live configuration differs (replicas, storage, retention or subjects), the drift refusal of the stream contracts (Launch-x:deploy/production/topology/README.md:28) (contracts/data-services.md section 4)."
do_2 = "Add publish.Publisher.Run looping delivery.Relay.RunOnce (Launch-x:shared/delivery/relay.go:27) over the outbox in Perps-Seq order; the event_id is <chain>:<block>:<block_hash>:<tx_index>:<log_index>:<sub> with the lower-case block hash and is the Nats-Msg-Id (Launch-x:shared/delivery/natsdriver/driver.go:45), so a republish inside the duplicate window is acknowledged without a second stream entry and a log of a rewritten height is a new event (contracts/data-services.md section 4)."
do_3 = "Every message carries the header Perps-Seq, a per-chain counter assigned at enqueue time from a Postgres sequence in commit order, and the JetStream stream sequence is recorded by MarkPublished (Launch-x:shared/delivery/store.go:205); both are strictly increasing in block, transaction and log order (contracts/data-services.md section 4)."
do_4 = "The payload is the delivery.Envelope JSON (Launch-x:shared/delivery/envelope.go:35) with the typed row as data and is refused above MaxEnvelopeBytes (Launch-x:shared/delivery/envelope.go:17); a refused publish is retried with Retry and backoff (Launch-x:shared/delivery/store.go:230) (contracts/data-services.md section 4)."
do_5 = "Add TestPublisher with subtests ensure_stream, refuses_drift, monotonic_seq, dedup_msg_id, rewind_message and envelope_limit against an in-process nats-server with JetStream and PERPS_DATA_TEST_DATABASE_URL (contracts/data-services.md section 4)."

