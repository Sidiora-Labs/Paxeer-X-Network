tests = ["modules/spot/keeper/shares_test.go"]
verification_contract = "go test ./modules/spot/keeper/ -run '^(TestShareDenomAndPointer|TestShareSupplyIsBankSupply|TestTransferredSharesWithdraw|TestShareMintScope)$'"
do_1 = "ShareDenom(token) is spot/share/<lowercase hex address>; CreateShareToken sets bank metadata and calls UpsertERCNativePointer (modules/evm/keeper/pointer_upgrade.go:49-57)."
do_2 = "The pointer code is NativePaxTokensERC20 (contracts/src/NativePaxTokensERC20.sol:7, constructor contracts/src/NativePaxTokensERC20.sol:17), so balanceOf and totalSupply read the bank module (contracts/src/NativePaxTokensERC20.sol:33-43)."
do_3 = "MintShares and BurnShares mint and burn through the bank keeper with the spot module account, which holds Minter and Burner (baseline task 1.3.100), and refuse any denom outside spot/share/*; they run only inside transactions (deposit, depositBatch, depositNative, withdraw, withdrawNative)."
do_4 = "Because a bank mint never runs the pointer _update, a mint or burn writes the share Transfer from or to address(0) at the share pointer through EmitEVMLog (precompiles/common/evm_events.go:16)."
do_5 = "The share tests cover the denom and pointer, TestShareSupplyIsBankSupply, the transferred-share withdraw and TestShareMintScope."

