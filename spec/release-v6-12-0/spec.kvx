[req.2015]
title = "Every custom error is returned with the contract selector and arguments"
ac_1 = "Custom error `AirdropNotTriggered()` (selector 0xceadfa6d, declared at Launch-x:contracts/contracts/interfaces/IFeeAccumulator.sol:14) is the revert data of the precompile for the same condition in FeeAccumulator; the precompile returns it as EVM revert data, not as a string reason, and the keeper error that carries it keeps its LXP_LAUNCHPAD_ code (modules/launchpad/types/errors.go:7)."
ac_2 = "Custom error `AlreadyClaimed()` (selector 0x646cf558, declared at Launch-x:contracts/contracts/interfaces/IFeeAccumulator.sol:13) is the revert data of the precompile for the same condition in FeeAccumulator; the precompile returns it as EVM revert data, not as a string reason, and the keeper error that carries it keeps its LXP_LAUNCHPAD_ code (modules/launchpad/types/errors.go:7)."
