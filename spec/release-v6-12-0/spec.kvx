[feature.7]
name = "perps-data-services"
scope = "The data services of the perpetuals and spot venues of Paxeer X Network under platform/perps-data in the root module: the perps-indexer that follows the node head, decodes the perpetuals and spot precompile logs, the pricefeed module logs and block events and the USDL ERC20 transfers into a Postgres fact and projection schema and publishes every block to a NATS JetStream stream; the perps-replay tool that rebuilds any height range; the perps-gateway that serves the REST routes, the data socket, the spot user socket, wallet sign-in, the account routes and the GraphQL endpoint and subscriptions the Hyperpax application reads; the perps-explorer REST views; the server-rendered perps-portal; the container images and the Railway layout; and the load profile. The precompiles themselves, the price feed and the application changes are other features."
requirements = ["7001", "7002", "7003", "7004", "7005", "7006", "7007", "7008", "7009", "7010", "7011", "7012", "7013", "7014", "7015", "7016", "7017", "7018", "7019", "7020", "7021", "7022", "7023", "7024", "7025", "7026"]
completion_task = "7.3.99"

[req.7001]
title = "The perps data services build in the root module and load their configuration"
ac_1 = "platform/perps-data is a package tree of the root module go.mod:1 on go go.mod:3, using go-ethereum through the pax-geth replace (go.mod:27, go.mod:280), gorilla/websocket (go.mod:44), lib/pq (go.mod:55) and client_golang (go.mod:69); go.mod:27-55 lists no nats or graphql module and go.sum:1287 holds only the graphql-go v1.3.0/go.mod line, so nats.go, nats-server/v2 and graphql-go are added with go get and both go.sum lines each, and the indexer imports only the leaf ABI packages precompiles/perps/abi, precompiles/pricefeed/abi and precompiles/spot/abi (contracts/data-services.md section 1)."
ac_2 = "config.Load reads PERPS_CHAIN_ID into the chain id of every subject and block row, replacing the literal 125 of Launch-x:core/indexer/internal/source/committed.go:634."
ac_3 = "Load refuses a missing or non-numeric PERPS_CHAIN_ID, a PERPS_RPC_URLS or PERPS_COMET_URLS list without an http or https entry and a non-numeric PORT, unlike the launchpad BaseEnv which requires Redis variables these services do not read (Launch-x:shared/config/env.go:31-34)."
ac_4 = "An RPC entry with a scheme other than http or https is refused, so the follower never dials a websocket or file endpoint by mistake (Launch-x:core/indexer/internal/source/evm.go:21)."
ac_5 = "A non-numeric PORT is refused before any listener opens (contracts/data-services.md section 23)."
ac_6 = "Config.String and every log line print DATABASE_URL and NATS_URL as redacted, matching the redacted json tag of the launchpad config (Launch-x:shared/config/env.go:32)."
ac_7 = "bigint.Add, Sub and MulDiv compute on decimal strings exactly as Launch-x:shared/db/bigint.go:60 and Launch-x:shared/db/bigint.go:90, flooring division."
ac_8 = "ValidateRaw refuses a fraction, an exponent or a negative value for unsigned columns (Launch-x:shared/db/bigint.go:129) and ValidateRawInt256 accepts the int256 range for signed columns."
ac_9 = "PERPS_COMET_URLS names the CometBFT RPC endpoints serving header and block_results for the indexer and the replay tool, and Load refuses the list when no entry is http or https (contracts/data-services.md section 23)."
ac_10 = "PERPS_AUTH_SECRET is required for the gateway, is at least 32 bytes and is printed redacted (contracts/data-services.md section 23)."

[req.7002]
title = "Schema perps holds append-only facts, chain tables, projections and the delivery tables"
ac_1 = "Every fact table carries the common columns row_id, block, block_hash, tx_index, log_index, sub, tx_hash, receipt_kind, block_time, emitter, kind, account and tx_from, is keyed (block, tx_index, log_index, sub) and is unique on (tx_hash, log_index, sub) and on row_id; the fact tables are the ones of contracts/data-services.md section 2 from perps.vaults to perps.usdl_transfers plus raw_logs, protocol_events and tx_actions."
ac_2 = "perps.blocks holds number, hash, parent_hash, time, proposer and tx_count, proposer being the upper-case hex of the CometBFT header ProposerAddress (consensus/types/block.go:423), and perps.cursors holds the follower cursor (Launch-x:core/indexer/migrations/00001_init.sql:13)."
ac_3 = "Amount columns are numeric(78,0) with a CHECK refusing a fraction, and account columns are bytea of length 20 (contracts/data-services.md section 2)."
ac_4 = "The projection tables positions_current, orders, spot_orders, account_margin, user_stats, user_pnl_daily, market_stats_rolling, leaderboard, spot_token_seen, market_snapshots, protocol_snapshots and keeper_cycles and the view account_ledger exist with the keys and indexes of contracts/data-services.md section 2."
ac_5 = "perps.markets and perps.fee_config are chain tables of 0001_facts.sql written by the seed migration and the startup refresh, keyed market_id with a unique symbol and id 1 respectively (contracts/data-services.md section 2)."
ac_6 = "delivery_outbox, delivery_inbox and delivery_quarantine exist in schema perps with the immutable envelope trigger (Launch-x:shared/delivery/schema.sql:2, Launch-x:shared/delivery/schema.sql:26-34)."
ac_7 = "Migrate refuses to run when a recorded migration hash differs from the embedded file (contracts/data-services.md section 2)."
ac_8 = "Migrate is idempotent (contracts/data-services.md section 2)."
ac_9 = "receipt_kind carries a CHECK on tx, perps_endblock, spot_endblock, activation and block_event, and tx_from is null for every receipt kind other than tx (contracts/data-services.md section 2)."

[req.7003]
title = "The indexer follows the chain head with parent-hash continuity and rewinds on a fork"
ac_1 = "The follower polls the head every 100 ms with 10 ms jitter (Launch-x:core/indexer/internal/source/committed.go:830) and writes each new height once."
ac_2 = "Logs are fetched for the address set of contracts/data-services.md section 1 only: 0x1015, 0x1020, 0x1021 to 0x1025, every share pointer of shareTokens(address) on 0x1025 and the USDL contract 0x85FcD13735F4309833A503EE804ea32395851479, including the synthetic receipts served by baseline task 1.0.6; 0x1026 and 0x1027 carry no code and are not read; block, transaction and log indexes are the ones the node fills (precompiles/common/evm_events.go:36-37)."
ac_3 = "A block whose parent hash differs from the stored hash of the previous height is detected (Launch-x:core/indexer/internal/source/committed.go:1037)."
ac_4 = "On a fork the follower deletes facts and projections at and above the fork height, the first height whose stored hash differs from the node hash, rebuilds affected projections and moves the cursor to the fork height minus one in one transaction (Launch-x:core/indexer/internal/source/committed.go:648)."
ac_5 = "A rewind enqueues one perps.<chain>.chain.rewind message carrying the fork height (contracts/data-services.md section 5)."
ac_6 = "RPC calls fall back across the configured endpoints in health rank order (Launch-x:core/indexer/internal/source/evm.go:410, Launch-x:core/indexer/internal/source/evm.go:499)."
ac_7 = "The indexer resumes from the cursor plus one after a restart and from PERPS_START_HEIGHT on an empty database (contracts/data-services.md section 5)."
ac_8 = "Catch-up reads at most 500 blocks per eth_getLogs call, below MaxBlocksForLog 2000 and MaxLogNoBlock 10000 (rpc/config/config.go:195-196), and halves the range and retries when the node refuses a response for size (contracts/data-services.md section 5)."
ac_9 = "Readiness is false while the lag to the node head exceeds 30 blocks or an outbox row is older than 30 seconds (contracts/data-services.md section 19)."
ac_10 = "A block indexed by the indexer is published to JetStream in block, transaction and log order (contracts/data-services.md section 4)."
ac_11 = "A venue block with logs ends in Postgres and on the stream, the path of Processor.ProcessBatch (Launch-x:core/indexer/internal/processor/processor.go:202)."
ac_12 = "Every synthetic receipt is checked against the table of contracts/data-services.md section 1: perps_endblock hashes keccak256(\"perps-endblock\" and the 8-byte height) at the highest real TxIndex plus 1, spot_endblock at plus 2 and activation at plus 3; a mismatch stops the follower with the height, the expected and the served values and stores nothing under a guessed key."
ac_13 = "For each height the follower reads the CometBFT header route for the proposer (consensus/internal/rpc/core/routes.go:44, consensus/types/block.go:423) and the block_results route for finalize_block_events (consensus/internal/rpc/core/routes.go:48, consensus/rpc/coretypes/responses.go:93) over PERPS_COMET_URLS."
ac_14 = "Share pointer discovery is two-pass per block: pass one decodes 0x1025 and records each ShareTokenCreated, pass two refetches the block for the pointers known after pass one, and the pointer set is seeded at start from getRegisteredTokens() (0x14cbd993) and shareTokens(address) (0x96153f07) (contracts/data-services.md section 6)."
ac_15 = "A rewind never deletes perps.markets or perps.fee_config (contracts/data-services.md section 2)."

[req.7004]
title = "Every perpetuals event of the release decodes into its fact table"
ac_1 = "VaultCreated(address indexed user, address indexed vault) from 0x1015 decodes into perps.vaults with kind created and account the user argument (contracts/data-services.md section 6)."
ac_2 = "CollateralDeposited(address indexed account, uint256 amount, uint256 newBalance) from 0x1015 decodes into perps.collateral_events with kind deposited and account the account argument (contracts/data-services.md section 6)."
ac_3 = "CollateralWithdrawn(address indexed account, uint256 amount, uint256 newBalance) from 0x1015 decodes into perps.collateral_events with kind withdrawn and account the account argument (contracts/data-services.md section 6)."
ac_4 = "CollateralTransferred(address indexed from, address indexed to, uint256 amount) from 0x1015 decodes into two perps.collateral_events rows, kind transferred_out with sub 0 and account from and kind transferred_in with sub 1 and account to (contracts/data-services.md section 6)."
ac_5 = "OrderPlaced(uint256 indexed orderId, address indexed user, uint256 indexed marketId, uint8 orderType, bool isLong, uint256 triggerPrice, uint256 sizeUsd) from 0x1015 decodes into perps.order_events with kind placed and account the user argument (contracts/data-services.md section 6)."
ac_6 = "OrderOptions(uint256 indexed orderId, uint8 timeInForce, bool reduceOnly, uint256 limitPrice, uint256 acceptablePrice, uint64 deadline, bytes16 cloid) from 0x1015 decodes into perps.order_events with kind options and account the user of the earlier placed row of that order id (contracts/data-services.md section 6)."
ac_7 = "OrderCancelled(uint256 indexed orderId, address indexed user) from 0x1015 decodes into perps.order_events with kind cancelled and account the user argument (contracts/data-services.md section 6)."
ac_8 = "OrderExpired(uint256 indexed orderId, address indexed user, uint256 indexed marketId) from 0x1015 decodes into perps.order_events with kind expired and account the user argument (contracts/data-services.md section 6)."
ac_9 = "OrderTriggered(uint256 indexed orderId, uint256 indexed marketId, uint256 markPrice) from 0x1015 decodes into perps.order_events with kind triggered and account the user of the earlier placed row of that order id (contracts/data-services.md section 6)."
ac_10 = "OrderExecuted(uint256 indexed orderId, uint256 indexed positionId, uint256 executionPrice) from 0x1015 decodes into perps.order_events with kind executed and account the user of the earlier placed row of that order id (contracts/data-services.md section 6)."
ac_11 = "Fill(uint256 indexed marketId, uint256 indexed makerOrderId, uint256 indexed takerOrderId, address maker, address taker, bool takerIsLong, uint256 price, uint256 sizeUsd, int256 makerFeeUsd, uint256 takerFeeUsd) from 0x1015 decodes into perps.fills with kind fill and account the taker argument (contracts/data-services.md section 6)."
ac_12 = "PositionOpened(uint256 indexed positionId, address indexed user, uint256 indexed marketId, bool isLong, uint256 sizeUsd, uint256 leverage, uint256 entryPrice, address collateralToken, uint256 collateralAmount) from 0x1015 decodes into perps.position_events with kind opened and account the user argument (contracts/data-services.md section 6)."
ac_13 = "PositionModified(uint256 indexed positionId, uint256 newSizeUsd, uint256 newCollateralUsd, uint256 newCollateralAmount) from 0x1015 decodes into perps.position_events with kind modified and account the user of the earlier opened row of that position id (contracts/data-services.md section 6)."
ac_14 = "PositionEntryPriceChanged(uint256 indexed positionId, uint256 oldEntryPrice, uint256 newEntryPrice) from 0x1015 decodes into perps.position_events with kind entry_price_changed and account the user of the earlier opened row of that position id (contracts/data-services.md section 6)."
ac_15 = "PositionClosed(uint256 indexed positionId, address indexed user, uint256 indexed marketId, uint256 closedSizeUsd, uint256 exitPrice, int256 realizedPnl, bool isFullClose) from 0x1015 decodes into perps.position_events with kind closed and account the user argument (contracts/data-services.md section 6)."
ac_16 = "PositionTpSlSet(uint256 indexed positionId, uint256 takeProfitPrice, uint256 stopLossPrice) from 0x1015 decodes into perps.position_events with kind tpsl_set and account the user of the earlier opened row of that position id (contracts/data-services.md section 6)."
ac_17 = "TradeSettled(uint256 indexed positionId, address indexed user, uint256 indexed marketId, uint8 tradeType, uint256 sizeUsd, uint256 executionPrice, int256 grossPnl, uint256 totalFeesUsd, int256 fundingPaidUsd, uint256 netPayoutTokens) from 0x1015 decodes into perps.trade_settlements with kind settled and account the user argument (contracts/data-services.md section 6)."
ac_18 = "FeeCollected(uint256 indexed positionId, address indexed user, uint256 indexed marketId, uint8 feeType, uint256 feeUsd, uint256 feeTokens, address token) from 0x1015 decodes into perps.fees with kind collected and account the user argument (contracts/data-services.md section 6)."
ac_19 = "MarkPriceUpdated(uint256 indexed marketId, uint256 markPrice, uint256 indexPrice, uint256 midPrice) from 0x1015 decodes into perps.mark_prices with kind mark and account the venue module address (contracts/data-services.md section 6)."
ac_20 = "FundingRateUpdated(uint256 indexed marketId, int256 newRatePerSecond, int256 fundingRate24h) from 0x1015 decodes into perps.funding_rates with kind rate and account the venue module address (contracts/data-services.md section 6)."
ac_21 = "FundingSettled(uint256 indexed marketId, int256 fundingRate, int256 longPayment, int256 shortPayment) from 0x1015 decodes into perps.funding_settlements with kind settled and account the venue module address (contracts/data-services.md section 6)."
ac_22 = "PositionFundingApplied(uint256 indexed positionId, address indexed user, uint256 indexed marketId, int256 fundingPaymentUsd, uint256 newCollateralUsd, uint256 newCollateralAmount) from 0x1015 decodes into perps.funding_payments with kind applied and account the user argument (contracts/data-services.md section 6)."
ac_23 = "OpenInterestChanged(uint256 indexed marketId, uint256 longOI, uint256 shortOI, uint256 deltaUsd, bool isIncrease) from 0x1015 decodes into perps.open_interest with kind oi and account the venue module address (contracts/data-services.md section 6)."
ac_24 = "Liquidation(uint256 indexed positionId, address indexed user, uint256 indexed marketId, uint256 liquidationPrice, uint256 penalty, address keeper) from 0x1015 decodes into perps.liquidations with kind liquidated and account the user argument (contracts/data-services.md section 6)."
ac_25 = "BackstopLiquidation(address indexed account, uint256 indexed marketId, uint256 sizeUsd, uint256 markPrice, uint256 marginTakenUsd) from 0x1015 decodes into perps.backstop_liquidations with kind backstop and account the account argument (contracts/data-services.md section 6)."
ac_26 = "InsuranceContribution(address indexed token, uint256 amount, uint8 source) from 0x1015 decodes into perps.insurance_events with kind contribution and account the venue module address (contracts/data-services.md section 6)."
ac_27 = "InsuranceDraw(uint256 indexed marketId, uint256 amount, uint256 newBalance) from 0x1015 decodes into perps.insurance_events with kind draw and account the venue module address (contracts/data-services.md section 6)."
ac_28 = "VaultDeficit(address indexed token, uint256 deficit) from 0x1015 decodes into perps.insurance_events with kind vault_deficit and account the venue module address (contracts/data-services.md section 6)."
ac_29 = "ADLExecuted(uint256 indexed positionId, uint256 deleveragedSizeUsd) from 0x1015 decodes into perps.adl_events with kind adl and account the user of the earlier opened row of that position id (contracts/data-services.md section 6)."
ac_30 = "ADLMatched(uint256 indexed marketId, uint256 indexed positionId, address indexed account, uint256 sizeUsd, uint256 price, uint256 rankScore) from 0x1015 decodes into perps.adl_events with kind matched and account the account argument (contracts/data-services.md section 6)."
ac_31 = "A log of a venue address whose topic0 has no decoder is stored in perps.raw_logs with decoded false and failure_class unknown_topic and counted in perps_indexer_unknown_logs_total, never dropped (contracts/data-services.md section 6)."
ac_32 = "Identical logs in one fetch decode once (Launch-x:core/indexer/internal/decode/dedup.go:17)."
ac_33 = "The account column takes the argument named in section 6, the user of the earlier placed or opened row for events that carry only an id, and the venue module address otherwise; tx_from is the sender only for receipt_kind tx and never supplies the account (contracts/data-services.md section 6)."
ac_34 = "The signed arguments grossPnl, fundingPaidUsd, realizedPnl, makerFeeUsd, fundingRate, longPayment, shortPayment, newRatePerSecond, fundingRate24h and fundingPaymentUsd decode as int256 and pass bigint.ValidateRawInt256; every other integer is unsigned and passes bigint.ValidateRaw (contracts/data-services.md section 6)."
ac_35 = "tradeType decodes as 0 open, 1 close, 2 liquidation, 3 reduce, 4 increase, 5 adl, 6 backstop and feeType as 0 trading, 4 maker rebate, the numbering of contracts/perps.md section 2; feeType 1 to 3 is never emitted, and a value outside its enumeration (feeType 1 to 3 included) is stored as emitted and counted in perps_indexer_enum_unknown_total (contracts/data-services.md section 6)."
ac_36 = "The events of contracts/perps.md section 25 that the release does not emit (the margin lock and transfer events, MarginModeChanged, LedgerEntryRecorded, VaultBalanceChanged, MarkPriceChanged and the administrative setters) and BorrowingFeeAccrued have no decoder; such a log goes to raw_logs with failure_class unknown_topic (contracts/data-services.md section 6)."
ac_37 = "The decoders import only the leaf ABI packages precompiles/perps/abi, precompiles/pricefeed/abi and precompiles/spot/abi, and TestDecoderColumnsMatchABI checks every row of the decoding table against those ABI files, so a signature change fails the build (contracts/data-services.md section 1, section 6)."

[req.7005]
title = "Every pricefeed, spot, share pointer and USDL event decodes into its fact table"
ac_1 = "FeedKeyRegistered(address indexed validator, address indexed feedAccount, bytes pubKey, address previousFeedAccount) from 0x1020 decodes into perps.feed_keys with kind registered and account the validator argument (contracts/data-services.md section 6)."
ac_2 = "FeedKeyRevoked(address indexed validator, address indexed feedAccount) from 0x1020 decodes into perps.feed_keys with kind revoked and account the validator argument (contracts/data-services.md section 6)."
ac_3 = "The Cosmos block event pricefeed_aggregate (market_id, index_price, mark_price, basis, timestamp_ms, sources, required, height) of finalize_block_events decodes into perps.index_prices with kind aggregate, receipt_kind block_event, tx_index -1, log_index its position in finalize_block_events, tx_hash the block hash and emitter 0x1020 (contracts/data-services.md section 6)."
ac_4 = "The Cosmos block event pricefeed_aggregate_skipped (market_id, sources, required) of finalize_block_events decodes into perps.index_prices with kind skipped, receipt_kind block_event, tx_index -1, log_index its position in finalize_block_events, tx_hash the block hash and emitter 0x1020 (contracts/data-services.md section 6)."
ac_5 = "MarketOrderExecuted(address indexed user, address indexed stablecoin, address indexed token, uint256 stablecoinAmount, uint256 tokenAmount, bool isBuy) at 0x1021 decodes into perps.spot_swaps with kind market_order and account the user argument (contracts/data-services.md section 6)."
ac_6 = "NativeSwap(address indexed user, address indexed tokenOther, uint256 nativeAmount, uint256 tokenAmount, bool nativeIsInput) at 0x1021 decodes into perps.spot_swaps with kind native_swap and account the user argument (contracts/data-services.md section 6)."
ac_7 = "SimpleSwap(address indexed user, address indexed tokenIn, address indexed tokenOut, uint256 amountIn, uint256 amountOut, uint256 executionPrice) at 0x1021 decodes into perps.spot_swaps with kind simple_swap and account the user argument (contracts/data-services.md section 6)."
ac_8 = "TwapSanityUpdated(bool enabled, uint256 period, uint256 maxDeviationBps) at 0x1021 decodes into perps.spot_admin with kind twap_sanity_updated and account the venue module address (contracts/data-services.md section 6)."
ac_9 = "PriceImpactApplied(address indexed user, address indexed tokenOut, uint256 impactBps, uint256 deductedAmount) at any of 0x1021 to 0x1025, matched by topic0 decodes into perps.spot_fee_events with kind price_impact and account the user argument (contracts/data-services.md section 6)."
ac_10 = "TieredFeeApplied(address indexed user, address indexed tokenOut, uint256 volumeUSD, uint256 feeBps, uint256 feeAmount) at any of 0x1021 to 0x1025, matched by topic0 decodes into perps.spot_fee_events with kind tiered_fee and account the user argument (contracts/data-services.md section 6)."
ac_11 = "LimitOrderCreated(uint256 indexed orderId, address indexed user, uint8 orderType, uint256 amount, uint256 targetPrice) at 0x1022 decodes into perps.spot_order_events with kind limit_created and account the user argument (contracts/data-services.md section 6)."
ac_12 = "LimitOrderCancelled(uint256 indexed orderId) at 0x1022 decodes into perps.spot_order_events with kind limit_cancelled and account the user of the earlier created row of that order id (contracts/data-services.md section 6)."
ac_13 = "LimitOrderExecuted(uint256 indexed orderId, uint256 executionPrice) at 0x1022 decodes into perps.spot_order_events with kind limit_executed and account the user of the earlier created row of that order id (contracts/data-services.md section 6)."
ac_14 = "LimitOrderExpired(uint256 indexed orderId) at 0x1022 decodes into perps.spot_order_events with kind limit_expired and account the user of the earlier created row of that order id (contracts/data-services.md section 6)."
ac_15 = "LimitOrderModified(uint256 indexed orderId, uint256 targetPrice, uint256 expiresAt) at 0x1022 decodes into perps.spot_order_events with kind limit_modified and account the user of the earlier created row of that order id (contracts/data-services.md section 6)."
ac_16 = "StopLimitOrderCreated(uint256 indexed orderId, address indexed user, uint8 orderType, uint256 amount, uint256 stopPrice, uint256 limitPrice) at 0x1023 decodes into perps.spot_order_events with kind stop_limit_created and account the user argument (contracts/data-services.md section 6)."
ac_17 = "StopLimitActivated(uint256 indexed orderId, uint256 activationPrice) at 0x1023 decodes into perps.spot_order_events with kind stop_limit_activated and account the user of the earlier created row of that order id (contracts/data-services.md section 6)."
ac_18 = "StopLimitCancelled(uint256 indexed orderId) at 0x1023 decodes into perps.spot_order_events with kind stop_limit_cancelled and account the user of the earlier created row of that order id (contracts/data-services.md section 6)."
ac_19 = "StopLimitExecuted(uint256 indexed orderId, uint256 executionPrice) at 0x1023 decodes into perps.spot_order_events with kind stop_limit_executed and account the user of the earlier created row of that order id (contracts/data-services.md section 6)."
ac_20 = "StopLossOrderCreated(uint256 indexed orderId, address indexed user, uint256 amount, uint256 triggerPrice) at 0x1023 decodes into perps.spot_order_events with kind stop_loss_created and account the user argument (contracts/data-services.md section 6)."
ac_21 = "StopLossOrderCancelled(uint256 indexed orderId) at 0x1023 decodes into perps.spot_order_events with kind stop_loss_cancelled and account the user of the earlier created row of that order id (contracts/data-services.md section 6)."
ac_22 = "StopLossOrderExecuted(uint256 indexed orderId, uint256 executionPrice) at 0x1023 decodes into perps.spot_order_events with kind stop_loss_executed and account the user of the earlier created row of that order id (contracts/data-services.md section 6)."
ac_23 = "Deposit(address indexed token, address indexed depositor, uint256 amount, uint256 newReserve) at 0x1025 decodes into perps.spot_vault_events with kind deposit and account the depositor argument (contracts/data-services.md section 6)."
ac_24 = "LPWithdrawal(address indexed token, address indexed provider, uint256 shares, uint256 amount) at 0x1025 decodes into perps.spot_vault_events with kind lp_withdrawal and account the provider argument (contracts/data-services.md section 6)."
ac_25 = "NativeDeposit(address indexed depositor, uint256 amount, uint256 newReserve) at 0x1025 decodes into perps.spot_vault_events with kind native_deposit and account the depositor argument (contracts/data-services.md section 6)."
ac_26 = "NativeWithdrawal(address indexed recipient, uint256 amount, uint256 newReserve) at 0x1025 decodes into perps.spot_vault_events with kind native_withdrawal and account the recipient argument (contracts/data-services.md section 6)."
ac_27 = "Withdrawal(address indexed token, address indexed recipient, uint256 amount, uint256 newReserve) at 0x1025 decodes into perps.spot_vault_events with kind withdrawal and account the recipient argument (contracts/data-services.md section 6)."
ac_28 = "ReservesSync(address indexed token, uint256 oldReserves, uint256 newReserves, uint256 recovered) at 0x1025 decodes into perps.spot_vault_events with kind reserves_sync and account the venue module address (contracts/data-services.md section 6)."
ac_29 = "ReservesUpdated(address indexed token, uint256 oldReserve, uint256 newReserve) at 0x1025 decodes into perps.spot_vault_events with kind reserves_updated and account the venue module address (contracts/data-services.md section 6)."
ac_30 = "TokenRegistered(address indexed token, uint8 decimals, bool isStablecoin) at 0x1025 decodes into perps.spot_token_registry with kind token_registered and account the venue module address (contracts/data-services.md section 6)."
ac_31 = "ShareTokenCreated(address indexed token, address indexed shareToken) at 0x1025 decodes into perps.spot_token_registry with kind share_token_created and account the venue module address (contracts/data-services.md section 6)."
ac_32 = "OperatorUpdated(address indexed operator, bool authorized) at 0x1025 decodes into perps.spot_admin with kind operator_updated and account the venue module address (contracts/data-services.md section 6)."
ac_33 = "TokenPauseUpdated(address indexed token, bool paused) at 0x1025 decodes into perps.spot_admin with kind token_pause_updated and account the venue module address (contracts/data-services.md section 6)."
ac_34 = "TransactionTrackerUpdated(address indexed tracker) at 0x1025 decodes into perps.spot_admin with kind tracker_updated and account the venue module address (contracts/data-services.md section 6)."
ac_35 = "UtilizationCapUpdated(address indexed token, uint256 maxUtilizationBps) at 0x1025 decodes into perps.spot_admin with kind utilization_cap_updated and account the venue module address (contracts/data-services.md section 6)."
ac_36 = "OwnershipTransferred(address indexed previousOwner, address indexed newOwner) at 0x1021, 0x1022, 0x1023, 0x1025, share pointers decodes into perps.spot_admin with kind ownership_transferred and account the venue module address (contracts/data-services.md section 6)."
ac_37 = "Paused(address account) at 0x1021, 0x1022, 0x1023 decodes into perps.spot_admin with kind paused and account the venue module address (contracts/data-services.md section 6)."
ac_38 = "Unpaused(address account) at 0x1021, 0x1022, 0x1023 decodes into perps.spot_admin with kind unpaused and account the venue module address (contracts/data-services.md section 6)."
ac_39 = "Transfer(address indexed from, address indexed to, uint256 value) at a share pointer decodes into perps.spot_share_transfers with kind transfer, share_token the emitter, token resolved from the pointer set and account from, or to on a mint from the zero address (contracts/data-services.md section 6)."
ac_40 = "Approval(address indexed `owner`, address indexed spender, uint256 value) at a share pointer decodes into perps.spot_share_transfers with kind approval and account the first argument (contracts/data-services.md section 6)."
ac_41 = "Transfer(address indexed from, address indexed to, uint256 value) of the USDL contract 0x85FcD13735F4309833A503EE804ea32395851479 decodes into perps.usdl_transfers with kind in when a venue custody address (the perps or the spot module EVM address) receives and out when it sends, account the non-venue side and venue the touched custody address (contracts/data-services.md section 6)."
ac_42 = "The spot order events carry no token, so the decoder resolves token and stablecoin by eth_call at the event height with getLimitOrder(uint256) (0x53061026) on 0x1022 and getStopLimitOrder(uint256) (0x307ff324) and getStopLossOrder(uint256) (0x4c34cf02) on 0x1023 (contracts/data-services.md section 6)."
ac_43 = "When the event height is pruned on every node the order lookup calls the latest height, because an order's token and stablecoin never change (contracts/data-services.md section 6)."
ac_44 = "A zero order record from the lookup writes the log to raw_logs with failure_class order_lookup and no fact row (contracts/data-services.md section 6)."
ac_45 = "Spot order side is buy for limit orderType 0 and sell for orderType 1, and a stop-loss order is a sell (contracts/data-services.md section 6)."
ac_46 = "Share pointer logs of a pointer created in the same block are decoded in the second pass, the pointer set is seeded from getRegisteredTokens() (0x14cbd993) and shareTokens(address) (0x96153f07) on 0x1025, and a pointer log whose token cannot be resolved goes to raw_logs with failure_class share_lookup (contracts/data-services.md section 6)."
ac_47 = "A share pointer Transfer from the zero address is a mint with account to, and one to the zero address is a burn with account from, so the keeper mint and burn of the spot fill path (contracts/spot.md, Events) reach the holdings (contracts/data-services.md section 6)."
ac_48 = "Only USDL Transfer logs whose from or to is the perps module EVM address or the spot module EVM address (contracts/address-table.md, module accounts) are stored, venue is that custody address, and the TVL of a venue is the sum of its in rows minus the sum of its out rows (contracts/data-services.md section 6)."
ac_49 = "PriceImpactApplied and TieredFeeApplied are matched by topic0 at every address from 0x1021 to 0x1025 (contracts/data-services.md section 6)."
ac_50 = "PECORQuoter 0x1024 is view-only and emits no log, and no decoder exists for 0x1026 or 0x1027, which carry no code (contracts/data-services.md section 1)."
ac_51 = "The pricefeed Cosmos events other than pricefeed_aggregate and pricefeed_aggregate_skipped are not decoded and write no index_prices row (contracts/data-services.md section 6)."

[req.7006]
title = "Writers commit each block once and keep projections consistent with the facts"
ac_1 = "A block written twice leaves one row per log and sub: inserts use ON CONFLICT (tx_hash, log_index, sub) DO NOTHING (contracts/data-services.md section 2)."
ac_2 = "Each fact row and its outbox message commit in the same transaction (Launch-x:shared/delivery/store.go:137)."
ac_3 = "Only the holder of the writer lease writes (Launch-x:core/indexer/internal/store/canonical.go:257)."
ac_4 = "The cursor advances to the written block in the same transaction (contracts/data-services.md section 5)."
ac_5 = "Every decoded row also lands in protocol_events, and every log or block event that maps to an explorer action lands in tx_actions with its action, including the Oracle Updated row of a block with pricefeed_aggregate events and the Sealed Batch Executed row of each end-block receipt (contracts/data-services.md section 2, section 16)."
ac_6 = "positions_current follows PositionOpened, PositionModified, PositionEntryPriceChanged, PositionTpSlSet, PositionClosed, Liquidation, ADLExecuted and PositionFundingApplied (contracts/perps.md section 18)."
ac_7 = "orders moves through active, triggered, filled, cancelled and expired: OrderPlaced inserts active with remaining_size_usd = size_usd, OrderOptions fills limit_price, acceptable_price, time_in_force, reduce_only, deadline and cloid, each Fill naming the order subtracts its size_usd, OrderTriggered sets triggered, and the order closes filled at remaining 0, cancelled on OrderCancelled and expired on OrderExpired (contracts/data-services.md section 2)."
ac_8 = "account_margin takes balance from the new_balance of the latest CollateralDeposited or CollateralWithdrawn plus or minus every later CollateralTransferred, locked as the sum of collateral_amount of the open positions and margin_mode 0, per account and the USDL token (contracts/data-services.md section 2)."
ac_9 = "market_stats_rolling folds each Fill once per match for volume, trades_count, high, low, open and last price over rolling 24 hour, 7 day and 30 day windows, while TradeSettled, FeeCollected, PositionFundingApplied and Liquidation fold only into user_stats and user_pnl_daily (contracts/data-services.md section 2)."
ac_10 = "market_snapshots per market and one protocol_snapshots row are written at each UTC hour boundary crossed by a block time, from the latest mark_prices, funding_rates, fills, open_interest, fees, usdl_transfers and insurance_events (contracts/data-services.md section 2)."
ac_11 = "keeper_cycles holds one row per perps_endblock receipt with markets_updated, orders_executed and liquidations_executed counted from its MarkPriceUpdated, OrderExecuted and Liquidation logs and both failed counts 0 (contracts/data-services.md section 2)."
ac_12 = "The view account_ledger unions collateral_events (entry_type 0 to 3), fees (4), funding_payments (5) and trade_settlements (6) with account, USDL token, amount, position_id and is_debit (contracts/data-services.md section 2)."
ac_13 = "user_stats counts win_count and loss_count from PositionClosed realized_pnl above and below 0 and sets total_pnl = realized_pnl - fees_usd + funding_usd (contracts/data-services.md section 2)."
ac_14 = "spot_orders follows the spot order events keyed (kind, order_id) through open, activated, executed, cancelled and expired with token and stablecoin from the decoder lookup, and spot_token_seen records every token of a spot swap, order or registry row (contracts/data-services.md section 2)."

[req.7007]
title = "Every row change is published once on JetStream with a monotonic sequence"
ac_1 = "PERPS_V1 uses file storage, three replicas, 72 hour max age, discard new and deny delete and purge (Launch-x:deploy/production/topology/README.md:28)."
ac_2 = "Market subjects are perps.<chain>.<market>.<kind> for fill, order, funding, index, liq, mark, oi and market, each token matching Launch-x:shared/delivery/natsdriver/driver.go:17."
ac_3 = "User subjects are perps.<chain>.user.<account>.<kind> for position, order, fill, margin, funding and ledger with the account in lower-case hex (contracts/data-services.md section 3)."
ac_4 = "Chain subjects are perps.<chain>.chain.block, .tx and .rewind (contracts/data-services.md section 3)."
ac_5 = "Spot subjects are perps.<chain>.spot.<token>.<kind> for swap, order and vault (contracts/data-services.md section 3)."
ac_6 = "Topic filters are checked with ValidSubjectFilter and matched with SubjectMatches (Launch-x:shared/delivery/stream.go:257, Launch-x:shared/delivery/stream.go:274)."
ac_7 = "EnsureStream refuses to start when the live stream configuration differs from stream.Config (contracts/data-services.md section 3)."
ac_8 = "EnsureStream creates PERPS_V1 when it does not exist (contracts/data-services.md section 3)."
ac_9 = "The event id is <chain>:<block>:<block_hash>:<tx_index>:<log_index>:<sub> with the lower-case block hash; a message republished with the same id inside the duplicate window is acknowledged without a second entry (Launch-x:shared/delivery/natsdriver/driver.go:45), and a log of a rewritten height is a new event (contracts/data-services.md section 4)."
ac_10 = "Perps-Seq and the JetStream stream sequence are strictly increasing in block, transaction and log order (Launch-x:shared/delivery/store.go:205)."
ac_11 = "An envelope above 1 MiB is refused before publishing (Launch-x:shared/delivery/envelope.go:17)."
ac_12 = "A rewind message is published on perps.<chain>.chain.rewind before any message of the rewritten heights (contracts/data-services.md section 4)."
ac_13 = "stream.Subject refuses a market kind outside fill, order, funding, index, liq, mark, oi and market (contracts/data-services.md section 3)."

[req.7008]
title = "The replay tool rewrites a height range from the node without duplicates"
ac_1 = "A replay request names from and to heights and is validated before any write (Launch-x:core/indexer/internal/store/replay.go:47)."
ac_2 = "A from height above the indexer cursor is refused (contracts/data-services.md section 7)."
ac_3 = "Replay deletes facts and projections in the range and rewrites them from the node, re-reading the logs, the synthetic receipts and block_results over PERPS_COMET_URLS, yielding rows identical to the first index (Launch-x:core/indexer/internal/processor/replay.go:151)."
ac_4 = "--dry-run reports the row counts that would change and writes nothing (contracts/data-services.md section 7)."
ac_5 = "Replay holds the writer lease for its duration so the indexer pauses (Launch-x:core/indexer/internal/store/canonical.go:257)."
ac_6 = "Replayed messages reuse the first event ids, so the stream and the consumer inbox deduplicate them (Launch-x:shared/delivery/schema.sql:35)."

[req.7009]
title = "Markets are seeded and refreshed from the chain, and chart candles stay on the Chainflow feed"
ac_1 = "migrations/0005_markets_seed.sql inserts the eighteen markets of contracts/perps-markets.md section 2, ids 0 to 17 (BTC, ETH, SOL, AVAX, LINK, TSLA, NVDA, NAS100, XAU, SPX500, GOOGL, PAX, SID, HYPE, XRP, ASTER, TRUMP, BNB), each with symbol, name, oracle_symbol, sz_decimals, px_decimals, max_leverage 1000 and source seed (contracts/data-services.md section 11)."
ac_2 = "At start markets.Refresh calls totalMarkets() and getMarket(uint256) on 0x1015 at the latest height (contracts/perps.md section 9) and updates name, max_leverage, maintenance_margin_bps, max_open_interest and enabled with source chain; a market id outside the seed is inserted with the chain values and null decimals (contracts/data-services.md section 11)."
ac_3 = "markets.Refresh calls getFees() on 0x1015 (contracts/perps.md section 10) and writes takerFeePpm, makerFeePpm, liquidationFeePpm and insuranceSharePpm into perps.fee_config row 1 (contracts/data-services.md section 11)."
ac_4 = "A failed refresh call keeps the stored rows and is retried every 60 seconds, and indexer readiness does not wait for it (contracts/data-services.md section 11)."
ac_5 = "GET /api/<symbol>/config is not mounted and answers 404, because chart candles stay on the Chainflow feed that candleFeedUrl builds from FEED_ORIGIN (Hyperpax:src/core/feeds.ts:2, Hyperpax:src/core/feeds.ts:8-14) (contracts/data-services.md section 12)."
ac_6 = "GET /api/<symbol>/time is not mounted and answers 404, because chart candles stay on the Chainflow feed that candleFeedUrl builds from FEED_ORIGIN (Hyperpax:src/core/feeds.ts:2, Hyperpax:src/core/feeds.ts:8-14) (contracts/data-services.md section 12)."
ac_7 = "GET /api/<symbol>/symbols is not mounted and answers 404, because chart candles stay on the Chainflow feed that candleFeedUrl builds from FEED_ORIGIN (Hyperpax:src/core/feeds.ts:2, Hyperpax:src/core/feeds.ts:8-14) (contracts/data-services.md section 12)."
ac_8 = "GET /api/<symbol>/search is not mounted and answers 404, because chart candles stay on the Chainflow feed that candleFeedUrl builds from FEED_ORIGIN (Hyperpax:src/core/feeds.ts:2, Hyperpax:src/core/feeds.ts:8-14) (contracts/data-services.md section 12)."
ac_9 = "GET /api/<symbol>/history is not mounted and answers 404, because chart candles stay on the Chainflow feed that candleFeedUrl builds from FEED_ORIGIN (Hyperpax:src/core/feeds.ts:2, Hyperpax:src/core/feeds.ts:8-14) (contracts/data-services.md section 12)."
ac_10 = "GET /api/<symbol>/quotes is not mounted and answers 404, because chart candles stay on the Chainflow feed that candleFeedUrl builds from FEED_ORIGIN (Hyperpax:src/core/feeds.ts:2, Hyperpax:src/core/feeds.ts:8-14) (contracts/data-services.md section 12)."
ac_11 = "GET /api/<symbol>/marks is not mounted and answers 404, because chart candles stay on the Chainflow feed that candleFeedUrl builds from FEED_ORIGIN (Hyperpax:src/core/feeds.ts:2, Hyperpax:src/core/feeds.ts:8-14) (contracts/data-services.md section 12)."
ac_12 = "GET /api/<symbol>/timescale_marks is not mounted and answers 404, because chart candles stay on the Chainflow feed that candleFeedUrl builds from FEED_ORIGIN (Hyperpax:src/core/feeds.ts:2, Hyperpax:src/core/feeds.ts:8-14) (contracts/data-services.md section 12)."
ac_13 = "No kline topic exists: a subscribe to <SYMBOL>@kline_<interval> answers the error unknown_topic (contracts/data-services.md section 10, section 12)."
ac_14 = "No candle table exists in schema perps and no candle package exists under platform/perps-data (contracts/data-services.md section 12)."

[req.7010]
title = "Symbol REST routes and symbol WebSocket topics follow the application data protocol"
ac_1 = "GET /api/<symbol>/price answers symbol, price (the latest index_price), timestamp, open, high and low over 24 hours of fills (Hyperpax:data_api.md:103, contracts/data-services.md section 9)."
ac_2 = "GET /api/<symbol>/stats answers symbol, volume_24h, open_interest, est_funding_rate, last_funding_rate (Hyperpax:data_api.md:118)."
ac_3 = "GET /api/<symbol>/perp_stats answers the /stats fields plus mark_price, index_price, basis_bps, long_short_ratio, liq_volume_24h (Hyperpax:data_api.md:132)."
ac_4 = "GET /api/<symbol>/trades/<symbol> answers symbol, count and trades with id, side, price, size, trade_time newest first from the spot swaps and executed spot orders of the token, for PAX and SID only; other symbols answer an empty list (Hyperpax:data_api.md:151, contracts/data-services.md section 9)."
ac_5 = "GET /api/<symbol>/perp_trades/<symbol> answers symbol, count and trades with id, side, price, contracts, notional, liquidation, trade_time from perps.fills, side the taker side (Hyperpax:data_api.md:166, contracts/data-services.md section 9)."
ac_6 = "GET /api/<symbol>/health answers status, backfill, lastFill (the block time of the latest fill of the market, null when none) and symbol (Hyperpax:data_api.md:188, contracts/data-services.md section 9)."
ac_7 = "limit on the trade routes is clamped to [1, 1000] with default 100 (Hyperpax:data_api.md:154)."
ac_8 = "An unknown symbol answers 404 with the error Unknown symbol, the symbol set being Hyperpax:src/core/feeds.ts:4."
ac_9 = "Topic <SYMBOL>@orderbook is served for PAX and SID only and delivers asks ascending and bids descending, up to 100 levels per side, each level [price, size], aggregated from the open spot_orders of the token, bids from buy orders and asks from sell orders at target_price (Hyperpax:data_api.md:214, contracts/data-services.md section 10)."
ac_10 = "Topic <SYMBOL>@trade is served for PAX and SID only and delivers one frame per spot swap or executed spot order; the subscribe snapshot carries the most recent 100 trades newest first (Hyperpax:data_api.md:234, contracts/data-services.md section 10)."
ac_11 = "Topic <SYMBOL>@stats delivers the /stats fields every 30 seconds and on subscribe (Hyperpax:data_api.md:267)."
ac_12 = "A subscribe to <SYMBOL>@orderbook or <SYMBOL>@trade for a symbol other than PAX and SID answers the error unknown_topic; those symbols stay on the Chainflow feed (contracts/data-services.md section 10)."
ac_13 = "Topic <SYMBOL>@perp_orderbook delivers the perpetual book with mark_price, index_price and basis_bps, sizes in contracts (Hyperpax:data_api.md:341, contracts/data-services.md section 10)."
ac_14 = "Topic <SYMBOL>@perp_trade delivers one frame per Fill with contracts, notional and liquidation; snapshot of the last 100 fills (Hyperpax:data_api.md:364, contracts/data-services.md section 10)."
ac_15 = "Topic <SYMBOL>@perp_stats delivers the /perp_stats fields every 30 seconds and on subscribe (Hyperpax:data_api.md:388)."
ac_16 = "Perpetual book levels aggregate the perps.orders rows with status active, a non-zero limit_price and remaining_size_usd above 0, bids from is_long orders and asks from the others, each level summing remaining_size_usd at its limit_price (contracts/data-services.md section 10)."
ac_17 = "Live book frames are coalesced to at most 10 per second with the top 20 levels per side (contracts/data-services.md section 22)."
ac_18 = "Every 5 seconds a book frame carries checksum, the CRC32 IEEE of the top 20 levels as price:size pairs joined by commas, asks then bids (contracts/data-services.md section 22)."
ac_19 = "A subscribe to <SYMBOL>@perp_orderbook for an unknown symbol answers the error unknown_topic (contracts/data-services.md section 8)."
ac_20 = "A socket opened on /ws/<symbol> is subscribed on open to the topics of section 10 for that symbol, the path the application symbol streams open (Hyperpax:src/hooks/perps/useSidPaxMarketStream.ts:60-70, Hyperpax:src/hooks/spot/useSpotMarketStream.ts:31-34) (contracts/data-services.md section 8)."

[req.7011]
title = "The markets table, totals and market topics are served for the eighteen markets"
ac_1 = "GET /api/markets returns one record per row of perps.markets with the 23 fields of Hyperpax:data_api.md:424-461, at the path the application reads (Hyperpax:src/core/feeds.ts:3), its leverage taken from max_leverage (contracts/data-services.md section 11)."
ac_2 = "GET /api/markets/<symbol> is case-insensitive (Hyperpax:data_api.md:463)."
ac_3 = "An unknown symbol answers 404 with Unknown symbol (Hyperpax:data_api.md:471)."
ac_4 = "GET /api/totals returns total_trades, volume_24h, volume_7d, volume_30d and total_oi (Hyperpax:data_api.md:473)."
ac_5 = "GET /api/markets/health returns ok, service, symbols and uptimeSec (Hyperpax:data_api.md:490)."
ac_6 = "funding_8h is eight times the latest hourly rate, perp_next_funding_ms the next whole UTC hour, perp_basis_bps (mark - index) / index times 10000 (contracts/data-services.md section 11)."
ac_7 = "Topic markets@all delivers the full markets array every 5 seconds and on subscribe (Hyperpax:data_api.md:498)."
ac_8 = "Topic markets@totals delivers the totals object every 5 seconds and on subscribe (Hyperpax:data_api.md:513)."
ac_9 = "Topic <SYMBOL>@market delivers one market record every 5 seconds while subscribed (Hyperpax:data_api.md:534)."
ac_10 = "The fixed routes /api/markets/health, /api/markets/open-interest, /api/markets/tickers and /api/markets/ticker/<SYMBOL> take precedence over /api/markets/<symbol> (contracts/data-services.md section 11)."

[req.7012]
title = "One shared WebSocket carries every topic with snapshots, dense sequences and resume"
ac_1 = "The client event subscribe is accepted as documented (Hyperpax:data_api.md:32)."
ac_2 = "The client event unsubscribe is accepted as documented (Hyperpax:data_api.md:33)."
ac_3 = "The client event ping is accepted as documented (Hyperpax:data_api.md:34)."
ac_4 = "The error code invalid_json is sent as documented (Hyperpax:data_api.md:52-53)."
ac_5 = "The error code missing_topic is sent as documented (Hyperpax:data_api.md:52-53)."
ac_6 = "The error code unknown_event is sent as documented (Hyperpax:data_api.md:52-53)."
ac_7 = "The error code subscribe_rate_limit is sent as documented (Hyperpax:data_api.md:52-53)."
ac_8 = "The error code too_many_subscriptions is sent as documented (Hyperpax:data_api.md:52-53)."
ac_9 = "welcome, subscribed, unsubscribed and pong carry ts and snapshotId as documented (Hyperpax:data_api.md:44-50)."
ac_10 = "Data frames carry topic, ts, snapshotId, seq, snapshot and data (Hyperpax:data_api.md:59-68); snapshot is omitted on live frames."
ac_11 = "Per socket at most 200 subscriptions and 50 subscribe operations per second (Hyperpax:data_api.md:88)."
ac_12 = "The server pings every 30 seconds (Hyperpax:data_api.md:86) and closes a socket that answers no ping within two intervals."
ac_13 = "Shedding closes with 1013 and a retry-after reason the application parses (Hyperpax:src/core/net/realtime.ts:84-85)."
ac_14 = "subscribe sends subscribed, then one snapshot frame carrying the seq of the last broadcast, then deltas with greater seq (Hyperpax:data_api.md:77-79)."
ac_15 = "seq increases by exactly 1 per delta per topic (Hyperpax:data_api.md:75-76), so the application guard accepts every frame (Hyperpax:src/core/net/realtime.ts:29-47)."
ac_16 = "After a consumer reset the hub resumes from the JetStream sequence of the last applied message (Launch-x:shared/delivery/natsdriver/driver.go:238)."
ac_17 = "A rewind message makes every affected topic send a fresh snapshot with the next seq (contracts/data-services.md section 4)."
ac_18 = "A gap the hub cannot fill closes the socket with 1013 so the client resyncs, the rule of Hyperpax:src/core/net/realtime.ts:42."
ac_19 = "Frames older than 60 seconds are never sent because the client closes on them (Hyperpax:src/core/net/realtime.ts:68)."
ac_20 = "A gateway restart yields a new snapshotId and the client drops local state (Hyperpax:data_api.md:72-74)."
ac_21 = "The error code unknown_topic is sent for a topic outside the served set and the socket stays open (contracts/data-services.md section 8)."
ac_22 = "A socket opened on /ws/markets is subscribed on open to markets@all and markets@totals (Hyperpax:src/hooks/perps/useMarketsStream.ts:22-29), and one opened on /ws/explorer to chain@blocks and chain@transactions (Hyperpax:src/hooks/chain/useExplorerStream.ts:29) (contracts/data-services.md section 8)."

[req.7013]
title = "Every perpetuals GraphQL query root resolves from the indexed tables"
ac_1 = "Query.position (Hyperpax:src/core/perps/perpetual.graphql:571) returns Position (Hyperpax:src/core/perps/perpetual.graphql:29) from perps.positions_current (contracts/data-services.md section 13)."
ac_2 = "Query.positions (Hyperpax:src/core/perps/perpetual.graphql:572) returns Position (Hyperpax:src/core/perps/perpetual.graphql:29) from perps.positions_current (contracts/data-services.md section 13)."
ac_3 = "Query.trades (Hyperpax:src/core/perps/perpetual.graphql:581) returns Trade (Hyperpax:src/core/perps/perpetual.graphql:56) from perps.trade_settlements: tradeType the name of the enumeration of section 6 (open, close, liquidation, reduce, increase, adl, backstop); isLong from positions_current; price = execution_price; realizedPnl = gross_pnl; feeUsd = total_fees_usd (contracts/data-services.md section 13)."
ac_4 = "Query.order (Hyperpax:src/core/perps/perpetual.graphql:591) returns Order (Hyperpax:src/core/perps/perpetual.graphql:76) from perps.orders; failureReason is always null (no order fails asynchronously) (contracts/data-services.md section 13)."
ac_5 = "Query.orders (Hyperpax:src/core/perps/perpetual.graphql:592) returns Order (Hyperpax:src/core/perps/perpetual.graphql:76) from perps.orders; status names active, triggered, filled, cancelled, expired (contracts/data-services.md section 13)."
ac_6 = "Query.liquidations (Hyperpax:src/core/perps/perpetual.graphql:602) returns Liquidation (Hyperpax:src/core/perps/perpetual.graphql:101) from perps.liquidations (contracts/data-services.md section 13)."
ac_7 = "Query.market (Hyperpax:src/core/perps/perpetual.graphql:610) returns Market (Hyperpax:src/core/perps/perpetual.graphql:13) from perps.markets (maxLeverage from the seed and refresh of section 11), market_stats_rolling (contracts/data-services.md section 13)."
ac_8 = "Query.markets (Hyperpax:src/core/perps/perpetual.graphql:611) returns Market (Hyperpax:src/core/perps/perpetual.graphql:13) from perps.markets, market_stats_rolling (contracts/data-services.md section 13)."
ac_9 = "Query.latestPrices (Hyperpax:src/core/perps/perpetual.graphql:614) returns LatestPrice (Hyperpax:src/core/perps/perpetual.graphql:128) from perps.mark_prices, latest row per market: price = index_price, onchainTimestamp = block time in seconds (contracts/data-services.md section 13)."
ac_10 = "Query.priceHistory (Hyperpax:src/core/perps/perpetual.graphql:615) returns PriceUpdate (Hyperpax:src/core/perps/perpetual.graphql:118) from perps.index_prices kind aggregate: price = index_price, onchainTimestamp = timestamp_ms / 1000, txHash = the block hash (contracts/data-services.md section 13)."
ac_11 = "Query.fundingRates (Hyperpax:src/core/perps/perpetual.graphql:622) returns FundingRate (Hyperpax:src/core/perps/perpetual.graphql:140) from perps.funding_rates (contracts/data-services.md section 13)."
ac_12 = "Query.userVault (Hyperpax:src/core/perps/perpetual.graphql:629) returns UserVault (Hyperpax:src/core/perps/perpetual.graphql:154) from perps.vaults (vaultAddress 0x0000000000000000000000000000000000001015, createdAt the block time of VaultCreated) and account_margin (contracts/data-services.md section 13)."
ac_13 = "Query.vaultEvents (Hyperpax:src/core/perps/perpetual.graphql:630) returns VaultEvent (Hyperpax:src/core/perps/perpetual.graphql:162) from perps.collateral_events: eventType deposited, withdrawn, transferred_in or transferred_out; tokenAddress USDL (contracts/data-services.md section 13)."
ac_14 = "Query.collateralTokens (Hyperpax:src/core/perps/perpetual.graphql:638) returns CollateralToken (Hyperpax:src/core/perps/perpetual.graphql:178) from one constant row: tokenAddress 0x85FcD13735F4309833A503EE804ea32395851479, decimals 6, isActive true, addedAt the activation block time (contracts/data-services.md section 13)."
ac_15 = "Query.poolStates (Hyperpax:src/core/perps/perpetual.graphql:641) returns PoolState (Hyperpax:src/core/perps/perpetual.graphql:189) from latest perps.mark_prices per market: baseReserve \"0\", quoteReserve \"0\", oraclePrice = the latest index_price (contracts/data-services.md section 13)."
ac_16 = "Query.poolState (Hyperpax:src/core/perps/perpetual.graphql:642) returns PoolState (Hyperpax:src/core/perps/perpetual.graphql:189) from as poolStates for one market (contracts/data-services.md section 13)."
ac_17 = "Query.feeConfig (Hyperpax:src/core/perps/perpetual.graphql:645) returns FeeConfig (Hyperpax:src/core/perps/perpetual.graphql:202) from perps.fee_config: each Bps field = the ppm value / 100 rounded down (takerFeeBps from taker_fee_ppm, makerFeeBps from maker_fee_ppm, liquidationFeeBps from liquidation_fee_ppm, insuranceFeeBps from insurance_share_ppm); updatedAt the refresh block time (contracts/data-services.md section 13)."
ac_18 = "Query.protocolEvents (Hyperpax:src/core/perps/perpetual.graphql:648) returns ProtocolEvent (Hyperpax:src/core/perps/perpetual.graphql:214) from perps.protocol_events (contracts/data-services.md section 13)."
ac_19 = "Query.userStats (Hyperpax:src/core/perps/perpetual.graphql:655) returns UserStats (Hyperpax:src/core/perps/perpetual.graphql:454) from perps.user_stats (contracts/data-services.md section 13)."
ac_20 = "Query.marketStats (Hyperpax:src/core/perps/perpetual.graphql:656) returns MarketStats (Hyperpax:src/core/perps/perpetual.graphql:466) from perps.market_stats_rolling (contracts/data-services.md section 13)."
ac_21 = "Query.globalStats (Hyperpax:src/core/perps/perpetual.graphql:657) returns GlobalStats (Hyperpax:src/core/perps/perpetual.graphql:478) from perps.market_stats_rolling (sum over markets) (contracts/data-services.md section 13)."
ac_22 = "Query.indexerStatus (Hyperpax:src/core/perps/perpetual.graphql:658) returns IndexerStatus (Hyperpax:src/core/perps/perpetual.graphql:228) from perps.cursors, blocks (contracts/data-services.md section 13)."
ac_23 = "Query.keeperCycles (Hyperpax:src/core/perps/perpetual.graphql:661) returns KeeperCycle (Hyperpax:src/core/perps/perpetual.graphql:240) from perps.keeper_cycles: txHash the perps_endblock receipt hash (contracts/data-services.md section 13)."
ac_24 = "Query.accountLedger (Hyperpax:src/core/perps/perpetual.graphql:664) returns AccountLedgerEntry (Hyperpax:src/core/perps/perpetual.graphql:257) from the perps.account_ledger view; entryId the row_id, tokenAddress USDL (contracts/data-services.md section 13)."
ac_25 = "Query.delegates (Hyperpax:src/core/perps/perpetual.graphql:672) returns Delegate (Hyperpax:src/core/perps/perpetual.graphql:275) from answers []; this release has no delegate events (contracts/data-services.md section 13)."
ac_26 = "Query.tradingAccountEvents (Hyperpax:src/core/perps/perpetual.graphql:675) returns TradingAccountEvent (Hyperpax:src/core/perps/perpetual.graphql:293) from perps.collateral_events and perps.position_events: eventType the kind, extraData a JSON object of the remaining argument columns as decimal strings (contracts/data-services.md section 13)."
ac_27 = "Query.fees (Hyperpax:src/core/perps/perpetual.graphql:683) returns Fee (Hyperpax:src/core/perps/perpetual.graphql:310) from perps.fees (contracts/data-services.md section 13)."
ac_28 = "Query.tradeSettlements (Hyperpax:src/core/perps/perpetual.graphql:693) returns TradeSettlement (Hyperpax:src/core/perps/perpetual.graphql:330) from perps.trade_settlements (contracts/data-services.md section 13)."
ac_29 = "Query.oiSnapshots (Hyperpax:src/core/perps/perpetual.graphql:703) returns OiSnapshot (Hyperpax:src/core/perps/perpetual.graphql:353) from perps.open_interest facts: longOi, shortOi, deltaUsd, isIncrease (contracts/data-services.md section 13)."
ac_30 = "Query.markPriceHistory (Hyperpax:src/core/perps/perpetual.graphql:710) returns MarkPriceRecord (Hyperpax:src/core/perps/perpetual.graphql:369) from perps.mark_prices: baseReserve \"0\", quoteReserve \"0\" (contracts/data-services.md section 13)."
ac_31 = "Query.vaultBalanceHistory (Hyperpax:src/core/perps/perpetual.graphql:717) returns VaultBalanceRecord (Hyperpax:src/core/perps/perpetual.graphql:385) from perps.collateral_events new_balance (vaultType 0, vaultTypeName collateral) and perps.insurance_events kind draw new_balance (vaultType 1, vaultTypeName insurance); delta = amount, isIncrease for deposits (contracts/data-services.md section 13)."
ac_32 = "Query.fundingPayments (Hyperpax:src/core/perps/perpetual.graphql:725) returns FundingPayment (Hyperpax:src/core/perps/perpetual.graphql:402) from perps.funding_payments (contracts/data-services.md section 13)."
ac_33 = "Query.marketSnapshots (Hyperpax:src/core/perps/perpetual.graphql:734) returns MarketSnapshotRecord (Hyperpax:src/core/perps/perpetual.graphql:419) from perps.market_snapshots (contracts/data-services.md section 13)."
ac_34 = "Query.protocolSnapshots (Hyperpax:src/core/perps/perpetual.graphql:741) returns ProtocolSnapshotRecord (Hyperpax:src/core/perps/perpetual.graphql:438) from perps.protocol_snapshots: tvlUsd from usdl_transfers (the sum of  in - the sum of  out), insuranceTotalUsd = the latest InsuranceDraw new_balance plus later contributions (contracts/data-services.md section 13)."
ac_35 = "Query.enrichedGlobalStats (Hyperpax:src/core/perps/perpetual.graphql:747) returns EnrichedGlobalStats (Hyperpax:src/core/perps/perpetual.graphql:552) from perps.market_stats_rolling (sum over markets) (contracts/data-services.md section 13)."
ac_36 = "Query.enrichedMarketStats (Hyperpax:src/core/perps/perpetual.graphql:748) returns EnrichedMarketStats (Hyperpax:src/core/perps/perpetual.graphql:557) from perps.market_stats_rolling (contracts/data-services.md section 13)."
ac_37 = "Query.orderlyTickers (Hyperpax:src/core/perps/perpetual.graphql:751) returns OrderlyTicker (Hyperpax:src/core/perps/perpetual.graphql:493) from perps.market_stats_rolling; the h24 fields from fills of 24 hours (contracts/data-services.md section 13)."
ac_38 = "Query.orderlyFundingRates (Hyperpax:src/core/perps/perpetual.graphql:752) returns OrderlyFundingRate (Hyperpax:src/core/perps/perpetual.graphql:541) from perps.funding_rates (latest row per market) (contracts/data-services.md section 13)."
ac_39 = "Query.orderlyPriceChanges (Hyperpax:src/core/perps/perpetual.graphql:753) returns OrderlyPriceChange (Hyperpax:src/core/perps/perpetual.graphql:520) from perps.mark_prices history: change over 5m, 30m, 1h, 4h, 24h, 3d, 7d and 30d of index_price (contracts/data-services.md section 13)."
ac_40 = "Query.orderlyOpenInterests (Hyperpax:src/core/perps/perpetual.graphql:754) returns OrderlyOpenInterest (Hyperpax:src/core/perps/perpetual.graphql:534) from perps.open_interest (latest row per market) (contracts/data-services.md section 13)."
ac_41 = "limit defaults to 50 and is clamped to [1, 500]; offset is clamped to [0, 100000] (contracts/data-services.md section 13)."
ac_42 = "A query deeper than 10 levels is refused before any database read (contracts/data-services.md section 13)."
ac_43 = "Position.market is loaded with one batched query per request (Hyperpax:src/hooks/perps/useSubgraph.ts:23)."
ac_44 = "Query.leaderboard(limit, offset) returns LeaderboardEntry with rank, userAddress, totalRealizedPnl, totalTrades, winRate, avgHoldTime, openPositions and totalVolume from perps.leaderboard, a root the application reads (Hyperpax:src/hooks/perps/useSubgraph.ts:236) that the schema adds (contracts/data-services.md section 13)."

[req.7014]
title = "Every spot GraphQL query root resolves, with roots lacking a source event answering empty lists"
ac_1 = "Query.spotMarket (Hyperpax:src/core/perps/perpetual.graphql:761) returns SpotMarket (Hyperpax:src/core/perps/perpetual.graphql:843) from perps.spot_token_registry, non-stablecoin tokens (PAX, SID): marketId the token address, baseToken the token, quoteToken USDL, mode 0, modeName pecor, status active or paused (latest Paused, Unpaused or TokenPauseUpdated), created* from the TokenRegistered row, lastModeChange* null (contracts/data-services.md section 13)."
ac_2 = "Query.spotMarkets (Hyperpax:src/core/perps/perpetual.graphql:762) returns SpotMarket (Hyperpax:src/core/perps/perpetual.graphql:843) from as spotMarket (contracts/data-services.md section 13)."
ac_3 = "Query.spotOrder (Hyperpax:src/core/perps/perpetual.graphql:765) returns SpotOrder (Hyperpax:src/core/perps/perpetual.graphql:858) from perps.spot_orders: side 0 buy, 1 sell (a stop-loss is a sell); orderType 0 limit, 1 stop_limit, 2 stop_loss; offsetBps 0; size = amount; filledSize = amount when executed, else 0 (contracts/data-services.md section 13)."
ac_4 = "Query.spotOrders (Hyperpax:src/core/perps/perpetual.graphql:766) returns SpotOrder (Hyperpax:src/core/perps/perpetual.graphql:858) from as spotOrder (contracts/data-services.md section 13)."
ac_5 = "Query.spotOrderFills (Hyperpax:src/core/perps/perpetual.graphql:775) returns SpotOrderFill (Hyperpax:src/core/perps/perpetual.graphql:880) from perps.spot_order_events executed kinds only: fillSize the order amount, fillPrice the execution price, fillScore 0 (contracts/data-services.md section 13)."
ac_6 = "Query.spotBatchClearings (Hyperpax:src/core/perps/perpetual.graphql:784) of type SpotBatchClearing (Hyperpax:src/core/perps/perpetual.graphql:894) has no source event in this release and answers [] with no error (contracts/data-services.md section 13)."
ac_7 = "Query.spotEpochSettlements (Hyperpax:src/core/perps/perpetual.graphql:791) of type SpotEpochSettlement (Hyperpax:src/core/perps/perpetual.graphql:908) has no source event in this release and answers [] with no error (contracts/data-services.md section 13)."
ac_8 = "Query.spotFastSettlements (Hyperpax:src/core/perps/perpetual.graphql:794) of type SpotFastSettlement (Hyperpax:src/core/perps/perpetual.graphql:918) has no source event in this release and answers [] with no error (contracts/data-services.md section 13)."
ac_9 = "Query.spotCollateralMovements (Hyperpax:src/core/perps/perpetual.graphql:802) returns SpotCollateralMovement (Hyperpax:src/core/perps/perpetual.graphql:930) from perps.spot_vault_events kinds deposit, withdrawal, lp_withdrawal, native_deposit, native_withdrawal; native rows carry the registered PAX token address (contracts/data-services.md section 13)."
ac_10 = "Query.spotMarketModeChanges (Hyperpax:src/core/perps/perpetual.graphql:811) of type SpotMarketModeChange (Hyperpax:src/core/perps/perpetual.graphql:942) has no source event in this release and answers [] with no error (contracts/data-services.md section 13)."
ac_11 = "Query.spotPofqUpdates (Hyperpax:src/core/perps/perpetual.graphql:818) of type SpotPofqUpdate (Hyperpax:src/core/perps/perpetual.graphql:954) has no source event in this release and answers [] with no error (contracts/data-services.md section 13)."
ac_12 = "Query.spotPLVs (Hyperpax:src/core/perps/perpetual.graphql:826) of type SpotPLV (Hyperpax:src/core/perps/perpetual.graphql:966) has no source event in this release and answers [] with no error (contracts/data-services.md section 13)."
ac_13 = "Query.spotKeeperCycles (Hyperpax:src/core/perps/perpetual.graphql:829) of type SpotKeeperCycle (Hyperpax:src/core/perps/perpetual.graphql:977) has no source event in this release and answers [] with no error (contracts/data-services.md section 13)."
ac_14 = "Query.spotBatchClearFailures (Hyperpax:src/core/perps/perpetual.graphql:832) of type SpotBatchClearFailure (Hyperpax:src/core/perps/perpetual.graphql:988) has no source event in this release and answers [] with no error (contracts/data-services.md section 13)."

