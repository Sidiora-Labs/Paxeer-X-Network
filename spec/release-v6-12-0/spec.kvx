do_1 = "loadtest.Profile defines 140000 concurrent sockets across the gateway replicas, each subscribing to <SYMBOL>@perp_orderbook, <SYMBOL>@perp_trade and markets@all for the eighteen symbols (Hyperpax:src/core/feeds.ts:4)."
do_2 = "The reconnect storm drops 20 percent of the sockets at once and reconnects them at no more than 6000 per second; every socket returns to a guarded live stream within 60 seconds."
do_3 = "Book topics deliver at most 10 frames per second with 20 levels per side, and a checksum frame at least every 5 seconds that matches the CRC32 of the client-side book."
do_4 = "Report checks every frame with the sequence rule of the application (Hyperpax:src/core/net/realtime.ts:29-47) and fails on any gap that is not followed by a resync, on p99 frame delay above 250 ms, and on any 1013 close without a retry-after reason."
do_5 = "TestLoadProfile runs the profile scaled to 2000 sockets against one gateway built from gateway.NewServer with an in-process nats-server and PERPS_DATA_TEST_DATABASE_URL; cmd/perps-loadtest runs the full profile against the gateway named by PERPS_GATEWAY_URL."
