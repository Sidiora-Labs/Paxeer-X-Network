do_2 = "Cross-domain note for baseline task 1.3.101: PerpsK() on PrecompileKeepers (node/precompiles.go:17-71) (symbol PerpsK)."
do_3 = "Cross-domain note for baseline task 1.3.103: EndBlocker call in node/legacyabci/end_block.go:22-28 (symbol EndBlocker)."
do_4 = "Cross-domain notes for baseline task 1.3.102 (perps store key) and baseline task 1.3.100 (NewAppModule, the 0x1015 registration at node/app.go:961-965 and SeedV6120 in the v6.12.0 handler, the 0x1015 gate of node/upgrades.go:489-503 kept) (symbol SeedV6120)."

