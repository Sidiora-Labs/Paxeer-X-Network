scenario = "Given the rehearsal chain, when a spot buy and sell of PAX and SID against USDL run, then USDL moves as the ERC20 into the spot module EVM address under the allowance to the spot precompile address and out of that module EVM address, PAX and SID move as bank transfers, and maker and taker fees follow the parameter sheet in the same transaction."
contract = "contracts/spot.md"
test = "tools/release/rehearse-v6120.sh::check_spot_settlement (planned)"
