[feature.5]
name = "pricefeed"
scope = "The validator-run price path of Paxeer X Network: the new modules/pricefeed module with its market table, feed key registry, fee-free MsgSubmitPrices, per-block aggregation of the bonded set's observations into an index and a mark price, and the GetPrice read API with a freshness flag; the precompile at 0x1020 that serves those reads and the feed key writes; the price-sidecar binary built from platform/hosted/feeder that reads the Chainflow feed and signs one submission per block; and its install files under tools/price-sidecar. modules/oracle stays unchanged; the node wiring is task 1.3.100."
requirements = ["5001", "5002", "5003", "5004", "5005", "5006", "5007", "5008", "5009", "5010", "5011", "5012", "5013", "5014", "5015", "5016", "5017"]
completion_task = "5.3.99"

[req.5001]
title = "The eighteen markets carry fixed ids and their Chainflow symbol forms"
ac_1 = "types.Markets lists exactly eighteen markets with the ids of the application table (Hyperpax:src/core/perps/config.ts:168-185): 0 BTC, 1 ETH, 2 SOL, 3 AVAX, 4 LINK, 5 TSLA, 6 NVDA, 7 NAS100, 8 XAU, 9 SPX500, 10 GOOGL, 11 PAX, 12 SID, 13 HYPE, 14 XRP, 15 ASTER, 16 TRUMP, 17 BNB, and the symbol set equals FEED_SYMBOLS (Hyperpax:src/core/feeds.ts:4)."
ac_2 = "Each market carries the Chainflow request symbol (upper case), the response symbol PERP_<SYMBOL>_USDC that normalizeFeedSymbol strips (Hyperpax:src/core/feeds.ts:5-7) and the lower-case path name that candleFeedUrl builds (Hyperpax:src/core/feeds.ts:13)."
ac_3 = "0x1020 marketIdOf(string) returns the id of an upper-case symbol and reverts LXP_PRICEFEED_UNKNOWN_MARKET for any other string, matching case-sensitively as FEED_SYMBOLS spells the names (Hyperpax:src/core/feeds.ts:4)."
ac_4 = "0x1020 getMarket(uint256) returns (marketId, symbol, chainflowSymbol, minPrice, maxPrice, enabled) of a listed market and getMarketCount() returns the number of listed markets, the view shape of the xweb getParams case (precompiles/xweb/xweb.go:276-282)."
ac_5 = "A listing through MsgSetParams appends the next id and Params.Validate refuses a change of the id or symbol of an existing market with LXP_PRICEFEED_INVALID_PARAMS, the validate-then-store order of xweb SetParams (modules/xweb/keeper/keeper.go:120-126)."

[req.5002]
title = "Each validator registers at most one price feed key"
ac_1 = "registerFeedKey(bytes) from the EVM address of a bonded validator operator stores the key and the reverse entry and returns the feed account; the caller resolves through GetPaxAddressOrDefault (modules/evm/keeper/address.go:58) and the bonded check of ValidateFeeder (modules/oracle/keeper/keeper.go:396-398)."
ac_2 = "registerFeedKey from an address that is not a bonded validator operator reverts LXP_PRICEFEED_NOT_VALIDATOR, the refusal ValidateFeeder raises for a validator outside the active set (modules/oracle/keeper/keeper.go:396-397)."
ac_3 = "A pubKey that is not 33 bytes or does not decode as a compressed secp256k1 point reverts LXP_PRICEFEED_INVALID_KEY."
ac_4 = "A key whose feed account is registered to another validator reverts LXP_PRICEFEED_KEY_IN_USE, so a feed account maps to exactly one validator."
ac_5 = "Registering again replaces the validator's key in the same call: the old reverse entry is deleted and the FeedKeyRegistered log carries the previous feed account in its data."
ac_6 = "Registration creates the feed account in the auth module when absent, through HasAccount (sdk/x/auth/keeper/account.go:29) and NewAccountWithAddress (sdk/x/auth/keeper/account.go:9), so the account has an account number before its first submission."
ac_7 = "revokeFeedKey() removes the caller's key and reverse entry and emits FeedKeyRevoked(validator, feedAccount); a caller without a key reverts LXP_PRICEFEED_NO_KEY."
ac_8 = "Both writes emit the EVM log through pcommon.EmitEVMLog (precompiles/common/evm_events.go:16) with the event ID as topic 0 and the indexed validator and feed account as topics 1 and 2, the path of the xweb log helper (precompiles/xweb/xweb.go:500-510)."
ac_9 = "Registration emits the Cosmos event pricefeed_feed_key {validator, feed_account, previous_feed_account} and revocation emits pricefeed_feed_key_revoked {validator, feed_account}."
ac_10 = "getFeedKey(address) and getValidatorByFeedAccount(address) return the stored pair, and empty bytes or the zero address when none is stored."

[req.5003]
title = "MsgSubmitPrices carries signed observations that are checked one by one"
ac_1 = "MsgSubmitPrices {feeder, observations[market_id, sequence, index_price, mark_price, source_timestamp_ms]} is declared in api/pricefeed/tx.proto with the package and go_package layout of api/xweb/tx.proto:1-6 and GetSigners returns only the feeder."
ac_2 = "ValidateBasic refuses with LXP_PRICEFEED_INVALID_OBSERVATION an invalid bech32 feeder, zero observations, a zero sequence, a zero timestamp, and a price that is not a decimal integer of at most 39 digits without a leading zero or is zero."
ac_3 = "ValidateBasic refuses a repeated market id with LXP_PRICEFEED_DUPLICATE_MARKET and more than 64 observations with LXP_PRICEFEED_TOO_MANY_OBSERVATIONS."
ac_4 = "The message server refuses the whole message for an unregistered feeder (LXP_PRICEFEED_UNREGISTERED_FEEDER), a validator that is not bonded (LXP_PRICEFEED_NOT_VALIDATOR) and more observations than max_observations_per_submission (LXP_PRICEFEED_TOO_MANY_OBSERVATIONS), in the order of CheckOracleSpamming (modules/oracle/ante.go:43-72)."
ac_5 = "An accepted observation replaces the validator's stored observation of the market with its height and emits pricefeed_observation {validator, market_id, sequence, index_price, mark_price, source_timestamp_ms}."
ac_6 = "An observation whose market id is not listed is refused with reason unknown_market and one whose market is disabled with reason market_disabled; the other observations of the message continue."
ac_7 = "A sequence not greater than the stored sequence of the validator and market is refused with reason sequence, the kernel rule of src/modules/perps/lx_oracle_intake.c:150-152."
ac_8 = "A source timestamp later than block time plus max_clock_skew_ms is refused with reason future and one older than block time minus staleness_window_ms with reason stale, the two checks of src/modules/perps/lx_oracle_checks.c:11-14."
ac_9 = "An index or mark price outside [min_price, max_price] of its market is refused with reason bounds, the rule of src/modules/perps/lx_oracle_checks.c:18-27."
ac_10 = "While the market's aggregate is fresh an index price farther than max_deviation_bps from the aggregate index is refused with reason deviation (src/modules/perps/lx_oracle_checks.c:29-49); while it is not fresh the deviation check is skipped so the market recovers, as the kernel clears its halt (src/modules/perps/lx_oracle_intake.c:157-170)."
ac_11 = "Every refused observation emits pricefeed_observation_refused {validator, market_id, sequence, reason} with reason one of unknown_market, market_disabled, sequence, future, stale, bounds, deviation, and the response reports accepted and refused counts."

[req.5004]
title = "Price submissions pay no fee and are bounded in size and rate"
ac_1 = "SubmissionIsGasless(ctx, msg, k) returns true for a MsgSubmitPrices of a registered feed account of a bonded validator that has not submitted at the current height, the role oracleVoteIsGasless plays for the vote (node/antedecorators/gasless.go:106-132)."
ac_2 = "SubmissionIsGasless returns false for an unregistered feeder and for the feeder of a validator that is not bonded, so the fee decorator wrapped by the gasless decorator charges them (node/antedecorators/gasless.go:28-54)."
ac_3 = "NewSubmissionAloneDecorator refuses a tx that carries MsgSubmitPrices beside another message with LXP_PRICEFEED_SUBMISSION_ALONE, the VoteAloneDecorator rule (modules/oracle/ante.go:74-100)."
ac_4 = "NewSubmissionRateDecorator refuses a second submission of a validator at one height with LXP_PRICEFEED_RATE_LIMITED using the stored last submission height, the counter rule of CheckAndSetSpamPreventionCounter (modules/oracle/keeper/keeper.go:594-604)."
ac_5 = "NewSubmissionRateDecorator refuses a tx over max_submission_bytes with LXP_PRICEFEED_SUBMISSION_TOO_LARGE and an unregistered feeder with LXP_PRICEFEED_UNREGISTERED_FEEDER before signature verification."
ac_6 = "The message server repeats the height check, so two submissions of one validator delivered in one block apply at most once."
ac_7 = "The submission path is a Cosmos message because the EVM fee check refuses a fee cap below the base fee (modules/evm/ante/fee.go:53-58); MsgSubmitPrices is not reachable through 0x1020."

[req.5005]
title = "The chain aggregates the active set's observations per block deterministically"
ac_1 = "Aggregation runs in the module's MidBlock after every transaction of the block (node/app.go:2221-2226), over the bonded validators read through ValidatorsPowerStoreIterator up to MaxValidators as the vote module builds its claim map (modules/oracle/abci.go:30-48)."
ac_2 = "Only observations with block_time_ms - source_timestamp_ms <= staleness_window_ms are candidates."
ac_3 = "The required count is max(min_sources, floor(bonded / 2) + 1); below it the aggregate is not updated and pricefeed_aggregate_skipped {market_id, sources, required} is emitted."
ac_4 = "The median sorts candidates by price and then by operator bytes; an odd count takes the middle element and an even count the floor midpoint, the rule of the feeder median (platform/hosted/feeder/src/lib.rs:284-298)."
ac_5 = "Candidates farther than max_divergence_bps from the first median are dropped and the median is taken again, the two-pass rule of the feeder aggregate (platform/hosted/feeder/src/lib.rs:306-360); fewer than the required count after the filter skips the aggregate."
ac_6 = "The aggregate stores index, mark, basis, timestamp = the oldest remaining source timestamp (platform/hosted/feeder/src/lib.rs:354-358), height and sources, and emits pricefeed_aggregate {market_id, index_price, mark_price, basis, timestamp_ms, sources, required}."
ac_7 = "The aggregate depends only on the store and block time: delivering the same submissions in any order inside a block yields byte-identical aggregate records."

[req.5006]
title = "The mark price follows the published formula"
ac_1 = "On a market's first aggregate the basis average B equals D = E - I, where E is the median of the remaining mark observations and I the index."
ac_2 = "Afterwards B = B_prev + (D - B_prev) * dt / (dt + mark_ema_tau_ms) with dt the difference of aggregate timestamps in ms, truncating toward zero; dt = 0 keeps B_prev."
ac_3 = "M0 is the middle value of I + B, E and I."
ac_4 = "M is clamped into [I - I * max_mark_basis_bps / 10000, I + I * max_mark_basis_bps / 10000] and is at least 1."
ac_5 = "The basis average is stored with the aggregate, so the next block continues it; a skipped aggregate leaves it unchanged."

[req.5007]
title = "GetPrice serves the index and mark with a freshness flag"
ac_1 = "GetPrice(ctx, marketId) returns Price{Index, Mark, TimestampMs, Height, Sources, Fresh} from the stored aggregate."
ac_2 = "Fresh is false when block_time_ms - TimestampMs > max_price_age_ms or TimestampMs > block_time_ms + max_clock_skew_ms."
ac_3 = "GetPrice of a disabled market returns Fresh false; GetPrice of a listed market without an aggregate returns zero prices with Fresh false and no error."
ac_4 = "GetPrice of an id not in the params returns LXP_PRICEFEED_UNKNOWN_MARKET."
ac_5 = "GetPriceBySymbol(ctx, symbol) returns the Price of the market with that symbol and LXP_PRICEFEED_UNKNOWN_MARKET for an unknown symbol."

[req.5008]
title = "0x1020 serves the price, market, observation and parameter views"
ac_1 = "getPrice(uint256) and getPriceBySymbol(string) return the Price tuple (indexPrice, markPrice, timestampMs, height, sources, fresh) of GetPrice and GetPriceBySymbol."
ac_2 = "getPrices(uint256[]) returns the Price tuples in input order for at most 64 ids and reverts LXP_PRICEFEED_BATCH_TOO_LARGE above that."
ac_3 = "getObservation(uint256, address) returns (sequence, indexPrice, markPrice, sourceTimestampMs, height) of the stored observation and zeros when none is stored."
ac_4 = "getParams() returns the Params tuple of the stored parameters, the view shape of the xweb getParams case (precompiles/xweb/xweb.go:276-282)."
ac_5 = "Market ids above the largest uint64 and ids not listed revert LXP_PRICEFEED_UNKNOWN_MARKET from getPrice, getPrices, getMarket and getObservation."
ac_6 = "The ABI in precompiles/pricefeed/abi.json equals the interface of precompiles/pricefeed/PriceFeed.sol: twelve methods and two events with the signatures of the contract file, and the golden test pins every selector and topic."

[req.5009]
title = "0x1020 follows the precompile conventions of the chain"
ac_1 = "Views charge 3000 + 16 * len(input) and the two writes 30000 + 16 * len(input), the constants and formula of the xweb precompile (precompiles/xweb/xweb.go:62-64, precompiles/xweb/xweb.go:185-194)."
ac_2 = "A delegatecall reverts LXP_PRICEFEED_DELEGATECALL, a write from a static call reverts LXP_PRICEFEED_STATICCALL and any call without a wired keeper reverts LXP_PRICEFEED_KEEPER_MISSING, the guard of precompiles/xweb/xweb.go:297-310."
ac_3 = "A call with value reverts LXP_PRECOMPILE_NON_PAYABLE and a call with the wrong argument count reverts LXP_PRECOMPILE_ARG_COUNT, the shared codes of precompiles/xweb/xweb.go:236-238 and precompiles/xweb/xweb.go:253-255."
ac_4 = "Every module error is registered under codespace pricefeed with ABCI codes 2 to 16 and types.LXPName returns its LXP_PRICEFEED_ code, the mapping of modules/xweb/types/errors.go:36-48; the precompile wraps keeper errors with that name before reverting."
ac_5 = "Revert data is ABI Error(string) because the precompile is built WithRevertReasons, as xweb is (precompiles/xweb/xweb.go:169)."

[req.5010]
title = "Parameters are validated and set only by the authority"
ac_1 = "DefaultParams(authority) carries the eighteen markets with min_price 1 and max_price 10^30 and the defaults of the contract table; staleness_window_ms 10000 and max_divergence_bps 50 are the feeder bounds (platform/hosted/feeder/tests/fixtures/feeder.json:9-10)."
ac_2 = "Params.Validate refuses with LXP_PRICEFEED_INVALID_PARAMS each out-of-range field of the contract table, non-dense ids, a repeated symbol and min_price >= max_price."
ac_3 = "MsgSetParams from a signer other than the stored authority is refused with LXP_PRICEFEED_UNAUTHORIZED, the requireAuthority rule of modules/xweb/keeper/keeper.go:131-138."
ac_4 = "MsgSetParams from the authority stores the validated params and emits pricefeed_params {authority}."

[req.5011]
title = "The module activates at v6.12.0 with its markets and exports its state"
ac_1 = "InitV6120(ctx, k) writes DefaultParams with the eighteen markets when the store holds no params and registers no feed key."
ac_2 = "InitV6120 returns nil without a change when params are already stored, so a governance change is never overwritten."
ac_3 = "After InitV6120 and before any submission every market reads Fresh false, so the venues refuse trading until the bonded majority submits."
ac_4 = "ExportGenesis and InitGenesis carry params, feed keys, observations and aggregates; InitGenesis refuses a feed account mapped to two validators with LXP_PRICEFEED_INVALID_GENESIS, the JSON genesis path of the xweb module (modules/xweb/module.go:97-112)."
ac_5 = "The store uses the one-byte prefixes of the contract storage table (0x01 params through 0x06 last submission height) with big-endian integers in keys, the layout of modules/xweb/types/keys.go:27-57."
ac_6 = "The module exports the wiring surface task 1.3.100 consumes: types.ModuleName and StoreKey 'pricefeed', keeper.NewKeeper, AppModuleBasic and AppModule with MidBlock (the oracle mid-block shape, modules/oracle/module.go:191-193), NewSubmissionAloneDecorator, NewSubmissionRateDecorator, SubmissionIsGasless, and precompiles/pricefeed NewPrecompile and GetVersioned (the shape of precompiles/xweb/setup.go:10-14)."

[req.5012]
title = "The sidecar reads the Chainflow feed per market"
ac_1 = "The Chainflow source sends GET /api/markets/ticker/{symbol} with header X-API-Key whose value comes from the environment variable named in the config or the file named by its _FILE variable; the existing SourceConfig has no header field (platform/hosted/feeder/src/lib.rs:83-97) and fetch_quote sends a bare GET (platform/hosted/feeder/src/lib.rs:603-624)."
ac_2 = "A 200 ticker whose symbol is PERP_<SYMBOL>_USDC yields index_price and mark_price parsed with parse_fixed(text, 18) (platform/hosted/feeder/src/lib.rs:196-225) and updated_at in Unix ms."
ac_3 = "A ticker whose symbol differs from the market's response symbol is refused with kind symbol, and a 200 body without index_price or mark_price is refused with kind no_price."
ac_4 = "Status 503 is refused with kind stale, 429 with kind rate_limited, and an updated_at older than max_quote_age_ms with kind stale."
ac_5 = "The candle timestamp of the price route is never used: the observation time is the ticker's updated_at."

[req.5013]
title = "The sidecar signs and submits one MsgSubmitPrices per block"
ac_1 = "cosmos_tx encodes MsgSubmitPrices, TxBody, AuthInfo with one SignerInfo (compressed secp256k1 key, sign mode direct, sequence) and an empty fee with the configured gas limit, and SignDoc {body, auth_info, chain_id, account_number}, byte-identical to the Go encoding."
ac_2 = "The signature is the 64-byte low-s r || s secp256k1 signature of sha256(SignDoc bytes) made with k256 at the pin of platform/hosted/internal/Cargo.toml:22."
ac_3 = "The Go module decodes the Rust-produced TxRaw with the application's tx decoder and verifies its signature with the auth signature verification, so both encoders agree."
ac_4 = "The sidecar reads account number and sequence with abci_query and broadcasts with broadcast_tx_sync, the consensus RPC routes of consensus/internal/rpc/core/routes.go:66 and consensus/internal/rpc/core/routes.go:70."
ac_5 = "A broadcast answered with account sequence mismatch (sdk/x/auth/ante/sigverify.go:273-274) re-reads the account and retries once; LXP_PRICEFEED_RATE_LIMITED waits for the next round; a transport failure retries with doubling backoff up to retry_max_attempts."
ac_6 = "At start the sidecar refuses to run unless 0x1020 getValidatorByFeedAccount(feedAccount) returns the configured validator, the role of check_sender (platform/hosted/feeder/src/lib.rs:783), and sets each market's next sequence to max(journal, getObservation sequence + 1) using the journal of platform/hosted/feeder/src/lib.rs:523-572."

[req.5014]
title = "The sidecar loop reports health and metrics and degrades per market"
ac_1 = "One round runs every cadence_ms (default 1000), the loop shape of platform/hosted/feeder/src/main.rs:56-72, fetches every market, and submits one transaction carrying every market that produced a ticker."
ac_2 = "When every market fails the round sends no transaction."
ac_3 = "GET /healthz answers 200 while the process runs and GET /readyz answers 200 only while a submission was accepted within three cadences, the rules of health_status and ready (platform/hosted/feeder/src/lib.rs:27-41, platform/hosted/feeder/src/lib.rs:629-633)."
ac_4 = "GET /metrics answers price_sidecar_rounds_total, price_sidecar_submissions_total{result}, price_sidecar_fetch_errors_total{market,kind}, price_sidecar_market_age_ms{market} and price_sidecar_last_accepted_height in the Prometheus text format."
ac_5 = "LXP_PRICEFEED_UNREGISTERED_FEEDER or LXP_PRICEFEED_NOT_VALIDATOR from a broadcast turns the sidecar not ready and it keeps polling."

[req.5015]
title = "The sidecar installs from tools/price-sidecar with names only"
ac_1 = "price-sidecar.service follows interop/deploy/x-websearch/x-websearch.service:1-51: dedicated User and Group, LoadCredential for feed.key and chainflow.key, Environment lines passing %d paths in PRICE_SIDECAR_FEED_KEY_FILE and PRICE_FEED_REST_API_KEY_FILE, Restart=on-failure, StateDirectory with mode 0700, UMask=0077 and the same sandbox directives."
ac_2 = "config.template.json carries every config field with empty values for the Chainflow feed base address, chain id, validator and feed account, and names only the environment variables PRICE_SIDECAR_CONFIG, PRICE_SIDECAR_FEED_KEY_FILE, PRICE_FEED_REST_API_KEY_FILE, PRICE_SIDECAR_STATE_DIR, PRICE_SIDECAR_HEALTH_ADDR, PRICE_SIDECAR_CONSENSUS_RPC_URL, PRICE_SIDECAR_EVM_RPC_URL."
ac_3 = "The config loader refuses every empty field of the template naming the field, the placeholder proof of interop/deploy/x-websearch/tests/packaging-check.sh:1-11."

[req.5016]
title = "The price path works end to end on an in-process multi-validator chain"
ac_1 = "On the real application built with SetupWithGenesisValSet (node/test_helpers.go:692) with four bonded validators, four registered feed keys and signed MsgSubmitPrices transactions through the real ante decorators, MidBlock writes aggregates and GetPrice returns Fresh true for every submitted market."
ac_2 = "With two of four validators submitting, no aggregate is written and the markets go not fresh after max_price_age_ms."
ac_3 = "getPrice(uint256) through the EVM keeper's precompile set at 0x1020 returns the same tuple as GetPrice at the same height."

[req.5017]
title = "The domain completes with its whole test set at one revision"
ac_1 = "The Go packages modules/pricefeed/... and precompiles/pricefeed/..., the crate layerx-oracle-feeder and the packaging check pass in one run of tools/price-sidecar/tests/domain-check.sh."
ac_2 = "modules/oracle is unchanged at the completion revision."
ac_3 = "The module exposes the symbols task 1.3.100 wires (types.ModuleName, types.StoreKey, keeper.NewKeeper, keeper.InitV6120, keeper.GetPrice, pricefeed.NewSubmissionAloneDecorator, pricefeed.NewSubmissionRateDecorator, pricefeed.SubmissionIsGasless, precompiles/pricefeed NewPrecompile and GetVersioned) with the signatures of the contract file."

[capability_group.5.1]
title = "Module state"
children = ["5.1.1", "5.1.2", "5.1.3", "5.1.4", "5.1.5", "5.1.6"]

[capability_group.5.2]
title = "Submission path"
children = ["5.2.1", "5.2.2", "5.2.3", "5.2.4"]

[capability_group.5.3]
title = "Aggregation and pricing"
children = ["5.3.1", "5.3.2", "5.3.3"]

[capability_group.5.4]
title = "Precompile 0x1020"
children = ["5.4.1", "5.4.2", "5.4.3", "5.4.4"]

[capability_group.5.5]
title = "Price sidecar"
children = ["5.5.1", "5.5.2", "5.5.3", "5.5.4"]

[capability_group.5.6]
title = "Integration and completion"
children = ["5.6.1", "5.6.2"]

[capability.5.1.1]
title = "Market table with the Chainflow symbol forms"
reqs = ["5001.1", "5001.2"]
touches = ["modules/pricefeed/types/market.go", "modules/pricefeed/types/market_test.go"]
tests = ["modules/pricefeed/types/market_test.go"]
verification_contract = "go test ./modules/pricefeed/types/ -run TestMarket"
do_1 = "Declare Market {ID uint64, Symbol, ChainflowSymbol, MinPrice sdk.Int, MaxPrice sdk.Int, Enabled bool} and the var Markets in modules/pricefeed/types/market.go with the eighteen ids and symbols of Hyperpax:src/core/perps/config.ts:168-185 in that order."
do_2 = "Add ResponseSymbol(m) returning PERP_<ChainflowSymbol>_USDC, the form normalizeFeedSymbol strips (Hyperpax:src/core/feeds.ts:5-7), and PathName(m) returning the lower-case symbol that candleFeedUrl builds (Hyperpax:src/core/feeds.ts:13)."
do_3 = "Set MinPrice 1 and MaxPrice 10^30 on every entry, the 18-decimal integer range of the contract; the feeder parses prices at 18 decimals with parse_fixed (platform/hosted/feeder/src/lib.rs:196-225)."
do_4 = "Write TestMarketTable comparing the symbol set with the eighteen FEED_SYMBOLS names (Hyperpax:src/core/feeds.ts:4) and pinning ids 0, 7, 12 and 17, and TestMarketChainflowForms pinning the three forms of markets 0 and 9."

[capability.5.1.2]
title = "Parameters, store keys and records"
reqs = ["5010.1", "5010.2", "5011.5"]
touches = ["modules/pricefeed/types/params.go", "modules/pricefeed/types/state.go", "modules/pricefeed/types/params_test.go"]
tests = ["modules/pricefeed/types/params_test.go"]
verification_contract = "go test ./modules/pricefeed/types/ -run TestParams"
do_1 = "Declare Params with Authority, Markets and the ten numeric fields of the contract parameter table, and DefaultParams(authority) seeding types.Markets, the shape of the xweb DefaultParams read by GetParams (modules/xweb/keeper/keeper.go:112-118)."
do_2 = "Add DefaultAuthority() returning the governance module account address as modules/xweb/types/genesis.go:21-23 does."
do_3 = "Write Params.Validate with every bound of the contract table, dense ids from 0, unique symbols and MinPrice < MaxPrice, returning ErrInvalidParams; SetParams calls it before storing, the order of modules/xweb/keeper/keeper.go:120-126."
do_4 = "Declare in modules/pricefeed/types/state.go the prefixes 0x01 to 0x06 and the key builders FeedKeyKey, FeedAccountKey, ObservationKey, AggregateKey and LastSubmitKey with big-endian ids, the u64 and join helpers of modules/xweb/types/keys.go:41-53."
do_5 = "Declare the records FeedKey, ObservationRecord, Aggregate {IndexPrice, MarkPrice, Basis, TimestampMs, Height, Sources} and GenesisState with DefaultGenesis in modules/pricefeed/types/state.go; the keeper stores them as JSON like modules/xweb/keeper/keeper.go:29-46."
do_6 = "Write TestParamsDefault, TestParamsValidate and TestParamsStoreKeys."

[capability.5.1.3]
title = "Registered errors and event names"
reqs = ["5009.4"]
touches = ["modules/pricefeed/types/errors.go", "modules/pricefeed/types/events.go", "modules/pricefeed/types/errors_test.go"]
tests = ["modules/pricefeed/types/errors_test.go"]
verification_contract = "go test ./modules/pricefeed/types/ -run TestLXPName"
do_1 = "Register the fifteen errors under codespace pricefeed with codes 2 to 16 in the order of the contract error table, the Register pattern of modules/xweb/types/errors.go:10-17."
do_2 = "Write LXPName(err) returning the LXP_PRICEFEED_ code of a registered error and false for another codespace, the mapping of modules/xweb/types/errors.go:36-48."
do_3 = "Declare in modules/pricefeed/types/events.go the event types pricefeed_observation, pricefeed_observation_refused, pricefeed_aggregate, pricefeed_aggregate_skipped, pricefeed_feed_key, pricefeed_feed_key_revoked, pricefeed_params, their attribute keys and the seven refusal reasons."
do_4 = "Write TestLXPName iterating the table and checking an error of the xweb codespace returns false."

[capability.5.1.4]
title = "Keeper and feed key registry"
reqs = ["5002.1", "5002.2", "5002.3", "5002.4", "5002.5", "5002.6", "5002.9"]
touches = ["modules/pricefeed/types/expected_keepers.go", "modules/pricefeed/keeper/keeper.go", "modules/pricefeed/testutil/store.go", "modules/pricefeed/keeper/registry.go", "modules/pricefeed/keeper/registry_test.go"]
tests = ["modules/pricefeed/keeper/registry_test.go"]
verification_contract = "go test ./modules/pricefeed/keeper/ -run TestRegistry"
do_1 = "Declare StakingKeeper {Validator, ValidatorsPowerStoreIterator, MaxValidators, GetLastTotalPower} with the method set of modules/oracle/types/expected_keeper.go:11-19 and sdk/x/staking/keeper/validator.go:253, AccountKeeper {HasAccount, NewAccountWithAddress, SetAccount} (sdk/x/auth/keeper/account.go:9, sdk/x/auth/keeper/account.go:29) and EVMKeeper {GetPaxAddressOrDefault, GetEVMAddress} (modules/evm/keeper/address.go:30, modules/evm/keeper/address.go:58)."
do_2 = "Write Keeper and NewKeeper(storeKey, stakingKeeper, accountKeeper, evmKeeper) with the JSON set and get helpers of modules/xweb/keeper/keeper.go:15-46."
do_3 = "Write RegisterFeedKey(ctx, operator, pubKey) that resolves the validator through Validator (sdk/x/staking/keeper/alias_functions.go:79), requires IsBonded as ValidateFeeder does (modules/oracle/keeper/keeper.go:396-398), decodes the compressed key, refuses a feed account mapped to another validator, deletes the previous reverse entry, writes both entries and creates the auth account when HasAccount is false."
do_4 = "Write RevokeFeedKey, GetFeedKey and GetValidatorByFeedAccount, and emit pricefeed_feed_key and pricefeed_feed_key_revoked on the context event manager."
do_5 = "Write modules/pricefeed/testutil/store.go with the overlay of modules/xweb/testutil/store.go:25-60 and NewKeeper on the test application keepers, the shape of modules/xweb/testutil/store.go:64-68."
do_6 = "Write TestRegistryCreatesFeedAccount and TestRegistryEvents on the test application from testutil/keeper/evm.go:22."

[capability.5.1.5]
title = "Activation and genesis"
reqs = ["5011.1", "5011.2", "5011.3", "5011.4"]
touches = ["modules/pricefeed/keeper/init_v6120.go", "modules/pricefeed/keeper/genesis.go", "modules/pricefeed/keeper/init_v6120_test.go"]
tests = ["modules/pricefeed/keeper/init_v6120_test.go"]
verification_contract = "go test ./modules/pricefeed/keeper/ -run TestInitV6120"
do_1 = "Write func InitV6120(ctx sdk.Context, k Keeper) error that stores DefaultParams(DefaultAuthority()) when ParamsKey is absent and returns nil otherwise, the idempotent upgrade step shape of runXWebUpgrade (node/upgrades.go:212)."
do_2 = "Write ExportGenesis and InitGenesis over params, feed keys, observations and aggregates, the JSON genesis path of modules/xweb/module.go:97-112, refusing a feed account under two validators with ErrInvalidGenesis."
do_3 = "Leave every aggregate absent at activation so GetPrice reads Fresh false until the bonded majority submits."
do_4 = "Write TestInitV6120Seeds, TestInitV6120KeepsParams, TestInitV6120StartsNotFresh and TestInitV6120GenesisRoundTrip."

[capability.5.1.6]
title = "Module wiring surface"
reqs = ["5011.6"]
touches = ["modules/pricefeed/module.go", "modules/pricefeed/abci.go", "modules/pricefeed/module_test.go"]
tests = ["modules/pricefeed/module_test.go"]
verification_contract = "go test ./modules/pricefeed/ -run TestAppModule"
do_1 = "Write AppModuleBasic and AppModule with Name, RegisterInterfaces, DefaultGenesis, ValidateGenesis, InitGenesis, ExportGenesis and ConsensusVersion 1, the layout of modules/xweb/module.go:32 and modules/xweb/module.go:123."
do_2 = "Register the Msg service in RegisterServices as modules/xweb/module.go:91-93 does."
do_3 = "Write MidBlock(ctx, height) calling MidBlocker in modules/pricefeed/abci.go, the shape of modules/oracle/module.go:191-193 that node/app.go:1157 schedules."
do_4 = "Write TestAppModule running MidBlock on the test application at height 10."

[capability.5.2.1]
title = "MsgSubmitPrices and MsgSetParams wire types"
reqs = ["5003.1", "5003.2", "5003.3"]
touches = ["api/pricefeed/tx.proto", "modules/pricefeed/types/tx.pb.go", "modules/pricefeed/types/tx_test.go", "modules/pricefeed/types/msgs.go", "modules/pricefeed/types/codec.go", "modules/pricefeed/types/msgs_test.go"]
tests = ["modules/pricefeed/types/tx_test.go", "modules/pricefeed/types/msgs_test.go"]
verification_contract = "go test ./modules/pricefeed/types/ -run 'TestTxWireRoundTrip|TestValidateBasic'"
do_1 = "Declare api/pricefeed/tx.proto in package paxprotocol.paxchain.pricefeed with the go_package layout of api/xweb/tx.proto:6, service Msg {SubmitPrices, SetParams} as at api/xweb/tx.proto:13-18, Observation, MsgSubmitPrices, MsgSubmitPricesResponse {accepted, refused} and MsgSetParams with the params message shape of api/xweb/tx.proto:76-89."
do_2 = "Generate modules/pricefeed/types/tx.pb.go with the buf generate step of scripts/protoc.sh:26."
do_3 = "Write ValidateBasic and GetSigners in modules/pricefeed/types/msgs.go: bech32 feeder with the pax prefix (node/const.go:5), one to 64 observations, unique market ids, non-zero sequence and timestamp, canonical decimal prices of 1 to 39 digits."
do_4 = "Register both messages in modules/pricefeed/types/codec.go with the interface registration of modules/xweb/types/codec.go:17-37."
do_5 = "Write TestTxWireRoundTrip, TestValidateBasicRefusesInvalid and TestValidateBasicBounds."

[capability.5.2.2]
title = "Per-observation checks in the message server"
reqs = ["5003.4", "5003.5", "5003.6", "5003.7", "5003.8", "5003.9", "5003.10", "5003.11", "5004.6"]
touches = ["modules/pricefeed/keeper/observation.go", "modules/pricefeed/keeper/msg_server.go", "modules/pricefeed/keeper/observation_test.go"]
tests = ["modules/pricefeed/keeper/observation_test.go"]
verification_contract = "go test ./modules/pricefeed/keeper/ -run TestSubmitPrices"
do_1 = "Write NewMsgServerImpl and SubmitPrices in modules/pricefeed/keeper/msg_server.go, the server shape of modules/xweb/keeper/msg_server.go:22, refusing the whole message for an unregistered feeder, a validator not bonded, more than max_observations_per_submission observations and a repeated height, the order of CheckOracleSpamming (modules/oracle/ante.go:43-72)."
