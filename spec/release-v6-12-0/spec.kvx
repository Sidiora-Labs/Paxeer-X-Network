qualification = "UNRUN"

[acceptance.4.1]
feature = "5"
req = "4.1"
scenario = "Given the rehearsal validators with the price sidecar installed and each feed key registered with registerFeedKey at 0x1020, when ten blocks pass, then each block carries one MsgSubmitPrices per validator for every listed symbol."
contract = "contracts/pricefeed.md"
test = "tools/release/rehearse-v6120.sh::check_sidecar_submissions (planned)"
