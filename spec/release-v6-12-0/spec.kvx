[req.2013]
title = "Access-control and upgrade functions answer from the migrated role table and refuse administration"
ac_1 = "`DEFAULT_ADMIN_ROLE()` (selector 0xa217fddf) of SidioraFactory, Router, Quoter, FeesRouter, FeeAccumulator, PoolRegistry, ProtocolConfig, SidioraNFT at every surface address of those roles and at 0x1017 returns the migrated role table answer (Launch-x:contracts/contracts/base/AccessControl.sol:48); hasRole(0x00, any) is false after the upgrade."
ac_2 = "`getRoleAdmin(bytes32)` (selector 0x248a9ca3) of SidioraFactory, Router, Quoter, FeesRouter, FeeAccumulator, PoolRegistry, ProtocolConfig, SidioraNFT at every surface address of those roles and at 0x1017 returns the migrated role table answer (Launch-x:contracts/contracts/base/AccessControl.sol:48); hasRole(0x00, any) is false after the upgrade."
ac_3 = "`grantRole(bytes32,address)` (selector 0x2f2ff15d) of SidioraFactory, Router, Quoter, FeesRouter, FeeAccumulator, PoolRegistry, ProtocolConfig, SidioraNFT at every surface address of those roles and at 0x1017 reverts with MissingRole(address,bytes32) (0x0161a64a) for every caller, because role administration moves to governance (Launch-x:contracts/contracts/base/AccessControl.sol:58)."
ac_4 = "`hasRole(bytes32,address)` (selector 0x91d14854) of SidioraFactory, Router, Quoter, FeesRouter, FeeAccumulator, PoolRegistry, ProtocolConfig, SidioraNFT at every surface address of those roles and at 0x1017 returns the migrated role table answer (Launch-x:contracts/contracts/base/AccessControl.sol:48); hasRole(0x00, any) is false after the upgrade."
ac_5 = "`proxiableUUID()` (selector 0x52d1902d) of SidioraFactory, Router, Quoter, FeesRouter, FeeAccumulator, PoolRegistry, ProtocolConfig, SidioraNFT at every surface address of those roles and at 0x1017 returns the revert data the proxy address returned at the halt height (Launch-x:contracts/contracts/base/UUPSUpgradeable.sol:41), since notDelegated refuses a call through the proxy."
ac_6 = "`registeredDefaultAdminCount()` (selector 0xc0cb71b6) of SidioraFactory, Router, Quoter, FeesRouter, FeeAccumulator, PoolRegistry, ProtocolConfig, SidioraNFT at every surface address of those roles and at 0x1017 returns 0 after the upgrade, since DEFAULT_ADMIN_ROLE is not migrated (Launch-x:contracts/contracts/base/AccessControl.sol:32)."
ac_7 = "`renounceRole(bytes32,address)` (selector 0x36568abe) of SidioraFactory, Router, Quoter, FeesRouter, FeeAccumulator, PoolRegistry, ProtocolConfig, SidioraNFT at every surface address of those roles and at 0x1017 reverts with MissingRole(address,bytes32) (0x0161a64a) for every caller, because role administration moves to governance (Launch-x:contracts/contracts/base/AccessControl.sol:68)."
ac_8 = "`revokeRole(bytes32,address)` (selector 0xd547741f) of SidioraFactory, Router, Quoter, FeesRouter, FeeAccumulator, PoolRegistry, ProtocolConfig, SidioraNFT at every surface address of those roles and at 0x1017 reverts with MissingRole(address,bytes32) (0x0161a64a) for every caller, because role administration moves to governance (Launch-x:contracts/contracts/base/AccessControl.sol:63)."
ac_9 = "`upgradeToAndCall(address,bytes)` (selector 0x4f1ef286) of SidioraFactory, Router, Quoter, FeesRouter, FeeAccumulator, PoolRegistry, ProtocolConfig, SidioraNFT at every surface address of those roles and at 0x1017 reverts with MissingRole(address,bytes32) (0x0161a64a) carrying the caller and 0x00, and a value-carrying call reverts first as non-payable (Launch-x:contracts/contracts/base/UUPSUpgradeable.sol:48)."

