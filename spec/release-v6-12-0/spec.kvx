[feature.3]
name = "perps"
scope = "The perpetuals venue of Paxeer X Network as a clean Go rewrite: the new modules/perps module with cross-margin USDL accounts, a price-time priority book per market, tiered fees, the pricefeed-based mark price, hourly funding, a borrowing fee on open interest, account-level liquidation, insurance backstop and auto-deleveraging; the precompile precompiles/perps at 0x0000000000000000000000000000000000001015 that keeps the Hyperpax application's calls; the eighteen markets seeded by SeedV6120; and the v6.9 exchange implementation kept under precompiles/layerxexchange/legacy/v69. The node wiring is the baseline wiring task 1.3.100."
requirements = ["3001", "3002", "3003", "3004", "3005", "3006", "3007", "3008", "3009", "3010", "3011", "3012", "3013", "3014", "3015", "3016", "3017", "3018", "3019", "3020", "3021", "3022", "3023"]
completion_task = "3.3.99"

[req.3001]
title = "The perpetuals interface at 0x1015 is frozen as Perps.sol and abi.json under a golden test"
ac_1 = "precompiles/perps/Perps.sol declares every function, event and structure of contracts/perps.md sections 2 to 18 and precompiles/perps/abi.json is its compiled ABI, loaded with MustGetABI (precompiles/common/precompiles.go:449) as the launchpad precompile loads its ABI (precompiles/launchpad/launchpad.go:180)."
ac_2 = "Every method the Hyperpax application calls keeps the selector the application encodes: the methods cited at Hyperpax:src/hooks/perps/usePosition.ts:29-121, Hyperpax:src/hooks/perps/usePerpsOrders.ts:10-91, Hyperpax:src/hooks/perps/useVault.ts:12-58, Hyperpax:src/hooks/perps/useMarginMode.ts:41-283 and Hyperpax:src/hooks/perps/useQuoter.ts:119-146."
ac_3 = "The quote tuples keep the field order and types of Hyperpax:src/hooks/perps/useQuoter.ts:7-42 (OpenPositionQuote 10 fields, ClosePositionQuote 7 fields, MarketQuote 11 fields), and AccountSummary and PositionMargin keep the order of Hyperpax:src/hooks/perps/useMarginMode.ts:121 and Hyperpax:src/hooks/perps/useMarginMode.ts:241."
ac_4 = "A golden file precompiles/perps/testdata/abi_golden.txt lists each method signature with its selector and each event signature with its topic0; any change to abi.json that alters a line fails the test, so the interface changes only together with contracts/perps.md."

[req.3002]
title = "Eighteen markets are seeded at activation with the Hyperpax ids and governed only by upgrade handlers"
ac_1 = "SeedV6120(ctx sdk.Context, k Keeper) error writes the 18 markets of contracts/perps-markets.md with ids, symbols and max leverage of Hyperpax:src/core/perps/config.ts:168-185, tier class, tick, lot, impact notional and OI cap, after DefaultParams."
ac_2 = "SeedV6120 is idempotent: a second run leaves the store byte-identical and returns nil."
ac_3 = "Market.Validate in modules/perps/types/market.go refuses pxDecimals + szDecimals above 6, a zero OI cap, a max leverage above 1000 or a tier table whose deductions do not follow the recurrence of contracts/perps-markets.md section 1, with LXP_PERPS_INVALID_PARAMS."
ac_4 = "The tier tables follow the deduction recurrence: deduction(n) = deduction(n-1) + lowerBound(n) x (MMR(n) - MMR(n-1)), giving BTC deductions 500, 8,000, 58,000, 433,000 and 2,308,000 USD, PAX 45, 1,045, 7,295 and 57,295 USD and LINK 1,875, 16,875 and 141,875 USD."
ac_5 = "Keeper.SetMarket(ctx, authority, market) changes a market only for the governance authority, the pattern of UpdateParams (modules/launchpad/keeper/keeper.go:76-85); any other authority returns LXP_PERPS_UNAUTHORIZED."
ac_6 = "`function getMarket(uint256 marketId) external view returns (string memory name, string memory symbol, uint256 maxLeverage, uint256 maintenanceMarginBps, uint256 maxOpenInterest, bool enabled)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_7 = "`function getMarketConfig(uint256 marketId) external view returns (MarketConfig memory config)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_8 = "`function getActiveMarketIds() external view returns (uint256[] memory marketIds)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_9 = "`function totalMarkets() external view returns (uint256 count)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_10 = "`function isMarketActive(uint256 marketId) external view returns (bool active)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_11 = "LXP_PERPS_UNKNOWN_MARKET is registered with code 3 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when a market id is not stored."
ac_12 = "LXP_PERPS_MARKET_DISABLED is registered with code 4 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when the market is stored with enabled false."

[req.3003]
title = "Each address holds one USDL collateral account inside the perps module"
ac_1 = "Collateral moves only with BankKeeper.SendCoins (modules/launchpad/types/expected_keepers.go:15-16) of uusdl (modules/launchpad/types/params.go:31) between the caller's Paxeer address (precompiles/utils/expected_keepers.go:117) and the perps module account."
ac_2 = "Token arguments are checked against GetERC20NativePointer(ctx, uusdl) (precompiles/utils/expected_keepers.go:127); a different token returns LXP_PERPS_UNSUPPORTED_COLLATERAL before any transfer."
ac_3 = "Withdrawable = equity - max(initial margin of positions and orders, 10 percent of position notional at mark), floored at 0; withdraw, removeCollateral and transferCollateral are bounded by it."
ac_4 = "An account is created by createVault, deposit or the first order method; other writes of an address without an account return LXP_PERPS_NO_ACCOUNT."
ac_5 = "`function createVault() external returns (address vault)` is declared in precompiles/perps/abi.json and served by precompiles/perps/account.go as a state-changing method, charged DefaultGasCost(input, true) plus 20,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useVault.ts:21."
ac_6 = "`function getVault(address user) external view returns (address vault)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useVault.ts:12."
ac_7 = "`function deposit(address token, uint256 amount) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/account.go as a state-changing method, charged DefaultGasCost(input, true) plus 30,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useVault.ts:48."
ac_8 = "`function withdraw(address token, uint256 amount) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/account.go as a state-changing method, charged DefaultGasCost(input, true) plus 30,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useVault.ts:58."
ac_9 = "`function emergencyWithdraw(address token) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/account.go as a state-changing method, charged DefaultGasCost(input, true) plus 30,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useMarginMode.ts:283."
ac_10 = "`function transferCollateral(address to, uint256 amount) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/account.go as a state-changing method, charged DefaultGasCost(input, true) plus 30,000 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_11 = "`function getBalance(address token) external view returns (uint256 balance)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useVault.ts:30."
ac_12 = "`function getLockedBalance(address token) external view returns (uint256 locked)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useVault.ts:39."
ac_13 = "`function getAccountSummary(address token) external view returns (AccountSummary memory summary)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useMarginMode.ts:239."
ac_14 = "`function getAccount(address account) external view returns (AccountState memory state)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_15 = "`event VaultCreated(address indexed user, address indexed vault)` is logged from 0x0000000000000000000000000000000000001015 on createVault on the first call of an account; vault is always 0x0000000000000000000000000000000000001015, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_16 = "`event CollateralDeposited(address indexed account, uint256 amount, uint256 newBalance)` is logged from 0x0000000000000000000000000000000000001015 on deposit, topUpPosition, addCollateral and the deposit leg of the compatibility order methods, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_17 = "`event CollateralWithdrawn(address indexed account, uint256 amount, uint256 newBalance)` is logged from 0x0000000000000000000000000000000000001015 on withdraw, emergencyWithdraw and removeCollateral, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_18 = "`event CollateralTransferred(address indexed from, address indexed to, uint256 amount)` is logged from 0x0000000000000000000000000000000000001015 on transferCollateral, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_19 = "LXP_PERPS_ZERO_AMOUNT is registered with code 6 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when an amount or size argument is zero."
ac_20 = "LXP_PERPS_UNSUPPORTED_COLLATERAL is registered with code 7 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when a token argument is not the USDL ERC20 pointer."
ac_21 = "LXP_PERPS_INSUFFICIENT_COLLATERAL is registered with code 8 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when the bank balance of the caller is below a deposit."
ac_22 = "LXP_PERPS_SELF_TRANSFER is registered with code 41 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when transferCollateral names the caller."
ac_23 = "LXP_PERPS_ZERO_ADDRESS is registered with code 42 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when an address argument is zero."
ac_24 = "LXP_PERPS_NO_ACCOUNT is registered with code 43 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when a write other than createVault, deposit or a compatibility order names a caller without an account."

[req.3004]
title = "Margin is cross only with tiered maintenance margin"
ac_1 = "Initial margin of a position is notional / leverage and of a resting order its notional at limit price / leverage; maintenance margin is notional at mark x MMR(tier) - deduction(tier) (contracts/perps-parameters.md section 2), replacing the single-rate check of lx_perps_maintenance_check (src/modules/perps/lx_perps_liquidate.c:23)."
ac_2 = "Leverage above the cap of the tier that contains the resulting notional returns LXP_PERPS_LEVERAGE_TOO_HIGH."
ac_3 = "An opening order is accepted only if equity after the opening fee covers the initial margin of all positions and orders after the change; otherwise LXP_PERPS_INSUFFICIENT_MARGIN."
ac_4 = "The 1000x consequences of contracts/perps-parameters.md section 9 hold: 5 bps buffer, 14.5 bps minimum collateral, 9 bps round trip, liquidation at a 5 bps adverse move."
ac_5 = "Cross mode is the only mode: MarginMode Cross is 0 (Hyperpax:src/types/perps.ts:319-322) and every isolated-margin request returns LXP_PERPS_CROSS_MARGIN_ONLY."
ac_6 = "`function setMarginMode(uint8 mode) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/account.go as a state-changing method, charged DefaultGasCost(input, true) plus 5,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useMarginMode.ts:80."
ac_7 = "`function getMarginMode() external view returns (uint8 mode)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useMarginMode.ts:41."
ac_8 = "`function topUpPosition(uint256 positionId, uint256 amount) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/account.go as a state-changing method, charged DefaultGasCost(input, true) plus 30,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useMarginMode.ts:164."
ac_9 = "`function transferMargin(uint256 fromPositionId, uint256 toPositionId, uint256 amount) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/account.go as a state-changing method, charged DefaultGasCost(input, true) plus 5,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useMarginMode.ts:197."
ac_10 = "`function getPositionMargin(uint256 positionId) external view returns (PositionMargin memory margin)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/useMarginMode.ts:119."
ac_11 = "`function getMarginTiers(uint256 marketId) external view returns (MarginTier[] memory tiers)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_12 = "`function checkLiquidatable(uint256 positionId) external view returns (bool liquidatable, uint256 marginBps)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_13 = "LXP_PERPS_INSUFFICIENT_MARGIN is registered with code 9 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when an order, withdrawal or transfer would leave equity below the initial margin or the transfer requirement."
ac_14 = "LXP_PERPS_LEVERAGE_TOO_HIGH is registered with code 10 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when requested leverage exceeds the tier maximum for the resulting notional."
ac_15 = "LXP_PERPS_CROSS_MARGIN_ONLY is registered with code 32 in modules/perps/types/errors.go as modules/launchpad/types/errors.go:7-9 registers its errors, and is the first text of the revert reason (precompiles/common/precompiles.go:134-143) when setMarginMode names isolated or transferMargin is called."

[req.3005]
title = "Orders are validated against tick, lot, value, leverage, reduce-only and cloid rules"
ac_1 = "Order validation runs in the order of contracts/perps.md section 5 and reproduces the checks of order_validate (src/modules/perps/lx_perps_book.c:183) including the time-in-force bound at src/modules/perps/lx_perps_book.c:199."
ac_2 = "A limit price that is not a multiple of the tick returns LXP_PERPS_TICK_SIZE, and a size that rounds to zero lots returns LXP_PERPS_LOT_SIZE."
ac_3 = "Order value is bounded: below 10 USD returns LXP_PERPS_MIN_ORDER_VALUE; above the market-order maximum for the market's leverage band, or 10 times it for limit orders, returns LXP_PERPS_MAX_ORDER_VALUE."
ac_4 = "A cloid is unique per account and market among open orders: a second open order with the same cloid returns LXP_PERPS_DUPLICATE_CLOID; the cloid index frees on cancel, fill and expiry."
ac_5 = "An account holds at most 1,000 open orders; the next placement returns LXP_PERPS_TOO_MANY_OPEN_ORDERS."
ac_6 = "A resting order with a deadline below block time is expired in EndBlock and frees its margin; a placement with a deadline already below block time returns LXP_PERPS_DEADLINE_EXPIRED."
ac_7 = "`function placeOrder(OrderParams calldata p) external returns (uint256 orderId)` is declared in precompiles/perps/abi.json and served by precompiles/perps/orders.go as a state-changing method, charged DefaultGasCost(input, true) plus 250,000 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_8 = "`function placeLimitOrder(uint256 marketId, bool isLong, uint256 triggerPrice, uint256 sizeUsd, uint256 leverage, address collateralToken, uint256 collateralAmount) external returns (uint256 orderId)` is declared in precompiles/perps/abi.json and served by precompiles/perps/orders.go as a state-changing method, charged DefaultGasCost(input, true) plus 250,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePerpsOrders.ts:36."
ac_9 = "`function placeStopLimitOrder(uint256 marketId, bool isLong, uint256 triggerPrice, uint256 limitPrice, uint256 sizeUsd, uint256 leverage, address collateralToken, uint256 collateralAmount) external returns (uint256 orderId)` is declared in precompiles/perps/abi.json and served by precompiles/perps/orders.go as a state-changing method, charged DefaultGasCost(input, true) plus 250,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePerpsOrders.ts:58."
ac_10 = "`function cancelOrder(uint256 orderId) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/orders.go as a state-changing method, charged DefaultGasCost(input, true) plus 20,000 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePerpsOrders.ts:71."
ac_11 = "`function cancelByCloid(uint256 marketId, bytes16 cloid) external` is declared in precompiles/perps/abi.json and served by precompiles/perps/orders.go as a state-changing method, charged DefaultGasCost(input, true) plus 20,000 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_12 = "`function getOrder(uint256 orderId) external view returns (address user, uint256 marketId, bool isLong, uint8 orderType, uint256 triggerPrice, uint256 limitPrice, uint256 sizeUsd, uint256 leverage, address collateralToken, uint256 collateralAmount, bool active)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePerpsOrders.ts:10."
ac_13 = "`function getOrderDetails(uint256 orderId) external view returns (OrderDetails memory details)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118)."
ac_14 = "`function getUserOrderIds(address user) external view returns (uint256[] memory orderIds)` is declared in precompiles/perps/abi.json and served by precompiles/perps/views.go as a view, charged DefaultGasCost(input, false) plus 0 through WithGasTable (precompiles/common/precompiles.go:115-118); it keeps the application call at Hyperpax:src/hooks/perps/usePerpsOrders.ts:19."
ac_15 = "`event OrderPlaced(uint256 indexed orderId, address indexed user, uint256 indexed marketId, uint8 orderType, bool isLong, uint256 triggerPrice, uint256 sizeUsd)` is logged from 0x0000000000000000000000000000000000001015 on every order placement, including the implicit market order of openPosition, addSize, closePosition and partialClose, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_16 = "`event OrderOptions(uint256 indexed orderId, uint8 timeInForce, bool reduceOnly, uint256 limitPrice, uint256 acceptablePrice, uint64 deadline, bytes16 cloid)` is logged from 0x0000000000000000000000000000000000001015 on directly after OrderPlaced for every order, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_17 = "`event OrderCancelled(uint256 indexed orderId, address indexed user)` is logged from 0x0000000000000000000000000000000000001015 on cancelOrder, cancelByCloid, emergencyWithdraw, self-trade prevention, IOC and FOK remainders, reduce-only shrink and liquidation order sweeps, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
ac_18 = "`event OrderExpired(uint256 indexed orderId, address indexed user, uint256 indexed marketId)` is logged from 0x0000000000000000000000000000000000001015 on EndBlock when a resting order passes its deadline, through EmitEVMLog (precompiles/common/evm_events.go:16) inside a transaction or in the EndBlock synthetic receipt written with SetTransientReceipt (modules/evm/keeper/receipt.go:28-36)."
