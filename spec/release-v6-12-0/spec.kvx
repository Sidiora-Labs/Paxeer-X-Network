verification_contract = "go test -count=1 ./platform/perps-data/internal/store/ -run 'TestProjections'"
do_1 = "Add store.Project(ctx, tx, rows) called inside WriteBlock, the project callback of Launch-x:core/indexer/internal/store/canonical.go:66, folding the events contracts/perps.md section 18 lists: PositionOpened inserts positions_current with status open, PositionModified and PositionEntryPriceChanged update size, collateral and entry price, PositionTpSlSet sets take_profit_price and stop_loss_price, PositionFundingApplied updates collateral, ADLExecuted reduces size, PositionClosed with isFullClose true sets status closed and Liquidation sets status liquidated (contracts/data-services.md section 2)."
do_2 = "orders follows the lifecycle of contracts/data-services.md section 2: OrderPlaced inserts status active with remaining_size_usd = size_usd, OrderOptions fills limit_price, acceptable_price, time_in_force, reduce_only, deadline and cloid, each Fill naming the order as maker or taker subtracts its size_usd, OrderTriggered sets triggered, and the order closes filled at remaining 0, cancelled on OrderCancelled and expired on OrderExpired; spot_orders follows the spot order events keyed (kind, order_id) through open, activated, executed, cancelled and expired; the status strings active and filled are the ones the application filters on (Hyperpax:src/hooks/perps/useSubgraph.ts:110, Hyperpax:src/hooks/perps/useSubgraph.ts:195)."
do_3 = "account_margin takes balance from the new_balance of the latest CollateralDeposited or CollateralWithdrawn plus or minus every later CollateralTransferred, locked as the sum of collateral_amount of the open positions and margin_mode 0; user_stats counts win_count and loss_count from PositionClosed realized_pnl and sets total_pnl = realized_pnl - fees_usd + funding_usd; user_pnl_daily folds TradeSettled with volume and trades; market_stats_rolling folds each Fill once per match, TradeSettled being folded only into the account projections; all with the arithmetic of internal/bigint (contracts/data-services.md section 2)."
do_4 = "keeper_cycles gets one row per perps_endblock receipt counting its MarkPriceUpdated, OrderExecuted and Liquidation logs; spot_token_seen records every token of a spot swap, order or registry row; the Snapshotter writes market_snapshots for every market and one protocol_snapshots row (tvl_usd from usdl_transfers) at each UTC hour boundary crossed by a block time; no oi_snapshots table exists (contracts/data-services.md section 2)."
do_5 = "Add TestProjections with subtests position_lifecycle, order_lifecycle, margin_fold, stats_rolling, hourly_snapshots, keeper_cycles, account_ledger_view, user_stats_win_loss and spot_orders_lifecycle against PERPS_DATA_TEST_DATABASE_URL (contracts/data-services.md section 2)."

[capability.7.2.6]
