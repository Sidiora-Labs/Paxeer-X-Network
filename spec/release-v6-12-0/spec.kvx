scenario = "Given the rehearsal chain at H1+1, when the market table of 0x1015 is read, then the eighteen markets of contracts/perps-markets.md exist with their parameters, and an order on a market whose getPrice(m).fresh is false reverts."
contract = "contracts/perps-markets.md"
