tests = ["modules/pricefeed/types/market_test.go"]
verification_contract = "go test ./modules/pricefeed/types/ -run 'TestMarket'"
do_1 = "Declare Market {ID uint64, Symbol, ChainflowSymbol, MinPrice sdk.Int, MaxPrice sdk.Int, Enabled bool} and the var Markets in modules/pricefeed/types/market.go with the eighteen ids and symbols of Hyperpax:src/core/perps/config.ts:168-185 in that order."
do_2 = "Add ResponseSymbol(m) returning PERP_<ChainflowSymbol>_USDC, the form normalizeFeedSymbol strips (Hyperpax:src/core/feeds.ts:5-7), and PathName(m) returning the lower-case symbol that candleFeedUrl builds (Hyperpax:src/core/feeds.ts:13)."
do_3 = "Set MinPrice 1 and MaxPrice 10^30 on every entry, the 18-decimal integer range of the contract; the feeder parses prices at 18 decimals with parse_fixed (platform/hosted/feeder/src/lib.rs:196-225)."
do_4 = "Write TestMarketTable comparing the symbol set with the eighteen FEED_SYMBOLS names (Hyperpax:src/core/feeds.ts:4) and pinning ids 0, 7, 12 and 17, and TestMarketChainflowForms pinning the three forms of markets 0 and 9."

