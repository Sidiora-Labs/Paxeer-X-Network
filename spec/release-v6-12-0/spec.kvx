[contract_context.7.module]
home = "Every package lives under platform/perps-data of the root module go.mod:1; binaries under platform/perps-data/cmd (contracts/data-services.md:5)."
reuse = "Delivery, health and metrics packages are copied from the launchpad backend with their origin named, for example the relay of Launch-x:shared/delivery/natsdriver/driver.go:27 (Launch-x:shared/delivery/natsdriver/driver.go:27)."

[contract_context.7.schema]
tables = "One schema perps with fact, chain, projection, account and delivery tables (contracts/data-services.md:26); amounts are numeric(78,0) raw integers."
migrations = "Embedded migrations 0001 to 0004 are applied in lexical order by store.Migrate and refuse start on a changed hash (contracts/data-services.md:26)."

[contract_context.7.stream]
subjects = "One JetStream stream per chain with subjects perps.<chain>.<family>.<event> (contracts/data-services.md:386)."
sequence = "The stream sequence orders every message; consumers resume from their stored sequence and a rewind is published as its own message (contracts/data-services.md:412)."

[contract_context.7.events]
source = "Decoders are generated from the ABI exported by the perpetuals, spot and oracle precompiles of the same commit, and every row of the Events headings of contracts/perps.md and contracts/spot.md decodes by the family rule (contracts/data-services.md:429)."

[contract_context.7.gateway]
routes = "REST, the data socket, the spot user socket on /v1/ws, sign-in and account routes under /v2, and GraphQL on /graphql with the alias /api/subgraph (contracts/data-services.md:897, contracts/data-services.md:909, contracts/data-services.md:937)."
application_base = "The spot client writes its paths beginning with /v1/users (Hyperpax:src/core/spot/api.ts:283), so its base is the bare gateway origin (contracts/data-services.md:909)."
graphql_ws = "graphql-transport-ws is answered on /graphql-ws and on /graphql, the wsUrl of the PerfDB client (Hyperpax:src/core/perfdb/client.ts:120)."

[contract_context.7.operations]
deploy = "One Dockerfile builds every binary and one Railway project holds the services, Postgres and a three-node NATS cluster, with variables named only (contracts/data-services.md:846, contracts/data-services.md:850)."

[task.7.0.1]
title = "Add the JetStream client to the root module and copy the NATS driver"
status = "pending"
mode = "BUILD"
wave = 0
requires = []
reqs = ["7001.1", "7007.9"]
capabilities = ["7.1.1"]
do_1 = "Add github.com/nats-io/nats.go v1.47.0 (the version of Launch-x:shared/go.mod:123) and github.com/nats-io/nats-server/v2 for the in-process test broker to the require block that already holds go-ethereum, gorilla/websocket, lib/pq and client_golang (go.mod:27, go.mod:44, go.mod:55, go.mod:69); the module path stays go.mod:1 so platform/perps-data imports the precompile ABIs of the same commit."
do_2 = "Copy Publisher and NewPublisher (Launch-x:shared/delivery/natsdriver/driver.go:22, Launch-x:shared/delivery/natsdriver/driver.go:27) into internal/delivery/natsdriver/driver.go, origin Launch-x shared/delivery/natsdriver, keeping the subject pattern Launch-x:shared/delivery/natsdriver/driver.go:17 and the 5 second publish timeout Launch-x:shared/delivery/natsdriver/driver.go:20."
do_3 = "Keep Publish (Launch-x:shared/delivery/natsdriver/driver.go:38) publishing with WithMsgID and WithExpectStream (Launch-x:shared/delivery/natsdriver/driver.go:45) and refusing an acknowledgement with a foreign stream or a zero sequence (Launch-x:shared/delivery/natsdriver/driver.go:52)."
do_4 = "Copy ConsumerConfig, NewConsumer, Fetch, Run and BrokerPosition (Launch-x:shared/delivery/natsdriver/driver.go:58, Launch-x:shared/delivery/natsdriver/driver.go:93, Launch-x:shared/delivery/natsdriver/driver.go:151, Launch-x:shared/delivery/natsdriver/driver.go:209, Launch-x:shared/delivery/natsdriver/driver.go:238); the import of the Launch-x delivery package is rewritten to platform/perps-data/internal/delivery."
do_5 = "Required change against the copy: the replace of go-ethereum by pax-geth (go.mod:280) stays the only go-ethereum source, so the driver and the decoders use one ethtypes.Log type."
do_6 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
