[task.7.1.1]
title = "Head follower with parent-hash continuity and rewind"
status = "pending"
mode = "BUILD"
wave = 1
requires = ["7.0.5", "7.0.7"]
reqs = ["7003.1", "7003.2", "7003.3", "7003.4", "7003.5", "7003.6"]
capabilities = ["7.2.1"]
do_1 = "Copy EVMOptions, EVMSource, NewEVM, Head, FetchLogs, toLog, getBlock, callWithFallback, rankedIndices, markSuccess, markFailure, runHealthCheck and parseHexUint64 (Launch-x:core/indexer/internal/source/evm.go:21, Launch-x:core/indexer/internal/source/evm.go:53, Launch-x:core/indexer/internal/source/evm.go:76, Launch-x:core/indexer/internal/source/evm.go:182, Launch-x:core/indexer/internal/source/evm.go:204, Launch-x:core/indexer/internal/source/evm.go:346, Launch-x:core/indexer/internal/source/evm.go:376, Launch-x:core/indexer/internal/source/evm.go:410, Launch-x:core/indexer/internal/source/evm.go:499, Launch-x:core/indexer/internal/source/evm.go:528, Launch-x:core/indexer/internal/source/evm.go:541, Launch-x:core/indexer/internal/source/evm.go:552, Launch-x:core/indexer/internal/source/evm.go:633) into internal/source/rpc.go as RPC, origin Launch-x core/indexer/internal/source."
do_2 = "RPC.Logs filters on the venue addresses 0x1015, 0x1020, 0x1021 to 0x1025 and every share pointer address that spot_tokens holds from ShareTokenCreated (re-read before each block range) in one eth_getLogs per block range, the FetchOptions and FetchResult shapes of Launch-x:core/indexer/internal/source/source.go:30 and Launch-x:core/indexer/internal/source/source.go:43; block, transaction and log indexes are filled by the node because the precompile adds only address, topics and data (precompiles/common/evm_events.go:32-38)."
do_3 = "Follower.Step polls the head every 100 ms with 10 ms jitter, the cadence of Launch-x:core/indexer/internal/source/committed.go:830, and for each next height fetches the block and its logs; it checks the parent hash against the stored perps.blocks row of height n-1 as Launch-x:core/indexer/internal/source/committed.go:1037 does."
do_4 = "On a parent-hash mismatch or a stored hash that differs at the same height (the conflict of Launch-x:core/indexer/internal/source/committed.go:648), Follower.rewind walks back to the highest height whose stored hash equals the node hash, deletes every fact and projection row at a higher height and moves the cursor, all in one transaction, and enqueues one perps.<chain>.chain.rewind message carrying the fork height."
do_5 = "Projections are rebuilt for the affected accounts and markets from the remaining facts in the same transaction, so a read after the rewind never mixes rows of two branches."
do_6 = "Add TestFollower with subtests follows_head, detects_parent_mismatch, rewinds_to_fork, publishes_rewind and rpc_fallback against the node named by PERPS_DATA_TEST_RPC (a node started with make run-local-node, chain.mk:278) and the Postgres of PERPS_DATA_TEST_DATABASE_URL; the mismatch case writes a perps.blocks row with a different hash at a real height and asserts the rewind."
