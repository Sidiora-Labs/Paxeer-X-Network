[finding.5.0.4]
revision = "b1eec354b"
command = "go test -count=1 ./modules/xweb/keeper/ ./modules/xweb/types/ -run 'TestRegisterAttestor|TestRemoveAttestor|TestAttestorSetMajorityRule'"
exit_code = 1
log_path = "logs/5.0.4-verify-1.log"
observed_and_assumption = "19 of 20 cases pass; the genesis case expects the exact ErrInvalidAttestors refusal for 17 members but modules/xweb/types/genesis.go (outside touches) wraps it as ErrInvalidGenesis; taken as a planning gap, the assertion stays intact and the branch is held unlanded until the genesis file is owned by a task."

[finding.5.0.8]
revision = "9fb40b2b8"
command = "cargo test --locked --manifest-path interop/Cargo.toml -p x-websearch --test search --test content"
exit_code = 101
log_path = "logs/5.0.8-verify-2.log"
observed_and_assumption = "22 of 23 cases pass; unpaid binary content returns 503 service_not_ready before the 200 path because readiness interception lives in x-websearch src/server.rs and src/main.rs (outside touches); taken as a planning gap, the assertion stays intact and the branch is held unlanded."

[finding.7.0.8]
revision = "79bbb49f0"
command = "cargo test --locked --manifest-path platform/Cargo.toml -p layerx-platform-internal --lib evm_sender::"
exit_code = 0
log_path = "logs/7.0.8-verify-1.log"
observed_and_assumption = "verify passes with 9 cases but acceptance 7.34.3 (EVM sender signing through the KMS) is unmet because the hosted KMS exposes only Ed25519 keys; taken as needing a secp256k1 KMS interface decision before the task can be marked done."

[finding.1.1.3]
revision = "759709249"
command = "make build && go test -count=1 ./modules/lxphost/ -run TestAccountMap -v"
exit_code = 1
log_path = "logs/1.1.3-verify-1.log"
observed_and_assumption = "3 of 5 cases pass; the asset sub-account vectors fail because codec.AccountKind (layerxproof/codec/state.go:323-357) has no agent asset kind while the kernel accepts it (src/ledger/lx_account_id.c:50-61); taken as a codec gap, repaired by task 0.7, after which the two cases rerun unchanged."

[finding.1.1.4]
revision = "e0a427b94"
command = "make build && go test -count=1 ./modules/lxphost/ -run TestAssetMap"
exit_code = 1
log_path = "logs/1.1.4-verify-2.log"
observed_and_assumption = "2 of 3 cases pass; the FeeOrdinal kernel parity check fails because registry_asset (src/modules/bridge/lxp_bridge_credit.c:76-83) hashes the symbol without the second colon so its asset ids differ from genesis (src/protocol/lxp_genesis.c:455-466) and custodyproof/light.go:357, and that file is scheduled for deletion with the custody credit; taken as needing a ruling on which asset id derivation the fee ordinal parity check should use."

[finding.13.1.3]
revision = "709fd23d6"
command = "cargo test --locked --manifest-path interop/Cargo.toml -p layerx-gas-station --test resolution_policy"
exit_code = 0
log_path = "logs/13.1.3-verify-1.log"
observed_and_assumption = "the task gate passes with 5 cases, but the existing journal cancellation and station expired-rebroadcast assertions in the same crate contradict the no-replacement resolution policy the task requires; both are left intact and the crate-wide test run is a wave gate, taken as a policy ruling for the gas station tests."

