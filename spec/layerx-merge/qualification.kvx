# Qualification findings for layerx-merge: one [finding.<task>] per failure outside the task scope.
# Keys: revision, command, exit_code, log_path, observed_and_assumption.

[finding.5.0.8]
revision = "488630ac9"
command = "cargo test --locked --manifest-path interop/Cargo.toml -p x-websearch --test search --test content"
exit_code = 101
log_path = "logs/5.0.8-verify-1.log"
observed_and_assumption = "interop/Cargo.lock on main is stale, so every --locked interop gate refuses before compiling; taken as unrelated to the task and refreshed once offline on main so the interop gates can run."

[finding.7.0.7]
revision = "488630ac9"
command = "forge build --offline --root ."
exit_code = 1
log_path = "logs/7.0.7-build-1.log"
observed_and_assumption = "contracts/lib is empty until contracts/bootstrap-libs.sh fetches forge-std and openzeppelin-contracts; taken to mean the build_cmd must run the bootstrap first, amended in the task."

[finding.7.0.8]
