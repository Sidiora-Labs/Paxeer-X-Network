[capability.6.2.1]
title = "Tool execution attestation keyed by idempotency key"
reqs = ["6012.1", "6012.2", "6012.3"]
touches = ["src/modules/service/lx_service_module.c", "include/layerx/lxp_kernel.h", "src/protocol/lxp_module_ctx.c", "tests/modules/test_service_attest.c", "tests/modules/test_service_helpers.h"]
tests = ["tests/modules/test_service_attest.c"]
verification_contract = "make test-service-attest"
do_1 = "Declare const uint8_t *lxp_ctx_idempotency_key(const lxp_module_ctx *ctx) in include/layerx/lxp_kernel.h next to lxp_ctx_activity_id (include/layerx/lxp_kernel.h:355)."
do_2 = "Define it in src/protocol/lxp_module_ctx.c beside lxp_ctx_activity_id (src/protocol/lxp_module_ctx.c:1675), returning the executing activity idempotency_key written at src/protocol/lxp_activity.c:63-69, or NULL without an activity."
do_3 = "In execute_tool_exec_attest (src/modules/service/lx_service_module.c:197) replace the memcmp against lxp_ctx_activity_id (src/modules/service/lx_service_module.c:205-206) with a memcmp against lxp_ctx_idempotency_key, keeping LXP_ERR_INVALID_ATTESTATION on mismatch."
do_4 = "Remove the hand-set marker in tests/modules/test_service_helpers.h:91 and add two vectors to tests/modules/test_service_attest.c: a real signed activity accepted and a mismatched key refused."
symbols = ["lxp_ctx_idempotency_key", "execute_tool_exec_attest", "test_tool_exec_attest_real_activity"]

[capability.6.2.2]
title = "Vendor quote parsers for 0x0907"
reqs = ["6013.1", "6013.2", "6013.3"]
touches = ["precompiles/layerxagent/teeattestor/vendor.go", "precompiles/layerxagent/teeattestor/vendor_test.go"]
