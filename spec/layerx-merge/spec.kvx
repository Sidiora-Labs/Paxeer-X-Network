[task.0.5]
title = "Blocks contain exactly the executed sequence"
status = "pending"
mode = "BUILD"
wave = 0
requires = ["0.2", "0.8"]
reqs = ["3.3", "3.5"]
do_1 = "In sequencer mode, CreateProposalBlock (consensus/internal/state/execution.go:101) builds the block as [MsgSequenceBatch] followed by the Seal() slice of the WAL in seq order, replacing mempool ReapTxs (:126)."
do_2 = "MsgSequenceBatch carries height, fromSeq, toSeq, prevSeqHash, lastSeqHash, txRoot, keyId and sig. It is tx 0 of every block and is injected unsigned by the proposer. sig = ed25519 over sha256(\"PAXEER/v1/sequence-batch\\0\" || chain-id || height || fromSeq || toSeq || prevSeqHash || lastSeqHash || txRoot), signed with the receipt key."
do_3 = "Header time becomes the open time of L_open instead of tmtime.Now() (consensus/internal/state/state.go:279). It stays inside Precision 505 ms plus MessageDelay 12 s (consensus/types/params.go:168-176)."
do_4 = "Seal logic lives in node/sequencer/seal.go. Add node/sequencer/seal_test.go: the proposed tx list equals the WAL slice and the batch fields fold to lastSeqHash. Extend consensus/internal/state/execution_test.go (TestApplyBlock :47) for a sequencer-built proposal."
