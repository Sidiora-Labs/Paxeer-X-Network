scope = "Native perps and spot execution inside layerxexchange 0x1015 with margin in bank escrow, signed-observation oracle intake, funding, liquidation, ADL and insurance; agent oracle 0x0903; the perps keeper service; the feeder on pushOracle; launchpad 0x1017 per-market protocol fees and price history; retirement of the intent store, ingester, router and C oracle adapter."
requirements = ["3001", "3002", "3003", "3004", "3005", "3006", "3007", "3008", "3009", "3010", "3011", "3012", "3013", "3014", "3015", "3016", "3017", "3018", "3019", "3020", "3021", "3022", "3023", "3024", "3025", "3026", "3027", "3028", "3029", "3030", "3031", "3032", "3033", "3034", "3035", "3036", "3037", "3038", "3039", "3040"]
completion_task = "3.7.6"

[req.3001]
title = "Perps market creation on 0x1015 createPerpsMarket"
ac_1 = "createPerpsMarket stores the 622-byte market record under 'market:'+marketId through lx_perps_market_create_execute and refuses a second create of the same id with LXP_MARKET_ALREADY_EXISTS (src/modules/perps/lx_perps_market.c:266-278, src/modules/perps/lx_perps_dispatch.c:605-606)"
ac_2 = "creation is permissionless with a self-named administrator: the tuple administrator must equal the caller DID, otherwise LXP_UNAUTHORIZED_DEBIT (src/modules/perps/lx_perps_dispatch.c:600-601)"
ac_3 = "market_validate refuses zero sizes, initial margin not above maintenance margin, bps above 10000, zero intervals, minimum price not below maximum price and non-canonical oracle keys with LXP_PARAMETER_BOUNDS (src/modules/perps/lx_perps_market.c:51-77)"
ac_4 = "create stages the liquidity, long-funding and short-funding system accounts and requires a registered, unpaused quote asset with a matching insurance account, else LXP_ASSET_MISMATCH or LXP_ASSET_PAUSED (src/modules/perps/lx_perps_dispatch.c:568-591)"
ac_5 = "create seeds funding state with funding_index 0 and last_funding_timestamp_ms equal to the block-open timestamp (src/modules/perps/lx_perps_dispatch.c:889-890)"
ac_6 = "the governance-only MsgSetMarket path stops creating markets; one creation path remains and MsgSetMarket keeps only enable and disable flags (modules/layerxexchange/keeper/msg_server.go:25, modules/layerxexchange/keeper/keeper.go:54)"

[req.3002]
title = "Perps market halt and resume on 0x1015 setPerpsHalt"
ac_1 = "setPerpsHalt is accepted only from the market administrator; any other caller is refused with LXP_UNAUTHORIZED_DEBIT (src/modules/perps/lx_perps_dispatch.c:618-619)"
ac_2 = "a halt request that repeats the current state is refused with LXP_AGREEMENT_STATE (src/modules/perps/lx_perps_dispatch.c:620)"
ac_3 = "an accepted halt rewrites market:<id> with the new flag and emits PerpsMarketHalted(market_id, administrator, halted) (src/modules/perps/lx_perps_dispatch.c:897-906, include/layerx/lx_perps.h:61)"
ac_4 = "while halted, place, open, increase, funding and liquidate are refused with LXP_MARKET_HALTED and cancel and margin-add stay allowed (src/modules/perps/lx_oracle_halt.c:15-25, src/modules/perps/lx_perps_dispatch.c:542)"

[req.3003]
title = "Oracle observation intake on 0x1015 pushOracle"
ac_1 = "pushOracle accepts a 72-byte observation and a 64-byte ed25519 signature over 'LXP:ORACLE:OBSERVATION:v1' plus the observation by a key in the market permittedOracleKeys, else LXP_UNAUTHORIZED_ORACLE (src/modules/perps/lx_oracle_intake.c:64-92)"
ac_2 = "the EVM sender must be the 0x1004-bound address of the signing oracle key, replacing the kernel binding of activity signer to oracle key, else LXP_UNAUTHORIZED_ORACLE (src/modules/perps/lx_perps_dispatch.c:473-483)"
ac_3 = "observation_sequence must strictly increase per market, else LXP_ORACLE_SEQUENCE (src/modules/perps/lx_perps_dispatch.c:526-530, src/modules/perps/lx_oracle_intake.c:150-152)"
ac_4 = "staleness, bounds and deviation are checked against the block-open timestamp and the market limits: observed_at after the timestamp gives LXP_TIMESTAMP_REGRESSION, older than maximum_oracle_staleness_ms gives LXP_ORACLE_STALE, a price outside [minimum_price, maximum_price] gives LXP_ORACLE_BOUNDS and a jump above maximum_deviation_basis_points gives LXP_ORACLE_DEVIATION (src/modules/perps/lx_oracle_checks.c:5-49)"
ac_5 = "an accepted push writes the 72-byte oracle state through lx_perps_oracle_state_put, clears an oracle-driven halt and emits OracleAccepted(market_id, oracle_pubkey, sequence, price) (src/modules/perps/lx_perps_state.c:90, src/modules/perps/lx_oracle_intake.c:170, include/layerx/lx_perps.h:62)"
ac_6 = "the precompile keeps the kernel transport shape: version byte, observation and signature at offset 73 for 137 bytes (src/modules/perps/lx_perps_command.c:112-123, platform/hosted/feeder/src/lib.rs:50)"

[req.3004]
title = "Perps order placement and matching on 0x1015 placeOrder"
ac_1 = "placeOrder executes ORDER_PLACE in the transaction: price-time match on (market, side, price, global_sequence, order_id) with at most 8 fills and a book capacity of 256 resting orders (src/modules/perps/lx_perps_book.c:13-25, src/modules/perps/lx_perps_book.c:121-160, include/layerx/lx_perps.h:27)"
ac_2 = "the order id is chain-derived from (chain, caller, nonce) with kind byte 6 using the per-account nonce, replacing the caller-chosen kernel id; a reused id is refused with LXP_SEQUENCE_REUSED (modules/layerxexchange/keeper/keeper.go:101, modules/layerxexchange/types/ids.go:34, src/modules/perps/lx_perps_dispatch.c:641-643)"
ac_3 = "the margin account must be the caller DID margin account for the market and its main account must equal the caller main, else LXP_UNAUTHORIZED_DEBIT (src/modules/perps/lx_perps_dispatch.c:132-149, src/modules/perps/lx_perps_dispatch.c:1152-1156)"
ac_4 = "a limit price farther from the oracle than maximum_deviation_basis_points is refused with LXP_ORACLE_DEVIATION, and tick, lot and margin checks refuse with LXP_PARAMETER_BOUNDS or LXP_MARGIN_INSUFFICIENT (src/modules/perps/lx_perps_position.c:240-259, src/modules/perps/lx_perps_book.c:183-217)"
ac_5 = "post-only orders that would cross are refused with LXP_AGREEMENT_STATE, FOK orders that cannot fill fully leave no fill, and GTC remainders rest until the book reaches 256 entries, after which LXP_ARENA_EXHAUSTED is returned (src/modules/perps/lx_perps_book.c:253-271)"
ac_6 = "makers whose settlement is refused with LXP_MARGIN_INSUFFICIENT or LXP_UNAUTHORIZED_DEBIT are removed from the book and the match retried, and the receipt reports OrderPlaced(order_id, market_id, fill_count, quantity) (src/modules/perps/lx_perps_dispatch.c:986-989, src/modules/perps/lx_perps_dispatch.c:1104, include/layerx/lx_perps.h:63)"
ac_7 = "matching runs at receipt against the pending branch, so the same receipt order replays identical fills on every validator; the differential test compares the Go keeper outcome with the C module outcome for the same calls (src/modules/perps/lx_perps_dispatch.c:1122-1225)"

[req.3005]
title = "Perps order cancel on 0x1015 cancelOrder"
ac_1 = "cancelOrder(market, orderId) refuses a caller whose DID does not hold the order margin account with LXP_UNAUTHORIZED_DEBIT, closing the gap where the current method checks no holder (src/modules/perps/lx_perps_dispatch.c:647-662, modules/layerxexchange/keeper/intents.go:153-166)"
ac_2 = "an accepted cancel deletes order:<market><order>, persists the book and emits OrderCancelled(order_id, market_id) (src/modules/perps/lx_perps_dispatch.c:1227-1250, src/modules/perps/lx_perps_state.c:392, include/layerx/lx_perps.h:64)"
ac_3 = "cancelling an unknown order id is refused with LXP_UNKNOWN_FIELD (src/modules/perps/lx_perps_book.c:299)"
ac_4 = "cancel stays allowed while the market is halted and while Params.Paused is set (src/modules/perps/lx_oracle_halt.c:22-24, src/modules/governance/lxp_emergency.c:147)"

[req.3006]
title = "Position open on 0x1015 openPosition"
ac_1 = "openPosition requires position_id equal to the caller margin account id, entry_notional 0, a lot-multiple size and a nonzero margin amount, else LXP_NON_CANONICAL or LXP_PARAMETER_BOUNDS (src/modules/perps/lx_perps_dispatch.c:665-680)"
ac_2 = "margin must cover the initial requirement at the oracle price, notional = floor(oracle_price * size / price_scale), else LXP_MARGIN_INSUFFICIENT (src/modules/perps/lx_perps_dispatch.c:681-688, src/modules/perps/lx_perps_dispatch.c:348)"
ac_3 = "an accepted open posts margin from the D2 main address to the D2 margin address through lx_perps_margin_post, sets has_open_reference and emits PositionOpened(position_id, market_id, side) (src/modules/perps/lx_perps_position.c:76-93, src/modules/perps/lx_perps_dispatch.c:1282-1285, include/layerx/lx_perps.h:65)"
ac_4 = "one position per DID per market: a second open while one is open is refused with LXP_SEQUENCE_REUSED (src/modules/perps/lx_perps_position.c:149-152)"

[req.3007]
title = "Position increase on 0x1015 increasePosition"
ac_1 = "increasePosition fixes notional_delta to 0 and refuses any nonzero value with LXP_NON_CANONICAL (src/modules/perps/lx_perps_command.c:335-354, src/modules/perps/lx_perps_position.c:176)"
ac_2 = "only the position holder may increase: position_loaded refuses a closed position with LXP_AGREEMENT_STATE and another DID with LXP_UNAUTHORIZED_DEBIT (src/modules/perps/lx_perps_dispatch.c:545-565)"
ac_3 = "the held margin after the increase must cover the initial requirement on the new size, else LXP_MARGIN_INSUFFICIENT (src/modules/perps/lx_perps_dispatch.c:718-750)"
ac_4 = "an accepted increase posts margin and emits PositionIncreased(position_id, market_id, side) (src/modules/perps/lx_perps_dispatch.c:1293-1337, include/layerx/lx_perps.h:66)"

[req.3008]
title = "Position close and settlement on 0x1015 closePosition"
ac_1 = "closePosition settles funding owed through lx_perps_funding_owed before the close legs, returning owed as int256 within i128 (src/modules/perps/lx_perps_dispatch.c:1428-1430, src/modules/perps/lx_perps_funding.c:200-234)"
ac_2 = "close builds two legs between margin, main and the market pool through close_settlement_emit and refuses a remaining nonzero balance with LXP_ACCOUNT_NOT_EMPTY (src/modules/perps/lx_perps_dispatch.c:1344-1359, src/modules/perps/lx_perps_position.c:207-212)"
ac_3 = "after close has_open_reference is cleared so withdrawMargin may release the full balance (src/modules/perps/lx_perps_dispatch.c:1450)"
ac_4 = "closePosition replaces requestSettlement, which only records a SETTLE intent today, and emits PositionClosed(position_id, market_id, owed) (modules/layerxexchange/keeper/intents.go:169-182, include/layerx/lx_perps.h:67)"
ac_5 = "closePosition stays allowed while Params.Paused is set, as an exit path (src/modules/governance/lxp_emergency.c:147)"

[req.3009]
title = "Funding tick on 0x1015 fundingTick"
ac_1 = "fundingTick is permissionless and requires an unhalted market, a current oracle price and both funding system accounts (src/modules/perps/lx_perps_dispatch.c:790-808)"
ac_2 = "the rate is (mid minus oracle) in bps of the book mid, rounded toward the oracle side and clamped to maximum_funding_rate_bps (src/modules/perps/lx_perps_funding.c:54-88, src/modules/perps/lx_perps_dispatch.c:1512)"
ac_3 = "elapsed intervals are caught up as elapsed / funding_interval_ms; zero elapsed intervals give LXP_NOT_YET_VALID and a timestamp before the last tick gives LXP_TIMESTAMP_REGRESSION (src/modules/perps/lx_perps_funding.c:137-143)"
ac_4 = "transfer legs move between the long and short funding accounts under the PROTOCOL_MODULE context with reason FUNDING and emit FundingSettled(market_id, quote_asset, funding_index, rate) (src/modules/perps/lx_perps_funding.c:173-192, src/modules/perps/lx_perps_dispatch.c:98, include/layerx/lx_perps.h:68)"
ac_5 = "funding reads come from pending state so the keeper sees the effect of earlier receipts in the same block (src/modules/perps/lx_perps_state.c:182)"

[req.3010]
title = "Liquidation and insurance on 0x1015 liquidate"
ac_1 = "liquidate is permissionless with liquidatorAccount equal to the caller DID main account, else LXP_UNAUTHORIZED_DEBIT (src/modules/perps/lx_perps_dispatch.c:822-827)"
ac_2 = "a position is liquidatable only when margin balance is below ceil(mark notional * maintenance_margin_ratio_bps / 10000), else LXP_MARGIN_INSUFFICIENT (src/modules/perps/lx_perps_liquidate.c:23-44, src/modules/perps/lx_perps_dispatch.c:837-842)"
ac_3 = "the liquidation fee splits with insurance = ceil(fee * (10000 - liquidator_share_bps) / 10000) and the liquidator receiving the rest (src/modules/perps/lx_perps_liquidate.c:46-61)"
ac_4 = "a loss beyond the margin is covered by insurance first and the remainder is recorded in 'deficit:'+market with recorded_at_sequence from global_sequence (src/modules/perps/lx_perps_insurance.c:42-83, src/modules/perps/lx_perps_dispatch.c:1557-1580)"
ac_5 = "an accepted liquidation closes the position and emits Liquidated(position_id, market_id, covered) with covered as uint256 within u128 (src/modules/perps/lx_perps_liquidate.c:177-209, include/layerx/lx_perps.h:69)"

[req.3011]
title = "Auto-deleveraging on 0x1015 adl"
ac_1 = "adl takes 1..16 strictly ascending position ids, else LXP_LENGTH_LIMIT or LXP_UNSORTED_SEQUENCE (src/modules/perps/lx_perps_command.c:468-494, src/modules/perps/lx_perps_dispatch.c:854-856)"
ac_2 = "every candidate must be open, held in an agent margin account and in profit at the oracle price, else LXP_AGREEMENT_STATE or LXP_UNKNOWN_ACCOUNT_NAMESPACE (src/modules/perps/lx_perps_dispatch.c:864-873, src/modules/perps/lx_perps_dispatch.c:1718-1735)"
ac_3 = "ADL legs move profit from the candidates to the liquidity account under PROTOCOL_MODULE until the deficit is cleared, and an uncleared remainder is refused with LXP_INSUFFICIENT_BALANCE (src/modules/perps/lx_perps_insurance.c:117-177)"
ac_4 = "a cleared deficit is deleted from 'deficit:'+market and Deleveraged(market_id, liquidity_id, count, deficit) is emitted (src/modules/perps/lx_perps_dispatch.c:1747, src/modules/perps/lx_perps_state.c:273, include/layerx/lx_perps.h:70)"

[req.3012]
title = "Margin account registration on 0x1015 registerMargin"
ac_1 = "registerMargin(market) stages the zero-balance AGENT_MARGIN account 'agent:<did>:margin:<hex(market)>' and returns its id; the precompile computes the id instead of taking it from the payload (src/modules/perps/lx_perps_dispatch.c:1951-1976, src/protocol/lxp_module_ctx.c:773-776)"
ac_2 = "only the account-holder authority kind is accepted (LXP_AUTHORITY_OWNER); a delegated grant is refused with LXP_UNAUTHORIZED_DEBIT (src/modules/perps/lx_perps_dispatch.c:1962-1964)"
ac_3 = "a second registration of the same market is refused with LXP_SEQUENCE_REUSED and a halted market with LXP_MARKET_HALTED (src/modules/perps/lx_perps_dispatch.c:1971)"
ac_4 = "the iface v3 registration keeps activity type 0x0006000c in the genesis module table (include/layerx/lx_perps.h:344, tests/test_genesis_module_table.c:725)"

[req.3013]
title = "Margin deposit on 0x1015 depositMargin and depositMarginToken"
ac_1 = "depositMargin(market) moves msg.value by bank transfer from the caller into the caller DID D2 main address in the same transaction, replacing custody.Deposit (modules/layerxexchange/keeper/intents.go:57-77, precompiles/layerxexchange/layerxexchange.go:343-361)"
ac_2 = "depositMarginToken(pointer, amount, market) does the same for a registered ERC20 pointer denom with amount within u128, else LXP_NON_CANONICAL (precompiles/layerxexchange/layerxexchange.go:365-376, modules/layerxexchange/keeper/intents.go:27-29)"
ac_3 = "depositMargin is the only payable method; every other method refuses a nonzero value (precompiles/layerxexchange/layerxexchange.go:208-211, precompiles/common/precompiles.go:219-225)"
ac_4 = "a margin asset outside Params margin assets is refused with LXP_EXCHANGE_NOT_MARGIN_ASSET and emits MarginDeposited(depositId, marginAccount, holder, assetId, amount) on success (modules/layerxexchange/types/errors.go:11, modules/layerxexchange/types/params.go:67, precompiles/layerxexchange/layerxexchange.go:327-339)"

[req.3014]
title = "Margin withdraw on 0x1015 withdrawMargin with a free-margin check"
ac_1 = "withdrawMargin(market, amount) releases from the D2 margin address to the D2 main address in the same transaction when amount is within free margin = balance minus locked, locked = ceil(mark notional * initial_margin_ratio_bps / 10000) (src/modules/perps/lx_perps_position.c:95-112, precompiles/layerxexchange/layerxexchange.go:378-394)"
ac_2 = "with no open reference and no resting orders the whole balance is free (src/modules/perps/lx_perps_dispatch.c:1450)"
ac_3 = "resting order margin counts as locked, so a withdraw that would leave a resting order unfunded is refused (src/modules/perps/lx_perps_book.c:165-182)"
ac_4 = "an accepted withdraw emits MarginWithdrawn(marginAccount, holder, assetId, amount) in place of MarginWithdrawalRequested and stays allowed while paused (precompiles/layerxexchange/layerxexchange.go:63-67, src/modules/governance/lxp_emergency.c:147)"

[req.3015]
title = "Spot market creation on 0x1015 createSpotMarket"
ac_1 = "createSpotMarket is permissionless with administrator equal to the caller DID, else LXP_UNAUTHORIZED_DEBIT (src/modules/spot/lx_spot_dispatch.c:343-352)"
ac_2 = "market fields need nonzero ids, base different from quote and nonzero tick and lot, else LXP_PARAMETER_BOUNDS (src/modules/spot/lx_spot_market.c:11-20)"
ac_3 = "the store holds at most 64 spot markets and a duplicate id is refused with LXP_MARKET_ALREADY_EXISTS (src/modules/spot/lx_spot_dispatch.c:356-361, include/layerx/lx_spot.h:20)"
ac_4 = "create stages two escrow accounts derived with domain 'LX:SPOT:ESCROW:v1' and emits SpotMarketCreated(market_id, base, quote) (src/modules/spot/lx_spot_market.c:9-35, src/modules/spot/lx_spot_dispatch.c:429-445, include/layerx/lx_spot.h:32)"

[req.3016]
title = "Spot order placement and matching on 0x1015 placeSpotOrder"
ac_1 = "placeSpotOrder requires base and quote accounts both held by the caller DID, else LXP_UNAUTHORIZED_DEBIT (src/modules/spot/lx_spot_dispatch.c:143-201)"
ac_2 = "escrow is locked first, up to 8 fills execute with legs between escrow and counterparties, the unfilled remainder is refunded or rests for a GTC limit order, and the book cap 256 refuses with LXP_LENGTH_LIMIT (src/modules/spot/lx_spot_dispatch.c:533-669, include/layerx/lx_spot.h:21-22)"
ac_3 = "a market order must be IOC with price 0 and is refused with LXP_AGREEMENT_STATE when it fills nothing (src/modules/spot/lx_spot_market.c:112-114, src/modules/spot/lx_spot_dispatch.c:641-642)"
ac_4 = "the spot order id is chain-derived with kind byte 7, the global_sequence is the derived height and receipt index, and SpotOrderPlaced(order_id, market_id, fill_count, quantity, remaining) is emitted (src/modules/spot/lx_spot_dispatch.c:521, src/modules/spot/lx_spot_dispatch.c:681-689, include/layerx/lx_spot.h:33)"
ac_5 = "spot settlement requests stay refused because spot has no settlement activity (src/modules/spot/lx_spot_dispatch.c:11-14)"

[req.3017]
title = "Spot cancel and halt on 0x1015 cancelSpotOrder and setSpotHalt"
ac_1 = "cancelSpotOrder requires the order accounts held by the caller DID and returns the released escrow, else LXP_UNAUTHORIZED_DEBIT (src/modules/spot/lx_spot_dispatch.c:410-427, src/modules/spot/lx_spot_dispatch.c:692-738)"
ac_2 = "an accepted cancel emits SpotOrderCancelled(order_id, market_id, escrowed) (src/modules/spot/lx_spot_dispatch.c:733-737, include/layerx/lx_spot.h:34)"
ac_3 = "setSpotHalt is administrator-only and refuses a same-state request with LXP_AGREEMENT_STATE, emitting SpotMarketHalted or SpotMarketResumed (src/modules/spot/lx_spot_dispatch.c:364-376, src/modules/spot/lx_spot_dispatch.c:447-463, include/layerx/lx_spot.h:35-36)"
ac_4 = "cancelSpotOrder stays allowed while Params.Paused is set (src/modules/governance/lxp_emergency.c:147)"

[req.3018]
title = "Exchange views read state directly"
ac_1 = "getMarket, getOrder, getPosition and getMargin drop the (batchNumber, witness) arguments and read current or pending state directly instead of verifying a witness against the anchor finalized root (modules/layerxexchange/keeper/proofs.go:32-77, precompiles/layerxexchange/layerxexchange.go:243-275)"
ac_2 = "getPerpsBook returns at most 256 orders in book order and getPerpsPositions (0xc0451774) returns at most 128 positions in ascending positionId order (src/modules/perps/lx_perps_state.c:425, src/modules/perps/lx_perps_state.c:571-587, include/layerx/lx_perps.h:29)"
ac_3 = "getFunding, getOracle and getDeficit return the funding index and last tick, the oracle sequence, price and observed_at, and the deficit, and unknown keys give LXP_UNKNOWN_FIELD (src/modules/perps/lx_perps_state.c:105, src/modules/perps/lx_perps_state.c:182, src/modules/perps/lx_perps_state.c:256)"
ac_4 = "getSpotMarket, getSpotOrder and getSpotBook read the spot store with the book capped at 256 (src/modules/spot/lx_spot_state.c:135, src/modules/spot/lx_spot_state.c:185, src/modules/spot/lx_spot_state.c:245)"
ac_5 = "each view has a gRPC Query twin and point reads cost 3000 gas, book and position lists 20000 (precompiles/common/precompiles.go:286-292)"

[req.3019]
title = "Exchange administration, parameters and module pause"
ac_1 = "MsgUpdateParams stays under the module authority and validates margin assets and fee policy (modules/layerxexchange/keeper/msg_server.go:17-19, modules/layerxexchange/keeper/keeper.go:79, modules/layerxexchange/types/params.go:34)"
ac_2 = "Params gains a Paused flag that refuses every state-changing 0x1015 method except cancelOrder, cancelSpotOrder, closePosition and withdrawMargin with LXP_PAUSED_SCOPE, in the shape of lxp_pause_scope_check (src/modules/governance/lxp_emergency.c:139-160, modules/layerxexchange/keeper/keeper.go:35)"
ac_3 = "Params gains a time-in-force capability flag that replaces the native-genesis capability witness in placeOrder (modules/layerxexchange/keeper/intents.go:120-138, modules/layerxexchange/types/state.go:120)"
ac_4 = "market validation failures map to LXP_EXCHANGE_INVALID_MARKET and unknown markets to LXP_EXCHANGE_UNKNOWN_MARKET (modules/layerxexchange/types/errors.go:8-19, modules/layerxexchange/types/params.go:15)"

[req.3020]
title = "Launchpad market creation on 0x1017 createMarket stays unchanged"
ac_1 = "createMarket keeps its checks: zero creator refused, strategy 0..3 validated, name and symbol validated (modules/launchpad/keeper/market.go:27-37, modules/launchpad/types/market.go:16-25)"
ac_2 = "the creation fee goes to the treasury by bank send (modules/launchpad/keeper/market.go:38-41)"
ac_3 = "launchpad gas stays on its current per-method formula (precompiles/launchpad/launchpad.go:224-230)"
ac_4 = "delegatecall, staticcall writes and value on non-payable methods stay refused (precompiles/launchpad/launchpad.go:232)"

[req.3021]
title = "Launchpad buy and sell with per-market protocol fee accumulators"
ac_1 = "Swap keeps the virtual-reserve curve, the paused, deadline, zero-input, zero-address and slippage refusals (modules/launchpad/keeper/swap.go:129-154)"
ac_2 = "the protocol cut is computed as fee * ProtocolFeeBps / 10000 and sent to the treasury, with the pool cut added to market.AccumulatedFees (modules/launchpad/keeper/swap.go:53-64, modules/launchpad/keeper/swap.go:168-171)"
ac_3 = "the global ProtocolFeesPending counter written on every swap is replaced by a per-market counter keyed 0x03 plus denom, so swaps of different markets do not conflict (modules/launchpad/keeper/swap.go:172, modules/launchpad/types/keys.go:38, modules/launchpad/keeper/keeper.go:104-122)"
ac_4 = "the solvency invariant owedQuote = RealQuoteBalance + AccumulatedFees + AirdropBalance per market keeps holding (modules/launchpad/keeper/invariants.go:20-27)"
ac_5 = "genesis import and export carry per-market protocol fee entries in place of the single ProtocolFeesPending value (modules/launchpad/keeper/genesis.go:18, modules/launchpad/keeper/genesis.go:52, modules/launchpad/types/genesis.go:56-71)"

[req.3022]
title = "Launchpad fee strategies, burn, airdrop, LP rewards and pause stay unchanged"
ac_1 = "SetFeeStrategy and ClaimFees require the fee-rights holder and the CLAIM strategy for claims (modules/launchpad/keeper/fees.go:12-29, modules/launchpad/keeper/fees.go:50-76)"
ac_2 = "ExecuteBurn, ExecuteAirdrop and ExecuteLpRewards keep their strategy checks and effects (modules/launchpad/keeper/fees.go:100, modules/launchpad/keeper/fees.go:123, modules/launchpad/keeper/fees.go:253)"
ac_3 = "ClaimAirdrop and ClaimAirdropForEpoch keep the epoch basis from the holding history (modules/launchpad/keeper/fees.go:156, modules/launchpad/keeper/fees.go:212, modules/launchpad/keeper/history.go:155)"
