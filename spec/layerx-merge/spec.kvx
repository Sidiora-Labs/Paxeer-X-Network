[contract_context.5.interface]
request = "request(uint8,bytes,uint64) payable returns uint64, selector 0x5f7c8e9b, origin 1 (precompiles/xweb/XWeb.sol:93, precompiles/xweb/xweb.go:306-331)."
fulfil = "fulfil(uint64,bytes,bytes32,uint32,bytes[]) returns (uint8,uint64), selector 0xaeb8a7ec, origin 1 (precompiles/xweb/xweb.go:384-447)."
refund = "refund(uint64), selector 0xd7194ccb, origin 1 only (precompiles/xweb/xweb.go:333-346, modules/xweb/keeper/refund.go:17-48)."
fulfil_program = "fulfilProgram(bytes observation), selector 0x2d4bf7ad, origin 2, raw observation 146..5283 bytes (include/layerx/lx_web.h:32-35)."
request_from_program = "Keeper.RequestFromProgram(ctx, programId, requestId, kind, payload, asset, amount) is a keeper entry with no EVM selector; the request record is the 0x101D guest event (src/modules/programs/call.c:1979-1985)."
views_origin1 = "getRequest 0xcbbf67ec, getResult 0xedff42d6, getAttestors 0x1a15922d, threshold 0x42cde4e8, fee 0xddca3f43, getParams 0x5e615a6b (precompiles/xweb/XWeb.sol:105-115, precompiles/xweb/xweb.go:250-280)."
views_origin2 = "getProgramResult(bytes32,uint64) 0x2b2e13fc and getKernelNetworkId() 0xfc0d26f4; the getParams tuple stays fixed (precompiles/xweb/XWeb.sol:65-71)."
msgs = "MsgRegisterAttestor, MsgRemoveAttestor, MsgSetThreshold, MsgSetParams, MsgPause and MsgUnpause under Params.Authority (modules/xweb/keeper/msg_server.go:71-207, modules/xweb/keeper/keeper.go:81-86)."
consumer = "IXWebConsumer.onXWebResponse is the only origin-1 callback (precompiles/xweb/XWeb.sol:120-123, precompiles/xweb/xweb.go:53-54); origin 2 pulls with web_read (programs/crates/layerx-programs-runtime/src/abi/mod.rs:1346, programs/crates/layerx-programs-runtime/src/abi/manifest.rs:70)."
address = "0x1019 stays the precompile address (modules/xweb/types/keys.go:17, precompiles/xweb/xweb.go:58)."

[contract_context.5.storage]
params_key = "Params under key 0x01 (modules/xweb/types/keys.go:28, modules/xweb/keeper/keeper.go:62-76)."
attestor_key = "One attestor set for both origins under key 0x02 (modules/xweb/types/keys.go:29, modules/xweb/keeper/keeper.go:90-94)."
paused_key = "Paused flag under key 0x03 (modules/xweb/types/keys.go:30, modules/xweb/keeper/keeper.go:105-115)."
nonce_key = "Origin-1 nonce under key 0x04 (modules/xweb/types/keys.go:31, modules/xweb/keeper/keeper.go:118-122)."
request_result_keys = "Origin-1 requests and results under 0x05 and 0x06 (modules/xweb/types/keys.go:32-33, modules/xweb/types/keys.go:55-57)."
origin2_families = "Origin-2 pending under web/pending||programId||u64 and answers under web/answer||programId||u64||part, never in 0x05/0x06 (include/layerx/lx_web.h:44-47, src/modules/web/lx_web_intake.c:253-265)."
capacities = "At most 256 pending and 64 committed origin-2 entries (include/layerx/lx_web.h:39-40, src/modules/web/lx_web_intake.c:546-547, src/modules/web/lx_web_intake.c:570)."
genesis = "InitGenesis and ExportGenesis carry params, set, paused flag, nonce, requests and results (modules/xweb/keeper/genesis.go:9-36)."

[contract_context.5.errors]
module_names = "Registered module errors map to LXP_XWEB_<NAME> (modules/xweb/types/errors.go:6-29)."
site_names = "Precompile site texts become LXP_XWEB_DELEGATECALL, LXP_XWEB_STATICCALL, LXP_XWEB_KEEPER_MISSING, LXP_XWEB_FULFIL_EVM_ONLY and LXP_XWEB_CALLBACK_BUDGET (precompiles/xweb/xweb.go:290, precompiles/xweb/xweb.go:293, precompiles/xweb/xweb.go:296, precompiles/xweb/xweb.go:243, precompiles/xweb/xweb.go:416)."
framework_codes = "Framework checks keep their shared codes: argument count, non-payable, wei remainder (precompiles/common/precompiles.go:213, precompiles/common/precompiles.go:221, precompiles/common/precompiles.go:230)."
kernel_names = "Origin-2 intake keeps the kernel names in kernel order: LXP_WRONG_NETWORK (src/modules/web/lx_web_intake.c:533), LXP_SEQUENCE_REUSED (src/modules/web/lx_web_intake.c:544), LXP_ARENA_EXHAUSTED (src/modules/web/lx_web_intake.c:547), LXP_CONTEXT_MISMATCH (src/modules/web/lx_web_intake.c:561), LXP_ATTESTATION_THRESHOLD (src/modules/web/lx_web_intake.c:563)."
signature_names = "Signature refusals keep LXP_BAD_SIGNATURE, LXP_AUTH_DUPLICATE_SIGNER, LXP_UNSORTED_SEQUENCE and LXP_INVALID_ATTESTATION (src/modules/web/lx_web_intake.c:228-239)."
shape_names = "Shape refusals keep LXP_NON_CANONICAL and LXP_UNKNOWN_FIELD (src/modules/web/lx_web_intake.c:527, src/modules/web/lx_web_intake.c:540-541)."
disabled = "Below activation the origin-2 surface answers LXP_MODULE_DISABLED (src/modules/web/lx_web_intake.c:445, modules/layerxcustody/keeper/keeper.go:38-46)."
refund_origin2 = "Refund of an origin-2 id answers LXP_XWEB_UNKNOWN_REQUEST because no 0x05 record exists (modules/xweb/keeper/refund.go:19-20)."

[contract_context.5.events]
requested = "XWebRequested topic0 0x3761cb12023af30e23da5dd47f1bf8cae4951138f813d82effc788e317254293 (precompiles/xweb/XWeb.sol:73-78)."
fulfilled = "XWebFulfilled topic0 0xc7eff87d7909e306e0e43af3c9ad333ddc311b8a3c1f90fa68044c11d62ecd1a (precompiles/xweb/XWeb.sol:80-86)."
refunded = "XWebRefunded topic0 0xc7eaafa8d3b0edacffbf86e1d4f404b61a8cb32dca0e8e57998422538045072d (precompiles/xweb/XWeb.sol:88-91)."
cosmos = "Cosmos event names and attributes are kept (modules/xweb/types/events.go:4-39)."
origin2 = "Origin 2 emits no xweb log; the request record is the 0x101D ProgramGuestEvent with topic0 0x23a84d3a8c8e7d232703d9715c64dba47a94a94c87c46fe61532e5a609e761d1 (src/modules/programs/call.c:1985, src/modules/web/lx_web_module.c:129-145)."

[contract_context.5.gas]
write = "request and refund charge 30000 + 16 x len (precompiles/xweb/xweb.go:61-63, precompiles/xweb/xweb.go:184-193)."
fulfil = "fulfil adds 8000 per signature (64 when undecodable) and the callback gas used plus 10000 (precompiles/xweb/xweb.go:197-207, precompiles/xweb/xweb.go:446)."
fulfil_program = "fulfilProgram charges 30000 + 16 x len + 8000 x sigs (16 when undecodable) with no callback term (precompiles/xweb/xweb.go:184-207)."
views = "Views charge 3000 + 16 x len (precompiles/xweb/xweb.go:185)."
sidecar_limit = "The sidecar fulfil gas limit is the precompile charge plus transaction base and calldata (interop/crates/x-websearch/src/submit.rs:26-34, interop/crates/x-websearch/src/submit.rs:90-100)."
kernel_units = "Kernel gas units are not converted (src/modules/web/lx_web_module.c:67, src/modules/web/lx_web_module.c:107)."

[contract_context.5.activation]
precompile = "The precompile registers at v6.8 (precompiles/setup.go:37, precompiles/setup.go:93)."
per_method = "fulfilProgram, getProgramResult, getKernelNetworkId and RequestFromProgram gate per method by IsUpgradeActiveAtHeight, failing closed without a reader (modules/layerxcustody/keeper/keeper.go:38-46, modules/layerxcustody/types/expected_keepers.go:31-33)."
params = "Activation sets fee 75 PAX base units, kernelNetworkId and programFeeDenoms PAX, SID, USDC, USDL through the upgrade handler (node/upgrades.go:77-80, node/upgrades.go:354-372)."
initial_set = "The initial set is registered at upgrade with threshold 3 (node/xweb_attestors.go:14, node/upgrades.go:365)."
min_gas_price = "The draw sender class pays at most 0.067 gwei; the only floor is MinimumFeePerGas, default 1 gwei (modules/evm/types/params.go:52, modules/evm/types/params.go:81, modules/evm/types/params.go:102)."

[contract_context.5.invariants]
one_set = "One attestor set serves both origins and registration is capped at 16 while MaxAttestors 64 stays the gas bound (modules/xweb/types/keys.go:21, include/layerx/lx_web.h:29, modules/xweb/keeper/msg_server.go:82-83)."
majority = "The threshold is a strict majority, 2t > n and t <= n (modules/xweb/types/state.go:169-174, src/modules/web/lx_web_attestors.c:13-15)."
sorted = "Attestors stay sorted by signer (modules/xweb/keeper/msg_server.go:85-88, src/modules/web/lx_web_attestors.c:20-23)."
pause = "Pause stops request, fulfil and both origin-2 entries; refund stays open (modules/xweb/keeper/request.go:20-21, modules/xweb/keeper/fulfil.go:95-96, modules/xweb/keeper/refund.go:15-16)."
no_refund = "Origin 2 has no refund and no timeout; origin 1 refunds after its timeout only (modules/xweb/keeper/refund.go:28-30)."
split = "Fees split floor(amount/count) to each signer with the remainder to signers[0], zero legs skipped (modules/xweb/keeper/fulfil.go:133-151, src/modules/web/lx_web_intake.c:423-491)."
network = "The kernel network id is non-zero and fills preimage bytes 43..46 (src/protocol/lxp_kernel.c:1685, src/modules/web/lx_web_intake.c:532-533)."

[contract_context.5.fees]
price = "Paid HTTP costs USD 0.001 per request: 75 PAX base units at rate 13.44, 232 SID, 1000 USDC or USDL (tools/bringup/xweb-config.sh:144-158, tools/bringup/xweb-config.sh:187)."
rate_input = "The PAX USD rate is a required input to the pricing script (tools/bringup/xweb-config.sh:145)."
origin2_fee = "Origin-2 fee is any positive amount in one allowlisted asset, paid into address.Module(\"layerx\", sha256(\"PAXEERX_WEB_FEES_V1\"||asset)) (src/modules/programs/call.c:588-601, sdk/types/address/hash.go:63)."
origin1_fee = "Origin-1 fee is the Params fee in wei, escrowed on request (modules/xweb/keeper/request.go:44-55, modules/xweb/types/state.go:78)."
draw = "Paid HTTP settles by draw on 0x101A with PaymentDrawn; exact by payExact with PaymentExact (interop/crates/x-websearch/src/payment.rs:1888, interop/crates/x-websearch/src/payment.rs:2138)."

[contract_context.5.attestors]
shape = "An attestor is signer, payout and 32-byte public key; the key derives the signer (modules/xweb/types/state.go:130-158)."
cap = "Registration refuses the 17th attestor with LXP_XWEB_INVALID_ATTESTORS (modules/xweb/keeper/msg_server.go:82-83, include/layerx/lx_web.h:29)."
remove = "Removal clamps the threshold to the set size (modules/xweb/keeper/msg_server.go:125-127)."
sidecar_cap = "The sidecar observation signature bound drops from 32 to 16 (interop/crates/x-websearch/src/kernel.rs:70)."
agent_payer_set = "The agent-host payer is signed by the embedded-wallet attestor set, not this set (agent/crates/layerx-agentd-host/src/payer.rs:45-48)."

[contract_context.5.origin2]
wire = "The observation is origin byte 2, 28 zero bytes, u32 network id, program id, u64 request id, kind and the answer fields (include/layerx/lx_web.h:55-68, src/network/lx_web_adapter.c:23-60)."
preimage = "The origin-2 preimage is 188 bytes under PAXEERX_WEB_V1 with origin 0x02 and the kernel network id (src/modules/web/lx_web_intake.c:44-99, modules/xweb/types/attestation.go:57-75)."
order = "Intake checks shape, network, sequence, capacity, context and threshold in kernel order (src/modules/web/lx_web_intake.c:510-595)."
commit = "The answer commits under web/answer and is read by getProgramResult and web_read (programs/crates/layerx-programs-runtime/src/host/web.rs:13, programs/crates/layerx-programs-runtime/src/abi/mod.rs:1346)."
submit = "The sidecar submits fulfilProgram in place of lx_sendActivity (interop/crates/x-websearch/src/kernel.rs:809, interop/crates/x-websearch/src/kernel.rs:860)."

[task.5.0.1]
title = "Keep the origin-1 request path and give its refusals stable LXP_XWEB codes"
status = "pending"
mode = "BUILD"
wave = 3
requires = ["5.0.7", "10.0.3"]
reqs = ["5001.1", "5001.2", "5001.3", "5001.4", "5001.5"]
capabilities = ["5.1.1"]
do_1 = "Keep Keeper.Request (modules/xweb/keeper/request.go:18-90) as the only origin-1 entry: the exact fee comparison (modules/xweb/keeper/request.go:44-45), the escrow leg into the module account (modules/xweb/keeper/request.go:52-55) and the nonce step (modules/xweb/keeper/request.go:56) stay unchanged."
do_2 = "Return the errors of Keeper.Request through the D6 mapper so the precompile revert text reads LXP_XWEB_<NAME>: <registered text> for every registered error (modules/xweb/types/errors.go:6-29), read at the keeper call site (precompiles/xweb/xweb.go:321)."
do_3 = "Prefix the guard texts with LXP_XWEB_DELEGATECALL (precompiles/xweb/xweb.go:290), LXP_XWEB_STATICCALL (precompiles/xweb/xweb.go:293) and LXP_XWEB_KEEPER_MISSING (precompiles/xweb/xweb.go:296); behaviour of guard (precompiles/xweb/xweb.go:288-299) is otherwise unchanged."
do_4 = "Keep the wei-to-base-unit conversion through HandlePaymentUhpx (precompiles/common/precompiles.go:227-231) at the request site (precompiles/xweb/xweb.go:313-320) so a wei remainder reverts with LXP_PRECOMPILE_WEI_REMAINDER (precompiles/common/precompiles.go:230)."
do_5 = "Keep the EVM log (precompiles/xweb/xweb.go:326-327) and the Cosmos event attributes origin (modules/xweb/keeper/request.go:77) and network_id = ChainID (modules/xweb/keeper/request.go:78) for origin 1 so the sidecar watcher (interop/crates/x-websearch/src/watch.rs:219-232) decodes the same fields."
do_6 = "Write the tests modules/xweb/keeper/request_test.go::TestRequestStoresUnderTheNextNonceAndTakesTheFee, modules/xweb/keeper/request_test.go::TestRequestRefusals, modules/xweb/keeper/request_test.go::TestRequestEventCarriesWhatAnAttestorNeeds with one case per acceptance of this task that they name (of 5.1.1, 5.1.2, 5.1.3, 5.1.4, 5.1.5), each using the real keeper, precompile or binary path whose behaviour starts at modules/xweb/keeper/request.go:18; no test double replaces the path under test."
do_7 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["Keeper.Request", "PrecompileExecutor.request", "guard", "HandlePaymentUhpx"]
touches = ["modules/xweb/keeper/request.go", "modules/xweb/keeper/request_test.go"]
build_cmd = "go build ./modules/xweb/keeper/"
verify_cmd = "go test -count=1 ./modules/xweb/keeper/ ./precompiles/xweb/ -run 'TestRequest|TestRefusesDelegateCall'"
gate_kind = "existing"
planned_paths = []
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result or time limit; record exact revision, command, exit code and private evidence location. Do not mark complete without the declared evidence."
path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to their current equivalents before the gate can run; historical references never authorize a duplicate implementation tree. Complete scoped path reconciliation without dropping acceptance criteria."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

[task.5.0.2]
title = "Keep origin-1 fulfil and move its refusals to LXP_XWEB codes"
status = "pending"
mode = "BUILD"
wave = 3
requires = ["5.0.7", "10.0.3"]
reqs = ["5002.1", "5002.2", "5002.3", "5002.4", "5002.5"]
capabilities = ["5.1.2"]
do_1 = "Keep verifySignatures (modules/xweb/keeper/fulfil.go:17-43) and verifySingle (modules/xweb/keeper/fulfil.go:48-64) for origin 1; signatures recover through RecoverSigner (modules/layerxbridge/types/attestation.go:115-134) with v 27 or 28 and low s."
do_2 = "Keep the origin-1 attestation builder (modules/xweb/keeper/fulfil.go:68-81) with Origin 1 (modules/xweb/keeper/fulfil.go:71), ChainID (modules/xweb/keeper/fulfil.go:72) and the EVM requester word (modules/xweb/keeper/fulfil.go:73)."
do_3 = "Keep the split loop (modules/xweb/keeper/fulfil.go:132-151): bech32 payout parse (modules/xweb/keeper/fulfil.go:137-139), remainder to signers[0] (modules/xweb/keeper/fulfil.go:142-144), zero legs skipped (modules/xweb/keeper/fulfil.go:145-146), SendCoins per leg (modules/xweb/keeper/fulfil.go:148)."
