req = "10029.3"
scenario = "Given holder DID d and a session key at address s, when the client opens, refreshes and closes a session, then it calls layerxauth grantSession, then grantSessionSuccessor with the predecessor id and expected commitment, then revokeGrant, each as a signed transaction."
