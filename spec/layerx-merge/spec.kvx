do_7 = "Make setAdmin (modules/tokenfactory/keeper/admins.go:40-49) copy the stored issuer_did into the new metadata so ChangeAdmin (modules/tokenfactory/keeper/msg_server.go:156) never clears it."
do_8 = "IssuerDid(ctx, denom) returns the stored value for the layerxledger keeper, which compares it with the caller DID as the kernel compares issuer_did32 (src/modules/asset/lx_asset_execution.h:216, src/modules/asset/lx_asset_execution.h:241-242)."
do_9 = "Add TestIssuerDidValidate and TestIssuerDidSurvivesChangeAdmin to modules/tokenfactory/keeper/admins_test.go."
do_10 = "Existing denoms keep an empty issuer_did and their admin rules unchanged (modules/tokenfactory/keeper/admins.go:11-20)."
