do_1 = "Replace sign_draw (interop/crates/x-websearch/src/payment.rs:273) and receive_authorization (interop/crates/x-websearch/src/payment.rs:239) with draw_calldata, the ABI encoding of the 0x101A draw method; RECEIVE_OPERATION (interop/crates/x-websearch/src/payment.rs:85) is deleted."
do_2 = "Replace the lx_sendActivity submit (interop/crates/x-websearch/src/payment.rs:1966-1981) with eth_sendRawTransaction of a transaction signed by the receiver key loaded through RECEIVER_KEY_FILE (interop/crates/x-websearch/src/keys.rs:10), held as a secp256k1 EVM key so the receiver address is the draw sender."
do_3 = "Replace sequence (interop/crates/x-websearch/src/payment.rs:1950-1951) with eth_getTransactionCount at the pending tag, held under the PaymentStore lock (interop/crates/x-websearch/src/payment.rs:624) so one sender never reuses a nonce."
do_4 = "Add tx_hash to PaymentRecord (interop/crates/x-websearch/src/payment.rs:607-620) set where draw builds the record (interop/crates/x-websearch/src/payment.rs:1937-1943); recover (interop/crates/x-websearch/src/payment.rs:1985-2011) reads pax_sequencerReceipt(tx_hash) in place of lx_getActivityStatus and lx_getReceipt."
do_5 = "Keep the grant expiry check (interop/crates/x-websearch/src/payment.rs:1906), the idempotency conflict (interop/crates/x-websearch/src/payment.rs:1915) and the draw validity window (interop/crates/x-websearch/src/payment.rs:72)."
symbols = ["draw", "draw_calldata", "PaymentRecord.tx_hash", "PaymentStore"]

