[contract_context.8.s04]
package = "The identity registration service lives in platform/hosted/identity (platform/hosted/identity/src/main.rs:56) and the router handler in platform/hosted/gateway/src/rpc_register.rs:96."
reads = "It reads the bound DID through addr 0x1004 getLayerXDid (precompiles/addr/addr.go:40)."
writes = "The user write is bindLayerX at addr 0x1004 (precompiles/addr/addr.go:38), signed by the ed25519 DID over LX:PAXEER-BIND:v1 with chain id, EVM address and nonce."
sponsorship = "The bind is a sponsored type-4 transaction through the gas station (D14); the CLI register path (platform/cli/src/register.rs:47) and allowlist (platform/cli/src/rpc.rs:84) follow."
test = "The registration request keeps the real proof and the exact contract (platform/cli/tests/rpc_identity.rs:37)."

[contract_context.8.s16]
reads = "The relayer reads the 0x1016 views (precompiles/layerxbridge/layerxbridge.go:41)."
writes = "Inbound releases are bridgeIn (modules/layerxbridge/keeper/bridge.go:65) verified by verifySignatures (modules/layerxbridge/keeper/bridge.go:33); a duplicate submit is refused through isNullified."
keys = "Signing keys come from the remote signer (interop/crates/layerx-mirror-signer/src/lib.rs:456) named in the relayer config (interop/crates/layerx-bridge-relayer/src/config.rs:320)."
events = "BridgeIn and BridgeOut events are emitted at precompiles/layerxbridge/layerxbridge.go:49 and precompiles/layerxbridge/layerxbridge.go:50."
finality = "The relayer confirms from the signed sequencer receipt and takes finality from block commit."

[contract_context.8.s27]
reads = "The gateway reads addr (precompiles/addr/addr.go:40) and bank (precompiles/bank/bank.go:24) through the RPC list of human/wallet/gateway/src/env.ts:221."
streams = "Agent stream routes (human/wallet/gateway/src/routes/agentPrecompiles.ts:226, human/wallet/gateway/src/routes/agentPrecompiles.ts:234) write through the 0x0906 executor (human/wallet/gateway/src/precompiles.ts:326)."
scheduler = "Scheduler routes (human/wallet/gateway/src/routes/agentPrecompiles.ts:73) reach the 0x0905 executor in receipt order."
quorum = "Attestor endpoints and quorum come from human/wallet/gateway/src/env.ts:201 and human/wallet/gateway/src/env.ts:217, and boot refuses a set other than five endpoints with quorum three (human/wallet/gateway/src/env.ts:263)."
sponsor_key = "The sponsor key input (human/wallet/gateway/src/env.ts:240, human/wallet/gateway/src/routes/wallet.ts:37) is retired; sponsorship goes through the gas station (D14)."

[contract_context.8.s28]
thresholds = "secp256k1 shares sign at threshold (human/wallet/attestor/internal/tss/ecdsa/ecdsa.go:26) and ed25519 shares at human/wallet/attestor/internal/tss/eddsa/eddsa.go:21; the set is 3 of 5 (D34)."
kinds = "The kind table maps each request kind to a key type (human/wallet/attestor/internal/server/sign.go:37); lx_grant stays for layerxledger grants (human/wallet/attestor/internal/policy/kinds.go:16)."
decode = "Calldata is decoded against the embedded ABI set (human/wallet/attestor/internal/policy/evm/decode.go:28) before policy evaluation (human/wallet/attestor/internal/policy/policy.go:359)."
payer = "The attestor set signs the agent-host web payer (D26)."

[contract_context.8.s29]
writes = "Every human service write is a user EVM transaction through eth_sendRawTransaction; the onboarding sponsor key (human/crates/layerx-human-service/src/onboarding/native.rs:28) is retired."
reads = "Balances come from bank state through the network observation (human/crates/layerx-human-service/src/journeys/observed.rs:157)."
evidence = "Activity evidence is the signed sequencer receipt with the receipt key (D15)."

[contract_context.8.s30]
evm = "The KMS signs EVM actions (human/crates/layerx-human-kms/src/evm.rs:178) with the attestor-sharded secp256k1 key through AttestorSigner (human/crates/layerx-human-kms/src/attestor.rs:505)."
ed25519 = "ed25519 stays for bindLayerX, DID proofs and payment grants (human/crates/layerx-human-kms/src/attestor.rs:594)."
config = "Threshold inputs load in Config::load (human/crates/layerx-human-kms/src/config.rs:86)."
rotation = "Out of scope for this feature: DID key rotation is handled outside this feature (D16)."

[contract_context.8.s31]
rungs = "Status pages show submitted, receipted and committed; the frontend list (explorer/frontend/types/api/paxeerXLists.ts:1) and ladder (explorer/frontend/ui/shared/statusLadder/rungs.ts:23) change."
rpc = "Block reads come from rpc/block.go:207 and log filters from rpc/filter.go:569."
archive = "Kernel tables from before the activation height are served read-only; anchor reads stay until bond return (D21)."
ingest = "Custody, deposit-root and guarantor ingestion stops (explorer/backend/apps/indexer/lib/indexer/transform/paxeer_x_logs.ex:17)."

[contract_context.8.s32]
backends = "Wallet off-chain backends keep their routes (human/apps/wallet/src/surfaces/LaunchpadView.tsx:28, human/apps/wallet/src/surfaces/WebDataView.tsx:65)."
swap = "Swap routes stay in the executor switch (human/apps/wallet/src/lib/swap/executor.ts:37)."
submission = "Every signed write goes through the gateway send path that returns the signed receipt."

[contract_context.8.rungs]
submitted = "Submitted: the transaction was accepted by eth_sendRawTransaction on the sequencer (D17)."
receipted = "Receipted: pax_sequencerReceipt returns a signed receipt whose checks pass (human/wallet/sdk/src/ladder.ts:4 changes to this list)."
committed = "Committed: the block carrying the receipt is committed; explorer status maps at human/wallet/sdk/src/ladder.ts:100."
replacement = "There is no same-nonce replacement; a second send takes the next nonce (D17)."

[contract_context.8.receipt_checks]
r2 = "Receipt signature check R2 follows agent/crates/layerx-proof/src/receipt.rs:631."
r7 = "Inclusion check R7 reads the transaction through rpc/tx.go:106."
key = "The receipt key is ed25519 and pinned by clients (D15)."

[contract_context.8.switch_off]
lx = "Every lx_* name on the router answers -32601 at activation (platform/hosted/gateway/src/rpc.rs:229)."
cli = "The CLI allowlist (platform/cli/src/rpc.rs:84) admits eth_* and px_* names."
sdk = "Wallet SDK reads lx_getAccount and lx_getActivityStatus (human/wallet/sdk/src/kernel.ts:95, human/wallet/sdk/src/kernel.ts:112) move to their successors."
web = "Web history reads (human/apps/web/src/api/gateway.ts:360, human/apps/web/src/app/_markets/activity-feed.tsx:40) move to px_getHistory."

[contract_context.8.portable_v2]
format = "The portable receipt v2 replaces v1 (interop/crates/layerx-portable/src/receipt.rs:11)."
contents = "It carries the signed receipt and receipt key, and at committed the header, inclusion proof, commit and validator set."

[task.8.4.1]
title = "Attestor decode reads the layerxledger and layerxpay ABIs"
status = "pending"
mode = "BUILD"
wave = 4
requires = ["1.6.1", "1.7.1"]
reqs = ["8020.1", "8020.2", "8020.3", "8021.1", "8021.2", "8021.3", "10.8", "4.1", "4.3"]
capabilities = ["8.4.1", "8.3.6"]
do_1 = "Add layerxledger 0x101A and layerxpay 0x101B to the embedded ABI set read through abiFiles (human/wallet/attestor/internal/policy/evm/decode.go:28, human/wallet/attestor/internal/policy/evm/decode.go:53) so PrecompileNames (human/wallet/attestor/internal/policy/evm/decode.go:69) lists both."
do_2 = "Map both names to their addresses in PrecompileAddress (human/wallet/attestor/internal/policy/evm/decode.go:78) and IsPrecompile (human/wallet/attestor/internal/policy/evm/decode.go:83), so DecodeCalldata (human/wallet/attestor/internal/policy/evm/decode.go:200) resolves send, draw, payExact, issueGrant and the escrow, budget, stream and service selectors."
do_3 = "Write abi/layerxledger.json and abi/layerxpay.json from the frozen construct ABIs; decodeMethod (human/wallet/attestor/internal/policy/evm/decode.go:238) and orderedArgs (human/wallet/attestor/internal/policy/evm/decode.go:260) need no change for these tuples."
do_4 = "Extend TestDecodeCalldataForEachPrecompile (human/wallet/attestor/internal/policy/evm/evm_test.go:197) with one call per new precompile and assert the decoded method name and arguments."
do_5 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["DecodeCalldata", "PrecompileNames", "PrecompileAddress"]
touches = ["human/wallet/attestor/internal/policy/evm/decode.go", "human/wallet/attestor/internal/policy/evm/abi/layerxledger.json", "human/wallet/attestor/internal/policy/evm/abi/layerxpay.json"]
build_cmd = "cd human/wallet/attestor && go build ./..."
verify_cmd = "cd human/wallet/attestor && go test -count=1 ./internal/policy/evm/... -run TestDecodeCalldataForEachPrecompile"
gate_kind = "existing"
planned_paths = ["human/wallet/attestor/internal/policy/evm/abi/layerxledger.json", "human/wallet/attestor/internal/policy/evm/abi/layerxpay.json"]
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark complete without the declared evidence."
path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to their current equivalents before the gate can run; historical references never authorize a duplicate implementation tree. Complete scoped path reconciliation without dropping acceptance criteria."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

