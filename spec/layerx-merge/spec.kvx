[task.0.90]
title = "Kernel idempotency entries carry a retention window"
status = "pending"
mode = "BUILD"
wave = 0
requires = []
reqs = ["11.3", "4.2"]
do_1 = "Idempotency entries carry an expiry: an entry older than a retention window counted in global sequence is pruned before a new key is staged, so the store at LXP_STATE_MAX_IDEMPOTENCY (include/layerx/lxp_state.h:15, 8192 entries) admits new keys instead of returning LXP_ERR_ARENA_EXHAUSTED (src/state/lxp_idempotency.c:107-108)."
do_2 = "A key replayed inside the window still returns the stored receipt; a key whose entry was pruned is admitted as a new activity. The commit check in src/protocol/lxp_module_ctx.c, which reads idempotency_count against the same bound, follows the pruned count."
do_3 = "Add vectors to tests/state/lxp_test_idempotency.c: fill to the bound, advance the global sequence past the window, admit a new key; replay inside the window returns the stored receipt."
symbols = ["lxp_idempotency_can_commit", "lxp_idempotency_commit_staged", "LXP_STATE_MAX_IDEMPOTENCY"]
touches = ["src/state/lxp_idempotency.c", "include/layerx/lxp_state.h", "src/protocol/lxp_module_ctx.c", "tests/state/lxp_test_idempotency.c"]
verify_cmd = "make test-idempotency"
