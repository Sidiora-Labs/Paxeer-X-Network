title = "Gateway EVM review, send and grant signing"
status = "pending"
mode = "BUILD"
wave = 5
requires = ["0.3", "1.6.1", "1.7.1", "8.4.1"]
reqs = ["8001.1", "8001.2", "8001.3", "8021.1", "8021.2", "8021.3", "8022.1", "8022.2", "8022.3", "8020.1", "8020.2", "8020.3", "7.4", "8.6", "10.2"]
