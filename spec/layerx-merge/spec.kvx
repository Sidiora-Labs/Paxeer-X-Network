do_3 = "GrantCapability executes sub-op 8: kind and actor checks (src/modules/governance/lxp_governance.c:505-516), grant_scope_validate (src/modules/governance/lxp_governance.c:457-490), duplicate LXP_SEQUENCE_REUSED (src/modules/governance/lxp_governance.c:522-523), store and events 0x7148, 0x7108, 0x7128 (src/modules/governance/lxp_governance.c:526-534)."
do_4 = "RevokeGrant executes sub-op 6 (src/modules/governance/lxp_governance.c:616-637): LXP_AUTH_SCOPE (src/modules/governance/lxp_governance.c:625-628), LXP_AUTH_REVOKED (src/modules/governance/lxp_governance.c:632), 41-byte record (src/modules/governance/lxp_governance.c:633), event 0x7106 (src/modules/governance/lxp_governance.c:634), REVOCATION bump (src/modules/governance/lxp_governance.c:636) and 0x7110 (src/modules/governance/lxp_governance.c:640); then it updates the stored LayerXScopeAuthorization epoch so isLive fails for older grants (src/state/lxp_authority.c:1141-1144)."
do_5 = "Every write first resolves the caller through the 0x1004 binding to the account-holder authority (include/layerx/lxp_authority.h:12) and refuses with LXP_PAUSED_SCOPE when Params.Paused is true."
do_6 = "Create modules/layerxauth/keeper/grants_test.go with TestSessionCanonical, TestSessionDuplicate, TestSessionSummary, TestCapabilityKind, TestCapabilityScope, TestCapabilityDuplicate, TestCapabilityEvents, TestRevokeRefusals, TestRevokeRecord, TestRevokeEpochCascade and TestGranteeMustBeBound, re-targeting tests/state/lxp_test_grants.c and tests/state/lxp_test_revocation.c."
