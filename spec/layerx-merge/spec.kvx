title = "Perps keeper binary, image and liquidation integration run"
reqs = ["3026.5"]
touches = ["platform/hosted/perps-keeper/src/main.rs", "platform/hosted/perps-keeper/Dockerfile", "integration_test/perps_liquidation/perps_liquidation_test.yaml"]
tests = ["integration_test/perps_liquidation/perps_liquidation_test.yaml"]
verification_contract = "python3 integration_test/scripts/runner.py integration_test/perps_liquidation/perps_liquidation_test.yaml"
do_1 = "Add platform/hosted/perps-keeper/src/main.rs: one loop per market reading getMarket, getPerpsPositions, getMargin and getOracle with the pending tag and passing due work from plan.rs to the Submitter."
do_2 = "Add platform/hosted/perps-keeper/Dockerfile in the shape of the feeder image (platform/hosted/feeder/src/main.rs:43)."
do_3 = "Add integration_test/perps_liquidation/perps_liquidation_test.yaml for integration_test/scripts/runner.py:1: create m1, open a long size 10 with margin 120, push price 60 through the feeder and assert the liquidation receipt, a funding accrual and an ADL fill."
do_4 = "Liquidations name the keeper DID main as liquidatorAccount (validate_liquidate src/modules/perps/lx_perps_dispatch.c:827)."
symbols = ["main", "run_market"]

[capability.3.12.2]
title = "Height gate for the v2 methods and versioned replay"
reqs = ["3039.1", "3039.3"]
touches = ["precompiles/layerxexchange/layerxexchange.go", "precompiles/layerxexchange/setup.go", "precompiles/layerxexchange/layerxexchange_test.go"]
tests = ["precompiles/layerxexchange/layerxexchange_test.go"]
verification_contract = "go test -count=1 ./precompiles/layerxexchange/ -run 'TestV2MethodsGatedByHeight|TestVersionedReplayBelowHeight'"
do_1 = "Add the activation height check to Execute (precompiles/layerxexchange/layerxexchange.go:198) refusing a v2 selector below the height with LXP_VERSION_UNSUPPORTED, in the shape of the custody height gate (modules/layerxcustody/keeper/keeper.go:42)."
do_2 = "Register the pre-activation implementation in the versions table of precompiles/layerxexchange/setup.go so blocks below the height replay with the earlier precompile (precompiles/setup.go:84)."
do_3 = "The height is set at activation rehearsal."
do_4 = "Add TestV2MethodsGatedByHeight and TestVersionedReplayBelowHeight to precompiles/layerxexchange/layerxexchange_test.go."
symbols = ["ActivationHeight", "TestV2MethodsGatedByHeight"]

[capability.3.12.3]
title = "End-to-end exchange v2 scenario"
reqs = ["3039.2", "3039.4"]
touches = ["integration_test/exchange_v2/exchange_v2_test.yaml"]
tests = ["integration_test/exchange_v2/exchange_v2_test.yaml"]
verification_contract = "python3 integration_test/scripts/runner.py integration_test/exchange_v2/exchange_v2_test.yaml"
do_1 = "Add integration_test/exchange_v2/exchange_v2_test.yaml for integration_test/scripts/runner.py:1 with a bring_up case: past the activation height markets are created with no migration step (modules/layerxexchange/keeper/genesis.go:13)."
do_2 = "The exchange_v2 case creates a perps market, pushes an oracle price, places two crossing orders, runs fundingTick, liquidates, creates a spot market and trades it, and buys on the launchpad, all from EVM transactions."
do_3 = "Each step asserts its receipt succeeded and the final balances equal the scripted values; the launchpad step reads getProtocolFees (precompiles/launchpad/launchpad.go:322)."
do_4 = "Activation is a bring-up at the activation height; no account-state migration is required."
symbols = ["exchange_v2", "bring_up"]

