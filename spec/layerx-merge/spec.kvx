verification_contract = "Each task of the family runs its own verify_cmd once, for example: go test -count=1 -run '^(TestNativeDepositCustodiesValueAndEmitsTheVaultLog|TestTokenDepositThroughThePointerMap|TestWithdrawalPaysOnceThroughThePrecompile|TestWithdrawalDelayAndRefusalsThroughThePrecompile|TestForcedExitThroughThePrecompile|TestDepositRootThroughThePrecompile|TestGasIsTheDocumentedFormula)$' ./precompiles/layerxcustody/"
do_1 = "`GetTransactionReceipt` at rpc/tx.go:106, which returns the EVM receipt map (status, gasUsed, logs) that the chain side of every comparison reads; the chain receipt is read here"
do_2 = "`decode_protocol` at agent/crates/layerx-wire/src/receipt.rs:730, which decodes the canonical ProtocolReceipt envelope that the signed receipt carries; signed receipts decode with the canonical envelope"
do_3 = "`lxp_ledger_receipt_build` at src/ledger/lxp_receipt.c:17, which builds the kernel receipt whose fields are compared with the chain receipt; the kernel receipt is the reference side"
do_4 = "`receipt_locator` at platform/hosted/authority/src/lib.rs:250, which derives the receipt locator from receipt bytes; re-pointed at the signed sequencer receipt; locators derive from the signed sequencer receipt"
symbols = ["GetTransactionReceipt", "decode_protocol", "lxp_ledger_receipt_build", "receipt_locator"]

