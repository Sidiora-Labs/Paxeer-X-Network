[contract_context.3.exchange_carried]
interface = "0x1015 keeps depositMargin(bytes32) payable, depositMarginToken(address,uint256,bytes32), withdrawMargin(bytes32,uint256) returns bool, placeOrder(bytes32,bytes32,uint8,uint256,uint256,uint8) returns (orderId, fillCount, remaining), cancelOrder(bytes32,bytes32) and intentNonce(address); requestSettlement and getIntent leave the ABI (precompiles/layerxexchange/layerxexchange.go:50-61, :219-277)."
storage = "Margin lives in bank balances of the D2 main and margin addresses (sdk/types/address/hash.go:63-66); the per-account nonce stays under the nonce key (modules/layerxexchange/keeper/keeper.go:101) and the intent records leave the store (modules/layerxexchange/keeper/keeper.go:89-143)."
errors = "Go-origin refusals are LXP_EXCHANGE_INVALID_MARKET, LXP_EXCHANGE_UNKNOWN_MARKET and LXP_EXCHANGE_NOT_MARGIN_ASSET (modules/layerxexchange/types/errors.go:8-19); kernel-origin refusals keep their kernel code as LXP_ text (precompiles/common/precompiles.go:53-66)."
events = "MarginDeposited without nonce, MarginWithdrawn, OrderPlaced with fill count and quantity, OrderCancelled; the request events leave (precompiles/layerxexchange/layerxexchange.go:63-67)."
gas = "Flat per method plus 3 or 30 gas per input byte (precompiles/common/precompiles.go:286-292, sdk/store/types/gas.go:353-356); below the activation height the current formula stays (precompiles/layerxexchange/layerxexchange.go:74-78)."
activation = "Each v2 method is switched on at the activation height as the custody keeper gates by height (modules/layerxcustody/keeper/keeper.go:42); a bring-up at the activation height; no account-state migration is required."
invariants = "Only depositMargin is payable (precompiles/layerxexchange/layerxexchange.go:208-211); delegatecall is refused (:205-206); withdrawMargin never releases below the locked margin (src/modules/perps/lx_perps_position.c:95-112)."

[contract_context.3.exchange_perps]
interface = "createPerpsMarket, setPerpsHalt, pushOracle(bytes,bytes), openPosition, increasePosition, closePosition, fundingTick, liquidate, adl and registerMargin map one to one onto the kernel perps activities 0x00060001-0x0006000c (src/modules/perps/lx_perps_dispatch.c:2037-2073)."
storage = "The kernel prefixes market:, oracle:, funding:, deficit:, order:, position: are kept inside the exchange store (src/modules/perps/lx_perps_state.c:10-14); the market record is 622 bytes (include/layerx/lx_perps.h:26)."
errors = "Refusals are the kernel codes, for example LXP_MARGIN_INSUFFICIENT (src/modules/perps/lx_perps_dispatch.c:688), LXP_UNAUTHORIZED_DEBIT (:601), LXP_MARKET_HALTED (:542) and LXP_ORACLE_SEQUENCE (:530)."
events = "PerpsMarketCreated, PerpsMarketHalted, OracleAccepted, OrderPlaced, OrderCancelled, PositionOpened, PositionIncreased, PositionClosed, FundingSettled, Liquidated and Deleveraged follow include/layerx/lx_perps.h:60-70."
gas = "createPerpsMarket 120000, setPerpsHalt 30000, pushOracle 60000, openPosition 80000, increasePosition 60000, closePosition 100000, fundingTick 60000, liquidate 150000, adl 300000, registerMargin 50000, each plus the per-byte term (precompiles/common/precompiles.go:286-292); final numbers set at activation rehearsal."
activation = "Perps state starts empty at the activation height; markets are created by transactions (src/modules/perps/lx_perps_dispatch.c:1767)."
invariants = "One position per DID per market (src/modules/perps/lx_perps_position.c:149-152); the book holds at most 256 orders and a match at most 8 fills (include/layerx/lx_perps.h:27, src/modules/perps/lx_perps_book.c:139); funding runs only from fundingTick (src/modules/perps/lx_perps_dispatch.c:2023-2029)."

[contract_context.3.exchange_spot]
interface = "createSpotMarket, placeSpotOrder, cancelSpotOrder and setSpotHalt map onto the spot activities 0x000A0001-0x000A0005 (src/modules/spot/lx_spot_dispatch.c:872-881)."
storage = "Spot markets, orders and books keep the kernel layout (src/modules/spot/lx_spot_state.c:135-278); escrow balances sit at the D2 addresses of lx_spot_escrow_id (src/modules/spot/lx_spot_market.c:22-35)."
errors = "Refusals are LXP_UNAUTHORIZED_DEBIT (src/modules/spot/lx_spot_dispatch.c:351), LXP_MARKET_ALREADY_EXISTS (:356), LXP_LENGTH_LIMIT (:360) and LXP_AGREEMENT_STATE for a market order with no fill (:641)."
events = "SpotMarketCreated, SpotOrderPlaced, SpotOrderCancelled, SpotMarketHalted and SpotMarketResumed follow include/layerx/lx_spot.h:32-36."
gas = "createSpotMarket 100000, placeSpotOrder 250000, cancelSpotOrder 50000, setSpotHalt 30000, plus the per-byte term (precompiles/common/precompiles.go:286-292)."
activation = "Spot state starts empty at the activation height; the 64-market cap applies from the first market (include/layerx/lx_spot.h:20)."
invariants = "Escrow equals the sum of resting order reservations per market (src/modules/spot/lx_spot_dispatch.c:652-669); spot has no settlement activity (src/modules/spot/lx_spot_dispatch.c:11-14)."

[contract_context.3.launchpad]
interface = "0x1017 keeps its methods (precompiles/launchpad/launchpad.go:46-69), drops protocolFeesPending from getConfig (:156-169) and adds getProtocolFees(address); the keeper gains PriceHistory beside the snapshot ring (modules/launchpad/types/math.go:17)."
storage = "Protocol fees move from the global key 0x03 (modules/launchpad/types/keys.go:38) to 0x03 plus denom per market."
errors = "Go errors carry LXP_LAUNCHPAD_<NAME> text (modules/launchpad/types/errors.go:8-36)."
events = "MarketCreated, Swap, FeeRecorded, FeeStrategyChanged, FeesClaimed, FeesBurned, AirdropExecuted, AirdropClaimed, LpRewardsExecuted and PauseToggled are unchanged (precompiles/launchpad/Launchpad.sol:71-80)."
gas = "The current per-method formula stays (precompiles/launchpad/launchpad.go:224-230)."
activation = "The major 2 ABI applies from the activation height; genesis export carries per-market fee entries (modules/launchpad/keeper/genesis.go:52)."
invariants = "owedQuote equals RealQuoteBalance plus AccumulatedFees plus AirdropBalance per market (modules/launchpad/keeper/invariants.go:20-27)."

[contract_context.3.agent_oracle]
interface = "0x0903 submitPrice(bytes32,int256,uint256), getValidatorPrice(bytes32) and aggregate(feeds) over the 0x1015 oracle store (src/modules/perps/lx_oracle_read.c:93-125)."
storage = "No store of its own; writes and reads go to 'oracle:'+market of the exchange (src/modules/perps/lx_perps_state.c:90, :105)."
errors = "LXP_AGENT_ORACLE_NOT_SIGNER when the caller key is not permitted (src/modules/perps/lx_oracle_intake.c:83), LXP_AGENT_ORACLE_PRICE, LXP_AGENT_ORACLE_CONFIDENCE, and LXP_UNKNOWN_FIELD for an absent record (src/modules/perps/lx_oracle_read.c:51)."
events = "submitPrice emits the exchange OracleAccepted event (include/layerx/lx_perps.h:62)."
gas = "aggregate 1000, submitPrice 30000, getValidatorPrice 3000, each plus the per-byte term (precompiles/common/precompiles.go:286-292)."
activation = "Registered in precompiles/setup.go at the activation height (precompiles/setup.go:84)."
invariants = "getValidatorPrice returns quorum 1 and observed_at in seconds from the committed struct (include/layerx/lx_oracle.h:86-92)."

[contract_context.3.feeder]
interface = "The feeder sends pushOracle(bytes,bytes) to 0x1015 as an EVM transaction (platform/hosted/feeder/src/lib.rs:614)."
storage = "The journal of submitted rounds stays (platform/hosted/feeder/src/lib.rs:506)."
errors = "A sender not bound to the oracle key is refused at startup; the chain refuses it with LXP_UNAUTHORIZED_ORACLE (src/modules/perps/lx_perps_dispatch.c:483)."
events = "Each accepted round yields one OracleAccepted log (include/layerx/lx_perps.h:62)."
gas = "pushOracle 60000 plus the per-byte term, paid through the gas station (precompiles/common/precompiles.go:286-292)."
activation = "The feeder switches transport at the activation height; the LNI input leaves (platform/hosted/feeder/src/main.rs:44-46)."
invariants = "Observation sequence strictly increases per market (src/modules/perps/lx_oracle_intake.c:150-152)."

[contract_context.3.perps_keeper]
interface = "The keeper sends fundingTick(bytes32), liquidate(bytes32,bytes32,bytes32) and adl(bytes32,bytes32[]) as EVM transactions (src/modules/perps/lx_perps_dispatch.c:790-876)."
storage = "The keeper holds no chain state; it reads getPerpsPositions with the pending tag (src/modules/perps/lx_perps_state.c:571-587)."
errors = "A liquidate naming another main account is refused with LXP_UNAUTHORIZED_DEBIT (src/modules/perps/lx_perps_dispatch.c:827)."
events = "Receipts carry FundingSettled, Liquidated and Deleveraged (include/layerx/lx_perps.h:68-70)."
gas = "fundingTick 60000, liquidate 150000, adl 300000 plus the per-byte term, sponsored through the gas station (precompiles/common/precompiles.go:286-292)."
activation = "The keeper starts after the activation height; there is no EndBlock driver (src/modules/perps/lx_perps_dispatch.c:2023-2029)."
invariants = "ADL candidates are submitted in ascending id order, at most 16 (src/modules/perps/lx_perps_command.c:458)."

[task.3.2.1]
title = "cgo bridge from modules/layerxexchange to the C perps and spot module interfaces"
status = "pending"
mode = "BUILD"
wave = 2
requires = ["1.1.12", "1.1.13", "1.2.9"]
reqs = ["1.4", "2.1", "2.2", "3012.4", "3033.1", "3033.2", "3033.4"]
capabilities = ["3.1.1"]
do_1 = "Add modules/layerxexchange/native/bridge.go with a cgo preamble linking the static library of the Makefile build target, in the pattern of wasm-runtime/internal/api/link_system.go:5-6 and wasm-runtime/internal/api/lib.go:5; it sits on the shared host shim of first-wave task 1.1 (lxp_module_ctx API include/layerx/lxp_module.h:105-167). New symbols: NewEngine, Engine.Perps, Engine.Spot, Engine.Call. After the change Go can call decode, validate and execute of one kernel iface per activity."
do_2 = "Add modules/layerxexchange/native/bridge.c exporting thin C wrappers over the three perps ifaces (lx_perps_module_iface, the tif iface and the margin-register iface, src/modules/perps/lx_perps_dispatch.c:2037, :2048, :2059) and the spot iface (src/modules/spot/lx_spot_dispatch.c:872-881). New symbol lxx_bridge_call(activity_type, payload, ctx) returns the lxp_result code unchanged so Go maps it one to one."
do_3 = "Back lxp_ctx_kv_get, lxp_ctx_kv_put and lxp_ctx_kv_iter with the exchange KVStore through the shim callbacks, keeping the kernel key layout 'market:', 'oracle:', 'funding:', 'deficit:', 'order:', 'position:' (src/modules/perps/lx_perps_state.c:10-14) and the ascending iteration order of lxp_ctx_kv_iter (src/protocol/lxp_module_ctx.c:1809). After the change two calls on different markets touch disjoint keys."
do_4 = "Keep the kernel epoch hooks as no-ops (lx_perps module_epoch src/modules/perps/lx_perps_dispatch.c:2023-2029, spot epoch src/modules/spot/lx_spot_dispatch.c:858-864) and register no EndBlock driver; funding, liquidation and ADL run only from transactions."
do_5 = "Route activity type 0x0006000c (LX_PERPS_ACTIVITY_MARGIN_REGISTER include/layerx/lx_perps.h:344) to the tif iface with abi version 3 as the genesis module table does (tests/test_genesis_module_table.c:725)."
do_6 = "Add modules/layerxexchange/native/bridge_test.go with TestPerpsIfaceThroughBridge (the perps_market_create vector from tests/fixtures/trading-payloads/vectors.json:1 decoded and executed with the C test outcome), TestPerMarketKeyIsolation, TestStoreBackedAssetState, TestNoEndBlockDriver and TestTifIfaceRegistersMarginRegister."
do_7 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
