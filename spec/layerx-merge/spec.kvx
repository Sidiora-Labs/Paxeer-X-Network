do_2 = "activity_id, activity_root and result_code come from the EVM response (modules/evm/types/tx.pb.go:83, :84; modules/evm/types/receipt.pb.go:111, :114)."
do_3 = "fee_charged and asset come from the fee path (modules/evm/keeper/feetoken.go:92-108; modules/evm/types/params.pb.go:470-475)."
