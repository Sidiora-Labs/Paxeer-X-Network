[resolution.13.31]
title = "Struct ABI only for computeClearing and scoreBatch"
contract = "0x0902 computeClearing (0x8397e9f8) and 0x0904 scoreBatch (0x1b1fba48) use tuple-array struct ABI only, one selector per method; the parallel-array form gets no selector."
applies_to = ["6.*", "13.3.12"]
source = "decision D31"

[resolution.13.32]
title = "submitPrice follows the exchange oracle rule"
contract = "0x0903 submitPrice admits a price only when the caller's 0x1004-bound key is in the market's permittedOracleKeys and an ed25519 observation signature by that key verifies, the same check as the exchange oracle intake (src/modules/perps/lx_oracle_intake.c:64)."
applies_to = ["6.*", "3.*", "13.4.7"]
source = "decision D32"

[resolution.13.33]
title = "TEE roots are the xweb attestor set"
contract = "0x0907 uses the xweb attestor set read through GetAttestorSet (modules/xweb/keeper/keeper.go:90) as its registered roots; no second registry exists."
applies_to = ["6.*", "5.*", "13.3.11"]
source = "decision D33"

[resolution.13.34]
title = "TEE signatures are 3 of 5 over secp256k1 keys"
contract = "0x0907 accepts an attestation only with threshold signatures, 3 of 5, by secp256k1 attestor keys from the registered roots."
applies_to = ["6.*", "13.3.11"]
source = "decision D34"

[resolution.13.35]
title = "draw is the seven-field typed receive at 0x101A"
contract = "layerxledger 0x101A exposes draw(bytes32 from, bytes32 assetId, uint128 amount, bytes32 grantId, uint64 receiverSequence, bytes32 idempotencyKey, bytes32 contextHash), the fields of lxp_receive (include/layerx/lxp_ledger.h:216-227) recorded against the payer grant (src/ledger/lxp_grant_store.c:123); the four-argument form is withdrawn from every client table."
applies_to = ["1.*", "5.*", "10.*", "13.3.7"]
