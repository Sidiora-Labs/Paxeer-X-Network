do_1 = "Edit Makefile:1257, :4171 (CheckpointRegistry, layerxanchor) away from the layerxAnchor 0x1014 checkpoint and guarantor surface: remove the build, test and qualification targets of the layerxAnchor 0x1014 checkpoint and guarantor surface; read finality from the block itself: the committed height and CometBFT commit, or eth_getBlockByNumber(\"finalized\"); a state root comes from the committed app hash with a per-key ICS23 proof at that height."
do_2 = "Edit Makefile:1256 (LayerXCustody) away from the layerxCustody deposit escrow and asset and deposit views: remove the build, test and qualification targets of the layerxCustody deposit escrow and asset and deposit views; funding a kernel sub-account is a bank send to the derived sub-account address; asset facts come from bank 0x1001 name, symbol, decimals and supply and from pointerview 0x100A."
do_3 = "Edit Makefile:237, :238, :1408, :2031, :2040, :2291 and 19 further matches in the file (layerx-guarantor, src/paxeer/) away from the Guarantor runtime: remove the build, test and qualification targets of the Guarantor runtime; validators commit the sequencer-proposed block, so the guarantor process, its secrets and its provisioning step are removed."
do_4 = "Edit Makefile:1394, :1398, :1399, :1400, :1405, :1443 and 48 further matches in the file (authority_replica, finality_authority, handover_history, layerx-handover) away from the Finality authority, evidence register, receipt authority, authority replica and sequencer handover: remove the build, test and qualification targets of the Finality authority, evidence register, receipt authority, authority replica and sequencer handover; handover becomes the pinned leader list with standby takeover on the sequencer WAL; the sequencer receipt key is a governed parameter read from chain state at the receipt height."
do_5 = "Edit Makefile:1122, :1127, :1128, :1171 (da_bundle, lxp_da_) away from the DA bundle build, chunk proofs and verified DA storage: remove the build, test and qualification targets of the DA bundle build, chunk proofs and verified DA storage; block data is the availability record; the DA build and storage are removed with the kernel daemon."
do_6 = "Edit Makefile:1027, :1035, :1036, :1045, :1075, :1406 and 5 further matches in the file (lxp_daemon_replica, lxp_replay, relay-archive, replica_ingest) away from the Replica, authority replica and relay archive: remove the build, test and qualification targets of the Replica, authority replica and relay archive; full and archive paxd nodes serve history; the standby follows the sequencer WAL; the relay archive entries are removed."
do_7 = "Edit Makefile:2111 (lxp_idempotency) away from the Kernel idempotency table: remove the build, test and qualification targets of the Kernel idempotency table; replay protection is the EVM account nonce plus the transaction hash; the hosted module drops its idempotency lookups."
do_8 = "Edit Makefile:998, :1003, :1004, :1006, :1011, :1012 and 15 further matches in the file (batch_publish, batch_seal, batch_wal) away from the Kernel batch seal, batch header roots, batch publish, batch WAL and kernel receipt signature: remove the build, test and qualification targets of the Kernel batch seal, batch header roots, batch publish, batch WAL and kernel receipt signature; the pinned sequencer proposes the block and signs the receipt; the node sequencer WAL replaces the batch WAL."
do_9 = "Edit Makefile:812, :813, :825, :836, :857, :869 and 3 further matches in the file (lx_oracle_adapter) away from the Unwired oracle adapter, oracle batch root, web adapter and web batch root: remove the build, test and qualification targets of the Unwired oracle adapter, oracle batch root, web adapter and web batch root; no batch header exists after the merge; the oracle encoders linked by the perps intake are kept."
do_10 = "Edit Makefile:3549, :3645, :3655 (fee_governance) away from the Fee-governance relay activity 0x00090008: remove the build, test and qualification targets of the Fee-governance relay activity 0x00090008; the fee schedule changes through a governance-authority MsgUpdateFeeSchedule on the chain."
do_11 = "Edit Makefile:84, :374, :375, :381, :382, :385 and 3 further matches in the file (replay-golden) away from the Kernel root replay golden: remove the build, test and qualification targets of the Kernel root replay golden; the replay golden and its targets are removed with the batch seal and replica; host determinism of the kept C modules is covered by the host determinism test."
do_12 = "Edit Makefile:2297, :2540, :3879 (layerx-custody-proof) away from the Custody credit and light client: remove the build, test and qualification targets of the Custody credit and light client; kernel balances are bank balances of derived sub-accounts, so no cross-domain credit exists; custodyproof/verify.go stays as the commit and header verifier."
do_13 = "Edit Makefile:172, :292, :310, :1397, :1466, :1467 and 50 further matches in the file (_lni, lni, lni_) away from the LNI transport: remove the build, test and qualification targets of the LNI transport; writes are eth_sendRawTransaction through the unified router and reads are eth_call on the precompile views or gRPC queries at a height."
do_14 = "Edit Makefile:28 (checkpoint-settlement.json) away from the Settlement domain and export trust: remove the build, test and qualification targets of the Settlement domain and export trust; offline exports carry chain id 125 and the validator set at the height instead of a settlement domain."
do_15 = "Edit Makefile:17, :3044, :3050, :3053 (wire-differential) away from the Activity wire codec and its C differential: remove the build, test and qualification targets of the Activity wire codec and its C differential; encode the operation as an EIP-1559 transaction with the existing RLP encoder; the differential runs against go-ethereum types."
do_16 = "Edit Makefile:3609, :3611, :3623, :3626 (paxai-storage-keeper) away from the paxai-storage-keeper: remove the build, test and qualification targets of the paxai-storage-keeper; no reservation is needed; historical availability comes from archive nodes."
do_17 = "Edit Makefile:2292, :2335, :2369, :2387, :4121, :4137 (layerx-explorer-index, layerx-human-movement-provider, layerx-paxeer-client) away from the Human two-domain crates and journeys: remove the build, test and qualification targets of the Human two-domain crates and journeys; remove the deposit, withdraw, exit and binding hops; balances come from bank state and the explorer pages are the native explorer pages."
do_18 = "Edit platform/Makefile.inc:171 (relay-archive) away from the Replica, authority replica and relay archive: remove the build, test and qualification targets of the Replica, authority replica and relay archive; full and archive paxd nodes serve history; the standby follows the sequencer WAL; the relay archive entries are removed."
do_19 = "Edit platform/Makefile.inc:134 (settlement-domain) away from the Settlement domain and export trust: remove the build, test and qualification targets of the Settlement domain and export trust; offline exports carry chain id 125 and the validator set at the height instead of a settlement domain."
do_20 = "Edit tools/paxeer-x/build/104.30.2.mk:25 (checkpoint-settlement.json) away from the Settlement domain and export trust: remove the checkpoint-settlement document from the input set."
