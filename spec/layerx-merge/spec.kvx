[contract_context.7.sequencer]
interface = "Sequencer mode of paxd: execute at receipt, sign the receipt with the host receipt key, propose blocks in receipt order checked in ProcessProposal (node/app.go:1457)."
reads = "All committed state plus its open speculative state; pending reads for others are served from that state through the RPC context hook (node/app.go:2895), where the pending tag today maps to latest (rpc/utils.go:66)."
writes = "One block per height in receipt order with MsgSequenceBatch as transaction 0; raw transactions arrive through the send path (rpc/send.go:76)."
signing_key = "Validator consensus key loaded by the privval file loader (consensus/privval/file.go:233) and one separate ed25519 receipt key per host published in ReceiptKeys (D15)."
liveness = "Every write path stops without it; the standby proposes at round 1 after one consensus round of delay. Service entry point: node/app.go:1457."
failure = "A block out of receipt order is refused in ProcessProposal (node/app.go:1457) and alerted; a WAL tail missing on both hosts is excluded by synchronous replication."
evidence = "MsgSequenceBatch per block with lastSeq, lastSeqHash and ReceiptKeys stored by the sequencer module; the kernel sequencer route (platform/hosted/core/src/main.rs:1645) retires."
monitoring = "Sequencer readiness for primary and standby and receipt-order divergence replace the kernel readiness alert (tools/ops/monitoring/rules.yml:56)."

