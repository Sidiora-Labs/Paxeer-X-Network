[capability.6.1.1]
title = "layerxagent common package: errors, guards, height gate and gas table"
reqs = ["6001.1", "6001.2", "6001.3", "6001.4"]
touches = ["precompiles/layerxagent/common/common.go", "precompiles/layerxagent/common/gas.go", "precompiles/layerxagent/common/common_test.go"]
tests = ["precompiles/layerxagent/common/common_test.go"]
verification_contract = "go test -count=1 ./precompiles/layerxagent/common/"
do_1 = "Add package precompiles/layerxagent/common with the A.0 error code constants (LXP_PRECOMPILE_INPUT_TOO_SHORT, LXP_PRECOMPILE_UNKNOWN_METHOD, LXP_PRECOMPILE_ARG_COUNT, LXP_PRECOMPILE_NON_PAYABLE, LXP_PRECOMPILE_NO_CONTEXT) mapped from the generic errors at precompiles/common/precompiles.go:281, precompiles/common/precompiles.go:213, precompiles/common/precompiles.go:221 and precompiles/common/precompiles.go:125 so a short input, a wrong argument count, value on a nonpayable method and a missing context each revert with their named code."
do_2 = "Add GuardWrite(ctx, readOnly, isDelegate) in precompiles/layerxagent/common/common.go that returns LXP_AGENT_READ_ONLY for a static context and LXP_AGENT_DELEGATECALL for a delegatecall, mirroring the refusal at precompiles/layerxexchange/layerxexchange.go:206; every write method of 0x0905 and 0x0906 calls it before decoding."
do_3 = "Add HeightGate(ctx) that refuses execution below the merge plan height with the IsUpgradeActiveAtHeight pattern at modules/layerxcustody/keeper/keeper.go:42; the plan name is set at activation rehearsal."
do_4 = "Add MethodGas(selector, inputLen) in precompiles/layerxagent/common/gas.go returning the D2 table values (read 1000 + 3/byte, write 2000 + 30/byte, heavy surcharges 6000, 25000, 30000, 46000, 4000) and UnknownMethodCallGas (precompiles/common/precompiles.go:22) for an unknown selector, replacing DefaultGasCost (precompiles/common/precompiles.go:286-292) for these precompiles."
do_5 = "Wrap every executor with WithRevertReasons (precompiles/common/precompiles.go:53) so Go-origin errors surface as Error(string) LXP_AGENT_<FN>_<NAME>: <message>."
symbols = ["GuardWrite", "HeightGate", "MethodGas", "ErrUnknownMethod", "ErrDelegatecall", "ErrReadOnly"]

[capability.6.1.2]
title = "orob 0x0901 precompile"
reqs = ["6002.1", "6002.2", "6002.3"]
touches = ["precompiles/layerxagent/orob/orob.go", "precompiles/layerxagent/orob/orob_test.go"]
tests = ["precompiles/layerxagent/orob/orob_test.go"]
verification_contract = "go test -count=1 ./precompiles/layerxagent/orob/"
do_1 = "Add precompiles/layerxagent/orob/orob.go with ResolveOffset implementing oraclePrice x (10000 + offsetBps) / 10000 with big.Int Quo (truncation toward zero), guarded by the A.0 price and offset checks; the method is found through MethodById (precompiles/common/precompiles.go:68-80)."
do_2 = "Add ResolveOffsetBatch looping ResolveOffset over at most the batch cap and returning int256[]; the cap check precedes any arithmetic."
do_3 = "Add ToOffset computing (abs - oracle) x 10000 / oracle and range-checking the result against int16 before packing, so an out-of-range result reverts with LXP_AGENT_OVERFLOW."
do_4 = "Charge read gas through MethodGas (pattern precompiles/common/precompiles.go:286-292) and emit no events; the precompile is pure and keeps no store."
do_5 = "The ABI is taken from the frozen interface and matches the gateway address map entry orob at human/wallet/gateway/src/precompiles.ts:18."
symbols = ["ResolveOffset", "ResolveOffsetBatch", "ToOffset", "OrobPrecompile"]

[capability.6.1.3]
title = "clearing 0x0902 precompile"
reqs = ["6003.1", "6003.2", "6003.3"]
touches = ["precompiles/layerxagent/clearing/clearing.go", "precompiles/layerxagent/clearing/clearing_test.go"]
tests = ["precompiles/layerxagent/clearing/clearing_test.go"]
verification_contract = "go test -count=1 ./precompiles/layerxagent/clearing/"
do_1 = "Add precompiles/layerxagent/clearing/clearing.go with ComputeClearing decoding the (int16 offsetBps, uint128 size)[] buy and sell tuples of the struct ABI (decision.31) through MethodById (precompiles/common/precompiles.go:68-80)."
do_2 = "Collect the unique offsets of both sides ascending as candidate levels; for each level sum buy size at offsets >= level and sell size at offsets <= level and keep min(demand, supply)."
do_3 = "Select the lowest level among the levels with maximal volume, compute its price with orob ResolveOffset and return (clearingOffsetBps, clearingPrice, matchedVolume); return (0, oraclePrice, 0) on an empty side or no cross."
do_4 = "Apply the batch cap and the price check before the loop and charge the heavy class 6000 + 3/byte through MethodGas (pattern precompiles/common/precompiles.go:286-292)."
do_5 = "Keep the precompile pure: it never reads or writes the 0x1015 spot book (decision.22), and the address entry clearing at human/wallet/gateway/src/precompiles.ts:19 stays unchanged."
symbols = ["ComputeClearing", "ClearingPrecompile", "clearingOrder"]

[capability.6.1.4]
title = "pofq 0x0904 precompile"
reqs = ["6004.1", "6004.2", "6004.3"]
touches = ["precompiles/layerxagent/pofq/pofq.go", "precompiles/layerxagent/pofq/pofq_test.go"]
tests = ["precompiles/layerxagent/pofq/pofq_test.go"]
verification_contract = "go test -count=1 ./precompiles/layerxagent/pofq/"
do_1 = "Add precompiles/layerxagent/pofq/pofq.go with ScoreFill clamping at zero and range-checking the result against uint256 before packing (LXP_AGENT_OVERFLOW); method lookup through MethodById (precompiles/common/precompiles.go:68-80)."
do_2 = "Add ScoreBatch over the struct tuples (int256 fillPrice, int256 oraclePrice, uint128 size)[] with the batch cap, returning (0, 0) on zero total size."
do_3 = "Add UpdateRollingScore with the decay check first, the w formula in big.Int and updatedWeight = w / 10000 so weights stay bounded across fills."
do_4 = "Charge read gas 1000 + 3/byte through MethodGas (pattern precompiles/common/precompiles.go:286-292); the oracle price comes from the caller (0x1015 committed price, src/modules/perps/lx_oracle_read.c:93), never read by 0x0904."
symbols = ["ScoreFill", "ScoreBatch", "UpdateRollingScore", "PofqPrecompile"]

[capability.6.1.5]
title = "scheduler 0x0905 precompile methods and views"
reqs = ["6005.1", "6005.2", "6005.3"]
touches = ["precompiles/layerxagent/scheduler/scheduler.go", "precompiles/layerxagent/scheduler/scheduler_test.go"]
tests = ["precompiles/layerxagent/scheduler/scheduler_test.go"]
verification_contract = "go test -count=1 ./precompiles/layerxagent/scheduler/"
do_1 = "Add precompiles/layerxagent/scheduler/scheduler.go with Schedule validating target, callData cap, horizon (MaxScheduleHorizon 2,592,000) and deposit (MinDepositFactor 2), escrowing msg.value in the keeper and returning the next job id; write guards through GuardWrite (refusal pattern precompiles/layerxexchange/layerxexchange.go:206)."
do_2 = "Add Cancel (creator only, full refund, JobCancelled) and Reschedule (creator only, horizon and past-block checks, JobRescheduled) over the keeper store."
do_3 = "Add views GetJob (zero Job when absent) and Pending (bounded by MaxJobsPerCreator 1024) matching the ABI the gateway uses at human/wallet/gateway/src/precompiles.ts:50."
do_4 = "Charge schedule 25000 + 30/byte and cancel or reschedule 20000 + 30/byte through MethodGas; views use the read class (pattern precompiles/common/precompiles.go:286-292)."
do_5 = "Emit JobScheduled, JobCancelled and JobRescheduled with the topic0 values 0xf946d531, 0xa80c76c4 and 0xb060fcde from the frozen event signatures."
symbols = ["Schedule", "Cancel", "Reschedule", "GetJob", "Pending", "SchedulerPrecompile"]

[capability.6.1.6]
title = "layerxagent keeper: scheduler store and end-block hook"
reqs = ["6006.1", "6006.2", "6006.3"]
touches = ["modules/layerxagent/keeper/keeper.go", "modules/layerxagent/keeper/scheduler.go", "modules/layerxagent/keeper/scheduler_test.go"]
tests = ["modules/layerxagent/keeper/scheduler_test.go"]
verification_contract = "go test -count=1 ./modules/layerxagent/keeper/"
do_1 = "Add modules/layerxagent/keeper/keeper.go with the store key, params (MaxJobsPerCreator 1024, MaxScheduleHorizon 2,592,000, MinDepositFactor 2, per-block and per-job caps set at activation rehearsal) and the height gate pattern of modules/layerxcustody/keeper/keeper.go:42."
do_2 = "Add modules/layerxagent/keeper/scheduler.go with SetJob, DeleteJob, IterateDue(height) over the due prefix in (block, id) big-endian order, and the creator index used by Pending."
do_3 = "Add EndBlocker running due jobs in id order in a cached context as the creator, charging gasUsed x baseFee to the fee collector and refunding the rest; a refund failure halts nothing and is recorded in JobFailed."
do_4 = "Emit JobExecuted and JobFailed as Cosmos typed events (no transaction receipt exists at end block) with the reason truncated to the cap."
do_5 = "Register the keeper with the app module manager beside the custody keeper whose height gate is at modules/layerxcustody/keeper/keeper.go:42."
symbols = ["Keeper", "SetJob", "IterateDue", "EndBlocker", "EventJobExecuted", "EventJobFailed"]

