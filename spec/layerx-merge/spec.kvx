qualification = "UNRUN"

[req.13005]
title = "Fee floor and fee-token rate age"
ac_1 = "The global MinimumFeePerGas (modules/evm/types/params.go:81), today DefaultMinFeePerGas of 1 gwei (modules/evm/types/params.go:52), is set at or below 0.067 gwei and no sender-class param is added."
ac_2 = "MaxFeeTokenRateAge (modules/evm/types/params.go:16) is raised by governance and read at modules/evm/keeper/params.go:331-336."
