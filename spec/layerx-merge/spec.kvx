do_1 = "Add function send(address fromAddress, address toAddress, string denom, uint256 amount, bytes32 contextHash) returns (bool) and event LayerXReceipt(address indexed from, address indexed to, string denom, uint256 amount, bytes32 contextHash) to precompiles/bank/Bank.sol beside the four-argument send at precompiles/bank/Bank.sol:12-17, and the matching entries to precompiles/bank/abi.json."
do_2 = "In NewPrecompile record the go-ethereum overload name send0 and its id 0x2e4c85ac in the method loop (precompiles/bank/bank.go:77-96), and route it in Execute (precompiles/bank/bank.go:106-132) to sendWithContext."
do_3 = "sendWithContext reuses the checks of send (precompiles/bank/bank.go:134-185): readOnly (precompiles/bank/bank.go:135-137), payable (precompiles/bank/bank.go:138-140), empty denom (precompiles/bank/bank.go:145-148), pointer caller (precompiles/bank/bank.go:149-152) and the zero-amount short-circuit (precompiles/bank/bank.go:154-158)."
do_4 = "A nonzero amount moves coins through the same MsgSend path (precompiles/bank/bank.go:168-181) and then emits LayerXReceipt with topic0 0x4b11729a809ec729868d9ba54f3192aa4179fe63668e9f742aa9b25de21de65f through pcommon.EmitEVMLog (precompiles/common/evm_events.go:16)."
do_5 = "Opt bank into the reason path of task 0.1 at the NewDynamicGasPrecompile call (precompiles/bank/bank.go:98), gated on the merge plan; refusals map to LXP_NON_CANONICAL for staticcall and payable misuse and to LXP_ASSET_PAUSED for a paused denom."
do_6 = "Add TestSendContextHashSelector to precompiles/bank/bank_test.go asserting method send0 has id 0x2e4c85ac and the four-argument send keeps 0x5c05961b (precompiles/bank/Bank.sol:12-17)."
do_7 = "Add TestSendContextHashRefusals and TestSendContextHashZeroAmount covering staticcall, payable, empty denom, non-pointer caller (precompiles/bank/bank.go:135-152) and the zero-amount short-circuit (precompiles/bank/bank.go:154-158)."
do_8 = "Add TestSendContextHashReceipt asserting balances and one LayerXReceipt log with topic0 0x4b11729a809ec729868d9ba54f3192aa4179fe63668e9f742aa9b25de21de65f, and extend TestRun (precompiles/bank/bank_test.go:47) to assert the four-argument send still emits no log."
do_9 = "Add TestSendContextHashSubAccount sending from address.Module(\"layerx\", id) (sdk/types/address/hash.go:63-66) through MsgSend (sdk/x/bank/keeper/msg_server.go:28-60)."
do_10 = "Add TestSendReasonsFromPlanHeight asserting Error(string) LXP_NON_CANONICAL at the merge plan height and empty revert data one height below (precompiles/common/precompiles.go:179-185)."
symbols = ["send0", "sendWithContext", "LayerXReceipt", "TestSendContextHashSelector", "TestSendContextHashRefusals", "TestSendContextHashZeroAmount", "TestSendContextHashReceipt", "TestSendContextHashSubAccount", "TestSendReasonsFromPlanHeight"]

