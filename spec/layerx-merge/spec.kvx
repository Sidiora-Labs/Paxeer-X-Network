[contract_context.6.agent_functions]
source = "spec/layerx-merge/contracts/agent-functions.md sections A to F; the A section heading sits at spec/layerx-merge/contracts/agent-functions.md:15 and the D2 gas table at spec/layerx-merge/contracts/agent-functions.md:125."
interface = "Seven precompiles 0x0901, 0x0902 and 0x0904 to 0x0908 with embedded ABIs; 0x0903 is served by the trading feature. Every write refuses delegatecall in the pattern of precompiles/layerxexchange/layerxexchange.go:206 and staticcall in the pattern of precompiles/addr/addr.go:157-158."
storage = "Only the scheduler and the streams keep state: scheduler jobs and deposits live in the layerxagent module store; streams live in the layerxpay 0x101B stream keeper (decision.29). The other five are pure functions over calldata and chain views."
errors = "Every refusal is Error(string) with an LXP_ code from the A.0 table, returned through WithRevertReasons (precompiles/common/precompiles.go:53)."
events = "Logs follow the C section topics and are emitted with EmitEVMLog (precompiles/common/evm_events.go:16) in execution order."
gas = "Fixed per-method gas from the D2 table (decision.30); unknown selectors charge UnknownMethodCallGas (precompiles/common/precompiles.go:22) as RequiredGas does at precompiles/common/precompiles.go:68-77; each class follows the DefaultGasCost pattern (precompiles/common/precompiles.go:286-292): read 1000 + 3 per input byte, write 2000 + 30 per input byte, heavy adds a fixed surcharge."
activation = "All seven addresses are registered in the custom precompile map (precompiles/setup.go:67) and served from the merge plan height through the activation list that replaces CustomPrecompileActivation (modules/evm/keeper/keeper.go:195); before the height the addresses hold no code."
activation_gate = "Each write also checks the height gate in the pattern of IsUpgradeActiveAtHeight (modules/layerxcustody/keeper/keeper.go:42) so a replayed block below the height refuses identically on every node."
tee_roots = "The 0x0907 roots are the xweb attestor set with a 3-of-5 secp256k1 threshold (decision.33 and decision.34); this supersedes the contract text that names the embedded-wallet set, whose threshold is 3 (human/wallet/attestor/internal/tss/ecdsa/ecdsa.go:26)."
invariants = "Same input gives the same output and gas on every node; no precompile reads wall-clock time; scheduler execution order is job id order at end block; stream balances never go below zero."
parity = "The E section vectors of spec/layerx-merge/contracts/agent-functions.md are the parity source; each package test carries them verbatim."

[contract_context.6.clients]
source = "spec/layerx-merge/contracts/clients.md sections A to F."
operations = "Operations O1-O79 are keyed in platform/sdk/conformance/operations.json; writes are EIP-1559 transactions on eth_sendRawTransaction followed by pax_sequencerReceipt, reads are eth_call, eth_getProof and abci_query through the router."
identity = "An agent EVM address is bound to its DID with bindLayerX; the binding is read with GetLayerXDid (modules/evm/keeper/layerx_binding.go:18) and removed with UnbindLayerX (modules/evm/keeper/layerx_binding.go:92); the unified account view is getUnifiedAccount (precompiles/addr/addr.go:437) and account ids come from DeriveAccountID (layerxproof/codec/state.go:360)."
bind_builder = "One bind builder serves every client: sign_bind_transaction (agent/crates/layerx-client/src/account_binding.rs:200); the V6 vector fixes chain id 125 and nonce 0."
receipt = "Receipt verification walks rungs: the sequencer signature over the receipt checked against ReceiptKeys by height (the check of verify_sequencer_signature, agent/crates/layerx-proof/src/receipt.rs:631), then receipt inclusion, then a Comet commit with more than 2/3 voting power in the manner of verifyEntry (custodyproof/verify.go:173)."
fees = "Fees are charged in the fee token chosen by the payer (GetFeeTokenCharge, modules/evm/keeper/feetoken.go:92); projections carry the denom beside the amount."
switch_off = "Every lx_ method name L1-L26 returns -32601 (decision.17); the gateway ingress point is the relay refusal at platform/hosted/gateway/src/paxeer.rs:172 and the CLI filter refusal is at platform/cli/src/rpc.rs:172-176."
conformance = "Suites C1-C11 run vectors V1-V9: receipted positive, receipted revert, refusals, committed, portable v2, bind, sponsored, switch-off and idempotent replay; C10 moves the x402 documents to txHash, rung names and the eip155 network id."

[contract_context.6.services_s26]
source = "spec/layerx-merge/contracts/services.md section S26 (agentd and agentd-host)."
payer = "The agentd-host payer ProductionWebPayer (agent/crates/layerx-agentd-host/src/payer.rs:45) sends issueGrant and payExact transactions in place of grant and pay (agent/crates/layerx-agentd-host/src/payer.rs:357, agent/crates/layerx-agentd-host/src/payer.rs:393)."
signer = "The payer key is held by the embedded-wallet attestor set (decision.26) under policy kind lx_grant (human/wallet/attestor/internal/policy/kinds.go:16) with threshold 3 (human/wallet/attestor/internal/tss/ecdsa/ecdsa.go:26)."
receipts = "The pinned sequencer key check (agent/crates/layerx-agentd-host/src/payer.rs:299) is replaced by ReceiptKeys lookup by height."
agentd = "agentd keeps its daemon role: prepare, sign, outbox, idempotency and finality tracking, all on EVM transactions; no daemon-local state is authoritative over chain state."

