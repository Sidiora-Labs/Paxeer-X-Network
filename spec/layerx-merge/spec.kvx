title = "Denom pause message, store, handler and paused mint and burn"
reqs = ["1008.1", "1008.4", "1008.2", "1008.5"]
touches = ["api/tokenfactory/tx.proto", "modules/tokenfactory/types/tx.pb.go", "modules/tokenfactory/types/errors.go", "modules/tokenfactory/types/msgs.go", "modules/tokenfactory/types/codec.go", "modules/tokenfactory/types/msgs_test.go", "modules/tokenfactory/keeper/pause.go", "modules/tokenfactory/types/keys.go", "modules/tokenfactory/keeper/pause_test.go", "modules/tokenfactory/keeper/msg_server.go", "modules/tokenfactory/keeper/bankactions.go", "modules/tokenfactory/keeper/denom_pause_test.go"]
