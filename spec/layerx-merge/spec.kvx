scope = "Retire every two-domain component of the Paxeer X Network once the kernel is hosted on the chain: the retired precompile executors answer LXP_MODULE_DISABLED at their registered addresses, guarantor bonds and challenge deposits are returned at the merge plan height, the anchor store is deleted at a later step, every live caller is re-targeted to its one-domain replacement, the retired trees and their manifest entries are deleted, and one retired-caller check plus an activation rehearsal prove that no live caller remains."
requirements = ["11001", "11002", "11003", "11004", "11005", "11006", "11007", "11008", "11009", "11010", "11011", "11012", "11013", "11014", "11015", "11016", "11017", "11018", "11019", "11020", "11021", "11022", "11023", "11024", "11025", "11026", "11027", "11028", "11029", "11030", "11031", "11032", "11033", "11034", "11035", "11036", "11037", "11038", "11039", "11040", "11041", "11042", "11043", "11044", "11045", "11046", "11047", "11048", "11049", "11050", "11051", "11052"]
completion_task = "11.7.45"

[req.11001]
title = "Retire the layerxVerify 0x1012 retired executor"
ac_1 = "layerxVerify at 0x0000000000000000000000000000000000001012 keeps its registration (precompiles/setup.go:83) and all five methods return Error(string) LXP_MODULE_DISABLED (include/layerx/lxp_result.h:42) at or above the merge plan height through the gate pattern of modules/layerxcustody/keeper/keeper.go:42; it verifies kernel receipts, inclusion and state proofs on the chain, which only matters while the kernel keeps a second ledger (precompiles/layerxverify/layerxverify.go:10, :188; contracts/src/precompiles/ILayerXVerify.sol:4; precompiles/layerxverify/layerxverify_test.go:93)."
ac_2 = "Every live caller re-targets: drop the layerxVerify reference; after the plan height every method returns Error(string) LXP_MODULE_DISABLED, so the caller reads the committed header and an ICS23 proof through abci_query prove=true or eth_getProof instead; the replacement is at custodyproof/verify.go:260, modules/layerxcustody/keeper/keeper.go:42 and the first caller re-targeted is agent/crates/layerx-client/examples/go_verifier_vectors.rs:2."
ac_3 = "The retirement lands only after nothing; the executor stays registered at precompiles/setup.go so a call never succeeds empty; references inside the deleted trees, such as contracts/src/precompiles/ILayerXVerify.sol:4, precompiles/layerxverify/LayerXVerify.sol:4, leave with the deletion."
ac_4 = "After the retirement the retired-caller check finds no live non-test reference to layerxverify, ILayerXVerify outside the deleted trees across the 2 caller files, including platform/hosted/indexer/src/abi.rs:36, :732."

[req.11002]
title = "Retire the layerxAnchor 0x1014 checkpoint and guarantor surface"
ac_1 = "layerxAnchor at 0x0000000000000000000000000000000000001014 keeps its registration (precompiles/setup.go:83) and the twelve write methods (the nine reads stay served until the store-delete step) return Error(string) LXP_MODULE_DISABLED (include/layerx/lxp_result.h:42) at or above the merge plan height through the gate pattern of modules/layerxcustody/keeper/keeper.go:42; it anchors kernel batch roots onto the chain so the chain can trust kernel state held in a second ledger (precompiles/layerxanchor/layerxanchor.go:46, :189; contracts/src/precompiles/ILayerXAnchor.sol:4; precompiles/layerxanchor/layerxanchor_test.go:263)."
ac_2 = "Every live caller re-targets: read finality from the block itself: the committed height and CometBFT commit, or eth_getBlockByNumber(\"finalized\"); a state root comes from the committed app hash with a per-key ICS23 proof at that height; the replacement is at custodyproof/verify.go:260, rpc/block.go:257, modules/layerxcustody/keeper/keeper.go:42 and the first caller re-targeted is Makefile:1257, :4171."
ac_3 = "The retirement lands only after the guarantor bond return at the activation height and the store-delete step that follows it; references inside the deleted trees, such as agent/crates/layerx-paxeer-verifier/src/contract.rs:9, cmd/layerx-guarantor/settlement.py:27, leave with the deletion."
ac_4 = "After the retirement the retired-caller check finds no live non-test reference to layerxanchor, ILayerXAnchor, ANCHOR_PRECOMPILE, PxAnchorHead outside the deleted trees across the 37 caller files, including agent/crates/layerx-proof/src/checkpoint.rs:183."

