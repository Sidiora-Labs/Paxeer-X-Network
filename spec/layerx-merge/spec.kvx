[task.0.3]
title = "Signed sequencer receipt returned immediately"
status = "done"
mode = "BUILD"
wave = 0
requires = ["0.2"]
reqs = ["3.1", "3.5", "9.2", "10.2", "10.4", "12.2", "9002.1", "9002.2", "9002.3", "9002.4", "9002.5", "9021.1", "9021.2", "9021.3", "9021.4", "9021.5", "9021.6", "9021.7", "9022.1", "9022.2", "9022.3", "9022.4", "9023.1", "9023.2", "9023.3", "9023.4", "9023.5", "9024.1", "9024.2", "9024.3", "9024.4", "9024.5"]
capabilities = ["9.2.1", "9.2.2"]
do_1 = "Encode the ProtocolReceipt v2 in node/sequencer/receipt.go (BuildReceipt) in the field order of agent/crates/layerx-wire/src/receipt.rs:190-220, version 2 (agent/crates/layerx-wire/src/limits.rs:12) and tag 0x5201 (agent/crates/layerx-wire/src/receipt.rs:10); seqHash = sha256(\"PAXEER/v1/sequence\\0\" || prevSeqHash || u64be(seq) || activity_id) and activity_id is the transaction hash (modules/evm/types/tx.pb.go:84)."
