[meta]
name = "LayerX merge into Paxeer X"
slug = "layerx-merge"
version = "1.0.0"
status = "draft"
goal = "Fold the LayerX kernel into the Paxeer X Network as one execution domain: every kernel capability works on the chain with the same semantics and outcomes, AI, trading and markets are native to the chain, and the proposer is the executor, so a transaction is executed at receipt, answered with a signed receipt and proposed in exactly that order."
scope = "One execution domain (paxd: Cosmos SDK, EVM, CosmWasm, OCC). Kernel C modules and the Rust program runtime hosted inside chain modules and precompiles; the sequencer node and its consensus rule at one activation height; components that existed only to join two domains retired behind a retired executor; off-chain services and clients re-pointed to the sequencer and chain state."
revision = "52b672ac4"
completion = "Every task verify_cmd passes at one revision, every acceptance criterion of req.1 to req.12 holds on that revision, and the activation goldens (bring-up at the activation height, guarantor bond return, receipt order equal to block order) pass on the merged candidate."

[decision.1]
title = "Kernel C modules and the Rust program runtime inside paxd"
value = "The kernel C modules and the Rust program runtime are hosted through cgo behind an lxp_module_ctx shim inside the chain keepers, conditional on the C-in-consensus determinism spike passing; the result of that spike is decided on its evidence, with no fallback fixed in advance."
basis = "Every kernel module already executes through an lxp_module_ctx execute function (src/modules/programs/registration.c:164, src/modules/programs/deploy.c:485) and the node already links cgo code (wasm-runtime/version_cgo.go:1)."
affects = ["modules/layerxledger", "modules/layerxpay", "modules/layerxauth", "modules/layerxprograms", "modules/layerxexchange", "0x101A", "0x101B", "0x101C", "0x101D", "0x1015"]

[decision.2]
title = "Kernel account and margin model"
value = "Kernel accounts become derived bank addresses per DID and sub-account suffix, and trading margin uses the same namespace."
basis = "Kernel accounts carry a sub-account kind and parent account id (include/layerx/lxp_genesis.h:148-149), and bank addresses make every balance visible to bank, the explorer and ERC-20 pointers."
affects = ["0x1001 bank", "0x1015 layerxexchange", "0x101A layerxledger", "explorer balance views"]

[decision.3]
title = "Home of session keys and delegated authorities"
value = "Session keys and delegated capabilities are authz grants carrying a LayerX-scope Authorization that covers kernel and program calls, keeping all eight authority kinds."
basis = "The kernel defines eight authority kinds including SESSION_KEY and DELEGATED_CAPABILITY (include/layerx/lxp_authority.h:11-19), and authz gives one grant path for all of them."
affects = ["0x101C layerxauth", "sdk/x/authz", "0x101A", "0x101B", "0x101D"]

[decision.4]
title = "Custody claims and guarantor bonds at the activation height"
value = "Not applicable: activation is a bring-up at a height, no account-state migration; the activation handler only returns every posted guarantor bond and open challenge deposit."
basis = "The kernel holds no account state to carry over, so no claim settlement step exists."
affects = ["0x1013 layerxCustody", "0x1014 layerxAnchor", "activation handler"]

[decision.5]
title = "Kernel balances without an addr binding at activation"
value = "Not applicable: activation is a bring-up at a height, no account-state migration; the activation handler creates no claim record and no held balance."
basis = "With no account state to carry over there is no unbound balance to place."
affects = ["0x1004 addr", "activation handler"]

[decision.6]
title = "Precompile error encoding"
value = "Every new precompile reverts with Error(string) carrying the prefix LXP_<code>, and addr 0x1004 and bank 0x1001 gain an opt-in reason path in the shared dynamic-gas precompile base so they return the same form."
basis = "The precompile framework returns Error(string) and already offers WithRevertReasons (precompiles/common/precompiles.go:51), so kernel result codes map to strings without a framework change elsewhere."
affects = ["0x1001", "0x1004", "0x1015", "0x1017", "0x1019", "0x101A", "0x101B", "0x101C", "0x101D", "0x0901-0x0908", "precompiles/common"]

[decision.7]
title = "Time semantics under the sequencer cadence"
value = "The receipt timestamp is fixed at pending-block open, AI and market height windows are re-tuned for the new cadence, and the fee-token rate age is raised by governance."
basis = "The kernel batch carries one timestamp per batch (include/layerx/lxp_batch.h:32) and the fee-token rate age is already a governance parameter (modules/evm/keeper/params.go:310), so no fork or codec change is needed."
affects = ["node/sequencer", "modules/evm params", "0x1018 feeToken", "0x101D AI and market guests", "0x1019 xweb TimeoutBlocks"]

[decision.8]
title = "Trading semantics where kernel and exchange differ"
value = "Order ids are chain-derived from (chain, caller, nonce), launchpad fees accumulate per market, market creation is permissionless with a self-named administrator, books keep capacity 256 with 8 fills per dispatch, and the spot settlement request stays refused as in the kernel."
basis = "Kernel caps are LX_PERPS_BOOK_CAPACITY 256 and LX_PERPS_DISPATCH_MAX_FILLS 8 (include/layerx/lx_perps.h:27, :34), and the single launchpad fee counter is written on every swap (modules/launchpad/keeper/swap.go:172)."
affects = ["0x1015 layerxexchange", "0x1017 launchpad", "agent SDK order API"]

[decision.9]
title = "Program fee versus gas"
value = "The program fee (metering times prices) is kept on top of near-zero gas."
basis = "Program fee outcomes in the existing program goldens stay unchanged (tests/programs/test_fee_governance.c)."
affects = ["0x101D layerxprograms"]

[decision.10]
title = "Paid search settlement and lxpay placement"
value = "Paid web search settles as one draw per request through layerxledger at 0x101A (the lxpay construct), at USD 0.001 per request, with the EVM minimum gas price at most 0.067 gwei for the draw sender class."
basis = "A per-request draw gives one receipt per paid request and keeps the x402 conformance suite (interop/specs/conformance/x402/payment-payload.json) unchanged."
affects = ["0x101A layerxledger", "modules/evm params", "x-websearch sidecar", "x402 seller"]

[decision.11]
title = "Program-origin web request terms"
value = "Program-origin (origin 2) web requests keep the kernel per-asset fee with any-amount, no-refund parity, carried as an origin-2 fee table in the xweb params."
basis = "Paid amounts and outcomes then match the kernel web intake (src/modules/web/lx_web_intake.c:510)."
affects = ["0x1019 xweb", "0x101D layerxprograms"]

[decision.12]
title = "Program-origin observation admission"
value = "Origin-2 observations admit with at most 16 signers and the kernel network id kept as an xweb param."
basis = "The kernel caps attestors at 16 (include/layerx/lx_web.h:29) while xweb signs with the EVM chain id (modules/xweb/keeper/fulfil.go:72), so keeping the kernel id leaves preimage vectors and attestor tooling unchanged."
affects = ["0x1019 xweb", "modules/xweb params", "x-websearch sidecar"]

[decision.13]
title = "Reference guest deployment"
value = "The interpreter, compute-lease market and AI market reference guests are deployed at the activation height through MsgDeploy by the chain operator, with expected code hashes."
basis = "The guests are ordinary programs (programs/crates/layerx-programs-interpreter, programs/crates/layerx-programs-market, programs/crates/layerx-programs-ai-market) and use the same deploy path and goldens as any program."
affects = ["0x101D layerxprograms", "activation runbook"]

[decision.14]
title = "Sponsorship path and per-identity budget home"
value = "Every sponsored agent write is an EIP-7702 executeSponsored batch through the gas station with one paymaster nonce, and per-identity budgets live in a gas-station ledger keyed by the DID resolved through addr 0x1004."
basis = "The sponsorship contract already exists (contracts/src/BatchCallAndSponsor.sol:135) and an on-chain budget would need an ante change (modules/evm/ante/fee.go:36), which is a fork."
affects = ["gas station", "BatchCallAndSponsor", "0x1004 addr", "agent SDK nonce handling"]

[decision.15]
title = "Sequencer receipt signing key"
value = "Receipts are signed by a separate ed25519 receipt key per sequencer host, distinct from the validator key and pinned in the authority service and the settle endpoint."
basis = "The existing verifier takes a pinned 32-byte ed25519 key (agent/crates/layerx-proof/src/receipt.rs:631), so SDK verifiers are reused unchanged."
affects = ["node/sequencer", "modules/sequencer ReceiptKeys", "authority service", "SDK verifiers"]

[decision.16]
title = "DID key rotation and the embedded-wallet ed25519 share"
value = "Application level, decided with the wallet feature; no task of this feature depends on it and addr 0x1004 gains no rotation or recovery method here."
basis = "Key rotation is an application-level matter of the wallet stack, not a chain design decision."
affects = ["0x1004 addr", "embedded wallet"]

[decision.17]
title = "Client-facing contract"
value = "Clients move to a clean break: agent-api major 2, write rungs submitted, receipted and committed, no same-nonce replacement, no pending receipts on eth_getTransactionReceipt, and lx_* ingress switched off at activation."
basis = "Major 1 is declared at agent/schema/agent-api/v1.kvx:3 and removing declarations requires a new major."
affects = ["agent SDKs", "gateway", "CLI", "x402 seller", "seller middleware", "explorer status UI", "wallet status UI"]

[decision.18]
title = "Sequencer consensus scope"
value = "One activation-height fork: BeginBlock(N+1) is fed the votes of N-1, a new modules/sequencer carries MsgSequenceBatch, and Leader() follows the pinned leader list."
basis = "Without the fork a transaction arriving while block N is in consensus waits for its commit, because BeginBlock reads the last commit votes (node/legacyabci/begin_block.go:61) and the leader is chosen by power (consensus/internal/consensus/types/round_state.go:422)."
affects = ["modules/sequencer", "node/sequencer", "consensus Leader()", "node/legacyabci BeginBlock", "activation height"]

[decision.19]
title = "Sequencer execution mode"
value = "The sequencer executes OCC micro-batches in receipt order, with the strictly sequential executor landed first and the switch to micro-batches made on measurement."
basis = "Sequential execution reuses DeliverTx (node/abci.go:169) and micro-batches reuse DeliverTxBatch with the OCC scheduler (node/abci.go:230)."
affects = ["node/sequencer executor"]

[decision.20]
title = "Legacy surfaces"
value = "layerxctl is kept as an operator EVM client, the program registry service becomes a read cache over the programs module, and the eight agent functions behind 0x0901-0x0908 are implemented as real precompiles, the first four re-specified from the earlier implementation."
basis = "The agent routes name 0x0901-0x0908 (human/wallet/gateway/src/precompiles.ts:18) while no precompile is registered there (precompiles/setup.go:67)."
affects = ["cmd/layerxctl", "program registry service", "0x0901-0x0908"]

[decision.21]
title = "layerxAnchor reads after the fold"
value = "layerxAnchor 0x1014 reads are served until every posted guarantor bond is returned, then the store is deleted and the retired executor remains at the address."
basis = "The address stays registered (precompiles/setup.go:83) so it never returns empty success."
affects = ["0x1014 layerxAnchor"]

[decision.22]
title = "Agent functions 0x0901-0x0904"
value = "orob, clearing, oracle and pofq are re-specified from the earlier implementation and implemented anew as real precompiles, keeping eight agent functions."
basis = "The routes exist (human/wallet/gateway/src/precompiles.ts:18-21) and the functions are specified in contracts/agent-functions.md section A.1."
affects = ["0x0901", "0x0902", "0x0903", "0x0904"]

[decision.23]
title = "Revert reasons for addr and bank"
value = "addr 0x1004 and bank 0x1001 return Error(string) LXP_<code> reasons through an opt-in reason path in the dynamic-gas precompile base."
basis = "Both run on DynamicGasPrecompile (precompiles/common/precompiles.go:166), and a wallet needs a reason to explain a refused bind."
affects = ["0x1001 bank", "0x1004 addr", "precompiles/common"]

[decision.24]
title = "Service dispute resolution"
value = "Service disputes are resolved by the linked escrow's arbiter, and the linked escrow settles on the ruling in the same call."
basis = "Today either agreement party may resolve (src/modules/service/lx_service_dispute.c:89) and no component settles the linked escrow."
affects = ["0x101B layerxpay service and escrow"]

[decision.25]
title = "Exchange withdrawMargin"
value = "withdrawMargin is kept as an immediate bank release from the caller's margin address to its main address behind a free-margin check."
basis = "The method is live on the exchange precompile today (precompiles/layerxexchange/layerxexchange.go:52)."
affects = ["0x1015 layerxexchange"]

[decision.26]
title = "Signer of the agent-host web payer"
value = "The embedded-wallet attestor set signs for the agent-host web payer, one attestor set for all custody."
basis = "One custody signer set removes a second key system to operate."
affects = ["agentd-host", "embedded wallet attestors", "0x101A payer grants"]

[decision.27]
title = "Typed exact payment at 0x101A"
value = "payExact is a typed send carrying a payment reference and emitting PaymentExact."
basis = "x402 sellers need a payment that carries a reference, and the x402 conformance suite stays unchanged."
affects = ["0x101A layerxledger", "x402 seller"]

[decision.28]
title = "xweb error naming"
value = "Go-origin xweb errors use LXP_XWEB_* names and kernel-origin (origin 2) errors keep kernel codes."
basis = "This follows the LXP_<MODULE>_<NAME> rule of the error registry used for launchpad and exchange."
affects = ["0x1019 xweb"]

[decision.29]
title = "One stream state"
value = "Agent streams 0x0906 keep no store and execute through the layerxpay 0x101B stream keeper."
basis = "One state gives one set of stream semantics (include/layerx/lx_stream.h:26)."
affects = ["0x0906", "0x101B layerxpay"]

[decision.30]
title = "Gas rule across the new precompiles"
value = "Every new precompile charges from a fixed per-method gas table; kernel gas units are not converted."
basis = "The fixed table follows the existing DefaultGasCost pattern (precompiles/common/precompiles.go:286) and keeps gas independent of kernel internals."
affects = ["0x101A", "0x101B", "0x101C", "0x101D", "0x0901-0x0908", "0x1015", "0x1019"]

[decision.31]
title = "computeClearing and scoreBatch ABI form"
value = "0x0902 computeClearing and 0x0904 scoreBatch use the struct ABI (tuple arrays) only, one selector per method."
basis = "No caller uses the parallel-array form."
affects = ["0x0902", "0x0904"]

[decision.32]
title = "submitPrice signer rule"
value = "0x0903 submitPrice admits a price signed by a key in the market's permittedOracleKeys through the caller's 0x1004-bound key with the ed25519 observation signature, the same rule as the exchange oracle push."
basis = "One oracle rule serves 0x0903 and 0x1015 pushOracle, both writing the exchange oracle store (tests/modules/test_oracle_intake.c)."
affects = ["0x0903", "0x1015 oracle store"]

[decision.33]
title = "TEE attestor roots"
value = "0x0907 uses the xweb attestor set as its registered roots."
basis = "One attestor set on chain needs no second registry kept in sync."
affects = ["0x0907", "0x1019 xweb attestor set"]

[decision.34]
title = "TEE signer threshold and key type"
value = "0x0907 verifies threshold signatures, 3 of 5, over secp256k1 attestor keys."
basis = "This matches the deployed attestor keys and the custody signing threshold."
affects = ["0x0907", "embedded wallet attestors"]

[design]
flow = "Wallet, agent or developer client -> unified router -> sequencer (eth_sendRawTransaction) -> execute at receipt on the open block -> WAL group fsync and hot-standby ack -> signed receipt (pax_sequencerReceipt) and pending reads -> block proposed in receipt order with MsgSequenceBatch at tx 0 -> validators check order in ProcessProposal, execute with OCC and commit -> committed receipt and history."
domains = "One execution domain, paxd. The LayerX kernel is folded in: its C modules and the Rust program runtime run inside chain keepers through a cgo lxp_module_ctx shim (decision.1), kernel accounts are derived bank addresses (decision.2), and the kernel daemon, its WAL, replicas, finality and checkpoint anchoring are retired because block commit is finality."
native_constructs = "20 existing constructs and 5 new ones. Existing: bank 0x1001 (send gains the context-hash overload and LayerXReceipt log), wasmd 0x1002, json 0x1003, addr 0x1004 (DID binding, revert reasons), staking 0x1005, gov 0x1006, distribution 0x1007, oracle 0x1008, ibc 0x1009, pointerview 0x100A, pointer 0x100B, solo 0x100C, p256Verify 0x1011, layerxVerify 0x1012 (retired executor), layerxCustody 0x1013 (retired executor), layerxAnchor 0x1014 (retired executor after bond return), layerxExchange 0x1015 (native perps and spot engine), layerxBridge 0x1016, launchpad 0x1017 (per-market fees), feeToken 0x1018, xweb 0x1019 (origin 2 added), plus the modules tokenfactory, evm, layerxgov, feegrant, authz, wasm and the BatchCallAndSponsor contract. New: layerxledger 0x101A (assets, accounts, send, payer grants, draw, payExact), layerxpay 0x101B (escrow, budget, stream, service), layerxauth 0x101C (sessions, capabilities, idempotency index), layerxprograms 0x101D (deploy, upgrade, call, wind-down, sandbox, registry), and modules/sequencer (MsgSequenceBatch, no precompile). The eight agent functions 0x0901-0x0908 are real precompiles (decision.20). Address table, selectors and error registry: contracts/address-table.md."
sequencer = "The proposer is the executor: an operator-run primary and hot standby in node/sequencer execute every transaction at receipt on a speculative branch of committed state, return a canonical ProtocolReceipt v2 signed by the ed25519 receipt key, serve pending reads from the open block, and propose blocks containing exactly that sequence; other validators execute and commit. Block time is settlement only. Contract: contracts/sequencer.md sections (a) to (g)."
fees = "Fees are policy, not security: the EVM minimum gas price is at most 0.067 gwei for the draw sender class (decision.10), SID is self-paid through feeToken 0x1018 at the governed rate with a governance-raised rate age (decision.7), sponsored writes go through the gas station and executeSponsored with one paymaster nonce and DID-keyed budgets (decision.14), paid search is USD 0.001 per request drawn at 0x101A, and the program fee stays on top of gas (decision.9)."
activation = "Activation is a bring-up at the activation height; no account-state migration is required. One height-gated fork switches on modules/sequencer, the leader list and the BeginBlock vote feed (decision.18); new precompile methods are gated per method on the same plan; lx_* ingress switches off at activation and clients use agent-api major 2 with rungs submitted, receipted and committed (decision.17). The activation height and plan name are set at activation rehearsal."
include = "design.body.md"

[execution]
planning_state = "Task completion requires the declared implementation and its verify_cmd evidence at one revision. A specification or task status alone establishes no runtime result."
task_policy = "Read the exact declared source and contract section, keep code that already meets the contract, implement every unmet criterion of the task, then run one bounded qualification pass. Implementation, qualification and activation evidence are recorded separately."
gate_policy = "Every planned gate is implemented by the task that owns its acceptance criteria. A verify_cmd names a target that exists at the revision or is listed in planned_paths with gate_kind planned; unknown, empty or skipped selectors are refused."
candidate_policy = "A passing gate is reused only while its source, inputs, scope and environment stay the same. Aggregate, sanitizer, cluster and activation-rehearsal gates run once per wave on the merged wave revision, not per task."
parallelism = "tasks in the same wave with disjoint touches run in parallel"
privacy = "Credentials, key material, operational inventories and raw execution logs stay in access-controlled storage. Everything in this feature directory is public and is reviewed before publication."
ownership = "every path appears in the touches of exactly one task per wave"
citation_policy = "every do_n names the path:line it changes or reproduces"

[req.1]
title = "Feature parity on the chain"
ac_1 = "The kernel ledger, asset, escrow, budget, stream and service tests (tests/ledger/test_send.c, tests/modules/test_escrow_dispute.c, tests/modules/test_budget_spend.c, tests/modules/test_stream_settle.c) re-targeted through the cgo shim at layerxledger 0x101A and layerxpay 0x101B give equal result codes and per-account deltas (contracts/ledger-auth.md section E, contracts/pay.md section E)."
ac_2 = "The trading payload vectors (tests/fixtures/trading-payloads/vectors.json) and the perps and spot book tests (tests/modules/test_perps_liquidate.c, tests/modules/test_spot_book.c) pass byte-exact through layerxexchange 0x1015, except order ids and launchpad fee counters, which are re-pinned per decision.8 (contracts/exchange-launchpad.md section E)."
ac_3 = "The program tests under tests/programs (test_lifecycle.c, test_call_activity.c, test_winddown.c, test_interface_protocol.c) re-targeted at layerxprograms 0x101D give equal outcomes, fees and event order (contracts/programs.md section E)."
ac_4 = "The determinism spike passes: the same block replayed through the shim on every validator build gives identical app hash and per-transaction results, OCC with forced aborts equals sequential execution, and no kernel in-memory state survives between transactions outside the committed store (decision.1)."
ac_5 = "The kernel authority, grant and idempotency tests (tests/state/lxp_test_grants.c, tests/state/lxp_test_idempotency.c) re-targeted at layerxauth 0x101C give the same outcome for each of the eight authority kinds (include/layerx/lxp_authority.h:11-19; contracts/ledger-auth.md precompile 2 section E)."
ac_6 = "The kernel root replay golden (tests/replay/lxp_test_golden_replay.c:7) is retired and replaced by the per-module goldens above; no feature golden is dropped without a chain-side replacement."

[req.2]
title = "Native AI, trading and markets"
ac_1 = "Perps and spot markets execute on chain in layerxexchange 0x1015: placeOrder and cancelOrder execute in the engine instead of recording an intent, cancelOrder checks the order's owning account, and margin moves in-transaction through bank instead of custody (modules/layerxexchange/keeper/intents.go:63, :153; contracts/exchange-launchpad.md section A rows E1 to E5)."
ac_2 = "Every chain user trades from its own derived margin account (decision.2), and withdrawMargin releases free margin to the caller's main address in one call (decision.25)."
ac_3 = "Launchpad buy and sell write a per-market protocol fee counter, getProtocolFees(address) reads it, and swaps on different markets do not share a written key under OCC (modules/launchpad/keeper/swap.go:172; contracts/exchange-launchpad.md section A launchpad rows)."
ac_4 = "A perps keeper service ticks funding per funding interval and liquidates a position below maintenance within one receipt round through fundingTick, liquidate and adl at 0x1015 (contracts/services.md S20; agent/sdk/typescript/src/perps.ts:24)."
ac_5 = "The interpreter, compute-lease market and AI market guests are deployed through MsgDeploy at the activation height with their expected code hashes and pass their crate tests against layerxprograms (programs/crates/layerx-programs-ai-market/src/lib.rs, programs/crates/layerx-programs-market/src/lib.rs; decision.13)."
ac_6 = "The AI worker, evaluator and price feeder services commit through layerxprograms and layerxexchange calls signed by their 0x1004-bound keys (contracts/services.md S19, S21, S23)."
ac_7 = "Launchpad serves a price history query beside the holding history of modules/launchpad/keeper/history.go:32 with swap semantics unchanged (contracts/exchange-launchpad.md section A)."

[req.3]
title = "The proposer is the executor"
ac_1 = "eth_sendRawTransaction on the sequencer executes an executable transaction in receipt order, fsyncs the WAL and receives the standby ack before returning, and pax_sequencerReceipt returns the canonical signed receipt (contracts/sequencer.md (a1), (b1), (e2); today rpc/send.go:76 returns the hash only)."
ac_2 = "Pending-tag reads (eth_call, eth_getBalance, eth_getTransactionCount, eth_getLogs) on the sequencer answer from the open block, and every other node answers -32000 pending served by sequencer instead of mapping pending to latest (rpc/utils.go:66; contracts/sequencer.md (b2))."
ac_3 = "From the activation height every block carries MsgSequenceBatch at tx 0, and ProcessProposal refuses any block whose order, seq continuity, txRoot, seqHash or batch signature differ from the sealed sequence (consensus/internal/state/execution.go:101, :126; contracts/sequencer.md (c2), (c3))."
ac_4 = "Leader() follows the pinned primary and standby list from the activation height, and BeginBlock(N+1) receives the votes of N-1 with no height counted twice (consensus/internal/consensus/types/round_state.go:422; node/legacyabci/begin_block.go:61; contracts/sequencer.md (c3))."
ac_5 = "The header time of a sequenced block equals the open time of its pending block, which equals the signed receipt timestamp (consensus/internal/state/state.go:279; contracts/sequencer.md (a1) field 26)."
ac_6 = "The strictly sequential executor and the OCC micro-batch executor give byte-identical receipts and equal state hashes for the same seq order, and validators' OCC execution of the sealed block gives the same app hash and receipt fields except blockHash (node/abci.go:169, :230; contracts/sequencer.md (d))."
ac_7 = "After a primary stop the standby proposes the replicated WAL slice at round 1 with receipts unchanged, and a send without the standby ack returns an error and no receipt (contracts/sequencer.md (c4), (e3), (e4))."
ac_8 = "Block pruning runs outside the block apply path so prune time is not added to block time (consensus/internal/state/execution.go:418)."

[req.4]
title = "Ledger, payments and authorization constructs"
ac_1 = "layerxledger 0x101A serves register, pause, unpause, openAccount, send, draw, payExact, issueGrant, revokeGrant, mint and burn with the views of its contract, and a paused asset refuses writes and serves reads (contracts/ledger-auth.md precompile 1 sections A and B)."
ac_2 = "A replayed idempotency key returns LXP_IDEMPOTENT_REPLAY with the first result readable through resultByIdempotency, and idempotency entries carry an expiry so the store never fills (src/state/lxp_idempotency.c:107; contracts/clients.md (e) V9)."
ac_3 = "layerxpay 0x101B serves the escrow, budget, stream and service families, and budget delegate spend and pull are reachable through their own activity types (src/modules/budget/lx_budget_delegate.c:101, :146; contracts/pay.md sections A.1 to A.4)."
ac_4 = "A service dispute is resolved only by the linked escrow's arbiter and settles the escrow in the same call; a party resolving is refused with LXP_UNAUTHORIZED_ARBITER (src/modules/service/lx_service_dispute.c:89; tests/modules/test_service_dispute.c:488; contracts/pay.md section A.6)."
ac_5 = "Tool-execution attestation compares the payload against the attested activity rather than the activity that carries it, so a real attestation is admitted (src/modules/service/lx_service_module.c:205; contracts/pay.md section A.4)."
ac_6 = "layerxauth 0x101C issues and revokes session and capability grants as authz LayerX-scope Authorizations, and every write precompile resolves the sender to the granting DID before execute (contracts/ledger-auth.md precompile 2 sections A and D; decision.3)."
ac_7 = "bank 0x1001 send with a context hash emits LayerXReceipt, and addr 0x1004 and bank 0x1001 revert with Error(string) LXP_<code> from the activation plan (precompiles/common/precompiles.go:166; contracts/ledger-auth.md section 0-B; decision.23)."

[req.5]
title = "Programs and program web requests"
ac_1 = "layerxprograms 0x101D serves deploy, upgrade, call, simulateCall, transfer, registerAccount, the wind-down and sandbox families and retireStorage, each upgrade and call carrying a trailing feeLimit (contracts/programs.md sections A and B)."
ac_2 = "retireStorage stages its retirement profile and completes a storage retirement signed by the controller (src/modules/programs/blob_lifecycle.c:378; contracts/programs.md section A)."
ac_3 = "The program fee (metering times prices) is charged on top of gas and quoteCallFee returns it before the call (decision.9; tests/programs/test_fee_governance.c; contracts/programs.md section B)."
ac_4 = "A program web request is recorded through the xweb keeper RequestFromProgram, fulfilled with fulfilProgram by at most 16 signers of the single xweb attestor set under the kernel network id, and read back with getProgramResult (include/layerx/lx_web.h:29; contracts/web.md section A rows A9 to A12)."
ac_5 = "Origin-2 fees follow the per-asset table with no refund, and refund of an origin-2 id returns LXP_XWEB_UNKNOWN_REQUEST while origin-1 refund is unchanged (src/modules/web/lx_web_intake.c:510; contracts/web.md section A row A3; decision.11)."
ac_6 = "The xweb attestor registration cap is 16 for both origins and MsgPause stops both origins (modules/xweb/types/keys.go:21; contracts/web.md section A rows A4 and A8)."

[req.6]
title = "Agent functions"
ac_1 = "0x0901 to 0x0908 are registered precompiles, so a call reaches an executor and never returns empty success (precompiles/setup.go:67; human/wallet/gateway/src/precompiles.ts:18-25)."
ac_2 = "orob, clearing, oracle and pofq at 0x0901 to 0x0904 implement the methods of contracts/agent-functions.md section A.1, with computeClearing and scoreBatch on the struct ABI only (decision.31)."
ac_3 = "0x0903 submitPrice writes and getValidatorPrice reads the 0x1015 exchange oracle store under the market permittedOracleKeys rule (decision.32; contracts/agent-functions.md section B)."
ac_4 = "0x0905 scheduler runs jobs in receipt order, 0x0906 streams execute through the 0x101B stream keeper with no store of their own, and 0x0908 hashes and recovers EIP-712 data per the gateway ABIs (human/wallet/gateway/src/routes/agentPrecompiles.ts:67; contracts/pay.md section A.7)."
ac_5 = "0x0907 verifies attestations against the xweb attestor set as roots with a 3 of 5 secp256k1 threshold (decision.33, decision.34; contracts/agent-functions.md section B)."
ac_6 = "Every agent-function error is Error(string) with an LXP_AGENT_* code and every method charges its fixed gas from contracts/agent-functions.md section D2 (decision.30)."

[req.7]
title = "Fee policy and gas"
ac_1 = "The EVM minimum gas price is set to at most 0.067 gwei by the evm params change, down from the 1 gwei default (modules/evm/types/params.go:52; contracts/sequencer.md (f))."
ac_2 = "The sequencer applies its configured floor to Cosmos transactions before Accept, since deliver mode skips the CheckTx floor check (sdk/x/auth/ante/validator_tx_fee.go:33; daemon/paxd/cmd/root.go:397)."
ac_3 = "SID self-pay through feeToken 0x1018 charges at the governed rate of 3.114 SID per PAX, and MaxFeeTokenRateAge is raised by governance so a governance-paced rate stays fresh (modules/evm/types/params.go:36, :39; modules/evm/keeper/params.go:310; modules/evm/keeper/feetoken.go:92)."
ac_4 = "Every sponsored write is a type-4 transaction calling executeSponsored with one paymaster nonce, and the gas station enforces per-DID budgets resolved through addr 0x1004 getLayerXDid before signing a quote (contracts/src/BatchCallAndSponsor.sol:135; interop/crates/layerx-gas-station/src/policy.rs:98; precompiles/addr/addr.go:40)."
ac_5 = "The gas station refuses quotes when it is down or a budget is exhausted, records the DID in each quote record, and no longer sends same-nonce replacement transactions (interop/crates/layerx-gas-station/src/journal.rs:87; interop/crates/layerx-gas-station/src/station.rs:391)."
ac_6 = "Every new precompile method charges from its fixed per-method gas table (precompiles/common/precompiles.go:286; decision.30)."

[req.8]
title = "Activation and retirement"
ac_1 = "Activation is a bring-up at the activation height; no account-state migration is required: one plan gates modules/sequencer, the leader list and every new precompile method per height (modules/layerxcustody/keeper/keeper.go:42; contracts/address-table.md section (c))."
ac_2 = "The activation handler returns every posted guarantor bond and open challenge deposit, and the sum returned equals the anchor module balance (precompiles/layerxanchor/layerxanchor.go:230-232; decision.4)."
ac_3 = "Every retired method of layerxVerify 0x1012, layerxCustody 0x1013 and layerxAnchor 0x1014 returns Error(string) LXP_MODULE_DISABLED at the plan height, and the addresses stay registered (precompiles/setup.go:83; node/upgrades.go:401-406)."
ac_4 = "layerxAnchor reads are served until bond return completes, then the store is deleted and the reads also return LXP_MODULE_DISABLED (decision.21; contracts/address-table.md section (a) 0x1014 row)."
ac_5 = "The three reference guests are deployed through MsgDeploy at the activation height with expected code hashes (decision.13)."
ac_6 = "Retired components that joined two domains have no live caller left: the intent ingester, the kernel daemon finality path and the anchor-reading mirror input are removed after their replacements land (interop/crates/layerx-intent-ingester/src/submit.rs:64; interop/crates/layerx-mirror/src/node.rs:544)."
ac_7 = "Kernel governance halt and resume are replaced by per-module Paused params on layerxledger, layerxpay, layerxexchange and layerxprograms, set through governance (src/modules/governance/lxp_emergency.c:73)."

[req.9]
title = "Off-chain services re-pointed to chain state"
ac_1 = "The unified router sends pending-tag calls and pax_sequencerReceipt to the sequencer and serves px_* answers from chain state without custody or anchor joins (contracts/services.md S03)."
ac_2 = "The authority service, indexer and x402 seller verify sequencer receipts against the pinned receipt key list instead of kernel checkpoints (platform/hosted/authority/src/main.rs:307; platform/hosted/authority/src/trust.rs:14; platform/hosted/indexer/src/settlement.rs:15; contracts/services.md S06, S08, S14)."
ac_3 = "The paid web sidecar draws payment at 0x101A through the sequencer with receipt before release, fulfils origin 1 and origin 2, and its fee is set from the governed PAX price rather than a fixed constant (interop/crates/x-websearch/src/payment.rs:7; tools/bringup/xweb-config.sh:145; contracts/services.md S15)."
ac_4 = "The xweb default fee is set at activation to USD 0.001 in base units instead of the 1 PAX default (modules/xweb/types/state.go:78; decision.10)."
ac_5 = "The program registry service reads the programs module through its query service instead of the in-process protocol adapter (platform/hosted/registry/src/program_state.rs:5; contracts/services.md S10)."
ac_6 = "The gas station deploy template names the paymaster address and the rollout controller authenticates to the image registry before pulls (interop/deploy/gas-station/railway.env.example:21; tools/rollout/rollout.py:14; contracts/services.md S11, S35)."
ac_7 = "Monitoring alerts on sequencer readiness, receipt seq versus committed index divergence, WAL fsync latency and standby ack lag in place of the kernel readiness alert (tools/ops/monitoring/rules.yml:56; contracts/services.md S01, S34)."
ac_8 = "The core boundary, webhooks, interop service, bridge relayer and ai-artifacts services take finality from block commit, state proofs and signed sequencer receipts instead of kernel checkpoints and the LNI (platform/hosted/ai-artifacts/src/retention.rs:46; platform/hosted/webhooks/src/ai_market.rs:20; interop/crates/layerx-interop-service/src/server.rs:2526; precompiles/layerxbridge/layerxbridge.go:41; docs/off-chain-services.md)."

[req.10]
title = "Clients and status rungs"
ac_1 = "agent-api major 2 replaces major 1 and its goldens are regenerated for the 65-byte signature, rungs and cursor format (agent/schema/agent-api/v1.kvx:3; contracts/clients.md (e) C1)."
ac_2 = "Clients report only the rungs submitted, receipted and committed with the definitions of contracts/clients.md (a), replacing instant, sealed and final in the wallet and explorer status UIs (human/wallet/sdk/src/ladder.ts:4; explorer/frontend/types/api/paxeerXLists.ts:1; agent/crates/layerx-agent-api/src/error.rs:131)."
ac_3 = "Every lx_* name on the gateway answers -32601 at activation and each caller moves to its major-2 replacement (platform/hosted/gateway/src/rpc.rs:341; contracts/clients.md (d))."
ac_4 = "SDK and agentd verifiers hold a rung only after the receipt checks R1 to R8 pass against the pinned receipt key list (agent/crates/layerx-proof/src/receipt.rs:631; contracts/clients.md (c))."
ac_5 = "The CLI allowlist admits the eth_* and major-2 names so wallet derive --bind completes, the Python SDK gains a transport for bind transactions, and the Python xweb call matches the PrecompileCall type (platform/cli/src/rpc.rs:172; agent/sdk/python/layerx_sdk/account_derivation.py:523; agent/sdk/python/layerx_sdk/exchange.py:162)."
ac_6 = "agentd session.open and agent.register complete, issuing the layerxauth grant on open (agent/crates/layerx-agentd/src/agent_rpc.rs:759; contracts/clients.md (a))."
ac_7 = "The portable receipt moves to format layerx-receipt-proof-v2 carrying the signed receipt, receipt key and, at committed, the header, inclusion proof, commit and validator set (interop/crates/layerx-portable/src/receipt.rs:11; contracts/clients.md (c))."
ac_8 = "The human KMS signs EVM actions with the attestor-sharded secp256k1 key and keeps ed25519 for bindLayerX, DID proofs and payment grants (human/crates/layerx-human-kms/src/evm.rs:178; human/crates/layerx-human-kms/src/attestor.rs:505), and the wallet attestor decode policy covers 0x101A-0x101D and 0x1015 (human/wallet/attestor/internal/policy/evm/decode.go)."

[req.11]
title = "Required changes to today's code"
ac_1 = "Exchange cancelOrder checks that the caller owns the order (modules/layerxexchange/keeper/intents.go:153)."
ac_2 = "Exchange margin deposits reach trading margin in the same transaction instead of custody escrow (modules/layerxexchange/keeper/intents.go:57-63)."
ac_3 = "Idempotency entries carry an expiry and are removed after it, so the store stays below its capacity (src/state/lxp_idempotency.c:107)."
ac_4 = "Budget delegate spend and pull have their own activity types and are reachable (src/modules/budget/lx_budget_delegate.c:101, :146)."
ac_5 = "Tool-execution attestation is admitted for a real activity (src/modules/service/lx_service_module.c:205)."
ac_6 = "The storage retirement profile is staged so retireStorage completes (src/modules/programs/blob_lifecycle.c:378)."
ac_7 = "The gateway wallet sponsorship route enforces per-identity budgets (human/wallet/gateway/src/routes/wallet.ts:192)."
ac_8 = "The sequencer read context is the open block, not the check context (contracts/sequencer.md (d) ante read context row)."
ac_9 = "The kernel stream module has a rate-change activity type that settles accrual at the old rate before the new rate applies, so 0x0906 updateRate executes through the 0x101B stream keeper (include/layerx/lx_stream.h:26-32; src/modules/stream/lx_stream_settle.c:95)."

[req.12]
title = "Qualification and evidence"
ac_1 = "Each task's verify_cmd passes once at the task revision and its evidence is recorded as revision, command, exit code and log path."
ac_2 = "The receipt vectors V1 to V9 of contracts/clients.md (e) pass in every SDK that verifies receipts."
ac_3 = "The x402 conformance suite passes unchanged except the network id, rung names and transaction hash fields (interop/specs/conformance/x402/payment-payload.json; contracts/clients.md (e) C10)."
ac_4 = "An activation rehearsal on a copy of chain state runs the plan at a rehearsal height and passes bond return, retired-method refusals and receipt-order equality between signed receipts and committed blocks (contracts/sequencer.md (c), (d))."
ac_5 = "The sequential versus micro-batch measurement records throughput and receipt latency p50 and p99 on one workload, and the micro-batch switch is made only when its throughput is higher and its p99 rise stays within the window bound (contracts/sequencer.md (d))."
ac_6 = "Values set at activation rehearsal (activation height, plan name, minimum gas price, rate age, AI and market height windows, receipt module id, micro-batch bounds) are recorded with the rehearsal evidence before activation."

