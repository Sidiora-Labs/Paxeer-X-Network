do_1 = "Edit docker/kernel/Dockerfile:361, :403 (layerxanchor) away from the layerxAnchor 0x1014 checkpoint and guarantor surface: remove the image, copy or rollout entry of the layerxAnchor 0x1014 checkpoint and guarantor surface; read finality from the block itself: the committed height and CometBFT commit, or eth_getBlockByNumber(\"finalized\"); a state root comes from the committed app hash with a per-key ICS23 proof at that height."
do_2 = "Edit docker/kernel/Dockerfile:15, :16, :80, :171, :178, :304 and 10 further matches in the file (guarantor.sh, layerx-guarantor) away from the Guarantor runtime: remove the image, copy or rollout entry of the Guarantor runtime; validators commit the sequencer-proposed block, so the guarantor process, its secrets and its provisioning step are removed."
do_3 = "Edit docker/kernel/Dockerfile:17, :176, :303, :391 (layerx-handover) away from the Finality authority, evidence register, receipt authority, authority replica and sequencer handover: remove the image, copy or rollout entry of the Finality authority, evidence register, receipt authority, authority replica and sequencer handover; handover becomes the pinned leader list with standby takeover on the sequencer WAL; the sequencer receipt key is a governed parameter read from chain state at the receipt height."
do_4 = "Edit docker/kernel/Dockerfile:365, :366, :367, :368, :427, :428 and 2 further matches in the file (relay_archive) away from the Replica, authority replica and relay archive: remove the image, copy or rollout entry of the Replica, authority replica and relay archive; full and archive paxd nodes serve history; the standby follows the sequencer WAL; the relay archive entries are removed."
do_5 = "Edit docker/kernel/Dockerfile:40, :42, :47, :89, :186, :306 and 1 further matches in the file (layerx-custody-proof) away from the Custody credit and light client: remove the image, copy or rollout entry of the Custody credit and light client; kernel balances are bank balances of derived sub-accounts, so no cross-domain credit exists; custodyproof/verify.go stays as the commit and header verifier."
do_6 = "Edit docker/kernel/Dockerfile:354, :397 (checkpoint-settlement.json) away from the Settlement domain and export trust: remove the image, copy or rollout entry of the Settlement domain and export trust; offline exports carry chain id 125 and the validator set at the height instead of a settlement domain."
do_7 = "Edit docker/kernel/Dockerfile:26, :28, :415, :416 (layerx-explorer-index, layerx-human-movement-provider) away from the Human two-domain crates and journeys: remove the image, copy or rollout entry of the Human two-domain crates and journeys; remove the deposit, withdraw, exit and binding hops; balances come from bank state and the explorer pages are the native explorer pages."
do_8 = "Edit docker/kernel/Dockerfile.dockerignore:40 (layerxanchor) away from the layerxAnchor 0x1014 checkpoint and guarantor surface: remove the image, copy or rollout entry of the layerxAnchor 0x1014 checkpoint and guarantor surface; read finality from the block itself: the committed height and CometBFT commit, or eth_getBlockByNumber(\"finalized\"); a state root comes from the committed app hash with a per-key ICS23 proof at that height."
do_9 = "Edit docker/kernel/Dockerfile.dockerignore:35 (layerxcustody) away from the layerxCustody deposit escrow and asset and deposit views: remove the image, copy or rollout entry of the layerxCustody deposit escrow and asset and deposit views; funding a kernel sub-account is a bank send to the derived sub-account address; asset facts come from bank 0x1001 name, symbol, decimals and supply and from pointerview 0x100A."
do_10 = "Edit docker/kernel/Dockerfile.dockerignore:22 (layerx-custody-proof) away from the Custody credit and light client: remove the image, copy or rollout entry of the Custody credit and light client; kernel balances are bank balances of derived sub-accounts, so no cross-domain credit exists; custodyproof/verify.go stays as the commit and header verifier."
