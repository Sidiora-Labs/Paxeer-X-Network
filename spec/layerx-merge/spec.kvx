[capability.10.1.1]
title = "Keep existing addresses and pin their behaviour at the merge height"
reqs = ["10001.1", "10001.2", "10001.3", "10001.4"]
touches = ["precompiles/merge_gate_test.go"]
tests = ["precompiles/merge_gate_test.go::TestMergeGate"]
verification_contract = "go test -count=1 ./precompiles/ -run TestMergeGate"
do_1 = "In precompiles/setup.go at GetCustomPrecompiles (precompiles/setup.go:63) leave the eighteen entries of the map literal (precompiles/setup.go:68-86) and the feetoken and xweb blocks (precompiles/setup.go:88-95) unchanged; add the merge entries after them so that GetCustomPrecompiles returns a superset at H and the same set below H."
do_2 = "In precompiles/merge_gate_test.go add TestMergeGate with a table over 0x1002-0x100C and 0x1011 that builds the precompile set for the plan below and at H and asserts identical Run output and revert bytes for one call per address, using the RunAndCalculateGas entry point (precompiles/common/precompiles.go:166-205)."
do_3 = "In precompiles/layerxbridge/layerxbridge.go at the WithRevertReasons option (precompiles/layerxbridge/layerxbridge.go:104) and precompiles/feetoken/feetoken.go at WithRevertReasons (precompiles/feetoken/feetoken.go:53) route refusals through RevertReason (precompiles/common/precompiles.go:59-66) only when the merge plan is active, so H-1 keeps today's bytes."
do_4 = "In the same test assert that oracle 0x1008 (precompiles/setup.go:75) answers the same value at H-1 and at H and that no exchange call path reads it, by checking that the 0x1015 executor (precompiles/layerxexchange/layerxexchange.go:198) never calls the oracle keeper."
do_5 = "Record in TestMergeGate the address list it found at each height so a later change that drops an entry fails with the missing address named (anchor modules/evm/keeper/keeper.go:251)."
symbols = ["GetCustomPrecompiles", "TestMergeGate", "RevertReason", "WithRevertReasons"]

[capability.10.1.2]
title = "Serve the bank send overload and its reason path from the merge height"
reqs = ["10002.1", "10002.2", "10002.3"]
touches = ["precompiles/bank/bank.go", "precompiles/bank/bank_test.go"]
tests = ["precompiles/bank/bank_test.go::TestBankRevertReasons"]
verification_contract = "go test -count=1 ./precompiles/bank/ -run 'TestRun|TestBankRevertReasons'"
do_1 = "In precompiles/bank/abi.json add send(address,address,string,uint256,bytes32) and event LayerXReceipt(address,address,string,uint256,bytes32); in precompiles/bank/bank.go beside the method constants (precompiles/bank/bank.go:22-29) add SendWithContextMethod so MethodById resolves 0x2e4c85ac."
do_2 = "In Execute (precompiles/bank/bank.go:106) add a case after SendMethod (precompiles/bank/bank.go:114) that checks the merge plan through the evm keeper activation lookup (modules/evm/keeper/keeper.go:251) and calls a sendWithContext helper that reuses send (precompiles/bank/bank.go:134) and then emits LayerXReceipt with the context hash."
do_3 = "In NewDynamicGasPrecompile (precompiles/bank/bank.go:98) pass the reason option so RunAndCalculateGas returns RevertReason text (precompiles/common/precompiles.go:59-66) instead of the bare revert at precompiles/common/precompiles.go:182-183, but only when the plan is active at the call height."
do_4 = "Map an insufficient balance refusal of the bank keeper to code LXP_BANK_INSUFFICIENT_FUNDS with message \"insufficient funds\" in the shared table (task 10.0.4), so the revert string equals the registry row (anchor precompiles/bank/bank.go:106)."
do_5 = "In precompiles/bank/bank_test.go add TestBankRevertReasons covering the overload at H-1 and at H, the LayerXReceipt topic and the insufficient-funds text (anchor precompiles/bank/bank.go:22)."
symbols = ["SendMethod", "SendWithContextMethod", "LayerXReceipt", "NewDynamicGasPrecompile"]

[capability.10.1.3]
title = "Return LXP_ADDR_ reasons from addr 0x1004 without changing its method set"
reqs = ["10003.1", "10003.2", "10003.3"]
touches = ["precompiles/addr/addr.go", "precompiles/addr/addr_test.go"]
tests = ["precompiles/addr/addr_test.go::TestAddrRevertReasons"]
verification_contract = "go test -count=1 ./precompiles/addr/ -run 'TestGetAddr|TestAssociate|TestAddrRevertReasons'"
do_1 = "In precompiles/addr/addr.go at NewPrecompile (precompiles/addr/addr.go:86) build the precompile with the reason option so Run packs RevertReason (precompiles/common/precompiles.go:59-66) when the merge plan is active."
do_2 = "In bindLayerX (precompiles/addr/addr.go:335) and unbindLayerX (precompiles/addr/addr.go:363) wrap each keeper error of modules/evm/types/layerx_binding.go:28-35 with its LXP_ADDR_ code from the shared table, so the returned error text is the registry string."
do_3 = "Keep the BindLayerX case of Execute (precompiles/addr/addr.go:156) and IsTransaction (precompiles/addr/addr.go:322) unchanged so the method set and gas stay as today, and add no case for rotation or recovery."
do_4 = "In precompiles/addr/addr_test.go add TestAddrRevertReasons asserting, for each of the eight binding errors, the empty revert at H-1 and the LXP_ADDR_ text at H, and that the rotation selector falls to LXP_PRECOMPILE_UNKNOWN_METHOD (anchor precompiles/addr/addr.go:134)."
do_5 = "Assert that getUnifiedAccount (precompiles/addr/addr.go:437) returns the same tuple at H-1 and at H for a bound address."
symbols = ["bindLayerX", "unbindLayerX", "getUnifiedAccount", "NewPrecompile"]

