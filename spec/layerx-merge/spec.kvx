[capability_group.5.1]
title = "Origin-1 surface: request, fulfil, refund and views"
children = ["5.1.1", "5.1.2", "5.1.3", "5.1.4"]

[capability.5.1.1]
title = "Keep the origin-1 request path and give its refusals stable LXP_XWEB codes"
reqs = ["5001.1", "5001.2", "5001.3", "5001.4", "5001.5"]
touches = ["modules/xweb/keeper/request.go", "precompiles/xweb/xweb.go"]
tests = ["modules/xweb/keeper/request_test.go", "precompiles/xweb/xweb_test.go"]
verification_contract = "go test -count=1 ./modules/xweb/keeper/ ./precompiles/xweb/ -run 'TestRequest|TestRefusesDelegateCall'"
do_1 = "Keep Keeper.Request (modules/xweb/keeper/request.go:18-90) as the only origin-1 entry: the exact fee comparison (modules/xweb/keeper/request.go:44-45), the escrow leg into the module account (modules/xweb/keeper/request.go:52-55) and the nonce step (modules/xweb/keeper/request.go:56) stay unchanged."
do_2 = "Return the errors of Keeper.Request through the D6 mapper so the precompile revert text reads LXP_XWEB_<NAME>: <registered text> for every registered error (modules/xweb/types/errors.go:6-29), read at the keeper call site (precompiles/xweb/xweb.go:321)."
do_3 = "Prefix the guard texts with LXP_XWEB_DELEGATECALL (precompiles/xweb/xweb.go:290), LXP_XWEB_STATICCALL (precompiles/xweb/xweb.go:293) and LXP_XWEB_KEEPER_MISSING (precompiles/xweb/xweb.go:296); behaviour of guard (precompiles/xweb/xweb.go:288-299) is otherwise unchanged."
do_4 = "Keep the wei-to-base-unit conversion through HandlePaymentUhpx (precompiles/common/precompiles.go:227-231) at the request site (precompiles/xweb/xweb.go:313-320) so a wei remainder reverts with LXP_PRECOMPILE_WEI_REMAINDER (precompiles/common/precompiles.go:230)."
do_5 = "Keep the EVM log (precompiles/xweb/xweb.go:326-327) and the Cosmos event attributes origin (modules/xweb/keeper/request.go:77) and network_id = ChainID (modules/xweb/keeper/request.go:78) for origin 1 so the sidecar watcher (interop/crates/x-websearch/src/watch.rs:219-232) decodes the same fields."
symbols = ["Keeper.Request", "PrecompileExecutor.request", "guard", "HandlePaymentUhpx"]

[capability.5.1.2]
title = "Keep origin-1 fulfil and move its refusals to LXP_XWEB codes"
reqs = ["5002.1", "5002.2", "5002.3", "5002.4", "5002.5"]
touches = ["modules/xweb/keeper/fulfil.go", "precompiles/xweb/xweb.go"]
tests = ["modules/xweb/keeper/fulfil_test.go", "precompiles/xweb/xweb_test.go"]
verification_contract = "go test -count=1 ./modules/xweb/keeper/ ./precompiles/xweb/ -run 'TestFulfil|TestRecordCallback'"
do_1 = "Keep verifySignatures (modules/xweb/keeper/fulfil.go:17-43) and verifySingle (modules/xweb/keeper/fulfil.go:48-64) for origin 1; signatures recover through RecoverSigner (modules/layerxbridge/types/attestation.go:115-134) with v 27 or 28 and low s."
do_2 = "Keep the origin-1 attestation builder (modules/xweb/keeper/fulfil.go:68-81) with Origin 1 (modules/xweb/keeper/fulfil.go:71), ChainID (modules/xweb/keeper/fulfil.go:72) and the EVM requester word (modules/xweb/keeper/fulfil.go:73)."
do_3 = "Keep the split loop (modules/xweb/keeper/fulfil.go:132-151): bech32 payout parse (modules/xweb/keeper/fulfil.go:137-139), remainder to signers[0] (modules/xweb/keeper/fulfil.go:142-144), zero legs skipped (modules/xweb/keeper/fulfil.go:145-146), SendCoins per leg (modules/xweb/keeper/fulfil.go:148)."
do_4 = "Route every error of Keeper.Fulfil and Keeper.RecordCallback through the D6 mapper; the precompile-site texts become LXP_XWEB_FULFIL_EVM_ONLY (precompiles/xweb/xweb.go:243) and LXP_XWEB_CALLBACK_BUDGET (precompiles/xweb/xweb.go:415-420)."
do_5 = "Keep the callback bound (precompiles/xweb/xweb.go:451-457), deliver (precompiles/xweb/xweb.go:462-482) and the return of callback outcome and gas used (precompiles/xweb/xweb.go:446)."
symbols = ["Keeper.Fulfil", "verifySignatures", "verifySingle", "Keeper.RecordCallback", "Precompile.fulfil", "deliver"]

[capability.5.1.3]
