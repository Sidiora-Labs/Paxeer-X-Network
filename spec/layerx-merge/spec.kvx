[contract_context.1.shared]
interface = "Both precompiles resolve the EVM caller to its DID through the 0x1004 binding read (modules/evm/keeper/layerx_binding.go:18-26) and execute the kernel activity through the cgo shim; the authority kind is LXP_AUTHORITY_OWNER (include/layerx/lxp_authority.h:12)."
storage = "Kernel entries live in kernel->module_kv (include/layerx/lxp_kernel.h:236-243) with the entry layout of include/layerx/lxp_kernel.h:38-44, persisted by the shim into the module store of the transaction branch; Go code reads them only through exported helpers (include/layerx/lx_asset.h:242, include/layerx/lxp_ledger.h:288)."
errors = "Every refusal is Error(string) \"LXP_<CODE>\" where CODE is lxp_result_name (src/protocol/lxp_result.c:3) without the ERR_ prefix (decision D6 A); the reason path is the WithRevertReasons option of precompiles/common/precompiles.go:53-66."
events = "Logs are emitted with pcommon.EmitEVMLog (precompiles/common/evm_events.go:16), one per kernel event in kernel order (src/protocol/lxp_module_ctx.c:2187-2214)."
gas = "EVM gas is a fixed per-method table built with the DefaultGasCost rule (precompiles/common/precompiles.go:286-292) and the KV read config (sdk/store/types/gas.go:349-358); kernel gas (src/modules/asset/lx_asset_registry.c:424) is not charged to the caller; the numbers are set at activation rehearsal."
activation = "Both addresses are served from the merge plan height through the activation list of task 0.1 that replaces CustomPrecompileActivation (modules/evm/keeper/keeper.go:195-223); a bring-up at the activation height, no account-state migration is required."
invariants = "No kernel in-memory state survives between transactions; the same block gives the same app hash on every build; OCC with forced aborts equals sequential execution (occ_tests/occ_test.go:108)."
pause = "Params.Paused on each module refuses every write with LXP_PAUSED_SCOPE (include/layerx/lxp_result.h:140) and is set only through layerxgov (modules/layerxgov/types/proposal.go:138-188); views keep answering."

[contract_context.1.bank_overload]
interface = "send(address,address,string,uint256,bytes32) returns (bool), selector 0x2e4c85ac, beside the four-argument send (precompiles/bank/Bank.sol:12-17); go-ethereum names it send0 in the method loop (precompiles/bank/bank.go:77-96)."
storage = "No new store: coins move through the bank MsgSend path (precompiles/bank/bank.go:168-181, sdk/x/bank/keeper/msg_server.go:28-60)."
errors = "The checks of the four-argument send apply unchanged (precompiles/bank/bank.go:135-152); from the merge plan height the reason path returns LXP_<CODE>, and a paused tokenfactory denom returns LXP_ASSET_PAUSED (sdk/x/bank/keeper/send.go:366-368)."
events = "LayerXReceipt(address indexed from, address indexed to, string denom, uint256 amount, bytes32 contextHash), topic0 0x4b11729a809ec729868d9ba54f3192aa4179fe63668e9f742aa9b25de21de65f, emitted after the transfer through precompiles/common/evm_events.go:16."
gas = "RequiredGas keeps the bank rule of precompiles/bank/bank.go:102-104; the log adds the EVM log cost only."
activation = "The overload and the reason path are gated on the merge plan (node/upgrades.go:398-412); below it the revert bytes are unchanged (precompiles/common/precompiles.go:179-185)."
invariants = "A zero amount returns true with no transfer and no log (precompiles/bank/bank.go:154-158); the four-argument send never emits a log."

[contract_context.1.ledger]
interface = "layerxledger 0x101A: register, pause, unpause, openAccount, send, draw, payExact, issueGrant, revokeGrant, mint, burn; views getAsset, balanceOf, totalUnits, accountId, accountOwner, nextSequence (0xce2f921f), getPayerGrant; built on the executor shape of precompiles/layerxexchange/layerxexchange.go:140-198."
storage = "Asset records (src/modules/asset/lx_asset_registry.c:711-792), payer grants (src/modules/asset/lx_asset_execution.h:46-104) and accounts (include/layerx/lxp_ledger.h:49-62) stay kernel entries; balances are bank balances at address.Module(\"layerx\", accountId) (sdk/types/address/hash.go:63-66, decision D2 A)."
errors = "Kernel refusals pass through: LXP_ASSET_ALREADY_REGISTERED (src/modules/asset/lx_asset_execution.h:192), LXP_ASSET_PAUSED (src/modules/asset/lx_asset_execution.h:252), LXP_SEQUENCE_MISMATCH (src/ledger/lxp_send.c:264), LXP_NO_PAYER_GRANT (src/ledger/lxp_receive.c:415), LXP_STALE_REVOCATION (src/modules/asset/lx_asset_execution.h:403), LXP_INSUFFICIENT_BALANCE (src/modules/asset/lx_asset_execution.h:307)."
events = "AssetRegistered, AssetPaused, AssetUnpaused, AccountOpened, PayerGrantIssued, PayerGrantRevoked from kernel events 1, 2, 3, 4, 7, 8 (src/modules/asset/lx_asset_execution.h:233, src/modules/asset/lx_asset_execution.h:247, src/modules/asset/lx_asset_execution.h:254, src/modules/asset/lx_asset_execution.h:392, src/modules/asset/lx_asset_execution.h:407); Transfer per leg (src/modules/asset/lx_asset_transfer.c:51); PaymentDrawn and PaymentExact."
gas = "register 18440; pause, unpause, openAccount 3080; send 17480; draw 8840; payExact 7880; issueGrant 16520; revokeGrant 4040; mint, burn 5000; views 1108 to 1204 (precompiles/common/precompiles.go:286-292)."
activation = "0x101A has no withdraw and no receive method; withdrawal leaves through custody retirement, out of scope for this feature (include/layerx/lx_asset.h:21-31 keeps type 0x00010009 for the kernel only)."
invariants = "issuance plus total units equals the initial supply after every asset operation (src/protocol/lxp_module_ctx.c:105-132); an authz grantee is refused on every method (src/modules/asset/lx_asset_registry.c:147)."

[contract_context.1.auth]
interface = "layerxauth 0x101C: grantSession, grantSessionSuccessor, grantCapability, revokeGrant; views resultByIdempotency, getGrant, isLive, sessionKey, capabilityScope, checkActivity; session and capability grants are authz grants carrying LayerXScopeAuthorization (sdk/x/authz/authorizations.go:11-25, decision D3 A)."
storage = "Grant bodies at key 5 || grantId (src/modules/governance/lxp_governance.c:423-428), session summaries at key 0x15 || grantId (src/modules/governance/lxp_governance.c:444-445), revocations at key 6 || grantId (src/modules/governance/lxp_governance.c:633), identity REVOCATION (src/modules/governance/lxp_governance.c:636)."
errors = "LXP_AUTH_SCOPE (src/modules/governance/lxp_governance.c:516), LXP_SEQUENCE_REUSED (src/modules/governance/lxp_governance.c:523), LXP_NON_CANONICAL (src/modules/governance/lxp_governance.c:421-422), LXP_AUTH_REVOKED (src/modules/governance/lxp_governance.c:632), liveness codes (src/state/lxp_authority.c:1122-1146)."
events = "SessionGranted (0x7145, src/modules/governance/lxp_governance.c:446), GrantBody (0x7105/0x7125 and 0x7108/0x7128, src/modules/governance/lxp_governance.c:447-451 and src/modules/governance/lxp_governance.c:528-534), CapabilityGranted (0x7148, src/modules/governance/lxp_governance.c:527), GrantRevoked (0x7106, src/modules/governance/lxp_governance.c:634), IdentityStateUpdated (0x7110, src/modules/governance/lxp_governance.c:640)."
gas = "grantSession 36680, grantSessionSuccessor 38600, grantCapability 34760, revokeGrant 5000; resultByIdempotency 1204, getGrant 1108, isLive 1300, sessionKey 1108, capabilityScope 1108, checkActivity 1396 (precompiles/common/precompiles.go:286-292)."
activation = "Key rotation and recovery are out of scope for this feature (decision D16); the epoch hook is a no-op (src/modules/governance/lxp_governance.c:648-653)."
invariants = "A grant is live only while its revocation epoch equals the grantor REVOCATION (src/state/lxp_authority.c:1141-1144); grantor DID equals grantee DID for delegated resolution (src/state/lxp_authority.c:780-782)."

[contract_context.1.idempotency]
interface = "One IdempotencyIndex keeper serves 0x101A, 0x101B and 0x101D; resultByIdempotency(didId, key) returns the stored receipt (src/protocol/lxp_kernel.c:7091-7101)."
storage = "Key hash H_context(u32be(len did) || did || key) (src/state/lxp_idempotency.c:8-23); each entry carries its recorded global sequence after the required change to include/layerx/lxp_state.h:25-31."
errors = "A replay inside the window returns LXP_IDEMPOTENT_REPLAY with the stored receipt (src/state/lxp_idempotency.c:58); a full store returns LXP_ARENA_EXHAUSTED only when the live count reaches the bound (src/state/lxp_idempotency.c:107-108)."
events = "No event is emitted for an index write; the activity events carry the outcome (src/protocol/lxp_kernel.c:3227)."
gas = "resultByIdempotency charges 1204 (precompiles/common/precompiles.go:286-292)."
activation = "The retention window is a layerxauth param set at activation rehearsal; window 0 keeps today's unbounded-until-full behaviour (include/layerx/lxp_state.h:15)."
invariants = "C store and keeper give the same codes for the same key sequence (tests/state/lxp_test_idempotency.c:320); snapshots keep the recorded sequence (src/state/lxp_idempotency.c:169-222)."

[contract_context.1.addr_reasons]
interface = "addr 0x1004 methods are unchanged (precompiles/addr/addr.go:141-180); only the revert data changes from the merge plan height."
storage = "No storage change; bindings stay in the evm keeper (modules/evm/keeper/layerx_binding.go:18-26)."
errors = "Binding errors (modules/evm/types/layerx_binding.go:28-37) map to LXP_UNKNOWN_DID, LXP_BAD_SIGNATURE, LXP_DUPLICATE_ENTRY, LXP_SEQUENCE_EXHAUSTED and LXP_NON_CANONICAL (include/layerx/lxp_result.h:33-78)."
events = "Bind and unbind logs are unchanged (precompiles/addr/addr.go:382-389)."
gas = "RequiredGas is unchanged (precompiles/addr/addr.go:127-132)."
activation = "The reason path is opted in at NewDynamicGasPrecompile (precompiles/addr/addr.go:123) and gated on the merge plan by task 0.1 (precompiles/common/precompiles.go:177-205)."
invariants = "Below the plan height every revert carries empty data (precompiles/common/precompiles.go:179-185)."

[contract_context.1.tokenfactory]
interface = "MsgSetDenomPaused(sender, denom, paused) beside SetDenomMetadata (api/tokenfactory/tx.proto:12-17); issuer_did field 2 on DenomAuthorityMetadata (api/tokenfactory/authority_metadata.proto:11-16)."
storage = "Paused flag under a new paused prefix beside modules/tokenfactory/types/keys.go:28-33; issuer DID inside the authority metadata (modules/tokenfactory/keeper/admins.go:23-37)."
errors = "ErrUnauthorized for a non-admin (modules/tokenfactory/types/errors.go:14); LXP_ASSET_PAUSED for mint, burn and send of a paused denom; LXP_PAUSED_SCOPE for an unchanged pause flag (src/modules/asset/lx_asset_execution.h:243)."
events = "set_denom_paused with denom and paused attributes from the msg server (modules/tokenfactory/keeper/msg_server.go:188)."
gas = "Ordinary Cosmos message gas as for SetDenomMetadata (modules/tokenfactory/types/msgs.go:202-234); no fixed table."
activation = "Existing denoms start unpaused with an empty issuer DID (modules/tokenfactory/keeper/admins.go:11-20); a bring-up at the activation height, no account-state migration is required."
invariants = "ChangeAdmin never changes issuer_did (modules/tokenfactory/keeper/msg_server.go:156); a paused denom moves through no bank path (sdk/x/bank/keeper/send.go:356-368)."

[contract_context.1.shim]
interface = "modules/lxphost exposes Execute, ExecuteActivity and read functions over lxp_kernel_execute_activity (include/layerx/lxp_kernel.h:641) and the exported read helpers (include/layerx/lx_asset.h:242)."
storage = "Kernel module entries are mirrored per transaction branch (include/layerx/lxp_kernel.h:38-44)."
errors = "Kernel result codes surface as LXP_<CODE> text from lxp_result_name (include/layerx/lxp_result.h:163)."
events = "Kernel events are returned to the calling precompile in emission order (src/protocol/lxp_module_ctx.c:2187-2214)."
gas = "Kernel gas (include/layerx/lxp_module.h:105-174 context API) is metered inside the kernel only."
activation = "The shim links the library of the Makefile build target (Makefile:210) via cgo (wasm-runtime/internal/api/link_system.go:5-6)."
invariants = "global_sequence equals the transaction sequence (include/layerx/lxp_module.h:154); no ambient input enters the kernel."

[contract_context.1.read_helpers]
interface = "lxp_governance_session_key_read beside include/layerx/lxp_governance.h:166-182 and lx_asset_payer_grant_read beside include/layerx/lx_asset.h:273."
storage = "They read key 0x15 || id (src/modules/governance/lxp_governance.c:444-445) and grant: || id (src/modules/asset/lx_asset_execution.h:46-51)."
errors = "Absent entries give LXP_ERR_UNKNOWN_FIELD (include/layerx/lxp_result.h:37) and LXP_ERR_NO_PAYER_GRANT (src/modules/asset/lx_asset_execution.h:89)."
events = "Read helpers emit nothing; they follow the scan of src/protocol/lxp_kernel.c:1532-1539."
gas = "Views that call them charge 1108 (precompiles/common/precompiles.go:286-292)."
activation = "Library-only change; tests at Makefile:2202 and Makefile:470 cover it (tests/state/lxp_test_grants.c:1)."
invariants = "Helpers never mutate kernel state (include/layerx/lxp_kernel.h:236-243)."

[task.1.0.1]
title = "Kernel idempotency entries record their commit sequence and prune past a retention window"
status = "done"
mode = "BUILD"
wave = 0
requires = []
reqs = ["1030.1", "1030.2", "1030.3", "1030.4", "1030.5", "1002.2", "1030.7", "4.2", "11.3", "1.5", "1.4"]
capabilities = ["1.8.1"]
do_1 = "Add uint64_t recorded_sequence after canonical_receipt in lxp_idempotency_key_state (include/layerx/lxp_state.h:25-31) and uint64_t idempotency_retention to lxp_state_store (include/layerx/lxp_state.h:36-46); a zero retention keeps today's behaviour."
do_2 = "In lxp_idempotency_record (src/state/lxp_idempotency.c:61-85) stamp journal->staged_idempotency.recorded_sequence from journal->global_sequence (include/layerx/lxp_state.h:52) next to the key hash and receipt copies at src/state/lxp_idempotency.c:75-83."
do_3 = "Add lxp_idempotency_prune(lxp_state_store *store, uint64_t current_sequence) to src/state/lxp_idempotency.c: when idempotency_retention > 0 it compacts the array in order, dropping entries with recorded_sequence + idempotency_retention <= current_sequence, so find_entry (src/state/lxp_idempotency.c:25-31) and lookup (src/state/lxp_idempotency.c:33-59) see only live entries; declare it beside lxp_idempotency_reserve (include/layerx/lxp_state.h:134)."
do_4 = "Add lxp_idempotency_append(lxp_state_store *store, const lxp_idempotency_key_state *entry, uint64_t current_sequence) that prunes then appends, and route lxp_idempotency_commit_staged (src/state/lxp_idempotency.c:111-119) through it; lxp_idempotency_can_commit (src/state/lxp_idempotency.c:96-109) returns LXP_ERR_ARENA_EXHAUSTED at src/state/lxp_idempotency.c:107-108 only when the live count after pruning equals LXP_STATE_MAX_IDEMPOTENCY (include/layerx/lxp_state.h:15)."
do_5 = "Add a live-count helper lxp_idempotency_live_count(const lxp_state_store *, uint64_t current_sequence) declared in include/layerx/lxp_state.h:135-136 for the preview bound of the module context; it counts entries the prune would keep without mutating the store."
do_6 = "Extend the snapshot entry codec (src/state/lxp_idempotency.c:169-192 encode, src/state/lxp_idempotency.c:194-222 decode) with a new magic LXRF2 carrying recorded_sequence as u64; LXRF1 (src/state/lxp_idempotency.c:121) and raw legacy entries decode with recorded_sequence 0, and the version refusal at src/state/lxp_idempotency.c:201-202 keeps refusing unknown LXRF versions."
do_7 = "Keep the journal and snapshot callers (src/state/lxp_journal.c:1056, src/state/lxp_journal.c:1076, src/state/lxp_snapshot.c:567, src/state/lxp_snapshot.c:873) source-compatible: they keep calling the same exported functions, and the snapshot of a store with retention 0 is byte-identical to today's except for entries written after the change."
do_8 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["lxp_idempotency_key_state.recorded_sequence", "lxp_state_store.idempotency_retention", "lxp_idempotency_prune", "lxp_idempotency_append", "lxp_idempotency_live_count"]
touches = ["include/layerx/lxp_state.h", "src/state/lxp_idempotency.c"]
build_cmd = "make build"
verify_cmd = "make test-idempotency"
gate_kind = "existing"
planned_paths = []
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
