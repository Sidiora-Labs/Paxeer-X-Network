[contract_context.2.escrow]
interface = "0x101B serves escrowOpen, escrowCapture, escrowPartialCapture, escrowRelease, escrowTimeout, escrowDisputeOpen and escrowDisputeResolve as kernel types 0x00020001 to 0x00020007, decoded and validated by the escrow iface before execute (src/modules/escrow/lx_escrow_module.c:47, :176, :433)."
storage = "One escrow record per escrow id and one result record per idempotency key in the module store; funds sit in a v3 escrow custody account staged from the holder DID (src/modules/escrow/lx_escrow_state.c:237, :351; src/protocol/lxp_module_ctx.c:855)."
errors = "Kernel codes surface as LXP_<code>: LXP_ZERO_AMOUNT and LXP_PARAMETER_BOUNDS at validate, LXP_UNAUTHORIZED_DEBIT for a holder mismatch, LXP_MODULE_DISABLED without the runtime (src/modules/escrow/lx_escrow_module.c:176-196, :222-223, :380)."
events = "EscrowOpened to EscrowResolved carry the 67-byte body with escrow id, ordinal, state, captured and locked amounts (src/modules/escrow/lx_escrow_state.c:489; include/layerx/lx_escrow.h:33)."
gas = "Open, capture, partial capture, release and timeout are write class at 60000; dispute open 30000; dispute resolve 80000; each plus 30 per byte, provisional until activation rehearsal (precompiles/common/precompiles.go:286-292; sdk/store/types/gas.go:349-358)."
activation = "Served from the layerxpay upgrade height with the module paused and the escrow gate flag at genesis (src/protocol/lxp_genesis.c:55-56; precompiles/setup.go:93-95)."
invariants = "Captured plus remaining equals locked; a capture never exceeds the hold; a disputed hold is frozen until the arbiter resolves (src/modules/escrow/lx_escrow_capture.c:8-16; src/modules/escrow/lx_escrow_timeout.c:46-59; src/modules/escrow/lx_escrow_dispute.c:49-133)."

[contract_context.2.budget]
interface = "Budget create, fund, amend, delegate add and remove, spend, close, defund and revoke are kernel ordinals 1 to 9; delegate spend and pull become ordinals 10 and 11 (src/modules/budget/lx_budget_module.c:312-632; include/layerx/lx_budget.h:13-42)."
storage = "One kv budget record per budget id with a budget custody account; the delegate set lives in the record (src/modules/budget/lx_budget_module.c:89; include/layerx/lx_budget.h:207)."
errors = "Allowance, expiry and closed refusals keep their kernel codes; grant refusals on pull are LXP_GRANT_REVOKED, LXP_GRANT_EXPIRED and LXP_GRANT_EXHAUSTED (src/ledger/lxp_receive.c:414-422; src/ledger/lxp_grant_store.c:146-150)."
events = "BudgetCreated, BudgetFunded, BudgetAmended, BudgetDelegateAdded and Removed, BudgetSpent, BudgetClosed, BudgetDefunded and BudgetRevoked follow the kernel emission sites (src/modules/budget/lx_budget_module.c:363-367, :396-399, :428-432, :452-454, :492-496, :534-538, :593-598, :628-632)."
gas = "Create 50000, fund 40000, amend and delegate changes 30000, spend, close, defund and revoke 50000, delegate spend 60000, pull 58000 heavy; each plus 30 per byte (precompiles/common/precompiles.go:286-292)."
activation = "Ordinals 10 and 11 are callable only once the kernel types exist; until then the precompile reverts with LXP_UNKNOWN_ACTIVITY (src/modules/budget/lx_budget_module.c:643-703)."
invariants = "Spent this period never exceeds the period limit after rollover; close, defund and revoke drain to the refund account (src/modules/budget/lx_budget_period.c:19-55; src/modules/budget/lx_budget_module.c:499-632)."

[contract_context.2.stream]
interface = "Stream open, top-up, meter, settle, pause, resume and close are kernel ordinals 1 to 7; the rate change is ordinal 8 reached by 0x0906 through the keeper, with no 0x101B ABI method (src/modules/stream/lx_stream_open.c:193; src/modules/stream/lx_stream_execution.h:353)."
storage = "One stream record per stream id and one result record per idempotency key; the stream account is a v3 custody account (src/modules/stream/lx_stream_state.c:37, :97)."
errors = "Payer-only actions refuse others with LXP_UNAUTHORIZED_DEBIT; a reused stream id is LXP_SEQUENCE_REUSED; a key stored for another stream is LXP_CONTEXT_MISMATCH (src/modules/stream/lx_stream_execution.h:199-200; src/modules/stream/lx_stream_open.c:277; src/modules/stream/lx_stream_settle.c:114-121)."
events = "StreamOpened, StreamToppedUp, StreamMetered, StreamSettled, StreamPaused, StreamResumed and StreamClosed follow the kernel event builders (src/modules/stream/lx_stream_execution.h:60, :77, :90, :105, :120, :133)."
gas = "Open and top-up 50000, meter 38000 heavy, settle 60000, pause and resume 30000, close 80000; each plus 30 per byte (precompiles/common/precompiles.go:286-292)."
activation = "The stream epoch charges gas only and settles nothing, so activation needs no stream migration (src/modules/stream/lx_stream_open.c:179-186)."
invariants = "Settled total never exceeds accrued total; settle pays the minimum of unsettled and balance and marks underfunding (src/modules/stream/lx_stream_settle.c:95-121)."

[contract_context.2.service]
interface = "Offer publish and withdraw, agreement propose and accept, commit, abandon, progress, tool execution attestation, deliver, accept, reject and dispute open and resolve are kernel service ordinals (src/modules/service/lx_service_module.c:445; include/layerx/lx_service.h:33-47)."
storage = "Offers, agreements, commitments, executions, deliveries, progress reports and disputes are records keyed by id in the service store (src/modules/service/lx_service_state.c:240, :395, :502, :539, :700, :860, :1023)."
errors = "Party and state refusals are LXP_UNAUTHORIZED_DEBIT, LXP_AGREEMENT_STATE, LXP_PARAMETER_BOUNDS and LXP_METER_REGRESSION (src/modules/service/lx_service_acceptance.c:8-27; src/modules/service/lx_service_commit.c:26-151)."
events = "Thirteen service events carry a 73-byte body with primary and secondary ids, code and sequence; DefaultOutcomeApplied is event 14 (include/layerx/lx_service.h:33-47)."
gas = "Record methods 30000 or 40000, deliver 50000, tool execution attestation 38000 heavy; each plus 30 per byte (precompiles/common/precompiles.go:286-292)."
activation = "The service gate flag is set at genesis with the other pay modules (src/protocol/lxp_genesis.c:61-62)."
invariants = "Service activities never move balances; any transfer effect is a fatal invariant (src/modules/service/lx_service_dispute.c:106-124)."

[contract_context.2.dispute]
interface = "serviceDisputeOpen and serviceDisputeResolve compose the service dispute activity with the escrow dispute activity on the linked hold in one call (src/modules/service/lx_service_dispute.c:15-64; src/modules/escrow/lx_escrow_dispute.c:16-33)."
storage = "The dispute record keeps the escrow resolution id written at resolve (src/modules/service/lx_service_dispute.c:94-95)."
errors = "Required change: LXP_ARBITER_REQUIRED, LXP_UNAUTHORIZED_ARBITER and LXP_ESCROW_LINK_MISMATCH join the code list after LXP_ERR_PROGRAM_REFUSED, values set at activation rehearsal (include/layerx/lxp_result.h:140-141)."
events = "DisputeOpened and DisputeResolved on the service side and EscrowDisputed and EscrowResolved on the escrow side (include/layerx/lx_service.h:33-47; src/modules/escrow/lx_escrow_state.c:489)."
gas = "Open 50000 and resolve 100000, both heavy because they run two kernel activities (precompiles/common/precompiles.go:286-292)."
activation = "Required change: resolve checks the linked escrow arbiter in place of agreement_party (src/modules/service/lx_service_dispute.c:8-13, :87-90)."
invariants = "Only the linked escrow arbiter resolves; the split moves escrow funds only (src/modules/escrow/lx_escrow_dispute.c:49-133)."

[contract_context.2.draw]
interface = "The per-request draw lands at 0x101A and is referenced by 0x101B only; budgetPull shares the grant record (src/ledger/lxp_receive.c:383)."
storage = "Grant state holds the per-grant draw total and count (src/ledger/lxp_grant_store.c:123-155)."
errors = "Revoked, expired and exhausted grants refuse both the draw and the pull (src/ledger/lxp_receive.c:414-422; src/ledger/lxp_grant_store.c:146-150)."
events = "The draw emits on 0x101A; budgetPull emits BudgetSpent on 0x101B (src/modules/budget/lx_budget_module.c:492-496)."
gas = "budgetPull is heavy at 58000 for the grant signature check (src/ledger/lxp_grant_store.c:72-99)."
activation = "The ledger module is the first-wave task 2.3 and lands before the pull is callable (src/ledger/lxp_receive.c:383)."
invariants = "One draw record per grant draw whichever path made it (src/ledger/lxp_grant_store.c:123-155)."

[contract_context.2.framework]
interface = "Every method resolves an account-holder authority from the caller's 0x1004 binding and returns Error(string) LXP_<code> on refusal (precompiles/common/precompiles.go:53-70; include/layerx/lxp_authority.h:12)."
storage = "layerxpay keeps a module store with the kernel records and a genesis Paused flag, shaped like the xweb module (modules/xweb/types/genesis.go:11-27)."
errors = "LXP_ERR_<X> maps to LXP_<X> and LXP_FATAL_<X> keeps its name (include/layerx/lxp_result.h:29-141)."
events = "Logs are emitted through the shared EVM log helper with the event id as topic 0 (precompiles/common/evm_events.go:16-40)."
gas = "Views are read class at 1000 plus 3 per byte (sdk/store/types/gas.go:349-358)."
activation = "Pause scope applies to every write except the exit set; the module gate flag is the only enable switch (src/modules/governance/lxp_emergency.c:139-161; src/protocol/lxp_genesis.c:55-62)."
invariants = "Idempotency entries carry a retention window so keyed methods keep admitting keys; required change at the store limit (src/state/lxp_idempotency.c:107-108)."

[contract_context.2.agent_streams]
interface = "0x0906 calls the keeper stream API and keeps no store (src/modules/stream/lx_stream_execution.h:353)."
storage = "One stream state for both callers (src/modules/stream/lx_stream_state.c:37)."
errors = "Settle by payer or recipient, close by payer only (src/modules/stream/lx_stream_execution.h:257-259; src/modules/stream/lx_stream_lifecycle.c:19-20)."
events = "StreamRateUpdated is logged after the old-rate settle (src/modules/stream/lx_stream_execution.h:105-118)."
gas = "0x0906 charges its own table; the keeper adds no EVM gas (precompiles/common/precompiles.go:286-292)."
activation = "0x0906 is served from the same upgrade as 0x101B (precompiles/setup.go:93-95)."
invariants = "Stream ids and keys are chain-derived nonzero bytes32 values (src/modules/stream/lx_stream_payload.c:135, :258-260)."

