do_3 = "Replace the HTTP lx_subscribe refusal (platform/hosted/gateway/src/rpc.rs:404-407) with the -32601 answer used for every lx_ name."
do_4 = "Update the public method list (platform/hosted/gateway/src/rpc.rs:1138-1148) and platform/hosted/gateway/openrpc.json: add px_getReceiptKeys, px_getCommit, px_getValidators, px_register and px_requestFunds; drop every lx_ name; the schema test (platform/hosted/gateway/src/rpc.rs:1114) keeps both in step."
do_5 = "Add rpc unit tests in the existing test module (platform/hosted/gateway/src/rpc.rs:758): lx_read_names_answer_method_not_found, lx_send_activity_answers_method_not_found, lx_estimate_fee_answers_method_not_found and no_kernel_backend_after_activation."
