[req.6095]
title = "Retire SettlementAnchored and the CheckpointFinalised and BatchIncluded split"
ac_1 = "CheckpointFinalised and SettlementAnchored (agent/crates/layerx-types/src/verify.rs:12-13) and the agent-api Level variants (agent/crates/layerx-agent-api/src/error.rs:134-135) are removed in favour of the three rungs."
ac_2 = "The level report in finality (agent/crates/layerx-agentd/src/finality.rs:221) and the export refusal (agent/crates/layerx-agentd/src/export.rs:207) are removed."
ac_3 = "Committed means a verified Comet commit."

[req.6096]
title = "Retire the authority authorized-batch route"
ac_1 = "The authorized-batch URL (agent/crates/layerx-agentd/src/human_runtime.rs:1379) and its use by track (agent/crates/layerx-agentd/src/human_runtime.rs:12802) are removed; block header and commit come from the node."
ac_2 = "The x402 AuthorizedReceiptBatch in Python (agent/sdk/python/layerx_sdk/x402.py:159) and the TS draw check (agent/sdk/typescript/src/x402/draw.ts:47) no longer take an authorized batch."
ac_3 = "The authority route is no longer served."

[req.6097]
title = "Retire the LNI transport for agent writes and reads"
ac_1 = "submit_signed in the client LNI path (agent/crates/layerx-client/src/client.rs:1063) and the agentd LNI uses (the receipt lookup at agent/crates/layerx-agentd/src/human_runtime.rs:12847 and the submit at agent/crates/layerx-agentd/src/human_runtime.rs:12067) are replaced by JSON-RPC to the router."
ac_2 = "layerxctl moves to RPC (decision.20) and its socket flag goes (cmd/layerxctl/src/main.rs:130)."
ac_3 = "The lni module of the client (agent/crates/layerx-client/src/lni) is deleted after the last caller moves."

[req.6098]
title = "Retire kernel ed25519 activity envelope signing for agents"
ac_1 = "sign_disclosed (agent/crates/layerx-crypto/src/signer.rs:226), KeystoreSigner (agent/crates/layerx-crypto/src/signer.rs:250) and the RemoteSigner LXRS protocol (agent/crates/layerx-crypto/src/remote.rs:68) stop signing activities; the secp256k1 EIP-1559 signer (agent/crates/layerx-crypto/src/evm_transaction.rs:94) sits behind the same Signer trait."
ac_2 = "ed25519 is kept only for the DID bind message and payer grants (signing mode B), never a transaction."
ac_3 = "The remote signer protocol carries the EIP-1559 preimage."

[req.6099]
title = "Retire the agent wire codec and its C differential for activities"
ac_1 = "The layerx-wire activity codec is replaced by RLP through the existing EIP-1559 encoder, and the C reference target (Makefile:3044) is removed."
ac_2 = "The differential test (agent/tools/wire-differential/tests/parity.rs:5) is replaced by a differential against go-ethereum transaction types."
ac_3 = "agent/Cargo.toml no longer lists crates/layerx-wire once every user moves."

[req.6100]
title = "Retire the cross-domain custody credit disclosure"
ac_1 = "decode_native_custody_credit (agent/crates/layerx-crypto/src/disclosure.rs:386) and the system:paxeer-reserve account (agent/crates/layerx-types/src/account.rs:24, agent/crates/layerx-proof/src/state.rs:527) are removed from agent crates, since deposits are native balances."
ac_2 = "The hosted core reserve id (platform/hosted/core/src/lib.rs:536) is removed with the reserve account."
ac_3 = "Deposits appear as native balances read by eth_getBalance and bank."

[req.6101]
title = "Retire availability fetch of kernel batches"
ac_1 = "The export availability fetch (agent/crates/layerx-agentd/src/export.rs:811), the agentd availability path (agent/crates/layerx-agentd/src/human_runtime.rs:15771) and the explorer index fetch (human/crates/layerx-explorer-index/src/main.rs:1135) move to block retrieval."
ac_2 = "The client availability API is removed after the last caller moves."
ac_3 = "The explorer index reads blocks."

[req.6102]
title = "Retire two sequences per payment draw"
ac_1 = "The identity sequence read in the web search kernel client (interop/crates/x-websearch/src/kernel.rs:788) and the intent ingester (interop/crates/layerx-intent-ingester/src/submit.rs:610) is replaced by the EVM pending nonce."
ac_2 = "The receiver sequence kept by the layerxledger draw signature is read from nextSequence at pending."
ac_3 = "The payment record (interop/crates/x-websearch/src/payment.rs:1937) stores txHash and nonce instead of two sequences."

[req.6103]
title = "Keep the addr bindLayerX path as the required first step"
ac_1 = "The addr bindLayerX path is kept: the client binding (agent/crates/layerx-client/src/account_binding.rs:200), the Paxeer binding module (agent/crates/layerx-client/src/paxeer_binding.rs), the CLI derive bind (platform/cli/src/wallet_derive.rs:10-12), the TS bind reader (agent/sdk/typescript/src/account-derivation.ts:455) and the Python bind call (agent/sdk/python/layerx_sdk/account_derivation.py:462)."
ac_2 = "The gateway lx_* names are not kept: decision.17 switches them off with -32601, superseding the earlier schema note that kept them re-backed."
ac_3 = "The bind is refused under delegatecall and allowed as a 7702 CALL."

