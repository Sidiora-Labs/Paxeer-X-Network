[capability.8.3.1]
title = "Wallet send and receive of PAX and ERC-20 returns the signed receipt"
reqs = ["8001.1", "8001.2", "8001.3"]
touches = ["human/wallet/gateway/src/rpc/pool.ts", "human/wallet/gateway/src/routes/sign.ts"]
tests = ["human/wallet/gateway/test/rpc-pool.test.ts", "human/wallet/gateway/test/e2e/gateway.e2e.test.ts"]
verification_contract = "npm --prefix human/wallet/gateway test -- test/rpc-pool.test.ts"
do_1 = "Change RpcPool (human/wallet/gateway/src/rpc/pool.ts:70) so sendRawTransaction (human/wallet/gateway/src/rpc/pool.ts:218) targets the sequencer endpoint and returns the hash together with the receipt read through pax_sequencerReceipt; reads keep the current failover."
do_2 = "Change the /v1/wallet/send handler (human/wallet/gateway/src/routes/sign.ts:549) so the call at human/wallet/gateway/src/routes/sign.ts:571 stores the receipt and the response body (human/wallet/gateway/src/routes/sign.ts:610) adds a receipt object beside tx_hash, address and chain_id."
do_3 = "Keep the nonce read through getTransactionCount (human/wallet/gateway/src/rpc/pool.ts:191) on the pending tag so a second send in the same open block takes the next nonce; prepareGas (human/wallet/gateway/src/rpc/pool.ts:200) keeps its estimate path."
do_4 = "Map a status-0 receipt to rung receipted with the decoded LXP_ code in the send answer; the wallet SDK send path (human/wallet/sdk/src/provider.ts:304) reads the receipt object instead of returning only tx_hash (human/wallet/sdk/src/provider.ts:306)."
symbols = ["RpcPool", "sendRawTransaction", "getTransactionCount"]

[capability.8.1.1]
title = "Wallet swap settles through the sequencer and reads its output from receipt logs"
reqs = ["8002.1", "8002.2", "8002.3"]
touches = ["human/apps/wallet/src/lib/swap/executor.ts"]
tests = ["human/apps/wallet/src/lib/swap/executor.test.ts"]
verification_contract = "npm --prefix human/apps/wallet test -- src/lib/swap/executor.test.ts"
do_1 = "Keep executeSwap (human/apps/wallet/src/lib/swap/executor.ts:31) and its route switch (human/apps/wallet/src/lib/swap/executor.ts:37); the signer it receives submits through the row 1 send path and resolves with the signed receipt."
do_2 = "Change parseUsdlReceived (human/apps/wallet/src/lib/swap/executor.ts:142) to accept the receipt logs returned by the send path, so the PECOR branch (human/apps/wallet/src/lib/swap/executor.ts:179) reads receipt.hash and the output from the same receipt."
do_3 = "Change the Sidiora buy branch (human/apps/wallet/src/lib/swap/executor.ts:194) to report the output from the receipt logs at human/apps/wallet/src/lib/swap/executor.ts:197 instead of polling."
do_4 = "Keep ensureApproval (human/apps/wallet/src/lib/swap/executor.ts:18) ordering: the approval receipt must be receipted before the swap is signed; add one assertion test for the receipt-log read."
symbols = ["executeSwap", "parseUsdlReceived", "ensureApproval"]

