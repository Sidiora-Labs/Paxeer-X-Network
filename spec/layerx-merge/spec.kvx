do_1 = "Change the exchange module factory (human/wallet/sdk/src/modules/exchange.ts:46) to the 0x1015 v2 selectors for placeOrder (human/wallet/sdk/src/modules/exchange.ts:52), depositMargin (human/wallet/sdk/src/modules/exchange.ts:55) and withdrawMargin (human/wallet/sdk/src/modules/exchange.ts:58)."
do_2 = "Change ExchangeView (human/apps/wallet/src/surfaces/ExchangeView.tsx:30) so the placeOrder action (human/apps/wallet/src/surfaces/ExchangeView.tsx:52) and cancel action (human/apps/wallet/src/surfaces/ExchangeView.tsx:60) read the decoded event from the signed receipt."
do_3 = "Change the margin actions (human/apps/wallet/src/surfaces/ExchangeView.tsx:62, human/apps/wallet/src/surfaces/ExchangeView.tsx:64) so the margin read follows the receipt in the same open block through the pending tag."
do_4 = "Keep the ExchangeAction union (human/apps/wallet/src/surfaces/ExchangeView.tsx:11) and re-target ExchangeView.test.tsx at the v2 ABI."
