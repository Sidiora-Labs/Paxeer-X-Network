[service.sequencer]
purpose = "Proposer that executes each user-signed EVM transaction at receipt and returns a signed ProtocolReceipt v2; primary plus hot standby."
route = "node JSON-RPC eth_sendRawTransaction, pax_sequencerReceipt and pending-tag reads; private to the router and registered hosted senders"
inputs = "user-signed raw EVM transactions; committed state"
outputs = "ProtocolReceipt v2 per transaction; one block per height with MsgSequenceBatch as transaction 0"
state = "receipt WAL replicated synchronously to the standby; ReceiptKeys list in chain state"
dependencies = ["archive-node", "monitoring"]
failure_policy = "standby proposes the replicated WAL slice at round 1; without the standby acknowledgement sends return an error, never a receipt"
contract = "contracts/services.md#s01-sequencer-primary-and-hot-standby"
completion_task = "7.0.3"
operation_task = "7.0.1"

[service.archive-node]
purpose = "paxd node with pruning off serving historical state and proofs by height."
route = "node JSON-RPC at past heights, routed by the router for past-height reads"
inputs = "committed blocks"
outputs = "eth_getProof, eth_getLogs and eth_getBlockByNumber at past heights"
state = "full history from genesis or the activation height"
dependencies = ["sequencer"]
failure_policy = "down: past-height reads return an error, never a current-height substitute; restart from its own data or a snapshot copy"
contract = "contracts/services.md#s02-archive-node-new"
completion_task = "7.1.3"
operation_task = "7.1.5"

[service.unified-router]
purpose = "Public entry: relays user-signed EVM transactions and reads, serves px_ methods from one source, routes services."
route = "public JSON-RPC, WebSocket and service routes of the route catalogue"
inputs = "client JSON-RPC and HTTP"
outputs = "relayed answers, px_ answers, catalogue routes"
state = "stateless"
dependencies = ["sequencer", "archive-node", "indexer", "receipt-authority", "identity-registration", "faucet"]
failure_policy = "sequencer unreachable: writes refused with -32003, never relayed unsigned; restart is stateless"
contract = "contracts/services.md#s03-unified-router"
completion_task = "7.7.4"
operation_task = "7.6.3"

[service.identity-registration]
purpose = "Registers tenants and keys and serves the binding for addr 0x1004 bindLayerX, through px_register."
route = "router px_register; identity service routes"
inputs = "registration requests"
outputs = "binding digest; starter credits"
state = "identity service database"
dependencies = ["unified-router", "gas-station-relayer"]
failure_policy = "down: 503 with no partial registration; a bind already submitted lands on its own"
contract = "contracts/services.md#s04-identity-registration-service"
completion_task = "7.5.8"
operation_task = "7.4.6"

[service.faucet]
purpose = "Funds admitted claims by an EVM bank send from the faucet account."
route = "router px_requestFunds over the claim path"
inputs = "claims with identity, address and network quotas"
outputs = "funding id; EVM transfer"
state = "claim journal"
dependencies = ["unified-router", "sequencer", "gas-station-relayer"]
failure_policy = "down or empty: 503; a pending or refused claim is never reported funded"
contract = "contracts/services.md#s05-faucet"
completion_task = "7.5.7"
operation_task = "7.4.6"

[service.receipt-authority]
purpose = "Verifies sequencer receipts against ReceiptKeys and committed inclusion; detects order divergence."
route = "authority routes by-activity and agent routes"
inputs = "pax_sequencerReceipt; committed receipts"
outputs = "202 pending or verified answers; equivocation evidence"
state = "stateless apart from evidence records"
dependencies = ["sequencer", "archive-node"]
failure_policy = "unverified or sequencer down: 202 pending, never a false success"
contract = "contracts/services.md#s06-receipt-authority-verifier"
completion_task = "7.5.9"
operation_task = "7.0.1"

[service.core-boundary]
purpose = "Treasury payouts as EVM transfers under configured caps."
route = "operator routes of the core boundary"
inputs = "operator send requests"
outputs = "EVM transfers from the treasury"
state = "withdrawal configuration and caps"
dependencies = ["sequencer"]
failure_policy = "down: no send and no partial send; operator retries"
contract = "contracts/services.md#s07-core-boundary-treasury"
completion_task = "7.5.11"
operation_task = "7.4.6"

[service.indexer]
purpose = "Indexes one chain: blocks, receipts and construct logs."
route = "indexer read API through the router"
inputs = "committed blocks and logs"
outputs = "history, AI market projections"
state = "own database"
dependencies = ["archive-node"]
failure_policy = "stale reads carry a freshness head; resumes from its last indexed height"
contract = "contracts/services.md#s08-indexer"
completion_task = "7.7.3"
operation_task = "7.4.6"

[service.webhooks]
purpose = "Delivers merchant and AI market notifications on block-commit finality."
route = "webhook deliveries to subscriber endpoints"
inputs = "authority routes and indexer projections"
outputs = "signed deliveries"
state = "delivery cursor"
dependencies = ["receipt-authority", "indexer"]
failure_policy = "redelivery from the authority and indexer cursor"
contract = "contracts/services.md#s09-webhooks"
completion_task = "7.6.1"
operation_task = "7.4.6"

[service.program-registry]
purpose = "Read cache over layerxprograms 0x101D views (D20)."
route = "registry read routes"
inputs = "0x101D getProgram, getInterface and getStateHead"
outputs = "cached program records with height"
state = "cache with cursor height"
dependencies = ["archive-node"]
failure_policy = "stale catalogue rebuilt from module queries"
contract = "contracts/services.md#s10-program-registry-read-cache"
completion_task = "7.5.13"
operation_task = "7.4.6"

[service.gas-station-relayer]
purpose = "Sponsors user batches through BatchCallAndSponsor with per-DID budgets."
route = "/quote, /submit, /status, /retry"
inputs = "quote requests with EIP-7702 authorisations"
outputs = "type-4 sponsored transactions"
state = "journal of quotes and submissions"
dependencies = ["sequencer"]
failure_policy = "budgets fail closed; a refused send frees the nonce; no same-nonce replacement"
contract = "contracts/services.md#s11-gas-station-relayer"
completion_task = "7.2.1"
operation_task = "7.0.1"

[service.gas-station-rate-publisher]
purpose = "Publishes the paymaster SID rate by setRate within max_rate_age."
route = "none public"
inputs = "operator rate file"
outputs = "setRate transactions"
state = "publication journal"
dependencies = ["sequencer"]
failure_policy = "publication refused below floor, past budget or above fee cap; the old rate stays"
contract = "contracts/services.md#s12-gas-station-sid-rate-publisher"
completion_task = "7.0.6"
operation_task = "7.0.1"

[service.interop-service]
