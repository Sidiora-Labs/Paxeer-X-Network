[req.13001]
title = "Receipt key and batch signer"
ac_1 = "A receipt verifies only against the pinned 32-byte ed25519 receipt key of its host and height range (agent/crates/layerx-proof/src/receipt.rs:631)."
ac_2 = "eth_sendRawTransaction keeps returning the hash (rpc/send.go:139-159) and the signed receipt is read by pax_sequencerReceipt."
ac_3 = "MsgSequenceBatch is injected at CreateProposalBlock (consensus/internal/state/execution.go:101) and verified in ProcessProposal (node/app.go:1457)."
ac_4 = "The EVM receipt module id is the next free id after the set of include/layerx/lxp_module.h:26."

[acceptance.13.1.1]
feature = "13"
req = "13001.1"
scenario = "Given ReceiptKeys pins key K1 for heights 100-199 and K2 from 200, when a receipt for height 150 signed by K2 is verified, then verification fails and a receipt for height 150 signed by K1 verifies."
contract = "contracts/sequencer.md#(a4) Key rotation procedure"
test = "agent/crates/layerx-proof/tests/resolution_receipt_key.rs::refuses_key_outside_range"
qualification = "UNRUN"

[acceptance.13.1.2]
feature = "13"
req = "13001.2"
scenario = "Given a funded EOA, when it sends a raw transfer of 1 PAX, then eth_sendRawTransaction returns the 32-byte hash and pax_sequencerReceipt for that hash returns a receipt whose ed25519 signature verifies."
contract = "contracts/sequencer.md#(b1) Methods"
test = "rpc/resolution_pending_test.go::TestResolutionSendReturnsHash"
qualification = "UNRUN"

[acceptance.13.1.3]
feature = "13"
req = "13001.3"
scenario = "Given a sealed sequence 1-40 at height 300, when the proposer builds the block, then its first tx is MsgSequenceBatch fromSeq 1 toSeq 40 and a block whose batch txRoot differs is refused by ProcessProposal."
contract = "contracts/sequencer.md#(c3) Leader, proposal, ProcessProposal, BeginBlock"
test = "node/sequencer/resolution_test.go::TestResolutionBatchInjection"
qualification = "UNRUN"

[acceptance.13.1.4]
feature = "13"
req = "13001.4"
scenario = "Given the module id set of lxp_module.h, when an EVM receipt is encoded, then its module_id equals the next free id and no existing kernel module id is reused."
contract = "contracts/sequencer.md#(a) Signed receipt: canonical ProtocolReceipt v2 envelope carrying the EVM result, ed25519-signed by the separate receipt key (D15 A)"
test = "node/sequencer/resolution_test.go::TestResolutionReceiptModuleId"
qualification = "UNRUN"

[req.13002]
title = "Nonce rule, replacement and read context"
ac_1 = "In deliver mode the ante check requires nonce equal to the next nonce (modules/evm/ante/sig.go:70-80) and future nonces wait in the sequencer queue."
ac_2 = "A same-nonce replacement is refused, and the gas station issues no cancellation transfer at the sponsor nonce (interop/crates/layerx-gas-station/src/station.rs:391-406)."
ac_3 = "The ante latest-context hook reads GetCheckCtx (node/app.go:1122-1124) on the open speculative state of the sequencer."
ac_4 = "The standby proposes every receipted tx in receipt order after a failover, Leader() following the pinned list (consensus/internal/consensus/types/round_state.go:422)."

[acceptance.13.2.1]
feature = "13"
req = "13002.1"
scenario = "Given next nonce 7, when txs with nonces 9, 7, 8 arrive, then receipts are issued in order 7, 8, 9 and no receipt is issued for 9 before 8."
contract = "contracts/sequencer.md#(b3) Nonce, estimation, replacement"
test = "node/sequencer/resolution_test.go::TestResolutionNonceQueue"
qualification = "UNRUN"

[acceptance.13.2.2]
feature = "13"
req = "13002.2"
scenario = "Given a receipted tx at nonce 12, when a second tx at nonce 12 with a higher tip arrives, then it is refused and the gas station journal records no Replacement entry."
contract = "contracts/sequencer.md#(b3) Nonce, estimation, replacement"
test = "interop/crates/layerx-gas-station/tests/resolution_policy.rs::no_same_nonce_replacement"
qualification = "UNRUN"

[acceptance.13.2.3]
feature = "13"
req = "13002.3"
scenario = "Given a receipted transfer of 5 PAX not yet in a block, when the sender's balance is estimated through the ante read context, then the estimate reflects the debit of 5 PAX."
contract = "contracts/sequencer.md#(b3) Nonce, estimation, replacement"
test = "node/sequencer/resolution_test.go::TestResolutionReadContext"
qualification = "UNRUN"

[acceptance.13.2.4]
feature = "13"
req = "13002.4"
scenario = "Given the primary receipted sequence 1-25 and stops before proposing, when the standby takes the lease at epoch 2, then the next block carries sequence 1-25 in receipt order."
contract = "contracts/sequencer.md#(c4) Failover with a sequencer-signed but unproposed sequence"
test = "node/sequencer/resolution_test.go::TestResolutionStandbyReplay"
qualification = "UNRUN"

