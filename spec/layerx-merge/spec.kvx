[task.0.8]
title = "Sequencer WAL and hot standby"
status = "pending"
mode = "BUILD"
wave = 0
requires = ["0.2"]
reqs = ["3.1", "3.7"]
do_1 = "Add node/sequencer/wal reusing the frame format of consensus/internal/libs/wal/writer.go:94-95. Entry kinds: 1 OPEN, 2 ACCEPT, 3 SEAL, 4 COMMITTED, 5 LEASE."
do_2 = "Use group fsync (consensus/internal/libs/wal/writer.go:110, log.go:195-198). A receipt is released only after the ACCEPT entry is synced locally and acknowledged by the standby; otherwise Accept fails closed."
do_3 = "LEASE entries carry a rising epoch. A host acts as sequencer only under an unexpired lease of the highest epoch; the standby takes over after expiry and fences the old epoch."
do_4 = "The standby in node/sequencer/standby.go replays the WAL so that after takeover it proposes lastSeq+1 up to its last seq in receipt order."
do_5 = "Add node/sequencer/wal/wal_test.go: replay after a truncated frame, a receipt withheld without a standby ack, and lease takeover with epoch fencing."
symbols = ["WAL", "EntryOpen", "EntryAccept", "EntrySeal", "EntryCommitted", "EntryLease"]
touches = ["node/sequencer/wal/wal.go", "node/sequencer/wal/wal_test.go", "node/sequencer/standby.go"]
