tests = ["modules/lxphost/occ_test.go"]
verification_contract = "make build && go test -count=1 ./modules/lxphost/ -run TestHostOCCMatchesSequential"
do_1 = "Create modules/lxphost/occ_test.go following the OCC harness of occ_tests/occ_test.go:108."
do_2 = "Build 32 kernel transfers across 8 accounts through ExecuteActivity (modules/lxphost/execute.go of task 1.1.12), each reaching asset_transfer (src/modules/asset/lx_asset_execution.h:106-162)."
do_3 = "Run them sequentially and under OCC with every second transaction forced to abort once; compare balances read through lx_asset_balance_get (include/layerx/lx_asset.h:263), receipts and the app hash."
do_4 = "Assert no kernel module_kv entry (include/layerx/lxp_kernel.h:236-243) survives an aborted incarnation."
do_5 = "Name the test TestHostOCCMatchesSequential."
symbols = ["TestHostOCCMatchesSequential"]

