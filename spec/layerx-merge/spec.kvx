verification_contract = "go test -count=1 ./precompiles/layerxagent/teeattestor/"
do_1 = "Add precompiles/layerxagent/teeattestor/vendor.go with parseTDX, parseSEVSNP, parseSGX and parseH100 returning (mrtd, reportData, timestamp, debug, chain) for the families at human/wallet/gateway/src/precompiles.ts:32-36."
do_2 = "Dispatch in Verify on the envelope magic: PXVE 0x01 keeps the dev path, a vendor header selects the vendor parser; any other header is LXP_AGENT_TEE_INVALID_QUOTE."
do_3 = "Verify each certificate chain against the family root list served by RootOf and RootCount (gateway client human/wallet/gateway/src/precompiles.ts:474) and refuse an unlisted root with LXP_AGENT_TEE_UNTRUSTED_CHAIN."
do_4 = "Apply the debug refusal and MaxAttestationAge 600 s to vendor quotes exactly as to the dev envelope."
do_5 = "Add one golden vector per vendor format to vendor_test.go, built from public vendor sample quotes re-signed under a test root."
symbols = ["parseTDX", "parseSEVSNP", "parseSGX", "parseH100", "verifyVendorChain"]

