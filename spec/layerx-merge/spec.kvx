[acceptance.2.1.1]
feature = "2"
req = "2001.1"
scenario = "Given holder H with 5000 base units of asset A; when escrowOpen is called with amount 0 for escrowId E1; then the call reverts with LXP_ZERO_AMOUNT, no hold:E1 record exists and H still holds 5000."
contract = "contracts/pay.md#A.1 escrow"
test = "tests/modules/test_escrow_open.c::main"
qualification = "UNRUN"

[acceptance.2.1.2]
feature = "2"
req = "2001.2"
