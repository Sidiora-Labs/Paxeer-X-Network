do_1 = "In prepare_bound (agent/crates/layerx-agentd/src/prepare/mod.rs:371) replace the kernel envelope build with an Eip1559Call (agent/crates/layerx-crypto/src/evm_transaction.rs:9) whose nonce is the pending nonce read through the node boundary and whose gas is eth_estimateGas at pending."
do_2 = "Replace the StaleSequence check (agent/crates/layerx-agentd/src/prepare/mod.rs:384-390) with a refusal when the pending read fails, so a stale nonce is never used."
do_3 = "Return preimage = signing_hash (agent/crates/layerx-crypto/src/evm_transaction.rs:82) and canonical bytes = the unsigned RLP; prepare_activity (agent/crates/layerx-agentd/src/prepare/mod.rs:331), prepare_activity_for_protocol (:344) and prepare_budget_mutation_for_protocol (:361) all route through the same builder."
do_4 = "Build the disclosure by decoding calldata with the target construct ABI (layerxledger, layerxpay, layerxauth, layerxprograms) and include to, value, selector and the decoded arguments."
do_5 = "Add agent/crates/layerx-agentd/tests/evm_preimage_golden.rs with fixed unsigned RLP, preimage and signature vectors for each MCP native alias (send, register, mint, issueGrant, draw)."
symbols = ["prepare_bound", "prepare_activity", "PreparedTransaction", "decode_disclosure"]

