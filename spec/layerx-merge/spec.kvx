[feature.2]
name = "pay"
scope = "The layerxpay precompile at 0x101B over the kernel escrow, budget, stream and service modules: escrow holds, budgets with delegate spend and pull as kernel activity types, streams with a rate change that settles at the old rate first, services with disputes resolved by the linked escrow arbiter, the 0x101A per-request draw as a reference, read views, event logs, the per-method gas table, pause and retention, agent streams 0x0906 through the stream keeper, registration and parity."
requirements = ["2001", "2002", "2003", "2004", "2005", "2006", "2007", "2008", "2009", "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "2025", "2026", "2027", "2028", "2029", "2030", "2031", "2032"]
completion_task = "2.7.1"

[req.2001]
title = "Escrow open locks the holder's funds in a v3 custody account"
ac_1 = "escrowOpen refuses a zero amount with LXP_ERR_ZERO_AMOUNT before any state is read (src/modules/escrow/lx_escrow_module.c:190)."
ac_2 = "escrowOpen executes only when the resolved principal equals the holder field of the hold, otherwise LXP_ERR_UNAUTHORIZED_DEBIT (src/modules/escrow/lx_escrow_module.c:222-223)."
ac_3 = "validate_open requires the holder account kind AGENT_MAIN and the escrow account kind AGENT_ESCROW and refuses a paused asset with LXP_ERR_NON_CANONICAL (src/modules/escrow/lx_escrow_open.c:15-17, :26)."
ac_4 = "A second open with an escrowId that already has a hold record returns LXP_ERR_ESCROW_STATE (src/modules/escrow/lx_escrow_open.c:32-33)."
ac_5 = "A successful open moves the amount holder to escrow account with reason LXP_REASON_ESCROW_LOCK under LXP_AUTH_OWNER and commits the result keyed by the escrow id (src/modules/escrow/lx_escrow_open.c:54-63)."
ac_6 = "escrowOpen refuses a holder or escrow account whose asset differs from the escrow asset with LXP_ERR_ASSET_MISMATCH and an escrow id already stored with LXP_ERR_ESCROW_STATE (src/modules/escrow/lx_escrow_open.c:27-33)."

[req.2002]
title = "Escrow capture and partial capture pay the beneficiary under the capture authority"
ac_1 = "Capture is authorized for the beneficiary under any authority kind or for the holder only under LXP_AUTHORITY_DELEGATED_CAPABILITY; any other principal gets LXP_ERR_UNAUTHORIZED_CAPTURE (src/modules/escrow/lx_escrow_capture.c:18-26, :77-78)."
ac_2 = "A timed-out hold returns LXP_ERR_HOLD_EXPIRED, a disputed hold returns LXP_ERR_HOLD_DISPUTED, and a hold whose expiry has passed returns LXP_ERR_HOLD_EXPIRED without writing state (src/modules/escrow/lx_escrow_capture.c:66-75)."
ac_3 = "Full capture transfers the whole remaining escrow balance whatever amount was presented and sets state CAPTURED (src/modules/escrow/lx_escrow_capture.c:86, :110)."
ac_4 = "Partial capture refuses a zero amount or an amount equal to or above the remaining balance with LXP_ERR_CAPTURE_EXCEEDS_HOLD and otherwise sets PARTIALLY_CAPTURED (src/modules/escrow/lx_escrow_capture.c:87-90, :110-111)."
ac_5 = "A capture whose escrow account or asset differs from the hold returns LXP_ERR_CONTEXT_MISMATCH before the replay check (src/modules/escrow/lx_escrow_capture.c:50-52)."
ac_6 = "A capture replayed with the same idempotency key and the same bound context returns the stored receipt without a second transfer (src/modules/escrow/lx_escrow_capture.c:58-65)."
ac_7 = "A capture at or after the hold expiry returns LXP_ERR_HOLD_EXPIRED without touching hold state, balances or the idempotency record; the expiry sweep is the only writer of the timed-out state (src/modules/escrow/lx_escrow_capture.c:70-75)."
ac_8 = "A partial capture of zero, above the remaining hold or equal to the whole remaining hold returns LXP_ERR_CAPTURE_EXCEEDS_HOLD; the whole remainder is taken only by full capture (src/modules/escrow/lx_escrow_capture.c:86-90)."

[req.2003]
title = "Escrow release, timeout and the epoch expiry sweep return funds to the holder"
ac_1 = "A disputed hold refuses release and timeout with LXP_ERR_HOLD_DISPUTED and a terminal hold refuses them with LXP_ERR_ESCROW_STATE (src/modules/escrow/lx_escrow_timeout.c:46-48)."
ac_2 = "escrowTimeout is permissionless but returns LXP_ERR_NOT_YET_VALID when the hold has no expiry or the block-open time is before it (src/modules/escrow/lx_escrow_timeout.c:53-56)."
ac_3 = "escrowRelease requires the resolved principal to equal the holder, otherwise LXP_ERR_UNAUTHORIZED_DEBIT (src/modules/escrow/lx_escrow_timeout.c:57-59)."
ac_4 = "Release and timeout move the remaining balance to the holder with reason LXP_REASON_ESCROW_RELEASE, skip the transfer when nothing remains, and set lockedAmount 0 (src/modules/escrow/lx_escrow_timeout.c:68-83)."
ac_5 = "The epoch sweep collects active holds whose expiry is at or before the epoch timestamp and refuses a 25th expired hold in one epoch with LXP_ERR_ARENA_EXHAUSTED (src/modules/escrow/lx_escrow_timeout.c:114-118)."
ac_6 = "A timeout before the hold expiry or on a hold without expiry returns LXP_ERR_NOT_YET_VALID, and a release by anyone other than the holder returns LXP_ERR_UNAUTHORIZED_DEBIT (src/modules/escrow/lx_escrow_timeout.c:53-59)."
ac_7 = "The escrow epoch refuses an epoch or timestamp that does not match the batch with LXP_ERR_TIMESTAMP_REGRESSION (src/modules/escrow/lx_escrow_timeout.c:222-224)."

[req.2004]
title = "Escrow dispute open freezes a hold and the arbiter splits it by basis points"
ac_1 = "Dispute open is allowed to the holder or the beneficiary only, otherwise LXP_ERR_UNAUTHORIZED_DEBIT (src/modules/escrow/lx_escrow_dispute.c:8-14, :26-27)."
ac_2 = "Dispute open returns LXP_ERR_DISPUTE_WINDOW_CLOSED when the dispute window is 0 or the block-open time is past it, and otherwise sets DISPUTED (src/modules/escrow/lx_escrow_dispute.c:28-32)."
ac_3 = "Dispute resolve is allowed to the arbiter principal only, otherwise LXP_ERR_UNAUTHORIZED_DEBIT, and requires state DISPUTED, otherwise LXP_ERR_ESCROW_STATE (src/modules/escrow/lx_escrow_dispute.c:89-92)."
ac_4 = "Resolve pays floor(balance x bps / 10000) to the beneficiary and the remainder to the holder, refuses a sum that differs from the balance with LXP_ERR_CONSERVATION, and sets RESOLVED with lockedAmount 0 (src/modules/escrow/lx_escrow_dispute.c:35-47, :99-128)."
ac_5 = "A resolve with beneficiaryBps 0 or 10000 produces one zero leg that the ledger skips; a transfer set is refused only when every leg is zero (src/ledger/lxp_journal.c:222-227)."
ac_6 = "escrowDisputeOpen needs an active hold, a party to the hold and a nonzero dispute window not yet passed, else LXP_ERR_ESCROW_STATE, LXP_ERR_UNAUTHORIZED_DEBIT or LXP_ERR_DISPUTE_WINDOW_CLOSED (src/modules/escrow/lx_escrow_dispute.c:25-31)."
ac_7 = "escrowResolve needs a DISPUTED hold and the hold arbiter as caller, and the beneficiary and holder shares must sum to the remaining balance, else LXP_ERR_CONSERVATION (src/modules/escrow/lx_escrow_dispute.c:89-107)."

[req.2005]
title = "Budget create and fund move holder funds into a budget account under the budget authority"
ac_1 = "Every budget method requires authority kind LXP_AUTHORITY_OWNER and refuses other kinds with LXP_ERR_UNAUTHORIZED_DEBIT (src/modules/budget/lx_budget_module.c:266, :272)."
ac_2 = "budgetCreate on an existing budget id returns LXP_ERR_SEQUENCE_REUSED and a new budget stages its v3 custody account before the transfer (src/modules/budget/lx_budget_module.c:322, :325-327)."
ac_3 = "The module stores at most 128 budgets in memory and the 129th create returns LXP_ERR_ARENA_EXHAUSTED (include/layerx/lx_budget.h:14; src/modules/budget/lx_budget_module.c:143-144)."
ac_4 = "A successful create emits event type 1 with budgetId, assetId and amount and fund emits event type 2 with budgetId and amount (src/modules/budget/lx_budget_module.c:363-367, :396-399)."
ac_5 = "budgetCreate decodes the v1 211-byte payload and budgetCreateNative the v2 251-byte payload carrying the source account and sequence (include/layerx/lx_budget.h:32-33; src/modules/budget/lx_budget_codec.c:130-137)."
ac_6 = "A budget record needs a nonzero period limit and period length, an expiry after the period start, a known rollover policy and at most LX_BUDGET_MAX_DELEGATES delegates, and a zero carry cap when rollover is off (src/modules/budget/lx_budget_create.c:28-37)."
ac_7 = "budgetFund needs an agent main source account, an agent budget target and a nonzero amount, and moves the funds under LXP_REASON_BUDGET_FUND (src/modules/budget/lx_budget_create.c:66-77)."

[req.2006]
title = "Budget amend and the delegate set are changed by the holder only"
ac_1 = "budgetAmend checks the new period limit against the period cap and returns LXP_ERR_BUDGET_PERIOD_CAP when it is exceeded (src/modules/budget/lx_budget_module.c:417-418)."
ac_2 = "budgetAmend emits event type 3 with budgetId, the new per-period limit and expiry (src/modules/budget/lx_budget_module.c:428-432)."
ac_3 = "Adding a zero delegate returns LXP_ERR_NON_CANONICAL, a duplicate returns LXP_ERR_SEQUENCE_REUSED and a 17th delegate returns LXP_ERR_ARENA_EXHAUSTED (src/modules/budget/lx_budget_delegate.c:35-42; include/layerx/lx_budget.h:15)."
ac_4 = "Removing an absent delegate returns LXP_ERR_UNAUTHORIZED_DELEGATE and add/remove emit the activity ordinal as event type (src/modules/budget/lx_budget_delegate.c:61; src/modules/budget/lx_budget_module.c:452-454)."
ac_5 = "budgetAmend refuses a closed budget with LXP_ERR_UNKNOWN_FIELD, a revoked budget with LXP_ERR_BUDGET_REVOKED and a caller other than the holder with LXP_ERR_UNAUTHORIZED_DEBIT (src/modules/budget/lx_budget_module.c:411-414)."
ac_6 = "budgetAmend sets the period limit to the new configured limit plus the carried amount and keeps the configured limit, carry cap, expiry and rollover policy from the payload (src/modules/budget/lx_budget_module.c:415-425)."

[req.2007]
title = "Budget spend honours the period allowance, expiry and lazy rollover"
ac_1 = "budgetSpend is allowed to the holder or to an actor in the delegate set, otherwise LXP_ERR_UNAUTHORIZED_DELEGATE (src/modules/budget/lx_budget_module.c:470-472)."
ac_2 = "Spend refuses a closed or revoked budget, an expired budget with LXP_ERR_EXPIRED, an amount above the allowance with LXP_ERR_BUDGET_ALLOWANCE_EXCEEDED and above the balance with LXP_ERR_INSUFFICIENT_BUDGET_FUNDS (src/modules/budget/lx_budget_spend.c:61-72)."
ac_3 = "Remaining budget is the minimum of the period allowance left and the budget account balance (src/modules/budget/lx_budget_spend.c:35-52)."
ac_4 = "Rollover counts elapsed periods from period_start and under the CAPPED policy carries the unspent allowance up to carry_cap (src/modules/budget/lx_budget_period.c:6-17, :43-47)."
ac_5 = "Spend pays the recipient AGENT_MAIN account with reason BUDGET_SPEND and emits event type 6 with budgetId, recipient and amount (src/modules/budget/lx_budget_spend.c:100; src/modules/budget/lx_budget_module.c:492-496)."
ac_6 = "Spend refuses a closed budget with LXP_ERR_UNKNOWN_FIELD, a revoked one with LXP_ERR_BUDGET_REVOKED and one at or past expiry with LXP_ERR_EXPIRED, then rolls the period before checking the allowance and the balance (src/modules/budget/lx_budget_spend.c:60-73)."
ac_7 = "Rollover counts whole elapsed periods from the period start, refuses a batch time before the period start with LXP_ERR_TIMESTAMP_REGRESSION and a period advance that overflows u64 with LXP_ERR_OVERFLOW (src/modules/budget/lx_budget_period.c:6-38)."

[req.2008]
title = "Budget close, defund and revoke drain the budget back to its refund account"
ac_1 = "budgetClose and budgetRevoke require a revocation sequence above the stored one, otherwise LXP_ERR_STALE_REVOCATION (src/modules/budget/lx_budget_module.c:514-515)."
ac_2 = "Close drains the full balance to the refund account and emits event type 7 with the drained amount and revocation sequence (src/modules/budget/lx_budget_close.c:106-127; src/modules/budget/lx_budget_module.c:534-538)."
ac_3 = "Defund moves the requested amount out and lowers the per-period limit through lx_budget_defund_limit (src/modules/budget/lx_budget_close.c:62-104)."
ac_4 = "Revoke drains the balance, sets revoked and pins per_period_limit to the amount already spent, emitting event type 9 (src/modules/budget/lx_budget_close.c:129-134; src/modules/budget/lx_budget_module.c:628-632)."
ac_5 = "budgetDefund refuses a zero amount with LXP_ERR_INVALID_AMOUNT and an amount above the budget balance with LXP_ERR_INSUFFICIENT_BUDGET_FUNDS (src/modules/budget/lx_budget_close.c:69-72)."
ac_6 = "budgetClose of a budget funded from a native business source refunds the remaining balance to that source account (src/modules/budget/lx_budget_module.c:521-524)."

[req.2009]
title = "Budget delegate spend executes through a kernel activity type with a persisted delegate capability"
ac_1 = "Required change: the budget activity list gains LX_BUDGET_DELEGATE_SPEND at ordinal 10 (0x0003000a) after LX_BUDGET_REVOKE, and module_decode stops returning LXP_ERR_UNKNOWN_ACTIVITY for it (include/layerx/lx_budget.h:16-24; src/modules/budget/lx_budget_module.c:12-16, :650-651)."
ac_2 = "Delegate spend is authorized by lx_budget_authorize_delegate: the submitter is in the delegate set and the capability matches holder, asset, recipient, purpose, expiry, revocation sequence and per-spend and total caps, else LXP_ERR_UNAUTHORIZED_DELEGATE (src/modules/budget/lx_budget_delegate.c:71-99)."
ac_3 = "Required change: the delegate capability (include/layerx/lx_budget.h:102-113) is stored in the budget kv store so consumed accumulates across activities, replacing the in-memory store lookup of lx_budget_delegate_spend_execute (src/modules/budget/lx_budget_delegate.c:112)."
ac_4 = "A delegate spend whose budget spend fails leaves consumed at its value before the activity (src/modules/budget/lx_budget_delegate.c:115-122)."
ac_5 = "Required change: budgetDelegateSpend on 0x101B builds the delegate-spend payload and runs decode, validate and execute of ordinal 10 through the shim (contracts/pay.md A.2; src/modules/budget/lx_budget_module.c:719-761)."
ac_6 = "Delegate spend uses the same spend checks as the holder, so a delegate never gets past the period allowance or the budget balance (src/modules/budget/lx_budget_spend.c:68-73)."

[req.2010]
title = "Budget pull executes through a kernel activity type and records the grant draw"
ac_1 = "Required change: the budget activity list gains LX_BUDGET_PULL at ordinal 11 (0x0003000b) whose execute branch reaches lx_budget_pull_execute (src/modules/budget/lx_budget_delegate.c:146-163; src/modules/budget/lx_budget_module.c:719-761)."
ac_2 = "Pull is authorized by the payer grant: lxp_verify_payer_grant against the holder account, then grant.from equals the record holder, recipient, asset and purpose match, amount within per-draw maximum and allowance, expiration not passed and revocation sequence equal, else LXP_ERR_GRANT_SCOPE_VIOLATION (src/modules/budget/lx_budget_delegate.c:126-144)."
ac_3 = "Required change: every successful pull records the drawn amount against the grant through lxp_grant_draw_record, which lx_budget_pull_execute does not call today (src/ledger/lxp_grant_store.c:123; src/modules/budget/lx_budget_delegate.c:146-163)."
ac_4 = "Required change: a pull against a revoked grant is refused with LXP_ERR_GRANT_REVOKED using the stored grant state (include/layerx/lxp_ledger.h:229-235; src/ledger/lxp_receive.c:419-420)."
ac_5 = "Required change: budgetPull on 0x101B carries the canonical lxp_payer_grant bytes and executes ordinal 11; its draw totals share the grant store used by the 0x101A draw (include/layerx/lxp_ledger.h:198-214; src/ledger/lxp_receive.c:434)."
ac_6 = "A pull refused for allowance or balance leaves the period counters as they were, because the allowance debit runs only after both checks (src/modules/budget/lx_budget_spend.c:68-73)."

[req.2011]
title = "Stream open and top-up fund a v3 stream account from the payer"
ac_1 = "Stream authority accepts kinds LXP_AUTHORITY_OWNER, SESSION_KEY and DELEGATED_CAPABILITY with a nonzero principal and charges payload_length+1 kernel gas (src/modules/stream/lx_stream_open.c:157-163)."
ac_2 = "The open payload is 204 bytes plus 32 bytes per meter authority, with zero fields, non-ascending authorities and streamAccount equal to recipient refused with LXP_ERR_NON_CANONICAL (include/layerx/lx_stream.h:14-25; src/modules/stream/lx_stream_payload.c:135-157)."
ac_3 = "An open whose stream id already has a record returns LXP_ERR_SEQUENCE_REUSED (src/modules/stream/lx_stream_open.c:276-277)."
ac_4 = "Open sets the payer to the resolved principal, stages the v3 stream custody account and funds it with reason STREAM_FUND under LXP_AUTH_OWNER (src/modules/stream/lx_stream_execution.h:162-167; src/modules/stream/lx_stream_open.c:204-232)."
ac_5 = "Top-up is allowed to the payer only, otherwise LXP_ERR_UNAUTHORIZED_DEBIT, and clears the underfunded flag (src/modules/stream/lx_stream_execution.h:199-200; src/modules/stream/lx_stream_open.c:288-321)."
ac_6 = "streamOpen sets the payer to the calling principal before validation and refuses a stream id already stored with LXP_ERR_SEQUENCE_REUSED (src/modules/stream/lx_stream_open.c:106-113)."

[req.2012]
title = "Stream metering accrues against signed cumulative readings"
ac_1 = "A meter attestation verifies ed25519 over the tag LXP:STREAM:METER:v1, stream id, reading and authority key, from a key listed in the stream record, otherwise LXP_ERR_UNAUTHORIZED_METER (src/modules/stream/lx_stream_meter.c:7-56)."
ac_2 = "A reading below the stored cumulative meter returns LXP_ERR_METER_REGRESSION and an equal reading accrues nothing (src/modules/stream/lx_stream_meter.c:75-80)."
ac_3 = "Metered accrual adds floor((rate x delta + carry) / rate_unit) clamped to the remaining total cap (src/modules/stream/lx_stream_meter.c:58-111)."
ac_4 = "TIME streams refuse meter readings because lx_stream_accrue serves TIME mode only and metered accrual serves METERED only (src/modules/stream/lx_stream_accrue.c:48-50; src/modules/stream/lx_stream_meter.c:70-72)."
ac_5 = "The meter attestation preimage is the 19-byte tag followed by 72 bytes of stream id, reading and key, refused with LXP_ERR_LENGTH_LIMIT when the buffer is short (src/modules/stream/lx_stream_meter.c:10-16)."
ac_6 = "Metered accrual arithmetic that overflows u128 returns LXP_ERR_ACCRUAL_OVERFLOW and writes nothing (src/modules/stream/lx_stream_meter.c:86, :95, :104)."
ac_7 = "A meter reading before the stream start or the last accrual returns LXP_ERR_NON_MONOTONIC_TIME and one after a nonzero stream end returns LXP_ERR_EXPIRED (src/modules/stream/lx_stream_open.c:87-96)."

[req.2013]
title = "Stream settle pays accrued value up to the stream balance and marks underfunding"
ac_1 = "TIME accrual is floor((rate x elapsed_ms + carry) / rate_unit), skipped while closed, paused or underfunded, and clamped to the total cap (src/modules/stream/lx_stream_accrue.c:54-74)."
ac_2 = "Settle is allowed to the payer or the recipient only, otherwise LXP_ERR_UNAUTHORIZED_DEBIT (src/modules/stream/lx_stream_execution.h:257-259)."
ac_3 = "A settle key already stored for another stream or another ordinal returns LXP_ERR_CONTEXT_MISMATCH and the same key for the same stream returns the stored result (src/modules/stream/lx_stream_settle.c:114-122)."
ac_4 = "Settle pays min(unsettled, balance) with reason STREAM_DRAW and marks the stream underfunded when unsettled exceeds a zero balance (src/modules/stream/lx_stream_settle.c:142-150; src/modules/stream/lx_stream_settle.c:34-52)."
ac_5 = "A closed stream refuses settle with LXP_ERR_STREAM_CLOSED and a block time before the last accrual returns LXP_ERR_NON_MONOTONIC_TIME (src/modules/stream/lx_stream_settle.c:125, :131-132)."
ac_6 = "Settle refuses a closed stream with LXP_ERR_STREAM_CLOSED, a stream account, recipient or asset that differs from the record with LXP_ERR_NON_CANONICAL, and a batch time before the last accrual with LXP_ERR_NON_MONOTONIC_TIME (src/modules/stream/lx_stream_settle.c:123-132)."
ac_7 = "A stream account is debited only by the stream module with protocol-module authority and a draw or refund reason; any other debit returns LXP_ERR_UNAUTHORIZED_DEBIT (src/modules/stream/lx_stream_settle.c:12-21)."

[req.2014]
title = "Stream pause, resume and close are payer actions that keep accrual exact"
ac_1 = "Pause, resume and close load the stream for the payer only, otherwise LXP_ERR_UNAUTHORIZED_DEBIT (src/modules/stream/lx_stream_lifecycle.c:9-22)."
ac_2 = "Pause accrues a TIME stream to the block-open time before setting paused, and resume resets last_accrual to the block-open time so the paused interval accrues nothing (src/modules/stream/lx_stream_lifecycle.c:24-58)."
ac_3 = "Close is idempotent by key, accrues unless paused or underfunded, pays min(unsettled, balance) to the recipient with STREAM_DRAW and refunds the rest to the payer with STREAM_REFUND (src/modules/stream/lx_stream_lifecycle.c:87-174)."
ac_4 = "The stream epoch hook charges gas 1 and performs no time settlement (src/modules/stream/lx_stream_open.c:179-185)."
ac_5 = "Pausing a paused stream and resuming a running stream return LXP_OK without a write (src/modules/stream/lx_stream_lifecycle.c:32, :51)."
ac_6 = "Pause and resume refuse a block time before the last accrual with LXP_ERR_NON_MONOTONIC_TIME (src/modules/stream/lx_stream_lifecycle.c:33-35, :52-54)."

[req.2015]
title = "Stream rate change settles accrual at the old rate before the new rate applies"
ac_1 = "Required change: the stream activity list gains LX_STREAM_RATE_CHANGE at ordinal 8 (0x00040008) after LX_STREAM_CLOSE with an 82-byte payload: header, stream id, new rate and idempotency key (include/layerx/lx_stream.h:14-32; src/modules/stream/lx_stream_open.c:8-11)."
ac_2 = "Required change: rate change is allowed to the payer only and is refused on a closed stream with LXP_ERR_STREAM_CLOSED (src/modules/stream/lx_stream_lifecycle.c:9-22; src/modules/stream/lx_stream_settle.c:125)."
ac_3 = "Required change: rate change first runs the settle path at the old rate up to the block-open time and only then writes the new rate, keeping last_accrual and remainder_carry from that settle (src/modules/stream/lx_stream_settle.c:95-188; src/modules/stream/lx_stream_accrue.c:82-83)."
ac_4 = "Required change: rate change emits event type 8 carrying the stream id, old rate, new rate and the amount paid by its settle, which 0x0906 updateRate logs as StreamRateUpdated; the 0x101B ABI gains no method for it (src/modules/stream/lx_stream_execution.h:105-118)."
ac_5 = "A rate-change key replayed for the same stream returns the stored result; the same key on another stream returns LXP_ERR_CONTEXT_MISMATCH (src/modules/stream/lx_stream_state.c:97-157)."
ac_6 = "Time accrual refuses a batch time before the last accrual with LXP_ERR_NON_MONOTONIC_TIME and any u128 overflow with LXP_ERR_ACCRUAL_OVERFLOW, so a rate change never settles across a time regression (src/modules/stream/lx_stream_accrue.c:9-13, :58-76)."

[req.2016]
title = "Service offers and agreements are records only and move no balance"
ac_1 = "Any transfer effect produced by a service activity is turned into LXP_FATAL_INVARIANT by lx_service_effect_audit (src/modules/service/lx_service_dispute.c:106-124)."
ac_2 = "serviceOfferPublish binds the offering agent to the resolved principal and serviceOfferWithdraw is allowed to that agent only (src/modules/service/lx_service_module.c:75; src/modules/service/lx_service_offer.c:56-77)."
ac_3 = "serviceAgreementPropose sets the buyer to the principal, refuses a buyer equal to the offering agent and a zero escrow id, and stores the escrow id on the agreement (src/modules/service/lx_service_agreement.c:8-61; src/modules/service/lx_service_payload.c:84-88)."
ac_4 = "serviceAgreementAccept is allowed to the provider only and moves the agreement to FORMED (src/modules/service/lx_service_agreement.c:63-97)."
ac_5 = "serviceOfferWithdraw refuses an offer already withdrawn, already accepted or past its expiry with LXP_ERR_OFFER_UNAVAILABLE (src/modules/service/lx_service_offer.c:66-69)."
ac_6 = "serviceAgreementPropose refuses a terms hash different from the offer terms hash with LXP_ERR_TERMS_MISMATCH and a reused agreement id with LXP_ERR_SEQUENCE_REUSED (src/modules/service/lx_service_agreement.c:33-37)."
ac_7 = "serviceAgreementPropose refuses an acceptance window that ends before the delivery deadline or a dispute window that ends before the acceptance window with LXP_ERR_OVERFLOW (src/modules/service/lx_service_agreement.c:48-53)."

[req.2017]
title = "Service commitment, progress and delivery follow the agreement state machine"
ac_1 = "serviceCommitTask is allowed to the agreement provider while the agreement is FORMED and moves it to COMMITTED (src/modules/service/lx_service_commit.c:26-60)."
ac_2 = "serviceProgressReport requires progress strictly above the high-water mark and at most 10000 basis points, otherwise LXP_ERR_METER_REGRESSION or LXP_ERR_PARAMETER_BOUNDS (src/modules/service/lx_service_commit.c:99-151; src/modules/service/lx_service_state.c:899)."
ac_3 = "serviceDeliver requires every deliverable hash to equal the offer deliverable spec hash, otherwise LXP_ERR_DELIVERABLE_MISMATCH, and moves COMMITTED to DELIVERED (src/modules/service/lx_service_deliver.c:8-62, :63)."
ac_4 = "serviceCommitAbandon is allowed to the commitment provider and returns the agreement to FORMED (src/modules/service/lx_service_commit.c:61-98)."
ac_5 = "serviceDeliver is accepted while the agreement is COMMITTED or LX_SERVICE_AGREEMENT_REJECTED, from the agreement provider only, else LXP_ERR_AGREEMENT_STATE, and past the delivery deadline returns LXP_ERR_DELIVERY_DEADLINE_PASSED (src/modules/service/lx_service_deliver.c:80-87)."
ac_6 = "Every deliverable needs a nonzero artifact size and a nonzero availability reference, otherwise LXP_ERR_DA_MISSING, and a reused delivery id returns LXP_ERR_SEQUENCE_REUSED (src/modules/service/lx_service_deliver.c:26-28, :91-93)."
ac_7 = "serviceProgressReport refuses a report after the commitment deadline with LXP_ERR_DELIVERY_DEADLINE_PASSED (src/modules/service/lx_service_commit.c:132-138)."

[req.2018]
title = "Service acceptance, rejection and the default outcome close a delivery"
ac_1 = "serviceAccept and serviceReject are allowed to the buyer while the agreement is DELIVERED and the acceptance window is open (src/modules/service/lx_service_acceptance.c:8-27)."
ac_2 = "serviceReject stores the sorted contested hashes and moves the agreement to LX_SERVICE_AGREEMENT_REJECTED (src/modules/service/lx_service_acceptance.c:57-91; include/layerx/lx_service.h:101-110)."
ac_3 = "The service epoch applies the offer default outcome to DELIVERED agreements past the acceptance window and emits event 14 (src/modules/service/lx_service_acceptance.c:121-174; include/layerx/lx_service.h:33-47)."
ac_4 = "Service maintenance visits one agreement per call and the kernel registers the escrow, budget and service maintenance hooks and none for stream (src/modules/service/lx_service_acceptance.c:176-201; src/protocol/lxp_kernel.c:5545-5547)."
ac_5 = "serviceReject requires every contested hash to be one of the delivered deliverable hashes, otherwise LXP_ERR_DELIVERABLE_MISMATCH (src/modules/service/lx_service_acceptance.c:71-77)."
ac_6 = "The service epoch refuses an epoch or timestamp that does not match the batch with LXP_ERR_TIMESTAMP_REGRESSION, and the default outcome records the outcome sequence and timestamp (src/modules/service/lx_service_acceptance.c:155-160, :166-171)."

[req.2019]
title = "Tool execution attestation on the EVM path binds the caller key and the activity key"
ac_1 = "The attestation grant is built from the submitting authority: attestorIdentity must equal the principal and publicKey must equal verified_key (src/modules/service/lx_service_module.c:197-220)."
ac_2 = "The attestation signature is ed25519 over the tag LXP:SERVICE:ATTEST:v1 and the execution fields, verified with the grant key (src/modules/service/lx_service_attest.c:8, :102-142)."
ac_3 = "The commitment named by the execution must belong to the submitting provider (src/modules/service/lx_service_attest.c:132)."
ac_4 = "Required change: on 0x101B the payload activityId is compared with the executing activity idempotency key, because the activity id hashes the canonical encoding that carries the payload (src/modules/service/lx_service_module.c:205-206; src/protocol/lxp_kernel.c:379-381)."
ac_5 = "A reused attestation id returns LXP_ERR_SEQUENCE_REUSED and the stored execution records the global sequence of the attesting activity (src/modules/service/lx_service_attest.c:160-164)."
ac_6 = "The canonical execution bytes are copied into the stored record only when the encoding succeeds and fits the stored canonical payload, otherwise the call returns the encoding error or LXP_ERR_LENGTH_LIMIT and nothing is stored (src/modules/service/lx_service_attest.c:165-168)."

[req.2020]
title = "Service disputes are resolved by the arbiter of the linked escrow, which settles on the ruling"
ac_1 = "Required change: dispute resolve replaces the agreement_party rule with the arbiter rule: the resolver principal equals the linked escrow arbiter, a party is refused with LXP_ERR_UNAUTHORIZED_ARBITER and a non-DISPUTED agreement keeps LXP_ERR_UNAUTHORIZED_DISPUTANT (src/modules/service/lx_service_dispute.c:8-13, :87-90)."
ac_2 = "Required change: at dispute open and resolve the linked escrow must exist with holder equal to the buyer, beneficiary equal to the provider and asset equal to the offer asset, otherwise LXP_ERR_ESCROW_LINK_MISMATCH; a zero arbiter returns LXP_ERR_ARBITER_REQUIRED (src/modules/escrow/lx_escrow_module.c:222-223; src/modules/escrow/lx_escrow_open.c:8-35)."
ac_3 = "Required change: serviceDisputeOpen runs the escrow dispute-open sub-op in the same call, so the linked hold becomes DISPUTED and release, timeout, capture and the epoch sweep stop (src/modules/escrow/lx_escrow_dispute.c:25-32; src/modules/escrow/lx_escrow_timeout.c:46-47, :114)."
ac_4 = "Required change: serviceDisputeResolve then runs the escrow dispute-resolve sub-op with beneficiaryBps := providerBps and idempotency key := escrowResolutionId, paying the provider floor(balance x bps / 10000) and the buyer the rest in one ESCROW_RESOLVE transfer set (src/modules/escrow/lx_escrow_dispute.c:49-133)."
ac_5 = "Required change: both sub-ops run in one precompile call service first; any failure reverts the whole call and the service activity still moves no balance (src/modules/service/lx_service_dispute.c:106-124)."
ac_6 = "Required change: the three new codes LXP_ERR_ARBITER_REQUIRED, LXP_ERR_UNAUTHORIZED_ARBITER and LXP_ERR_ESCROW_LINK_MISMATCH follow LXP_ERR_PROGRAM_REFUSED in the result list with proposed values -737, -738 and -739, final values set at activation rehearsal (include/layerx/lxp_result.h:141)."

[req.2021]
title = "The 402LXP per-request draw lands natively at 0x101A and is referenced by 0x101B"
ac_1 = "The draw executes LX_ASSET_RECEIVE 0x00010006 through lxp_receive_execute, verifying the payer grant and recording the drawn total (include/layerx/lx_asset.h:26; src/ledger/lxp_receive.c:383-445; src/ledger/lxp_grant_store.c:72-99, :123-155)."
ac_2 = "The draw transfer carries reason LXP_REASON_PAYMENT and calls lxp_grant_draw_record before the transfer (src/ledger/lxp_receive.c:434, :442)."
ac_3 = "The draw is not part of the 0x101B ABI: layerxpay registers no draw method, and budgetPull draws against the same grant store (contracts/pay.md A.5; src/modules/budget/lx_budget_delegate.c:131)."
ac_4 = "The payer grant record is the canonical lxp_payer_grant encoding with total, per-draw maximum, expiration and revocation sequence (include/layerx/lxp_ledger.h:198-214)."
ac_5 = "A draw to another recipient, of another asset or above the per-draw maximum returns LXP_ERR_GRANT_SCOPE_VIOLATION before any draw is recorded (src/ledger/lxp_receive.c:425-428)."
ac_6 = "The grant state is copied before the draw record so a failed transfer restores it (src/ledger/lxp_receive.c:433-436)."

[req.2022]
title = "EVM callers reach the kernel modules with an authority resolved from the 0x1004 binding"
ac_1 = "The keeper resolves the caller's did:layerx public key from the EVM address through GetLayerXDid and refuses an unbound caller with LXP_UNAUTHORIZED_DEBIT before any kernel call (modules/evm/keeper/layerx_binding.go:18-26)."
ac_2 = "The resolved authority has kind LXP_AUTHORITY_OWNER, principal and verified_key equal to the bound key, matching the kind that budget_authorized_signer requires (src/modules/budget/lx_budget_module.c:266-268)."
ac_3 = "Required change: on the EVM path the budget envelope re-verification of payload hash and ed25519 signature is replaced by the shim-built authority, while the AGENT_MAIN signer check and the sequence check stay (src/modules/budget/lx_budget_module.c:277-292)."
ac_4 = "v3 custody account ids are computed from the DID string did:layerx:+hex(key) and the segment escrow, budget or stream, as lxp_ctx_account_stage_module_custody stages them (src/protocol/lxp_module_ctx.c:855, :884-886)."
ac_5 = "Delegated kinds come from a D3 authz grant whose LayerX-scope authorization covers the method's activity type; escrow capture by the holder needs LXP_AUTHORITY_DELEGATED_CAPABILITY (src/modules/escrow/lx_escrow_capture.c:18-26; src/modules/governance/lxp_governance.c:457-490)."

[req.2023]
title = "Every refusal reverts with Error(string) carrying the kernel code name"
ac_1 = "The precompile is built WithRevertReasons, so a failed call returns Error(string) with the error text (precompiles/common/precompiles.go:52-66, :82-92)."
ac_2 = "The revert text is LXP_ followed by the kernel name without the LXP_ERR_ prefix, taken from lxp_result_name, with no translation table kept in Go (include/layerx/lxp_result.h:29, :163)."
ac_3 = "Fatal kernel results surface as LXP_FATAL_INVARIANT and abort the transaction rather than being retried (src/modules/service/lx_service_dispute.c:106-124)."
ac_4 = "The three new dispute codes map like any other kernel code once added to the result list (include/layerx/lxp_result.h:140-141)."
ac_5 = "RevertReason packs the error text as Error(string) with selector 0x08c379a0 (precompiles/common/precompiles.go:59-66)."
ac_6 = "Every existing kernel value stays unchanged when the three dispute codes are appended, so recorded receipts keep their error bytes (include/layerx/lxp_result.h:29-141)."

[req.2024]
title = "Read views return kernel records without writing state"
ac_1 = "getEscrow, escrowRemaining and getEscrowResult read through lx_escrow_lookup, lx_escrow_remaining and lx_escrow_result_lookup (src/modules/escrow/lx_escrow_state.c:237, :351; src/modules/escrow/lx_escrow_capture.c:8-16)."
ac_2 = "getBudget reads through the exported lx_budget_read helper that first-wave task 2.9 adds over the kv record, and budgetRemaining runs lx_budget_remaining after lx_budget_rollover on a copy (src/modules/budget/lx_budget_spend.c:35; src/modules/budget/lx_budget_period.c:19-55)."
ac_3 = "getStream reads lx_stream_load and streamAccrued runs lx_stream_accrue on a copy at the block-open time and never saves; METERED streams return the stored totals (src/modules/stream/lx_stream_state.c:37; src/modules/stream/lx_stream_accrue.c:34, :48-50)."
ac_4 = "Service views read the offer, agreement, commitment, execution, delivery, progress and dispute lookups (src/modules/service/lx_service_state.c:240, :395, :502, :539, :700, :758, :860, :899, :1023)."
ac_5 = "Views are charged the read class and run with readOnly true so no write reaches the store (precompiles/common/precompiles.go:177-196)."

[req.2025]
title = "Kernel events are re-emitted as EVM logs at 0x101B"
ac_1 = "Escrow events types 1..7 carry the 67-byte body of lx_escrow_event_body and become EscrowOpened through EscrowResolved (src/modules/escrow/lx_escrow_state.c:489; include/layerx/lx_escrow.h:33)."
ac_2 = "Budget events types 1..9 map to BudgetCreated through BudgetRevoked with the body sizes of the emission sites (src/modules/budget/lx_budget_module.c:363-367, :396-399, :534-538, :593-598, :628-632)."
ac_3 = "Stream events types 1..7 map to StreamOpened through StreamClosed and type 8 is the rate-change event (src/modules/stream/lx_stream_execution.h:60, :77, :90, :105, :120, :133)."
ac_4 = "Service events 1..14 carry the 73-byte body (primary, secondary, code, sequence) of lx_service_emit (src/modules/service/lx_service_state.c:1040; include/layerx/lx_service.h:33-47)."
ac_5 = "A reverted call emits no log because kernel events are re-emitted only after the kernel commit (src/protocol/lxp_module_ctx.c:3126)."

[req.2026]
title = "Gas is a fixed per-method table plus a per-byte term, and module fees stay kernel accounting"
ac_1 = "RequiredGas returns the D.2 flat value for the method plus 30 per input byte for write and heavy classes and 1000 + 3 per byte for views (precompiles/common/precompiles.go:286-292)."
ac_2 = "Heavy methods are serviceToolExecAttest and streamMeter at 38000 and the two dispute methods at 50000 and 100000, which run two kernel activities (src/modules/stream/lx_stream_meter.c:27-56; src/modules/service/lx_service_attest.c:102-142)."
ac_3 = "Kernel validate gas of payload_length+1 is kernel accounting and is not added to EVM gas (src/modules/escrow/lx_escrow_module.c:176; src/modules/budget/lx_budget_module.c:716; src/modules/stream/lx_stream_open.c:163; src/modules/service/lx_service_module.c:61)."
ac_4 = "Module fee prices fee.module.escrow, budget, stream and service stay in lxp_fee_compute and are not charged a second time in EVM gas (src/protocol/lxp_fee.c:33-39, :185)."
ac_5 = "The numbers in the table are provisional and their final values are set at activation rehearsal; the table lives in one Go file (precompiles/common/precompiles.go:286-292)."

[req.2027]
title = "Pause and module enable gate every write except the exit set"
ac_1 = "Writes check the governance pause scope for the method's module (escrow 2, budget 3, stream 4, service 5) before the kernel call and refuse with LXP_PAUSED_SCOPE (src/modules/governance/lxp_emergency.c:139-161; include/layerx/lxp_result.h:140)."
ac_2 = "The exit set escrowRelease, escrowTimeout, budgetClose, budgetDefund, budgetRevoke, streamPause, streamClose, serviceOfferWithdraw and serviceCommitAbandon skips the check as cancellation_or_exit_path does (src/modules/governance/lxp_emergency.c:147)."
ac_3 = "The Paused flag in the layerxpay genesis refuses every write except the exit set and starts true, as xweb ships dormant (modules/xweb/types/genesis.go:11-27)."
ac_4 = "A missing module runtime returns LXP_MODULE_DISABLED and each module stays behind LXP_GENESIS_MODULE_GATE_ENABLE_FLAG (src/modules/escrow/lx_escrow_module.c:380; src/protocol/lxp_genesis.c:55-62)."
ac_5 = "Views stay readable while paused (src/modules/governance/lxp_emergency.c:139-161)."

[req.2028]
title = "Keyed methods keep admitting new keys under a retention window"
ac_1 = "Today the idempotency store refuses a new key with LXP_ERR_ARENA_EXHAUSTED once 8192 entries exist (src/state/lxp_idempotency.c:96-109)."
ac_2 = "The retention window pruned by global sequence is owned by first-wave tasks 0.90 and 3.90 in C and keeper alike; layerxpay adds no store of its own for activity keys (src/state/lxp_idempotency.c:107-108)."
ac_3 = "Escrow, stream and budget result records keep their own key families so a replay inside the window returns the stored result (src/modules/escrow/lx_escrow_state.c:351, :436; src/modules/stream/lx_stream_state.c:97)."
ac_4 = "A key replayed after its entry was pruned is treated as new only for the activity store; the module result record still answers the replay (src/modules/stream/lx_stream_settle.c:114-122)."
ac_5 = "The store size is LXP_STATE_MAX_IDEMPOTENCY entries allocated once per store (src/state/lxp_idempotency.c:90-93)."

[req.2029]
title = "Agent streams 0x0906 execute through the 0x101B stream keeper with one stream state"
ac_1 = "The keeper exposes Go methods for open, settle, close, rate change, getStream and accrued that 0x0906 calls; 0x0906 keeps no stream store (src/modules/stream/lx_stream_execution.h:353; src/modules/stream/lx_stream_state.c:37)."
ac_2 = "open maps ratePerSecond to rate with rateUnit 1000 and seconds to milliseconds, and funds initialFunding := cap (src/modules/stream/lx_stream_accrue.c:57-66)."
ac_3 = "Settle by payer or recipient and close by payer only are the kernel narrowing that 0x0906 accepts (src/modules/stream/lx_stream_execution.h:257-259; src/modules/stream/lx_stream_lifecycle.c:19-20)."
ac_4 = "The stream id and the settle and close keys are chain-derived nonzero bytes32 values passed by 0x0906 (src/modules/stream/lx_stream_payload.c:135, :258-260)."
ac_5 = "updateRate reaches the rate-change keeper method and logs StreamRateUpdated (include/layerx/lx_stream.h:26-32)."

[req.2030]
title = "layerxpay is registered at 0x101B behind its upgrade and wired into the application"
ac_1 = "GetCustomPrecompiles adds 0x101B behind a LayerXPayUpgrade semver gate, following the xweb gate (precompiles/setup.go:63-97, :93-95)."
ac_2 = "NewPrecompile builds the executor from keepers.LayerXPayK() with WithRevertReasons, as the custody precompile does (precompiles/layerxcustody/layerxcustody.go:150-161)."
ac_3 = "The Keepers interface and EmptyKeepers gain LayerXPayK, and the node PrecompileKeepers return the application keeper (precompiles/utils/expected_keepers.go:32, :51, :83; node/precompiles.go:63, :89)."
ac_4 = "The application constructs the layerxpay keeper and registers its AppModule beside the custody module (node/app.go:469, :782, :974)."
ac_5 = "The keeper enables each kernel module only when its genesis gate flag is set (src/protocol/lxp_genesis.c:55-62)."

[req.2031]
title = "Replay identity and parity vectors cover every pay activity type"
ac_1 = "The replay identity lists gain 0x0003000a, 0x0003000b and 0x00040008 next to the existing escrow, budget, stream and service types (tests/test_replay_crossarch.c:9-27; tests/qualification/lxp_qual_replay.c:38-46)."
ac_2 = "DEFUND 0x00030008 and REVOKE 0x00030009 replay cases are owned by first-wave task 2.9 and are not added twice (tests/test_replay_crossarch.c:9-27)."
ac_3 = "Every E-section vector has a keeper test that runs the same inputs through 0x101B and asserts the same results as the C test (tests/modules/test_escrow_open.c:1)."
ac_4 = "Rewritten dispute vectors replace the party resolver with the arbiter and keep transfer_calls 0 for the service activity (tests/modules/test_service_dispute.c:488-497, :522-529)."
ac_5 = "The fixture generator derives the corpus from the per-module ordinal ranges, so extending module 3 to 11 and module 4 to 8 adds the new records without moving older ones (scripts/replica/lxp_replay_fixture.py:9-13, :51-70)."
ac_6 = "LXP_QUAL_ACTIVITY_TYPE_COUNT sizes the qualification list and the fuzz seed loop, so both grow together (include/layerx/lxp_qualification.h:11; tests/test_fuzz_smoke.c:143)."

[req.2032]
title = "Rows kept at kernel parity or served outside this precompile"
ac_1 = "Budget list views are out of scope for this feature: budgets are keyed by id only and the indexer serves lists (src/modules/budget/lx_budget_codec.c:22-28)."
ac_2 = "An external metering provider is out of scope for this feature: the chain verifies only the listed ed25519 meter keys (src/modules/stream/lx_stream_meter.c:27-56)."
ac_3 = "A service dispute keeps no timeout of its own at parity because service never holds funds; the linked escrow keeps its own expiry (src/modules/service/lx_service_dispute.c:106-124; src/modules/escrow/lx_escrow_timeout.c:53-56)."
ac_4 = "Budget delegate add and remove stay exact kernel parity: the delegate set is part of the budget record and list views stay with the indexer (src/modules/budget/lx_budget_delegate.c:35-61)."
ac_5 = "The stream epoch stays a gas-only hook at parity; no time settlement runs at epoch boundaries (src/modules/stream/lx_stream_open.c:179-186)."

