[acceptance.6.1.1]
feature = "6"
req = "6001.1"
scenario = "Given the orob precompile at 0x0901 registered at the merge plan height, when a transaction calls it with selector 0xdeadbeef and 4 bytes of input, then RequiredGas returns 3000 and the call reverts with Error(string) beginning LXP_PRECOMPILE_UNKNOWN_METHOD."
contract = "contracts/agent-functions.md#a0-error-codes"
test = "precompiles/layerxagent/common/common_test.go::TestUnknownSelectorGasAndRevert"
qualification = "UNRUN"

[acceptance.6.1.2]
feature = "6"
req = "6001.2"
scenario = "Given a contract that delegatecalls 0x0905 schedule with a 1 PAX deposit, when the call executes, then it reverts with LXP_AGENT_DELEGATECALL and no job id 1 exists; given a staticcall to 0x0906 settle(7), then it reverts with LXP_AGENT_READ_ONLY."
contract = "contracts/agent-functions.md#a0-error-codes"
test = "precompiles/layerxagent/common/common_test.go::TestDelegatecallAndStaticRefused"
qualification = "UNRUN"

[acceptance.6.1.3]
feature = "6"
req = "6001.3"
scenario = "Given a node at height 99 with the merge plan at height 100, when eip712 0x0908 hashTypedData is called, then it reverts with an LXP_ code and no gas beyond the fixed read cost is charged; at height 100 the same call returns the digest."
contract = "contracts/agent-functions.md#a-methods"
test = "precompiles/layerxagent/common/common_test.go::TestHeightGateBeforePlan"
qualification = "UNRUN"

[acceptance.6.1.4]
feature = "6"
req = "6001.4"
scenario = "Given computeClearing input of 260 bytes, when RequiredGas is evaluated, then it returns 6000 + 3 x 260 = 6780; given cancel input of 36 bytes, then it returns 20000 + 30 x 36 = 21080."
contract = "contracts/agent-functions.md#d2-gas-table"
test = "precompiles/layerxagent/common/common_test.go::TestGasTable"
qualification = "UNRUN"

[acceptance.6.2.1]
feature = "6"
req = "6002.1"
scenario = "Given oraclePrice 2000000 and offsetBps 250, when resolveOffset is called, then it returns 2050000; given offsetBps -10000, then it reverts with LXP_AGENT_OROB_OFFSET_RANGE; given oraclePrice 0, then it reverts with LXP_AGENT_OROB_ORACLE_PRICE."
