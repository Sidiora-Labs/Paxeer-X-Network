touches = ["modules/layerxexchange/native/bridge.go", "modules/layerxexchange/native/bridge.c", "modules/layerxexchange/native/bridge_test.go"]
build_cmd = "make build && go build ./modules/layerxexchange/... ./precompiles/layerxexchange/..."
verify_cmd = "go test -count=1 ./modules/layerxexchange/native/ -run 'TestPerpsIfaceThroughBridge|TestPerMarketKeyIsolation|TestStoreBackedAssetState|TestNoEndBlockDriver|TestTifIfaceRegistersMarginRegister'"
gate_kind = "planned"
planned_paths = ["modules/layerxexchange/native/bridge.go", "modules/layerxexchange/native/bridge.c", "modules/layerxexchange/native/bridge_test.go"]
