[feature.10]
name = "Precompile address table, merge activation and clients"
scope = "The precompile address table with its merge plan (named upgrade, per-method height gate, handler, store mounts and activation list, precompiles/setup.go:63, node/upgrades.go:398-411), the shared precompile base with its opt-in LXP_ reason path (precompiles/common/precompiles.go:166-205), the LXP_ error registry and the client error tables, the Rust, TypeScript and Python SDKs, the CLI and cmd/layerxctl, bring-up, qualification and example tooling moved from lx_* to EVM transactions, px_ reads, ledger payments and the merged precompiles, and the gateway lx_* switch-off at activation (platform/hosted/gateway/src/rpc.rs:338)."
requirements = ["10001", "10002", "10003", "10004", "10005", "10006", "10007", "10008", "10009", "10010", "10011", "10012", "10013", "10014", "10015", "10016", "10017", "10018", "10019", "10020", "10021", "10022", "10023", "10024", "10025", "10026", "10027", "10028", "10029", "10030", "10031", "10032", "10033", "10034", "10035", "10036", "10037", "10038", "10039", "10040", "10041", "10042", "10043", "10044", "10045"]
completion_task = "10.7.2"

[req.10001]
title = "Existing precompile addresses keep their behaviour across the merge plan height"
ac_1 = "Addresses 0x1002 wasmd, 0x1003 json, 0x1005 staking, 0x1006 gov, 0x1007 distribution, 0x1008 oracle, 0x1009 ibc, 0x100A pointerview, 0x100B pointer, 0x100C solo and 0x1011 p256Verify stay in the map built by GetCustomPrecompiles (precompiles/setup.go:67-87) and return byte-identical results and revert data at H-1 and at H."
ac_2 = "layerxBridge 0x1016 and feeToken 0x1018 keep every method and from H return their refusals as Error(string) LXP_ text through the reason path they opt into (precompiles/layerxbridge/layerxbridge.go:104, precompiles/feetoken/feetoken.go:53)."
ac_3 = "oracle 0x1008 stays registered (precompiles/setup.go:75) and is not the price source of perps; perps prices come from the 0x1015 exchange oracle store."
ac_4 = "No existing address is removed, renumbered or wrapped by the merge: the merge gate test compares the registered address set at H-1 and at H and finds every entry of precompiles/setup.go:68-86 in both."

[req.10002]
title = "bank 0x1001 send overload with context hash and the LayerXReceipt log"
ac_1 = "From H bank 0x1001 serves send(address,address,string,uint256,bytes32), selector 0x2e4c85ac, beside the existing send(address,address,string,uint256) 0x5c05961b dispatched at the SendMethod case (precompiles/bank/bank.go:114) and executed by send (precompiles/bank/bank.go:134)."
ac_2 = "The overload logs LayerXReceipt(address,address,string,uint256,bytes32) with topic0 0x4b11729a809ec729868d9ba54f3192aa4179fe63668e9f742aa9b25de21de65f carrying the context hash; the four-argument send logs nothing new (precompiles/bank/bank.go:22-29)."
ac_3 = "Every existing bank method behaves as today, and from H a refusal returns Error(string) LXP_ text through the opt-in path of the dynamic-gas base (NewDynamicGasPrecompile precompiles/bank/bank.go:98, reason dropped today at precompiles/common/precompiles.go:182-183)."

[req.10003]
title = "addr 0x1004 binding methods and LXP_ADDR_ refusals"
ac_1 = "addr 0x1004 keeps bindLayerX (precompiles/addr/addr.go:335), unbindLayerX (precompiles/addr/addr.go:363), getLayerXDid (precompiles/addr/addr.go:391), getEvmAddrByLayerX (precompiles/addr/addr.go:407), layerXBindNonce (precompiles/addr/addr.go:423) and getUnifiedAccount (precompiles/addr/addr.go:437) with today's selectors."
ac_2 = "From H a refused binding returns Error(string) with the LXP_ADDR_ code registered for the keeper error of modules/evm/types/layerx_binding.go:28-35, and below H the bytes stay as today."
ac_3 = "rotateLayerXKey, setRecoveryRoot and recoverLayerX are not added at either height; a selector for any of them returns LXP_PRECOMPILE_UNKNOWN_METHOD from MethodById (precompiles/common/precompiles.go:131)."

[req.10004]
title = "Retired layerxVerify 0x1012, layerxCustody 0x1013 and layerxAnchor 0x1014"
ac_1 = "0x1012, 0x1013 and 0x1014 stay registered (precompiles/setup.go:81-83) and, from H, every retired method returns Error(string) \"LXP_MODULE_DISABLED: <precompile> retired\" instead of executing."
ac_2 = "layerxCustody keeps no drain window: its twenty methods (precompiles/layerxcustody/layerxcustody.go:52-72) all return LXP_MODULE_DISABLED from H, following the gate pattern of modules/layerxcustody/keeper/keeper.go:38-46."
ac_3 = "layerxAnchor writes (precompiles/layerxanchor/layerxanchor.go:41-61) return LXP_MODULE_DISABLED from H, while its reads, selected by isView (precompiles/layerxanchor/layerxanchor.go:131), are served until the anchor store-delete step at height D and return LXP_MODULE_DISABLED from D."
ac_4 = "The merge handler returns posted anchor guarantor bonds and open challenge deposits before the store-delete step, so no balance stays locked in a retired store (anchor node/upgrades.go:187)."

[req.10005]
title = "layerxExchange 0x1015 version 2 methods: engine execution and direct reads"
ac_1 = "From H depositMargin, depositMarginToken, withdrawMargin(bytes32,uint256), placeOrder(bytes32,bytes32,uint8,uint256,uint256,uint8) and cancelOrder(bytes32,bytes32) execute in the exchange engine instead of the intent recording of modules/layerxexchange/keeper/intents.go:33-169."
ac_2 = "The three replaced signatures (withdrawMargin 0x661e2df4, placeOrder 0x36633730, cancelOrder 0x7489ec23) are dropped from the ABI at H and fall to LXP_PRECOMPILE_UNKNOWN_METHOD through MethodById (precompiles/common/precompiles.go:131)."
ac_3 = "requestSettlement (precompiles/layerxexchange/layerxexchange.go:433) and getIntent return LXP_MODULE_DISABLED from H, while intentNonce stays as the nonce input of the chain-derived order and deposit id."
ac_4 = "getMarket, getOrder, getPosition and getMargin become direct state reads with the shorter signatures, and the twenty-two perps and spot methods are served only from H (method constants precompiles/layerxexchange/layerxexchange.go:50-61, Execute precompiles/layerxexchange/layerxexchange.go:198)."

[req.10006]
title = "launchpad 0x1017 protocol fee counter and getConfig tuple"
ac_1 = "From H every launchpad trade adds its protocol cut to a per-market counter, read by the new getProtocolFees(address) view; below H the view is not dispatched (launchpad method constants precompiles/launchpad/launchpad.go:46-69, unknown-method path precompiles/launchpad/launchpad.go:331)."
ac_2 = "getConfig() keeps selector 0xc3f909d4 and returns the Config tuple without protocolFeesPending from H (GetConfig case precompiles/launchpad/launchpad.go:328-329)."
ac_3 = "Every other launchpad method behaves as today and from H returns Error(string) LXP_LAUNCHPAD_ text through WithRevertReasons (precompiles/launchpad/launchpad.go:192)."

[req.10007]
title = "xweb 0x1019 program origin: fulfilProgram, getProgramResult and refund"
ac_1 = "From H xweb 0x1019 serves fulfilProgram(bytes), getProgramResult and getKernelNetworkId beside the methods of precompiles/xweb/xweb.go:43-53; below H they are not dispatched."
ac_2 = "refund (precompiles/xweb/xweb.go:333-347) keeps origin 1 as today, and an origin-2 request id returns Error(string) LXP_XWEB_UNKNOWN_REQUEST at H (RefundMethod case precompiles/xweb/xweb.go:244)."
ac_3 = "Every other xweb method behaves as today and from H returns LXP_XWEB_ text through WithRevertReasons (precompiles/xweb/xweb.go:168), with the registration gate XWebUpgrade (precompiles/setup.go:37) left unchanged."

[req.10008]
title = "layerxledger 0x101A: a new construct address served from the merge plan height"
ac_1 = "0x101A layerxledger is added to the map built by GetCustomPrecompiles (precompiles/setup.go:67) under the merge plan and is not served below H, read through the activation lookup latestCustomPrecompilesAtHeight (modules/evm/keeper/keeper.go:251)."
ac_2 = "0x101A is built with the reason option (precompiles/common/precompiles.go:53-56) so every refusal is Error(string) LXP_ text from its first height."
ac_3 = "lxpay names layerxledger: issueGrant, revokeGrant, draw and payExact are layerxledger methods at 0x101A, and no separate lxpay module exists beside it (anchor precompiles/setup.go:63-97)."

[req.10009]
title = "layerxpay 0x101B: a new construct address served from the merge plan height"
ac_1 = "0x101B layerxpay is added to the map built by GetCustomPrecompiles (precompiles/setup.go:67) under the merge plan and is not served below H, read through the activation lookup latestCustomPrecompilesAtHeight (modules/evm/keeper/keeper.go:251)."
ac_2 = "0x101B is built with the reason option (precompiles/common/precompiles.go:53-56) so every refusal is Error(string) LXP_ text from its first height."
ac_3 = "layerxpay writes outside the exit set return LXP_PAUSED_SCOPE while the payments pause scope is set, and budgetPull and budgetDelegateSpend carry the selectors 0xbc2548e7 and 0xf9708fc1 (anchor precompiles/setup.go:63-97)."

[req.10010]
title = "layerxauth 0x101C: a new construct address served from the merge plan height"
ac_1 = "0x101C layerxauth is added to the map built by GetCustomPrecompiles (precompiles/setup.go:67) under the merge plan and is not served below H, read through the activation lookup latestCustomPrecompilesAtHeight (modules/evm/keeper/keeper.go:251)."
ac_2 = "0x101C is built with the reason option (precompiles/common/precompiles.go:53-56) so every refusal is Error(string) LXP_ text from its first height."
ac_3 = "grantSession(bytes,uint64,bytes32) 0x1107b49e stores a session grant and logs SessionGranted, and sessionKey(grantId) returns the stored scope (anchor include/layerx/lxp_authority.h:12-19)."

[req.10011]
title = "layerxprograms 0x101D: a new construct address served from the merge plan height"
ac_1 = "0x101D layerxprograms is added to the map built by GetCustomPrecompiles (precompiles/setup.go:67) under the merge plan and is not served below H, read through the activation lookup latestCustomPrecompilesAtHeight (modules/evm/keeper/keeper.go:251)."
ac_2 = "0x101D is built with the reason option (precompiles/common/precompiles.go:53-56) so every refusal is Error(string) LXP_ text from its first height."
ac_3 = "deploy, upgrade, call and the exit and sandbox families are served at 0x101D, and windDown is not a method of the address (anchor agent/crates/layerx-sdk/src/program_http.rs:403)."

[req.10012]
title = "Agent functions 0x0901-0x0908 served at the gateway route addresses"
ac_1 = "The eight agent-function addresses 0x0901 resolveOffset, 0x0902 computeClearing, 0x0903 oracle aggregator, 0x0904 pofq, 0x0905 scheduler, 0x0906 streams, 0x0907 tee attestor and 0x0908 eip712 are registered at H at the addresses the wallet gateway routes to (human/wallet/gateway/src/precompiles.ts:18-25)."
ac_2 = "Below H a call to any of the eight addresses returns empty success, as today, because no entry exists in the map of precompiles/setup.go:67-87."
ac_3 = "Every agent-function refusal is Error(string) with an LXP_AGENT_ code, and the oracle aggregator 0x0903 and streams 0x0906 use the 0x1015 oracle store and the 0x101B stream keeper instead of separate state (registration pattern precompiles/setup.go:93-95)."

[req.10013]
title = "Selector table of changed and new methods"
ac_1 = "Every single selector of the table equals the first four bytes of keccak256 of its canonical signature and is resolved by MethodById (precompiles/common/precompiles.go:131) from the ABI loaded through MustGetABI (precompiles/common/precompiles.go:294)."
ac_2 = "bank 0x1001 adds send(address,address,string,uint256,bytes32) 0x2e4c85ac and the LayerXReceipt event whose topic0 is the full keccak256 of the event signature (precompiles/bank/bank.go:22-29)."
ac_3 = "For 0x1015 each changed signature names the selector it replaces, and the replaced selector is absent from the ABI at H (precompiles/layerxexchange/layerxexchange.go:50-61)."
ac_4 = "For 0x1015 depositMargin, depositMarginToken and intentNonce keep their selectors, and requestSettlement and getIntent keep theirs but are retired (anchor precompiles/layerxexchange/layerxexchange.go:71-72)."
ac_5 = "The perps and spot methods of 0x1015 are new selectors served only from H (anchor precompiles/layerxexchange/layerxexchange.go:71-72)."
ac_6 = "launchpad 0x1017 and xweb 0x1019 add getProtocolFees, fulfilProgram, getProgramResult and getKernelNetworkId, and getConfig keeps 0xc3f909d4 (precompiles/launchpad/launchpad.go:46-69, precompiles/xweb/xweb.go:43-53)."
ac_7 = "layerxledger 0x101A selectors, including send(bytes), draw, payExact and nextSequence(bytes32,bytes32) 0xce2f921f, are taken from contracts/ledger-auth.md and added to the map of precompiles/setup.go:67."
ac_8 = "layerxpay 0x101B and layerxauth 0x101C selectors are taken from contracts/pay.md and contracts/ledger-auth.md, and the row covering every other 0x101B method defers to contracts/pay.md without a single selector (precompiles/setup.go:67)."
ac_9 = "layerxprograms 0x101D selectors are taken from contracts/programs.md, including quoteCallFee(uint64[7]) 0xd67f9ffa (precompiles/setup.go:67)."
ac_10 = "The agent-function selectors of 0x0901-0x0908 are taken from contracts/agent-functions.md and match the calls the wallet gateway already encodes (human/wallet/gateway/src/precompiles.ts:18-25)."

[req.10014]
title = "Wallet gateway route keys that are not chain addresses"
ac_1 = "The gateway route key staking resolves to 0x0000000000000000000000000000000000001005, the registered staking precompile (precompiles/staking/staking.go:49), instead of 0x...0800 (human/wallet/gateway/src/precompiles.ts:17)."
ac_2 = "The key bech32 routes to addr 0x1004 getPaxAddr and getEvmAddr (precompiles/addr/addr.go:57) instead of 0x...0400, which no precompile serves."
ac_3 = "The key p256 resolves to 0x0000000000000000000000000000000000001011 (precompiles/p256/p256.go:24) instead of 0x...0100."

[req.10015]
title = "Code-owned ABIs of addr, bank, feetoken, layerxbridge and BatchCallAndSponsor"
ac_1 = "addr, bank, feetoken and layerxbridge have no contract part; their ABIs are the abi.json files embedded by each package and loaded through MustGetABI (precompiles/common/precompiles.go:294), and clients encode against them."
ac_2 = "bank send and balance (precompiles/bank/bank.go:22-29), feetoken setFeeDenom, getFeeDenom and clearFeeDenom (precompiles/feetoken/feetoken.go:19-21) and layerxbridge bridgeOut (precompiles/layerxbridge/layerxbridge.go:41-47) keep their selectors."
ac_3 = "BatchCallAndSponsor executeSponsored(Call[],Quote,bytes,bytes) and nonce() (contracts/src/BatchCallAndSponsor.sol:20, contracts/src/BatchCallAndSponsor.sol:135) are the sponsored path, and the gas station requires the account delegate to equal its configured paymaster."

[req.10016]
title = "Merge plan activation: constant, handler, store mounts and the activation list"
ac_1 = "node/upgrades.go declares the merge plan constant beside ActivationUpgrade (node/upgrades.go:88) with no tag-list entry, and knownUpgradePlans (node/upgrades.go:416-418) lists it so the node does not halt on it."
ac_2 = "RegisterUpgradeHandlers (node/upgrades.go:117-194) sets a handler for the plan through SetUpgradeHandler (node/upgrades.go:187), and the store loader mounts the layerxledger, layerxpay, layerxauth, layerxprograms and sequencer stores at H (node/app.go:1298-1325, node/app.go:1384-1395)."
ac_3 = "The handler returns anchor guarantor bonds and open challenge deposits, initialises the five new modules from genesis params and drains no custody claims (anchor node/upgrades.go:117-194)."
ac_4 = "The evm keeper activation becomes a list of (plan name, address set) entries replacing the single CustomPrecompileActivation (modules/evm/keeper/keeper.go:195-223), each read through IsUpgradeActiveAtHeight (sdk/x/upgrade/keeper/keeper.go:296-299) in latestCustomPrecompilesAtHeight (modules/evm/keeper/keeper.go:251)."
ac_5 = "The plan height equals the sequencer activation height on every validator, and a validator whose configured height differs refuses to start (activation gate entries node/upgrades.go:402-409)."

[req.10017]
title = "LXP_ revert wire form and the opt-in reason path"
ac_1 = "A refusal is ABI Error(string), selector 0x08c379a0, with text \"LXP_<code>: <message>\" optionally followed by \"; <detail>\", produced by RevertReason (precompiles/common/precompiles.go:59-66)."
ac_2 = "Run (precompiles/common/precompiles.go:82-111) packs the reason only for precompiles built WithRevertReasons (precompiles/common/precompiles.go:53-56), and the dynamic-gas base gains the same opt-in instead of dropping the reason (precompiles/common/precompiles.go:182-183)."
ac_3 = "Below H every existing precompile reverts with today's bytes; LXP_ text appears only from H (anchor precompiles/common/precompiles.go:166-205)."
ac_4 = "Kernel results map by name with LXP_ERR_ shortened to LXP_ (include/layerx/lxp_result.h:29-157); a value outside the enum maps to LXP_UNKNOWN (src/protocol/lxp_result.c:10); fatal values at or below -1000 halt the node and never produce a revert (src/protocol/lxp_result.c:55-58)."
ac_5 = "A governance pause is reported by the pausing module: layerxpay writes outside the exit set return LXP_PAUSED_SCOPE, xweb reads its own pause flag, and an origin-1 xweb refusal carries the Go keeper code while an origin-2 refusal carries the kernel code (modules/xweb/types/errors.go:6)."

[req.10018]
title = "LXP_ error code registry and the client error tables"
ac_1 = "Every kernel result of include/layerx/lxp_result.h:29-157 has one registry entry named LXP_ plus the name without the ERR_ prefix, keeping its numeric value only in the client tables."
ac_2 = "Every Go module error of xweb, layerxbridge, launchpad, layerxanchor, tokenfactory and layerxexchange has one entry named LXP_<MODULE>_<NAME> with its registered message (modules/xweb/types/errors.go:6)."
ac_3 = "Precompile-site refusals of addr, feetoken, bank and the common base, and the binding errors of modules/evm/types/layerx_binding.go:28-35 and modules/evm/keeper/feetoken.go:27, have one entry each, including LXP_PRECOMPILE_UNKNOWN_METHOD from MethodById (precompiles/common/precompiles.go:131)."
ac_4 = "The agent-function codes LXP_AGENT_* are defined by the new precompiles/layerxagent packages and listed per method group (human/wallet/gateway/src/precompiles.ts:18-25 routes)."
ac_5 = "The three layerxpay codes LXP_ARBITER_REQUIRED, LXP_UNAUTHORIZED_ARBITER and LXP_ESCROW_LINK_MISMATCH take the proposed values -737, -738 and -739 into include/layerx/lxp_result.h:29-157 at activation rehearsal."
ac_6 = "LXP_UNKNOWN covers any value outside the enum (src/protocol/lxp_result.c:10), and the fatal codes are listed but never surface as reverts (src/protocol/lxp_result.c:55-58)."
ac_7 = "Clients classify each code retriable or terminal from the Retryable column; the Rust mirror (agent/crates/layerx-types/src/result.rs:79) carries the class per value, unknown values are terminal (agent/crates/layerx-types/src/result.rs:253-260), and the TypeScript and Python mappings follow the same split (agent/sdk/typescript/src/agent-http.ts:309-328, agent/sdk/python/layerx_sdk/agent_http.py:928-934)."
ac_8 = "Where the Retryable column and the Rust mirror class differ, both stay as written and the difference is recorded once in qualification.kvx; neither side is changed to make the table agree (agent/crates/layerx-types/src/result.rs:79)."

[req.10019]
title = "Client contract header: agent-api major 2, version and change control"
ac_1 = "agent-api moves from major 1 (agent/schema/agent-api/v1.kvx:3) to major 2; removing or changing a declaration requires a new major (agent/schema/agent-api/v1.kvx:7), and the request header carries contract_major 2 (agent/schema/agent-api/v1.kvx:11)."
ac_2 = "Construct names, signatures and selectors used by clients come from the contract part that owns the construct, and for addr, bank, feetoken and layerxbridge from their embedded ABI (precompiles/common/precompiles.go:294)."
ac_3 = "Clients refuse a second transaction at a used nonce, report no pending receipt from eth_getTransactionReceipt, and treat lx_* ingress as answering -32601 from H (platform/hosted/gateway/src/rpc.rs:362)."

[req.10020]
title = "Signing and sponsorship legend: E, G, B, SP, SELF, K3R, RR, W"
ac_1 = "E: a write is an EIP-1559 type-2 transaction signed secp256k1 (agent/crates/layerx-crypto/src/evm_transaction.rs:9, sign at agent/crates/layerx-crypto/src/evm_transaction.rs:94), and the chain reads the actor DID with getLayerXDid of the sender (precompiles/addr/addr.go:391)."
ac_2 = "B and G: the DID ed25519 key signs only the bind message and the payer grant, and a session address writes under a layerxauth grant resolved by the precompile (agent/crates/layerx-client/src/account_binding.rs:200)."
ac_3 = "SP and SELF: with no gas the client signs a 7702 authorization to BatchCallAndSponsor and the station submits executeSponsored (interop/crates/layerx-gas-station/src/service.rs:270-274); otherwise the agent pays gas in PAX or in the denom set through feetoken (precompiles/feetoken/feetoken.go:19-21)."
ac_4 = "K3R, RR, W and none: a write reports submitted, receipted and committed from pax_sequencerReceipt and eth_getTransactionReceipt; a read reports no rung and names its tag or height (human/wallet/sdk/src/ladder.ts:4)."

[req.10021]
title = "Client rungs submitted, receipted and committed"
ac_1 = "submitted holds from eth_sendRawTransaction until a sequencer receipt passes; a null or a timeout keeps submitted and the client only polls or resends the exact raw bytes (agent/crates/layerx-sdk/src/rpc_verification.rs:295)."
ac_2 = "receipted is granted after checks R1-R6 pass on the sequencer receipt, reporting the decoded LXP_ code when status is 0 (agent/crates/layerx-proof/src/receipt.rs:631-667)."
ac_3 = "committed is granted after R7 and R8 pass at the landing height, and there is no rung beyond it; instant, sealed and final are retired (human/wallet/sdk/src/ladder.ts:4, human/wallet/sdk/src/ladder.ts:13)."
ac_4 = "A nonce already receipted is never reported superseded and a replacement is refused, because the sequencer receipt is final for the nonce (agent/schema/agent-api/write.kvx:42)."

[req.10022]
title = "Identity and keys: bind, session grants, nonces and receipt keys"
ac_1 = "Every write is signed by the agent EVM key as a type-2 transaction, or type 4 when sponsored, on chainId 125 (agent/crates/layerx-crypto/src/evm_transaction.rs:9)."
ac_2 = "Binding uses the DID key over \"LX:PAXEER-BIND:v1\"||125||address||layerXBindNonce, sent by the address to addr bindLayerX (precompiles/addr/addr.go:335, layerXBindNonce precompiles/addr/addr.go:423), and a delegated EOA binds through CALL, never delegatecall."
ac_3 = "An unbound sender is refused with LXP_UNAUTHORIZED_DEBIT on layerxledger and LXP_AUTH_SCOPE on layerxauth, and the reverse lookups getEvmAddrByLayerX and getUnifiedAccount (precompiles/addr/addr.go:407, precompiles/addr/addr.go:437) join identities; key rotation is out of scope and only unbind then bind is offered (precompiles/addr/addr.go:363)."
ac_4 = "Session keys and capabilities are layerxauth grants whose scope is read with sessionKey and capabilityScope, using the kernel authority kinds 1 to 8 (include/layerx/lxp_authority.h:12-19)."
ac_5 = "Concurrent writers use separate session addresses with separate nonce streams, and sponsored batches read nonce() at the account at pending (contracts/src/BatchCallAndSponsor.sol:20)."
ac_6 = "Receipt verifiers pin the sequencer ReceiptKeys list with primary and standby entries instead of one env key (platform/hosted/authority/src/main.rs:307)."

[req.10023]
title = "Major-1 envelope fields carried at major 2"
ac_1 = "activity_id becomes the txHash keccak256 of the raw transaction, and the actor sequence becomes eth_getTransactionCount at pending, with the layerxledger sequence read through nextSequence 0xce2f921f (agent/crates/layerx-sdk/src/rpc.rs:789-792)."
ac_2 = "The 64-byte ed25519 signature field (agent/schema/agent-api/write.kvx:24) becomes a 65-byte secp256k1 signature, including in McpExternalSignatureV1 (agent/schema/agent-api/write.kvx:70-74)."
ac_3 = "timestamp_bound, idempotency_key, fee_limit and network map to expiresAt, the per-method idempotency key, gas times maxFeePerGas and chainId 125 (anchor agent/crates/layerx-agentd/src/idempotency.rs:151)."
ac_4 = "The 112-hex cursor (agent/schema/agent-api/read.kvx:33) becomes (blockHeight, txIndex, logIndex), proof bundles become portable v2, the Level enum (agent/crates/layerx-agent-api/src/error.rs:129-136) becomes the three rungs, and outbox states follow receipt status."

[req.10024]
title = "Receipt checks R1-R10"
ac_1 = "R1-R2: the client fetches pax_sequencerReceipt and verifies the ed25519 signature over the canonical bytes against a pinned key (agent/crates/layerx-proof/src/receipt.rs:631-667)."
ac_2 = "R3-R6: the signing key's height range, the activity_id equal to keccak256 of the raw transaction, the log and return-data digests, and the seqHash chain all hold before receipted (anchor agent/crates/layerx-proof/src/receipt.rs:631-667)."
ac_3 = "R7-R8: eth_getTransactionReceipt at the landing height equals the sequencer receipt in status, gasUsed and logs, and the Comet commit there carries more than 2/3 power before committed (anchor interop/crates/layerx-portable/src/receipt.rs:120)."
ac_4 = "R9-R10: a status-0 receipt is decoded through the error registry, and SDKs, agentd, the authority service and /v1/settle all verify against the same pinned ReceiptKeys list (platform/hosted/authority/src/main.rs:307)."

[req.10025]
title = "Portable receipt layerx-receipt-proof-v2"
ac_1 = "The format string becomes layerx-receipt-proof-v2 (interop/crates/layerx-portable/src/receipt.rs:11) and verificationLevel is receipted or committed."
ac_2 = "rawTransaction, signedReceipt, receiptDigest and receiptKey replace canonicalReceipt and sequencerPublicKey, and batchId, asset and the two state roots are dropped (PortableReceipt::export interop/crates/layerx-portable/src/receipt.rs:45)."
ac_3 = "At committed the bundle carries the Comet header, receipt-trie inclusion, commit and validator set at the landing height, verified offline by PortableReceipt::verify (interop/crates/layerx-portable/src/receipt.rs:120)."

[req.10026]
title = "Operations: Write lifecycle: prepare, sign, submit, track, wait and replay"
ac_1 = "activity.prepare returns an unsigned EIP-1559 transaction with chainId 125, the pending nonce, the construct address and its calldata instead of a kernel activity (agent/crates/layerx-agentd/src/prepare/mod.rs:331-392)."
ac_2 = "activity.sign and the self-sign session path sign the EIP-1559 preimage with secp256k1 and check recovery equals the bound address (agent/crates/layerx-agentd/src/sign.rs:248, agent/crates/layerx-agentd/src/sign.rs:324)."
ac_3 = "activity.submit sends eth_sendRawTransaction through the router and records the txHash; restart recovery and unknown resolution read pax_sequencerReceipt per outbox entry (agent/crates/layerx-agentd/src/outbox/recover.rs:94, agent/crates/layerx-agentd/src/outbox/unknown.rs:111)."
ac_4 = "A repeated idempotency key at a new nonce reverts LXP_IDEMPOTENT_REPLAY and the first result is read with resultByIdempotency (agent/crates/layerx-agentd/src/idempotency.rs:151)."
ac_5 = "track and wait report the rungs from pax_sequencerReceipt and eth_getTransactionReceipt, the Rust SDK send_activity, identity sequence and wait_for follow the same calls, and the operation envelope carries contract_major 2 (agent/crates/layerx-agentd/src/finality.rs:289)."

[req.10027]
title = "Operations: Fees, sponsorship and fee denomination"
ac_1 = "Fee projection is eth_estimateGas at pending times the gas price, replacing the kernel fee estimate (agent/crates/layerx-agentd/src/human_runtime.rs:16188)."
ac_2 = "Sponsored submission uses the gas station quote, submit, status and retry routes (interop/crates/layerx-gas-station/src/service.rs:270-274) carrying executeSponsored, and the station refuses an account whose delegate is not its paymaster (interop/crates/layerx-gas-station/src/tx.rs:314)."
ac_3 = "Sponsored nonce discovery reads BatchCallAndSponsor nonce() at the account at pending (contracts/src/BatchCallAndSponsor.sol:20), and the fee denomination preference uses feetoken getFeeDenom, setFeeDenom and clearFeeDenom (precompiles/feetoken/feetoken.go:19-21)."

[req.10028]
title = "Operations: Reads, history, proofs and subscriptions"
ac_1 = "Account and balance reads use eth_getBalance and bank balance at pending and layerxledger balanceOf by eth_call, replacing lx_getAccount and lx_getBalance (agent/crates/layerx-sdk/src/rpc.rs:743-747)."
ac_2 = "Module state reads are eth_call views at pending, and committed reads use abci_query with proof at the height; batch, checkpoint, proof bundle and availability reads use eth_getBlockByNumber and the Comet commit (agent/crates/layerx-agentd/src/human_runtime.rs:4555)."
ac_3 = "History reads use px_getHistory over the indexer (platform/hosted/gateway/src/history.rs:424) and subscriptions use eth_subscribe logs and newHeads (agent/crates/layerx-sdk/src/rpc_subscription.rs:189)."
ac_4 = "px_ reads (px_resolveAccount, px_getAccount, px_getBalances, px_listAssets, px_getNetwork) are kept, and the wallet SDK kernel reads move from lx_* names (human/wallet/sdk/src/kernel.ts:95-112) to px_ and eth_ calls."

[req.10029]
title = "Operations: Budgets, daemon limits, capabilities and sessions"
ac_1 = "Budget create, fund and revoke call layerxpay budgetCreate, budgetFund and budgetRevoke instead of kernel budget activities (agent/crates/layerx-agentd/src/budget/create.rs:270)."
ac_2 = "Delegate spend and pull call budgetSpend, budgetDelegateSpend and budgetPull, and list, state and reconciliation read getBudget and budgetRemaining (agent/crates/layerx-agentd/src/budget/reconcile.rs:100)."
ac_3 = "Daemon limits, approval holds and policy stay daemon-local with no chain call (agent/crates/layerx-agentd/src/budget/daemon.rs:22)."
ac_4 = "Capabilities and sessions are layerxauth grantCapability, grantSession, grantSessionSuccessor and revokeGrant, and wallet caps read getBudget and getPayerGrant (agent/crates/layerx-agentd/src/human_runtime.rs:15936)."

[req.10030]
title = "Operations: Identity operations: register, rotation, faucet and bind"
ac_1 = "agent.register routes the identity service behind router px_ routes and then binds through addr bindLayerX (agent/crates/layerx-agentd/src/agent_rpc_dispatch.rs:1355-1359)."
ac_2 = "Key rotation is out of scope; the only chain path is unbindLayerX then bindLayerX (precompiles/addr/addr.go:363, precompiles/addr/addr.go:335)."
ac_3 = "faucet.claim routes the faucet service behind router px_ routes, and the faucet operation stays retired in agentd (agent/crates/layerx-agentd/src/agent_rpc.rs:24)."
ac_4 = "Account derivation and the CLI derive --bind read layerXBindNonce and submit bindLayerX (precompiles/addr/addr.go:423, platform/cli/src/wallet_derive.rs:123)."

[req.10031]
title = "Operations: Ledger sends, tokens, grants and x402 payments"
ac_1 = "Wallet sends and token transfers call layerxledger send(bytes); token create, mint and burn call register, mint and burn (agent/crates/layerx-sdk/src/wallet.rs:73)."
ac_2 = "Grants are issueGrant and revokeGrant, and a draw is one draw call by the grant recipient logging PaymentDrawn (agent/sdk/typescript/src/x402/draw.ts:6, agent/sdk/python/layerx_sdk/x402_draw.py:9)."
ac_3 = "Paid web search and the agentd-host payer use issueGrant or payExact (agent/crates/layerx-agentd-host/src/payer.rs:357, agent/crates/layerx-agentd-host/src/payer.rs:393)."
ac_4 = "x402 sellers and buyers verify the sequencer receipt and the PaymentDrawn or PaymentExact log, and the seller middleware uses eth_sendRawTransaction and pax_sequencerReceipt (platform/middleware/seller/src/rpc.ts:56)."

[req.10032]
title = "Operations: Programs, AI markets, intents, trading and disputes"
ac_1 = "Program call, simulate, deploy, upgrade, wind-down and sandbox call layerxprograms methods instead of the /v1/programs routes (agent/crates/layerx-sdk/src/program_http.rs:234, agent/crates/layerx-sdk/src/program_http.rs:403)."
ac_2 = "Program discovery reads getProgram and getInterface by eth_call, and program events come from eth_getLogs on ProgramGuestEvent (interop/crates/x-websearch/src/kernel.rs:55)."
ac_3 = "AI market writes call layerxprograms call, intents build per-leg calls inside one sponsored batch, and perps and spot builders call layerxexchange version 2 methods (agent/sdk/typescript/src/exchange.ts:424-433, agent/sdk/typescript/src/perps.ts:449)."
ac_4 = "Service disputes call layerxpay serviceDisputeOpen and serviceDisputeResolve, resolved only by the linked escrow's arbiter (anchor src/modules/service/lx_service_dispute.c:39)."

[req.10033]
title = "Operations: CLI, layerxctl and gateway ingress operations"
ac_1 = "CLI wallet send, token and open-account read the pending nonce and send an E-signed layerxledger call through eth_sendRawTransaction (platform/cli/src/wallet.rs:710)."
ac_2 = "CLI receipt reads pax_sequencerReceipt and then eth_getTransactionReceipt (platform/cli/src/main.rs:1045)."
ac_3 = "layerxctl read-state uses eth_call and submit uses eth_sendRawTransaction (cmd/layerxctl/src/main.rs:129)."
ac_4 = "Gateway lx_sendActivity ingress is switched off at H and the router relays eth_sendRawTransaction and pax_sequencerReceipt (platform/hosted/gateway/src/rpc.rs:338-355)."

[req.10034]
title = "Operations: Receipt consumers: verifiers, status ladder, settlement, authority, portable and interop"
ac_1 = "The TypeScript, Python, Go, JVM, .NET and Swift receipt verifiers run section (c) checks, and the mirror verifier for external chains is unchanged (agent/sdk/typescript/src/verifier.ts:1168, agent/sdk/python/layerx_sdk/verifier.py:1003)."
ac_2 = "Wallet and explorer status ladders show submitted, receipted and committed (human/wallet/sdk/src/ladder.ts:4)."
ac_3 = "/v1/settle and the receipt authority verify against the pinned ReceiptKeys list instead of one env key (platform/hosted/authority/src/main.rs:75, platform/hosted/authority/src/main.rs:307)."
ac_4 = "Portable export and verify use portable v2, and interop submissions are user-signed transactions relayed by eth_sendRawTransaction with the sequencer receipt as settlement evidence (interop/crates/layerx-portable/src/receipt.rs:11)."

[req.10035]
title = "lx_* names switched off at the gateway with their replacements"
ac_1 = "Every lx_* name of the gateway dispatch (platform/hosted/gateway/src/rpc.rs:338-355) answers JSON-RPC -32601 method not found from H, with no kernel forwarding (platform/hosted/gateway/src/rpc.rs:362)."
ac_2 = "Each caller file listed for a name moves to the replacement of contracts/clients.md section (d): writes to eth_sendRawTransaction and pax_sequencerReceipt, reads to eth_ and px_ reads (agent/crates/layerx-sdk/src/rpc.rs:743-747)."
ac_3 = "History, register and faucet handlers are removed from the gateway (platform/hosted/gateway/src/history.rs:420, platform/hosted/gateway/src/rpc_register.rs:399, platform/hosted/gateway/src/rpc_faucet.rs:358), and the OpenRPC document and route catalogue drop the names (tools/paxeer-x/route-catalogue.json:4516)."

[req.10036]
title = "Switch-off surfaces S1-S4"
ac_1 = "S1: the gateway HTTP JSON-RPC answers -32601 for every lx_* name (platform/hosted/gateway/src/rpc.rs:362)."
ac_2 = "S2: the gateway websocket answers -32601 for lx_subscribe and lx_unsubscribe and sends no lx_subscription notification (platform/hosted/gateway/src/ws.rs:286)."
ac_3 = "S3 and S4: the /v1/activities and /v1/programs write routes are not served, and the CLI allowlist (platform/cli/src/rpc.rs:84-178) admits only eth_ and the major-2 names."

[req.10037]
title = "Clients that break at the switch-off and their major-2 path"
ac_1 = "The seller middleware, the x402 seller and buyer and the paid web sidecar stop sending lx_* names and follow the ledger payment operations (platform/middleware/seller/src/rpc.ts:56, interop/crates/x-websearch/src/payment.rs:1981)."
ac_2 = "The CLI, the agent API schema and the Rust, TypeScript and Python SDKs use major 2 and no lx_* name (platform/cli/src/rpc.rs:84-178, agent/crates/layerx-sdk/src/rpc.rs:743-747)."
ac_3 = "The gateway, wallet SDK and web app, status UIs and bring-up tooling follow the major-2 operations, with the rung ladder in every status UI (human/wallet/sdk/src/kernel.ts:95-112, tools/bringup/check-live.sh:2502)."

[req.10038]
title = "Conformance suites C1-C11"
ac_1 = "Schema goldens and the shared operations file are regenerated at major 2, keyed O1-O79, with streaming tests on eth_subscribe logs (agent/schema/agent-api/v1.kvx:3)."
ac_2 = "Receipt fixtures are replaced by the sequencer receipt vectors V1-V4 and no AuthorizedBatch fixture remains, while the derivation and payload codec fixtures stay (agent/crates/layerx-sdk/tests/receipt_fixture.rs:129)."
ac_3 = "The TypeScript, Python, Rust, Go, JVM, .NET and Swift suites, the portable crate tests and the x402 vectors run at major 2 (agent/sdk/typescript/test/receipt-fixture.test.ts:17, tests/agent/sdk/python/test_receipt_fixture.py:61)."

[req.10039]
title = "Receipt vectors V1-V9"
ac_1 = "V1-V2: a status-1 and a status-0 sequencer receipt verify to receipted, the second decoding its LXP_ code (agent/crates/layerx-proof/src/receipt.rs:631-667)."
ac_2 = "V3-V5: malformed receipts are refused, a committed bundle verifies, and portable v2 round trips at both rungs (interop/crates/layerx-portable/src/receipt.rs:120)."
ac_3 = "V6-V9: the bind message, the sponsored digest and 7702 authorization, the twenty-six -32601 answers and the idempotent replay equal their vectors (precompiles/addr/addr.go:335, contracts/src/BatchCallAndSponsor.sol:135)."

[req.10040]
title = "Method ownership of client-called methods"
ac_1 = "layerxledger and layerxauth methods called by clients are owned by contracts/ledger-auth.md, which fixes their names, signatures and selectors (precompiles/setup.go:67)."
ac_2 = "layerxpay, layerxexchange, launchpad, layerxprograms and xweb methods are owned by their contract parts, and layerxanchor reads are owned by none because the executor is retired (precompiles/layerxanchor/layerxanchor.go:131)."
ac_3 = "Sequencer RPC and receipt keys are owned by contracts/sequencer.md, and addr, bank, feetoken, layerxbridge and BatchCallAndSponsor by their code ABIs (precompiles/common/precompiles.go:294)."

[req.10041]
title = "Rust SDK surface: reads, receipts, subscriptions, wallet and programs"
ac_1 = "The Rust RpcClient reads move from the lx_* table of read_methods! (agent/crates/layerx-sdk/src/rpc.rs:743-747) to eth_ and px_ reads, including get_identity_sequence (agent/crates/layerx-sdk/src/rpc.rs:789) and get_balances (agent/crates/layerx-sdk/src/rpc.rs:801)."
ac_2 = "wait_for and the Rust receipt verifier report the three rungs from the sequencer receipt (agent/crates/layerx-sdk/src/rpc_verification.rs:295)."
ac_3 = "Subscriptions use eth_subscribe logs (agent/crates/layerx-sdk/src/rpc_subscription.rs:189) and the wallet signs layerxledger calls as EIP-1559 transactions (agent/crates/layerx-sdk/src/wallet.rs:73)."
ac_4 = "The program client deploys, upgrades and calls through layerxprograms 0x101D instead of the /v1/programs routes (agent/crates/layerx-sdk/src/program_http.rs:403, agent/crates/layerx-sdk/src/program_http.rs:410)."

[req.10042]
title = "TypeScript SDK surface: RPC, gas station, exchange, x402, derivation, verifier and envelope"
ac_1 = "JsonRpcClient reads move from lx_* to eth_ and px_ (agent/sdk/typescript/src/rpc.ts:74, agent/sdk/typescript/src/rpc.ts:122), and subscriptions use eth_subscribe (agent/sdk/typescript/src/rpc-subscription.ts:103)."
ac_2 = "Exchange, perps and spot builders produce version 2 calls for 0x1015 (agent/sdk/typescript/src/exchange.ts:424-433, agent/sdk/typescript/src/perps.ts:449)."
ac_3 = "x402 grant, draw and receive builders use layerxledger issueGrant, draw and payExact (agent/sdk/typescript/src/x402/draw.ts:6, agent/sdk/typescript/src/x402/receive.ts:151)."
ac_4 = "Account derivation binds through addr 0x1004 (agent/sdk/typescript/src/account-derivation.ts:29), the verifier runs the section (c) checks (agent/sdk/typescript/src/verifier.ts:1168), and the agent envelope carries contract_major 2 (agent/sdk/typescript/src/agent-http.ts:376)."

