[acceptance.7.1.1]
feature = "7"
req = "7001.1"
scenario = "Given a router at the activation height H and a client that calls lx_getAccount with a DID that holds 5 PAX, when the call arrives, then the router answers error -32601 with no upstream request to the kernel core, and eth_getBalance for the bound EVM address at the pending tag answers 5000000000000000000 wei."
contract = "contracts/services.md#s03-unified-router"
test = "planned: platform/hosted/gateway/src/rpc.rs::tests::lx_read_names_answer_method_not_found"
qualification = "UNRUN"

[acceptance.7.1.2]
feature = "7"
req = "7001.2"
scenario = "Given the router configuration without a kernel core endpoint, when the router starts, then readiness does not depend on a kernel core probe and every one of the read names listed in the earlier backend table answers -32601."
contract = "contracts/services.md#s03-unified-router"
test = "planned: platform/hosted/gateway/src/rpc.rs::tests::no_kernel_backend_after_activation"
qualification = "UNRUN"

[acceptance.7.1.3]
feature = "7"
req = "7001.3"
scenario = "Given a transaction with hash 0xab..01 receipted by the sequencer at sequence 41 and committed at height 120, when a client calls pax_sequencerReceipt with that hash, then the answer carries rung committed, height 120 and a receipt signature that verifies under the ReceiptKeys entry whose height range contains 120."
contract = "contracts/services.md#s03-unified-router"
test = "planned: platform/hosted/gateway/tests/balances_one_source.rs::receipt_reads_use_sequencer_receipt"
qualification = "UNRUN"

[acceptance.7.1.4]
feature = "7"
req = "7001.4"
scenario = "Given the archive node down and a client that calls eth_getProof at height 100 while the head is 5000, when the router relays the call, then the client receives an upstream error and never a proof taken at height 5000."
contract = "contracts/services.md#s03-unified-router"
test = "planned: platform/hosted/gateway/src/paxeer.rs::tests::historical_proof_never_uses_head"
qualification = "UNRUN"

[acceptance.7.2.1]
feature = "7"
req = "7002.1"
scenario = "Given a client that posts lx_sendActivity with a canonical envelope after activation, when the router dispatches it, then the router answers -32601 and makes no call to /v1/activities; a raw type-2 transaction sent with eth_sendRawTransaction is relayed to the sequencer and the transaction hash is returned."
contract = "contracts/services.md#s03-unified-router"
test = "planned: platform/hosted/gateway/src/rpc.rs::tests::lx_send_activity_answers_method_not_found"
qualification = "UNRUN"

[acceptance.7.2.2]
