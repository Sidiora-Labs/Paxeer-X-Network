verification_contract = "cargo test --locked --manifest-path platform/Cargo.toml -p layerx-platform-gateway --bin layerx-gateway rpc::"
do_1 = "Answer -32601 for every lx_ name from the activation height in dispatch (platform/hosted/gateway/src/rpc.rs:362): the read names (platform/hosted/gateway/src/rpc.rs:342-357), lx_getSequence (platform/hosted/gateway/src/rpc.rs:237), lx_sendActivity (platform/hosted/gateway/src/rpc.rs:341), lx_estimateFee (platform/hosted/gateway/src/rpc.rs:417-423) and the commitment levels (platform/hosted/gateway/src/rpc.rs:489-495)."
