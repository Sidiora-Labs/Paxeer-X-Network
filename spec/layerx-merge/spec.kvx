[capability.4.1.1]
title = "cgo native host, module wiring, genesis and bring-up"
reqs = ["4051.1", "4051.2", "4051.3"]
touches = ["modules/layerxprograms/native/host.go", "modules/layerxprograms/keeper/keeper.go", "modules/layerxprograms/module.go", "node/app.go", "node/upgrades.go"]
tests = ["modules/layerxprograms/native/host_test.go", "modules/layerxprograms/keeper/genesis_test.go"]
verification_contract = "The node starts with layerxprograms mounted, the activation handler initializes default params with no account migration, and the native host executes the kernel programs module through the lxp_module_ctx shim."
do_1 = "Link the kernel programs module through its registration iface src/modules/programs/registration.c:248 and dispatch decode, validate and execute (src/modules/programs/registration.c:77, src/modules/programs/registration.c:120, src/modules/programs/registration.c:164)."
do_2 = "Build the cgo host after the existing cgo link pattern of wasm-runtime/version_cgo.go:1 and link the runtime staticlib of programs/crates/layerx-programs-runtime."
do_3 = "Register the module and store key beside node/app.go:266 and the module account map at node/app.go:289."
do_4 = "Register the activation handler in node/upgrades.go:117 and the plan in node/upgrades.go:416; the plan name is set at activation rehearsal."
symbols = ["programs_module_registration", "lxp_programs_module_version", "RegisterUpgradeHandlers", "knownUpgradePlans"]

[capability.4.1.2]
title = "0x101D address, height gate, revert form and principal"
reqs = ["4041.1", "4041.2", "4041.3", "4041.4"]
touches = ["precompiles/layerxprograms/layerxprograms.go", "precompiles/setup.go"]
tests = ["precompiles/layerxprograms/layerxprograms_test.go"]
verification_contract = "Every selector routes through the precompile at 0x101D, refuses below the activation height and while Paused, reverts as Error(string) LXP_<code> and resolves the principal from the 0x1004 binding."
do_1 = "Register the precompile in precompiles/setup.go:63 with the address constant pattern of precompiles/layerxcustody/layerxcustody.go:83."
do_2 = "Gate each method with IsUpgradeActiveAtHeight as at modules/layerxcustody/keeper/keeper.go:42."
do_3 = "Enable reason reverts with precompiles/common/precompiles.go:53 and map kernel results through precompiles/common/precompiles.go:59 into LXP_<code> strings."
do_4 = "Resolve the principal from modules/evm/keeper/layerx_binding.go:18 and derive the 32-byte account id as src/ledger/lx_account_id.c:196 does."
symbols = ["GetCustomPrecompiles", "GetLayerXDid", "RevertReason", "IsUpgradeActiveAtHeight"]

[capability.4.1.3]
title = "Fixed per-method gas table"
reqs = ["4042.1", "4042.2", "4042.3"]
touches = ["precompiles/layerxprograms/gas.go"]
tests = ["precompiles/layerxprograms/gas_test.go"]
verification_contract = "RequiredGas returns the D2 value for every selector and the unknown-selector path reverts after charging the read cost."
do_1 = "Derive read and write classes from sdk/store/types/gas.go:349: read 1000 + 3 x len, write 2000 + 30 x len."
do_2 = "Replace precompiles/common/precompiles.go:286 for 0x101D selectors with the D2 table lookup."
do_3 = "Add the retireStorage signature surcharge of 2 x precompiles/addr/addr.go:53 plus 20000."
do_4 = "Resolve the selector through the method lookup used by precompiles/common/precompiles.go:82 before charging."
symbols = ["RequiredGas", "DefaultGasCost", "KVGasConfig"]

[capability.4.1.4]
title = "Deterministic execution and replay of programs"
reqs = ["4016.1", "4016.2", "4016.3"]
touches = ["modules/layerxprograms/keeper/replay_test.go"]
tests = ["modules/layerxprograms/keeper/replay_test.go", "programs/crates/layerx-programs-runtime/tests/program_replay.rs"]
verification_contract = "Two validators executing the same block give equal app hashes, and the replay golden gives the same program subtree root."
do_1 = "Keep the replay capture at src/modules/programs/call.c:3138 and its staging at src/modules/programs/state_record.c:534 inside the native host."
do_2 = "Finalize replay per block through src/modules/programs/occupancy.c:1242."
do_3 = "Re-pin only the authority bytes produced by the shim-built authority, as the replay form at src/modules/programs/call.c:2879 requires."
do_4 = "Replay tests/replay/golden/history.lxl and compare the programs prefix root, not the kernel batch hash (src/modules/programs/call.c:2952)."
symbols = ["lxp_programs_call_replay_take", "lxp_programs_replay_finalize", "lxp_programs_replay_capture_stage"]

[capability.4.2.1]
