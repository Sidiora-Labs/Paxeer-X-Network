[contract_context.9.a1_envelope]
interface = "Each sequencer receipt is one ProtocolReceipt v2 envelope in canonical bytes; field order and widths follow the wire crate (agent/crates/layerx-wire/src/receipt.rs:190-220) and node/sequencer/receipt.go builds it."
storage = "Receipts are held in the ACCEPT WAL entry and served by pax_sequencerReceipt; the encoder is the Go mirror of encode (agent/crates/layerx-wire/src/receipt.rs:928-980)."
errors = "Decode refuses a wrong version or tag (agent/crates/layerx-wire/src/limits.rs:8, :12; agent/crates/layerx-wire/src/receipt.rs:10); tag 0x5202 (agent/crates/layerx-wire/src/receipt.rs:11) is not produced."
invariants = "global_sequence is gap-free from 1 at H_act and resulting_state_root chains sha256(\"PAXEER/v1/sequence\\0\" || prevSeqHash || u64be(seq) || activity_id); activity_id is never zero (agent/crates/layerx-proof/src/receipt.rs:648)."
activation = "The first receipt after H_act has previous_state_root of 32 zero bytes; module_id is the first id after the reserved range (include/layerx/lxp_module.h:26), set at activation rehearsal."

[contract_context.9.a2_effects]
interface = "Effect 0 is the STATE execution summary and effects 1..n are EVENT logs (include/layerx/lxp_receipt.h:14-18), bodies within MAX_EFFECT_BODY (agent/crates/layerx-wire/src/receipt.rs:16)."
invariants = "No effect is monetary, so decode_effect never meets the monetary kind check (agent/crates/layerx-wire/src/receipt.rs:497-502)."
gas = "The effect count bound is extended beyond MAX_EFFECTS (agent/crates/layerx-wire/src/receipt.rs:15) for module_version 1 so every log of a transaction is encoded."
events = "Log effect bodies carry address, topics and sha256(data) of each EVM log (modules/evm/types/receipt.pb.go:26-31)."

[contract_context.9.a3_signature]
interface = "The digest is sha256(\"LXP/v1/receipt\\0\" || unsigned) (agent/crates/layerx-wire/src/hash.rs:69, :330-335) and the signature is ed25519 (agent/crates/layerx-crypto/src/ed25519.rs:54-60)."
storage = "The receipt key is a host file separate from priv_validator_key (consensus/privval/file.go:222)."
errors = "verify_sequencer_signature returns the canonical-encoding, version, zero-activity, missing-signature or signature failure (agent/crates/layerx-proof/src/receipt.rs:631-660)."
invariants = "The signature tail is flag 1 then a 64-byte bounded array (agent/crates/layerx-wire/src/receipt.rs:707-716)."

[contract_context.9.a4_rotation]
storage = "modules/sequencer param ReceiptKeys holds {keyId, publicKey, firstHeight, lastHeight} entries, following the key-range rule of the proof crate (agent/crates/layerx-proof/src/inclusion.rs:66-70)."
interface = "Changes pass only through a governance param change, in the shape of the EVM param handler (modules/evm/gov.go:26-41)."
activation = "The primary and standby keys are pinned with overlapping ranges in module genesis at H_act; values are set at activation rehearsal (agent/crates/layerx-proof/src/inclusion.rs:66-70)."
invariants = "The hosted authority service and settle endpoint load the full list in place of one key (platform/hosted/authority/src/main.rs:306-309; platform/hosted/gateway/src/main.rs:1030-1036)."

[contract_context.9.a5_client]
interface = "Clients run verify_sequencer_signature with the pinned key (agent/crates/layerx-proof/src/receipt.rs:631) and check context_hash against the key ranges (agent/crates/layerx-proof/src/inclusion.rs:14-19)."
invariants = "At the committed rung eth_getTransactionReceipt (rpc/tx.go:106) agrees in status, gasUsed and logs, and the block's MsgSequenceBatch covers the seq."
events = "Two valid receipts with one keyId and seq and different activity_id are an equivocation pair recorded by the authority service beside its key check (platform/hosted/authority/src/lib.rs:281-285)."

[contract_context.9.b1_methods]
interface = "eth_sendRawTransaction (rpc/send.go:76) returns after the receipt on the sequencer and forwards on other nodes (rpc/send.go:96-113)."
interface_cometbft = "tx_search, abci_query, header and commit (consensus/internal/rpc/core/routes.go:44, :49, :52, :70) are unchanged and committed-only."
errors = "The lx_* ingress is refused after activation in the router's existing refusal shape (platform/hosted/gateway/src/paxeer.rs:172)."
invariants = "The mempool never orders sequencer blocks (consensus/internal/mempool/mempool.go:429; consensus/internal/mempool/tx.go:461)."

[contract_context.9.b2_pending]
interface = "The pending tag resolves to the open block on the sequencer and standby (rpc/utils.go:41, :51, :63); other nodes answer -32000 \"pending served by sequencer\" or forward."
storage = "Pending reads use a read-only snapshot of L_open through the RPC context provider (node/app.go:2895-2906; rpc/simulate.go:322)."
errors = "eth_getProof and trace calls with pending are refused on every node (rpc/state.go:110; rpc/simulate.go:395-396)."
events = "Pending logs, filters and subscriptions are fed from receipts (rpc/filter.go:569; rpc/subscribe.go:226); newHeads and eth_newBlockFilter stay committed-only (rpc/subscribe.go:107; rpc/filter.go:422)."
gas = "eth_estimateGas defaults to pending on the sequencer (rpc/simulate.go:120) and fee views report the base fee fixed at Open (modules/evm/keeper/fee.go:100)."

[contract_context.9.b3_nonce]
interface = "eth_getTransactionCount pending returns the sequencer's next nonce including held future nonces (rpc/tx.go:358)."
errors = "A same-nonce transaction is refused, never superseded (modules/evm/ante/sig.go:75)."
invariants = "The gas station's Replacement path is removed (interop/crates/layerx-gas-station/src/station.rs:393-407; interop/crates/layerx-gas-station/src/journal.rs:94-99)."

[contract_context.9.c1_activation]
activation = "Activation is a bring-up at the activation height through the upgrade path (node/upgrades.go:416-418); no account-state migration is required."
storage = "The modules/sequencer store is added at H_act (node/upgrades.go:377) and the module is registered (node/upgrades.go:385)."
invariants = "Rollback below the freeze height (sdk/server/rollback.go:41) and replay reach the same app hash."

[contract_context.9.c2_batch]
interface = "MsgSequenceBatch{height, fromSeq, toSeq, prevSeqHash, lastSeqHash, txRoot, keyId, sig} is tx 0 of every block at or above H_act; sig covers the sequence-batch domain with chain-id (agent/crates/layerx-wire/src/hash.rs:132; node/app.go:1462-1468)."
storage = "The keeper stores lastSeq and lastSeqHash after each batch (src/sequencer/lxp_sequence.c:45 is the kernel range check it replaces)."
errors = "A batch out of position, repeated, or not chaining from the store is refused; ProcessProposal answers REJECT first (node/app.go:1462-1468)."
gas = "The message is fee-free and refused through CheckTx (node/abci.go:95)."

[contract_context.9.c3_leader]
interface = "Leader(h, r) = L[r mod len(L)] from H_act (consensus/internal/consensus/types/round_state.go:194, :422-437)."
invariants = "ProcessProposal runs nine checks and any failure answers REJECT (node/app.go:1457, :1462-1468)."
activation = "BeginBlock(N+1) receives the votes of N-1 from H_act; at H_act the list is empty (node/app.go:2119; node/legacyabci/begin_block.go:60, :61)."
gas = "Header time stays within the synchrony params (consensus/types/params.go:194-203)."

[contract_context.9.c4_failover]
invariants = "On primary stop the standby leads the next round and continues from the last replicated ACCEPT; no released receipt is dropped and no seq is signed twice (consensus/internal/consensus/types/round_state.go:422-437)."
storage = "The LEASE entry's epoch fences the old primary; replay starts from the last COMMITTED entry (consensus/internal/consensus/wal.go:269)."
errors = "A host with a lower epoch refuses Accept and Seal (cmd/layerx-handover/main.c:117)."

[contract_context.9.d_execution]
interface = "Accept, Seal and Open over L_c, L_N and L_open; Accept runs DeliverTx in deliver mode (node/abci.go:169) on a per-transaction branch (sdk/baseapp/baseapp.go:822)."
invariants = "Sequential first, MicroBatch later behind the same interface (D19); validators run the block path with OCC (node/app.go:1861, :1888)."
gas = "Seal closes the block before the gas and byte limits (node/app.go:1477; consensus/types/params.go:135-143)."

[contract_context.9.e1_wal]
storage = "WAL frames are crc32c || length || entry (consensus/internal/libs/wal/writer.go:92-104), version 1, kinds OPEN, ACCEPT, SEAL, COMMITTED and LEASE."
errors = "A checksum failure ends replay at the last good frame (consensus/internal/libs/wal/reader.go:70-71)."
invariants = "Replay reproduces each stored receipt byte for byte or stops the sequencer (consensus/internal/consensus/wal.go:269)."

[contract_context.9.e2_replication]
invariants = "A receipt is released only after group fdatasync (consensus/internal/libs/wal/writer.go:106-111) and the standby ack."
errors = "A missing ack within the replication timeout refuses the send; the timeout is set at activation rehearsal (rpc/send.go:139-141)."
storage = "The standby keeps its own L_open by re-executing ACCEPT entries in seq order (node/abci.go:169)."

[contract_context.9.e3_handover]
interface = "Planned handover: stop accepting, ack last frame, LEASE(epoch+1), start accepting, the step order of the kernel tool (cmd/layerx-handover/main.c:117, :140)."
errors = "Sends during the window get a retryable error (cmd/layerx-handover/main.c:140)."
invariants = "The new primary signs with its own pinned key and its L_open equals the old primary's at the last acknowledged seq (agent/crates/layerx-proof/src/inclusion.rs:14-19)."

[contract_context.9.e4_guarantee]
invariants = "A signed receipt commits at its seq with the same result after any unplanned stop (node/app.go:1462-1468)."
interface = "Rungs submitted, receipted and committed are reported by pax_sequencerReceipt; eth_getTransactionReceipt stays committed-only (rpc/tx.go:106)."
errors = "A send with an error or no answer is resolved by the pending nonce or the receipt by hash, never by a same-nonce resend (rpc/tx.go:358)."

[contract_context.9.f_fees]
gas = "The EVM minimum fee is at most 67000000 wei (modules/evm/types/params.go:16) and the node floor \"0.01uhpx\" applies before Accept (sdk/server/config/config.go:41-48)."
interface = "SID is charged through the fee-token path at the governed rate (modules/evm/keeper/feetoken.go:92-108; precompiles/feetoken/feetoken.go:19), 3114000 base units per PAX at activation."
storage = "Sponsorship budgets are keyed by DID through the precompile at 0x...1004 (precompiles/addr/addr.go:57)."
invariants = "No receipt is issued for a transaction that cannot pay (modules/evm/ante/fee.go:88-108)."

[contract_context.9.g_timing]
gas = "Receipt latency p50 is at most 10 ms on the rehearsal hardware (rpc/send.go:76)."
activation = "TimeoutPropose 1 s plus 500 ms per round, TimeoutVote 50 ms, TimeoutCommit 50 ms (consensus/config/config.go:1161-1187), set at activation rehearsal."
invariants = "Block limits MaxGas 100M, MaxGasWanted 50M, MaxBytes 22020096 (consensus/types/params.go:135-143, :168-176); prune runs off ApplyBlock (consensus/internal/state/execution.go:418)."

[task.0.2]
title = "Sequencer executor: execute at receipt on the open speculative state"
status = "done"
mode = "BUILD"
wave = 0
requires = []
reqs = ["3.1", "3.6", "7.2", "8.1", "11.8", "12.5", "9001.1", "9001.2", "9001.3", "9001.4", "9001.5", "9017.1", "9017.2", "9017.3", "9035.1", "9035.2", "9035.3", "9035.4", "9035.5", "9044.1", "9044.2", "9044.3", "9044.4", "9044.5"]
capabilities = ["9.1.1", "9.8.4"]
do_1 = "Add the executor in node/sequencer/executor.go: type Executor with Accept(txBytes) (receipt, error), Seal(height) and Open(height, timestampMs); Open builds L_open over the last committed state at the block-open time (D7) and runs BeginBlock once for the height (node/legacyabci/begin_block.go:43), replacing tmtime.Now() for the header (consensus/internal/state/state.go:279)."
do_2 = "In node/sequencer/accept.go land the Sequential mode first (D19): each transaction runs on its own branch of L_open made with the CacheTxContext pattern (sdk/baseapp/baseapp.go:822) through app.DeliverTx (node/abci.go:169); the branch is written on success and dropped on failure, and a failed transaction takes no seq."
do_3 = "Build the Accept context from L_open, never from checkState (sdk/baseapp/baseapp.go:550 setCheckState, :778 getState), so the deliver-mode nonce rule (modules/evm/ante/sig.go:75) and the deliver-only fee branches (modules/evm/ante/fee.go:114, :130) run as in block execution."
do_4 = "Recover a panic raised by DeliverTx inside Accept in the shape of the deliver path's recovery (node/abci.go:192-194): no receipt, branch dropped, seq counter and L_open unchanged."
do_5 = "Keep the MicroBatch switch in the Executor interface so task 9.2.1 adds it over DeliverTxBatch (node/abci.go:230) and NewScheduler (node/abci.go:247) without changing callers; the default mode is Sequential."
do_6 = "Add node/sequencer/executor_test.go with TestExecutorAcceptWritesBranchOnSuccess, TestExecutorBeginBlockOncePerOpen, TestExecutorRunsDeliverModeAnte, TestExecutorRecoversExecutionPanic, TestExecutorContextFromOpenBlock, TestExecutorSequentialOrder and TestExecutorAdmissionIsAnteChain on the real App built as node/app_test.go:263 builds it; the kernel admission it replaces is src/sequencer/lxp_admission.c:58."
do_7 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["Executor", "Accept", "Seal", "Open", "ModeSequential"]
touches = ["node/sequencer/executor.go", "node/sequencer/accept.go", "node/sequencer/executor_test.go"]
build_cmd = "go build ./node/sequencer/..."
verify_cmd = "go test -count=1 ./node/sequencer/ -run TestExecutor"
gate_kind = "planned"
planned_paths = ["node/sequencer/executor.go", "node/sequencer/accept.go", "node/sequencer/executor_test.go"]
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result; record exact revision, command, exit code and private evidence location. Do not mark complete without the declared evidence."
path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to their current equivalents before the gate can run; historical references never authorize a duplicate implementation tree. Complete scoped path reconciliation without dropping acceptance criteria."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

