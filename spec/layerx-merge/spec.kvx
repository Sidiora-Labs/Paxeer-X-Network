[feature.8]
name = "human-and-bridge"
scope = "Wallet app, wallet SDK, embedded wallet gateway, attestors and KMS, web app, human service, explorer fork, bridge and identity registration on Paxeer X Network after the LayerX merge: every human and bridge surface submits through the sequencer, reads chain state, reports the three rungs, and no longer calls the retired custody, anchor and verify interfaces."
requirements = ["8001", "8002", "8003", "8004", "8005", "8006", "8007", "8008", "8009", "8010", "8011", "8012", "8013", "8014", "8015", "8016", "8017", "8018", "8019", "8020", "8021", "8022", "8023", "8024", "8025", "8026", "8027", "8028", "8029", "8030", "8031", "8032", "8033", "8034", "8035", "8036", "8037", "8038", "8039", "8040", "8041", "8042", "8043", "8044", "8045", "8046", "8047", "8048", "8049", "8050", "8051", "8052", "8053", "8054", "8055", "8056", "8057", "8058", "8059", "8060", "8061", "8062", "8063", "8064", "8065", "8066", "8067", "8068", "8069", "8070", "8071", "8072", "8073", "8074", "8075", "8076", "8077", "8078", "8079"]
completion_task = "8.7.21"

[req.8001]
title = "Wallet send and receive of PAX and ERC-20 returns the signed receipt"
disposition = "KEEP the EVM transaction, RE-POINT submission"
ac_1 = "POST /v1/wallet/send (human/wallet/gateway/src/routes/sign.ts:549) submits the quorum-signed transaction through RpcPool.sendRawTransaction (human/wallet/gateway/src/rpc/pool.ts:218) to the sequencer and answers with the transaction hash and the verified signed receipt instead of the hash alone (human/wallet/gateway/src/routes/sign.ts:610)."
ac_2 = "The pool method eth_sendRawTransaction (human/wallet/gateway/src/rpc/pool.ts:219) keeps failover across RPC_URLS (human/wallet/gateway/src/env.ts:221) for reads but routes every write to the sequencer, so a send is receipted before the call returns."
ac_3 = "A send whose receipt carries status 0 is reported as receipted with the decoded Error(string) code and never as success (rung table in contracts/clients.md (a); response at human/wallet/gateway/src/routes/sign.ts:610)."

[req.8002]
title = "Wallet swap settles through the sequencer and reads its output from receipt logs"
disposition = "KEEP"
ac_1 = "executeSwap (human/apps/wallet/src/lib/swap/executor.ts:31) dispatches PECOR, HLPMMv2 and Sidiora routes (human/apps/wallet/src/lib/swap/executor.ts:37) unchanged and each signed router call is submitted through the sequencer send path of row 1."
ac_2 = "parseUsdlReceived (human/apps/wallet/src/lib/swap/executor.ts:142) reads the output amount from the logs of the signed receipt rather than from a later block receipt."
ac_3 = "ensureApproval (human/apps/wallet/src/lib/swap/executor.ts:18) waits for the receipted approval before the swap transaction is signed, so the swap nonce is the approval nonce plus one."

[req.8003]
title = "Wallet exchange surface targets the merged exchange construct"
disposition = "RE-POINT"
ac_1 = "The exchange surface (human/apps/wallet/src/surfaces/ExchangeView.tsx:32) builds its module from the SDK exchange module (human/wallet/sdk/src/modules/exchange.ts:46) against the layerxexchange 0x1015 v2 ABI and reads the order result from the signed receipt."
ac_2 = "depositMargin (human/wallet/sdk/src/modules/exchange.ts:55) moves margin in the same transaction to the derived margin account instead of a custody escrow, and the surface action at human/apps/wallet/src/surfaces/ExchangeView.tsx:62 shows the new margin from the receipt."
ac_3 = "withdrawMargin (human/wallet/sdk/src/modules/exchange.ts:58) releases free margin to the caller main address in one call from the surface action at human/apps/wallet/src/surfaces/ExchangeView.tsx:64."

[req.8004]
title = "Wallet bridge surface reads the outbound nonce from the receipt"
disposition = "KEEP 0x1016 bridgeOut"
ac_1 = "The bridge surface (human/apps/wallet/src/surfaces/BridgeView.tsx:18) calls bridgeOut through the SDK bridge module (human/wallet/sdk/src/modules/bridge.ts:38), which reaches precompiles/layerxbridge/layerxbridge.go:247 unchanged."
ac_2 = "The surface reads the outbound nonce from the BridgeOut log in the signed receipt (receiptEvents at human/apps/wallet/src/surfaces/useSurface.ts:72) instead of waiting for a block receipt."
ac_3 = "A paused bridge answers with Error(string) LXP_BRIDGE_PAUSED in a status-0 receipt and the surface shows the refusal (modules/layerxbridge/keeper/bridge.go:142)."

[req.8005]
title = "Wallet launchpad surface submits through the sequencer"
disposition = "KEEP"
ac_1 = "The launchpad surface (human/apps/wallet/src/surfaces/LaunchpadView.tsx:28) calls buy and sell through the SDK launchpad module (human/wallet/sdk/src/modules/launchpad.ts:46, human/wallet/sdk/src/modules/launchpad.ts:47) at 0x1017 unchanged."
ac_2 = "Market creation from the surface (human/apps/wallet/src/surfaces/LaunchpadView.tsx:55) is receipted before the market page opens."
ac_3 = "The launchpad module factory (human/wallet/sdk/src/modules/launchpad.ts:40) keeps its selectors; the launchpad surface tests pass unchanged."

[req.8006]
title = "Wallet fee denomination choice through feeToken 0x1018"
disposition = "KEEP"
ac_1 = "useFeeSelection (human/apps/wallet/src/surfaces/useSurface.ts:195) reads and writes the fee preference through the feeToken module (human/wallet/sdk/src/modules/fee-token.ts:13) at 0x1018 unchanged."
ac_2 = "applyPreference (human/apps/wallet/src/surfaces/useSurface.ts:226) clears the preference through clearFeeDenom (human/wallet/sdk/src/modules/fee-token.ts:40) and the chain charges PAX afterwards (precompiles/feetoken/feetoken.go:105)."
ac_3 = "The preference covers former kernel actions, because every write is an EVM transaction charged through modules/evm/keeper/feetoken.go:16."

[req.8007]
title = "Wallet web-data surface stays on xweb 0x1019"
disposition = "KEEP"
ac_1 = "The web-data surface (human/apps/wallet/src/surfaces/WebDataView.tsx:65) sends request and refund through the SDK web-data module (human/wallet/sdk/src/modules/web-data.ts:110) unchanged."
ac_2 = "Refund (human/wallet/sdk/src/modules/web-data.ts:123) of an origin-1 request is unchanged and is receipted before the surface reports it (human/apps/wallet/src/surfaces/WebDataView.tsx:99)."
ac_3 = "The draw list at human/apps/wallet/src/surfaces/WebDataView.tsx:102 shows budgets and caps from chain reads only."

[req.8008]
title = "Wallet custody deposit flow is removed"
disposition = "DELETE"
ac_1 = "DepositFlow (human/apps/wallet/src/account/DepositFlow.tsx:159) and its custody calldata builder depositTokenCalldata (human/apps/wallet/src/account/custody.ts:30) are removed; no wallet path calls 0x1013 deposit or depositToken."
ac_2 = "The custody hand-off domain (human/apps/wallet/src/account/custody.ts:5) and beneficiaryOf (human/apps/wallet/src/account/custody.ts:22) are removed with their tests."
ac_3 = "A call to 0x1013 deposit after the activation height returns Error(string) LXP_MODULE_DISABLED, so a stale client cannot move funds into a retired escrow (precompiles/layerxcustody/layerxcustody.go:408)."

[req.8009]
title = "Wallet balances read bank and pointer state only"
disposition = "RE-POINT"
ac_1 = "getBalances (human/wallet/sdk/src/endpoint.ts:74) reads px_getBalances (human/wallet/sdk/src/endpoint.ts:76) answered from bank 0x1001 and pointerview 0x100A without the custody getAsset join (human/crates/layerx-network-gateway/src/lib.rs:338)."
ac_2 = "listAssets (human/wallet/sdk/src/endpoint.ts:58) returns asset metadata from bank name, symbol, decimals and supply keyed by denom instead of 32-byte asset ids."
ac_3 = "The asset list (human/apps/wallet/src/account/AssetList.tsx:91) shows one-domain balances and no kernel side."

[req.8010]
title = "Wallet history reads explorer address transactions"
disposition = "RE-POINT"
ac_1 = "getUnifiedHistory (human/wallet/sdk/src/endpoint.ts:92) is replaced by a read of the explorer address transactions; px_getUnifiedHistory (human/wallet/sdk/src/endpoint.ts:99) has no wallet caller."
ac_2 = "HistoryView (human/apps/wallet/src/account/HistoryView.tsx:37) pages the explorer list by its cursor and no row is labelled with the LayerX side (human/apps/wallet/src/account/HistoryView.tsx:83)."
ac_3 = "Transactions before the activation height stay readable through the frozen kernel archive route of the explorer (archive decision in section 4 of the human surfaces table)."

[req.8011]
title = "Wallet kernel plan becomes an EVM transaction plan"
disposition = "RE-POINT"
ac_1 = "KernelPlan (human/apps/wallet/src/account/KernelPlan.tsx:161) receives from planIntent (human/apps/wallet/src/account/KernelPlan.tsx:166) a plan of EVM calls (to, data, value) for the target construct instead of kernel activity bytes."
ac_2 = "submitPlan (human/apps/wallet/src/account/KernelPlan.tsx:201) signs each call with the embedded wallet or MetaMask and submits through the sequencer; the journey state follows the signed receipts."
ac_3 = "A plan refused by the service is shown with its typed code (human/apps/wallet/src/account/KernelPlan.tsx:183)."

[req.8012]
title = "Wallet SDK kernel reads move to eth and px reads"
disposition = "RE-POINT"
ac_1 = "KernelClient (human/wallet/sdk/src/kernel.ts:85) reads lx_getAccount (human/wallet/sdk/src/kernel.ts:95) through px_getAccount and lx_getBalances (human/wallet/sdk/src/kernel.ts:100) through bank reads."
ac_2 = "lx_getSequence (human/wallet/sdk/src/kernel.ts:104) moves to eth_getTransactionCount on the pending tag and lx_getReceipt (human/wallet/sdk/src/kernel.ts:108) to pax_sequencerReceipt."
ac_3 = "lx_getActivityStatus (human/wallet/sdk/src/kernel.ts:112) and lx_getWalletCaps (human/wallet/sdk/src/kernel.ts:216) are removed; a gateway answering -32601 for an lx_ name leaves the SDK unaffected."

[req.8013]
title = "Status ladder rungs are submitted, receipted and committed"
disposition = "RE-POINT"
ac_1 = "LadderRung (human/wallet/sdk/src/ladder.ts:4) becomes submitted, receipted and committed and LADDER_RUNGS (human/wallet/sdk/src/ladder.ts:13) lists exactly those three in order."
ac_2 = "readExplorerStatus (human/wallet/sdk/src/ladder.ts:99) maps the explorer status answer (human/wallet/sdk/src/ladder.ts:107) onto the three rungs and the anchor table (human/wallet/sdk/test/ladder.test.ts:81) is removed."
ac_3 = "The wallet StatusLadder (human/apps/wallet/src/account/StatusLadder.tsx:24) renders the three rungs and the send check (human/apps/wallet/e2e/send.spec.ts:104) expects receipted where it expected instant."

[req.8014]
title = "Sponsored gas enforces per-identity budgets"
disposition = "KEEP plus per-identity budgets"
ac_1 = "The sponsorship routes (human/wallet/gateway/src/routes/wallet.ts:195) submit through the gas station with executeSponsoredAbi (human/wallet/gateway/src/routes/wallet.ts:192) and enforce a budget per DID resolved through addr 0x1004 getLayerXDid."
ac_2 = "The gateway sponsor key input (human/wallet/gateway/src/env.ts:240, read at human/wallet/gateway/src/routes/wallet.ts:37) is removed; sponsorship goes only through the gas station."
ac_3 = "The web fee-budget check (human/apps/web/e2e/native-fee-budget.test.ts) asserts the sponsorship budget instead of a kernel budget, and sponsored/status (human/wallet/gateway/src/routes/wallet.ts:236) reports the remaining budget."

[req.8015]
title = "Portfolio, token, transaction detail and discover views stay on the explorer API"
disposition = "KEEP"
ac_1 = "The wallet API proxy (human/apps/wallet/src/app/api/wallet/[...path]/route.ts:52) stays dynamic and forwards to the explorer API (human/apps/wallet/src/app/api/wallet/[...path]/route.ts:123) unchanged."
ac_2 = "Transaction detail pages read native transactions only, so a sequencer-submitted transaction shows its receipt fields once indexed (explorer address view in explorer/backend/apps/explorer/lib/explorer/chain/paxeer_x/unified_account.ex:123)."
ac_3 = "No wallet backend route reads a kernel endpoint after the change (human/apps/wallet/src/app/api/wallet/[...path]/route.ts:123)."

[req.8016]
title = "Wallet off-chain backends stay unchanged"
disposition = "KEEP"
ac_1 = "PNS, points, FX, candles, icons, push, chat, contacts, settings and health backends under the wallet API routes (human/apps/wallet/src/app/api/wallet/[...path]/route.ts:52) need no chain change."
ac_2 = "Swaps by direct signing still settle while a backend is down (human/apps/wallet/src/lib/swap/executor.ts:31)."
ac_3 = "The backends hold no signing key (human/apps/wallet/src/app/api/wallet/[...path]/route.ts:123 forwards only)."

[req.8017]
title = "Embedded wallet provisioning binds the DID through addr 0x1004"
disposition = "KEEP 0x1004"
ac_1 = "bindLayerX (human/wallet/gateway/src/provision/bind.ts:330) builds the bind message (human/wallet/gateway/src/provision/bind.ts:67) under BIND_DOMAIN (human/wallet/gateway/src/provision/bind.ts:23) and the calldata (human/wallet/gateway/src/provision/bind.ts:91) for addr 0x1004 bindLayerX (precompiles/addr/addr.go:38)."
ac_2 = "The bind transaction is sponsored through the gas station instead of a gateway top-up, and waitForReceipt (human/wallet/gateway/src/provision/bind.ts:309) is replaced by the signed receipt of the send."
ac_3 = "An address already bound to a different DID is refused through readUnifiedAccount (human/wallet/gateway/src/provision/bind.ts:108) before any signing."

[req.8018]
title = "Wallet availability reads sequencer health"
disposition = "RE-POINT"
ac_1 = "readKernelAvailability (human/wallet/gateway/src/provision/bind.ts:130) stops reading layerxAnchor latestFinalized (human/wallet/gateway/src/provision/bind.ts:132) and reads the latest receipted height from the sequencer."
ac_2 = "/v1/wallet/me (human/wallet/gateway/src/routes/wallet.ts:136) reports sequencer availability from the read above (human/wallet/gateway/src/routes/wallet.ts:146)."
ac_3 = "No gateway read reaches 0x1014 after the change (human/wallet/gateway/src/provision/bind.ts:133)."

[req.8019]
title = "Embedded wallet custody signing is removed"
disposition = "DELETE"
ac_1 = "The custody routes (human/wallet/gateway/src/routes/sign.ts:429, human/wallet/gateway/src/routes/sign.ts:446, human/wallet/gateway/src/routes/sign.ts:461) are removed and answer 404."
ac_2 = "The custody domain and target (human/wallet/gateway/src/attestor/client.ts:1105, human/wallet/gateway/src/attestor/client.ts:1106) and decodeCustody (human/wallet/gateway/src/attestor/client.ts:1109) are removed from the attestor client."
ac_3 = "The custody authorization test (human/wallet/gateway/test/custody-authorization.test.ts:59) is removed; the e2e custody adapter cases (human/wallet/gateway/test/e2e/gateway.e2e.test.ts:247) are removed with it."

[req.8020]
title = "Key sharding and threshold signing stay the in-app custody"
disposition = "KEEP"
ac_1 = "The secp256k1 threshold is 3 (human/wallet/attestor/internal/tss/ecdsa/ecdsa.go:26) and the ed25519 set is 3 of 5 (human/wallet/attestor/internal/tss/eddsa/eddsa.go:21)."
