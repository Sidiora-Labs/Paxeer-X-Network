qualification = "UNRUN"

[acceptance.13.3.3]
feature = "13"
req = "13003.3"
scenario = "Given the sequencer RPC, when pax_sequencerReceipt is called with an unknown hash, then it returns null and with a receipted hash it returns the signed receipt."
contract = "contracts/sequencer.md#(b1) Methods"
