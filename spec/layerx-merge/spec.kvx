[contract_context.4.module_host]
interface = "modules/layerxprograms hosts the kernel programs module through its registration interfaces (src/modules/programs/registration.c:248, src/modules/programs/registration.c:268, src/modules/programs/registration.c:288) and the runtime staticlib through cgo behind the lxp_module_ctx shim (decision.1)."
storage = "All program state lives under the layerxprograms store key, beside the existing module store wiring at node/app.go:266."
activation = "A bring-up at the activation height; no account-state migration is required; the plan is registered in node/upgrades.go:117 and listed in node/upgrades.go:416."
invariants = "The module version stays the kernel value read by src/modules/programs/registration.c:348 and the build links the runtime through cgo as wasm-runtime/version_cgo.go:1 does."

[contract_context.4.principal]
interface = "The principal of every 0x101D call is the LayerX identity bound to msg.sender at 0x1004, resolved by modules/evm/keeper/layerx_binding.go:18; an unbound sender is refused."
storage = "The 32-byte account id is derived from the identity as src/ledger/lx_account_id.c:196 derives it."
errors = "A principal that does not match the transfer leg source is refused with the scope refusal (src/modules/programs/transfer.c:108, src/modules/programs/call.c:2238)."
invariants = "Delegated authority comes from authz LayerX-scope grants mapped to the kernel authority kinds at src/state/lxp_authority.c:780-782 (decision.3)."

[contract_context.4.height_gate]
activation = "Every selector refuses below the activation height as the custody keeper gates at modules/layerxcustody/keeper/keeper.go:42."
interface = "The activation constant follows the pattern of modules/layerxcustody/types/governance_activation.go:5 and is set at activation rehearsal."
storage = "The Paused param refuses every state-writing selector while set; views stay served (precompiles/common/precompiles.go:82)."

[contract_context.4.revert]
errors = "Every refusal reverts as Error(string) with text LXP_<code>: <message>, produced through precompiles/common/precompiles.go:53 and precompiles/common/precompiles.go:59."
lifecycle = "Deploy refuses a reused sequence (src/modules/programs/deploy.c:497) and fee governance refuses a reused or out-of-order sequence (src/modules/programs/fees.c:536, src/modules/programs/fees.c:871)."
call = "Call refuses an unpayable fee (src/modules/programs/call.c:1903), an asset mismatch (src/modules/programs/call.c:1913) and a root mismatch (src/modules/programs/call.c:963)."
winddown = "Wind-down refuses a frozen account (src/modules/programs/winddown.c:398), a context mismatch (src/modules/programs/winddown.c:395) and a disabled module (src/modules/programs/winddown.c:647)."
retirement = "Retirement refuses duplicates and unsorted lists (src/modules/programs/blob_lifecycle.c:300, src/modules/programs/blob_lifecycle.c:301), an attestation below threshold (src/modules/programs/blob_lifecycle.c:486) and an unmet condition (src/modules/programs/blob_lifecycle.c:798)."

[contract_context.4.gas]
gas = "RequiredGas is a fixed per-method table; reads cost 1000 + 3 x len and writes 2000 + 30 x len, derived from sdk/store/types/gas.go:349 in place of precompiles/common/precompiles.go:286."
surcharge = "retireStorage adds 2 x precompiles/addr/addr.go:53 plus 20000 for its signature checks."
separation = "Gas pays EVM execution only; the program fee is charged separately from the program payment account (src/protocol/lxp_kernel.c:213)."

[contract_context.4.fee]
interface = "The program fee equals metered usage times the schedule prices resolved at src/modules/programs/fees.c:1828 and settled by src/modules/programs/fee.c:154."
storage = "Fee schedules are kept by sequence; current, by-sequence and pending reads come from src/modules/programs/fees.c:1633, src/modules/programs/fees.c:1608 and src/modules/programs/fees.c:1355."
governance = "Schedules change only through gov messages staged by src/modules/programs/fees.c:1288 under authority kind include/layerx/programs.h:403; the kernel relay ordinal decoded at src/modules/programs/fees.c:1089 is not user dispatch."
bounds = "Out-of-bound prices are refused (src/modules/programs/fees.c:341) and overflow is refused (src/modules/programs/fees.c:1399)."
quote = "quoteCallFee returns the sum over i = 0..5 of budget[i] x prices[i] with the prices bound at src/protocol/lxp_kernel.c:568-580."

[contract_context.4.metering]
interface = "Metering schedules are read by src/modules/programs/metering.c:182 and src/modules/programs/metering.c:205."
