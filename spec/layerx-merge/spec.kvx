[feature.6]
name = "agent"
scope = "The Paxeer X Network agent stack on EVM transactions: the seven layerxagent precompiles at 0x0901-0x0908 (0x0903 stays with the trading feature) with their gateway routes, tool-exec attestation bound to the activity, agentd and agentd-host writing signed EIP-1559 transactions, session.open and agent.register, agent-api major 2 with generated SDKs and platform verifiers, MCP, portable receipt v2, x402 and the agent-side replacement of every retired kernel path."
requirements = ["6001", "6002", "6003", "6004", "6005", "6006", "6007", "6008", "6009", "6010", "6011", "6012", "6013", "6014", "6015", "6016", "6017", "6018", "6019", "6020", "6021", "6022", "6023", "6024", "6025", "6026", "6027", "6028", "6029", "6030", "6031", "6032", "6033", "6034", "6035", "6036", "6037", "6038", "6039", "6040", "6041", "6042", "6043", "6044", "6045", "6046", "6047", "6048", "6049", "6050", "6051", "6052", "6053", "6054", "6055", "6056", "6057", "6058", "6059", "6060", "6061", "6062", "6063", "6064", "6065", "6066", "6067", "6068", "6069", "6070", "6071", "6072", "6073", "6074", "6075", "6076", "6077", "6078", "6079", "6080", "6081", "6082", "6083", "6084", "6085", "6086", "6087", "6088", "6089", "6090", "6091", "6092", "6093", "6094", "6095", "6096", "6097", "6098", "6099", "6100", "6101", "6102", "6103"]
completion_task = "6.7.13"

[req.6001]
title = "Shared layerxagent framework: selector dispatch, revert form, guards, height gate and fixed gas"
ac_1 = "Every layerxagent precompile resolves its method through MethodById (precompiles/common/precompiles.go:68-80) and an unknown selector costs UnknownMethodCallGas 3000 (precompiles/common/precompiles.go:22) and reverts with LXP_PRECOMPILE_UNKNOWN_METHOD."
ac_2 = "Every write method refuses delegatecall with LXP_AGENT_DELEGATECALL, following the guard at precompiles/layerxexchange/layerxexchange.go:206, and refuses a static context with LXP_AGENT_READ_ONLY."
ac_3 = "Every method refuses below the merge plan height using the upgrade check pattern at modules/layerxcustody/keeper/keeper.go:42, and revert reasons are Error(string) with the LXP_ prefix through WithRevertReasons (precompiles/common/precompiles.go:53)."
ac_4 = "RequiredGas follows the fixed table: read 1000 + 3 per input byte and write 2000 + 30 per input byte, in the DefaultGasCost pattern (precompiles/common/precompiles.go:286-292), with decision.30 fixing per-method gas."

[req.6002]
title = "orob resolver 0x0901: resolveOffset, resolveOffsetBatch and toOffset"
ac_1 = "resolveOffset(int256,int16) (0x454ad3a1) returns oraclePrice x (10000 + offsetBps) / 10000 truncated toward zero, refuses oraclePrice <= 0 with LXP_AGENT_OROB_ORACLE_PRICE and offsetBps <= -10000 with LXP_AGENT_OROB_OFFSET_RANGE; the address is registered in the gateway map at human/wallet/gateway/src/precompiles.ts:17-29."
ac_2 = "resolveOffsetBatch(int256,int16[]) (0x3df597e3) returns one price per offset and refuses more offsets than the cap with LXP_AGENT_BATCH_TOO_LARGE; gas is the read class of the table (precompiles/common/precompiles.go:286-292)."
ac_3 = "toOffset(int256,int256) (0x3f779aef) returns (absolutePrice - oraclePrice) x 10000 / oraclePrice and refuses a result outside int16 with LXP_AGENT_OVERFLOW; the precompile never reads the 0x1015 spot book (decision.22)."

[req.6003]
title = "batch clearing 0x0902: computeClearing with the struct ABI"
ac_1 = "computeClearing (0x8397e9f8, struct form, decision.31) evaluates candidate levels as the unique offsets ascending, computes volume(l) = min(demand, supply) and returns the lowest level among the maxima with its price from resolveOffset; the 0x0902 address is listed at human/wallet/gateway/src/precompiles.ts:19."
ac_2 = "An empty side, or a best buy below the cheapest sell, returns (0, oraclePrice, 0) without reverting; the parallel-array selector 0xb6a4c9ae is not served and resolves to the unknown-method path (precompiles/common/precompiles.go:22)."
ac_3 = "More orders than the cap revert with LXP_AGENT_BATCH_TOO_LARGE and oraclePrice <= 0 reverts with LXP_AGENT_OROB_ORACLE_PRICE; gas is 6000 + 3 per input byte (pattern precompiles/common/precompiles.go:286-292)."

[req.6004]
title = "pofq scorer 0x0904: scoreFill, scoreBatch and updateRollingScore"
ac_1 = "scoreFill (0xe087a6ba) returns max(0, 1e18 - |fill - oracle| x 1e18 / oracle) and refuses oraclePrice <= 0; the oracle input is the committed price read by lx_oracle_committed_read (src/modules/perps/lx_oracle_read.c:93), supplied by the caller."
ac_2 = "scoreBatch (0x1b1fba48, struct form, decision.31) returns (sum score x size / sum size, sum size) and returns (0, 0) for empty input or zero volume; the pofq address is human/wallet/gateway/src/precompiles.ts:21."
ac_3 = "updateRollingScore (0xa8f32b0e) returns updatedScore = (cs x cw x (10000 - d) + ns x nw x 10000) / w and updatedWeight = w / 10000 with w = cw x (10000 - d) + nw x 10000, refusing decayBps >= 10000 with LXP_AGENT_POFQ_DECAY_RANGE (agent-functions changes table, bounded weight)."

[req.6005]
title = "scheduler 0x0905: schedule, cancel, reschedule, getJob and pending"
ac_1 = "schedule(address,bytes,uint64,uint64) (0x849ba0a3, payable) stores a job when target is nonzero, height < executeAtBlock <= height + 2,592,000, 0 < gasLimit <= the per-job cap and msg.value >= gasLimit x baseFee x 2, emitting JobScheduled; the gateway ABI is SCHEDULER_ABI at human/wallet/gateway/src/precompiles.ts:50."
ac_2 = "cancel(uint256) (0x40e58ee5) by the creator refunds the full deposit and deletes the job and indexes, logging JobCancelled; any other caller gets LXP_AGENT_SCHEDULER_UNAUTHORIZED; the gateway cancel route is at human/wallet/gateway/src/routes/agentPrecompiles.ts:105."
ac_3 = "reschedule(uint256,uint64) (0x08e6f770) moves the due index and logs JobRescheduled; a block not above the current height reverts with LXP_AGENT_SCHEDULER_PAST_BLOCK; pending(address) returns at most 1024 active ids in id order (gateway route human/wallet/gateway/src/routes/agentPrecompiles.ts:146)."

[req.6006]
title = "scheduler store and end-block hook in the layerxagent keeper"
ac_1 = "The keeper stores jobs under prefixes due (block BE, id BE), creator index, job by id, params and next id, and enforces MaxJobsPerCreator 1024 with LXP_AGENT_SCHEDULER_MAX_JOBS; the address is reached by the gateway scheduler client at human/wallet/gateway/src/precompiles.ts:243."
ac_2 = "At each height the end-block hook runs due jobs in ascending id order up to the per-block cap, each under its own gasLimit at the base fee; fee = gasUsed x baseFee goes to the fee collector on success and on failure and the rest of the deposit returns to the creator (agent-functions F, decision.30)."
ac_3 = "A failing job charges gasUsed x baseFee, refunds the rest and emits JobFailed with the deterministic revert string truncated to the cap; jobs above the per-block cap roll to the next height (agent-functions changes table)."

[req.6007]
title = "payment streams 0x0906 executing through the 0x101B stream keeper"
ac_1 = "open (0x93e5b08b) keeps no store of its own and calls streamOpen on the 0x101B keeper with a chain-derived bytes32 streamId, rate := ratePerSecond and rateUnit 1000, funding through fund_context (src/modules/stream/lx_stream_open.c:204); a reused id is refused as at src/modules/stream/lx_stream_open.c:277."
ac_2 = "settle (0x8df82800) is accepted from the payer or the recipient only (src/modules/stream/lx_stream_execution.h:257-259) and pays min(unsettled, balance) through lx_stream_settle_execute (src/modules/stream/lx_stream_settle.c:95); close (0x0aebeb4e) is payer only (src/modules/stream/lx_stream_lifecycle.c:19-20) and refunds the unspent cap (src/modules/stream/lx_stream_lifecycle.c:87)."
ac_3 = "updateRate (0x405abb41) settles at the old rate to block-open time with lx_stream_accrue (include/layerx/lx_stream.h:217) before the new rate applies and logs StreamRateUpdated; accrued (0xf52981f4) runs the accrual on a copy loaded by lx_stream_load (src/modules/stream/lx_stream_state.c:37) and never saves."
ac_4 = "The token maps to an assetId through GetAssetByDenom and GetAssetByPointer (modules/layerxcustody/keeper/keeper.go:183, modules/layerxcustody/keeper/keeper.go:172) and addresses map to principals through GetLayerXDid (modules/evm/keeper/layerx_binding.go:18); an unmapped token reverts with LXP_AGENT_STREAMS_UNKNOWN_TOKEN."

[req.6008]
title = "tee attestor 0x0907: dev envelope verification against the xweb attestor roots"
ac_1 = "verify(uint8,bytes) (0x5fa55ca7) accepts families 0 TDX, 1 SEV-SNP, 2 NVIDIA H100 and 3 SGX (gateway TEE_FAMILIES at human/wallet/gateway/src/precompiles.ts:32-36), parses the PXVE 0x01 dev envelope, checks the signature over data[0:95] and returns (family, mrtd, reportData, timestamp, debug)."
ac_2 = "The roots are the xweb attestor set read through GetAttestorSet (modules/xweb/keeper/keeper.go:90) per decision.33, and the envelope needs 3 of 5 distinct secp256k1 attestor signatures per decision.34, matching the verifySignatures rule at modules/xweb/keeper/fulfil.go:17."
ac_3 = "A timestamp later than block-open time or older than 600 s reverts with LXP_AGENT_TEE_STALE, debug true reverts with LXP_AGENT_TEE_DEBUG_REFUSED and verifyAndExpect (0x71ded4b3) reverts with LXP_AGENT_TEE_REPORT_DATA_MISMATCH when reportData differs; the gateway verify route is at human/wallet/gateway/src/routes/agentPrecompiles.ts:277."

[req.6009]
title = "eip712 helper 0x0908: hashTypedData, domainSeparator and recoverTypedSigner"
ac_1 = "hashTypedData (0xd61c3c34) returns keccak256(0x19 0x01 || domainSeparator || structHash) and domainSeparator (0xe6d341cd) returns the EIP712Domain(string name,string version,uint256 chainId,address verifyingContract) hash; the gateway ABI is EIP712_ABI at human/wallet/gateway/src/precompiles.ts:153."
ac_2 = "recoverTypedSigner (0xac580b5c) returns the signer for a 65-byte r||s||v signature with v 27 or 28 and returns the zero address for a length other than 65, a bad v, a high s or a failed recovery."
ac_3 = "Name and version above the cap revert with LXP_AGENT_BATCH_TOO_LARGE, gas is 1000 + 3/byte for the hash methods and 4000 + 3/byte for recovery, and the gateway routes at human/wallet/gateway/src/routes/agentPrecompiles.ts:241, :254 and :264 reach the registered precompile."

[req.6010]
title = "Registration of 0x0901, 0x0902 and 0x0904-0x0908 in the precompile set"
ac_1 = "GetCustomPrecompiles (precompiles/setup.go:63) adds the seven layerxagent addresses to the custom map (precompiles/setup.go:67-87) behind the merge upgrade, so a call to 0x0901 at the plan height reaches the orob executor (decision.20)."
ac_2 = "0x0903 is registered by the trading feature; the agent registration leaves the 0x0903 key to that feature and adds no entry for it, so the map holds exactly one executor per address (agent-functions D3 oracle row)."
ac_3 = "Below the plan height the seven addresses are absent from the versioned map, following the upgrade comparison already used for xweb at precompiles/setup.go:93."

[req.6011]
title = "Gateway agent precompile routes reach only registered precompiles"
ac_1 = "agentPrecompileRoutes (human/wallet/gateway/src/routes/agentPrecompiles.ts:64) keeps the scheduler, streams, eip712 and tee routes and their signed-request pre-handlers; write routes call executeAgentTransaction and read routes call the registered address from human/wallet/gateway/src/precompiles.ts:17-29."
ac_2 = "Routes for orob, clearing and pofq are added beside the existing ones as read routes (POST /v1/agent/precompiles/orob/resolve-offset, /clearing/compute, /pofq/score-fill) with the requireAgent pre-handler used at human/wallet/gateway/src/routes/agentPrecompiles.ts:241."
ac_3 = "The write-route token refusal tested at human/wallet/gateway/test/agent.test.ts:267 still holds for every write route, and the address book route (human/wallet/gateway/src/routes/agentPrecompiles.ts:312) lists only the addresses registered at the current height."

[req.6012]
title = "Tool execution attestation binds to the activity idempotency key"
ac_1 = "execute_tool_exec_attest (src/modules/service/lx_service_module.c:197) compares payload activity_id with the executing activity idempotency key instead of lxp_ctx_activity_id (src/modules/service/lx_service_module.c:205-206), because the activity id is computed over the canonical encoding that carries the payload itself (src/protocol/lxp_kernel.c:379-381)."
ac_2 = "The module context exposes the executing activity idempotency key through a new accessor lxp_ctx_idempotency_key declared beside lxp_ctx_activity_id (include/layerx/lxp_kernel.h:355) and defined beside its body (src/protocol/lxp_module_ctx.c:1675); the key is the field written at src/protocol/lxp_activity.c:63-69."
ac_3 = "The test vector submits a real signed LX_SERVICE_TOOL_EXEC_ATTEST activity (include/layerx/lx_service.h:20) without setting ctx.activity_id by hand (tests/modules/test_service_helpers.h:91), and make test-service-attest (Makefile:741) passes."

[req.6013]
title = "TEE attestor 0x0907 verifies vendor quote formats"
ac_1 = "verify and verifyAndExpect (ABI human/wallet/gateway/src/precompiles.ts:189) accept TDX, SEV-SNP, SGX and NVIDIA H100 vendor quote formats in addition to the PXVE 0x01 dev envelope, selected by the family values at human/wallet/gateway/src/precompiles.ts:32-36."
ac_2 = "Each vendor chain is checked against the governance-set roots returned by rootOf and rootCount (gateway client human/wallet/gateway/src/precompiles.ts:474); a chain ending outside the set reverts with LXP_AGENT_TEE_UNTRUSTED_CHAIN."
ac_3 = "An unknown quote format within a known family reverts with LXP_AGENT_TEE_INVALID_QUOTE and the debug and staleness rules of the dev envelope apply unchanged; the gateway tee verify route (human/wallet/gateway/src/routes/agentPrecompiles.ts:277) needs no change."

[req.6014]
title = "agentd prepare builds an unsigned EIP-1559 transaction at the pending nonce"
ac_1 = "prepare_activity (agent/crates/layerx-agentd/src/prepare/mod.rs:331) and prepare_bound (agent/crates/layerx-agentd/src/prepare/mod.rs:371) return an unsigned Eip1559Call (agent/crates/layerx-crypto/src/evm_transaction.rs:9) with chainId 125, nonce from eth_getTransactionCount(address, pending), to = the target precompile and data = the construct ABI call carrying the idempotency key and deadline."
ac_2 = "The preimage returned by prepare is signing_hash (agent/crates/layerx-crypto/src/evm_transaction.rs:82) = keccak256(0x02 || rlp(fields)) and gas comes from eth_estimateGas against pending; the StaleSequence comparison against the kernel actor sequence (agent/crates/layerx-agentd/src/prepare/mod.rs:384-390) is replaced by the pending nonce read."
ac_3 = "When the sequencer is unreachable, prepare is refused and never falls back to a cached nonce (services S26 failure mode), and the disclosure is decoded from calldata through the target ABI instead of the kernel payload codec."

[req.6015]
title = "agentd sign produces and verifies 65-byte secp256k1 signatures"
ac_1 = "verify_before_submit (agent/crates/layerx-agentd/src/sign.rs:324) recovers the secp256k1 signer of the preimage and refuses unless it equals the address bound to the actor DID by addr getLayerXDid (precompiles/addr/addr.go:391)."
ac_2 = "rpc_sign (agent/crates/layerx-agentd/src/human_runtime.rs:543) keeps its refusal of non-holder authority and attaches a 65-byte r||s||v signature, and AgentSignature (agent/crates/layerx-crypto/src/signer.rs:106) widens from 64 to 65 bytes behind the same Signer trait."
ac_3 = "attach_external_signature (agent/crates/layerx-agentd/src/sign.rs:310) accepts only a 65-byte external signature and external (agent/crates/layerx-agentd/src/sign.rs:231) hands out the EIP-1559 preimage, so KMS and remote signers sign secp256k1."

[req.6016]
title = "agentd session-key self-sign through a layerxauth session grant"
ac_1 = "self_sign (agent/crates/layerx-agentd/src/sign.rs:248) signs with a secp256k1 key derived from the session seed prepared by prepare_seed (agent/crates/layerx-agentd/src/session_keys.rs:73), whose address is bound to the session ed25519 key through addr and is its own transaction sender."
ac_2 = "provision (agent/crates/layerx-agentd/src/session_keys.rs:150) issues layerxauth grantSession(bytes,uint64,bytes32) at 0x101C before first use and keeps the returned grantId; revoke (agent/crates/layerx-agentd/src/session_keys.rs:214) sends layerxauth revokeGrant(bytes32,uint8,uint64) for that grantId."
ac_3 = "On chain, every LayerX precompile resolves a session-key sender to the principal through the layerxauth grant, so a session write is charged to the holder DID and bounded by the grant scope (clients B7)."

[req.6017]
title = "agentd submit sends the raw transaction and fetches the sequencer receipt"
ac_1 = "dispatch_queued (agent/crates/layerx-agentd/src/human_runtime.rs:12046) replaces submit_signed (agent/crates/layerx-agentd/src/human_runtime.rs:12067) with eth_sendRawTransaction(raw) followed by pax_sequencerReceipt(txHash), storing the raw bytes and txHash before the send."
ac_2 = "The client submit path submit_signed (agent/crates/layerx-client/src/submit.rs:183) and verify_submission (agent/crates/layerx-client/src/submit.rs:306) re-verify the raw transaction and its 65-byte signature instead of the 64-byte ed25519 check (agent/crates/layerx-client/src/submit.rs:333)."
ac_3 = "A send that times out or loses its connection maps to Unknown with the exact raw transaction kept, never Failed; a JSON-RPC refusal (nonce too low, replacement) maps to Failed with no receipt (sequencer b3)."

[req.6018]
title = "agentd outbox states and restart recovery keyed by transaction hash"
ac_1 = "SubmissionState (agent/crates/layerx-agentd/src/outbox/mod.rs:25) drops Superseded and gains Committed, and legal_transition (agent/crates/layerx-agentd/src/outbox/mod.rs:366) allows Executed to Committed and Failed to Committed only for a receipted revert."
ac_2 = "enqueue (agent/crates/layerx-agentd/src/outbox/mod.rs:129) keys rows by txHash and stores the raw signed bytes, and transition (agent/crates/layerx-agentd/src/outbox/mod.rs:285) maps receipted status 1 to Executed and receipted status 0 with Error(string) to Failed."
ac_3 = "recover (agent/crates/layerx-agentd/src/outbox/recover.rs:94), called from recover_tenant_budget (agent/crates/layerx-agentd/src/human_runtime.rs:1918), resumes Submitted and Unknown rows by txHash after a restart without re-signing and without sending a second transaction at a used nonce."

[req.6019]
title = "Unknown resolution by transaction hash and the layerxauth idempotency index"
ac_1 = "resolve_unknown (agent/crates/layerx-agentd/src/outbox/unknown.rs:111) looks up pax_sequencerReceipt(txHash) and, when absent, layerxauth resultByIdempotency(bytes32 didId, bytes32 idempotencyKey) instead of the kernel receipt-by-key route."
ac_2 = "A resend uses the exact same raw bytes (same hash, same nonce), so the sequencer either returns the existing receipt or executes it once; the backoff of backoff_ms (agent/crates/layerx-agentd/src/outbox/unknown.rs:222) is unchanged."
ac_3 = "The admin resolve path (agent/crates/layerx-agentd/src/admin.rs:388) and the client resolve_unknown (agent/crates/layerx-client/src/receipt.rs:420) use the same lookup order."

[req.6020]
title = "agentd idempotency store and on-chain idempotent replay"
ac_1 = "The local Store (agent/crates/layerx-agentd/src/idempotency.rs:89) and execute (agent/crates/layerx-agentd/src/idempotency.rs:151) keep local dedupe per (tenant, key) unchanged, returning the first stored response for a repeated key."
ac_2 = "On chain, a second construct call with the same idempotency key from the same DID is refused with LXP_IDEMPOTENT_REPLAY and layerxauth resultByIdempotency returns the first result (clients conformance V9)."
ac_3 = "sweep (agent/crates/layerx-agentd/src/idempotency.rs:224) ages entries by committed height instead of the kernel current_sequence, so a key is never swept before its transaction is committed."

[req.6021]
title = "track maps the outbox row to the submitted, receipted and committed rungs"
ac_1 = "track_with_settlement (agent/crates/layerx-agentd/src/human_runtime.rs:12682) reports rung submitted when only the txHash is known, receipted when pax_sequencerReceipt returns a signed receipt verified by ed25519 against the pinned ReceiptKeys entry (verifier at agent/crates/layerx-proof/src/receipt.rs:631), and committed when eth_getTransactionReceipt answers and the Comet commit at that height verifies."
ac_2 = "receipt_by_idempotency_key_with_settlement (agent/crates/layerx-agentd/src/human_runtime.rs:12802) stops fetching AuthorizedBatch from the authority route (agent/crates/layerx-agentd/src/human_runtime.rs:1379); the receipt key comes from the router ReceiptKeys list (clients B13) and the commit from the Comet RPC through the router."
ac_3 = "augment (agent/crates/layerx-agentd/src/finality.rs:77) and augment_verified (agent/crates/layerx-agentd/src/finality.rs:173) attach committed evidence (block header, receipt inclusion, commit, validator set) checked with the commit rule of custodyproof/verify.go:173 (signatures from more than 2/3 voting power)."

[req.6022]
title = "wait blocks until the requested rung or the deadline"
ac_1 = "wait_with_settlement (agent/crates/layerx-agentd/src/human_runtime.rs:12907) performs one track, compares the reached rung with the requested rung (submitted < receipted < committed) and returns as soon as the requested rung is reached or the deadline passes."
ac_2 = "wait_for_level (agent/crates/layerx-agentd/src/finality.rs:289), used by the admin path (agent/crates/layerx-agentd/src/admin.rs:533), polls the same rung source and never reports a rung higher than its evidence."
ac_3 = "Rung receipted is reached at submit return because pax_sequencerReceipt answers at once after eth_sendRawTransaction (sequencer b1), so wait for receipted needs no polling."

[req.6023]
title = "project returns a gas fee projection carrying its denomination"
ac_1 = "fee_projection (agent/crates/layerx-agentd/src/human_runtime.rs:16188) returns gasLimit from eth_estimateGas at pending, maxFeePerGas and maxPriorityFeePerGas from the node, feeLimit = gasLimit x maxFeePerGas, and the fee denomination of the payer from the feetoken charge (modules/evm/keeper/feetoken.go:92)."
ac_2 = "When the payer has a fee token preference, the projection also carries the converted amount in that token at the feetoken rate, and a sponsored (7702) projection names the sponsor as payer."
ac_3 = "An estimate that reverts returns the decoded LXP_ revert code instead of a projection, so the caller sees the refusal before signing."

[req.6024]
title = "read.account and read.balance from pending EVM state"
ac_1 = "account_state (agent/crates/layerx-agentd/src/human_runtime.rs:14939) and balance (agent/crates/layerx-agentd/src/human_runtime.rs:15036) read native PAX by eth_getBalance(address, pending), bank denoms through the bank precompile 0x1001 and kernel assets through layerxledger balanceOf at 0x101A, with the account id from addr getUnifiedAccount (precompiles/addr/addr.go:437)."
ac_2 = "The read is authorised locally by the agentd tenant binding instead of the authority balance-context route, and balance (agent/crates/layerx-agentd/src/read/balance.rs:35) keeps its response shape with the height in place of the kernel sequence."
ac_3 = "Kernel asset sub-account ids stay the ids derived by DeriveAccountID (layerxproof/codec/state.go:360), so the same asset balance is found under the same account id before and after the merge."

[req.6025]
title = "read.module_state by eth_call views and proven ABCI queries"
ac_1 = "read_module_state (agent/crates/layerx-agentd/src/human_runtime.rs:15283) serves pending reads by eth_call to the view of the module precompile and historical reads by abci_query /store/<module>/key with prove=true at the requested height."
ac_2 = "A historical height below the node retention answers unavailable with the oldest retained height instead of a value, so a client never takes a historical value without a proof."
ac_3 = "The native read route (agent/crates/layerx-agentd/src/read/native.rs:44) reads (agent/crates/layerx-agentd/src/read/native.rs:261) through the router instead of the kernel LNI socket."

[req.6026]
title = "read.history over the block and log indexer with a block-position cursor"
ac_1 = "read_history (agent/crates/layerx-agentd/src/human_runtime.rs:15542) and history (agent/crates/layerx-agentd/src/read/history.rs:99) read px_getHistory through the router and return entries ordered by (blockHeight, txIndex, logIndex)."
ac_2 = "The Cursor (agent/crates/layerx-agentd/src/read/history.rs:7) changes from the 112-hex kernel cursor to the triple (blockHeight, txIndex, logIndex) encoded as defined by read.kvx in agent-api major 2."
ac_3 = "Every page carries the indexer freshness head so a caller can tell a stale index from an empty history."

[req.6027]
title = "read.batch returns the block header and its Comet header"
ac_1 = "read_batch (agent/crates/layerx-agentd/src/human_runtime.rs:15314) returns eth_getBlockByNumber(height) with the Comet header fields (app hash, validators hash, proposer) for the same height, replacing the kernel batch header."
ac_2 = "A height above the head is refused with not_found and a height below retention with history_unavailable."
ac_3 = "The TS and Python native batch header tests decode the same block-plus-header shape."

[req.6028]
title = "read.checkpoint returns the verified Comet commit at a height"
ac_1 = "The ReadCheckpoint operation (agent/crates/layerx-agentd/src/agent_rpc_dispatch.rs:1205) returns the Comet commit for a height fetched through the router and verified with more than 2/3 voting power (custodyproof/verify.go:173) against the validator set of that height."
ac_2 = "The checkpoint proof bundle (agent/crates/layerx-agentd/src/read/checkpoint.rs:139) no longer requires a settlement domain (agent/crates/layerx-agentd/src/read/checkpoint.rs:85) or guarantor attestations."
ac_3 = "Without a height the call returns the latest committed height, which replaces the handshake head."

[req.6029]
title = "read.proof_bundle returns receipt inclusion and account proofs"
ac_1 = "rpc_read_proof_bundle (agent/crates/layerx-agentd/src/human_runtime.rs:4555) and proof_bundle (agent/crates/layerx-agentd/src/read/proof_bundle.rs:87) return, for an activity or receipt, the raw transaction, its receipt and the Merkle inclusion proof of that receipt in the block receiptsRoot with the block header."
ac_2 = "For an account, the bundle is eth_getProof at height H (or the IAVL proof of the module store), checked against the state root of that height."
ac_3 = "The PB1 wire format is replaced by the portable v2 field set and read.kvx proof_bundle changes in agent-api major 2."

[req.6030]
title = "availability.fetch is served by block retrieval"
ac_1 = "availability_fetch (agent/crates/layerx-agentd/src/human_runtime.rs:15771) and availability (agent/crates/layerx-agentd/src/read/availability.rs:145) return eth_getBlockByNumber(height, full) with the transactions, since block data availability is the chain own."
ac_2 = "Provider failure accounting is kept for the router endpoints, so a failing endpoint is counted the same way as a failing provider today."
ac_3 = "The kernel batch availability tags are no longer requested anywhere in agentd."

[req.6031]
title = "export.offline produces a self-contained portable v2 bundle"
ac_1 = "produce (agent/crates/layerx-agentd/src/export.rs:201) builds {rawTransaction, signedReceipt, blockHeader, receiptInclusion, commit, validatorSet} and an optional account proof, and the SettlementAnchored refusal (agent/crates/layerx-agentd/src/export.rs:207) is removed because that level no longer exists."
ac_2 = "export_offline (agent/crates/layerx-agentd/src/human_runtime.rs:16321) and build (agent/crates/layerx-agentd/src/export.rs:67) carry the validator set of the commit height, so an export stays verifiable after later validator changes."
ac_3 = "An export requested for a transaction that is only receipted is refused with not_committed, so a portable bundle is always committed evidence."

[req.6032]
title = "budget.create, fund and revoke through layerxpay budget methods"
ac_1 = "The BudgetMutation variants (agent/crates/layerx-agentd/src/budget/mutate.rs:16) map to layerxpay 0x101B budgetCreate, budgetCreateNative, budgetFund, budgetDefund, budgetRevoke and budgetClose, sent from the holder bound address with funds escrowed in the layerxpay module account."
ac_2 = "owned_budget_mutation (agent/crates/layerx-agentd/src/human_runtime.rs:11904) keeps holder-only authority and signs with the holder key through owner_signature (agent/crates/layerx-agentd/src/human_runtime.rs:19127) replaced by the 65-byte secp256k1 path; budget_create_labelled (agent/crates/layerx-agentd/src/human_runtime.rs:14489) keeps its labels in agentd only."
ac_3 = "confirm_budget_mutation (agent/crates/layerx-agentd/src/budget/mutate.rs:202) confirms from the receipt log instead of the kernel receipt, and budget_create_identity (agent/crates/layerx-agentd/src/budget/create.rs:108) and create_protocol_budget (agent/crates/layerx-agentd/src/budget/create.rs:270) derive the budget id from the BudgetCreated log."

[req.6033]
title = "Budget delegate spend and pull through layerxpay"
ac_1 = "A delegate spends through layerxpay budgetDelegateSpend and a payee pulls through budgetPull, with msg.sender resolved to a DID in the budget delegate set added by budgetDelegateAdd."
ac_2 = "A caller outside the delegate set, or one removed by budgetDelegateRemove, is refused with the layerxpay delegate refusal code and nothing moves."
ac_3 = "A spend above the remaining cap is refused with the layerxpay cap code, matching the kernel refusal codes of the budget module."

[req.6034]
title = "budget.list, budget.state and reconciliation on layerxpay views"
ac_1 = "budget.state reads layerxpay getBudget(budgetId) at pending, and reconcile_state (agent/crates/layerx-agentd/src/budget/reconcile.rs:100) compares local accounting with that view and the receipt logs."
ac_2 = "budget.list lists the holder budgets from BudgetCreated logs by holder through eth_getLogs and drops the authority budget-state route."
ac_3 = "Budget proof intake accepts the receipt inclusion evidence of the budget transaction in place of kernel proof kinds."

[req.6035]
title = "DaemonLimit stays a daemon-enforced local limit"
ac_1 = "DaemonLimitRecord (agent/crates/layerx-agentd/src/budget/daemon.rs:22) and create_daemon_limit (agent/crates/layerx-agentd/src/budget/daemon.rs:218) keep their semantics: the limit is checked by agentd before signing and is not a chain object."
ac_2 = "The limit is checked against fee-inclusive amounts in the gas denomination, so gas counts toward the daily total."
ac_3 = "The limit survives a daemon restart."

[req.6036]
title = "capability.create, attenuate, revoke and list bounded by layerxauth"
ac_1 = "capability_create (agent/crates/layerx-agentd/src/human_runtime.rs:15936), capability_attenuate (agent/crates/layerx-agentd/src/human_runtime.rs:16012) and capability_revoke (agent/crates/layerx-agentd/src/human_runtime.rs:16145) stay daemon-local, and the scope bound comes from layerxauth capabilityScope(bytes32) instead of the authority capability-scope route (agent/crates/layerx-agentd/src/human_runtime.rs:1561)."
ac_2 = "A capability that should bind on chain is issued by layerxauth grantCapability(bytes) and revoked by revokeGrant, and isLive reports its state."
ac_3 = "Attenuation only narrows: an attenuated capability never exceeds its parent scope."

[req.6037]
title = "session.open, refresh, close and list complete on layerxauth"
ac_1 = "session.open is no longer refused with refused_pending_bootstrap_artifact (agent/crates/layerx-agentd/src/agent_rpc_dispatch.rs:1355-1359): it provisions the session key and sends layerxauth grantSession(bytes,uint64,bytes32) at 0x101C."
ac_2 = "session_refresh (agent/crates/layerx-agentd/src/human_runtime.rs:15468) issues grantSessionSuccessor for the live grant and session_close (agent/crates/layerx-agentd/src/human_runtime.rs:15513) issues revokeGrant; both stay holder-only."
ac_3 = "session.list returns the local sessions with their on-chain liveness from isLive."

[req.6038]
title = "agent.register as a sponsored bindLayerX through 7702 plus the identity record"
ac_1 = "agent.register is no longer refused (agent/crates/layerx-agentd/src/agent_rpc_dispatch.rs:1355-1359): it creates the principal record through the identity service routes /v1/principals and /v1/signup and sends bindLayerX(bytes32,bytes) through the 7702 executeSponsored path of BatchCallAndSponsor (contracts/src/BatchCallAndSponsor.sol:135)."
ac_2 = "The bind message is signed by the DID ed25519 key over layerXBindNonce (clients B3, signing mode B) and the addr precompile refuses delegatecall (precompiles/addr/addr.go:157-162); a 7702 EOA CALL into addr is a CALL, proven by test."
ac_3 = "onboarding (agent/crates/layerx-crypto/src/onboarding.rs:23, :117) used at agent/crates/layerx-agentd/src/managed_agent.rs:477 builds the sponsored bind instead of the kernel sponsored onboarding."

[req.6039]
title = "Key rotation is out of scope and the rotation surface is refused"
ac_1 = "Per decision.16 rotation is out of scope: OwnerRotation (agent/crates/layerx-crypto/src/rotation.rs:241) and the managed rotation flow (agent/crates/layerx-agentd/src/managed_agent_rotation.rs:131) are not wired to any chain write, and a rotation request is refused with rotation_unsupported."
ac_2 = "Changing the EVM address remains possible only as unbindLayerX from the old address (modules/evm/keeper/layerx_binding.go:92) and bindLayerX from the new one, which agentd does not automate."
ac_3 = "The receipt key rotation is the sequencer ReceiptKeys list (clients B13), not an agent key rotation."

[req.6040]
title = "Approval holds and policy stay daemon-enforced before signing"
ac_1 = "Approval holds (agent/crates/layerx-agentd/src/human_runtime.rs:5270) and authorize_submit (agent/crates/layerx-agentd/src/human_runtime.rs:7463) stay unchanged and run before the secp256k1 signing step."
ac_2 = "A refused hold never produces a transaction or a nonce use."
ac_3 = "Policies evaluate the decoded calldata disclosure, so a policy on asset or recipient sees the same fields as before."

[req.6041]
title = "Faucet stays retired in agentd and is served by the router faucet route"
ac_1 = "faucet.claim stays in RETIRED_OPERATIONS (agent/crates/layerx-agentd/src/agent_rpc.rs:24) and refused (agent/crates/layerx-agentd/src/agent_rpc_dispatch.rs:1298); the funding path is the router px_requestFunds route backed by a funded account sending PAX or SID."
ac_2 = "The gateway lx_requestFunds handler (platform/hosted/gateway/src/rpc_faucet.rs:10, :280, :358) is replaced by px_requestFunds behind the router and lx_requestFunds answers -32601 after the switch-off."
ac_3 = "Faucet limits per address and per period are enforced by the router service, not agentd."

[req.6042]
title = "subscription operations on eth_subscribe"
ac_1 = "agentd subscriptions open eth_subscribe logs and newHeads through the router and resume from the cursor (blockHeight, txIndex, logIndex) after a reconnect."
ac_2 = "The client stream subscribe (agent/crates/layerx-client/src/stream.rs:322) uses eth_subscribe and eth_unsubscribe instead of the kernel stream tags."
ac_3 = "Pending-log events are ordered exactly as the proposal orders the block."

[req.6043]
title = "program.call and simulate on layerxprograms"
ac_1 = "The program call operation (agent/crates/layerx-agentd/src/ops/program.rs:1185) sends layerxprograms call (selector 0x54bd2b48) at 0x101D as a transaction and simulate uses simulateCall (0x3044bd56) by eth_call at pending."
ac_2 = "The SDK program client (agent/crates/layerx-sdk/src/program_http.rs:234) posts the same calls through the router instead of the programs REST routes."
ac_3 = "The call carries the idempotency key and deadline arguments so a replay is refused with LXP_IDEMPOTENT_REPLAY."

[req.6044]
title = "program.deploy, upgrade and wind-down on layerxprograms"
ac_1 = "The SDK and agentd program lifecycle operations send layerxprograms deploy, upgrade and windDown(mode) transactions from the program holder address."
ac_2 = "windDown modes follow the programs contract and a wound-down program refuses further calls."
ac_3 = "The native lifecycle conformance fixtures are regenerated from the chain construct, not the kernel test fixtures."

[req.6045]
title = "program.discover, interface, receipt and activity reads"
ac_1 = "Program discovery and interface reads are eth_call views on layerxprograms, receipt by idempotency is layerxauth resultByIdempotency(bytes32,bytes32) and activity is the transaction by hash."
ac_2 = "The REST routes /v1/programs/registry and /receipts/by-idempotency are no longer called."
ac_3 = "An unknown program id answers not_found."

[req.6046]
title = "MCP activity.prepare, disclose, sign, submit, track and wait over the EVM agentd path"
ac_1 = "tool_operation (agent/crates/layerx-mcp/src/server.rs:789-821) keeps the mapping prepare and disclose (agent/crates/layerx-mcp/src/server.rs:810), sign (agent/crates/layerx-mcp/src/server.rs:811), the submit group (agent/crates/layerx-mcp/src/server.rs:812-815), track (agent/crates/layerx-mcp/src/server.rs:816) and wait (agent/crates/layerx-mcp/src/server.rs:818) onto the agentd operations of group 3."
ac_2 = "The McpExternalSignatureV1 schema in write.kvx carries a 65-byte secp256k1 signature, and an external signature of any other length is refused before submit."
ac_3 = "OwnerBoundary (agent/crates/layerx-mcp/src/binding.rs:376) execute (agent/crates/layerx-mcp/src/binding.rs:394) and reconcile (agent/crates/layerx-mcp/src/binding.rs:436) keep scope enforcement: a tool outside the bound scope is refused before agentd is called."

[req.6047]
title = "MCP wallet.send and token.transfer on layerxledger send and plain value transfer"
ac_1 = "The native alias ordinal 5 for wallet.send and token.transfer (agent/crates/layerx-mcp/src/catalogue.rs:1020) builds layerxledger send(bytes sendEnvelope) at 0x101A for a kernel asset and a plain value transfer for native PAX."
ac_2 = "The receiver side of a kernel send is preserved: an envelope whose recipient account does not exist is refused with the ledger code instead of creating the account silently."
ac_3 = "The receipt-positive conformance vectors are regenerated from the chain send."

[req.6048]
title = "MCP token.create and token.mint on layerxledger register and mint"
ac_1 = "Ordinal 1 (agent/crates/layerx-mcp/src/catalogue.rs:1021) builds layerxledger register(bytes32,bytes32,string,string,uint8,uint128,uint8,bytes) and ordinal 10 (agent/crates/layerx-mcp/src/catalogue.rs:1022) builds mint(bytes32,bytes32,uint128)."
ac_2 = "The asset id keeps issuer = DID, not the EVM address, so the same salt yields the same id as the kernel derivation."
ac_3 = "mint is refused for a caller other than the asset issuer."

[req.6049]
title = "MCP grant.issue and grant.draw on layerxledger issueGrant and draw"
ac_1 = "Ordinal 7 (agent/crates/layerx-mcp/src/catalogue.rs:1023) builds issueGrant(bytes payerGrant) with the 395-byte payer grant wire and ordinal 6 (agent/crates/layerx-mcp/src/catalogue.rs:1024) builds draw(bytes32,bytes32,uint128,bytes32,uint64,bytes32,bytes32)."
ac_2 = "The draw receiverSequence argument is read from layerxledger nextSequence at pending; the identity sequence is replaced by the EVM nonce."
ac_3 = "A draw above the remaining grant is refused with the ledger grant code."

[req.6050]
title = "MCP read tools over the re-backed agentd reads"
ac_1 = "ProgramReads (agent/crates/layerx-mcp/src/boundary.rs:276) execute (agent/crates/layerx-mcp/src/boundary.rs:333) keeps balance.get and wallet.balance (agent/crates/layerx-mcp/src/server.rs:803), wallet.accounts (agent/crates/layerx-mcp/src/server.rs:804), history (agent/crates/layerx-mcp/src/server.rs:805), receipt (agent/crates/layerx-mcp/src/server.rs:806), checkpoint (agent/crates/layerx-mcp/src/server.rs:807), proof (agent/crates/layerx-mcp/src/server.rs:808) and availability (agent/crates/layerx-mcp/src/server.rs:809) over loopback agentd."
ac_2 = "Read tools are allowed in a read-only session and never reach the signing path."
ac_3 = "The history tool carries the block-position cursor of agent-api major 2."

[req.6051]
title = "MCP faucet.request routed to the router faucet"
ac_1 = "FAUCET_REQUEST (agent/crates/layerx-mcp/src/server.rs:64-69) maps to the router px_requestFunds route instead of the agentd FaucetClaim operation (agent/crates/layerx-mcp/src/server.rs:817)."
ac_2 = "A router refusal surfaces as the tool error with the router code."
ac_3 = "The tool remains listed in the catalogue with an unchanged name."

[req.6052]
title = "MCP web.search, fetch and content paid in 402LXP on the chain path"
ac_1 = "web_tool (agent/crates/layerx-mcp/src/tools/web.rs:575) pays each request by a layerxledger payExact (exact price) or a grant draw (metered) and verifies the sequencer receipt before the sidecar answers; the web tool names at agent/crates/layerx-mcp/src/tools/web.rs:180-182 are unchanged."
ac_2 = "WebPayer (agent/crates/layerx-mcp/src/tools/web.rs:395) signs with the agent secp256k1 key through agentd, never with the kernel ed25519 envelope."
ac_3 = "A sidecar answer payment_pending (503) is retried with the same txHash, never with a second payment."

[req.6053]
title = "MCP approval and subscription tools"
ac_1 = "The approval tools (agent/crates/layerx-mcp/src/server.rs:798-801) map to agentd ApprovalList, ApprovalGet, ApprovalApprove and ApprovalReject unchanged."
ac_2 = "The subscription tools (agent/crates/layerx-mcp/src/server.rs:791-797) map to the agentd subscriptions now backed by eth_subscribe."
ac_3 = "approval.reject through MCP leaves the nonce unused."

[req.6054]
title = "agentd-host web payer signs EIP-1559 through the embedded-wallet attestor set"
ac_1 = "ProductionWebPayer (agent/crates/layerx-agentd-host/src/payer.rs:45) grant (agent/crates/layerx-agentd-host/src/payer.rs:357) and pay (agent/crates/layerx-agentd-host/src/payer.rs:393) build layerxledger issueGrant and payExact transactions for the payer bound address and have them signed by the embedded-wallet attestor set (decision.26) through AttestorSigner (agent/crates/layerx-agentd-host/src/payer.rs:48) on the threshold ECDSA path (human/wallet/attestor/internal/tss/ecdsa/ecdsa.go:26)."
ac_2 = "The receipt check (agent/crates/layerx-agentd-host/src/payer.rs:273) verifies the sequencer receipt with ed25519 against the ReceiptKeys entry (decision.15) in place of the single pinned sequencer_public_key (agent/crates/layerx-agentd-host/src/payer.rs:53) and AuthorizedBatch (agent/crates/layerx-agentd-host/src/payer.rs:17)."
ac_3 = "The attestor policy kind for the grant (human/wallet/attestor/internal/policy/kinds.go:16) covers the issueGrant transaction, and the submit (agent/crates/layerx-agentd-host/src/payer.rs:554) and track (agent/crates/layerx-agentd-host/src/payer.rs:579) calls use the agentd operations of group 3."

[req.6055]
title = "Gas for an agent with no balance through 7702 executeSponsored and DID-keyed station budgets"
ac_1 = "An agent with no PAX signs SponsoredBatch(nonce, callsHash, quoteDigest) for executeSponsored (contracts/src/BatchCallAndSponsor.sol:48) with the paymaster nonce (contracts/src/BatchCallAndSponsor.sol:20) and a 7702 authorization, and the gas station relays it (decision.14)."
ac_2 = "The station keeps a per-DID daily budget: requests beyond the cap for the DID bound to the sender are refused at quote time."
ac_3 = "The sponsored path uses one paymaster nonce stream from nonce() at contracts/src/BatchCallAndSponsor.sol:20 (clients B11), discovered by discoverSponsoredNonce (agent/sdk/typescript/src/gas-station.ts:625), separate from the EVM nonce."

[req.6056]
title = "Sponsored submit returns the sequencer receipt"
ac_1 = "submitSponsoredGasBatch (agent/sdk/typescript/src/gas-station.ts:542) and the station /submit route (interop/crates/layerx-gas-station/src/service.rs:272) return the pax_sequencerReceipt of the relayed transaction, not only its transactionHash."
ac_2 = "Parity checks read the inner call sender from the logs, because the transaction sender is the relayer."
ac_3 = "A station that receives a JSON-RPC refusal returns it unchanged and does not retry with a new nonce."

[req.6057]
title = "Fee denomination preference through feetoken 0x1018"
ac_1 = "readNativeFeePreference (agent/sdk/typescript/src/gas-station.ts:685) reads feetoken getFeeDenom at 0x1018 unchanged and simulates setFeeDenom by eth_call."
ac_2 = "The fee projection of agentd and the station quote both name the denomination of the payer."
ac_3 = "A sponsored transaction charges the sponsor denomination, not the agent preference."

[req.6058]
title = "agent-api major 2 write contract"
ac_1 = "v1.kvx moves from major = 1 (agent/schema/agent-api/v1.kvx:3) to major 2 (decision.17) because write fields are removed and changed, which the compatibility rule (agent/schema/agent-api/v1.kvx:7) forbids within a major."
ac_2 = "operation.sign (agent/schema/agent-api/write.kvx:19) signature_encoding (agent/schema/agent-api/write.kvx:24) becomes 130 lowercase hex characters (65 bytes), and type.McpExternalSignatureV1 (agent/schema/agent-api/write.kvx:70) carries the 65-byte form."
ac_3 = "The submission state variants (agent/schema/agent-api/write.kvx:42) drop Superseded (the outbox has it but the schema never listed it) and Acknowledged, and gain Committed; operation.submit (agent/schema/agent-api/write.kvx:30), track (agent/schema/agent-api/write.kvx:35) and wait (agent/schema/agent-api/write.kvx:50) report the rung; Unknown keeps first_class_terminal_pending (agent/schema/agent-api/write.kvx:43)."

[req.6059]
title = "agent-api major 2 read contract"
ac_1 = "read.history cursor_text (agent/schema/agent-api/read.kvx:33) and response_cursor (agent/schema/agent-api/read.kvx:37) change from the 112-hex kernel cursor to the (blockHeight, txIndex, logIndex) triple."
ac_2 = "read.proof_bundle (agent/schema/agent-api/read.kvx:47) returns the portable v2 field set and requested_verification_level (agent/schema/agent-api/read.kvx:55) takes a rung."
ac_3 = "read.balance (agent/schema/agent-api/read.kvx:18), read.account (agent/schema/agent-api/read.kvx:22), read.module_state (agent/schema/agent-api/read.kvx:26), read.batch (agent/schema/agent-api/read.kvx:39), read.checkpoint (agent/schema/agent-api/read.kvx:43), availability.fetch (agent/schema/agent-api/read.kvx:80), export.offline (agent/schema/agent-api/read.kvx:86) and project (agent/schema/agent-api/read.kvx:110) report height instead of kernel sequence, and project carries the fee denom."

[req.6060]
title = "Level becomes the three rungs"
ac_1 = "type.Level and the Level enum (agent/crates/layerx-agent-api/src/error.rs:129-136) are replaced by Rung {Submitted, Receipted, Committed}; SettlementAnchored, StateProven and the CheckpointFinalised and BatchIncluded split are removed."
ac_2 = "verification_status (agent/schema/agent-api/v1.kvx:129) reports achieved or unverified with a requested and achieved rung."
ac_3 = "Every SDK maps the rung names identically."

[req.6061]
title = "Golden files and the six generated SDKs follow major 2"
ac_1 = "The version golden files (agent/schema/agent-api/golden/version-request.hex) carry major 2 and the sdk-gen golden test (agent/tools/sdk-gen/tests/golden.rs) regenerates from the major 2 schema."
ac_2 = "The platform generators (platform/sdk/generators/generate_jvm.py and generate_portable.py) regenerate, and the drift gate (platform/sdk/generators/tests/drift.rs) passes."
ac_3 = "Every SDK agent operation envelope test (TS, Python, Go, Rust) decodes the major 2 envelope."

[req.6062]
title = "Rust SDK RPC client moves from lx_* to eth_*, pax_ and px_ methods"
ac_1 = "send_activity (agent/crates/layerx-sdk/src/rpc.rs:926) becomes send_raw_transaction calling eth_sendRawTransaction then pax_sequencerReceipt, and get_identity_sequence (agent/crates/layerx-sdk/src/rpc.rs:789) becomes eth_getTransactionCount(address, pending) (clients L1, L2)."
ac_2 = "The read methods (agent/crates/layerx-sdk/src/rpc.rs:743-747) map per the switch-off table: lx_getProof (agent/crates/layerx-sdk/src/rpc.rs:920) to eth_getProof, lx_getNodeInfo (agent/crates/layerx-sdk/src/rpc.rs:851) to px_getNetwork and eth_chainId, lx_register (agent/crates/layerx-sdk/src/rpc.rs:765) to the identity routes plus sponsored bind, lx_requestFunds (agent/crates/layerx-sdk/src/rpc.rs:783) to px_requestFunds."
ac_3 = "The SDK subscription (agent/crates/layerx-sdk/src/rpc_subscription.rs:189) sends eth_subscribe in place of lx_subscribe."

[req.6063]
