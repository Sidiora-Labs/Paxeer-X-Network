req = "10029.1"
scenario = "Given budget b with delegate actor e, when e spends 10 units to recipient r, then the client sends layerxpay budgetSpend(b, r, 10) from e, and a budgetDelegateSpend or budgetPull executes once the kernel activity type reaches its execute function."
contract = "contracts/clients.md#a-operations"
test = "tools/paxeer-x/tests/lx_callers_test.py"
qualification = "UNRUN"

[acceptance.10.29.2]
feature = "10"
req = "10029.2"
scenario = "Given budgets held by DID d, when the client lists them and reads budget b, then it reads getBudget(b) and budgetRemaining(b) on 0x101B by eth_call at pending and lists the holder's budgets from the indexer over the Budget events."
contract = "contracts/clients.md#a-operations"
test = "planned"
qualification = "UNRUN"

[acceptance.10.29.2-2]
feature = "10"
req = "10029.2"
scenario = "Given a daemon limit of 100 units per hour, when an agent asks agentd to sign a write of 150 units, then agentd holds or refuses it before signing and makes no chain call."
contract = "contracts/clients.md#a-operations"
test = "planned"
qualification = "UNRUN"

