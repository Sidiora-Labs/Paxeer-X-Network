[contract_context.10.address_table]
interface = "Every precompile address of the merged chain is one entry of the map built by GetCustomPrecompiles (precompiles/setup.go:63, map at precompiles/setup.go:67) and registered through addPrecompileToVM (precompiles/setup.go:271-284)."
new_addresses = "layerxledger 0x101A, layerxpay 0x101B, layerxauth 0x101C and layerxprograms 0x101D are new entries served from the merge plan height; the agent functions 0x0901-0x0908 are served at the addresses the wallet gateway already routes to (human/wallet/gateway/src/precompiles.ts:18-25)."
retired_addresses = "0x1012, 0x1013 and 0x1014 stay registered (precompiles/setup.go:81-83) and answer LXP_MODULE_DISABLED for retired methods; 0x1014 reads stay until the anchor store is deleted."
route_map = "The gateway route keys staking, bech32 and p256 point at registered addresses 0x1005 (precompiles/staking/staking.go:49), 0x1004 (precompiles/addr/addr.go:57) and 0x1011 (precompiles/p256/p256.go:24)."
selectors = "Every changed and new method selector equals the first four bytes of keccak256 of its canonical signature and is resolved by MethodById (precompiles/common/precompiles.go:131)."

[contract_context.10.errors]
wire_form = "A refusal reverts as ABI Error(string), selector 0x08c379a0, text \"LXP_<code>: <message>\" optionally followed by \"; <detail>\" (RevertReason precompiles/common/precompiles.go:59-66)."
opt_in = "The dynamic-gas base returns the reason only when the precompile opts in and the merge plan is active; today it returns ErrExecutionReverted without the reason (precompiles/common/precompiles.go:182-183)."
kernel_codes = "Kernel codes keep the names and values of include/layerx/lxp_result.h:29-157 with LXP_ERR_ shortened to LXP_; fatal values at or below -1000 never surface as a revert (src/protocol/lxp_result.c:55-58)."
retriability = "Clients classify each code as retriable or terminal from the Retryable column; the Rust mirror carries the class per value (agent/crates/layerx-types/src/result.rs:79) and unknown values are terminal (agent/crates/layerx-types/src/result.rs:253-260)."

[contract_context.10.activation]
plan = "One named merge plan gates every change of this feature by height; its name is set at activation rehearsal and it is recognised through knownUpgradePlans (node/upgrades.go:416-418)."
gate = "The evm keeper serves an address named by an activation entry only once IsUpgradeActiveAtHeight reports the plan done (modules/evm/keeper/keeper.go:251; sdk/x/upgrade/keeper/keeper.go:296-299)."
stores = "The merge handler mounts the new construct stores through the store loader (node/app.go:1298-1325, layerxStoreUpgrades node/app.go:1384-1395)."
bring_up = "The activation is a bring-up at the activation height; no account-state migration is required (node/upgrades.go:88)."

[contract_context.10.operations]
signing = "Every write is an EIP-1559 transaction signed secp256k1 with a 65-byte signature; the actor DID is getLayerXDid of the sender (agent/crates/layerx-crypto/src/evm_transaction.rs:9; precompiles/addr/addr.go:134)."
rungs = "Clients report only submitted, receipted and committed, replacing instant, sealed and final (human/wallet/sdk/src/ladder.ts:4)."
major = "agent-api major 2 replaces major 1 (agent/schema/agent-api/v1.kvx:3)."

[contract_context.10.receipts]
checks = "A rung is held only after checks R1-R8 pass against the pinned receipt key (agent/crates/layerx-proof/src/receipt.rs:631)."
portable = "The portable receipt format becomes layerx-receipt-proof-v2 (interop/crates/layerx-portable/src/receipt.rs:11)."

[contract_context.10.switch_off]
gateway = "Every lx_* name answers JSON-RPC -32601 at activation with no forwarding to the kernel (platform/hosted/gateway/src/rpc.rs:338-355, platform/hosted/gateway/src/rpc.rs:362)."
websocket = "lx_subscribe and lx_unsubscribe answer -32601 on the websocket (platform/hosted/gateway/src/ws.rs:286)."
cli = "The CLI allowlist admits eth_* and the major-2 names (platform/cli/src/rpc.rs:84-178)."

[contract_context.10.conformance]
vectors = "Receipt vectors V1-V9 run in every SDK (agent/crates/layerx-sdk/tests/receipt_fixture.rs:129, agent/sdk/typescript/test/receipt-fixture.test.ts:17, tests/agent/sdk/python/test_receipt_fixture.py:61)."

[task.0.1]
title = "Precompile address table: 0x101A-0x101D and 0x0901-0x0908 entries in GetCustomPrecompiles, served from the merge plan height"
status = "pending"
mode = "BUILD"
wave = 2
requires = ["10.0.1", "10.0.2"]
reqs = ["6.1", "8.1", "8.3", "10001.1", "10001.2", "10001.3", "10001.4", "10002.1", "10002.2", "10002.3", "10003.1", "10003.2", "10003.3", "10004.1", "10004.2", "10004.3", "10004.4", "10005.1", "10005.2", "10005.3", "10005.4", "10006.1", "10006.2", "10006.3", "10007.1", "10007.2", "10007.3", "10008.1", "10008.2", "10008.3", "10009.1", "10009.2", "10009.3", "10010.1", "10010.2", "10010.3", "10011.1", "10011.2", "10011.3", "10012.1", "10012.2", "10012.3", "10015.1", "10015.2", "10015.3", "10016.1", "10016.2", "10016.3", "10016.4", "10016.5"]
capabilities = ["10.1.1", "10.1.2", "10.1.3", "10.1.4", "10.1.5", "10.1.6", "10.1.7", "10.1.8", "10.1.9", "10.1.10", "10.1.11", "10.1.12", "10.2.3", "10.3.1"]
do_1 = "Add the merge address table to GetCustomPrecompiles (precompiles/setup.go:63): beside the existing map built at precompiles/setup.go:67 (bank precompiles/setup.go:68 through launchpad precompiles/setup.go:86, feetoken precompiles/setup.go:88-92, xweb precompiles/setup.go:93-95) declare MergeAddressTable, the eight agent-function addresses 0x0000000000000000000000000000000000000901-0x0000000000000000000000000000000000000908 and the four construct addresses 0x000000000000000000000000000000000000101A-0x000000000000000000000000000000000000101D with their GetName values (layerxledger, layerxpay, layerxauth, layerxprograms, orob, clearing, oracle aggregator, pofq, scheduler, streams, tee attestor, eip712)."
do_2 = "Register each merge entry through addPrecompileToVM (precompiles/setup.go:271-284) under the merge plan name (the constant added by task 10.0.1) through the keeper activation entry list of task 10.0.2, not a semver tag compare: add a package-level RegisterMergeConstructor(address, constructor) hook that the construct packages (precompiles/layerxledger, precompiles/layerxpay, precompiles/layerxauth, precompiles/layerxprograms, precompiles/layerxagent/*) call when their features land; an address in MergeAddressTable with no registered constructor is not served and GetCustomPrecompiles never installs a placeholder executor."
do_3 = "Keep every existing address registered and unchanged: 0x1012 layerxVerify, 0x1013 layerxCustody and 0x1014 layerxAnchor stay in the map (precompiles/setup.go:81-83) so retired methods reach an executor that answers LXP_MODULE_DISABLED instead of an empty success; PrecompileLastUpgrade (precompiles/setup.go:286-288) reports the merge plan once the entries are present."
do_4 = "Extend precompiles/setup_test.go beside TestFeeTokenRegistration (precompiles/setup_test.go:17) and TestXWebRegistration (precompiles/setup_test.go:92) with TestMergeAddressTable: below the plan height none of the twelve addresses is served; at the plan height every address with a registered constructor is served with its GetName and every address without one is absent; the address and name pairs equal contracts/address-table.md section (a)."
do_5 = "Assert that the route constants 0x0901-0x0908 of the wallet gateway (human/wallet/gateway/src/precompiles.ts:18-25) equal the registered addresses so a gateway call reaches an executor (head requirement 6.1)."
do_6 = "Gate the change on the merge plan through latestCustomPrecompilesAtHeight (modules/evm/keeper/keeper.go:251) and the (plan name, address set) activation entry that task 10.0.2 introduces, so the precompile set and revert bytes below H stay byte-identical to today."
do_7 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["GetCustomPrecompiles", "MergeAddressTable", "RegisterMergeConstructor", "PrecompileLastUpgrade", "addPrecompileToVM"]
touches = ["precompiles/setup.go", "precompiles/setup_test.go"]
build_cmd = "go build ./precompiles/..."
verify_cmd = "go test -count=1 ./precompiles/ -run 'TestFeeTokenRegistration|TestXWebRegistration|TestMergeAddressTable'"
gate_kind = "existing"
planned_paths = []
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result; record exact revision, command, exit code and private evidence location. Do not mark complete without the declared evidence."
path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to their current equivalents before the gate can run; historical references never authorize a duplicate implementation tree. Complete scoped path reconciliation without dropping acceptance criteria."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

