do_2 = "AssetAccountID(didKey, assetId) builds agent:<did>:asset:<hex64> as src/protocol/lxp_module_ctx.c:654-664 does and derives it with codec.DeriveAccountID (layerxproof/codec/state.go:360)."
do_3 = "IssuanceAccountID(assetId) builds the name of lx_asset_issuance_name (src/ledger/lx_account_id.c:228-256) and decodes the id from hex, the MODULE_VALUE path of src/ledger/lx_account_id.c:208-215 and layerxproof/codec/state.go:366-371."
do_4 = "BankAddress(accountId) returns address.Module(\"layerx\", accountId) (sdk/types/address/hash.go:63-66), decision D2 A; HolderDid(account) calls lx_account_owner_did (include/layerx/lxp_ledger.h:288, src/ledger/lx_account_read.c:6-37) through the shim."
do_5 = "Create modules/lxphost/accountmap_test.go with TestAccountMapMainVectors, TestAccountMapAssetVectors, TestAccountMapIssuance, TestAccountMapBankAddress and TestAccountMapHolderDid comparing each Go id with lx_account_id_from_string (src/ledger/lx_account_id.c:196-226)."
