[task.13.1.1]
title = "Sequencer resolutions: receipt module id, batch injection, nonce queue, read context, standby replay and activation height"
status = "done"
mode = "BUILD"
wave = 1
requires = []
reqs = ["13001.1", "13001.2", "13001.3", "13001.4", "13002.1", "13002.2", "13002.3", "13002.4", "13004.1", "13004.2", "13004.3", "13023.1", "13023.2", "13023.3"]
do_1 = "Set the EVM receipt module id in node/sequencer as the next free id after LXP_MODULE_RESERVED_COUNT (include/layerx/lxp_module.h:26), exported as EVMReceiptModuleID, so no kernel module id is reused."
do_2 = "Inject MsgSequenceBatch as the first transaction where CreateProposalBlock builds the proposal (consensus/internal/state/execution.go:101), taking the sealed receipt order from the activation height instead of ReapTxs (consensus/internal/state/execution.go:126); below the height the reap path stays unchanged."
do_3 = "Verify the batch in ProcessProposalHandler (node/app.go:1457): a block whose batch txRoot differs from the sealed sequence is refused."
do_4 = "Keep the deliver-mode nonce rule (modules/evm/ante/sig.go:70-80) for admission, and hold future nonces in NonceQueue so receipts are issued strictly in nonce order per sender."
do_5 = "Point the ante LatestCtxGetter (node/app.go:1122-1124) at ReadContext, the open speculative state of the sequencer, so estimates include receipted but unproposed debits."
do_6 = "Read ActivationHeight from node config and confirm BeginBlock(N+1) receives the votes of N-1 (node/legacyabci/begin_block.go:61); after a failover the standby proposes the receipted sequence in receipt order, following Leader() (consensus/internal/consensus/types/round_state.go:422)."
do_7 = "Add node/sequencer/resolution_test.go with TestResolutionReceiptModuleId, TestResolutionBatchInjection, TestResolutionNonceQueue, TestResolutionReadContext, TestResolutionStandbyReplay, TestResolutionActivationHeight and TestResolutionProposalSource; time is the block-open timestamp (include/layerx/lxp_module.h:151)."
do_8 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["EVMReceiptModuleID", "InjectSequenceBatch", "NonceQueue", "ReadContext", "ActivationHeight"]
touches = ["node/sequencer/resolution_test.go", "node/app.go", "consensus/internal/state/execution.go"]
build_cmd = "go build ./node/sequencer/"
verify_cmd = "go test -count=1 ./node/sequencer/ -run TestResolution"
gate_kind = "planned"
planned_paths = ["node/sequencer/resolution_test.go"]
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
