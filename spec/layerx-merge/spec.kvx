[acceptance.8.1.1]
feature = "8"
req = "8001.1"
scenario = "Given a provisioned embedded wallet holding 10 PAX on chain 125 (0x7d), when it posts /v1/wallet/send for 1 PAX to 0x00000000000000000000000000000000000000aa, then the answer carries tx_hash, address, chain_id 125 and a receipt whose status is 1 and whose activity_id equals keccak256 of the raw transaction."
contract = "contracts/services.md#S27 Embedded wallet gateway"
test = "human/wallet/gateway/test/e2e/gateway.e2e.test.ts::signs a transaction through the quorum and the signature recovers the wallet"
qualification = "UNRUN"

[acceptance.8.1.2]
feature = "8"
req = "8001.2"
scenario = "Given two RPC_URLS entries where the first answers with error -32000 for writes, when the gateway sends a signed transfer, then the write reaches the sequencer once and returns a receipt whose seq is one higher than the previous wallet receipt."
contract = "contracts/services.md#S27 Embedded wallet gateway"
test = "human/wallet/gateway/test/rpc-pool.test.ts::fails over from a failing endpoint and takes it back once it recovers"
qualification = "UNRUN"

[acceptance.8.1.3]
feature = "8"
req = "8001.3"
scenario = "Given an ERC-20 transfer of 5 units from a wallet holding 1 unit, when /v1/wallet/send returns, then the body reports rung receipted, status 0 and the revert reason, and the wallet UI shows a refusal instead of a completed transfer."
contract = "contracts/services.md#S27 Embedded wallet gateway"
test = "planned"
qualification = "UNRUN"

[acceptance.8.2.1]
feature = "8"
req = "8002.1"
scenario = "Given a PECOR quote for 100 USDL into PAX with 0.5 percent slippage, when the user confirms the swap, then one router transaction is submitted and the swap result is shown once the receipt is receipted."
contract = "contracts/services.md#S32 Wallet app backends"
test = "planned"
qualification = "UNRUN"

[acceptance.8.2.2]
feature = "8"
req = "8002.2"
