[capability.9.1.1]
title = "Accept, Seal and Open with deliver-mode execution on per-transaction branches"
reqs = ["9001.1", "9001.2", "9001.3", "9001.4", "9001.5", "9017.1", "9017.2", "9017.3", "9035.1", "9035.2", "9035.3", "9035.4", "9035.5"]
touches = ["node/sequencer/executor.go", "node/sequencer/accept.go", "node/sequencer/layers.go"]
tests = ["node/sequencer/executor_test.go"]
verification_contract = "go test -count=1 ./node/sequencer/ -run TestExecutor"
do_1 = "Open(height, time) builds L_open on L_N, runs BeginBlock once (node/legacyabci/begin_block.go:43) and fixes the header and the open time that replaces tmtime.Now() (consensus/internal/state/state.go:279)."
do_2 = "Accept branches L_open per transaction with the CacheTxContext pattern (sdk/baseapp/baseapp.go:822) and runs app.DeliverTx in deliver mode (node/abci.go:169); success writes the branch, failure drops it and takes no seq."
do_3 = "The Accept context comes from L_open and never from checkState (sdk/baseapp/baseapp.go:550, :778); LatestCtxGetter (node/app.go:1122-1124) returns L_open in sequencer mode."
do_4 = "Panics during DeliverTx are recovered in Accept with the same shape as the deliver path's recovery (node/abci.go:192-194), leaving seq and L_open unchanged."
do_5 = "Sequential mode is the default; the executor interface is the one MicroBatch implements later (node/app.go:1888 OCCV2 is the scheduler MicroBatch reuses)."
symbols = ["Executor", "Accept", "Seal", "Open", "OpenLayer"]

[capability.9.1.2]
title = "Per-sender future-nonce queue with same-nonce refusal"
reqs = ["9012.1", "9012.2", "9012.3", "9012.4", "9012.5", "9030.1", "9030.2", "9030.3", "9030.4"]
touches = ["node/sequencer/nonce_queue.go"]
tests = ["node/sequencer/nonce_queue_test.go"]
verification_contract = "go test -count=1 ./node/sequencer/ -run TestNonceQueue"
do_1 = "The next executable nonce per sender is read from L_open through the keeper path the ante uses (node/abci.go:144 EvmNonce; modules/evm/ante/sig.go:70-80)."
do_2 = "A transaction with nonce above next is held per sender, bounded per sender and in total, the role the mempool pending map plays today (consensus/internal/mempool/tx.go:259 NextNonce, :504 Insert)."
do_3 = "When a gap fills, held transactions drain to Accept in nonce order in the same receipt slot, so arrival order across senders is kept (consensus/internal/mempool/tx.go:461 is the ordering it replaces)."
do_4 = "A nonce below next, or a (sender, nonce) already receipted or held, is refused with an error; it is never superseded (modules/evm/ante/sig.go:75)."
do_5 = "Held entries expire after the queue lifetime set at activation rehearsal, in the manner of the mempool's expiry purge (consensus/internal/mempool/mempool.go:292)."
symbols = ["NonceQueue", "Hold", "Drain", "ErrNonceTooLow", "ErrSameNonce"]

