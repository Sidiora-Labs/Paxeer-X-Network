requires = ["3.7.1", "3.7.2", "3.7.3", "3.7.4", "3.7.5", "3.5.2", "3.6.2", "3.6.3", "3.6.4", "3.6.5", "3.6.6", "3.6.8", "3.6.9", "3.6.10", "3.6.13", "3.6.14", "3.6.16", "3.3.9", "3.4.6", "3.4.8"]
reqs = ["8.1", "12.4", "3039.2", "3039.4"]
capabilities = ["3.12.3"]
do_1 = "Add integration_test/exchange_v2/exchange_v2_test.yaml for integration_test/scripts/runner.py:1 with a bring_up case: past the activation height markets are created with no migration step (modules/layerxexchange/keeper/genesis.go:13)."
do_2 = "The exchange_v2 case creates a perps market, pushes an oracle price, places two crossing orders, runs fundingTick, liquidates, creates a spot market and trades it, and buys on the launchpad, all from EVM transactions."
do_3 = "Each step asserts its receipt succeeded and the final balances equal the scripted values; the launchpad step reads getProtocolFees (precompiles/launchpad/launchpad.go:322)."
do_4 = "Activation is a bring-up at the activation height; no account-state migration is required."
do_5 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = ["exchange_v2", "bring_up"]
touches = ["integration_test/exchange_v2/exchange_v2_test.yaml"]
build_cmd = "make build"
verify_cmd = "python3 integration_test/scripts/runner.py integration_test/exchange_v2/exchange_v2_test.yaml"
gate_kind = "planned"
planned_paths = ["integration_test/exchange_v2/exchange_v2_test.yaml"]
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result; record exact revision, command, exit code and private evidence location. Do not mark complete without the declared evidence."
path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to their current equivalents before the gate can run; historical references never authorize a duplicate implementation tree. Complete scoped path reconciliation without dropping acceptance criteria."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

[feature.4]
name = "Programs runtime and native AI markets"
scope = "layerxprograms 0x101D and modules/layerxprograms: the kernel programs C module and the Rust program runtime hosted through the cgo shim (decision.1), every program method, view, event, fee schedule, wind-down, sandbox, occupancy, blob and retirement-profile path, the reference guests deployed at activation (decision.13), the AI market program with its evaluator calls on the sequencer path, paxai-worker, the arbiter and ai-artifacts reading program state and finality from the chain, and the retirement of the kernel program adapters. Entry: the programs module registration at src/modules/programs/registration.c:348."
requirements = ["4001", "4002", "4003", "4004", "4005", "4006", "4007", "4008", "4009", "4010", "4011", "4012", "4013", "4014", "4015", "4016", "4017", "4018", "4019", "4020", "4021", "4022", "4023", "4024", "4025", "4026", "4027", "4028", "4029", "4030", "4031", "4032", "4033", "4034", "4035", "4036", "4037", "4038", "4039", "4040", "4041", "4042", "4043", "4044", "4045", "4046", "4047", "4048", "4049", "4050", "4051", "4052", "4053"]
completion_task = "7.7"

[req.4001]
title = "Program deploy through layerxprograms 0x101D"
ac_1 = "deploy (0xbde3ff66) runs the existing lifecycle validation (ABI transition, wasm and interface checks) at src/modules/programs/deploy.c:453 and the deploy execution at src/modules/programs/deploy.c:803 behind the cgo shim and returns (bytes32 programId, bytes32 codeHash)."
ac_2 = "A caller-chosen program id that already exists is refused with the kernel result name as Error(string), as the freshness check at src/modules/programs/deploy.c:497 requires; the revert uses the RevertReason form of precompiles/common/precompiles.go:59."
ac_3 = "A deploy from a sender with no DID binding is refused before the shim is entered; the principal is the DID id bound at modules/evm/keeper/layerx_binding.go:17."
ac_4 = "The deploy emits ProgramDeployed(programId, codeHash) exactly once, mirroring the kernel DEPLOYED event emitted at src/modules/programs/deploy.c:532."

[req.4002]
title = "Program upgrade under the recorded upgrade authority"
ac_1 = "upgrade (0xa860929f) reaches the upgrade path at src/modules/programs/deploy.c:587 and applies the upgrade policy check at src/modules/programs/deploy.c:536 unchanged."
ac_2 = "A wrong old hash is refused with LXP_CONTEXT_MISMATCH and a sender that is not the recorded authority is refused with LXP_AUTH_SCOPE, as in the kernel lifecycle tests (tests/programs/test_lifecycle.c:1984)."
ac_3 = "The ABI transition between the recorded and the new guest ABI is validated by src/modules/programs/deploy.c:191 and the runtime policy at programs/crates/layerx-programs-runtime/src/abi_policy.rs:77-85."

[req.4003]
title = "Program call and guest execution"
ac_1 = "call (0x54bd2b48) returns the guest outcome and response from src/modules/programs/call.c:2778 after the checks of src/modules/programs/call.c:2615: non-zero principal, ABI match, program active and artifact open."
ac_2 = "The seven-field caller budget decoded at src/modules/programs/call.c:117 bounds fuel, storage and transfer use exactly as in the kernel; exhaustion returns the typed refusal, not a Go panic."
ac_3 = "Transfer legs requested by the guest are authorized against the principal through src/modules/programs/call.c:2237 and settle as one conserved bank multi-send between derived accounts."
ac_4 = "The frozen ABI vectors programs/tests/vectors/abi-v1..v5.hex replay through the shim with the hashes pinned in programs/abi-frozen.sha256:1 unchanged."

[req.4004]
title = "Guest host functions: storage, scan, events and calls"
ac_1 = "storage_read, storage_write, storage_delete and their scoped forms registered at programs/crates/layerx-programs-runtime/src/host/mod.rs:1149-1217 map to the layerxprograms prefix store per program namespace through programs/crates/layerx-programs-runtime/src/host/storage.rs:20."
ac_2 = "storage_scan pages over the program namespace in key order as programs/crates/layerx-programs-runtime/src/host/scan.rs:22 defines, with the same page bound."
ac_3 = "event_emit becomes a Cosmos event and a ProgramGuestEvent log through programs/crates/layerx-programs-runtime/src/host/events.rs:16, and program_call runs a nested call in the same cached context through programs/crates/layerx-programs-runtime/src/host/calls.rs:21."

[req.4005]
title = "Guest host functions: value, context, crypto, oracle, web and market"
ac_1 = "transfer_402, transfer_program_402 and fund_program_402 at programs/crates/layerx-programs-runtime/src/host/transfer.rs:14 settle as bank transfers between program-derived accounts with conservation checked per call."
ac_2 = "balance_read at programs/crates/layerx-programs-runtime/src/host/balance.rs:18 returns the bank balance of the derived account, and context_read at programs/crates/layerx-programs-runtime/src/host/context.rs:17 returns block height, block time, chain id and the invoking principal."
ac_3 = "hash, signature_verify, signature_recover and bigint_* stay pure host functions (programs/crates/layerx-programs-runtime/src/host/crypto.rs:15, programs/crates/layerx-programs-runtime/src/abi/manifest.rs:58) and give byte-identical results to the runtime signature vectors."
ac_4 = "oracle_read, web_read and market_step_adjudicate keep their ABI v5 signatures at programs/crates/layerx-programs-runtime/src/host/oracle.rs:18, programs/crates/layerx-programs-runtime/src/host/web.rs:17 and programs/crates/layerx-programs-runtime/src/host/market.rs:22; web_read returns the xweb origin-2 result for the request id."

[req.4006]
title = "Metering schedule and program fee on top of gas"
ac_1 = "The program fee is charged in addition to EVM gas (decision.9) from the per-call usage times the schedule prices resolved at src/modules/programs/fees.c:1828."
ac_2 = "The fee schedule is updated only by MsgUpdateFeeSchedule with the gov module account as authority, replacing the permissionless relay at src/modules/programs/fees.c:1181."
ac_3 = "The metering schedule is updated only by MsgUpdateMeteringSchedule under gov authority, with the seven-field schedule validated as in src/modules/programs/metering.c:353."
ac_4 = "A sponsored call is charged the program fee once: the gas station pays gas and the program fee leg is drawn from the declared fee payer only, as fee settlement at src/modules/programs/fee.c:154 does."

[req.4007]
title = "Registry read as a view"
ac_1 = "registryRead keeps its kernel semantics as an event-only read at src/modules/programs/registration.c:155 and is served on chain as the views getProgram and getInterface plus Query/RegistryRead."
ac_2 = "The registry read path writes no state: the generic ordinal-4 path at src/modules/programs/registration.c:205-224 writes no record, and on chain no store key changes."
ac_3 = "A read of an unknown program returns the kernel absent-key result through src/modules/programs/winddown.c:129 and the query server returns an error, never a panic."

[req.4008]
title = "Program transfer with per-leg authority"
ac_1 = "transfer (0x59849fe7) runs src/modules/programs/transfer.c:125, where every leg source must equal the principal, then src/modules/programs/transfer.c:207 builds one conserved transfer set."
ac_2 = "A leg whose source is not the principal is refused through the Rust leg check at programs/crates/layerx-programs-runtime/src/ffi_transfer.rs:169 and no leg settles."
ac_3 = "The kernel 32-byte account id maps one-to-one to a bank address derived with address.Module at sdk/types/address/hash.go:63, so the conservation test programs/tests/conservation/run.sh holds on chain."

[req.4009]
title = "Program value accounts"
ac_1 = "registerAccount (0xfc786007) applies registration_authorized at src/modules/programs/accounts.c:364-391: the principal equals the recorded program principal or, with none recorded, the upgrade authority."
ac_2 = "The derived account is sha(program, seed) as src/modules/programs/accounts.c:496 computes, and getProgramAccount and getProgramAccountById return the same record (src/modules/programs/accounts.c:530, src/modules/programs/accounts.c:559)."
ac_3 = "Registering a mismatched asset or a second account for the same seed is refused with the kernel result name from src/modules/programs/accounts.c:913."

[req.4010]
title = "Program wind-down: exit route, deprecate, tombstone and exit value"
ac_1 = "setExitRoute, deprecate, tombstone, exitValue and exitValueBounded run src/modules/programs/winddown.c:540 with the recorded-principal check at src/modules/programs/winddown.c:150 for every operation."
ac_2 = "The state machine is none to DEPRECATED to TOMBSTONED with no reverse step, as src/modules/programs/winddown.c:911 enforces."
ac_3 = "exitValue moves the derived account balance to the exit route and exitValueBounded refuses when the balance is above the bound (src/modules/programs/winddown.c:592-594); the deprecate deadline counts the module activity sequence, advanced once per kernel activity."

[req.4011]
title = "Sandbox lease execute, fund and activate"
ac_1 = "sandboxExecute, sandboxFund and sandboxActivate run src/modules/programs/sandbox.c:279 and src/modules/programs/sandbox.c:306, keeping lease, escrow and ledger state under the layerxprograms store."
ac_2 = "sandboxExecute wraps the call validation and charges the call gas of the D2 table; sandboxFund wraps the transfer validation of the principal (src/modules/programs/sandbox.c:163)."
ac_3 = "The lease state codec is the existing one read by the sandbox crate tests at programs/crates/layerx-programs-sandbox/tests/lease.rs:14."

[req.4012]
title = "Sandbox destroy and expiry sweep in EndBlock"
ac_1 = "The sandbox destroy activity, which requires the protocol module authority at src/modules/programs/sandbox_expiry.c:231, becomes a bounded EndBlock sweep with no message and no precompile method."
ac_2 = "The sweep runs src/modules/programs/sandbox_expiry.c:244 per lease with a per-block bound, and a backlog above the bound continues in the next block."
ac_3 = "The batch finalize entry src/modules/programs/sandbox_expiry.c:323 is called with the block height as the boundary in place of the kernel batch."

[req.4013]
title = "Storage namespaces, blobs and occupancy"
ac_1 = "Program namespaces import and stage through src/modules/programs/storage.c:51 and src/modules/programs/storage.c:116 onto the prefix stores programs/, artifacts/ and occupancy/."
ac_2 = "Occupancy is bound per call at src/modules/programs/occupancy.c:286 and finalized per block through src/modules/programs/occupancy.c:937; its charge stays inside the program fee."
ac_3 = "Artifact reference counts follow blob_lifecycle: a deploy increments and a tombstone of the last user decrements, as tested in tests/programs/test_blob_lifecycle.c:1344."

[req.4014]
title = "Storage retirement and the retirement profile"
ac_1 = "retireStorage (0x1a5fe5ff) is a controller-signed state deletion: src/modules/programs/blob_lifecycle.c:747 requires the principal to equal the profile controller and src/modules/programs/blob_lifecycle.c:757 verifies archive provenance before deleting blobs and replay entries."
ac_2 = "The retirement profile is staged at the activation bring-up and by governance through src/modules/programs/blob_lifecycle.c:378, replacing the test-only callers of the kernel."
ac_3 = "The provenance witness parsed at src/modules/programs/blob_lifecycle.c:259 carries an ICS23 proof of the layerxprograms subtree at an archived height; a witness that does not verify is refused and nothing is deleted."

[req.4015]
title = "Program events as logs and Cosmos events"
ac_1 = "Every kernel program event kind declared at include/layerx/programs.h:188-199 maps to one 0x101D log with a fixed topic0 and to one Cosmos event, in emission order."
ac_2 = "Guest envelopes and call outcomes are emitted from src/modules/programs/event.c:157 and src/modules/programs/event.c:201 as ProgramGuestEvent and ProgramCallOutcome logs."
ac_3 = "Query/ProgramEvents(program, topic, page) pages a bounded event index by (height, log index); the kernel feed sequence of src/modules/programs/feed.c:43 is not reproduced."

[req.4016]
title = "Deterministic replay of program execution"
ac_1 = "Replay capture at src/modules/programs/call.c:3138 stays inside the native host and validators re-execute blocks as the replay of record."
ac_2 = "The kernel replay golden tests/replay/golden/history.lxl replays through the shim (src/modules/programs/occupancy.c:1242) and the program subtree roots match, compared by state root of the programs prefix and not by kernel batch hash."
ac_3 = "The runtime replay tests (programs/crates/layerx-programs-runtime/tests/replay.rs:7) pass unchanged against the runtime staticlib linked into paxd."

[req.4017]
title = "Cross-program calls and composition"
ac_1 = "program_call and program_call_response run a nested keeper call in the same cached context (programs/crates/layerx-programs-runtime/src/host/calls.rs:92, programs/crates/layerx-programs-runtime/src/host/calls.rs:128) and a refusal unwinds the whole cache."
ac_2 = "The call depth bound is the runtime composition limit (programs/crates/layerx-programs-runtime/src/host/calls.rs:21) and is independent of EVM call depth."
ac_3 = "Spend composition across nested calls keeps the downward-only capability rule of programs/crates/layerx-programs-runtime/src/abi/capability.rs:377."

[req.4018]
title = "Program registry crate and the registry read cache"
ac_1 = "The registry crate keeps its catalogue, naming, LXT20, LXT721, swap and archive logic, and its evidence source changes from kernel batch proofs (programs/crates/layerx-programs-registry/src/protocol_evidence.rs:11-15) to layerxprograms queries with ICS23 proofs at height."
ac_2 = "The registry service becomes a read cache (decision.20): it reads program state through gRPC in place of the in-process adapter at platform/hosted/registry/src/program_state.rs:5."
ac_3 = "The registry crate drops the layerx-proof dependency declared at programs/crates/layerx-programs-registry/Cargo.toml:13."

[req.4019]
title = "Read committed program state from the chain"
ac_1 = "Query/ProgramState and Query/ProgramBalances return committed program cells and derived account balances at a height with an ICS23 proof, replacing programs/crates/layerx-programs-protocol-adapter/src/ffi.rs:1205."
ac_2 = "agentd reads program balances and nodes through the gRPC client in place of agent/crates/layerx-agentd/src/read/program_balances.rs:4."
ac_3 = "The explorer index reads program records through gRPC in place of human/crates/layerx-explorer-index/src/programs.rs:7."

[req.4020]
title = "Interpreter reference guest"
ac_1 = "The interpreter guest (entrypoint at programs/crates/layerx-programs-interpreter/src/lib.rs:521) is deployed unchanged through MsgDeploy at the activation height with its expected code hash (decision.13)."
ac_2 = "The interpreter uses only storage_read, storage_write and transfer_402 of ABI 2, so its behaviour on chain equals the runtime interpreter test (programs/crates/layerx-programs-runtime/tests/interpreter_program.rs:27)."
ac_3 = "A deploy at the activation height whose code hash differs from the expected hash halts the bring-up with the mismatch named, and no partial guest set is left deployed; the hash is the deploy code hash checked at src/modules/programs/deploy.c:453."

[req.4021]
title = "Compute-lease market reference guest"
ac_1 = "The compute-lease market guest with ops 1-17 dispatched at programs/crates/layerx-programs-market/src/lib.rs:841 is deployed unchanged through MsgDeploy at activation with its expected code hash."
ac_2 = "Bisection disputes are judged by the pure host market_step_adjudicate at programs/crates/layerx-programs-runtime/src/host/market.rs:22, and the step conformance vectors give the same verdicts on chain."
ac_3 = "Lease and dispute deadlines are counted in block heights; the provider stake and slash amounts settle as bank transfers between derived accounts through programs/crates/layerx-programs-runtime/src/host/transfer.rs:14."

[req.4022]
title = "Arbiter reads prestate from the chain"
ac_1 = "The arbiter verified-replay library keeps its step and market logic and takes its prestate from a block header plus an ICS23 proof of the layerxprograms subtree in place of kernel batch headers (programs/crates/layerx-programs-arbiter/src/authority.rs:24)."
ac_2 = "A prestate proof for a different height or app hash is refused by the arbiter before any step is replayed (programs/crates/layerx-programs-arbiter/src/authority.rs:24)."
ac_3 = "The arbiter drops the layerx-proof dependency declared at programs/crates/layerx-programs-arbiter/Cargo.toml:14."

[req.4023]
title = "Guest SDKs and the frozen guest ABI"
ac_1 = "The guest ABI imports layerx_v1 to layerx_v5 listed at programs/crates/layerx-programs-runtime/src/abi/manifest.rs:8-31 do not change, so the SDK examples build against the frozen hashes."
ac_2 = "The ABI drift check tests/programs/check-abi-drift.sh:1 passes at the merged revision."
ac_3 = "ABI v5 admission refuses a guest importing a host function outside its declared version, as src/modules/programs/accounts.c:432 does."

[req.4024]
title = "Porting kits keep working against the guest ABI"
ac_1 = "The EVM, Solana and CosmWasm porting kits under programs/porting target the unchanged guest ABI and build in the programs workspace (programs/Cargo.toml:13)."
ac_2 = "Native CosmWasm contracts stay on x/wasm at 0x1002 and are not routed through layerxprograms; the CosmWasm kit (programs/porting/cosmwasm/Cargo.toml:1) remains the path for sources that want program semantics."
ac_3 = "A ported guest deployed through 0x101D produces the same outcome as under the kernel for the porting kit fixture (programs/porting/evm/Cargo.toml:1)."

[req.4025]
title = "Client program operations over EVM transactions"
ac_1 = "The program payload codecs of the SDKs are wrapped as 0x101D calldata in an EVM transaction; the gateway programs ingress at platform/hosted/gateway/src/rpc.rs:546-549 is retired."
ac_2 = "agentd keeps its policy and approval flow and submits program operations as EVM transactions signed by the 0x1004-bound agent key (agent/crates/layerx-agentd/src/ops/program.rs:997)."
ac_3 = "Program reads in clients use 0x101D views or gRPC queries; the LNI program read path (agent/crates/layerx-client/src/lni/program_read.rs:1) is retired."

[req.4026]
title = "Program web request leg (program side of paid search)"
ac_1 = "A guest web request captured at src/modules/programs/call.c:1867 and recorded at src/modules/programs/call.c:1935 becomes a call from layerxprograms into the xweb keeper with origin 2 inside the same call."
ac_2 = "The web fee account derived at src/modules/programs/call.c:591 is replaced by the xweb module account; no layerxprograms account holds web fees."
ac_3 = "web_read on a fulfilled origin-2 request returns the xweb result and getWebRequest returns the request record (src/modules/programs/call.c:1182)."

[req.4027]
title = "AI market and task-policy registry (F01)"
ac_1 = "The AI market program is deployed unchanged on layerxprograms and its market ops CREATE to REVOKE_OPERATOR (programs/crates/layerx-programs-ai-market/src/dispatch.rs:78 to programs/crates/layerx-programs-ai-market/src/dispatch.rs:86) travel as call(bytes) envelopes."
ac_2 = "The task policy is 307 bytes (programs/crates/layerx-programs-ai-market/src/policy.rs:10) and its bounds hold: max_workers 1..32, max_evaluators 1..8, task_timeout_heights 1..64 and minimum_evaluator_count at least 3 (programs/crates/layerx-programs-ai-market/src/policy.rs:102)."
ac_3 = "Only a direct caller may act: the host adapter requires no immediate caller program (programs/crates/layerx-programs-ai-market/src/host_adapter.rs:57), so an EVM contract calling 0x101D is treated as the principal and never as an immediate caller program."

[req.4028]
title = "AI task lifecycle (F01 tasks)"
ac_1 = "ADMIT_TASK to SEAL_TASK_SET (0x010C to 0x0110) are routed to the task apply entry at programs/crates/layerx-programs-ai-market/src/tasks.rs:1092 and windows are counted by execution height."
ac_2 = "A result after task_timeout_heights (programs/crates/layerx-programs-ai-market/src/policy.rs:100) is refused and CANCEL_TASK releases the task with no reward."
ac_3 = "OPEN_EPOCH and ADVANCE_ACTIVATION are routed at programs/crates/layerx-programs-ai-market/src/dispatch.rs:913-930 and the epoch opens only from the scheduled height."

[req.4029]
title = "AI worker identity and enrollment (F02)"
ac_1 = "EnrollWorker to ExpireEnrollment (0x0201 to 0x020A, with 0x0208 reserved) are routed through the identity arm at programs/crates/layerx-programs-ai-market/src/dispatch.rs:958 to programs/crates/layerx-programs-ai-market/src/workers.rs:761."
ac_2 = "The worker discovery seam (platform/hosted/paxai-worker/src/discovery.rs:4-7) is replaced by a chain read of the worker record at a committed height with an ICS23 proof."
ac_3 = "Stale signed metadata blocks admission until the next epoch with the roster refusal (programs/crates/layerx-programs-ai-market/src/tasks.rs:539)."

[req.4030]
title = "Off-chain inference and embedding execution (paxai-worker)"
ac_1 = "paxai-worker keeps admission with a durable signed ack, dispatch after an accepted task, the fenced lease and runner exit codes 0 and 75 (platform/hosted/paxai-worker/src/runner.rs:1-12); only its chain reader changes."
ac_2 = "JobResult is signed by the admitted delegate at platform/hosted/paxai-worker/src/jobs.rs:222-238 and submitted as COMMIT_TASK_RESULT through an EVM transaction to 0x101D."
ac_3 = "The worker reads its task and roster state from the chain at a committed height, and a chain head older than MAX_FINALITY_LAG = 8 (platform/hosted/paxai-worker/src/discovery.rs:48) blocks the admission gate."

[req.4031]
title = "AI evaluator grants, signed assessments and challenge (F03)"
ac_1 = "ScheduleEvaluator, RotateEvaluatorKey and RevokeEvaluator (0x0301 to 0x0303) apply through programs/crates/layerx-programs-ai-market/src/evaluators/authority.rs:867 with schedule at programs/crates/layerx-programs-ai-market/src/evaluators/authority.rs:656."
ac_2 = "ChallengeAssessment 0x0304 is permissionless against an admitted report digest of a frozen evaluator (programs/crates/layerx-programs-ai-market/src/evaluators/admission.rs:1041)."
ac_3 = "Collusion of evaluators remains an explicit trust boundary of the program (programs/crates/layerx-programs-ai-market/src/evaluators/authority.rs:6-7); quorum stays at minimum_evaluator_count of at least 3."

[req.4032]
title = "AI score commit and reveal (F04)"
ac_1 = "CommitScore 0x0401 and RevealScore 0x0402 apply through programs/crates/layerx-programs-ai-market/src/commit_reveal.rs:671 with commit at programs/crates/layerx-programs-ai-market/src/commit_reveal.rs:564 and reveal at programs/crates/layerx-programs-ai-market/src/commit_reveal.rs:598."
ac_2 = "The windows are COMMIT_OPENS 64, COMMIT_CLOSES 80, REVEAL_OPENS 80 and REVEAL_CLOSES 96 heights (programs/crates/layerx-programs-ai-market/src/commit_reveal.rs:63-66); a commit or reveal outside its window is refused."
ac_3 = "The window constants are re-tuned to the chain block cadence and set at activation rehearsal (decision.7); the duplicated constants in evidence (programs/crates/layerx-programs-ai-market/src/evidence.rs:1590-1591) change with them in one change."

[req.4033]
title = "AI aggregation (F05)"
ac_1 = "BeginAggregation, ProcessAggregation and FinalizeAggregation (0x0501 to 0x0503) are routed to programs/crates/layerx-programs-ai-market/src/aggregation.rs:1280."
ac_2 = "The result is the lower median with a fixed quorum of 3 and at most 8 votes (programs/crates/layerx-programs-ai-market/src/aggregation.rs:55, programs/crates/layerx-programs-ai-market/src/aggregation.rs:76); absent votes are excluded."
ac_3 = "Aggregation fits the runtime fuel cap and runs end to end through programs/tests/ai-market/run-aggregation-runtime.sh:1 against the runtime."

[req.4034]
title = "AI rewards: fund, claim, expire, refund and prune (F06)"
ac_1 = "FUND, CLAIM, EXPIRE_EPOCH_CLAIMS, REFUND_FREE and PRUNE_EPOCH (0x0601 to 0x0605) are routed to programs/crates/layerx-programs-ai-market/src/rewards.rs:2355."
ac_2 = "Each effect performs at most one native 402LXP action from the program rewards account under a grant ceiling (programs/crates/layerx-programs-ai-market/src/value_adapter.rs:110, programs/crates/layerx-programs-ai-market/src/value_adapter.rs:121)."
ac_3 = "The rewards account is the derived account of seed paxai/rewards/v1 (programs/crates/layerx-programs-ai-market/src/lib.rs:198) and reward asset ids map one-to-one to bank denoms."

[req.4035]
title = "AI worker history (F07)"
ac_1 = "ResetHistory, SuspendHistory and ResumeHistory (0x0701 to 0x0703) are routed to programs/crates/layerx-programs-ai-market/src/epoch.rs:1432."
ac_2 = "History records stay bounded per worker and are read through READ_STATE_CHUNK (programs/crates/layerx-programs-ai-market/src/queries.rs:119) at a committed height."
ac_3 = "The indexer history projection (platform/hosted/indexer/src/ai_reputation.rs:186) promotes entries at block commit, replacing checkpoint certificate promotion (platform/hosted/indexer/src/ai_reputation.rs:4, platform/hosted/indexer/src/ai_reputation.rs:28)."

[req.4036]
title = "AI admission, capacity and liveness (F08)"
ac_1 = "ApproveAdmission to AdministrativeRemove (0x0801 to 0x0809) gain an envelope apply that calls the admission table methods (programs/crates/layerx-programs-ai-market/src/admission.rs:662, programs/crates/layerx-programs-ai-market/src/admission.rs:823)."
ac_2 = "PruneInactive removes admissions whose last heartbeat is older than the policy bound (programs/crates/layerx-programs-ai-market/src/admission.rs:980)."
ac_3 = "Each heartbeat (programs/crates/layerx-programs-ai-market/src/admission.rs:823) is an EVM transaction whose gas is drawn from a per-worker sponsorship budget of the gas station."

[req.4037]
title = "AI evidence seal and private artifacts (F09)"
ac_1 = "SealEvidence 0x0901 binds artifacts to the sealed task context through programs/crates/layerx-programs-ai-market/src/evidence.rs:2135; the chain stores commitments only."
ac_2 = "A missing artifact digest is never accepted: a reveal against an unsealed or unknown digest is refused (programs/crates/layerx-programs-ai-market/src/evidence.rs:2135)."
ac_3 = "ai-artifacts keeps its object lifecycle and retention ledger; its binding observation takes the sealed evidence from a committed height (platform/hosted/ai-artifacts/src/retention.rs:474)."

[req.4038]
title = "AI queries, projections, views and SDKs (F10)"
ac_1 = "READ_HEADER 0x0A01 and READ_STATE_CHUNK 0x0A02 are served through simulateCall, a non-committing call that dispatches to programs/crates/layerx-programs-ai-market/src/queries.rs:78 and programs/crates/layerx-programs-ai-market/src/queries.rs:119 without a transaction."
ac_2 = "The snapshot binding becomes a versioned binding v2 in which batch_id is the block hash, native_state_root is the app hash with an ICS23 proof and finality is block commit (programs/crates/layerx-programs-ai-market/src/queries.rs:309)."
ac_3 = "The indexer, gateway AI views (platform/hosted/gateway/src/ai_views.rs:21), webhooks and the TS and Python AI clients keep their routes and accept v2 bindings."

[req.4039]
title = "Native storage continuity retirement"
ac_1 = "paxai-storage-keeper is retired: chain state has no finite capacity reservation, and its build targets at Makefile:3609 are removed."
ac_2 = "Historical program state is served by archive nodes as an ICS23 proof at an old height, replacing the kernel storage continuity test (tests/programs/test_paxai_storage_continuity.c:2008)."
ac_3 = "Storage retirement stays only as the controller-signed retireStorage of req 4.14, staged through tests/programs/test_paxai_native_gaps.c:1115 in the kernel tests."

[req.4040]
title = "Agent budgets for program and AI calls"
ac_1 = "The seven-field call budget (src/modules/programs/call.c:2572) and capability spend grants stay inside call(bytes) unchanged."
ac_2 = "Delegated authorities such as the multisig scope at src/modules/programs/call.c:2921 are authz grants carrying a LayerX-scope authorization (decision.3), keeping all eight authority kinds."
ac_3 = "Dynamic spend through capability grants keeps its runtime rules (programs/crates/layerx-programs-runtime/tests/dynamic_spend.rs:6)."

[req.4041]
title = "Precompile 0x101D framework fit"
ac_1 = "layerxprograms is registered at address 0x101D beside the custom precompiles of precompiles/setup.go:63, following the layout of precompiles/layerxcustody/layerxcustody.go:83."
ac_2 = "Every method and view is height-gated on the activation plan with IsUpgradeActiveAtHeight as at modules/layerxcustody/keeper/keeper.go:42; before activation each call reverts with the not-active reason."
ac_3 = "Reverts are Error(string) carrying the kernel result name through precompiles/common/precompiles.go:53 and precompiles/common/precompiles.go:59, and the module Paused param refuses every write method while views keep answering."
ac_4 = "The principal of every write is the DID id bound to msg.sender through 0x1004, and the authority record passed to the shim has kind `OWNER`, or the kind of the authz grant used (decision.3), with principal and actor equal to that DID id (src/ledger/lx_account_id.c:196-199)."

[req.4042]
title = "Fixed per-method gas table"
ac_1 = "Gas per method is fixed by the D2 table (decision.30): read is 1000 plus 3 per input byte and write is 2000 plus 30 per input byte, derived from sdk/store/types/gas.go:349."
ac_2 = "deploy and upgrade cost write plus 100000, call and sandboxExecute cost write plus 50000, simulateCall costs read plus 50000, and retireStorage costs write plus 2 x 4000 plus 20000 with 4000 taken from precompiles/addr/addr.go:53."
ac_3 = "The table replaces the default precompile cost of precompiles/common/precompiles.go:286 for every 0x101D selector, and an unknown selector reverts."

[req.4043]
title = "Fee, metering, quote and pending views"
ac_1 = "getFeeSchedule(epoch) and getCurrentFeeSchedule() read src/modules/programs/fees.c:1608 and src/modules/programs/fees.c:1633; getPendingFeeSchedule reads src/modules/programs/fees.c:1355."
ac_2 = "getMeteringSchedule and getCurrentMeteringSchedule read src/modules/programs/metering.c:182 and src/modules/programs/metering.c:205."
ac_3 = "quoteCallFee(uint64[7] budget) returns the execution ceiling, the sum over budget fields 0 to 5 of the field times the current price, using the admission prices bound at src/protocol/lxp_kernel.c:568-580 and the occupancy quote loop at src/modules/programs/occupancy.c:299-315."
ac_4 = "simulateCall (0x3044bd56) runs the call on a cached context and discards it, as src/protocol/lxp_kernel.c:6192 does, for sequencer and wallet previews."

[req.4044]
title = "Parity vectors pass through the native host"
ac_1 = "The kernel program tests in programs-core-test (Makefile:3638) pass unchanged at the merged revision and the same fixtures pass through the native host."
ac_2 = "The fee replay test (tests/test_fee_replay.c:411) gives equal fee amounts when the same activities run through layerxprograms."
ac_3 = "The runtime test suites lifecycle, execution, monetary_law, fee_governance and web_read pass against the staticlib linked into paxd (programs/crates/layerx-programs-runtime/tests/monetary_law.rs:20)."

[req.4045]
title = "Internal methods become chain hooks and gov messages"
ac_1 = "The fee-governance relay at src/modules/programs/fees.c:1089 to src/modules/programs/fees.c:1288 is replaced by MsgUpdateFeeSchedule under gov authority; the observe hook at src/modules/programs/fees.c:1731 runs in EndBlock."
ac_2 = "The migration epoch hook at src/modules/programs/registration.c:239 runs in BeginBlock with the block height as the epoch input."
ac_3 = "Occupancy finalize at src/modules/programs/occupancy.c:826 runs once per block in EndBlock after the sandbox sweep, and the metering schedule is materialized from genesis through src/modules/programs/metering.c:315 with the governance authority kind (include/layerx/programs.h:403)."
ac_4 = "The deploy migration fee path at src/modules/programs/deploy.c:724 commits usage into the program fee leg on chain and is not a user method."

[req.4046]
title = "Reference guests deployed at activation"
ac_1 = "The interpreter, compute-lease market and AI market guests are deployed through MsgDeploy in the activation bring-up with expected code hashes listed in the activation plan (decision.13), through the deploy path at src/modules/programs/deploy.c:803."
ac_2 = "The guests are built reproducibly from their crates (programs/Cargo.toml:6-8) and the expected hashes are set at activation rehearsal."
ac_3 = "The AI market guest is built with its chain domain set for the chain id (programs/crates/layerx-programs-ai-market/src/lib.rs:52); a build without the domain is refused by the bring-up."

[req.4047]
title = "AI evaluator calls on the sequencer path"
ac_1 = "The evaluator service submits CommitScore and RevealScore (programs/crates/layerx-programs-ai-market/src/dispatch.rs:108-109) as EVM transactions to 0x101D through the sequencer and receives the signed receipt at execution."
ac_2 = "Window checks use the sequenced execution height read through context_read (programs/crates/layerx-programs-ai-market/src/commit_reveal.rs:487), so a reveal sequenced after REVEAL_CLOSES is refused even if the block is proposed later."
ac_3 = "simulateCall previews a CommitScore or RevealScore without state change so the evaluator can check the window before signing (programs/crates/layerx-programs-ai-market/src/commit_reveal.rs:598)."

[req.4048]
title = "paxai-worker reads program state from the chain"
ac_1 = "FinalizedAuthority::bind (platform/hosted/paxai-worker/src/discovery.rs:105) takes a Query/ProgramState capture of the AI market state with an ICS23 proof at a committed height in place of the kernel capture and finality evidence."
ac_2 = "The finality lag check against the committed head keeps MAX_FINALITY_LAG = 8 heights (platform/hosted/paxai-worker/src/discovery.rs:136)."
ac_3 = "The worker configuration names a chain endpoint and the 0x1004-bound submit key next to the delegate seed (platform/hosted/paxai-worker/src/main.rs:43); no kernel endpoint remains."

[req.4049]
title = "ai-artifacts retention keyed to block commit"
ac_1 = "Retention timers start at the block commit height of the terminal or binding event (platform/hosted/ai-artifacts/src/retention.rs:414, platform/hosted/ai-artifacts/src/retention.rs:474) instead of kernel finality rank."
ac_2 = "The FinalityUnavailable refusal (platform/hosted/ai-artifacts/src/retention.rs:47) is returned only when the binding height is above the committed head."
ac_3 = "Recovery after restart replays the retention ledger and re-reads bindings from the chain at their commit heights (platform/hosted/ai-artifacts/src/retention.rs:717)."

[req.4050]
title = "Retirement of the kernel program adapters"
ac_1 = "The protocol-adapter crate (programs/Cargo.toml:5, programs/crates/layerx-programs-protocol-adapter/src/ffi.rs:147) is deleted after every caller reads through gRPC."
ac_2 = "The program state feed store (src/modules/programs/feed_store.c:988, include/layerx/lxp_daemon.h:382) and its daemon wiring are removed; Cosmos events, 0x101D logs and the indexer replace it."
ac_3 = "lx_getProgramEvents and /v1/programs/events (platform/hosted/gateway/src/rpc.rs:23) and the gateway programs ingress (platform/hosted/gateway/src/rpc.rs:618) are removed in favour of eth_getLogs on 0x101D and Query/ProgramEvents."
ac_4 = "The AI market LNI submit path (agent/crates/layerx-client/src/ai_market.rs:1546) is replaced by 0x101D calldata over EVM transactions."

[req.4051]
title = "Module hosting, genesis, params and bring-up"
ac_1 = "modules/layerxprograms hosts the kernel programs module and the runtime staticlib through cgo behind the lxp_module_ctx shim (decision.1), registered like the existing module wiring at node/app.go:164-166 and node/app.go:266."
ac_2 = "Genesis holds params (Paused, metering schedule, fee schedule) and empty program stores; activation is a bring-up at the activation height and no account-state migration is required (node/upgrades.go:117)."
ac_3 = "The plan name is listed in node/upgrades.go:416 and set at activation rehearsal next to the activation constant pattern of modules/layerxcustody/types/governance_activation.go:5."

[req.4052]
title = "AI market dispatch routes every implemented operation"
ac_1 = "Required change: programs/crates/layerx-programs-ai-market/src/dispatch.rs:901 routes REQUEST_CLOSE and ADVANCE_CLOSE (0x010A, 0x010B) to programs/crates/layerx-programs-ai-market/src/closure.rs:670; today they fall to UNKNOWN_OPERATION."
ac_2 = "Required change: the transition routes 0x0501 to 0x0503, 0x0601 to 0x0605, 0x0701 to 0x0703 and 0x0801 to 0x0809 to their apply entries (programs/crates/layerx-programs-ai-market/src/epoch.rs:1189, programs/crates/layerx-programs-ai-market/src/rewards.rs:2355, programs/crates/layerx-programs-ai-market/src/epoch.rs:1432, programs/crates/layerx-programs-ai-market/src/admission.rs:741)."
ac_3 = "Required change: READ_HEADER and READ_STATE_CHUNK are served on the ProgramRead boundary (programs/crates/layerx-programs-ai-market/src/dispatch.rs:19-22) without a state write."

[req.4053]
title = "AI market chain domain and height windows"
ac_1 = "Required change: the chain domain read from PAXAI_CHAIN_DOMAIN at build time (programs/crates/layerx-programs-ai-market/src/lib.rs:52) is set for the chain id at activation rehearsal and pinned in the expected code hash."
ac_2 = "Policy heights (task_timeout_heights, commit and reveal windows, EPOCH_HEIGHTS 128 at programs/crates/layerx-programs-ai-market/src/aggregation.rs:356) are re-tuned to the chain block cadence and set at activation rehearsal (decision.7)."
ac_3 = "Envelopes stay within MAX_ENVELOPE_BYTES 16384 and state within MAX_STATE_BYTES 196608 (programs/crates/layerx-programs-ai-market/src/lib.rs:199, programs/crates/layerx-programs-ai-market/src/lib.rs:204), within the 0x101D call input bound."

