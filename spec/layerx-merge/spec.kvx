qualification = "UNRUN"

[acceptance.7.2.3]
feature = "7"
req = "7002.3"
scenario = "Given the sequencer endpoint refusing connections, when a client sends eth_sendRawTransaction, then the router answers -32003 within its upstream deadline and keeps no copy of the transaction."
