writes = "None; the relay archive services it replaces (deploy/rollout.kvx:155) retire."
signing_key = "None beyond the node identity key. Service entry point: rpc/state.go:110."
liveness = "Historical proofs and old-height reads stop; current-state reads are unaffected. Service entry point: rpc/state.go:110."
failure = "Down: historical reads error; the router never substitutes the head (tools/paxeer-x/route-catalogue.json:434)."
evidence = "None. Service entry point: rpc/state.go:110."
monitoring = "Earliest retained height and head lag against a full node, beside the height stall alert (tools/ops/monitoring/rules.yml:4)."

