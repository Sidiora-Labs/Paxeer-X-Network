[feature.5]
name = "xweb web data: origin 1 kept, origin 2 hosted in modules/xweb, paid HTTP on the ledger precompile"
scope = "The xweb precompile 0x1019 and modules/xweb keep origin 1 (request precompiles/xweb/xweb.go:306-331, fulfil precompiles/xweb/xweb.go:384-447, refund precompiles/xweb/xweb.go:333-346) and gain origin 2 for hosted programs through Keeper.RequestFromProgram and fulfilProgram, replacing the kernel web module intake (src/modules/web/lx_web_intake.c:510-595); one attestor set capped at 16 serves both origins; the x-websearch sidecar watches EVM logs and submits fulfilProgram; paid HTTP settles by draw and payExact on 0x101A with receipts verified under pinned ReceiptKeys; the fee calculator takes the PAX USD rate as an input; the kernel web module, adapter, web root, relay, kernel 402LXP settlement, lx_getProgramEvents and lx_getWalletCaps retire."
requirements = ["5001", "5002", "5003", "5004", "5005", "5006", "5007", "5008", "5009", "5010", "5011", "5012", "5013", "5014", "5015", "5016", "5017", "5018", "5019", "5020", "5021", "5022", "5023", "5024", "5025", "5026", "5027", "5028", "5029", "5030", "5031", "5032", "5033", "5034", "5035", "5036", "5037", "5038", "5039", "5040", "5041", "5042", "5043", "5044", "5045", "5046", "5047", "5048", "5049", "5050", "5051", "5052"]
completion_task = "5.7.1"

[req.5001]
title = "Origin-1 EVM web request through request(uint8,bytes,uint64)"
ac_1 = "request (0x5f7c8e9b) on xweb 0x1019 escrows exactly Params.Fee from the caller into the xweb module account and stores the Request under the next global nonce (modules/xweb/keeper/request.go:44-45, modules/xweb/keeper/request.go:51-71)."
ac_2 = "request refuses a paused module, an unknown kind, an empty or oversized payload, zero or oversized callback gas, a payment other than the fee and a zero requester with the registered errors (modules/xweb/keeper/request.go:20-48)."
ac_3 = "request emits the EVM log XWebRequested and the Cosmos event XWebRequested carrying origin 1 and the EVM chain id as network_id (precompiles/xweb/xweb.go:326-327, modules/xweb/keeper/request.go:75-88)."
ac_4 = "request refuses a msg.value whose wei part is not a whole number of base units with LXP_PRECOMPILE_WEI_REMAINDER (precompiles/common/precompiles.go:228-231, precompiles/xweb/xweb.go:313-320)."
ac_5 = "request is refused through a delegatecall, from a staticcall and while no keeper is wired, with LXP_XWEB_DELEGATECALL, LXP_XWEB_STATICCALL and LXP_XWEB_KEEPER_MISSING (precompiles/xweb/xweb.go:288-299)."

[req.5002]
title = "Origin-1 fulfil: threshold or single-attestor verification, fee split and metered callback"
ac_1 = "fulfil (0xaeb8a7ec) verifies strictly ascending member signatures numbering at least Threshold over the origin-1 preimage and stores the Result (modules/xweb/keeper/fulfil.go:17-43, modules/xweb/keeper/fulfil.go:93-182)."
ac_2 = "fulfil splits the escrowed fee equally among the signers' payout accounts, the remainder of the division to the lowest signer, skipping zero legs (modules/xweb/keeper/fulfil.go:132-151)."
ac_3 = "fulfil refuses unordered, duplicate, non-member, high-s or wrong-v signatures with LXP_XWEB_BAD_SIGNATURE and fewer than Threshold with LXP_XWEB_BELOW_THRESHOLD (modules/xweb/keeper/fulfil.go:17-43, modules/layerxbridge/types/attestation.go:115-134)."
ac_4 = "fulfil delivers onXWebResponse to the requester with min(callbackGas, MaxCallbackGas) gas and records the outcome once (precompiles/xweb/xweb.go:449-482, modules/xweb/keeper/fulfil.go:186-205)."
ac_5 = "fulfil at the single level accepts exactly one signature from the named attestor and refuses any other with LXP_XWEB_BAD_SIGNATURE or LXP_XWEB_UNKNOWN_ATTESTOR (modules/xweb/keeper/fulfil.go:48-64)."

[req.5003]
title = "Origin-1 refund after timeout; origin-2 ids are not refundable"
ac_1 = "refund (0xd7194ccb) returns the fee to the requester once the block height reaches timeoutHeight, sets status 2 and emits XWebRefunded (modules/xweb/keeper/refund.go:17-48, precompiles/xweb/xweb.go:333-346)."
ac_2 = "refund refuses an unknown id, a fulfilled or refunded request and a height below timeoutHeight with LXP_XWEB_UNKNOWN_REQUEST, LXP_XWEB_ALREADY_FULFILLED, LXP_XWEB_REFUNDED and LXP_XWEB_NOT_EXPIRED (modules/xweb/keeper/refund.go:19-30)."
ac_3 = "refund stays open while the module is paused (modules/xweb/keeper/refund.go:15-16)."
ac_4 = "refund of a request id that only exists as an origin-2 program request returns LXP_XWEB_UNKNOWN_REQUEST, because program requests are keyed by (programId, requestId) outside the request prefix (modules/xweb/types/keys.go:32, src/modules/programs/call.c:603-612)."

[req.5004]
title = "Origin-1 read views"
ac_1 = "getRequest (0xcbbf67ec) and getResult (0xedff42d6) return the stored request and result and revert LXP_XWEB_UNKNOWN_REQUEST for an absent id (precompiles/xweb/xweb.go:348-380, modules/xweb/keeper/keeper.go:128-152)."
ac_2 = "getAttestors (0x1a15922d), threshold (0x42cde4e8), fee (0xddca3f43) and getParams (0x5e615a6b) read the single attestor set, the threshold, the fee in wei and the fixed params tuple (modules/xweb/keeper/keeper.go:62-107, precompiles/xweb/XWeb.sol:65-71)."
ac_3 = "The ABI file matches the Solidity interface for every method including the origin-2 additions (precompiles/xweb/XWeb.sol:93-115)."

[req.5005]
title = "One attestor set for both origins, registration capped at 16"
ac_1 = "MsgRegisterAttestor adds an attestor in ascending signer order and raises the threshold to the majority when below it (modules/xweb/keeper/msg_server.go:71-102)."
ac_2 = "MsgRegisterAttestor refuses the 17th attestor with LXP_XWEB_INVALID_ATTESTORS: the full check compares against a cap of 16 in place of MaxAttestors 64 (modules/xweb/keeper/msg_server.go:82-83, modules/xweb/types/keys.go:21)."
ac_3 = "MsgRegisterAttestor refuses a registered signer, a zero signer, a payout that is not bech32 and a public key that does not derive the signer (modules/xweb/keeper/msg_server.go:79-80, modules/xweb/types/state.go:136-158)."
ac_4 = "MsgRemoveAttestor removes a registered signer and clamps the threshold to the set size; an unknown signer fails LXP_XWEB_UNKNOWN_ATTESTOR (modules/xweb/keeper/msg_server.go:107-136)."

[req.5006]
title = "Threshold governance: strict majority of the set"
ac_1 = "MsgSetThreshold accepts t with 2t > n and t <= n and emits xweb_threshold_set (modules/xweb/keeper/msg_server.go:140-156, modules/xweb/types/state.go:172-174)."
ac_2 = "MsgSetThreshold refuses zero in ValidateBasic and a non-majority in the keeper with LXP_XWEB_INVALID_THRESHOLD (modules/xweb/types/msgs.go:106-107, modules/xweb/keeper/msg_server.go:148-149)."
ac_3 = "The same strict-majority rule governs origin-2 admission, reproducing the kernel set check (src/modules/web/lx_web_attestors.c:13-15) that intake applies before signature verification (src/modules/web/lx_web_intake.c:562-563)."

[req.5007]
title = "Params: origin-2 fields kernelNetworkId and programFeeDenoms"
ac_1 = "MsgSetParams carries kernelNetworkId (uint32, non-zero) and programFeeDenoms (subset of the PAX, SID, USDC and USDL denoms, minimum one) beside fee, payload cap, callback cap and timeout (modules/xweb/keeper/msg_server.go:161-182, modules/xweb/types/state.go:84-124)."
ac_2 = "MsgSetParams refuses kernelNetworkId 0, an empty programFeeDenoms and a denom outside the four mapped denoms with LXP_XWEB_INVALID_PARAMS (modules/xweb/types/state.go:110-124)."
ac_3 = "A sender other than Params.Authority is refused with LXP_XWEB_UNAUTHORIZED on every governance message (modules/xweb/keeper/keeper.go:81-86, modules/xweb/types/msgs.go:78-81)."
ac_4 = "The params proto and Go struct carry the two fields with the same numbering in MsgSetParams (api/xweb/tx.proto:74-84) and genesis export round-trips them (modules/xweb/keeper/genesis.go:27-36)."

[req.5008]
title = "Pause stops both origins; refund stays open"
ac_1 = "MsgPause sets the paused key and MsgUnpause deletes it, each by Params.Authority only (modules/xweb/keeper/msg_server.go:185-207, modules/xweb/keeper/keeper.go:109-115)."
ac_2 = "While paused, request, fulfil, RequestFromProgram and fulfilProgram refuse with LXP_XWEB_PAUSED (modules/xweb/keeper/request.go:20-21, modules/xweb/keeper/fulfil.go:95-96)."
ac_3 = "The kernel web module has no pause of its own; the only gate it had is the module registration epoch window (src/protocol/lxp_kernel.c:1410-1414), which the per-method activation height replaces."

[req.5009]
title = "Kernel attestor-set activity retired into the xweb Msgs"
ac_1 = "The kernel ATTESTOR_SET activity 0x000B0002 (include/layerx/lx_web.h:21) and its wholesale replace of web/attestors (src/modules/web/lx_web_module.c:147-162) have no Paxeer counterpart; MsgRegisterAttestor, MsgRemoveAttestor and MsgSetThreshold govern the one set."
ac_2 = "The kernel set limits (1..16 members, strict majority, ascending signers; src/modules/web/lx_web_attestors.c:8-26) are reproduced by AttestorSet.Validate with MaxAttestorSetSize and ValidThreshold (modules/xweb/types/state.go:176-200)."
ac_3 = "The kernel set authority (a governance key fixed at handover, src/modules/web/lx_web_attestors.c:103-109) is replaced by Params.Authority (modules/xweb/keeper/keeper.go:81-86)."
ac_4 = "A kernel 32-byte payout id maps to the bank address address.Module(\"layerx\", id) (sdk/types/address/hash.go:63-65) when an existing kernel set entry is carried into the xweb set (include/layerx/lx_web.h:70-73)."

[req.5010]
title = "RequestFromProgram: the origin-2 keeper entry called by the hosted programs module"
ac_1 = "Keeper.RequestFromProgram(ctx, programId, requestId, kind, payload, asset, amount) records the 123-byte pending record under \"web/pending\"||programId||u64 requestId with version 1, kind, keccak256(payload), fee asset, fee account, u128 amount, recording sequence and fulfilled 0 (src/modules/programs/call.c:1935-1954, src/modules/programs/call.c:603-612)."
ac_2 = "RequestFromProgram refuses a second web request in one call with LXP_DUPLICATE_ENTRY, a requestId already recorded or answered with LXP_SEQUENCE_REUSED and an undecodable event with LXP_NON_CANONICAL (src/modules/programs/call.c:1883-1900, src/modules/web/lx_web_intake.c:151-168)."
ac_3 = "RequestFromProgram refuses a call with no positive payment into a web fee account with LXP_FEE_UNPAYABLE and legs of two assets with LXP_ASSET_MISMATCH (src/modules/programs/call.c:1902-1920)."
ac_4 = "RequestFromProgram is reachable only from the program call that emitted the event: the topic match and the capture run inside the programs event emit (src/modules/programs/call.c:1979-1985), and no EVM selector reaches it."

[req.5011]
title = "Origin-2 fee account per asset and the programFeeDenoms allowlist"
ac_1 = "The fee account of an asset is the bank address address.Module(\"layerx\", sha256(\"PAXEERX_WEB_FEES_V1\"||asset)), reproducing web_fee_account_id (src/modules/programs/call.c:591-601) through sdk/types/address/hash.go:63-65."
ac_2 = "The fee is any positive amount of one allowlisted asset, held in the fee account until fulfilment, with no refund and no timeout; origin 1 keeps the exact Params.Fee (src/modules/programs/call.c:1904-1920, modules/xweb/keeper/request.go:44-45)."
ac_3 = "A payment in a denom outside programFeeDenoms is refused with LXP_ASSET_MISMATCH before anything is recorded (src/modules/programs/call.c:1911-1913)."
ac_4 = "The payment legs debit the call principal or the program funding account, which must equal the principal (src/modules/programs/call.c:2235-2238), and the fee account is created on first payment (src/modules/programs/call.c:2224-2234)."

[req.5012]
title = "Observation decoding: the raw canonical OBSERVATION bytes"
ac_1 = "DecodeObservation accepts exactly the kernel layout: origin 2, 28 zero bytes, u32 networkId, programId, u64 requestId, kind, payloadHash, contentDigest, u32 fullLength, u32 responseLength, response, u8 signatureCount 1..16 and 65-byte signatures, with no trailing byte (src/modules/web/lx_web_intake.c:101-149)."
ac_2 = "DecodeObservation refuses a length under 146 or over 5283 bytes, origin other than 2, a non-zero byte in 1..28, responseLength over 4096, fullLength under responseLength, zero or more than 16 signatures and a length mismatch with LXP_NON_CANONICAL (src/modules/web/lx_web_intake.c:109-147, include/layerx/lx_web.h:32-35)."
ac_3 = "A zero programId and a kind outside 1..2 are refused, as the canonical encoder refuses them (src/network/lx_web_adapter.c:30-40)."
ac_4 = "The observation activity 0x000B0001 (include/layerx/lx_web.h:20) is not carried as a kernel activity: the same bytes are the fulfilProgram argument, so the length checks of module_validate (src/modules/web/lx_web_module.c:94-127) become the decode checks."

[req.5013]
title = "Origin-2 signature verification over the shared xweb set"
ac_1 = "FulfilProgram checks signatureCount >= Threshold first and refuses with LXP_ATTESTATION_THRESHOLD (src/modules/web/lx_web_intake.c:220-221)."
ac_2 = "Per signature, v outside 27..28 or a high s gives LXP_BAD_SIGNATURE, a failed recovery gives LXP_BAD_SIGNATURE, an equal neighbour gives LXP_AUTH_DUPLICATE_SIGNER, a descending neighbour gives LXP_UNSORTED_SEQUENCE and a non-member gives LXP_INVALID_ATTESTATION (src/modules/web/lx_web_intake.c:222-240)."
ac_3 = "An invalid set (empty, over 16, or threshold not a strict majority) refuses with LXP_ATTESTATION_THRESHOLD before the digest is computed (src/modules/web/lx_web_intake.c:562-563, src/modules/web/lx_web_attestors.c:8-26)."
ac_4 = "Signer recovery is the same secp256k1 rule as origin 1: 65-byte r||s||v, v 27 or 28, low s (modules/layerxbridge/types/attestation.go:113-134)."

[req.5014]
title = "Origin-2 admission order, answer commit and fee split"
ac_1 = "FulfilProgram checks network id (LXP_WRONG_NETWORK), the pending record (LXP_UNKNOWN_FIELD), fulfilled byte (LXP_SEQUENCE_REUSED), kind and payload hash (LXP_CONTEXT_MISMATCH), then the set, then signatures, in the kernel order (src/modules/web/lx_web_intake.c:532-568)."
ac_2 = "The answer is written under \"web/answer\"||programId||u64 requestId||u8 part: part 0 is contentDigest, u32 fullLength and u32 responseLength (40 bytes), parts 1..ceil(R/1024) are 1024-byte response chunks (src/modules/web/lx_web_intake.c:253-307, include/layerx/lx_web.h:44-49)."
ac_3 = "The fee splits as floor(amount / signatureCount) to each signer's payout with the remainder to signers[0], zero legs skipped, in the recorded asset, and the record byte 122 becomes 1 (src/modules/web/lx_web_intake.c:423-503)."
ac_4 = "Every write of FulfilProgram is in one cached context: any refusal after decoding leaves the record, the answer families and all balances unchanged (src/modules/web/lx_web_intake.c:571-577)."

[req.5015]
title = "Origin-2 store capacities"
ac_1 = "At most 256 program requests are pending (recorded, unfulfilled); the 257th refuses with LXP_ARENA_EXHAUSTED (include/layerx/lx_web.h:39, src/modules/web/lx_web_intake.c:546-547)."
ac_2 = "At most 64 committed answers are held; the 65th fulfilProgram refuses with LXP_ARENA_EXHAUSTED before writing (include/layerx/lx_web.h:40, src/modules/web/lx_web_intake.c:569-570)."
ac_3 = "The counters are state, exported and imported with genesis, and the kernel bind check of counts within capacity (src/protocol/lxp_kernel.c:1683-1688) becomes a genesis validation."

[req.5016]
title = "getProgramResult and the web_read bridge"
ac_1 = "getProgramResult(bytes32 programId, uint64 requestId) (0x2b2e13fc) returns (contentDigest, fullLength, responseLength, response) from committed state only, reassembled from the chunks (src/modules/web/lx_web_intake.c:330-368)."
ac_2 = "An absent answer reverts LXP_UNKNOWN_FIELD, malformed stored parts revert LXP_NON_CANONICAL, and a call before activation reverts LXP_MODULE_DISABLED (src/modules/web/lx_web_intake.c:309-328, src/modules/web/lx_web_intake.c:341-364)."
ac_3 = "The guest web_read host call returns only the calling program's answers through Keeper.GetProgramResult, keeping its ABI (programs/crates/layerx-programs-runtime/src/abi/manifest.rs:70, programs/crates/layerx-programs-runtime/src/host/web.rs:13-60, programs/crates/layerx-programs-runtime/src/abi/mod.rs:1346)."
ac_4 = "The kernel view of the programs call (src/modules/programs/call.c:1182-1225) and its committed read (src/modules/programs/call.c:1201) are replaced by the bridge, with the same absent result for a stranger program."

[req.5017]
title = "Kernel network id: getKernelNetworkId and the origin-2 preimage word"
ac_1 = "getKernelNetworkId() (0xfc0d26f4) returns Params.KernelNetworkId; the getParams tuple stays fixed (precompiles/xweb/XWeb.sol:65-71)."
ac_2 = "The kernel network id fills preimage bytes 43..46 (bytes 15..42 zero) for origin 2; origin 1 keeps the EVM chain id (src/modules/web/lx_web_intake.c:67, modules/xweb/keeper/fulfil.go:72)."
ac_3 = "The sidecar reads the id from getKernelNetworkId in place of the kernel config field kernel_network_id (interop/crates/x-websearch/src/config.rs:263, interop/crates/x-websearch/src/config.rs:290)."

[req.5018]
title = "Origin 2 has no refund and no timeout"
ac_1 = "No method refunds an origin-2 fee; the kernel has no refund path (src/modules/programs/call.c:1867-1954)."
ac_2 = "The fee stays in the fee account until fulfilProgram splits it (src/modules/web/lx_web_intake.c:423-491)."
ac_3 = "Origin 1 keeps its timeout refund (modules/xweb/keeper/refund.go:28-30)."

[req.5019]
title = "Origin-1 and origin-2 preimages"
ac_1 = "The origin-1 preimage is 188 bytes: domain, 0x01, chain id, padded requester, request id, kind, payload hash, content digest, response hash, full length (modules/xweb/types/attestation.go:57-72, modules/xweb/keeper/fulfil.go:68-81)."
ac_2 = "The origin-2 preimage equals the kernel bytes for the same fields (src/modules/web/lx_web_intake.c:44-77)."
ac_3 = "The sidecar builds both preimages identically (interop/crates/x-websearch/src/attest.rs:87, interop/crates/x-websearch/src/attest.rs:111)."

[req.5020]
title = "Error names in Error(string) LXP form"
ac_1 = "Each registered xweb error reverts as 'LXP_XWEB_<NAME>: <text>' (modules/xweb/types/errors.go:6-29)."
ac_2 = "The site errors carry LXP_XWEB_DELEGATECALL, LXP_XWEB_STATICCALL, LXP_XWEB_KEEPER_MISSING, LXP_XWEB_FULFIL_EVM_ONLY, LXP_XWEB_CALLBACK_BUDGET (precompiles/xweb/xweb.go:243, precompiles/xweb/xweb.go:288-299, precompiles/xweb/xweb.go:416)."
ac_3 = "Framework errors carry LXP_PRECOMPILE_NON_PAYABLE, LXP_PRECOMPILE_WEI_REMAINDER and the argument-count code (precompiles/common/precompiles.go:213, precompiles/common/precompiles.go:221, precompiles/common/precompiles.go:230)."
ac_4 = "Kernel-origin errors on the origin-2 methods keep their kernel names (src/modules/web/lx_web_intake.c:533, src/modules/web/lx_web_intake.c:561)."

[req.5021]
title = "Fixed per-method gas and framework fit"
ac_1 = "request and refund charge 30000 + 16 x len(input); views charge 3000 + 16 x len(input) (precompiles/xweb/xweb.go:61-63, precompiles/xweb/xweb.go:184-193)."
ac_2 = "fulfil adds 8000 per signature, 64 for undecodable calldata, and the callback gas used plus 10000 (precompiles/xweb/xweb.go:189-191, precompiles/xweb/xweb.go:197-207, precompiles/xweb/xweb.go:446)."
ac_3 = "fulfilProgram charges 30000 + 16 x len(input) + 8000 x signatureCount read from the observation (16 if undecodable), with no callback term; the final number is set at activation rehearsal (precompiles/xweb/xweb.go:184-207)."
ac_4 = "The sidecar gas limit for fulfil equals the precompile charge plus the transaction base and calldata (interop/crates/x-websearch/src/submit.rs:26-34, interop/crates/x-websearch/src/submit.rs:90-100) and gains a fulfilProgram twin without the callback terms."

[req.5022]
title = "Events: origin-1 logs unchanged, origin 2 emits no xweb log"
ac_1 = "XWebRequested, XWebFulfilled and XWebRefunded keep their fields and topic0 values (precompiles/xweb/XWeb.sol:73-91)."
ac_2 = "The Cosmos event names stay as registered (modules/xweb/types/events.go:3-13)."
ac_3 = "Origin 2 emits no xweb log: the request is the program guest event (src/modules/programs/call.c:1985) and fulfilProgram emits none, as the kernel module emits none (src/modules/web/lx_web_module.c:129-145)."

[req.5023]
title = "Per-method activation gate for the origin-2 surface"
ac_1 = "fulfilProgram, getProgramResult, getKernelNetworkId and RequestFromProgram refuse with LXP_MODULE_DISABLED below the activation height, read through IsUpgradeActiveAtHeight as custody does (modules/layerxcustody/keeper/keeper.go:38-46)."
ac_2 = "The gate fails closed when no upgrade reader is bound (modules/layerxcustody/keeper/keeper.go:39-41)."
ac_3 = "The origin-1 methods stay gated by the v6.8 precompile registration only (precompiles/setup.go:37, precompiles/setup.go:93-94)."
ac_4 = "The xweb keeper takes the reader interface used by custody (modules/layerxcustody/types/expected_keepers.go:31-33); the application passes its upgrade keeper (node/app.go:795, node/app.go:656)."

[req.5024]
title = "Activation params: fee 75, kernel network id and denoms"
ac_1 = "At the activation plan height the step sets Params.Fee to 75 base units (USD 0.001 at the approved PAX rate), KernelNetworkId and ProgramFeeDenoms, keeping authority, caps and timeout (modules/xweb/keeper/msg_server.go:168-172, modules/xweb/types/state.go:84-90)."
ac_2 = "Below the plan height params are untouched (modules/layerxcustody/keeper/keeper.go:42)."
ac_3 = "Pending origin-1 requests keep the fee they were stored with (modules/xweb/keeper/request.go:63, modules/xweb/keeper/refund.go:35)."
ac_4 = "The activation is registered beside the existing plans (node/upgrades.go:88, node/upgrades.go:97) and validates params with ValidateSettings (modules/xweb/types/state.go:110-124)."

[req.5025]
title = "Initial attestor set at upgrade"
ac_1 = "The supplied set is registered in ascending order with threshold 3 and the module unpaused (node/upgrades.go:354-372, node/xweb_attestors.go:14)."
ac_2 = "Each entry's key derives its signer or the binary refuses to start (node/xweb_attestors.go:57-66, modules/xweb/types/state.go:150-156)."
ac_3 = "The initial set is within the 16 cap (node/xweb_attestors.go:29)."

[req.5026]
title = "Sidecar attestor engine for both origins"
ac_1 = "The sidecar signs origin-1 and origin-2 attestations with the same key over the shared preimage (interop/crates/x-websearch/src/attest.rs:50-126, interop/crates/x-websearch/src/attest.rs:197)."
ac_2 = "Signer recovery and set handling match the chain (interop/crates/x-websearch/src/attest.rs:174, interop/crates/x-websearch/src/attest.rs:525)."
ac_3 = "The origin-2 signature cap is 16, matching include/layerx/lx_web.h:29; the sidecar constant is a required change from 32 (interop/crates/x-websearch/src/kernel.rs:70)."
ac_4 = "Attest runs fetch, search or api and canonicalises before signing (interop/crates/x-websearch/src/attest.rs:493)."

[req.5027]
title = "Signature exchange keyed by origin"
ac_1 = "One exchange route serves both origins, keyed by (origin, requester, request id) (interop/crates/x-websearch/src/server.rs:211, interop/crates/x-websearch/src/server.rs:216)."
ac_2 = "The program route moves out of the kernel relay (interop/crates/x-websearch/src/kernel.rs:1011)."
ac_3 = "A request id of another origin never matches (interop/crates/x-websearch/src/server.rs:205-206)."

[req.5028]
title = "Crawl, search and content serving unchanged"
ac_1 = "Crawl, index and search keep their behaviour: Crawler.run_cycle (interop/crates/x-websearch/src/crawl.rs:350), WebIndex.put and commit (interop/crates/x-websearch/src/index.rs:145, interop/crates/x-websearch/src/index.rs:166) and query_terms (interop/crates/x-websearch/src/search.rs:107)."
ac_2 = "Unpaid /content/<digest> serves stored content through ContentStore.handle and get (interop/crates/x-websearch/src/content.rs:196, interop/crates/x-websearch/src/content.rs:131), bounded by MAX_CONTENT_BYTES (interop/crates/x-websearch/src/content.rs:14)."
ac_3 = "Fetch keeps its body and redirect limits (interop/crates/x-websearch/src/fetch.rs:753-754) and its destination rule (interop/crates/x-websearch/src/fetch.rs:317)."

[req.5029]
title = "Origin-2 request watch from EVM logs"
ac_1 = "The watcher reads ProgramGuestEvent logs of 0x101D with topic0 0x23a84d3a8c8e7d232703d9715c64dba47a94a94c87c46fe61532e5a609e761d1 carrying the PAXEERX_WEB_REQUEST_V1 topic, beside XWebRequested (interop/crates/x-websearch/src/watch.rs:41-43, interop/crates/x-websearch/src/kernel.rs:43)."
ac_2 = "The watcher keeps confirmations, cursor and chain id check (interop/crates/x-websearch/src/watch.rs:299-309, interop/crates/x-websearch/src/watch.rs:656-663)."
ac_3 = "lx_getProgramEvents is no longer called (interop/crates/x-websearch/src/kernel.rs:55)."

[req.5030]
title = "Origin-2 submit through fulfilProgram"
ac_1 = "The sidecar submits fulfilProgram(observation) (0x2d4bf7ad) built from the canonical observation bytes (interop/crates/x-websearch/src/kernel.rs:561, interop/crates/x-websearch/src/submit.rs:65)."
ac_2 = "The gas limit omits the callback terms (interop/crates/x-websearch/src/submit.rs:90-100)."
ac_3 = "A revert of LXP_SEQUENCE_REUSED is treated as already answered (src/modules/web/lx_web_intake.c:542-544)."

[req.5031]
title = "Paid search draw on layerxledger 0x101A"
ac_1 = "A paid /search or /fetch settles by one draw(bytes32 from, bytes32 assetId, uint128 amount, bytes32 grantId, uint64 receiverSequence, bytes32 idempotencyKey, bytes32 contextHash) transaction to 0x101A, replacing the ordinal-6 RECEIVE draw the receiver key signs today (interop/crates/x-websearch/src/payment.rs:85, interop/crates/x-websearch/src/payment.rs:273)."
ac_2 = "The draw is sent by the draw sender class at a gas price of at most 0.067 gwei; the only price floor is MinimumFeePerGas (modules/evm/types/params.go:81, modules/evm/types/params.go:102), whose default 1 gwei (modules/evm/types/params.go:52) is lowered at activation rehearsal."
ac_3 = "PaymentRecord stores the EVM transaction hash and the idempotency key; after a restart the sidecar reads the receipt by hash and never draws twice for one key (interop/crates/x-websearch/src/payment.rs:607-624, interop/crates/x-websearch/src/payment.rs:1915)."
ac_4 = "Nonces come from eth_getTransactionCount on one sequence per sender address, replacing lx_getSequence (interop/crates/x-websearch/src/payment.rs:1950-1951)."
ac_5 = "An expired grant refuses before sending (interop/crates/x-websearch/src/payment.rs:1906) and a draw whose fee exceeds the request limit refuses with draw_fee_limit_exceeded (interop/crates/x-websearch/src/payment.rs:2124)."

[req.5032]
title = "Paid HTTP exact payment through payExact"
ac_1 = "The exact scheme is a payer-signed payExact(bytes32,bytes32,bytes32,uint128,uint64,bytes32) on 0x101A; the sidecar releases only when the PaymentExact log pays exactly the offer amount in the offer asset to the payee (interop/crates/x-websearch/src/payment.rs:2138-2209)."
ac_2 = "A receipt paying another amount, asset or payee is refused with receipt_mismatch (interop/crates/x-websearch/src/payment.rs:2205); an unknown transaction with receipt_unknown (interop/crates/x-websearch/src/payment.rs:2201)."
ac_3 = "A receipt already used for one release is refused with receipt_consumed (interop/crates/x-websearch/src/payment.rs:2168) and a receipt digest that differs from the claimed digest with receipt_digest_mismatch (interop/crates/x-websearch/src/payment.rs:2161)."
ac_4 = "The receipt is read with pax_sequencerReceipt in place of lx_getReceipt (interop/crates/x-websearch/src/payment.rs:2193-2194)."

[req.5033]
title = "Payer grants on the ledger precompile"
ac_1 = "Grants are issued with issueGrant(bytes) (395-byte wire) and revoked with revokeGrant(bytes32,uint64) on 0x101A by the payer; the sidecar reads getPayerGrant(bytes32) before each draw and applies check_grant (interop/crates/x-websearch/src/payment.rs:2211-2234)."
ac_2 = "check_grant refuses a payer, recipient, asset or purpose that differs with grant_payer_mismatch, grant_recipient_mismatch, grant_asset_mismatch and grant_purpose_mismatch (interop/crates/x-websearch/src/payment.rs:2219-2228)."
ac_3 = "A grant that is not metered or whose per-draw limit is below the price is refused with grant_not_metered or grant_limit (interop/crates/x-websearch/src/payment.rs:2231-2234)."
ac_4 = "The purpose is purpose_hash of the receiver key (interop/crates/x-websearch/src/payment.rs:179); a revoked grant makes the draw revert and nothing is released (interop/crates/x-websearch/src/payment.rs:2018-2042)."

[req.5034]
title = "Receipt verification before release"
ac_1 = "The sidecar releases only after pax_sequencerReceipt(txHash) verifies under the pinned ReceiptKeys {keyId, publicKey, firstHeight, lastHeight}, replacing SequencerTrust (interop/crates/x-websearch/src/config.rs:150-151, interop/crates/x-websearch/src/payment.rs:2098-2112)."
ac_2 = "A receipt naming a key id that is not pinned is refused with receipt_mismatch before release (interop/crates/x-websearch/src/payment.rs:2118)."
ac_3 = "The config replaces sequencer_id and sequencer_public_key with a receipt_keys list (interop/crates/x-websearch/src/config.rs:873-881); a weak or malformed key is refused at load (interop/crates/x-websearch/src/config.rs:876-880)."
ac_4 = "A receipt that was already consumed is refused with receipt_consumed (interop/crates/x-websearch/src/payment.rs:2080)."

[req.5035]
title = "Pricing with the PAX USD rate as an input"
ac_1 = "xweb-config.sh takes the PAX USD rate as a required input and refuses without it, replacing USD_PER_PAX = 13.44 and the approved-rate check (tools/bringup/xweb-config.sh:145, tools/bringup/xweb-config.sh:152)."
ac_2 = "Each asset price is ceil(USD 0.001 x base units per USD), at least 1 (tools/bringup/xweb-config.sh:144, tools/bringup/xweb-config.sh:187)."
ac_3 = "The script calls px_getAccount, px_register and eth_getTransactionCount in place of lx_getAccount, lx_register, lx_getBalance and lx_getSequence (tools/bringup/xweb-config.sh:34, tools/bringup/xweb-config.sh:44, tools/bringup/xweb-config.sh:400, tools/bringup/xweb-config.sh:415, tools/bringup/xweb-config.sh:514)."
ac_4 = "The sidecar keeps prices as configured positive integers per asset (interop/crates/x-websearch/src/config.rs:807-826, interop/crates/x-websearch/src/assets.rs:71-95) and the rendered config carries the computed values."

[req.5036]
title = "MCP web tools pay with EVM addresses"
ac_1 = "web.search and web.fetch pay from the agent's EVM address, replacing agent:<did>:main and agent:<did>:asset:<id> (agent/crates/layerx-mcp/src/tools/web.rs:9-11, agent/crates/layerx-mcp/src/tools/web.rs:1269-1276)."
ac_2 = "Release happens only after the receipt verifies under ReceiptKeys (agent/crates/layerx-mcp/src/tools/web.rs:7-8, agent/crates/layerx-mcp/src/tools/web.rs:36)."
ac_3 = "The payer header carries the EVM address (agent/crates/layerx-mcp/src/tools/web.rs:54)."
ac_4 = "The WebPayer trait keeps grant and pay (agent/crates/layerx-mcp/src/tools/web.rs:395-415) with GrantTerms and ExactTerms carrying 20-byte addresses (agent/crates/layerx-mcp/src/tools/web.rs:364-385)."

[req.5037]
title = "TypeScript and Python web search clients"
ac_1 = "The TypeScript client sends the EVM address in the payer header and verifies receipts under ReceiptKeys (agent/sdk/typescript/src/web-search.ts:13, agent/sdk/typescript/src/web-search.ts:377, agent/sdk/typescript/src/web-search.ts:464-490)."
ac_2 = "The Python client does the same (agent/sdk/python/layerx_sdk/web_search.py:26, agent/sdk/python/layerx_sdk/web_search.py:558, agent/sdk/python/layerx_sdk/web_search.py:575-583)."
ac_3 = "Both drop agent:<did> account names (agent/sdk/typescript/src/web-search.ts:275-286, agent/sdk/python/layerx_sdk/web_search.py:285-307)."
