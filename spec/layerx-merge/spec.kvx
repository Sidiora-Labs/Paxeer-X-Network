[meta]
name = "LayerX merge into Paxeer X"
slug = "layerx-merge"
version = "1.0.0"
status = "draft"
goal = "Fold the LayerX kernel into the Paxeer X Network as one execution domain: every kernel capability works on the chain with the same semantics and outcomes, AI, trading and markets are native to the chain, and the proposer is the executor, so a transaction is executed at receipt, answered with a signed receipt and proposed in exactly that order."
scope = "One execution domain (paxd: Cosmos SDK, EVM, CosmWasm, OCC). Kernel C modules and the Rust program runtime hosted inside chain modules and precompiles; the sequencer node and its consensus rule at one activation height; components that existed only to join two domains retired behind a retired executor; off-chain services and clients re-pointed to the sequencer and chain state."
revision = "52b672ac4"
completion = "Every task verify_cmd passes at one revision, every acceptance criterion of req.1 to req.12 holds on that revision, and the activation goldens (bring-up at the activation height, guarantor bond return, receipt order equal to block order) pass on the merged candidate."

[decision.1]
title = "Kernel C modules and the Rust program runtime inside paxd"
value = "The kernel C modules and the Rust program runtime are hosted through cgo behind an lxp_module_ctx shim inside the chain keepers, conditional on the C-in-consensus determinism spike passing; the result of that spike is decided on its evidence, with no fallback fixed in advance."
basis = "Every kernel module already executes through an lxp_module_ctx execute function (src/modules/programs/registration.c:164, src/modules/programs/deploy.c:485) and the node already links cgo code (wasm-runtime/version_cgo.go:1)."
affects = ["modules/layerxledger", "modules/layerxpay", "modules/layerxauth", "modules/layerxprograms", "modules/layerxexchange", "0x101A", "0x101B", "0x101C", "0x101D", "0x1015"]

[decision.2]
title = "Kernel account and margin model"
value = "Kernel accounts become derived bank addresses per DID and sub-account suffix, and trading margin uses the same namespace."
basis = "Kernel accounts carry a sub-account kind and parent account id (include/layerx/lxp_genesis.h:148-149), and bank addresses make every balance visible to bank, the explorer and ERC-20 pointers."
affects = ["0x1001 bank", "0x1015 layerxexchange", "0x101A layerxledger", "explorer balance views"]

[decision.3]
title = "Home of session keys and delegated authorities"
value = "Session keys and delegated capabilities are authz grants carrying a LayerX-scope Authorization that covers kernel and program calls, keeping all eight authority kinds."
basis = "The kernel defines eight authority kinds including SESSION_KEY and DELEGATED_CAPABILITY (include/layerx/lxp_authority.h:11-19), and authz gives one grant path for all of them."
affects = ["0x101C layerxauth", "sdk/x/authz", "0x101A", "0x101B", "0x101D"]

[decision.4]
title = "Custody claims and guarantor bonds at the activation height"
value = "Not applicable: activation is a bring-up at a height, no account-state migration; the activation handler only returns every posted guarantor bond and open challenge deposit."
basis = "The kernel holds no account state to carry over, so no claim settlement step exists."
affects = ["0x1013 layerxCustody", "0x1014 layerxAnchor", "activation handler"]

[decision.5]
title = "Kernel balances without an addr binding at activation"
value = "Not applicable: activation is a bring-up at a height, no account-state migration; the activation handler creates no claim record and no held balance."
basis = "With no account state to carry over there is no unbound balance to place."
affects = ["0x1004 addr", "activation handler"]

[decision.6]
title = "Precompile error encoding"
value = "Every new precompile reverts with Error(string) carrying the prefix LXP_<code>, and addr 0x1004 and bank 0x1001 gain an opt-in reason path in the shared dynamic-gas precompile base so they return the same form."
basis = "The precompile framework returns Error(string) and already offers WithRevertReasons (precompiles/common/precompiles.go:51), so kernel result codes map to strings without a framework change elsewhere."
affects = ["0x1001", "0x1004", "0x1015", "0x1017", "0x1019", "0x101A", "0x101B", "0x101C", "0x101D", "0x0901-0x0908", "precompiles/common"]

[decision.7]
title = "Time semantics under the sequencer cadence"
value = "The receipt timestamp is fixed at pending-block open, AI and market height windows are re-tuned for the new cadence, and the fee-token rate age is raised by governance."
basis = "The kernel batch carries one timestamp per batch (include/layerx/lxp_batch.h:32) and the fee-token rate age is already a governance parameter (modules/evm/keeper/params.go:310), so no fork or codec change is needed."
affects = ["node/sequencer", "modules/evm params", "0x1018 feeToken", "0x101D AI and market guests", "0x1019 xweb TimeoutBlocks"]

[decision.8]
title = "Trading semantics where kernel and exchange differ"
value = "Order ids are chain-derived from (chain, caller, nonce), launchpad fees accumulate per market, market creation is permissionless with a self-named administrator, books keep capacity 256 with 8 fills per dispatch, and the spot settlement request stays refused as in the kernel."
basis = "Kernel caps are LX_PERPS_BOOK_CAPACITY 256 and LX_PERPS_DISPATCH_MAX_FILLS 8 (include/layerx/lx_perps.h:27, :34), and the single launchpad fee counter is written on every swap (modules/launchpad/keeper/swap.go:172)."
affects = ["0x1015 layerxexchange", "0x1017 launchpad", "agent SDK order API"]

[decision.9]
title = "Program fee versus gas"
value = "The program fee (metering times prices) is kept on top of near-zero gas."
basis = "Program fee outcomes in the existing program goldens stay unchanged (tests/programs/test_fee_governance.c)."
affects = ["0x101D layerxprograms"]

[decision.10]
title = "Paid search settlement and lxpay placement"
value = "Paid web search settles as one draw per request through layerxledger at 0x101A (the lxpay construct), at USD 0.001 per request, with the EVM minimum gas price at most 0.067 gwei for the draw sender class."
basis = "A per-request draw gives one receipt per paid request and keeps the x402 conformance suite (interop/specs/conformance/x402/payment-payload.json) unchanged."
affects = ["0x101A layerxledger", "modules/evm params", "x-websearch sidecar", "x402 seller"]

[decision.11]
title = "Program-origin web request terms"
value = "Program-origin (origin 2) web requests keep the kernel per-asset fee with any-amount, no-refund parity, carried as an origin-2 fee table in the xweb params."
basis = "Paid amounts and outcomes then match the kernel web intake (src/modules/web/lx_web_intake.c:510)."
affects = ["0x1019 xweb", "0x101D layerxprograms"]

[decision.12]
title = "Program-origin observation admission"
value = "Origin-2 observations admit with at most 16 signers and the kernel network id kept as an xweb param."
basis = "The kernel caps attestors at 16 (include/layerx/lx_web.h:29) while xweb signs with the EVM chain id (modules/xweb/keeper/fulfil.go:72), so keeping the kernel id leaves preimage vectors and attestor tooling unchanged."
affects = ["0x1019 xweb", "modules/xweb params", "x-websearch sidecar"]

[decision.13]
title = "Reference guest deployment"
value = "The interpreter, compute-lease market and AI market reference guests are deployed at the activation height through MsgDeploy by the chain operator, with expected code hashes."
basis = "The guests are ordinary programs (programs/crates/layerx-programs-interpreter, programs/crates/layerx-programs-market, programs/crates/layerx-programs-ai-market) and use the same deploy path and goldens as any program."
affects = ["0x101D layerxprograms", "activation runbook"]

[decision.14]
title = "Sponsorship path and per-identity budget home"
value = "Every sponsored agent write is an EIP-7702 executeSponsored batch through the gas station with one paymaster nonce, and per-identity budgets live in a gas-station ledger keyed by the DID resolved through addr 0x1004."
basis = "The sponsorship contract already exists (contracts/src/BatchCallAndSponsor.sol:135) and an on-chain budget would need an ante change (modules/evm/ante/fee.go:36), which is a fork."
affects = ["gas station", "BatchCallAndSponsor", "0x1004 addr", "agent SDK nonce handling"]

[decision.15]
title = "Sequencer receipt signing key"
value = "Receipts are signed by a separate ed25519 receipt key per sequencer host, distinct from the validator key and pinned in the authority service and the settle endpoint."
basis = "The existing verifier takes a pinned 32-byte ed25519 key (agent/crates/layerx-proof/src/receipt.rs:631), so SDK verifiers are reused unchanged."
affects = ["node/sequencer", "modules/sequencer ReceiptKeys", "authority service", "SDK verifiers"]

[decision.16]
title = "DID key rotation and the embedded-wallet ed25519 share"
value = "Application level, decided with the wallet feature; no task of this feature depends on it and addr 0x1004 gains no rotation or recovery method here."
basis = "Key rotation is an application-level matter of the wallet stack, not a chain design decision."
affects = ["0x1004 addr", "embedded wallet"]

[decision.17]
title = "Client-facing contract"
value = "Clients move to a clean break: agent-api major 2, write rungs submitted, receipted and committed, no same-nonce replacement, no pending receipts on eth_getTransactionReceipt, and lx_* ingress switched off at activation."
basis = "Major 1 is declared at agent/schema/agent-api/v1.kvx:3 and removing declarations requires a new major."
affects = ["agent SDKs", "gateway", "CLI", "x402 seller", "seller middleware", "explorer status UI", "wallet status UI"]

[decision.18]
title = "Sequencer consensus scope"
value = "One activation-height fork: BeginBlock(N+1) is fed the votes of N-1, a new modules/sequencer carries MsgSequenceBatch, and Leader() follows the pinned leader list."
basis = "Without the fork a transaction arriving while block N is in consensus waits for its commit, because BeginBlock reads the last commit votes (node/legacyabci/begin_block.go:61) and the leader is chosen by power (consensus/internal/consensus/types/round_state.go:422)."
affects = ["modules/sequencer", "node/sequencer", "consensus Leader()", "node/legacyabci BeginBlock", "activation height"]

[decision.19]
title = "Sequencer execution mode"
value = "The sequencer executes OCC micro-batches in receipt order, with the strictly sequential executor landed first and the switch to micro-batches made on measurement."
basis = "Sequential execution reuses DeliverTx (node/abci.go:169) and micro-batches reuse DeliverTxBatch with the OCC scheduler (node/abci.go:230)."
affects = ["node/sequencer executor"]

[decision.20]
title = "Legacy surfaces"
value = "layerxctl is kept as an operator EVM client, the program registry service becomes a read cache over the programs module, and the eight agent functions behind 0x0901-0x0908 are implemented as real precompiles, the first four re-specified from the earlier implementation."
basis = "The agent routes name 0x0901-0x0908 (human/wallet/gateway/src/precompiles.ts:18) while no precompile is registered there (precompiles/setup.go:67)."
affects = ["cmd/layerxctl", "program registry service", "0x0901-0x0908"]

[decision.21]
title = "layerxAnchor reads after the fold"
value = "layerxAnchor 0x1014 reads are served until every posted guarantor bond is returned, then the store is deleted and the retired executor remains at the address."
basis = "The address stays registered (precompiles/setup.go:83) so it never returns empty success."
affects = ["0x1014 layerxAnchor"]

[decision.22]
title = "Agent functions 0x0901-0x0904"
value = "orob, clearing, oracle and pofq are re-specified from the earlier implementation and implemented anew as real precompiles, keeping eight agent functions."
basis = "The routes exist (human/wallet/gateway/src/precompiles.ts:18-21) and the functions are specified in contracts/K2-AGENT.md section A.1."
affects = ["0x0901", "0x0902", "0x0903", "0x0904"]

[decision.23]
title = "Revert reasons for addr and bank"
value = "addr 0x1004 and bank 0x1001 return Error(string) LXP_<code> reasons through an opt-in reason path in the dynamic-gas precompile base."
basis = "Both run on DynamicGasPrecompile (precompiles/common/precompiles.go:166), and a wallet needs a reason to explain a refused bind."
affects = ["0x1001 bank", "0x1004 addr", "precompiles/common"]

[decision.24]
title = "Service dispute resolution"
value = "Service disputes are resolved by the linked escrow's arbiter, and the linked escrow settles on the ruling in the same call."
basis = "Today either agreement party may resolve (src/modules/service/lx_service_dispute.c:89) and no component settles the linked escrow."
affects = ["0x101B layerxpay service and escrow"]

[decision.25]
title = "Exchange withdrawMargin"
value = "withdrawMargin is kept as an immediate bank release from the caller's margin address to its main address behind a free-margin check."
basis = "The method is live on the exchange precompile today (precompiles/layerxexchange/layerxexchange.go:52)."
affects = ["0x1015 layerxexchange"]

[decision.26]
title = "Signer of the agent-host web payer"
value = "The embedded-wallet attestor set signs for the agent-host web payer, one attestor set for all custody."
basis = "One custody signer set removes a second key system to operate."
affects = ["agentd-host", "embedded wallet attestors", "0x101A payer grants"]

[decision.27]
title = "Typed exact payment at 0x101A"
value = "payExact is a typed send carrying a payment reference and emitting PaymentExact."
basis = "x402 sellers need a payment that carries a reference, and the x402 conformance suite stays unchanged."
affects = ["0x101A layerxledger", "x402 seller"]

[decision.28]
title = "xweb error naming"
value = "Go-origin xweb errors use LXP_XWEB_* names and kernel-origin (origin 2) errors keep kernel codes."
basis = "This follows the LXP_<MODULE>_<NAME> rule of the error registry used for launchpad and exchange."
affects = ["0x1019 xweb"]

[decision.29]
title = "One stream state"
value = "Agent streams 0x0906 keep no store and execute through the layerxpay 0x101B stream keeper."
basis = "One state gives one set of stream semantics (include/layerx/lx_stream.h:26)."
affects = ["0x0906", "0x101B layerxpay"]

[decision.30]
title = "Gas rule across the new precompiles"
value = "Every new precompile charges from a fixed per-method gas table; kernel gas units are not converted."
basis = "The fixed table follows the existing DefaultGasCost pattern (precompiles/common/precompiles.go:286) and keeps gas independent of kernel internals."
affects = ["0x101A", "0x101B", "0x101C", "0x101D", "0x0901-0x0908", "0x1015", "0x1019"]

[decision.31]
title = "computeClearing and scoreBatch ABI form"
value = "0x0902 computeClearing and 0x0904 scoreBatch use the struct ABI (tuple arrays) only, one selector per method."
basis = "No caller uses the parallel-array form."
affects = ["0x0902", "0x0904"]

[decision.32]
title = "submitPrice signer rule"
value = "0x0903 submitPrice admits a price signed by a key in the market's permittedOracleKeys through the caller's 0x1004-bound key with the ed25519 observation signature, the same rule as the exchange oracle push."
basis = "One oracle rule serves 0x0903 and 0x1015 pushOracle, both writing the exchange oracle store (tests/modules/test_oracle_intake.c)."
affects = ["0x0903", "0x1015 oracle store"]

[decision.33]
title = "TEE attestor roots"
value = "0x0907 uses the xweb attestor set as its registered roots."
basis = "One attestor set on chain needs no second registry kept in sync."
affects = ["0x0907", "0x1019 xweb attestor set"]

[decision.34]
title = "TEE signer threshold and key type"
value = "0x0907 verifies threshold signatures, 3 of 5, over secp256k1 attestor keys."
basis = "This matches the deployed attestor keys and the custody signing threshold."
affects = ["0x0907", "embedded wallet attestors"]

[design]
flow = "Wallet, agent or developer client -> unified router -> sequencer (eth_sendRawTransaction) -> execute at receipt on the open block -> WAL group fsync and hot-standby ack -> signed receipt (pax_sequencerReceipt) and pending reads -> block proposed in receipt order with MsgSequenceBatch at tx 0 -> validators check order in ProcessProposal, execute with OCC and commit -> committed receipt and history."
domains = "One execution domain, paxd. The LayerX kernel is folded in: its C modules and the Rust program runtime run inside chain keepers through a cgo lxp_module_ctx shim (decision.1), kernel accounts are derived bank addresses (decision.2), and the kernel daemon, its WAL, replicas, finality and checkpoint anchoring are retired because block commit is finality."
native_constructs = "20 existing constructs and 5 new ones. Existing: bank 0x1001 (send gains the context-hash overload and LayerXReceipt log), wasmd 0x1002, json 0x1003, addr 0x1004 (DID binding, revert reasons), staking 0x1005, gov 0x1006, distribution 0x1007, oracle 0x1008, ibc 0x1009, pointerview 0x100A, pointer 0x100B, solo 0x100C, p256Verify 0x1011, layerxVerify 0x1012 (retired executor), layerxCustody 0x1013 (retired executor), layerxAnchor 0x1014 (retired executor after bond return), layerxExchange 0x1015 (native perps and spot engine), layerxBridge 0x1016, launchpad 0x1017 (per-market fees), feeToken 0x1018, xweb 0x1019 (origin 2 added), plus the modules tokenfactory, evm, layerxgov, feegrant, authz, wasm and the BatchCallAndSponsor contract. New: layerxledger 0x101A (assets, accounts, send, payer grants, draw, payExact), layerxpay 0x101B (escrow, budget, stream, service), layerxauth 0x101C (sessions, capabilities, idempotency index), layerxprograms 0x101D (deploy, upgrade, call, wind-down, sandbox, registry), and modules/sequencer (MsgSequenceBatch, no precompile). The eight agent functions 0x0901-0x0908 are real precompiles (decision.20). Address table, selectors and error registry: contracts/K1-ADDRESS-TABLE.md."
sequencer = "The proposer is the executor: an operator-run primary and hot standby in node/sequencer execute every transaction at receipt on a speculative branch of committed state, return a canonical ProtocolReceipt v2 signed by the ed25519 receipt key, serve pending reads from the open block, and propose blocks containing exactly that sequence; other validators execute and commit. Block time is settlement only. Contract: contracts/K3-SEQUENCER-CONTRACT.md sections (a) to (g)."
fees = "Fees are policy, not security: the EVM minimum gas price is at most 0.067 gwei for the draw sender class (decision.10), SID is self-paid through feeToken 0x1018 at the governed rate with a governance-raised rate age (decision.7), sponsored writes go through the gas station and executeSponsored with one paymaster nonce and DID-keyed budgets (decision.14), paid search is USD 0.001 per request drawn at 0x101A, and the program fee stays on top of gas (decision.9)."
activation = "Activation is a bring-up at the activation height; no account-state migration is required. One height-gated fork switches on modules/sequencer, the leader list and the BeginBlock vote feed (decision.18); new precompile methods are gated per method on the same plan; lx_* ingress switches off at activation and clients use agent-api major 2 with rungs submitted, receipted and committed (decision.17). The activation height and plan name are set at activation rehearsal."
include = "design.body.md"

[execution]
planning_state = "Task completion requires the declared implementation and its verify_cmd evidence at one revision. A specification or task status alone establishes no runtime result."
task_policy = "Read the exact declared source and contract section, keep code that already meets the contract, implement every unmet criterion of the task, then run one bounded qualification pass. Implementation, qualification and activation evidence are recorded separately."
gate_policy = "Every planned gate is implemented by the task that owns its acceptance criteria. A verify_cmd names a target that exists at the revision or is listed in planned_paths with gate_kind planned; unknown, empty or skipped selectors are refused."
candidate_policy = "A passing gate is reused only while its source, inputs, scope and environment stay the same. Aggregate, sanitizer, cluster and activation-rehearsal gates run once per wave on the merged wave revision, not per task."
parallelism = "tasks in the same wave with disjoint touches run in parallel"
privacy = "Credentials, key material, operational inventories and raw execution logs stay in access-controlled storage. Everything in this feature directory is public and is reviewed before publication."
ownership = "every path appears in the touches of exactly one task per wave"
citation_policy = "every do_n names the path:line it changes or reproduces"
requirement_ids = "req.1 to req.12 are the programme requirements. Each feature N below declares its own requirements as req.<N><kkk> (N*1000+k, so req.3007 is requirement 7 of feature 3); a task reqs entry <id>.<a> names acceptance criterion a of that requirement and acceptance.N.k.a is its scenario."

[req.1]
title = "Feature parity on the chain"
ac_1 = "The kernel ledger, asset, escrow, budget, stream and service tests (tests/ledger/test_send.c, tests/modules/test_escrow_dispute.c, tests/modules/test_budget_spend.c, tests/modules/test_stream_settle.c) re-targeted through the cgo shim at layerxledger 0x101A and layerxpay 0x101B give equal result codes and per-account deltas (contracts/K2-LEDGER-AUTH.md section E, contracts/K2-PAY.md section E)."
ac_2 = "The trading payload vectors (tests/fixtures/trading-payloads/vectors.json) and the perps and spot book tests (tests/modules/test_perps_liquidate.c, tests/modules/test_spot_book.c) pass byte-exact through layerxexchange 0x1015, except order ids and launchpad fee counters, which are re-pinned per decision.8 (contracts/K2-EXCHANGE-LAUNCHPAD.md section E)."
ac_3 = "The program tests under tests/programs (test_lifecycle.c, test_call_activity.c, test_winddown.c, test_interface_protocol.c) re-targeted at layerxprograms 0x101D give equal outcomes, fees and event order (contracts/K2-PROGRAMS.md section E)."
ac_4 = "The determinism spike passes: the same block replayed through the shim on every validator build gives identical app hash and per-transaction results, OCC with forced aborts equals sequential execution, and no kernel in-memory state survives between transactions outside the committed store (decision.1)."
ac_5 = "The kernel authority, grant and idempotency tests (tests/state/lxp_test_grants.c, tests/state/lxp_test_idempotency.c) re-targeted at layerxauth 0x101C give the same outcome for each of the eight authority kinds (include/layerx/lxp_authority.h:11-19; contracts/K2-LEDGER-AUTH.md precompile 2 section E)."
ac_6 = "The kernel root replay golden (tests/replay/lxp_test_golden_replay.c:7) is retired and replaced by the per-module goldens above; no feature golden is dropped without a chain-side replacement."

[req.2]
title = "Native AI, trading and markets"
ac_1 = "Perps and spot markets execute on chain in layerxexchange 0x1015: placeOrder and cancelOrder execute in the engine instead of recording an intent, cancelOrder checks the order's owning account, and margin moves in-transaction through bank instead of custody (modules/layerxexchange/keeper/intents.go:63, :153; contracts/K2-EXCHANGE-LAUNCHPAD.md section A rows E1 to E5)."
ac_2 = "Every chain user trades from its own derived margin account (decision.2), and withdrawMargin releases free margin to the caller's main address in one call (decision.25)."
ac_3 = "Launchpad buy and sell write a per-market protocol fee counter, getProtocolFees(address) reads it, and swaps on different markets do not share a written key under OCC (modules/launchpad/keeper/swap.go:172; contracts/K2-EXCHANGE-LAUNCHPAD.md section A launchpad rows)."
ac_4 = "A perps keeper service ticks funding per funding interval and liquidates a position below maintenance within one receipt round through fundingTick, liquidate and adl at 0x1015 (contracts/K5-SERVICE-CONTRACTS.md S20; agent/sdk/typescript/src/perps.ts:24)."
ac_5 = "The interpreter, compute-lease market and AI market guests are deployed through MsgDeploy at the activation height with their expected code hashes and pass their crate tests against layerxprograms (programs/crates/layerx-programs-ai-market/src/lib.rs, programs/crates/layerx-programs-market/src/lib.rs; decision.13)."
ac_6 = "The AI worker, evaluator and price feeder services commit through layerxprograms and layerxexchange calls signed by their 0x1004-bound keys (contracts/K5-SERVICE-CONTRACTS.md S19, S21, S23)."
ac_7 = "Launchpad serves a price history query beside the holding history of modules/launchpad/keeper/history.go:32 with swap semantics unchanged (contracts/K2-EXCHANGE-LAUNCHPAD.md section A)."

[req.3]
title = "The proposer is the executor"
ac_1 = "eth_sendRawTransaction on the sequencer executes an executable transaction in receipt order, fsyncs the WAL and receives the standby ack before returning, and pax_sequencerReceipt returns the canonical signed receipt (contracts/K3-SEQUENCER-CONTRACT.md (a1), (b1), (e2); today rpc/send.go:76 returns the hash only)."
ac_2 = "Pending-tag reads (eth_call, eth_getBalance, eth_getTransactionCount, eth_getLogs) on the sequencer answer from the open block, and every other node answers -32000 pending served by sequencer instead of mapping pending to latest (rpc/utils.go:66; contracts/K3-SEQUENCER-CONTRACT.md (b2))."
ac_3 = "From the activation height every block carries MsgSequenceBatch at tx 0, and ProcessProposal refuses any block whose order, seq continuity, txRoot, seqHash or batch signature differ from the sealed sequence (consensus/internal/state/execution.go:101, :126; contracts/K3-SEQUENCER-CONTRACT.md (c2), (c3))."
ac_4 = "Leader() follows the pinned primary and standby list from the activation height, and BeginBlock(N+1) receives the votes of N-1 with no height counted twice (consensus/internal/consensus/types/round_state.go:422; node/legacyabci/begin_block.go:61; contracts/K3-SEQUENCER-CONTRACT.md (c3))."
ac_5 = "The header time of a sequenced block equals the open time of its pending block, which equals the signed receipt timestamp (consensus/internal/state/state.go:279; contracts/K3-SEQUENCER-CONTRACT.md (a1) field 26)."
ac_6 = "The strictly sequential executor and the OCC micro-batch executor give byte-identical receipts and equal state hashes for the same seq order, and validators' OCC execution of the sealed block gives the same app hash and receipt fields except blockHash (node/abci.go:169, :230; contracts/K3-SEQUENCER-CONTRACT.md (d))."
ac_7 = "After a primary stop the standby proposes the replicated WAL slice at round 1 with receipts unchanged, and a send without the standby ack returns an error and no receipt (contracts/K3-SEQUENCER-CONTRACT.md (c4), (e3), (e4))."
ac_8 = "Block pruning runs outside the block apply path so prune time is not added to block time (consensus/internal/state/execution.go:418)."

[req.4]
title = "Ledger, payments and authorization constructs"
ac_1 = "layerxledger 0x101A serves register, pause, unpause, openAccount, send, draw, payExact, issueGrant, revokeGrant, mint and burn with the views of its contract, and a paused asset refuses writes and serves reads (contracts/K2-LEDGER-AUTH.md precompile 1 sections A and B)."
ac_2 = "A replayed idempotency key returns LXP_IDEMPOTENT_REPLAY with the first result readable through resultByIdempotency, and idempotency entries carry an expiry so the store never fills (src/state/lxp_idempotency.c:107; contracts/K4-CLIENT-CONTRACT.md (e) V9)."
ac_3 = "layerxpay 0x101B serves the escrow, budget, stream and service families, and budget delegate spend and pull are reachable through their own activity types (src/modules/budget/lx_budget_delegate.c:101, :146; contracts/K2-PAY.md sections A.1 to A.4)."
ac_4 = "A service dispute is resolved only by the linked escrow's arbiter and settles the escrow in the same call; a party resolving is refused with LXP_UNAUTHORIZED_ARBITER (src/modules/service/lx_service_dispute.c:89; tests/modules/test_service_dispute.c:488; contracts/K2-PAY.md section A.6)."
ac_5 = "Tool-execution attestation compares the payload against the attested activity rather than the activity that carries it, so a real attestation is admitted (src/modules/service/lx_service_module.c:205; contracts/K2-PAY.md section A.4)."
ac_6 = "layerxauth 0x101C issues and revokes session and capability grants as authz LayerX-scope Authorizations, and every write precompile resolves the sender to the granting DID before execute (contracts/K2-LEDGER-AUTH.md precompile 2 sections A and D; decision.3)."
ac_7 = "bank 0x1001 send with a context hash emits LayerXReceipt, and addr 0x1004 and bank 0x1001 revert with Error(string) LXP_<code> from the activation plan (precompiles/common/precompiles.go:166; contracts/K2-LEDGER-AUTH.md section 0-B; decision.23)."

[req.5]
title = "Programs and program web requests"
ac_1 = "layerxprograms 0x101D serves deploy, upgrade, call, simulateCall, transfer, registerAccount, the wind-down and sandbox families and retireStorage, each upgrade and call carrying a trailing feeLimit (contracts/K2-PROGRAMS.md sections A and B)."
ac_2 = "retireStorage stages its retirement profile and completes a storage retirement signed by the controller (src/modules/programs/blob_lifecycle.c:378; contracts/K2-PROGRAMS.md section A)."
ac_3 = "The program fee (metering times prices) is charged on top of gas and quoteCallFee returns it before the call (decision.9; tests/programs/test_fee_governance.c; contracts/K2-PROGRAMS.md section B)."
ac_4 = "A program web request is recorded through the xweb keeper RequestFromProgram, fulfilled with fulfilProgram by at most 16 signers of the single xweb attestor set under the kernel network id, and read back with getProgramResult (include/layerx/lx_web.h:29; contracts/K2-XWEB.md section A rows A9 to A12)."
ac_5 = "Origin-2 fees follow the per-asset table with no refund, and refund of an origin-2 id returns LXP_XWEB_UNKNOWN_REQUEST while origin-1 refund is unchanged (src/modules/web/lx_web_intake.c:510; contracts/K2-XWEB.md section A row A3; decision.11)."
ac_6 = "The xweb attestor registration cap is 16 for both origins and MsgPause stops both origins (modules/xweb/types/keys.go:21; contracts/K2-XWEB.md section A rows A4 and A8)."

[req.6]
title = "Agent functions"
ac_1 = "0x0901 to 0x0908 are registered precompiles, so a call reaches an executor and never returns empty success (precompiles/setup.go:67; human/wallet/gateway/src/precompiles.ts:18-25)."
ac_2 = "orob, clearing, oracle and pofq at 0x0901 to 0x0904 implement the methods of contracts/K2-AGENT.md section A.1, with computeClearing and scoreBatch on the struct ABI only (decision.31)."
ac_3 = "0x0903 submitPrice writes and getValidatorPrice reads the 0x1015 exchange oracle store under the market permittedOracleKeys rule (decision.32; contracts/K2-AGENT.md section B)."
ac_4 = "0x0905 scheduler runs jobs in receipt order, 0x0906 streams execute through the 0x101B stream keeper with no store of their own, and 0x0908 hashes and recovers EIP-712 data per the gateway ABIs (human/wallet/gateway/src/routes/agentPrecompiles.ts:67; contracts/K2-PAY.md section A.7)."
ac_5 = "0x0907 verifies attestations against the xweb attestor set as roots with a 3 of 5 secp256k1 threshold (decision.33, decision.34; contracts/K2-AGENT.md section B)."
ac_6 = "Every agent-function error is Error(string) with an LXP_AGENT_* code and every method charges its fixed gas from contracts/K2-AGENT.md section D2 (decision.30)."

[req.7]
title = "Fee policy and gas"
ac_1 = "The EVM minimum gas price is set to at most 0.067 gwei by the evm params change, down from the 1 gwei default (modules/evm/types/params.go:52; contracts/K3-SEQUENCER-CONTRACT.md (f))."
ac_2 = "The sequencer applies its configured floor to Cosmos transactions before Accept, since deliver mode skips the CheckTx floor check (sdk/x/auth/ante/validator_tx_fee.go:33; daemon/paxd/cmd/root.go:397)."
ac_3 = "SID self-pay through feeToken 0x1018 charges at the governed rate of 3.114 SID per PAX, and MaxFeeTokenRateAge is raised by governance so a governance-paced rate stays fresh (modules/evm/types/params.go:36, :39; modules/evm/keeper/params.go:310; modules/evm/keeper/feetoken.go:92)."
ac_4 = "Every sponsored write is a type-4 transaction calling executeSponsored with one paymaster nonce, and the gas station enforces per-DID budgets resolved through addr 0x1004 getLayerXDid before signing a quote (contracts/src/BatchCallAndSponsor.sol:135; interop/crates/layerx-gas-station/src/policy.rs:98; precompiles/addr/addr.go:40)."
ac_5 = "The gas station refuses quotes when it is down or a budget is exhausted, records the DID in each quote record, and no longer sends same-nonce replacement transactions (interop/crates/layerx-gas-station/src/journal.rs:87; interop/crates/layerx-gas-station/src/station.rs:391)."
ac_6 = "Every new precompile method charges from its fixed per-method gas table (precompiles/common/precompiles.go:286; decision.30)."

[req.8]
title = "Activation and retirement"
ac_1 = "Activation is a bring-up at the activation height; no account-state migration is required: one plan gates modules/sequencer, the leader list and every new precompile method per height (modules/layerxcustody/keeper/keeper.go:42; contracts/K1-ADDRESS-TABLE.md section (c))."
ac_2 = "The activation handler returns every posted guarantor bond and open challenge deposit, and the sum returned equals the anchor module balance (precompiles/layerxanchor/layerxanchor.go:230-232; decision.4)."
ac_3 = "Every retired method of layerxVerify 0x1012, layerxCustody 0x1013 and layerxAnchor 0x1014 returns Error(string) LXP_MODULE_DISABLED at the plan height, and the addresses stay registered (precompiles/setup.go:83; node/upgrades.go:401-406)."
ac_4 = "layerxAnchor reads are served until bond return completes, then the store is deleted and the reads also return LXP_MODULE_DISABLED (decision.21; contracts/K1-ADDRESS-TABLE.md section (a) 0x1014 row)."
ac_5 = "The three reference guests are deployed through MsgDeploy at the activation height with expected code hashes (decision.13)."
ac_6 = "Retired components that joined two domains have no live caller left: the intent ingester, the kernel daemon finality path and the anchor-reading mirror input are removed after their replacements land (interop/crates/layerx-intent-ingester/src/submit.rs:64; interop/crates/layerx-mirror/src/node.rs:544)."
ac_7 = "Kernel governance halt and resume are replaced by per-module Paused params on layerxledger, layerxpay, layerxexchange and layerxprograms, set through governance (src/modules/governance/lxp_emergency.c:73)."

[req.9]
title = "Off-chain services re-pointed to chain state"
ac_1 = "The unified router sends pending-tag calls and pax_sequencerReceipt to the sequencer and serves px_* answers from chain state without custody or anchor joins (contracts/K5-SERVICE-CONTRACTS.md S03)."
ac_2 = "The authority service, indexer and x402 seller verify sequencer receipts against the pinned receipt key list instead of kernel checkpoints (platform/hosted/authority/src/main.rs:307; platform/hosted/authority/src/trust.rs:14; platform/hosted/indexer/src/settlement.rs:15; contracts/K5-SERVICE-CONTRACTS.md S06, S08, S14)."
ac_3 = "The paid web sidecar draws payment at 0x101A through the sequencer with receipt before release, fulfils origin 1 and origin 2, and its fee is set from the governed PAX price rather than a fixed constant (interop/crates/x-websearch/src/payment.rs:7; tools/bringup/xweb-config.sh:145; contracts/K5-SERVICE-CONTRACTS.md S15)."
ac_4 = "The xweb default fee is set at activation to USD 0.001 in base units instead of the 1 PAX default (modules/xweb/types/state.go:78; decision.10)."
ac_5 = "The program registry service reads the programs module through its query service instead of the in-process protocol adapter (platform/hosted/registry/src/program_state.rs:5; contracts/K5-SERVICE-CONTRACTS.md S10)."
ac_6 = "The gas station deploy template names the paymaster address and the rollout controller authenticates to the image registry before pulls (interop/deploy/gas-station/railway.env.example:21; tools/rollout/rollout.py:14; contracts/K5-SERVICE-CONTRACTS.md S11, S35)."
ac_7 = "Monitoring alerts on sequencer readiness, receipt seq versus committed index divergence, WAL fsync latency and standby ack lag in place of the kernel readiness alert (tools/ops/monitoring/rules.yml:56; contracts/K5-SERVICE-CONTRACTS.md S01, S34)."
ac_8 = "The core boundary, webhooks, interop service, bridge relayer and ai-artifacts services take finality from block commit, state proofs and signed sequencer receipts instead of kernel checkpoints and the LNI (platform/hosted/ai-artifacts/src/retention.rs:46; platform/hosted/webhooks/src/ai_market.rs:20; interop/crates/layerx-interop-service/src/server.rs:2526; precompiles/layerxbridge/layerxbridge.go:41; docs/off-chain-services.md)."

[req.10]
title = "Clients and status rungs"
ac_1 = "agent-api major 2 replaces major 1 and its goldens are regenerated for the 65-byte signature, rungs and cursor format (agent/schema/agent-api/v1.kvx:3; contracts/K4-CLIENT-CONTRACT.md (e) C1)."
ac_2 = "Clients report only the rungs submitted, receipted and committed with the definitions of contracts/K4-CLIENT-CONTRACT.md (a), replacing instant, sealed and final in the wallet and explorer status UIs (human/wallet/sdk/src/ladder.ts:4; explorer/frontend/types/api/paxeerXLists.ts:1; agent/crates/layerx-agent-api/src/error.rs:131)."
ac_3 = "Every lx_* name on the gateway answers -32601 at activation and each caller moves to its major-2 replacement (platform/hosted/gateway/src/rpc.rs:341; contracts/K4-CLIENT-CONTRACT.md (d))."
ac_4 = "SDK and agentd verifiers hold a rung only after the receipt checks R1 to R8 pass against the pinned receipt key list (agent/crates/layerx-proof/src/receipt.rs:631; contracts/K4-CLIENT-CONTRACT.md (c))."
ac_5 = "The CLI allowlist admits the eth_* and major-2 names so wallet derive --bind completes, the Python SDK gains a transport for bind transactions, and the Python xweb call matches the PrecompileCall type (platform/cli/src/rpc.rs:172; agent/sdk/python/layerx_sdk/account_derivation.py:523; agent/sdk/python/layerx_sdk/exchange.py:162)."
ac_6 = "agentd session.open and agent.register complete, issuing the layerxauth grant on open (agent/crates/layerx-agentd/src/agent_rpc.rs:759; contracts/K4-CLIENT-CONTRACT.md (a))."
ac_7 = "The portable receipt moves to format layerx-receipt-proof-v2 carrying the signed receipt, receipt key and, at committed, the header, inclusion proof, commit and validator set (interop/crates/layerx-portable/src/receipt.rs:11; contracts/K4-CLIENT-CONTRACT.md (c))."
ac_8 = "The human KMS signs EVM actions with the attestor-sharded secp256k1 key and keeps ed25519 for bindLayerX, DID proofs and payment grants (human/crates/layerx-human-kms/src/evm.rs:178; human/crates/layerx-human-kms/src/attestor.rs:505), and the wallet attestor decode policy covers 0x101A-0x101D and 0x1015 (human/wallet/attestor/internal/policy/evm/decode.go)."

[req.11]
title = "Required changes to today's code"
ac_1 = "Exchange cancelOrder checks that the caller owns the order (modules/layerxexchange/keeper/intents.go:153)."
ac_2 = "Exchange margin deposits reach trading margin in the same transaction instead of custody escrow (modules/layerxexchange/keeper/intents.go:57-63)."
ac_3 = "Idempotency entries carry an expiry and are removed after it, so the store stays below its capacity (src/state/lxp_idempotency.c:107)."
ac_4 = "Budget delegate spend and pull have their own activity types and are reachable (src/modules/budget/lx_budget_delegate.c:101, :146)."
ac_5 = "Tool-execution attestation is admitted for a real activity (src/modules/service/lx_service_module.c:205)."
ac_6 = "The storage retirement profile is staged so retireStorage completes (src/modules/programs/blob_lifecycle.c:378)."
ac_7 = "The gateway wallet sponsorship route enforces per-identity budgets (human/wallet/gateway/src/routes/wallet.ts:192)."
ac_8 = "The sequencer read context is the open block, not the check context (contracts/K3-SEQUENCER-CONTRACT.md (d) ante read context row)."
ac_9 = "The kernel stream module has a rate-change activity type that settles accrual at the old rate before the new rate applies, so 0x0906 updateRate executes through the 0x101B stream keeper (include/layerx/lx_stream.h:26-32; src/modules/stream/lx_stream_settle.c:95)."

[req.12]
title = "Qualification and evidence"
ac_1 = "Each task's verify_cmd passes once at the task revision and its evidence is recorded as revision, command, exit code and log path."
ac_2 = "The receipt vectors V1 to V9 of contracts/K4-CLIENT-CONTRACT.md (e) pass in every SDK that verifies receipts."
ac_3 = "The x402 conformance suite passes unchanged except the network id, rung names and transaction hash fields (interop/specs/conformance/x402/payment-payload.json; contracts/K4-CLIENT-CONTRACT.md (e) C10)."
ac_4 = "An activation rehearsal on a copy of chain state runs the plan at a rehearsal height and passes bond return, retired-method refusals and receipt-order equality between signed receipts and committed blocks (contracts/K3-SEQUENCER-CONTRACT.md (c), (d))."
ac_5 = "The sequential versus micro-batch measurement records throughput and receipt latency p50 and p99 on one workload, and the micro-batch switch is made only when its throughput is higher and its p99 rise stays within the window bound (contracts/K3-SEQUENCER-CONTRACT.md (d))."
ac_6 = "Values set at activation rehearsal (activation height, plan name, minimum gas price, rate age, AI and market height windows, receipt module id, micro-batch bounds) are recorded with the rehearsal evidence before activation."

[feature.1]
name = "kernel-ledger-auth"
scope = "The kernel ledger and authority constructs on the chain: the cgo C-module host shim and its global_sequence source, the kernel account and asset maps, layerxledger 0x101A and layerxauth 0x101C with their modules, the bank 0x1001 context-hash overload and reason path, addr 0x1004 LXP revert reasons, tokenfactory denom pause and issuer DID, module pause routing through layerxgov, idempotency retention on the C and keeper sides, and the exported kernel read helpers."
requirements = ["1001", "1002", "1003", "1004", "1005", "1006", "1007", "1008", "1009", "1010", "1011", "1012", "1013", "1014", "1015", "1016", "1017", "1018", "1019", "1020", "1021", "1022", "1023", "1024", "1025", "1026", "1027", "1028", "1029", "1030", "1031", "1032", "1033", "1034", "1035"]
completion_task = "1.7.1"

[req.1001]
title = "cgo C-module host shim inside the chain binary"
ac_1 = "The shim links the static kernel library produced by the Makefile build target (Makefile:210) through a cgo directive and build tag, following wasm-runtime/internal/api/link_system.go:5-6 and wasm-runtime/version_cgo.go:1."
ac_2 = "Every lxp_module_ctx call a C module makes during one activity (include/layerx/lxp_module.h:105-174) reads and writes the branch store of the executing transaction; no kernel in-memory state survives from one transaction to the next."
ac_3 = "Two independent builds executing the same block produce the same app hash, and the C program goldens executed through programs_execute (src/modules/programs/registration.c:164) are byte-exact through the shim."
ac_4 = "The shim passes no wall-clock, allocator address, thread identity or floating-point value into the kernel: the batch timestamp is the block time in milliseconds and the global sequence is the transaction sequence (include/layerx/lxp_module.h:154)."
ac_5 = "Optimistic concurrent execution with forced aborts yields the same results as sequential execution, following the pattern of occ_tests/occ_test.go:108."

[req.1002]
title = "global_sequence source for kernel activities"
ac_1 = "lxp_ctx_global_sequence (include/layerx/lxp_module.h:154, implemented at src/protocol/lxp_module_ctx.c:3162-3165) returns the sequencer sequence of the executing transaction, which the shim writes before every kernel call."
ac_2 = "The journal global_sequence (include/layerx/lxp_state.h:52) equals the same value when an idempotency entry is recorded, so retention counts in sequence units."
ac_3 = "The shim refuses to execute a transaction whose sequence is not greater than the last committed sequence, returning LXP_SEQUENCE_REUSED (include/layerx/lxp_result.h:72)."
ac_4 = "The batch timestamp the shim passes is the block-open time in milliseconds, so grant expiry checks against lxp_ctx_batch_timestamp_ms (src/modules/governance/lxp_governance.c:513) and send expiry (src/ledger/lxp_send.c:265) use block time on every node."

[req.1003]
title = "Kernel account map: ids, names and the derived bank address"
ac_1 = "The main account id H(\"LX:ACCOUNT:v1\" || u32be(len) || \"agent:<did>:main\") from LayerXMainAccountID (modules/evm/types/layerx_binding.go:69) equals lx_account_id_from_string (src/ledger/lx_account_id.c:196-226) for every fixed vector."
ac_2 = "The asset sub-account name \"agent:<did>:asset:<hex64 assetId>\" derives through codec.DeriveAccountID (layerxproof/codec/state.go:360) to the id the kernel stages at src/protocol/lxp_module_ctx.c:654-664."
ac_3 = "The issuance account of an asset uses the MODULE_VALUE path: the name is built by lx_asset_issuance_name (src/ledger/lx_account_id.c:228-256) and its id decodes from hex directly (src/ledger/lx_account_id.c:208-215, layerxproof/codec/state.go:366-371)."
ac_4 = "The bank address of every kernel account is address.Module(\"layerx\", accountId) (sdk/types/address/hash.go:63-66), decision D2 A."
ac_5 = "The holder DID of an agent account is read through lx_account_owner_did (src/ledger/lx_account_read.c:6-37): \":main\" and \":asset:\" names resolve, any other kind is refused."

[req.1004]
title = "Kernel asset map between asset ids and bank denoms"
ac_1 = "GetAssetByDenom (modules/layerxcustody/keeper/keeper.go:183) and GetAssetByPointer (modules/layerxcustody/keeper/keeper.go:172) map PAX, SID, USDC and USDL to their 32-byte asset ids and the map round-trips."
ac_2 = "A denom absent from the map is refused with LXP_ASSET_MISMATCH (include/layerx/lxp_result.h:81), the code asset_load returns for an unknown asset (src/modules/asset/lx_asset_execution.h:10-26)."
ac_3 = "For a mapped asset id the paused flag and the circulating units are read through lx_asset_lookup (include/layerx/lx_asset.h:242) and lx_asset_total_units (include/layerx/lx_asset.h:273), never from raw kernel keys."
ac_4 = "The asset map keeps the kernel fee ordinal order of asset_ordinals (src/protocol/lxp_fee.c:7), so a denom maps to the same fee ordinal on the Go and C sides."

[req.1005]
title = "addr 0x1004 revert reasons from the merge plan height"
ac_1 = "From the merge plan height addr 0x1004 opts into the reason path of the dynamic-gas base (precompiles/addr/addr.go:123, precompiles/common/precompiles.go:177-185): getLayerXDid of an unbound address returns Error(string) beginning LXP_UNKNOWN_DID (precompiles/addr/addr.go:399-402, include/layerx/lxp_result.h:48)."
ac_2 = "Below the merge plan height the revert data of every addr method stays as it is today: empty return data with vm.ErrExecutionReverted (precompiles/common/precompiles.go:179-185)."
ac_3 = "Binding failures map to kernel codes: ErrLayerXSignature and ErrLayerXSignatureLength to LXP_BAD_SIGNATURE, ErrLayerXAddressBound and ErrLayerXDidBound to LXP_DUPLICATE_ENTRY, ErrLayerXNonceExhausted to LXP_SEQUENCE_EXHAUSTED, ErrLayerXNonCanonicalKey and ErrLayerXChainID to LXP_NON_CANONICAL (modules/evm/types/layerx_binding.go:28-37)."
ac_4 = "addr gains no key rotation or recovery method; the method set dispatched at precompiles/addr/addr.go:141-180 is unchanged, rotation and recovery being out of scope for this feature (decision D16)."
ac_5 = "Bind and unbind logs keep their shape (emitLayerXEvent, precompiles/addr/addr.go:382-389) at and above the merge plan height; only revert data changes."

[req.1006]
title = "bank 0x1001 context-hash send overload"
ac_1 = "send(address,address,string,uint256,bytes32) with selector 0x2e4c85ac runs the checks of the four-argument send: staticcall refused (precompiles/bank/bank.go:135-137), payable refused (precompiles/bank/bank.go:138-140), empty denom refused (precompiles/bank/bank.go:145-148), caller must be the denom's ERC20 native pointer (precompiles/bank/bank.go:149-152)."
ac_2 = "An amount of zero short-circuits to true with no transfer and no log, as the four-argument send does at precompiles/bank/bank.go:154-158."
ac_3 = "A nonzero overload call moves the coins through the bank MsgSend path (precompiles/bank/bank.go:168-181) and then emits LayerXReceipt with topic0 0x4b11729a809ec729868d9ba54f3192aa4179fe63668e9f742aa9b25de21de65f, from and to indexed, denom, amount and contextHash in data."
ac_4 = "The four-argument send (selector 0x5c05961b, precompiles/bank/Bank.sol:12-17) is unchanged and still emits no log."
ac_5 = "go-ethereum names the overloaded ABI method send0; NewPrecompile records its id in the method loop (precompiles/bank/bank.go:77-96) and the Execute switch (precompiles/bank/bank.go:106-132) routes it to the overload."

[req.1007]
title = "bank 0x1001 unified-account balances and revert reasons"
ac_1 = "A derived sub-account address address.Module(\"layerx\", id) holds bank balances and sends through MsgSend with no bank-side refusal beyond the existing checks (sdk/x/bank/keeper/msg_server.go:28-60), decision D2 A."
ac_2 = "From the merge plan height bank 0x1001 opts into the reason path (precompiles/bank/bank.go:98, precompiles/common/precompiles.go:53-66) and reverts with Error(string) \"LXP_<CODE>: <message>\"; below it the revert bytes are unchanged."
ac_3 = "A send of a paused tokenfactory denom is refused by IsSendEnabledCoins (sdk/x/bank/keeper/msg_server.go:34) and the bank precompile reports LXP_ASSET_PAUSED (include/layerx/lxp_result.h:82)."

[req.1008]
title = "tokenfactory denom pause"
ac_1 = "MsgSetDenomPaused(sender, denom, paused) is added beside SetDenomMetadata (modules/tokenfactory/keeper/msg_server.go:188, api/tokenfactory/tx.proto:12-17); only the denom admin read by GetAuthorityMetadata (modules/tokenfactory/keeper/admins.go:11-20) may sign, any other sender gets ErrUnauthorized (modules/tokenfactory/types/errors.go:14)."
ac_2 = "A paused denom refuses mint (modules/tokenfactory/keeper/bankactions.go:11) and burn (modules/tokenfactory/keeper/bankactions.go:35) with ErrDenomPaused whose text begins LXP_ASSET_PAUSED."
ac_3 = "A paused denom refuses every bank transfer through IsSendEnabledCoin (sdk/x/bank/keeper/send.go:366-368), which consults the tokenfactory pause state."
ac_4 = "Setting the paused flag to its current value is refused with LXP_PAUSED_SCOPE, matching the kernel rule at src/modules/asset/lx_asset_execution.h:243."
ac_5 = "The pause and unpause outcomes reproduce the kernel PAUSE and UNPAUSE branch (src/modules/asset/lx_asset_execution.h:235-248) recorded in the supply-pause and supply-unpause receipt fixtures."

[req.1009]
title = "tokenfactory issuer DID on the denom authority metadata"
ac_1 = "DenomAuthorityMetadata (api/tokenfactory/authority_metadata.proto:11-16) gains issuer_did as field 2; Validate accepts an empty value or the did:layerx: prefix (modules/evm/types/layerx_binding.go:21) followed by 64 lowercase hex characters."
ac_2 = "A layerxledger register binds the created denom to the registering DID, the same value the kernel stores as issuer_did32 (src/modules/asset/lx_asset_execution.h:216)."
ac_3 = "ChangeAdmin (modules/tokenfactory/keeper/msg_server.go:156) leaves issuer_did unchanged; pause, unpause and mint authority on 0x101A compare the caller DID with the stored issuer (src/modules/asset/lx_asset_execution.h:241-242, src/modules/asset/lx_asset_execution.h:297)."
ac_4 = "Every existing denom decodes with an empty issuer_did and keeps its admin (modules/tokenfactory/keeper/admins.go:11-20)."

[req.1010]
title = "layerxledger shared rules: caller, authority, pause and error form"
ac_1 = "Every 0x101A method resolves the caller to its DID through the 0x1004 binding read GetLayerXDid (modules/evm/keeper/layerx_binding.go:18-26); an unbound caller reverts LXP_UNAUTHORIZED_DEBIT."
ac_2 = "The precompile builds the account-holder authority kind (LXP_AUTHORITY_OWNER, include/layerx/lxp_authority.h:12): verified key = bound DID key, actor = lxp_did_id_derive (src/state/lxp_identity.c:46-56), principal = account id; the kernel checks it at src/modules/asset/lx_asset_execution.h:175-182."
ac_3 = "An authz grantee is refused on every layerxledger method with LXP_UNAUTHORIZED_DEBIT, because the kernel requires the account-holder kind (src/modules/asset/lx_asset_registry.c:147)."
ac_4 = "Params.Paused refuses every 0x101A write with LXP_PAUSED_SCOPE (include/layerx/lxp_result.h:140) while views keep answering."
ac_5 = "Errors are Error(string) \"LXP_<CODE>\" where CODE is the lxp_result_name (src/protocol/lxp_result.c:3) text with its ERR_ prefix removed; LXP_FATAL_SUPPLY_MISMATCH keeps its full name."
ac_6 = "Keyed writes consult the shared IdempotencyIndex before execute and record the key only after success, mirroring the kernel order at src/protocol/lxp_kernel.c:3516 and src/protocol/lxp_kernel.c:3227."

[req.1011]
title = "layerxledger register, pause and unpause"
ac_1 = "register refuses an existing asset id with LXP_ASSET_ALREADY_REGISTERED (src/modules/asset/lx_asset_execution.h:192), a full registry with LXP_ARENA_EXHAUSTED (src/modules/asset/lx_asset_execution.h:204) and an asset id that is not the derived hash with LXP_ASSET_MISMATCH (src/modules/asset/lx_asset_execution.h:229)."
ac_2 = "register stages the issuance account (src/protocol/lxp_module_ctx.c:565-615, initial cap at src/protocol/lxp_module_ctx.c:604-605), creates the tokenfactory denom and emits AssetRegistered (kernel event 1, src/modules/asset/lx_asset_execution.h:233)."
ac_3 = "pause and unpause are allowed only for the asset issuer (src/modules/asset/lx_asset_execution.h:241-242) and refuse a repeat of the current state with LXP_PAUSED_SCOPE (src/modules/asset/lx_asset_execution.h:243); success emits kernel event 2 or 3 (src/modules/asset/lx_asset_execution.h:247)."
ac_4 = "Payloads follow the kernel decode rules: register at src/modules/asset/lx_asset_decode.c:38-82 and the 34-byte pause payload at src/modules/asset/lx_asset_registry.c:33-40."

[req.1012]
title = "layerxledger openAccount"
ac_1 = "openAccount returns the id of \"agent:<did>:asset:<hex64 assetId>\" staged at src/protocol/lxp_module_ctx.c:654-664 with kind AGENT_ASSET (src/protocol/lxp_module_ctx.c:665, include/layerx/lxp_ledger.h:20-35)."
ac_2 = "openAccount on a paused asset reverts LXP_ASSET_PAUSED (src/modules/asset/lx_asset_execution.h:252)."
ac_3 = "Ledger admission records the principal sequence before the open, as src/protocol/lxp_kernel.c:463-471 does for ACCOUNT_OPEN."
ac_4 = "Success emits AccountOpened (kernel event 4, src/modules/asset/lx_asset_execution.h:254); an open that names another holder's account reverts LXP_UNAUTHORIZED_DEBIT (src/protocol/lxp_module_ctx.c:644)."

[req.1013]
title = "layerxledger send with the kernel send envelope"
ac_1 = "send(bytes) decodes the kernel send wire with lxp_send_decode and refuses a malformed envelope with LXP_MALFORMED_SEND (src/ledger/lxp_send.c:180-230)."
ac_2 = "Validation keeps the kernel order: authority kind (src/ledger/lxp_send.c:253-255), debit authority (src/ledger/lxp_send.c:257-262), LXP_SEQUENCE_EXHAUSTED (src/ledger/lxp_send.c:263), LXP_SEQUENCE_MISMATCH (src/ledger/lxp_send.c:264), LXP_EXPIRED (src/ledger/lxp_send.c:265), conditions (src/ledger/lxp_send.c:266-275), LXP_CONTEXT_MISMATCH (src/ledger/lxp_send.c:276-277)."
ac_3 = "The envelope ed25519 signature (src/ledger/lxp_send.c:281-285) and the activity signature (src/modules/asset/lx_asset_execution.h:184) are not verified on the EVM path; the 0x1004 binding substitutes for them (D-4)."
ac_4 = "The source account must be the caller's main account or its asset sub-account (source_matches_actor, src/modules/asset/lx_asset_registry.c:66-99, validate_send at src/modules/asset/lx_asset_registry.c:119-183)."
ac_5 = "A replayed idempotency key returns LXP_IDEMPOTENT_REPLAY with the stored receipt (src/state/lxp_idempotency.c:33-59, src/ledger/lxp_apply.c:323) through the shared IdempotencyIndex."
ac_6 = "Each applied leg emits Transfer (src/modules/asset/lx_asset_transfer.c:51) and moves the bank coins between the D2 addresses of the two accounts."
ac_7 = "Each send condition is evaluated in order and an unmet one refuses the send (src/ledger/lxp_send.c:266-275) before any leg moves."
ac_8 = "A context hash that differs from the signed context hash refuses the send with LXP_CONTEXT_MISMATCH (src/ledger/lxp_send.c:276-277, include/layerx/lxp_result.h:61)."

[req.1014]
title = "layerxledger draw against a payer grant"
ac_1 = "draw refuses an unknown grant with LXP_NO_PAYER_GRANT (src/ledger/lxp_receive.c:415), a revoked grant with LXP_GRANT_REVOKED (src/ledger/lxp_receive.c:419-420) and an expired grant with LXP_GRANT_EXPIRED (src/ledger/lxp_receive.c:421-422)."
ac_2 = "receiverSequence must equal the recipient next_sequence (src/ledger/lxp_receive.c:350-352) and the recipient must be the caller's account (src/modules/asset/lx_asset_execution.h:334-336)."
ac_3 = "Amount rules follow lxp_grant_draw_record: zero refused with LXP_ZERO_AMOUNT (src/ledger/lxp_grant_store.c:130) and allowance or period exhaustion with LXP_GRANT_EXHAUSTED (src/ledger/lxp_grant_store.c:132, src/ledger/lxp_grant_store.c:146, src/ledger/lxp_grant_store.c:150)."
ac_4 = "The purpose check refuses a settled invoice with LXP_INVOICE_ALREADY_SETTLED and a wrong context hash with LXP_PURPOSE_MISMATCH (src/ledger/lxp_receive.c:365-381)."
ac_5 = "A successful draw records the drawn totals (src/ledger/lxp_receive.c:434), moves one PAYMENT leg (src/modules/asset/lx_asset_execution.h:369-370) and emits PaymentDrawn with grantId, from, to, assetId, amount and contextHash."
ac_6 = "A draw whose grant id, payer, asset or recipient differs from the stored grant is refused with LXP_GRANT_SCOPE_VIOLATION (src/ledger/lxp_receive.c:423-428)."

[req.1015]
title = "layerxledger payExact"
ac_1 = "payExact is a typed send whose idempotency key is paymentReference (include/layerx/lxp_ledger.h:138-150); amount zero is refused with LXP_ZERO_AMOUNT."
ac_2 = "expiresAt earlier than the batch timestamp is refused with LXP_EXPIRED (src/ledger/lxp_send.c:265)."
ac_3 = "A second payExact with the same paymentReference returns LXP_IDEMPOTENT_REPLAY with the first receipt (src/state/lxp_idempotency.c:33-59)."
ac_4 = "Success emits PaymentExact(from, to, paymentReference, assetId, amount) after the transfer leg (src/modules/asset/lx_asset_transfer.c:42-51)."

[req.1016]
title = "layerxledger issueGrant and revokeGrant"
ac_1 = "issueGrant decodes the 395-byte payer grant wire as src/ledger/lxp_receive.c:168-197 and verifies it under the authority hash domain, refusing a bad signature with LXP_BAD_SIGNATURE (src/ledger/lxp_grant_store.c:72-100)."
ac_2 = "A grant id already stored is refused with LXP_SEQUENCE_REUSED (src/modules/asset/lx_asset_execution.h:377), a paused asset with LXP_ASSET_PAUSED (src/modules/asset/lx_asset_execution.h:382) and a grant key other than the caller key with LXP_UNAUTHORIZED_DEBIT (src/modules/asset/lx_asset_execution.h:385-386)."
ac_3 = "revokeGrant requires revocationSequence equal to the activity account sequence, else LXP_STALE_REVOCATION (src/modules/asset/lx_asset_execution.h:403), and the caller to hold the grant source account (src/modules/asset/lx_asset_execution.h:399-401)."
ac_4 = "issueGrant emits PayerGrantIssued (kernel event 7, src/modules/asset/lx_asset_execution.h:392) and revokeGrant emits PayerGrantRevoked (kernel event 8, src/modules/asset/lx_asset_execution.h:407)."

[req.1017]
title = "layerxledger mint, burn and the supply binding"
ac_1 = "mint is allowed only for the asset issuer (src/modules/asset/lx_asset_execution.h:297) and burn only for the holder whose authority key equals the caller key (src/modules/asset/lx_asset_execution.h:299)."
ac_2 = "A mint that would take total units above the initial supply is refused with LXP_INSUFFICIENT_BALANCE (src/modules/asset/lx_asset_execution.h:307)."
ac_3 = "After every asset operation issuance plus total units equals the initial supply, else LXP_FATAL_SUPPLY_MISMATCH (src/protocol/lxp_module_ctx.c:105-132)."
ac_4 = "The bank side mirrors the legs: mint moves coins from the issuance module account to address.Module(\"layerx\", accountId) and burn returns them through the tokenfactory minter path (modules/tokenfactory/keeper/bankactions.go:11, modules/tokenfactory/keeper/bankactions.go:35)."

[req.1018]
title = "layerxledger views"
ac_1 = "getAsset returns the lx_asset_record fields (include/layerx/lx_asset.h:87-103) read through lx_asset_lookup (include/layerx/lx_asset.h:242) and decoded as lx_asset_record_decode (src/modules/asset/lx_asset_registry.c:749-792)."
ac_2 = "balanceOf and totalUnits read lx_asset_balance_get (include/layerx/lx_asset.h:263) and lx_asset_total_units (include/layerx/lx_asset.h:273)."
ac_3 = "accountId returns the main id for a zero assetId and the sub-account id otherwise (src/ledger/lx_account_id.c:196-226); accountOwner returns the holder DID id (src/ledger/lx_account_read.c:6-37)."
ac_4 = "nextSequence(bytes32,bytes32) (selector 0xce2f921f) returns next_sequence of the named account and an unknown account reverts with the lx_account_lookup code (src/ledger/lx_account_registry.c:551-573, LXP_ACCOUNT_ID_MISMATCH at src/ledger/lx_account_registry.c:563-564)."
ac_5 = "getPayerGrant returns the grant bytes and the drawn totals, window start, revocation and invoice state decoded as grant_load (src/modules/asset/lx_asset_execution.h:81-104); an absent grant reverts LXP_NO_PAYER_GRANT (src/modules/asset/lx_asset_execution.h:89)."
ac_6 = "Views do not check Params.Paused or the asset paused flag, so reads answer while writes are refused (src/modules/asset/lx_asset_registry.c:877 keeps the flag in the record only)."

[req.1019]
title = "layerxledger events"
ac_1 = "AssetRegistered, AssetPaused, AssetUnpaused, AccountOpened, PayerGrantIssued and PayerGrantRevoked are emitted from kernel events 1, 2, 3, 4, 7 and 8 (src/modules/asset/lx_asset_execution.h:233, src/modules/asset/lx_asset_execution.h:247, src/modules/asset/lx_asset_execution.h:254, src/modules/asset/lx_asset_execution.h:392, src/modules/asset/lx_asset_execution.h:407)."
ac_2 = "Transfer is emitted once per monetary leg delivered by lxp_ctx_emit_monetary_transfer_set (src/protocol/lxp_module_ctx.c:2187-2214) with from, to, assetId indexed and amount and reason in data."
ac_3 = "PaymentDrawn and PaymentExact are precompile logs with no kernel event constant; their data is read from the applied receive or send (include/layerx/lxp_ledger.h:216-227, include/layerx/lxp_ledger.h:138-150)."
ac_4 = "A refused write emits no log: logs are emitted only after the kernel activity returns LXP_OK (src/protocol/lxp_module_ctx.c:2187-2214)."

[req.1020]
title = "layerxledger fixed per-method gas"
ac_1 = "Writes charge the fixed table: register 18440; pause, unpause and openAccount 3080; send 17480; draw 8840; payExact 7880; issueGrant 16520; revokeGrant 4040; mint and burn 5000, computed with the DefaultGasCost rule (precompiles/common/precompiles.go:286-292)."
ac_2 = "Views charge getAsset 1108, balanceOf 1204, totalUnits 1108, accountId 1204, accountOwner 1108, nextSequence 1204 and getPayerGrant 1108, from the read rule 1000 + 3 x bytes of the KV gas config (sdk/store/types/gas.go:349-358)."
ac_3 = "Kernel gas units (module_validate charges payload length + 1, src/modules/asset/lx_asset_registry.c:424) and fee ordinals are never charged to the EVM caller; the numbers are provisional and set at activation rehearsal."

[req.1021]
title = "layerxauth LayerXScopeAuthorization on authz (decision D3 A)"
ac_1 = "LayerXScopeAuthorization implements authz.Authorization (sdk/x/authz/authorizations.go:11-25) and carries the module mask and activity ordinal range of the kernel scope (include/layerx/lxp_authority.h:27-47)."
ac_2 = "A grant is live only while its stored revocation epoch equals the grantor's current revocation sequence, reproducing lxp_authority_is_live (src/state/lxp_authority.c:1122-1146, LXP_AUTH_REVOKED at src/state/lxp_authority.c:1141-1144)."
ac_3 = "Accept refuses every layerxledger message because the kernel ledger requires the account-holder kind (src/modules/asset/lx_asset_registry.c:147)."
ac_4 = "The grantee address is the 0x1004-bound address of the grantee ed25519 key; an unbound grantee key is refused with LXP_AUTH_SCOPE (precompiles/addr/addr.go:391-405)."
ac_5 = "The authorization is stored through SaveGrant (sdk/x/authz/keeper/keeper.go:136) and executed through DispatchActions (sdk/x/authz/keeper/keeper.go:68), so the authz expiry and pruning rules apply unchanged."

[req.1022]
title = "layerxauth principal resolution for LayerX write precompiles"
ac_1 = "Direct calls resolve the sender to its DID through the 0x1004 binding and build the account-holder authority kind (include/layerx/lxp_authority.h:12)."
ac_2 = "Delegated calls resolve through a live grant: grantor and grantee must equal the DID pair (src/state/lxp_authority.c:780-782) and the grant must be live (src/state/lxp_authority.c:783), as lxp_authority_resolve_activity does (src/state/lxp_authority.c:744-791)."
ac_3 = "A principal that the authority may not debit is refused with LXP_UNAUTHORIZED_DEBIT, as lxp_authority_resolve does (src/state/lxp_authority.c:362-405, src/state/lxp_authority.c:380-381)."
ac_4 = "Scope and debit checks reuse lxp_authority_check_scope (src/state/lxp_authority.c:341-360) and lxp_authority_check_debit (src/state/lxp_authority.c:885-898) through the shim, so Go and C agree on every refusal code."

[req.1023]
title = "layerxauth grantSession and grantSessionSuccessor"
ac_1 = "Sub-op 5 payloads carry 3 fields (session) or 5 fields (successor) and at least 52 bytes (src/modules/governance/lxp_governance.c:168), prefix 0x71 (src/modules/governance/lxp_governance.c:155-161)."
ac_2 = "The grant must be kind SESSION_KEY (src/modules/governance/lxp_governance.c:396), not revoked (src/modules/governance/lxp_governance.c:397), pass the session checks (src/modules/governance/lxp_governance.c:398-406) and re-encode byte-identically, else LXP_NON_CANONICAL (src/modules/governance/lxp_governance.c:421-422)."
ac_3 = "A grant id already stored under key 5 is refused with LXP_SEQUENCE_REUSED (src/modules/governance/lxp_governance.c:423-426)."
ac_4 = "Success stores the body, writes the 209-byte LXGS2 summary at key 0x15 (src/modules/governance/lxp_governance.c:429-445) and emits 0x7145 (src/modules/governance/lxp_governance.c:446) and body chunks 0x7105 / 0x7125 (src/modules/governance/lxp_governance.c:447-451)."
ac_5 = "grantSessionSuccessor inherits the predecessor fee record (src/modules/governance/lxp_governance.c:323-368) and refuses a reused successor key with LXP_SEQUENCE_REUSED (src/modules/governance/lxp_governance.c:357)."

[req.1024]
title = "layerxauth grantCapability"
ac_1 = "grantCapability accepts kind DELEGATED_CAPABILITY or BUDGET_ALLOWANCE only and enforces the grant checks of src/modules/governance/lxp_governance.c:505-516."
ac_2 = "The scope is validated by grant_scope_validate (src/modules/governance/lxp_governance.c:457-490)."
ac_3 = "A grant id already stored is refused with LXP_SEQUENCE_REUSED (src/modules/governance/lxp_governance.c:522-523)."
ac_4 = "Success stores the grant (src/modules/governance/lxp_governance.c:526) and emits 0x7148 (src/modules/governance/lxp_governance.c:527) and the body chunks 0x7108 / 0x7128 (src/modules/governance/lxp_governance.c:528-534)."
ac_5 = "A capability whose not_after is the maximum value or not after the batch timestamp is refused with LXP_AUTH_SCOPE (src/modules/governance/lxp_governance.c:512-513)."
ac_6 = "A capability whose key equals the caller verified key or is not a canonical ed25519 key is refused with LXP_AUTH_SCOPE (src/modules/governance/lxp_governance.c:509-510)."

[req.1025]
title = "layerxauth revokeGrant and the revocation epoch"
ac_1 = "Sub-op 6 payloads carry 3 fields and exactly 45 bytes (src/modules/governance/lxp_governance.c:169)."
ac_2 = "A grant whose grantor is not the actor is refused with LXP_AUTH_SCOPE (src/modules/governance/lxp_governance.c:625-628) and an already revoked grant with LXP_AUTH_REVOKED (src/modules/governance/lxp_governance.c:632)."
ac_3 = "Success writes the 41-byte revocation record under key 6 || grantId (src/modules/governance/lxp_governance.c:633, record tags at src/state/lxp_authority.c:407-414), emits 0x7106 (src/modules/governance/lxp_governance.c:634) and sets identity REVOCATION to the sequence (src/modules/governance/lxp_governance.c:636)."
ac_4 = "After a revoke every earlier grant of the grantor fails isLive with LXP_AUTH_REVOKED (src/state/lxp_authority.c:1141-1144), and the LayerXScopeAuthorization epoch refuses them the same way."
ac_5 = "A revoke reason of 0 or above 5, or a sequence other than the activity sequence, is refused with LXP_AUTH_SCOPE (src/modules/governance/lxp_governance.c:627)."

[req.1026]
title = "layerxauth views"
ac_1 = "resultByIdempotency returns the stored receipt for the actor-scoped key H_context(u32be(len did) || did || key) (src/state/lxp_idempotency.c:8-23, lookup at src/state/lxp_idempotency.c:33-59, kernel read at src/protocol/lxp_kernel.c:7091-7101)."
ac_2 = "getGrant returns the stored encoding and revocation through lxp_authority_grant_lookup and lxp_authority_grant_load (src/state/lxp_authority.c:691-742)."
ac_3 = "isLive returns (false, code) with LXP_NOT_YET_VALID, LXP_AUTH_EXPIRED, LXP_AUTH_NOT_MATURE or LXP_AUTH_REVOKED exactly as lxp_authority_is_live (src/state/lxp_authority.c:1122-1146)."
ac_4 = "sessionKey returns the 209-byte LXGS2 summary through the exported C read helper and capabilityScope returns the scope struct fields (include/layerx/lxp_authority.h:27-47); no Go code reads a raw kernel key."
ac_5 = "checkActivity returns the string code of lxp_authority_resolve (src/state/lxp_authority.c:362-405) and lxp_authority_check_debit (src/state/lxp_authority.c:885-898), or an empty string when allowed."

[req.1027]
title = "layerxauth events"
ac_1 = "SessionGranted carries the 209-byte summary of kernel event 0x7145 (src/modules/governance/lxp_governance.c:446)."
ac_2 = "GrantBody carries each 256-byte chunk of events 0x7105 / 0x7125 (src/modules/governance/lxp_governance.c:447-451) and 0x7108 / 0x7128 (src/modules/governance/lxp_governance.c:528-534) with sub and chunk index."
ac_3 = "CapabilityGranted (0x7148, src/modules/governance/lxp_governance.c:527), GrantRevoked (0x7106, src/modules/governance/lxp_governance.c:634) and IdentityStateUpdated (0x7110, src/modules/governance/lxp_governance.c:640) are emitted from their kernel events."
ac_4 = "A refused auth write emits no log; logs follow only a kernel LXP_OK (src/modules/governance/lxp_governance.c:526-534)."

[req.1028]
title = "layerxauth fixed per-method gas"
ac_1 = "Writes charge grantSession 36680, grantSessionSuccessor 38600, grantCapability 34760 and revokeGrant 5000, computed with the DefaultGasCost rule (precompiles/common/precompiles.go:286-292)."
ac_2 = "Views charge resultByIdempotency 1204, getGrant 1108, isLive 1300, sessionKey 1108, capabilityScope 1108 and checkActivity 1396."
ac_3 = "Governance validate charges payload length as kernel gas (src/modules/governance/lxp_governance.c:249) and the epoch hook is a no-op (src/modules/governance/lxp_governance.c:648-653); neither is charged to the EVM caller."

[req.1029]
title = "Shared IdempotencyIndex keeper"
ac_1 = "The index key is the hash of u32be(len did) || did || key, the same hash key_hash builds (src/state/lxp_idempotency.c:8-23)."
ac_2 = "Lookup of a stored key returns LXP_IDEMPOTENT_REPLAY with the stored receipt (src/state/lxp_idempotency.c:55-58); an absent key returns no receipt and no error (src/state/lxp_idempotency.c:49-53)."
ac_3 = "An entry is written only after the activity applies, mirroring the kernel record at src/protocol/lxp_kernel.c:3227 after the lookup at src/protocol/lxp_kernel.c:3516."
ac_4 = "The index is exported to the layerxledger, layerxpay and layerxprograms keepers through one interface, so a key consumed at one precompile replays at all of them."
ac_5 = "Index entries round-trip through layerxauth genesis export and import with their recorded sequences, the chain-side form of the kernel snapshot codec (src/state/lxp_idempotency.c:169-222)."

[req.1030]
title = "Kernel idempotency retention window (C side)"
ac_1 = "Each idempotency entry records the global sequence it was committed at (required change to lxp_idempotency_key_state, include/layerx/lxp_state.h:25-31), set from the journal global_sequence (include/layerx/lxp_state.h:52)."
ac_2 = "With a retention window W greater than 0, entries with recorded sequence + W at or below the current sequence are pruned before a new entry is appended, so the capacity check that returns LXP_ERR_ARENA_EXHAUSTED (src/state/lxp_idempotency.c:107-108) counts live entries only."
ac_3 = "A key replayed inside the window still returns LXP_ERR_IDEMPOTENT_REPLAY with the stored receipt (src/state/lxp_idempotency.c:58); a key whose entry was pruned is admitted as a new activity."
ac_4 = "Snapshots carry the recorded sequence (encode and decode at src/state/lxp_idempotency.c:169-222); a legacy entry without it decodes with recorded sequence 0."
ac_5 = "A window of 0 keeps today's behaviour: no entry is pruned and the store refuses the 8193rd key with LXP_ERR_ARENA_EXHAUSTED (include/layerx/lxp_state.h:15)."
ac_6 = "The preview commit check in the module context (src/protocol/lxp_module_ctx.c:1401-1405) and its staged append (src/protocol/lxp_module_ctx.c:1419-1427) follow the pruned count through the same append routine."
ac_7 = "The journal and snapshot callers keep calling the same exported functions (src/state/lxp_journal.c:1056, src/state/lxp_snapshot.c:567) and a store with window 0 commits exactly as before."

[req.1031]
title = "IdempotencyIndex keeper retention window"
ac_1 = "The keeper stores each key with the global sequence it was recorded at and prunes entries older than the window before writing a new key, the admission rule of src/state/lxp_idempotency.c:107-108 after the C retention change."
ac_2 = "A key replayed inside the window is refused as LXP_IDEMPOTENT_REPLAY with the stored receipt; a pruned key is admitted."
ac_3 = "The window is the layerxauth module param IdempotencyRetention, set at activation rehearsal, and the keeper result codes equal the C codes of tests/state/lxp_test_idempotency.c:320."

[req.1032]
title = "Module pause routed through layerxgov"
ac_1 = "governanceMessage (modules/layerxgov/types/proposal.go:138-188) accepts layerxledger.MsgUpdateParams and layerxauth.MsgUpdateParams beside exchange.MsgUpdateParams (modules/layerxgov/types/proposal.go:155)."
ac_2 = "A message whose authority is not the governance module address is refused, as TestLayerXProposalAuthorityWhitelist checks (modules/layerxgov/types/proposal_test.go:121); unknown message types hit the default refusal (modules/layerxgov/types/proposal.go:185-186)."
ac_3 = "The proposal handler executes the messages in a cache context and commits only when all succeed (modules/layerxgov/handler.go:24, routing at modules/layerxgov/handler.go:26-29); after Paused = true every write of that module reverts LXP_PAUSED_SCOPE, the rule of src/modules/governance/lxp_emergency.c:148."
ac_4 = "Module Paused params replace the kernel emergency halt and resume (src/modules/governance/lxp_emergency.c:73-137) on the chain path; the C functions stay as they are and are called only by their own test (Makefile:1197)."

[req.1033]
title = "Kernel read helpers for Go views"
ac_1 = "lxp_governance_session_key_read returns the 209-byte LXGS2 summary stored at key 0x15 || grantId (written at src/modules/governance/lxp_governance.c:444-445), scanning the governance module entries as kernel_fee_record_find does (src/protocol/lxp_kernel.c:1532-1539)."
ac_2 = "The session key helper returns LXP_ERR_UNKNOWN_FIELD (include/layerx/lxp_result.h:37) when no summary exists and LXP_ERR_NON_CANONICAL when the stored value is not 209 bytes."
ac_3 = "lx_asset_payer_grant_read decodes the grant state exactly as grant_load (src/modules/asset/lx_asset_execution.h:81-104) and returns LXP_ERR_NO_PAYER_GRANT for an absent grant (src/modules/asset/lx_asset_execution.h:89)."
ac_4 = "Go views call only exported helpers (include/layerx/lx_asset.h:242, include/layerx/lx_asset.h:263, include/layerx/lx_asset.h:273, include/layerx/lxp_ledger.h:288) and the two helpers above; no Go code builds a kernel key."
ac_5 = "The payer grant helper returns LXP_ERR_NON_CANONICAL when the stored grant id differs from the requested id, as grant_load does (src/modules/asset/lx_asset_execution.h:103)."

[req.1034]
title = "Focused C execute tests before the precompiles"
ac_1 = "A focused execute test opens an account and checks the account record and kernel event 4 (src/modules/asset/lx_asset_execution.h:249-285)."
ac_2 = "The same test issues a payer grant and checks the stored grant record and kernel event 7 (src/modules/asset/lx_asset_execution.h:374-393)."
ac_3 = "A governance sub-op 6 case checks the revocation record, event 0x7106 and the REVOCATION bump (src/modules/governance/lxp_governance.c:616-637) in tests/state/lxp_test_revocation.c."
ac_4 = "The account and grant test has a Makefile target test-asset-account-grant built like test-asset-registry (Makefile:453-457, Makefile:470)."
ac_5 = "The focused test refuses ACCOUNT_OPEN on a paused asset with LXP_ERR_ASSET_PAUSED (src/modules/asset/lx_asset_execution.h:252)."

[req.1035]
title = "Registration of 0x101A and 0x101C in the precompile set and the app"
ac_1 = "The layerxledger and layerxauth precompiles are built in InitializePrecompiles (precompiles/setup.go:99-256), registered in PrecompileNamesToInfo and added to the VM, the pattern of precompiles/setup.go:173-176, precompiles/setup.go:227 and precompiles/setup.go:249."
ac_2 = "The keepers are reachable through utils.Keepers (precompiles/utils/expected_keepers.go:51-52, precompiles/utils/expected_keepers.go:83-86) and PrecompileKeepers (node/precompiles.go:92)."
ac_3 = "Both modules are registered in the app the way layerxexchange is (node/app.go:268, node/app.go:318, node/app.go:787, node/app.go:975, node/app.go:1053)."
ac_4 = "The two addresses are absent below the merge plan height and served from it, through the activation list that turns CustomPrecompileActivation (modules/evm/keeper/keeper.go:195-223) into a list of (plan, address set); a bring-up at the activation height, no account-state migration is required."
ac_5 = "In a live app PrecompileKeepers returns non-nil layerxledger and layerxauth keepers beside LayerXExchangeK (node/precompiles.go:92)."

