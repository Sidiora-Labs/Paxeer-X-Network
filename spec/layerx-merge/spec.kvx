[contract_context.11.activation]
interface = "One merge plan carries every retirement; it is registered with SetUpgradeHandler beside the activation plan (node/upgrades.go:187) and listed in knownUpgradePlans (node/upgrades.go:416-418); its name and height are set at activation rehearsal."
storage = "The plan adds no store; the anchor store is removed by a later store-delete step through StoreUpgrades Deleted in the shape of node/upgrades.go:377."
errors = "A node that reaches the plan height without the handler stops in the upgrade keeper as for every plan (sdk/x/upgrade/keeper/keeper.go:296)."
invariants = "Below the plan height every retired method behaves as at the release before the merge; the gate reads the block height, never wall time (modules/layerxcustody/keeper/keeper.go:42)."
activation = "Plan name and height, and the store-delete step name and height, are set at activation rehearsal; the rehearsal task of this feature proves them on four nodes."

[contract_context.11.retire_mechanism]
interface = "Each retired method checks IsUpgradeActiveAtHeight(ctx, MergeUpgrade, ctx.BlockHeight()) in the pattern of modules/layerxcustody/keeper/keeper.go:38-46 and returns Error(string) \"LXP_MODULE_DISABLED: <name> retired\"."
storage = "No state is read or written by a retired method; the retired executor keeps no keeper reference after the store-delete step (node/precompiles.go:61)."
errors = "LXP_MODULE_DISABLED is code -103 (include/layerx/lxp_result.h:42); a retired call never returns empty success, which an unregistered address would (precompiles/setup.go:81-83 keep the registrations)."
invariants = "Gas for a retired call is the base cost of the executor; no event is emitted."
activation = "Writes retire at the merge plan height; 0x1014 reads retire at the store-delete step."

[contract_context.11.addresses]
interface = "layerxVerify 0x0000000000000000000000000000000000001012 retires all five methods (precompiles/layerxverify/layerxverify.go:52, :202-210); layerxCustody 0x0000000000000000000000000000000000001013 retires all twenty methods (precompiles/layerxcustody/layerxcustody.go:83, :238-308)."
storage = "layerxAnchor 0x0000000000000000000000000000000000001014 retires its twelve writes (precompiles/layerxanchor/layerxanchor.go:206-249) and serves its nine reads (:260-281) until the store-delete step."
errors = "layerxExchange 0x0000000000000000000000000000000000001015 retires requestSettlement and getIntent and keeps intentNonce (precompiles/layerxexchange/layerxexchange.go:58 is a kept view)."
invariants = "Every retired address stays registered at precompiles/setup.go:81-83 for the life of the chain."
activation = "All four address rows switch at the merge plan height; the anchor reads switch at the store-delete step."

[contract_context.11.bond_return]
interface = "The plan handler calls ReturnAllBonds once; it walks GetGuarantors (modules/layerxanchor/keeper/guarantors.go:21), GetUnbondings (modules/layerxanchor/keeper/guarantors.go:34) and GetChallenges (modules/layerxanchor/keeper/challenges.go:18)."
storage = "Funds leave the anchor module account (modules/layerxanchor/keeper/keeper.go:30) by bank sends to Operator (modules/layerxanchor/types/state.go:60) and Challenger (modules/layerxanchor/types/state.go:138)."
errors = "A send failure aborts the handler and the plan does not apply; no partial return is committed."
invariants = "The sum returned equals the anchor module balance before the handler; the balance after is zero; no custody claim is drained (decision.4)."
activation = "Runs exactly once at the merge plan height."

[contract_context.11.store_delete]
interface = "A later step deletes the layerxanchor store key (storage/common/keys/store_keys.go:35, :68)."
storage = "The keeper construction (node/app.go:722) and the custody anchor reader (node/app.go:786) leave the application with the store."
errors = "After the step the nine anchor reads return LXP_MODULE_DISABLED (include/layerx/lxp_result.h:42)."
invariants = "The step runs only after the bond return, so the deleted store holds no value; GetGuarantors (modules/layerxanchor/keeper/guarantors.go:21) shows no bonded value at that height."
activation = "The step name and height are set at activation rehearsal."

[contract_context.11.switch_off]
interface = "Clients move to agent-api major 2: writes are eth_sendRawTransaction and reads are eth_call or gRPC queries at a height; lx_* ingress is switched off (decision.17) and layerxctl stays as an operator EVM client (decision.20)."
storage = "Finality is the committed height, read with the finalized block tag (rpc/block.go:257); proofs use the commit and header verifier (custodyproof/verify.go:260)."
errors = "A switched-off lx_* method answers a JSON-RPC method-not-found error from the router."
invariants = "No client keeps an ed25519 activity signature path except bindLayerX and DID proofs (precompiles/addr/addr.go:38)."
activation = "The switch-off follows the merge plan height and the re-target tasks of wave 5."

[contract_context.11.caller_check]
interface = "python3 tools/paxeer-x/tests/retired_callers_test.py [--component <slug>]... [--path <file>]... [--deleted] [--self-test] reads tools/paxeer-x/retired_callers.json."
storage = "The catalogue lists per component its symbols, deleted trees and replacement; it is the single list of retired names."
errors = "Exit 1 with file:line for every live non-test reference outside the deleted trees; exit 2 for an unknown component."
invariants = "Kept references such as precompiles/setup.go:81-83 and custodyproof/verify.go:260 never fail the check."
activation = "Wave 5 task gates run the check per file; the rehearsal runs it over the whole tree."

[contract_context.11.deletion_order]
interface = "Wave 5 re-targets every live caller, wave 6 returns the bonds, wave 7 retires the executors, deletes the trees, edits the manifests and deletes the anchor store."
storage = "Deleted trees include the guarantor runtime (cmd/layerx-guarantor/main.c:670; src/guarantor/lxp_guarantor.c:1; src/paxeer/lxp_paxeer_client.c:1) and the kernel daemon internals such as src/network/lxp_da_bundle.c:1; src/storage/lxp_da_verified.c:1; include/layerx/lxp_da.h:1."
errors = "A deletion task stays blocked until every re-target task of its components is done."
invariants = "No caller is deleted before its replacement exists; the kept kernel C modules keep their module context (src/protocol/lxp_module_ctx.c:78)."
activation = "Deletions land in the same release as the merge plan; the rehearsal proves the release."

