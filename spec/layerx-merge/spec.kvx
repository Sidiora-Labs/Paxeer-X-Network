tests = ["tests/modules/test_web_intake.c", "tests/fixtures/web/observation-activity.hex", "programs/crates/layerx-programs-runtime/tests/web_read.rs", "tests/test_web_program_path.c", "tests/test_programs_web_read.c", "modules/xweb/keeper/request_test.go", "modules/xweb/keeper/fulfil_test.go", "modules/xweb/keeper/msg_server_test.go", "modules/xweb/keeper/refund_test.go", "modules/xweb/types/testdata/preimage-vectors.json", "precompiles/xweb/xweb_test.go", "programs/sdk/rust/examples/web-reader"]
verification_contract = "Each task of the family runs its own verify_cmd once, for example: go test -count=1 -run '^TestParityWebWebIntake$' ./tests/parity/kernel_chain/"
do_1 = "`GetTransactionReceipt` at rpc/tx.go:106, which returns the EVM receipt map (status, gasUsed, logs) that the chain side of every comparison reads; the chain receipt is read here"
do_2 = "`decode_protocol` at agent/crates/layerx-wire/src/receipt.rs:730, which decodes the canonical ProtocolReceipt envelope that the signed receipt carries; signed receipts decode with the canonical envelope"
do_3 = "`lxp_ledger_receipt_build` at src/ledger/lxp_receipt.c:17, which builds the kernel receipt whose fields are compared with the chain receipt; the kernel receipt is the reference side"
do_4 = "`assertEqualExecTxResults` at occ_tests/occ_test.go:83, which compares code, gas used and log per transaction result; per-transaction code, gas and log are compared"
symbols = ["GetTransactionReceipt", "decode_protocol", "lxp_ledger_receipt_build", "assertEqualExecTxResults"]

