do_1 = "Add precompiles/layerxagent/streams/streams.go Open deriving a nonzero bytes32 streamId from (caller, height, tx index), mapping token through GetAssetByDenom or GetAssetByPointer (modules/layerxcustody/keeper/keeper.go:183, :172) and calling the 0x101B streamOpen whose fund leg is fund_context (src/modules/stream/lx_stream_open.c:204)."
do_2 = "Add Settle and Close deriving a per-call idempotency key and calling streamSettle and streamClose; the kernel caller narrowing (src/modules/stream/lx_stream_execution.h:257-259, src/modules/stream/lx_stream_lifecycle.c:19-20) is kept as the contract states."
do_3 = "Add UpdateRate calling the 0x101B rate-change activity added beside the stream activity types (include/layerx/lx_stream.h:26-32): settle at the old rate first, then store the new rate, then log StreamRateUpdated."
do_4 = "Add views Accrued (lx_stream_accrue on a copy, include/layerx/lx_stream.h:217) and GetStream (ms to s at the boundary, active = !closed and !paused, payer and payee addresses through GetLayerXDid at modules/evm/keeper/layerx_binding.go:18)."
do_5 = "Charge open 50000, settle 60000, close 80000 and updateRate 60000 plus 30/byte through MethodGas and emit the four Stream events after the kernel events."
symbols = ["Open", "Settle", "Close", "UpdateRate", "Accrued", "GetStream", "StreamsPrecompile", "deriveStreamID"]

