arbiter = "The arbiter derives prestate from a header and ICS23 proof (programs/crates/layerx-programs-arbiter/src/authority.rs:24)."

[contract_context.4.adapter_retirement]
adapter = "The protocol-adapter crate (programs/Cargo.toml:5) is deleted once every caller reads through gRPC."
feed = "The feed store (src/modules/programs/feed_store.c:988, include/layerx/lxp_daemon.h:382) is removed."
gateway = "Gateway program routes (platform/hosted/gateway/src/rpc.rs:23, platform/hosted/gateway/src/rpc.rs:618) are removed."
lni = "The LNI program read (agent/crates/layerx-client/src/lni/program_read.rs:1) is removed."
keeper = "The storage keeper targets (Makefile:3609) are removed."

