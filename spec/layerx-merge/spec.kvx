title = "Sequencer execution and block order: harness"
reqs = ["12001.1", "12001.2", "12001.3", "12001.4", "12001.5", "12001.6", "12002.1", "12002.2", "12002.3", "12003.1", "12003.2", "12003.3", "12003.4", "12004.1", "12004.2", "12004.3", "12004.4", "12005.1", "12005.2", "12005.3", "12006.1", "12006.2", "12006.3", "12006.4", "12007.1", "12007.2", "12007.3", "12007.4", "12008.1", "12008.2", "12008.3", "12008.4", "12009.1", "12009.2", "12009.3", "12009.4", "12010.1", "12010.2", "12010.3", "12010.4", "12011.1", "12011.2", "12011.3", "12011.4", "12012.1", "12012.2", "12012.3", "12012.4", "12013.1", "12013.2", "12013.3", "12013.4", "12014.1", "12014.2", "12014.3", "12015.1", "12015.2", "12015.3", "12015.4", "12016.1", "12016.2", "12016.3", "12016.4", "12016.5", "12017.1", "12017.2", "12017.3", "12017.4", "12017.5"]
touches = ["node/sequencer/sequencer_test.go", "occ_tests/occ_test.go", "node/optimistic_processing_test.go", "node/receipt_test.go", "node/receipt_translation_test.go", "node/check_total_block_gas_test.go", "node/app_test.go", "node/ante_test.go", "node/app_feetoken_test.go", "rpc/state_test.go"]
tests = ["node/app_test.go", "occ_tests/occ_test.go", "node/optimistic_processing_test.go", "node/receipt_test.go", "node/receipt_translation_test.go", "node/check_total_block_gas_test.go", "node/ante_test.go", "node/app_feetoken_test.go", "rpc/state_test.go", "rpc/tx_test.go", "rpc/simulate_test.go", "rpc/subscribe_test.go", "consensus/internal/consensus/wal_test.go", "consensus/test/e2e"]
verification_contract = "Each task of the family runs its own verify_cmd once, for example: go test -count=1 -run TestSequencerAccept ./node/sequencer/"
do_1 = "`runTest` at occ_tests/occ_test.go:198, which runs one scenario twice and feeds both outcomes to the three comparators; the twin runs each case once on the kernel and once on the chain"
do_2 = "`run` at tests/chain/template_test.go:20, which runs a block of encoded transactions through processblock.App and returns per-transaction codes; the chain side executes inside a real block"
do_3 = "`assertEqualState` at occ_tests/occ_test.go:17, which compares every store key of the expected and actual contexts and fails on the first differing value; state equality is the first comparator"
do_4 = "`ProcessProposalHandler` at node/app.go:1457, which checks proposals; the order check against the sequencer commitment is added here; the harness routes sequencer execution and block order cases here"
do_5 = "`FinalizeBlocker` at node/app.go:1551, which executes the committed block in order; the second family entry point the harness drives"
symbols = ["runTest", "run", "assertEqualState", "ProcessProposalHandler", "FinalizeBlocker"]

