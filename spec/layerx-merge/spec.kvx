[feature.9]
name = "sequencer"
scope = "Proposer-as-executor sequencer for the Paxeer X Network: every transaction executes at receipt on the open speculative state, a signed ProtocolReceipt v2 returns at send time, pending reads come from the open block, blocks carry exactly the executed sequence recorded by modules/sequencer, durability comes from a replicated WAL with a hot standby, and fees, sponsorship, timing and activation follow the frozen sequencer contract."
requirements = ["9001", "9002", "9003", "9004", "9005", "9006", "9007", "9008", "9009", "9010", "9011", "9012", "9013", "9014", "9015", "9016", "9017", "9018", "9019", "9020", "9021", "9022", "9023", "9024", "9025", "9026", "9027", "9028", "9029", "9030", "9031", "9032", "9033", "9034", "9035", "9036", "9037", "9038", "9039", "9040", "9041", "9042", "9043", "9044"]
completion_task = "9.7.2"

[req.9001]
title = "Execute every transaction at receipt on the open speculative state, in receipt order"
ac_1 = "Accept runs each transaction through app.DeliverTx in deliver mode (node/abci.go:169) on its own branch of L_open made with the CacheTxContext pattern (sdk/baseapp/baseapp.go:822); a successful branch is written into L_open, a failed branch is dropped and consumes no sequence number."
ac_2 = "BeginBlock for the open height runs once when L_open opens (node/legacyabci/begin_block.go:43), never per transaction, and every transaction of the block sees the header fixed at open: height, proposer and the open time that replaces tmtime.Now() (consensus/internal/state/state.go:279)."
ac_3 = "Accept always runs deliver mode, so the deliver-mode nonce rule nonce == next (modules/evm/ante/sig.go:75) and the deliver-only fee branches (modules/evm/ante/fee.go:114, :130) run exactly as they run in block execution."
ac_4 = "A panic raised while DeliverTx executes a transaction (node/abci.go:169) is recovered inside Accept: the transaction gets no receipt, its branch is dropped and the sequence counter and L_open are unchanged."
ac_5 = "Seal runs MidBlock, WriteDeferredBalances, EndBlock and RouteCollectedFeeTokens on L_open in the same order ProcessBlock runs them (node/app.go:2138, :2151, :2162, :2165) and then L_open becomes the sealed layer L_N."

[req.9002]
title = "Return a signed receipt at send time and keep the standard receipt committed-only"
ac_1 = "In sequencer mode eth_sendRawTransaction (rpc/send.go:76) passes the decoded transaction to Accept instead of BroadcastTx (rpc/send.go:150) and returns the transaction hash only after the receipt is signed, written to the WAL with fdatasync and acknowledged by the standby."
ac_2 = "The gasUsed reported for a sequencer send is the executed value from Accept, not the simulateTx estimate taken against the latest block (rpc/send.go:124-128, :166, :171)."
ac_3 = "pax_sequencerReceipt is registered in the pax namespace beside rpc/server.go:134 and returns rung, txHash, seq, height, index, timestamp, status, returnData, logs, gas fields, fee denom and amount, sponsor, from, to, contractAddress, nonce, vmError, keyId and the canonical receipt bytes; the bytes are identical at rungs receipted and committed."
ac_4 = "eth_getTransactionReceipt stays committed-only (rpc/tx.go:106-110): it returns null before commit and never returns a pending receipt with a null blockHash (D17)."
ac_5 = "After commit the standard receipt built by getTransactionReceipt (rpc/tx.go:110) and encodeReceipt (rpc/tx.go:551) equals the signed receipt field by field (status, gasUsed, cumulativeGasUsed, logs, effectiveGasPrice, contractAddress) except blockHash."

[req.9003]
title = "Serve pending-state reads from a read-only snapshot of the open block"
ac_1 = "RPCContextProvider (node/app.go:2895) gains a pending height beside LatestCtxHeight (rpc/utils.go:41) that returns a read-only CacheContext snapshot of L_open taken after the last receipted transaction; the existing latest branch (node/app.go:2896-2905) and CreateQueryContext path (:2906) are unchanged."
ac_2 = "On the sequencer and standby, getBlockNumber (rpc/utils.go:63) and getHeightFromBigIntBlockNumber (rpc/utils.go:90) stop mapping pending to latest (rpc/utils.go:66, :99), and ResolveHeight (rpc/watermark_manager.go:169) stops mapping pending to latest (rpc/watermark_manager.go:196)."
ac_3 = "On every node other than the sequencer and standby, a pending-tag read returns JSON-RPC error -32000 \"pending served by sequencer\" and never a silent latest answer (rpc/utils.go:90, :99)."
ac_4 = "A pending read takes a snapshot and never holds the L_open write lock while it runs, so Accept proceeds while eth_call (rpc/simulate.go:151) executes on the snapshot."
ac_5 = "After Accept of a transfer, eth_getBalance with pending (rpc/state.go:45, height resolved at :50) returns the post-transaction balance, and after the block commits eth_getBalance with latest returns the same value."

[req.9004]
title = "Propose blocks that contain exactly the executed sequence"
ac_1 = "In sequencer mode CreateProposalBlock (consensus/internal/state/execution.go:101) takes the block transactions from Seal() instead of mempool ReapTxs (consensus/internal/state/execution.go:126-130), with MsgSequenceBatch at position 0 and the sealed slice after it in seq order."
ac_2 = "MakeBlock (consensus/internal/state/state.go:265) uses the L_open open time instead of tmtime.Now() (consensus/internal/state/state.go:279) for the header time in sequencer mode."
ac_3 = "Seal closes the block at the consensus limits so checkTotalBlockGas (node/app.go:1477) passes: MaxGas and MaxGasWanted from DefaultBlockParams (consensus/types/params.go:139, :141) and MaxBytes (consensus/types/params.go:137)."
ac_4 = "The sequencer never opens L_open at or past a height with a scheduled upgrade plan (node/app.go:1500 plan.ShouldExecute)."
ac_5 = "The sequencer's own FinalizeBlocker (node/app.go:1551) adopts L_N as the state to commit when the block equals the sealed slice, following the optimistic adopt path (node/app.go:1587-1604, SetProcessProposalStateToCommit at sdk/baseapp/abci.go:254); a block that differs is re-executed."

[req.9005]
title = "Pin the proposer list from the activation height"
ac_1 = "Leader() (consensus/internal/consensus/types/round_state.go:422-437) returns L[r mod len(L)] at heights at or above H_act with L = [primary, standby]; below H_act the sha256(height, round) power-weighted rule is unchanged."
ac_2 = "Every caller of Leader (consensus/internal/consensus/state.go:1101, :1154, :2077, :2232, :2707) and SafeRoundState.Leader (consensus/internal/consensus/types/round_state.go:194) observes the pinned rule with no second code path."
ac_3 = "The leader list and H_act are node config fields beside the timeout overrides (consensus/config/config.go:1161-1187); ValidateBasic (consensus/config/config.go:1257) refuses an empty list, a duplicate entry, or an H_act without a list."
ac_4 = "Validators keep executing with OCC unchanged (node/app.go:2091 ProcessBlock, :1888 ProcessTXsWithOCCV2) and the app hash is unchanged by pinning, because Leader is not part of app state."
ac_5 = "The rule switch is height-activated: nodes restarted in any order before H_act compute identical leaders at every height, so mixed restart order never splits prevotes (modules/layerxcustody/keeper/keeper.go:38-46 is the height-activation pattern)."

[req.9006]
title = "Refuse at ProcessProposal any block that deviates from the sequencer order"
ac_1 = "ProcessProposalHandler (node/app.go:1457) checks, before checkTotalBlockGas (node/app.go:1477), that tx 0 decodes as MsgSequenceBatch (decode path node/app.go:1461) and that req.Header.ProposerAddress is in the pinned list L."
ac_2 = "The handler checks height field = header height, fromSeq = stored lastSeq + 1, prevSeqHash = stored lastSeqHash and toSeq - fromSeq + 1 = len(txs) - 1, reading the stored values from the clean context (node/app.go:1473; sdk/baseapp/abci.go:992-1003)."
ac_3 = "The handler recomputes txRoot from txs 1..n and lastSeqHash by folding seqHash over txs 1..n and refuses any mismatch, so two swapped transactions are detected (node/app.go:1462-1468)."
ac_4 = "The handler checks that the batch keyId names a ReceiptKeys entry whose [firstHeight, lastHeight] contains the height and that the ed25519 sig verifies over the batch digest (agent/crates/layerx-proof/src/inclusion.rs:66-70)."
ac_5 = "Any failed check answers REJECT in the existing shape (node/app.go:1462-1468), raises a sequencer alert metric and is never retried for the same block; validators prevote nil and the next round goes to the next L entry."

[req.9007]
title = "Survive an unplanned stop with a replicated WAL and a hot standby"
ac_1 = "Every ACCEPT is appended to the sequencer WAL and synced with fdatasync in a group before any receipt in the group is released, using the Sync shape of consensus/internal/libs/wal/log.go:195-198."
ac_2 = "The standby receives each WAL group synchronously, appends and syncs it, then acknowledges; with no acknowledgement the send returns an error and no receipt is issued (consensus/internal/libs/wal/writer.go:106-111; cmd/layerxd/lxp_daemon_replica.c:216)."
ac_3 = "The standby replays every ACCEPT through the same executor and DeliverTx path (node/abci.go:169) into its own L_N and L_open, so its state hash and its receipt bytes for each seq equal the primary's."
ac_4 = "Each node signs consensus with its own privval key and last-sign state (consensus/privval/file.go:317, :326); no consensus key is shared between primary and standby, so a handover cannot double sign."
ac_5 = "On primary loss the standby proposes at round 1 with the WAL slice lastSeq+1 to its last ACCEPT (consensus/internal/consensus/types/round_state.go:422-437)."

[req.9008]
title = "Set a near-zero EVM minimum gas price and apply the node floor before Accept"
ac_1 = "The MinimumFeePerGas default (modules/evm/types/params.go:52, carried into DefaultParams at :81, 1 gwei today) is lowered to at most 67000000 wei; the exact value is set at activation rehearsal through the governed key KeyMinFeePerGas (modules/evm/types/params.go:21, :102)."
ac_2 = "A gasFeeCap below the base fee or below the minimum is refused with ErrInsufficientFee (modules/evm/ante/fee.go:53-58) at Accept, in deliver mode, with no receipt."
ac_3 = "The sequencer applies its configured node floor (default \"0.01uhpx\", daemon/paxd/cmd/root.go:397) to Cosmos transactions explicitly before Accept, because the floor check runs only in CheckTx (sdk/x/auth/ante/validator_tx_fee.go:33)."
ac_4 = "Receipts quote the base fee of the open block, fixed when L_open opens from GetNextBaseFeePerGas (modules/evm/keeper/fee.go:100), so the effective gas price does not drift within one block."

[req.9009]
title = "Charge SID through the fee-token precompile at the governed rate with a raised rate age"
ac_1 = "A payer who selected SID through setFeeDenom at 0x0000000000000000000000000000000000001018 (precompiles/feetoken/feetoken.go:19, :22) is charged through GetFeeTokenCharge (modules/evm/keeper/feetoken.go:92-108) and the conversion and payer checks (modules/evm/ante/fee.go:88-108) at Accept."
ac_2 = "The initial rate is 3114000 SID base units per PAX (modules/evm/types/params.go:36) and every rate change passes the governance handler that holds it within the 5 % spread (modules/evm/gov.go:26-41; DefaultMaxFeeTokenSpread modules/evm/types/params.go:42)."
ac_3 = "The MaxFeeTokenRateAge default (modules/evm/types/params.go:39, 1000 blocks; key :16) is raised by governance in the activation proposal, its value set at activation rehearsal, and the stale branch of GetFeeTokenRate (modules/evm/keeper/params.go:334-335) holds at the raised bound."
ac_4 = "A stale rate refuses only SID payers, with ErrFeeTokenRateStale and no receipt; PAX payers in the same open block are receipted (modules/evm/keeper/params.go:334-335)."
ac_5 = "Fee tokens collected in the open block route at Seal through RouteCollectedFeeTokens (node/app.go:2165), as in ProcessBlock."

[req.9010]
title = "Carry sponsored writes from the gas station as ordinary sequencer transactions"
ac_1 = "A sponsored write is an ordinary type-4 transaction calling executeSponsored (contracts/src/BatchCallAndSponsor.sol:135-140) and receives an ordinary sequencer receipt whose summary effect carries the sponsor taken from the Sponsored event (contracts/src/BatchCallAndSponsor.sol:71, :166)."
ac_2 = "The gas station submits through eth_sendRawTransaction (interop/crates/layerx-gas-station/src/rpc.rs:171-175) via the router to the sequencer, and a submission is complete at rung receipted."
ac_3 = "The station reads the delegated account's batch nonce from pending state instead of the anchored latest block (interop/crates/layerx-gas-station/src/station.rs:331-333)."
ac_4 = "When the sponsor balance would fall below the balance floor the quote is refused (interop/crates/layerx-gas-station/src/policy.rs:113-118 BalanceFloor) and no transaction is sent."
ac_5 = "The station refuses rates older than max_rate_age, bounded at 300 s (interop/crates/layerx-gas-station/src/config.rs:147-148), and the contract reverts a stale rate (contracts/src/BatchCallAndSponsor.sol:113-120)."

[req.9011]
title = "Key sponsorship budgets by DID"
ac_1 = "reserve (interop/crates/layerx-gas-station/src/policy.rs:76) keys the per-account running total by the DID budget key instead of the EVM account (interop/crates/layerx-gas-station/src/policy.rs:92-93, :101-104)."
ac_2 = "The budget key is read through getLayerXDid on the addr precompile 0x0000000000000000000000000000000000001004 (precompiles/addr/addr.go:40, :57, :391) at pending state; an account with no bound DID uses its EVM address as the key."
ac_3 = "QuoteRecord (interop/crates/layerx-gas-station/src/journal.rs:37-50) carries the DID budget key, and journal replay restores the per-DID totals."
ac_4 = "A failed DID lookup signs no quote (fail closed), and a refused check consumes no budget (interop/crates/layerx-gas-station/src/policy.rs:76-126)."

[req.9012]
title = "Hold future nonces per sender and execute them in nonce order"
ac_1 = "A transaction whose nonce equals next(sender) on L_open is executed at receipt; the next value is read from L_open, not from the mempool (consensus/internal/mempool/mempool.go:234)."
ac_2 = "A transaction with nonce above next(sender) waits in a per-sender future queue at rung submitted and executes in nonce order the moment the gap fills; its seq is assigned at the fill moment, following the ready and pending split of consensus/internal/mempool/tx.go:152."
ac_3 = "A transaction with nonce below next(sender) is refused with \"nonce too low\", the rule CheckTx applies today (modules/evm/ante/sig.go:70-73)."
ac_4 = "The future queue has a per-sender bound and an expiry, both set at activation rehearsal; a transaction beyond the bound is refused and an expired entry is dropped with no receipt (consensus/internal/mempool/mempool.go:292)."
ac_5 = "Across senders the order is arrival order at Accept, and one sender's transactions never reorder (consensus/internal/mempool/tx.go:461 is the order it replaces)."

[req.9013]
title = "Estimate gas against pending state on the sequencer"
ac_1 = "eth_estimateGas (rpc/simulate.go:107) defaults to the pending tag on the sequencer, replacing the latest default (rpc/simulate.go:120)."
ac_2 = "The sequencer send path does not estimate through simulateTx against LatestBlockNumber (rpc/send.go:166, :171); it reports the executed gasUsed."
ac_3 = "eth_createAccessList keeps pending as its default tag (rpc/simulate.go:86, :91) and evaluates it against the L_open snapshot."
ac_4 = "On other nodes the estimate default stays latest, and an explicit pending tag returns -32000 \"pending served by sequencer\" (rpc/simulate.go:120)."

[req.9014]
title = "Keep CosmWasm and Cosmos transactions deterministic in the speculative branch"
ac_1 = "The Wasm per-block transaction counter (TXCounterStoreKey, node/app.go:1115) sees the position fixed by seq order, so a CosmWasm execute yields the same receipt at the sequencer and at every validator."
ac_2 = "Cosmos (non-EVM) transactions go through the same Accept path, never the CheckTx path (node/abci.go:95)."
ac_3 = "Accept decodes Cosmos and EVM transactions with the same decoder ProcessBlock uses (node/app.go:2128 DecodeTransactionsConcurrently), so the decoded form is identical."

[req.9015]
title = "Keep precompile calls deterministic in the speculative branch"
ac_1 = "A failing precompile call becomes ErrExecutionReverted with an Error(string) payload when WithRevertReasons is set (precompiles/common/precompiles.go:53, :82-92), and the receipt activity_root is sha256 of exactly the bytes block execution returns."
ac_2 = "The node-local precompile set is refreshed against L_open when it opens, following refreshXWebPrecompile (node/upgrades.go:250)."
ac_3 = "The precompile error recorded on the StateDB (precompiles/common/precompiles.go:113-120) is observed identically at the sequencer and in block execution."

[req.9016]
title = "Feed BeginBlock the votes of the height before last from the activation height"
ac_1 = "At heights at or above H_act, BeginBlock(N+1) receives the votes of N-1, stored in modules/sequencer at the end of block N from that block's DecidedLastCommit; at H_act itself BeginBlock receives an empty vote list and stores the votes of H_act-1 (node/app.go:1551, :2119)."
ac_2 = "The distribution and slashing BeginBlockers (node/legacyabci/begin_block.go:60, :61) read the fed list, so rewards and liveness lag one height and no height is counted twice."
ac_3 = "The BeginBlock call sites (node/app.go:2119 with lastCommit.Votes; node/abci.go:60) pass the stored list at heights at or above H_act and the request's own votes below it."
ac_4 = "The stored vote list lives in the modules/sequencer store and is written once per height in FinalizeBlocker (node/app.go:1551); a restart between heights resumes from the stored list."

[req.9017]
title = "Run the ante chain in deliver mode against the open block on the sequencer"
ac_1 = "Accept never runs a check-mode branch: the deliver-only fee paths (modules/evm/ante/fee.go:114, :130) run and the CheckTx-only floor path (sdk/x/auth/ante/validator_tx_fee.go:33) does not."
ac_2 = "LatestCtxGetter (node/app.go:1122-1124) returns the L_open context in sequencer mode instead of app.GetCheckCtx() (node/app.go:1123), so signature checks read association state written by earlier receipted transactions."
ac_3 = "Accept builds its context from L_open and never from checkState (sdk/baseapp/baseapp.go:550 setCheckState, :778 getState), so CheckTx and recheck on other paths do not affect receipt results."

[req.9018]
title = "Move block pruning off the ApplyBlock path"
ac_1 = "ApplyBlock (consensus/internal/state/execution.go:200) no longer calls pruneBlocks synchronously (consensus/internal/state/execution.go:418, inside :410-428); pruning runs on a background worker after Commit using the retain height from Commit (consensus/internal/state/execution.go:371)."
ac_2 = "At most one prune runs at a time, and requests that arrive while it runs coalesce to the highest retain height (consensus/internal/state/execution.go:764-779)."
ac_3 = "The worker never deletes at or above the retain height, and node shutdown waits for an in-flight prune before closing the block store (pruneBlocks consensus/internal/state/execution.go:764-779)."
ac_4 = "The retention rule is unchanged: GetBlockRetentionHeight (sdk/baseapp/abci.go:725) and min-retain-blocks (sdk/server/config/config.go:89) decide what is pruned; only the timing moves."

[req.9019]
title = "Bypass the mempool for ordering on the sequencer"
ac_1 = "In sequencer mode the block order never comes from ReapTxs (consensus/internal/mempool/mempool.go:429) or the priority-then-nonce order (consensus/internal/mempool/tx.go:461)."
ac_2 = "Every other node forwards eth_sendRawTransaction to the sequencer with the EvmProxy forwarding shape (rpc/send.go:96-113) and never broadcasts it into its own mempool (rpc/send.go:150)."
ac_3 = "Mempool Update and recheck (consensus/internal/mempool/mempool.go:446-469) stay unchanged on other nodes for gossip."
ac_4 = "eth_getTransactionCount with pending on other nodes is forwarded to the sequencer with the forwarding shape at rpc/tx.go:371-390 and never falls back to EvmNextPendingNonce (rpc/tx.go:392; consensus/internal/mempool/mempool.go:234)."

[req.9020]
title = "Prove the whole sequencer path with one focused test on the real App"
ac_1 = "node/sequencer/sequencer_test.go feeds 200 mixed transactions (two interleaved EVM senders, a reverting contract call, a SID-paying transaction, a CosmWasm execute and a precompile call) through Accept on the real App built as node/app_test.go builds it, and every receipt is returned before Seal (node/app_test.go:263)."
ac_2 = "Pending reads after Accept match the committed reads after the block (rpc/state.go:45, :62, :79, :212)."
ac_3 = "Seal transactions equal the WAL order, and a validator App running ProcessProposal and FinalizeBlock with OCC on (node/app.go:1457, :1551, :1888) yields the same app hash and identical receipts."
ac_4 = "A block with two transactions swapped is refused at ProcessProposal (node/app.go:1462-1468)."
ac_5 = "WAL replay on a fresh App reproduces every receipt byte for byte (consensus/internal/consensus/wal.go:269 is the replay model)."

[req.9021]
title = "Encode the signed receipt as the canonical ProtocolReceipt v2 envelope"
ac_1 = "The receipt header carries protocol version 2 (agent/crates/layerx-wire/src/limits.rs:12) and structure tag 0x5201 (agent/crates/layerx-wire/src/receipt.rs:10); tag 0x5202 (agent/crates/layerx-wire/src/receipt.rs:11) is never used; fields follow the order of ProtocolReceipt (agent/crates/layerx-wire/src/receipt.rs:190-220)."
ac_2 = "activity_id is the transaction hash (modules/evm/types/tx.pb.go:84 Hash; sha256 of the bytes for a Cosmos transaction) and is never zero, the condition the verifier enforces (agent/crates/layerx-proof/src/receipt.rs:648)."
ac_3 = "global_sequence is gap-free and starts at 1 at H_act; previous_state_root = prevSeqHash (32 zero bytes at H_act) and resulting_state_root = seqHash = sha256(\"PAXEER/v1/sequence\\0\" || prevSeqHash || u64be(seq) || activity_id) (agent/crates/layerx-wire/src/hash.rs:132 is the domain-hash helper)."
ac_4 = "activity_root is sha256 of the EVM return data (modules/evm/types/tx.pb.go:83 ReturnData), and result_code is 0 when the EVM status is 1 and 1 when the status is 0 (modules/evm/types/receipt.pb.go:111 Status, :114 VmError)."
ac_5 = "fee_charged is gasUsed times effectiveGasPrice converted into the payer's fee denom (modules/evm/keeper/feetoken.go:92-108; modules/evm/ante/fee.go:96), and asset is sha256 of the fee denom string (modules/evm/types/params.pb.go:470-475 AllowedFeeDenom.Denom)."
ac_6 = "batch_id is 24 zero bytes then u64be of the open height, timestamp is the open time in unix milliseconds, module_id is the next free id after LXP_MODULE_RESERVED_COUNT (include/layerx/lxp_module.h:26), set at activation rehearsal, module_version is 1, parameter_version is 0 and operation is the EVM transaction type (modules/evm/types/receipt.pb.go:103) or 0xFF for a Cosmos transaction."
ac_7 = "from and to are addr32 (12 zero bytes then the 20-byte address; recipient or created contract, modules/evm/types/receipt.pb.go:105, :112, :113), the four balances are read on the per-transaction branch before and after execution, from_sequence is the nonce (modules/evm/ante/sig.go:70-80), authorization_hash is keccak256 of the RLP authorization list for type 4 and zero otherwise, and context_hash is the signing host's keyId."

[req.9022]
title = "Encode receipt effects for the execution summary and every log"
ac_1 = "Effect 0 is the execution summary: kind 1 STATE (include/layerx/lxp_receipt.h:14-18), ordinal 0, not monetary, zero transfer_set_root, body gasUsed || cumulativeGasUsed || effectiveGasPrice || txIndex || contractAddress || sponsor || sha256(vmError) || returnData length || log count || feeDenom, at most 191 bytes, within MAX_EFFECT_BODY 256 (agent/crates/layerx-wire/src/receipt.rs:16)."
ac_2 = "Effects 1..n are the logs: kind 3 EVENT, ordinal = log index, body address || topic count || topics || sha256(data), at most 181 bytes, taken from the Log fields (modules/evm/types/receipt.pb.go:26-31)."
ac_3 = "Every effect is non-monetary, so decode_effect never meets the monetary-with-kind-other-than-2 refusal (agent/crates/layerx-wire/src/receipt.rs:497-502)."
ac_4 = "The effect count bound for this receipt shape is extended beyond MAX_EFFECTS 512 (agent/crates/layerx-wire/src/receipt.rs:15) as module_version 1 of this layout, so a transaction with more than 511 logs is encoded in full and never refused."

[req.9023]
title = "Sign receipts with the separate ed25519 receipt key, byte-compatible with the existing verifier"
ac_1 = "The signed digest is sha256(\"LXP/v1/receipt\\0\" || unsigned preimage) (agent/crates/layerx-wire/src/hash.rs:69, :330-335), where the preimage is the canonical encoding with signature flag 0 (agent/crates/layerx-wire/src/receipt.rs:1009-1018 encode_unsigned)."
ac_2 = "The scheme is pure ed25519 over the 32-byte digest (agent/crates/layerx-crypto/src/ed25519.rs:54-60) with a separate receipt key, never secp256k1 and never the validator consensus key (consensus/privval/file.go:222)."
ac_3 = "verify_sequencer_signature (agent/crates/layerx-proof/src/receipt.rs:631-660) accepts a receipt signed by node/sequencer: decode, byte-exact re-encode, supported version, non-zero activity_id, signature present (:653) and ed25519 over the digest (:658)."
ac_4 = "The signature is encoded as flag 1 then a 64-byte bounded array (agent/crates/layerx-wire/src/receipt.rs:707-716, :975-978)."
ac_5 = "The Go encoder output equals the Rust encoder output (agent/crates/layerx-wire/src/receipt.rs:928-980) for the same fields, proven by a shared vector checked on both sides."

[req.9024]
title = "Pin receipt keys on chain in ReceiptKeys and rotate them by governance"
ac_1 = "The modules/sequencer param ReceiptKeys holds entries {keyId 32 bytes, publicKey 32 bytes, firstHeight, lastHeight}; an entry with firstHeight above lastHeight is refused, the rule from_config applies (agent/crates/layerx-proof/src/inclusion.rs:66-70)."
ac_2 = "ReceiptKeys changes only through a governance param change, following the handler shape at modules/evm/gov.go:26-41; the primary and standby keys hold overlapping ranges."
ac_3 = "Receipts whose batch_id height is at or above the rotation height H2 are signed with K2 and carry context_hash = keyId2; receipts below H2 verify under K1 for as long as the list holds K1's range (agent/crates/layerx-proof/src/inclusion.rs:14-19)."
ac_4 = "A sequencer whose receipt public key is not in a ReceiptKeys entry covering the open height refuses to start (agent/crates/layerx-proof/src/inclusion.rs:66-70)."
ac_5 = "The receipt authority service and the settle endpoint load the same list of keys and ranges instead of the single key they load today (platform/hosted/authority/src/main.rs:306-309; platform/hosted/gateway/src/main.rs:1030-1036)."

[req.9025]
title = "Let clients verify a receipt end to end"
ac_1 = "A client fetches pax_sequencerReceipt (pax namespace beside rpc/server.go:134) and runs verify_sequencer_signature with the pinned key (agent/crates/layerx-proof/src/receipt.rs:631)."
ac_2 = "The client checks that context_hash names a pinned keyId whose range contains the batch_id height (agent/crates/layerx-proof/src/inclusion.rs:14-19)."
ac_3 = "The client checks that the JSON fields equal the decoded fields, sha256(returnData) equals activity_root, and each log's topics and sha256(data) equal its effect (agent/crates/layerx-wire/src/receipt.rs:178-186)."
ac_4 = "At the committed rung eth_getTransactionReceipt (rpc/tx.go:106-110) returns equal status, gasUsed and logs at a block number at or above the batch_id height, and that block's MsgSequenceBatch covers the receipt's seq."
ac_5 = "Two valid receipts under one keyId with equal global_sequence and different activity_id form an equivocation proof; the receipt authority service records the pair beside its key check (platform/hosted/authority/src/lib.rs:281-285) and raises a monitoring alert; nothing on chain consumes it."

[req.9026]
title = "Keep the CometBFT read routes unchanged and switch off the old ingress"
ac_1 = "tx_search (route consensus/internal/rpc/core/routes.go:52; TxSearch consensus/internal/rpc/core/tx.go:56) serves committed transactions only and is unchanged by the sequencer."
ac_2 = "abci_query with prove (route consensus/internal/rpc/core/routes.go:70; ABCIQuery consensus/internal/rpc/core/abci.go:13) still refuses a proof at height 1 or below (sdk/baseapp/abci.go:902-908) and serves committed state only."
ac_3 = "header and commit (routes consensus/internal/rpc/core/routes.go:44, :49; Header consensus/internal/rpc/core/blocks.go:188; Commit :216) are unchanged; app_hash in header H is the state after block H-1."
ac_4 = "The LayerX lx_* ingress is switched off at activation; the router refuses those calls in the shape it already uses for unrelayed subscriptions (platform/hosted/gateway/src/paxeer.rs:172)."

[req.9027]
title = "Answer every state and simulation call per the pending-tag table"
ac_1 = "eth_call (rpc/simulate.go:151), eth_getBalance (rpc/state.go:45), eth_getCode (rpc/state.go:62) and eth_getStorageAt (rpc/state.go:79) with pending read the L_open snapshot on the sequencer and standby, through StateAndHeaderByNumberOrHash (rpc/simulate.go:315, ctxProvider at :322)."
ac_2 = "eth_getProof with pending is refused on every node because L_open has no committed root (rpc/state.go:110)."
ac_3 = "debug_trace calls with pending stay refused on every node (rpc/simulate.go:395-396)."
ac_4 = "The standby answers pending reads from its own replayed L_open, equal to the primary's at the same seq (node/app.go:2895-2906)."

[req.9028]
title = "Serve pending logs, filters and subscriptions from receipts"
ac_1 = "eth_getLogs (rpc/filter.go:569) with toBlock pending includes logs of receipted transactions in L_N and L_open on the sequencer; on other nodes toBlock pending returns -32000."
ac_2 = "Filters created by eth_newFilter (rpc/filter.go:397) with toBlock pending return receipted logs once through eth_getFilterChanges (rpc/filter.go:458) and eth_getFilterLogs (rpc/filter.go:529); the committed copy is not repeated."
ac_3 = "eth_newBlockFilter (rpc/filter.go:422) stays committed-only; eth_newPendingTransactionFilter (rpc/filter.go:445, unsupported today at :453) returns receipted transaction hashes in receipt order on the sequencer and stays unsupported elsewhere."
ac_4 = "eth_subscribe logs (rpc/subscribe.go:226) on the sequencer gains a logs-from-receipts stream fed by Accept in which each log carries its seq and committed logs are not re-emitted; newHeads (rpc/subscribe.go:107, :181) stays committed-only."
ac_5 = "eth_subscribe newPendingTransactions gets a handler on the sequencer under the standard name that emits receipted hashes in receipt order; no such handler exists today in rpc/subscribe.go (rpc/subscribe.go:107 is the handler shape)."

[req.9029]
title = "Serve the pending block, pending transactions and fee views"
ac_1 = "eth_getBlockByNumber with pending (rpc/block.go:207, :215) on the sequencer returns the open block: number, timestamp (open time) and receipted transaction hashes, with no hash and no stateRoot; other nodes keep the latest-committed resolution."
ac_2 = "eth_blockNumber (rpc/info.go:52) always reports the latest committed height and never the pending one."
ac_3 = "eth_getTransactionByHash (rpc/tx.go:269) returns a receipted transaction with blockNumber = pending height and blockHash null on the sequencer; other nodes return committed transactions only."
ac_4 = "eth_gasPrice, eth_feeHistory and eth_maxPriorityFeePerGas (rpc/info.go:100, :142, :292) report the base fee of the open block, fixed at open from GetNextBaseFeePerGas (modules/evm/keeper/fee.go:100), on the sequencer; other nodes report committed values."

[req.9030]
title = "Refuse same-nonce replacement and remove the gas-station fee bump"
ac_1 = "A transaction whose (sender, nonce) is already receipted or held at rung submitted is refused with an error, never superseded (D17); deliver mode already requires nonce == next (modules/evm/ante/sig.go:75)."
ac_2 = "The gas station's same-nonce Replacement path is removed: replace (interop/crates/layerx-gas-station/src/station.rs:393-407), its callers (interop/crates/layerx-gas-station/src/station.rs:731-736, :737-741) and the journal Replacement record (interop/crates/layerx-gas-station/src/journal.rs:94-99); a send is receipted or refused."
ac_3 = "The relayer's EVM nonce comes from the sequencer pending map through eth_getTransactionCount pending (rpc/tx.go:358)."
ac_4 = "An expired or dropped submission leaves the sponsor nonce unfilled; the next sponsored send uses it, because the sequencer receipts only executable nonces (modules/evm/ante/sig.go:75)."

[req.9031]
title = "Bring the sequencer up at the activation height with no account-state migration"
ac_1 = "Activation is a bring-up at the activation height H_act through the existing upgrade path (node/upgrades.go:416-418 knownUpgradePlans; store additions at node/upgrades.go:377 activationStoreUpgrades); no account-state migration is required."
ac_2 = "modules/sequencer is registered in the activation module list (node/upgrades.go:385 activationModules) and its genesis at H_act holds the pinned leader list L, ReceiptKeys and lastSeq 0."
ac_3 = "Below H_act every node runs the existing proposer rotation and mempool path; at H_act the leader pin and ProcessProposal order check switch on together, read from the module store, never from local config alone (consensus/internal/consensus/types/round_state.go:422-437; consensus/internal/mempool/mempool.go:429)."
ac_4 = "A rollback rehearsal below the freeze height (sdk/server/rollback.go:41) returns the node to the pre-activation binary state, and the activation runs again to the same app hash."
ac_5 = "The activation values (H_act, L, ReceiptKeys, module_id) are set at activation rehearsal and carried by the upgrade plan and the module genesis only (node/upgrades.go:416-418)."

[req.9032]
title = "Record each block's sequence range with modules/sequencer MsgSequenceBatch in tx 0"
ac_1 = "MsgSequenceBatch carries height, fromSeq, toSeq, prevSeqHash, lastSeqHash, txRoot, keyId and sig; sig is the receipt key's ed25519 signature over sha256(\"PAXEER/v1/sequence-batch\\0\" || chain-id || height || fromSeq || toSeq || prevSeqHash || lastSeqHash || txRoot) (agent/crates/layerx-wire/src/hash.rs:132; agent/crates/layerx-crypto/src/ed25519.rs:54-60)."
ac_2 = "The message is always tx 0 of a block at or above H_act, and the keeper refuses it at any other position or more than once per block (node/app.go:1462-1468)."
ac_3 = "fromSeq equals the stored lastSeq + 1 and prevSeqHash equals the stored lastSeqHash; after delivery the keeper stores toSeq and lastSeqHash (src/sequencer/lxp_sequence.c:45 is the kernel range check it replaces)."
ac_4 = "txRoot is the merkle root of the hashes of txs 1..n of the block, computed the same way by proposer and validators; a block with no receipted transactions carries fromSeq = lastSeq + 1, toSeq = lastSeq and the empty root (consensus/internal/state/execution.go:101)."
ac_5 = "The message is signer-free on the Cosmos side and pays no fee: the ante chain skips fee deduction for it the way the existing fee-free paths are routed (node/ante.go:39), and it is refused if submitted through CheckTx."

[req.9033]
title = "Pin the leader, check the proposal and keep header time honest"
ac_1 = "Leader(h, r) = L[r mod len(L)] at heights at or above H_act, replacing the proposer priority choice (consensus/internal/consensus/types/round_state.go:194 SafeRoundState.Leader; :422-437) and the proposer checks in consensus/internal/consensus/state.go (:1083, :1101)."
ac_2 = "The proposer's block is the sealed L_N from the executor through CreateProposalBlock (consensus/internal/state/execution.go:101, :131), and not a reap."
ac_3 = "ProcessProposal on validators (node/app.go:1457, consensus/internal/state/execution.go:135) runs nine checks: decode, tx 0 is the batch, height matches, fromSeq/prevSeqHash chain from the store, the signature verifies under a pinned keyId, txRoot matches txs 1..n, the seqHash chain over txs 1..n ends at lastSeqHash, the proposer is Leader(h, r), and total gas fits (node/app.go:1477); any failure answers REJECT (node/app.go:1462-1468)."
ac_4 = "Header time stays within the consensus timing tolerance (consensus/types/params.go:194-203, Precision 505 ms and MessageDelay 12 s, set at activation rehearsal) and is the time Open fixed for that height."
ac_5 = "The leader list L is read from modules/sequencer at heights at or above H_act and from no local file; consensus config only enables the mode (consensus/config/config.go:1161-1187)."

[req.9034]
title = "Fail over to the standby with no reordering and no duplicate seq"
ac_1 = "When the primary stops, the next round's leader under L[r mod len] is the standby; it reads the WAL it replicated, opens L_N+1 from its last COMMITTED entry, and continues seq from the last replicated ACCEPT (consensus/internal/consensus/types/round_state.go:422-437; consensus/internal/consensus/wal.go:269)."
ac_2 = "A receipt released by the primary is always present on the standby, because release waits for the standby ack (e2); no receipted transaction is dropped by a failover (consensus/internal/libs/wal/writer.go:106-111)."
ac_3 = "The lease epoch in the WAL (kind 5 LEASE) fences the old primary: a host whose epoch is lower than the latest LEASE refuses to Accept or Seal (cmd/layerx-handover/main.c:117)."
ac_4 = "Validators never accept two blocks for the same height from different leaders with overlapping seq ranges, because fromSeq must equal stored lastSeq + 1 (c2) (src/sequencer/lxp_sequence.c:45)."

[req.9035]
title = "Execute Sequential first and add MicroBatch behind the same interface"
ac_1 = "The executor exposes Accept, Seal and Open over the layers L_c, L_N and L_open; Sequential mode runs each transaction to completion on a per-transaction branch of L_open before the next (node/abci.go:169; sdk/baseapp/baseapp.go:822)."
ac_2 = "MicroBatch mode (D19) groups transactions received within a small window, executes them with the existing OCC scheduler (node/app.go:1888 OCCV2; node/abci.go:247 NewScheduler) in arrival order, and yields receipts equal to Sequential for the same order."
ac_3 = "Validators always run the existing block path with OCC on (node/app.go:1861 ExecuteTxsConcurrently, :1888) and need no executor mode of their own."
ac_4 = "The mode is chosen in the sequencer section of app config (node/sequencer/config.go) and defaults to Sequential; MicroBatch switches on only after the benchmark shows a gain at the target latency (daemon/paxd/cmd/root.go:397)."
ac_5 = "Seal adopts L_N as the block's execution so FinalizeBlocker on the sequencer reuses it, through the existing optimistic adoption path (node/app.go:1587-1604)."

[req.9036]
title = "Write every executor step to a framed WAL"
ac_1 = "Each WAL frame is crc32c || u32 length || entry, the framing of the existing consensus WAL (consensus/internal/libs/wal/writer.go:92-104), and a frame whose checksum fails ends replay at the last good frame (consensus/internal/libs/wal/reader.go:70-71)."
ac_2 = "Entries carry version 1 and one of kinds 1 OPEN (height, open time, base fee), 2 ACCEPT (seq, tx bytes, receipt bytes), 3 SEAL (height, fromSeq, toSeq, lastSeqHash), 4 COMMITTED (height, app hash) and 5 LEASE (epoch, host keyId) (consensus/internal/consensus/wal.go:244 is the append model)."
ac_3 = "Replay from the last COMMITTED entry re-executes the ACCEPT entries in order and reproduces each stored receipt byte for byte; a mismatch stops the sequencer with an error (consensus/internal/consensus/wal.go:269)."
ac_4 = "Segments below the last COMMITTED height that the block store retains are deleted by the same background worker as block pruning, never on the Accept path (consensus/internal/libs/wal/log.go:195-198)."

[req.9037]
title = "Group-sync the WAL and wait for the standby before releasing a receipt"
ac_1 = "Accept appends the ACCEPT frame, and receipts are released only after one fdatasync covering their frames (group sync, as consensus/internal/libs/wal/writer.go:106-111 does for consensus) has returned."
ac_2 = "Each ACCEPT frame is streamed to the standby, and the receipt is released only after the standby acknowledges that it has synced the frame (cmd/layerxd/lxp_daemon_replica.c:216)."
ac_3 = "If the standby does not acknowledge within the replication timeout, set at activation rehearsal, Accept answers an error to the client and the transaction is not receipted (rpc/send.go:139-141)."
ac_4 = "The standby applies frames in seq order and keeps its own L_open by re-executing ACCEPT entries; a gap in seq makes it request the missing range before acknowledging (src/sequencer/lxp_sequence.c:45)."

[req.9038]
title = "Hand over between hosts with a lease and no dropped seq"
ac_1 = "A planned handover writes a LEASE entry with a higher epoch on the standby after the primary stops accepting and its last ACCEPT is acknowledged; the existing kernel handover tool is the model for the step order (cmd/layerx-handover/main.c:117, :140)."
ac_2 = "During handover sends are refused with a retryable error and never receipted twice (cmd/layerx-handover/main.c:140)."
ac_3 = "After handover the new primary signs with its own receipt key, whose ReceiptKeys range already covers the open height (agent/crates/layerx-proof/src/inclusion.rs:14-19)."
ac_4 = "The new primary's L_open after handover equals the old primary's at the last acknowledged seq (node/app.go:2895-2906)."

[req.9039]
title = "State the guarantee a user holds after an unplanned stop"
ac_1 = "A signed receipt is a promise that the transaction will commit at its seq: after any unplanned stop of the primary, every receipt released is committed at the same seq with the same result (node/app.go:1462-1468; consensus/internal/libs/wal/writer.go:106-111)."
ac_2 = "A send that received an error or no answer may or may not be receipted; the client resolves it by reading the pending nonce or the receipt by hash, never by resending with the same nonce and a higher fee (rpc/tx.go:358, :106)."
ac_3 = "The rungs submitted, receipted and committed are reported by pax_sequencerReceipt; eth_getTransactionReceipt stays committed-only (rpc/tx.go:106)."
ac_4 = "If both hosts stop, recovery replays the WAL on whichever host holds the longer acknowledged log, and no receipt is ever signed twice for one seq (consensus/internal/consensus/wal.go:198, :269)."

[req.9040]
title = "Check sponsorship and fee payment before the receipt"
ac_1 = "Accept runs the full ante chain, including fee deduction (modules/evm/ante/fee.go:88-108) and the fee-token path (modules/evm/keeper/feetoken.go:92-108), so a receipt is never issued for a transaction that cannot pay."
ac_2 = "Sponsored transactions through BatchCallAndSponsor (contracts/src/BatchCallAndSponsor.sol:88-95, :113-120) are accepted only when the sponsor's signature and nonce check pass in the same execution that issues the receipt."
ac_3 = "The fee recorded in the receipt equals the fee committed by the block path, including RouteCollectedFeeTokens (node/app.go:2165)."
ac_4 = "Deferred balance writes (node/app.go:2151 WriteDeferredBalances) are applied at Seal so L_N state equals the committed state."

[req.9041]
title = "Meet the receipt latency target and the block path budget"
ac_1 = "Receipt latency from send arrival to receipt release has p50 at most 10 ms on the rehearsal hardware with Sequential mode, WAL group sync and standby ack included (rpc/send.go:76; src/storage/lxp_log.c:179 is the kernel sync it replaces)."
ac_2 = "Consensus timeouts at activation are TimeoutPropose 1 s with 500 ms added per round, TimeoutVote 50 ms and TimeoutCommit 50 ms (consensus/config/config.go:1161-1187), set at activation rehearsal."
ac_3 = "Block limits stay MaxGas 100M, MaxGasWanted 50M and MaxBytes 22020096 (consensus/types/params.go:135-143, :168-176), and Seal closes L_N before either limit is crossed (node/app.go:1477 checkTotalBlockGas)."
ac_4 = "The measured block path (ApplyBlock about 174 ms and prune about 120 ms on the slower validator host) is cut by moving prune off ApplyBlock (req 9.18); the sequencer never waits on prune (consensus/internal/state/execution.go:200, :418)."

[req.9042]
title = "Wire the sequencer into paxd"
ac_1 = "paxd gains a sequencer section in app config read at start (daemon/paxd/cmd/root.go:287, :288, :397) with mode, WAL directory, receipt key file, standby address and replication timeout; validation refuses a sequencer section missing the key file or WAL directory."
ac_2 = "node/app.go builds the executor after the keepers and handlers are set (node/app.go:1142, :1143) and registers the pending context provider (node/app.go:2895-2906) and the send path."
ac_3 = "The JSON-RPC server registers pax_sequencerReceipt (rpc/server.go:134) and the pending handlers only in sequencer or standby mode; on other nodes the same method forwards to the sequencer."
ac_4 = "The sequencer exposes metrics for receipt latency, WAL sync time, standby ack time, open seq and sealed height on the existing telemetry path (consensus/internal/libs/wal/writer.go:106-111; node/app.go:1551)."

[req.9043]
title = "Rehearse activation on a cluster before the activation height"
ac_1 = "The upgrade integration test (integration_test/upgrade_module/major_upgrade_test.yaml:25 shape; cluster from integration_test/upgrade_module/scripts/launch_cluster.sh:7; runner integration_test/scripts/runner.py:86) runs a four-validator cluster through H_act with a sequencer and standby."
ac_2 = "Golden values for the first ten heights after H_act (app hash, batch ranges, receipt digests) are recorded and compared on a second run (integration_test/upgrade_module/major_upgrade_test.yaml:25)."
ac_3 = "The e2e manifest gains a sequencer network (consensus/test/e2e/pkg/manifest.go:13, :85, :169) that pins the leader and runs a failover."
ac_4 = "The rehearsal sets every value marked set at activation rehearsal (H_act, L, ReceiptKeys, module_id, timeouts, replication timeout) and records them with the cluster result (integration_test/scripts/runner.py:86)."

[req.9044]
title = "Retire the kernel sequencer constructs with a named replacement for each"
ac_1 = "Kernel admission (src/sequencer/lxp_admission.c:58, :80) is replaced by Accept on the Paxeer node, which runs the ante chain."
ac_2 = "Kernel batch seal and sequence numbering (src/sequencer/lxp_batch_seal.c:19, :62, :100; src/sequencer/lxp_sequence.c:45) are replaced by Seal and the seqHash chain recorded by MsgSequenceBatch."
ac_3 = "Kernel receipts (src/protocol/lxp_receipt.c:859, :886) are replaced by the ProtocolReceipt v2 envelope signed by node/sequencer in the same wire layout."
ac_4 = "The kernel batch WAL, replica and log (cmd/layerxd/lxp_daemon_batch_wal.c:362; cmd/layerxd/lxp_daemon_replica.c:216; src/storage/lxp_log.c:179, :498) are replaced by node/sequencer/wal and the standby stream."
ac_5 = "Kernel fee and budget spend (src/protocol/lxp_fee.c:185, :232; src/modules/budget/lx_budget_spend.c:16, :76) and the gateway send (src/network/lxp_gateway_send.c:467) are replaced by the EVM fee path, DID budgets through the precompile at 0x...1004 and eth_sendRawTransaction."

