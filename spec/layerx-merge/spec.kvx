interface = "A guest web request is captured at src/modules/programs/call.c:1867 and becomes one pending origin-2 xweb request."
fee = "The fee is escrowed in the same call to the xweb module account in place of src/modules/programs/call.c:591."
result = "web_read (programs/crates/layerx-programs-runtime/src/host/web.rs:17) returns the stored result; the view begins at src/modules/programs/call.c:1182."

[contract_context.4.replay]
invariants = "Two validators executing the same block produce equal app hashes; replay capture is taken at src/modules/programs/call.c:3138."
profile = "The call profile decode at src/modules/programs/call.c:2952 stays byte-identical."
staging = "Replay capture stages through src/modules/programs/state_record.c:534."

[contract_context.4.reference_guests]
interface = "The interpreter, compute-lease market and AI market guests (programs/crates/layerx-programs-interpreter/src/lib.rs:521, programs/crates/layerx-programs-market/src/lib.rs:841) are deployed at activation."
build = "The guests are workspace members of programs/Cargo.toml:6-8 and build reproducibly."
invariants = "Each deployed code hash equals its expected hash or the bring-up stops (src/modules/programs/deploy.c:453)."

[contract_context.4.ai_market_ops]
market = "Market ops CREATE to REVOKE_OPERATOR (programs/crates/layerx-programs-ai-market/src/dispatch.rs:78, programs/crates/layerx-programs-ai-market/src/dispatch.rs:86) are routed by programs/crates/layerx-programs-ai-market/src/dispatch.rs:901."
required_change = "Required change: closure (programs/crates/layerx-programs-ai-market/src/closure.rs:670) and the F05 to F08 families (programs/crates/layerx-programs-ai-market/src/aggregation.rs:1280, programs/crates/layerx-programs-ai-market/src/rewards.rs:2355, programs/crates/layerx-programs-ai-market/src/epoch.rs:1432, programs/crates/layerx-programs-ai-market/src/admission.rs:741) gain dispatch arms."
reads = "READ_HEADER and READ_STATE_CHUNK use the ProgramRead boundary programs/crates/layerx-programs-ai-market/src/dispatch.rs:19-22."
caller = "Only a direct principal may act (programs/crates/layerx-programs-ai-market/src/host_adapter.rs:57)."

[contract_context.4.ai_windows]
windows = "Commit and reveal windows are programs/crates/layerx-programs-ai-market/src/commit_reveal.rs:63-66 counted by execution height (programs/crates/layerx-programs-ai-market/src/commit_reveal.rs:487); the duplicate constants at programs/crates/layerx-programs-ai-market/src/evidence.rs:1590-1591 change with them."
epoch = "The epoch length is programs/crates/layerx-programs-ai-market/src/aggregation.rs:356; all heights are set at activation rehearsal (decision.7)."
domain = "The chain domain is programs/crates/layerx-programs-ai-market/src/lib.rs:52, set for the chain id at activation rehearsal."
bounds = "Envelope and state bounds are programs/crates/layerx-programs-ai-market/src/lib.rs:199 and programs/crates/layerx-programs-ai-market/src/lib.rs:204."

[contract_context.4.ai_finality]
binding = "Snapshot binding v2 (programs/crates/layerx-programs-ai-market/src/queries.rs:309) carries block hash, app hash with an ICS23 proof and block-commit finality."
finality = "require_finalized (programs/crates/layerx-programs-ai-market/src/queries.rs:395) accepts block commit in place of programs/crates/layerx-programs-ai-market/src/queries.rs:24."
consumers = "The indexer AI projection (platform/hosted/indexer/src/ai_market.rs:29) and history projection (platform/hosted/indexer/src/ai_reputation.rs:186), gateway AI views (platform/hosted/gateway/src/ai_views.rs:21) and webhooks accept v2 bindings."

[contract_context.4.ai_value]
grants = "Each reward effect performs at most one native 402LXP action under programs/crates/layerx-programs-ai-market/src/value_adapter.rs:110 or programs/crates/layerx-programs-ai-market/src/value_adapter.rs:121."
account = "The rewards account is derived from programs/crates/layerx-programs-ai-market/src/lib.rs:198."
quorum = "Aggregation uses programs/crates/layerx-programs-ai-market/src/aggregation.rs:55 and programs/crates/layerx-programs-ai-market/src/aggregation.rs:76; the evaluator floor is programs/crates/layerx-programs-ai-market/src/policy.rs:102."

[contract_context.4.ai_services]
worker = "paxai-worker binds authority (platform/hosted/paxai-worker/src/discovery.rs:105) from proven chain state and keeps platform/hosted/paxai-worker/src/discovery.rs:48."
worker_submit = "Results signed at platform/hosted/paxai-worker/src/jobs.rs:222-238 are submitted as EVM transactions to 0x101D."
artifacts = "ai-artifacts starts retention at commit heights (platform/hosted/ai-artifacts/src/retention.rs:414, platform/hosted/ai-artifacts/src/retention.rs:474) and recovers by re-reading bindings (platform/hosted/ai-artifacts/src/retention.rs:717)."
