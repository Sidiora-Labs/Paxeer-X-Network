[capability.1.1.1]
title = "cgo C-module host shim and global_sequence source"
reqs = ["1001.1", "1001.2", "1001.3", "1001.4", "1002.1", "1002.3", "1002.4"]
touches = ["modules/lxphost/host.go", "modules/lxphost/ctx.go", "modules/lxphost/host_test.go"]
tests = ["modules/lxphost/host_test.go"]
verification_contract = "make build && go test -count=1 ./modules/lxphost/ -run 'TestHost'"
do_1 = "Create modules/lxphost/host.go with a cgo preamble linking the static kernel library built by the Makefile build target (Makefile:210), with the #cgo LDFLAGS and import \"C\" shape of wasm-runtime/internal/api/link_system.go:5-6 and a cgo build tag as wasm-runtime/version_cgo.go:1."
do_2 = "Host owns one kernel per node created with lxp_kernel_create (include/layerx/lxp_kernel.h:277, src/protocol/lxp_kernel.c:1729) and exposes Execute(ctx sdk.Context, activity, authority) that calls lxp_kernel_execute_activity (include/layerx/lxp_kernel.h:641, src/protocol/lxp_kernel.c:6949)."
do_3 = "Create modules/lxphost/ctx.go: before each call it loads the module_kv entries (include/layerx/lxp_kernel.h:38-44) the activity may read from the transaction branch store and writes the staged entries back to the same branch, so lxp_ctx_kv_get and lxp_ctx_kv_put (include/layerx/lxp_module.h:105-174) see only committed plus same-transaction state."
do_4 = "ctx.go sets the batch timestamp to the block time in milliseconds and the journal global_sequence (include/layerx/lxp_state.h:52) to the transaction sequence, so lxp_ctx_global_sequence (src/protocol/lxp_module_ctx.c:3162-3165) returns it; a sequence not above the last committed one returns LXP_ERR_SEQUENCE_REUSED (include/layerx/lxp_result.h:72)."
do_5 = "Create modules/lxphost/host_test.go with TestHostLinksKernel, TestHostNoStateAcrossTxs, TestHostDeterministicAppHash (program goldens through programs_execute, src/modules/programs/registration.c:164), TestHostNoAmbientInputs, TestHostGlobalSequence and TestHostSequenceMonotonic."
symbols = ["Host", "Host.Execute", "branchCtx", "TestHostLinksKernel", "TestHostNoStateAcrossTxs", "TestHostDeterministicAppHash", "TestHostNoAmbientInputs", "TestHostGlobalSequence", "TestHostSequenceMonotonic"]

[capability.1.1.2]
title = "Shim execute bridge with account-holder authority and LXP error text"
reqs = ["1001.2", "1010.2", "1010.5"]
touches = ["modules/lxphost/execute.go", "modules/lxphost/execute_test.go"]
tests = ["modules/lxphost/execute_test.go"]
verification_contract = "make build && go test -count=1 ./modules/lxphost/ -run 'TestExecute|TestResultErrorText'"
do_1 = "Create modules/lxphost/execute.go with ExecuteActivity(ctx, Authority, activityType, payload) building the kernel activity and calling Host.Execute, which reaches lxp_kernel_execute_activity (src/protocol/lxp_kernel.c:6949)."
do_2 = "Authority carries kind LXP_AUTHORITY_OWNER (include/layerx/lxp_authority.h:12), verified key = the bound DID key, actor = lxp_did_id_derive (src/state/lxp_identity.c:46-56) of did:layerx:<hex key>, principal = the account id; the kernel checks it at src/modules/asset/lx_asset_execution.h:175-182."
do_3 = "Admission binds the principal sequence before the call, as lxp_kernel_bind_ledger_admission does for ACCOUNT_OPEN and WITHDRAW (src/protocol/lxp_kernel.c:463-471)."
do_4 = "ResultError(code) returns an error whose text is LXP_<CODE> from lxp_result_name (include/layerx/lxp_result.h:163, src/protocol/lxp_result.c:3) with the ERR_ prefix removed; LXP_FATAL_SUPPLY_MISMATCH keeps its full name."
do_5 = "Create modules/lxphost/execute_test.go with TestExecuteAuthorityFromBinding and TestResultErrorText."
symbols = ["ExecuteActivity", "Authority", "ResultError"]

[capability.1.1.3]
title = "Shim read bridge over exported C read helpers"
reqs = ["1033.4", "1004.3"]
touches = ["modules/lxphost/read.go", "modules/lxphost/read_test.go"]
tests = ["modules/lxphost/read_test.go"]
verification_contract = "make build && go test -count=1 ./modules/lxphost/ -run TestReadBridge"
do_1 = "Create modules/lxphost/read.go with ReadAsset (lx_asset_lookup, include/layerx/lx_asset.h:242), ReadBalance (lx_asset_balance_get, include/layerx/lx_asset.h:263) and ReadTotalUnits (lx_asset_total_units, include/layerx/lx_asset.h:273)."
do_2 = "ReadAccountOwner calls lx_account_owner_did (include/layerx/lxp_ledger.h:288) and ReadAccount calls lx_account_lookup (src/ledger/lx_account_registry.c:551-573)."
do_3 = "ReadSessionKey calls lxp_governance_session_key_read (task 1.0.2) and ReadPayerGrant calls lx_asset_payer_grant_read (task 1.0.3)."
do_4 = "ReadIdempotentReceipt calls the kernel receipt read at src/protocol/lxp_kernel.c:7091-7101, which decodes the stored receipt on replay."
do_5 = "Create modules/lxphost/read_test.go with TestReadBridgeNoRawKeys (no asset: or grant: key literal in the package) and TestReadBridgeValues against a kernel populated through ExecuteActivity."
symbols = ["ReadAsset", "ReadBalance", "ReadTotalUnits", "ReadAccountOwner", "ReadAccount", "ReadSessionKey", "ReadPayerGrant", "ReadIdempotentReceipt"]

[capability.1.1.4]
title = "OCC equals sequential execution through the shim"
reqs = ["1001.5"]
