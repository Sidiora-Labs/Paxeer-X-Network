[feature.13]
name = "resolutions"
scope = "Rulings that bind every other domain of the LayerX merge into the Paxeer X Network: the thirty-four decisions, the index and gap resolutions, the triaged rows, the cross-report items and the frozen contract clauses, each stated as one normative sentence, with requirements, acceptance scenarios and bounded tasks for the rulings that change code."
requirements = ["13001", "13002", "13003", "13004", "13005", "13006", "13007", "13008", "13009", "13010", "13011", "13012", "13013", "13014", "13015", "13016", "13017", "13018", "13019", "13020", "13021", "13022", "13023", "13024", "13025", "13026", "13027"]
completion_task = "13.7.4"

[resolution.13.1]
title = "Kernel C modules and the program runtime run inside paxd"
contract = "The kernel C modules and the Rust program runtime execute through cgo behind an lxp_module_ctx shim inside the chain keepers, entered through the existing module execute functions (src/modules/programs/registration.c:164, src/modules/programs/deploy.c:485) and linked as the node already links cgo code (wasm-runtime/version_cgo.go:1)."
applies_to = ["1.*", "2.*", "3.*", "4.*", "13.2.2"]
source = "decision D1"

[resolution.13.2]
title = "Kernel accounts are derived bank addresses"
contract = "A kernel account is the bank address address.Module(\"layerx\", kernel 32-byte account id) (sdk/types/address/hash.go:63) over the kernel id of the DID and sub-account suffix (include/layerx/lxp_genesis.h:148-149), and trading margin uses the same namespace."
applies_to = ["1.*", "3.*", "4.*", "5.*", "13.2.2"]
source = "decision D2"

[resolution.13.3]
title = "Session keys and delegated authorities are LayerX-scope authz grants"
contract = "Session keys and delegated capabilities are sdk/x/authz grants whose Authorization (sdk/x/authz/authorizations.go:11) carries the kernel authority kind, keeping all eight kinds of include/layerx/lxp_authority.h:11-19."
applies_to = ["1.*", "10.*", "13.3.8"]
source = "decision D3"

[resolution.13.4]
title = "No claim settlement at the activation height"
contract = "Activation is a bring-up at the activation height; no account-state migration is required, so no claim is settled and the activation handler only returns every posted guarantor bond and open challenge deposit held by the anchor module (precompiles/layerxanchor/layerxanchor.go:227-242)."
applies_to = ["11.*", "8.*", "13.7.2"]
source = "decision D4"

[resolution.13.5]
title = "No unbound-balance placement at the activation height"
contract = "Activation is a bring-up at the activation height; no account-state migration is required, so the activation handler creates no claim record and no held balance for any kernel account without an addr 0x1004 binding."
applies_to = ["11.*", "10.*", "13.7.2"]
source = "decision D5"

[resolution.13.6]
title = "Precompile reverts carry Error(string) LXP_<code>"
contract = "Every new precompile reverts with Error(string) whose text starts LXP_<code>, built through RevertReason (precompiles/common/precompiles.go:59) and WithRevertReasons (precompiles/common/precompiles.go:53)."
applies_to = ["1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "13.3.4"]
source = "decision D6"

[resolution.13.7]
title = "Receipt timestamp fixed at pending-block open"
contract = "The receipt timestamp is the pending-block open time read through lxp_ctx_batch_timestamp_ms (include/layerx/lxp_module.h:151); height windows for AI and markets and the fee-token rate age are re-tuned for the sequencer cadence and set at activation rehearsal."
applies_to = ["9.*", "4.*", "3.*", "13.1.1"]
source = "decision D7"

[resolution.13.8]
title = "Trading semantics follow the kernel with chain-derived order ids"
contract = "Order ids derive from (chain, caller, nonce) using the per-account nonce of modules/layerxexchange/keeper/keeper.go:109, launchpad fees accumulate per market instead of the global write at modules/launchpad/keeper/swap.go:172, books keep capacity 256 and 8 fills per dispatch (include/layerx/lx_perps.h:27, include/layerx/lx_perps.h:34), and the spot settlement request stays refused (src/modules/spot/lx_spot_dispatch.c:11-14)."
applies_to = ["3.*", "13.4.1", "13.4.2"]
source = "decision D8"

[resolution.13.9]
title = "Program fee kept on top of near-zero gas"
contract = "The program fee of metering times prices, held under the fee key of src/modules/programs/fees.c:20, is charged in addition to EVM gas, and a quoteCallFee view returns it for fee projection."
applies_to = ["4.*", "13.4.6"]
source = "decision D9"

[resolution.13.10]
title = "Paid search settles as one draw per request at 0x101A"
contract = "Paid web search settles one draw per request through layerxledger at 0x101A at USD 0.001 per request, and the global MinimumFeePerGas (modules/evm/types/params.go:81) is set at or below 0.067 gwei so the draw sender pays near-zero gas without a sender-class parameter."
applies_to = ["1.*", "5.*", "13.3.7", "13.1.2"]
source = "decision D10"

[resolution.13.11]
title = "Program-origin web requests keep the kernel fee terms"
contract = "Origin 2 (modules/xweb/types/attestation.go:20) keeps the kernel per-asset fee with any-amount and no-refund parity, carried as an origin-2 fee table in the xweb params; the intake records the fee with no refund path (src/modules/web/lx_web_intake.c:510-511)."
applies_to = ["5.*", "4.*", "13.4.3"]
source = "decision D11"

[resolution.13.12]
title = "Program-origin observations admit at most 16 signers"
contract = "Origin-2 observations admit at most 16 signers (include/layerx/lx_web.h:29-30) out of the xweb attestor set capped at 64 (modules/xweb/types/keys.go:19-21), and the kernel network id is an xweb param instead of the EVM chain id used at modules/xweb/keeper/fulfil.go:72."
applies_to = ["5.*", "13.4.4"]
source = "decision D12"

[resolution.13.13]
title = "Reference guests deploy through MsgDeploy at activation"
contract = "The interpreter, compute-lease market and AI market reference guests are deployed at the activation height through MsgDeploy with expected code hashes, the hashes pinned against programs/abi-frozen.sha256:1."
applies_to = ["4.*", "13.7.4"]
source = "decision D13"

[resolution.13.14]
title = "Sponsored writes go through one gas-station path with DID budgets"
contract = "Every sponsored agent write is one EIP-7702 executeSponsored batch (contracts/src/BatchCallAndSponsor.sol:135) through the gas station with one paymaster nonce, and per-identity budgets live in the gas-station policy (interop/crates/layerx-gas-station/src/policy.rs:98-107) keyed by the DID read through addr 0x1004 (precompiles/addr/addr.go:391-399)."
applies_to = ["7.*", "8.*", "6.*", "13.1.3", "13.5.2"]
source = "decision D14"

[resolution.13.15]
title = "Receipts are signed by a separate ed25519 receipt key per host"
contract = "Each sequencer host holds its own ed25519 receipt key, distinct from the validator key, pinned with a height range in the sequencer ReceiptKeys param and in the authority service, and verified by the pinned 32-byte key check of agent/crates/layerx-proof/src/receipt.rs:631."
applies_to = ["9.*", "7.*", "13.1.4", "13.5.4"]
source = "decision D15"

[resolution.13.16]
title = "DID key rotation belongs to the wallet feature"
contract = "DID key rotation and the embedded-wallet ed25519 share are out of scope for this feature because they are decided with the wallet feature; addr 0x1004 gains no rotation or recovery method and keeps the binding read of precompiles/addr/addr.go:391-399."
applies_to = ["10.*", "8.*"]
source = "decision D16"

[resolution.13.17]
title = "Clients move to a clean break"
contract = "Clients move to agent-api major 2 (from major 1 at agent/schema/agent-api/v1.kvx:3), write rungs submitted, receipted and committed (replacing human/wallet/sdk/src/ladder.ts:4), no same-nonce replacement, no pending receipts on eth_getTransactionReceipt, and lx_* ingress switched off at activation with JSON-RPC -32601."
applies_to = ["10.*", "6.*", "8.*", "13.6.1", "13.6.6"]
source = "decision D17"

[resolution.13.18]
title = "One activation-height fork for the sequencer"
contract = "From the activation height BeginBlock(N+1) is fed the votes of N-1 (node/legacyabci/begin_block.go:61), modules/sequencer carries MsgSequenceBatch, and Leader() (consensus/internal/consensus/types/round_state.go:422) follows the pinned leader list."
applies_to = ["9.*", "13.1.1"]
source = "decision D18"

[resolution.13.19]
title = "Sequencer executes in receipt order, sequential first"
contract = "The sequencer lands the strictly sequential executor on the CacheTxContext pattern (sdk/baseapp/baseapp.go:822) first, and switches to OCC micro-batches over DeliverTxBatch (node/abci.go:230) in receipt order only on measurement."
applies_to = ["9.*", "13.1.1"]
source = "decision D19"

[resolution.13.20]
title = "Legacy surfaces kept as real surfaces"
contract = "layerxctl stays an operator EVM client (cmd/layerxctl/src/main.rs:186), the program registry service is a read cache over the programs module (platform/hosted/registry/src/program_state.rs:5), and the eight agent functions 0x0901-0x0908 become real precompiles."
applies_to = ["6.*", "7.*", "4.*", "13.6.3"]
source = "decision D20"

[resolution.13.21]
title = "layerxAnchor reads served until bonds are returned"
contract = "layerxAnchor 0x1014 reads are served until every posted guarantor bond is returned, then the store is deleted and the retired executor stays at the address registered at precompiles/setup.go:83."
applies_to = ["11.*", "13.7.1"]
source = "decision D21"

[resolution.13.22]
title = "Agent functions 0x0901-0x0904 implemented anew"
contract = "orob, clearing, oracle and pofq are re-specified from the earlier implementation and implemented anew as real precompiles registered in GetCustomPrecompiles (precompiles/setup.go:63), so no gateway route at human/wallet/gateway/src/precompiles.ts:17-25 targets an empty address."
applies_to = ["6.*", "13.3.12"]
source = "decision D22"

[resolution.13.23]
title = "addr and bank return LXP_ reasons"
contract = "addr 0x1004 and bank 0x1001 opt into a reason path in the dynamic-gas base, whose error path today drops the reason (precompiles/common/precompiles.go:177-184), and return Error(string) LXP_<code>."
applies_to = ["10.*", "13.3.5", "13.3.6"]
source = "decision D23"

[resolution.13.24]
title = "Service disputes resolved by the linked escrow arbiter"
contract = "A service dispute is resolved only by the linked escrow arbiter, replacing the party check of src/modules/service/lx_service_dispute.c:85-90, and the linked escrow settles on the ruling in the same call, with new codes LXP_ERR_ARBITER_REQUIRED, LXP_ERR_UNAUTHORIZED_ARBITER and LXP_ERR_ESCROW_LINK_MISMATCH."
applies_to = ["2.*", "13.3.3"]
source = "decision D24"

[resolution.13.25]
title = "withdrawMargin is a bank release behind a free-margin check"
contract = "withdrawMargin (precompiles/layerxexchange/layerxexchange.go:52) takes a market argument and releases funds from the caller's margin address to its main address in the same transaction behind a free-margin check (src/modules/perps/lx_perps_position.c:95), replacing the request record of modules/layerxexchange/keeper/intents.go:82."
applies_to = ["3.*", "13.4.1"]
source = "decision D25"

[resolution.13.26]
title = "Embedded-wallet attestors sign for the web payer"
contract = "The agent-host web payer (agent/crates/layerx-agentd-host/src/payer.rs:45) is signed by the embedded-wallet attestor set, one attestor set for all custody, replacing the KMS grant signer of human/crates/layerx-human-kms/src/attestor.rs:594."
applies_to = ["6.*", "8.*", "13.5.3"]
source = "decision D26"

[resolution.13.27]
title = "payExact is a typed send emitting PaymentExact"
contract = "payExact at 0x101A is a typed send (include/layerx/lxp_ledger.h:138) whose payment reference is the send idempotency key, and the precompile emits PaymentExact from the applied transfer set."
applies_to = ["1.*", "5.*", "13.3.7"]
source = "decision D27"

[resolution.13.28]
title = "xweb errors use LXP_XWEB_* names for Go origin"
contract = "Errors raised by the xweb Go module (modules/xweb/types/errors.go:6-29) carry LXP_XWEB_<NAME>, and origin-2 errors raised by the kernel web intake keep their kernel codes."
applies_to = ["5.*", "13.4.3"]
source = "decision D28"

[resolution.13.29]
title = "Agent streams keep one stream state"
contract = "Agent streams 0x0906 hold no store and execute through the layerxpay 0x101B stream keeper over the kernel stream activities (include/layerx/lx_stream.h:26-32)."
applies_to = ["2.*", "6.*", "13.3.10"]
source = "decision D29"

[resolution.13.30]
title = "Fixed per-method gas tables"
contract = "Every new precompile charges from a fixed per-method gas table in the form of the existing exchange precompile Gas() (precompiles/layerxexchange/layerxexchange.go:182); kernel gas units stay internal and are not converted."
applies_to = ["1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "13.3.4"]
