do_1 = "Opt the addr precompile into the reason path that task 0.1 adds to DynamicGasPrecompile.RunAndCalculateGas (precompiles/common/precompiles.go:177-205): pass the option where NewDynamicGasPrecompile is called (precompiles/addr/addr.go:123), gated on the merge plan so heights below it keep the empty revert of precompiles/common/precompiles.go:179-185."
do_2 = "Add lxpReason(err) in precompiles/addr/addr.go mapping the binding errors of modules/evm/types/layerx_binding.go:28-37: NotBound to LXP_UNKNOWN_DID, Signature and SignatureLength to LXP_BAD_SIGNATURE, AddressBound and DidBound to LXP_DUPLICATE_ENTRY, NonceExhausted to LXP_SEQUENCE_EXHAUSTED, NonCanonicalKey and ChainID to LXP_NON_CANONICAL (include/layerx/lxp_result.h:33-78)."
do_3 = "Make getLayerXDid (precompiles/addr/addr.go:391-405) wrap ErrLayerXNotBound instead of the plain fmt error at precompiles/addr/addr.go:400-401 so the mapping resolves it to LXP_UNKNOWN_DID."
do_4 = "Route bind and unbind errors (precompiles/addr/addr.go:156-171) through lxpReason; the method dispatch at precompiles/addr/addr.go:141-180 gains no method (rotation and recovery are out of scope for this feature, decision D16)."
do_5 = "Add TestLayerXReasonsFromPlanHeight to precompiles/addr/layerx_binding_test.go beside TestLayerXBindRefusalsThroughPrecompile (precompiles/addr/layerx_binding_test.go:176), asserting the reason at the plan height and the empty revert one height below."
symbols = ["lxpReason", "getLayerXDid", "TestLayerXReasonsFromPlanHeight"]

[capability.1.2.2]
title = "bank 0x1001 context-hash overload with LayerXReceipt"
reqs = ["1006.1", "1006.2", "1006.3", "1006.4", "1006.5", "1007.2", "1007.1"]
touches = ["precompiles/bank/bank.go", "precompiles/bank/abi.json", "precompiles/bank/Bank.sol", "precompiles/bank/bank_test.go"]
