tests = ["precompiles/common/retire_test.go::TestRetiredAtMergePlan"]
verification_contract = "go test -count=1 ./precompiles/common/ -run TestRetiredAtMergePlan"
do_1 = "In precompiles/common add RetiredRevert(ctx, name) that checks IsUpgradeActiveAtHeight for the merge plan (sdk/x/upgrade/keeper/keeper.go:296-299) and returns RevertReason (precompiles/common/precompiles.go:59-66) with code LXP_MODULE_DISABLED and message \"<name> retired\"."
do_2 = "In layerxverify Execute (precompiles/layerxverify/layerxverify.go:188) call RetiredRevert before the method switch so all five methods (precompiles/layerxverify/layerxverify.go:44-48) stop at H."
do_3 = "In layerxcustody Execute (precompiles/layerxcustody/layerxcustody.go:219) call RetiredRevert before the switch over the twenty methods (precompiles/layerxcustody/layerxcustody.go:52-72), and pass the reason option at WithRevertReasons (precompiles/layerxcustody/layerxcustody.go:159)."
do_4 = "In layerxanchor Execute (precompiles/layerxanchor/layerxanchor.go:189) call RetiredRevert for every method that isView (precompiles/layerxanchor/layerxanchor.go:131) reports as a write, and for reads only once the anchor store-delete height is reached."
do_5 = "In precompiles/common/retire_test.go add TestRetiredAtMergePlan covering one method of each address at H-1, H and D, asserting the exact LXP_MODULE_DISABLED string and that the address is still in the map of precompiles/setup.go:81-83."
symbols = ["RetiredRevert", "TestRetiredAtMergePlan", "isView", "Execute"]

