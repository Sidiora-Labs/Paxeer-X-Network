[feature.7]
name = "services"
scope = "Off-chain platform services of the Paxeer X Network after the merge: the unified router relays user-signed EVM transactions to the sequencer and answers px_ methods from one source, hosted services verify signed sequencer receipts and committed inclusion in place of the kernel checkpoint path, gas sponsorship and the paymaster rate run with registered senders and per-DID budgets, chain drivers submit construct operations as EVM transactions, node operation adds the sequencer pair and the archive node, monitoring and rollout cover the merged set, and the kernel-only services retire; a bring-up at the activation height; no account-state migration is required."
requirements = ["7001", "7002", "7003", "7004", "7005", "7006", "7007", "7008", "7009", "7010", "7011", "7012", "7013", "7014", "7015", "7016", "7017", "7018", "7019", "7020", "7021", "7022", "7023", "7024", "7025", "7026", "7027", "7028", "7029", "7030", "7031", "7032", "7033", "7034", "7035", "7036", "7037", "7038", "7039", "7040", "7041", "7042", "7043", "7044", "7045", "7046", "7047"]
completion_task = "7.7.5"

[req.7001]
title = "Router reads answer from the sequencer and chain state, lx_ read names retired"
ac_1 = "Every lx_ read name that today maps to a kernel core path (account, DID, receipt, batch, checkpoint and asset reads at platform/hosted/gateway/src/rpc.rs:286-291) answers JSON-RPC -32601 from the activation height, and the same facts are served by eth_getBalance, bank 0x1001 balance (precompiles/bank/bank.go:24) and addr 0x1004 reads."
ac_2 = "The kernel backend table that classifies lx_ names (platform/hosted/gateway/src/rpc.rs:338, read names at platform/hosted/gateway/src/rpc.rs:342-357) is removed, so no lx_ name reaches a kernel core upstream after activation."
ac_3 = "Receipt reads are served by eth_getTransactionReceipt for inclusion (rpc/tx.go:106) and by pax_sequencerReceipt(txHash) for the signed ProtocolReceipt v2; checkpoint reads are replaced by block header and commit reads, with no anchor read."
ac_4 = "Historical proof reads (eth_getProof at a past height, rpc/state.go:110) are routed to the archive node; a past-height read never falls back to the current height."

[req.7002]
title = "Router write path relays user-signed EVM transactions to the sequencer"
ac_1 = "lx_sendActivity (platform/hosted/gateway/src/rpc.rs:341) and the program write routes (platform/hosted/gateway/src/rpc.rs:544-550) answer -32601 from the activation height; writes arrive as eth_sendRawTransaction and are relayed unchanged to the sequencer (rpc/send.go:76)."
ac_2 = "The router holds no signing key and never relays an unsigned or router-signed write: node signing methods stay refused (platform/hosted/gateway/src/evm.rs:17)."
ac_3 = "When the sequencer is unreachable the router refuses writes with -32003 and never queues them; the earlier send function (platform/hosted/gateway/src/rpc.rs:554) is removed with the kernel path."
ac_4 = "After a successful relay the receipt is served from pax_sequencerReceipt with rung submitted, receipted or committed; eth_sendRawTransaction on the chain today returns only the hash (rpc/send.go:159), so the receipt is a separate read."

[req.7003]
title = "Fee estimates come from the sequencer pending state"
ac_1 = "lx_estimateFee (platform/hosted/gateway/src/rpc.rs:417-423) answers -32601 from the activation height; the estimate is eth_estimateGas at the pending tag relayed to the sequencer."
ac_2 = "A SID-denominated fee for a self-paid account is the chain conversion of the PAX fee by the fee-token rate (modules/evm/keeper/feetoken.go:46-47); the router adds no fee schedule of its own."
ac_3 = "Pending-tag calls (eth_call rpc/simulate.go:151, eth_estimateGas, eth_getTransactionCount rpc/tx.go:358) are relayed to the sequencer; any other node answers the pending tag with -32000."

[req.7004]
title = "Registration and faucet move to px_register and px_requestFunds"
ac_1 = "lx_register (platform/hosted/gateway/src/rpc_register.rs:399) is served as px_register with the same request shape and the same binding digest (platform/hosted/gateway/src/rpc_register.rs:96); the lx_ name answers -32601 from the activation height."
ac_2 = "lx_requestFunds (platform/hosted/gateway/src/rpc_faucet.rs:358) is served as px_requestFunds over the same claim path (platform/hosted/gateway/src/rpc_faucet.rs:10) and starter-credit grant (platform/hosted/gateway/src/rpc_faucet.rs:280)."
ac_3 = "A pending or refused claim is never reported as funded (platform/hosted/gateway/src/rpc_faucet.rs:510); the starter credit settles only on a funded claim (platform/hosted/gateway/src/rpc_faucet.rs:326)."
ac_4 = "The CLI faucet command (platform/cli/src/faucet.rs:18) calls px_requestFunds."

[req.7005]
title = "Subscriptions relay eth_subscribe to the sequencer"
ac_1 = "The router relays eth_subscribe for logs and newPendingTransactions to the sequencer instead of the -32004 refusal (platform/hosted/gateway/src/paxeer.rs:172)."
ac_2 = "lx_subscribe and lx_unsubscribe (platform/hosted/gateway/src/ws.rs:286, platform/hosted/gateway/src/ws.rs:293) and the lx_subscription notification (platform/hosted/gateway/src/ws.rs:347) answer -32601 from the activation height."
ac_3 = "The HTTP lx_subscribe refusal (platform/hosted/gateway/src/rpc.rs:404-407) is replaced by -32601 for the lx_ name; the subscription method set stays the one the router names (platform/hosted/gateway/src/evm.rs:30)."

[req.7006]
title = "Public EVM relay stays narrow and sends writes to the sequencer"
ac_1 = "Only the eth_, net_ and web3_ namespaces are relayed (platform/hosted/gateway/src/evm.rs:12, gate at platform/hosted/gateway/src/paxeer.rs:796-801), and the relayable set is decided by one function (platform/hosted/gateway/src/evm.rs:95)."
ac_2 = "Writes relayed through the public relay (platform/hosted/gateway/src/paxeer.rs:166) go to the sequencer endpoint; reads at committed tags may go to any configured full node."
ac_3 = "Upstream errors pass through with their JSON-RPC code; the eight node signing methods stay refused (platform/hosted/gateway/src/evm.rs:17)."

[req.7007]
title = "Write gate and px_getCapabilities probe every merged construct"
ac_1 = "The capability probe set (platform/hosted/gateway/src/capabilities.rs:44, calldata at platform/hosted/gateway/src/capabilities.rs:70) covers layerxexchange 0x1015, layerxbridge 0x1016, launchpad 0x1017, feetoken 0x1018, xweb 0x1019, layerxledger 0x101A, layerxpay 0x101B, layerxauth 0x101C and layerxprograms 0x101D."
ac_2 = "The exchange probe keeps intentNonce (platform/hosted/gateway/src/capabilities.rs:36) and adds the v2 getMarket(bytes32) view; the bridge and launchpad probes keep isPaused and getMarketCount (platform/hosted/gateway/src/capabilities.rs:36-40)."
ac_3 = "A write to an address whose probe has not succeeded is refused before relay (platform/hosted/gateway/src/capabilities.rs:309, refusal body at platform/hosted/gateway/src/capabilities.rs:267)."

[req.7008]
title = "px_resolveAccount and px_getAccount answer from addr 0x1004 only"
ac_1 = "Account resolution (platform/hosted/gateway/src/paxeer.rs:292-330) reads getUnifiedAccount, getEvmAddrByLayerX and getLayerXDid on addr 0x1004 (precompiles/addr/addr.go:40-43) and drops the kernel core DID join."
ac_2 = "An unbound DID or address answers a not-found result, never a guessed mapping."
ac_3 = "Responses keep the field names clients decode today (agent/sdk/typescript/src/px.ts:37, agent/sdk/python/layerx_sdk/px.py:37)."

[req.7009]
title = "px_getBalances is one source: bank state"
ac_1 = "px_getBalances (platform/hosted/gateway/src/paxeer.rs:623) answers from bank 0x1001 balance and all_balances (precompiles/bank/bank.go:24-25) only; the kernel core /v1/dids/{did}/accounts join is removed."
ac_2 = "Kernel sub-account balances are derived bank addresses under the merge, so they appear in the same bank answer with no second ledger."
ac_3 = "A bank read failure is an error to the client, never a partial balance list."

[req.7010]
title = "px_listAssets reads the merged asset catalogue"
ac_1 = "px_listAssets (platform/hosted/gateway/src/paxeer.rs:592) joins layerxledger 0x101A getAsset(bytes32) with bank denom metadata in place of the kernel /v1/assets read (platform/hosted/gateway/src/paxeer.rs:533)."
ac_2 = "The layerxCustody getAsset call (platform/hosted/gateway/src/paxeer.rs:561-568) leaves the answer path."
ac_3 = "An asset known to bank metadata but absent from layerxledger is listed with its bank metadata only."

[req.7011]
title = "px_getNetwork derives availability from the sequencer head and the validator commit"
ac_1 = "px_getNetwork (platform/hosted/gateway/src/paxeer.rs:734) drops the layerxanchor latestFinalized and statusOf reads (platform/hosted/gateway/src/paxeer.rs:704)."
ac_2 = "The kernel availability field (platform/hosted/gateway/src/paxeer.rs:765) is kept and is true when the sequencer answers its pending head and the latest committed height is within one round of it."
ac_3 = "Clients that read the field keep working unchanged (agent/sdk/python/layerx_sdk/px.py:260, agent/sdk/typescript/src/px.ts:164-165)."

[req.7012]
title = "History reads are served by the one-chain indexer"
ac_1 = "px_getHistory and px_getUnifiedHistory (platform/hosted/gateway/src/history.rs:420-428) keep their indexer path (platform/hosted/gateway/src/history.rs:479); lx_getHistory answers -32601 from the activation height."
ac_2 = "Address resolution for history uses addr 0x1004 only (precompiles/addr/addr.go:40)."
ac_3 = "History is served with the indexer freshness head; a stale indexer answers with its indexed height, never with a gap filled from another source."

[req.7013]
title = "Route catalogue publishes the merged service surface"
ac_1 = "The catalogue embedded in the router (platform/hosted/gateway/src/lib.rs:984-993) is generated from the route catalogue file whose kernel, replica-authority, core-boundary and archive service entries (tools/paxeer-x/route-catalogue.json:28, tools/paxeer-x/route-catalogue.json:434) are removed at retirement."
ac_2 = "The public JSON-RPC method list (platform/hosted/gateway/src/rpc.rs:1138-1148, checked by platform/hosted/gateway/src/rpc.rs:1114) gains px_getReceiptKeys, px_getCommit, px_getValidators, px_register and px_requestFunds and drops every lx_ name."
ac_3 = "Private services stay unrouted: validators, the receipt authority administration, the mirror signer and rollout are absent from the public catalogue (tools/paxeer-x/route-catalogue.json:46106)."

[req.7014]
title = "Merchant settlement verifies the signed sequencer receipt"
ac_1 = "POST /v1/settle (platform/hosted/gateway/src/lib.rs:905, handler platform/hosted/gateway/src/main.rs:4447) verifies the ProtocolReceipt v2 signature against the ReceiptKeys list instead of the single key file (platform/hosted/gateway/src/main.rs:1030)."
ac_2 = "A settlement whose inclusion is not yet committed answers pending, and one that fails verification answers refused (platform/hosted/gateway/src/settlement.rs:189-213)."
ac_3 = "The configured sequencer authorisation (platform/hosted/gateway/src/lib.rs:1285) holds the list {keyId, publicKey, firstHeight, lastHeight} read from px_getReceiptKeys or the pinned file."

[req.7015]
title = "AI market views read committed program state"
ac_1 = "The AI market snapshot view (platform/hosted/gateway/src/ai_views.rs:1-2) serves the indexer projection of layerxprograms 0x101D logs at committed heights."
ac_2 = "Finality for a snapshot is block commit, not a checkpoint certificate (platform/hosted/indexer/src/ai_market.rs:6)."
ac_3 = "A view the indexer has not reached answers its freshness state instead of older data presented as current (platform/hosted/indexer/src/ai_market.rs:389)."

[req.7016]
title = "Explorer and wallet UI proxies stay unchanged"
ac_1 = "The UI proxy (platform/hosted/gateway/src/ui_proxy.rs:636) and the explorer proxy keep their upstreams; the explorer fork is the explorer."
ac_2 = "The hpx registration ingress (platform/hosted/gateway/src/routes.rs:678) keeps its path list."
ac_3 = "The service routes listed by the catalogue (platform/hosted/gateway/src/routes.rs:1054) are generated from the same catalogue file as the public list."

[req.7017]
title = "Receipt authority verifies sequencer receipts with block-commit inclusion"
ac_1 = "The authority verifies the ed25519 receipt signature against the ReceiptKeys list, chosen by keyId and height range, in place of the single pinned key (platform/hosted/authority/src/main.rs:306-307, documented at platform/hosted/authority/src/main.rs:74-75)."
ac_2 = "Inclusion comes from eth_getTransactionReceipt on one full node at a committed height (rpc/tx.go:106) instead of the checkpoint verifier (platform/hosted/authority/src/trust.rs:14)."
ac_3 = "Until inclusion is committed the by-activity routes (platform/hosted/authority/src/main.rs:879, prefixes at platform/hosted/authority/src/main.rs:1277-1280) answer 202 pending; they never answer success on an unverified receipt."
ac_4 = "Block order equals signed receipt order: two receipts with sequences 7 and 8 are committed in that order, and a block that commits them in the other order is recorded as equivocation evidence and alerted."
ac_5 = "The agent routes (platform/hosted/authority/src/main.rs:1258) follow the same pending and verified rule."

[req.7018]
title = "Program registry is a read cache over layerxprograms 0x101D"
ac_1 = "Program state reads (platform/hosted/registry/src/program_state.rs:5, route import at platform/hosted/registry/src/routes.rs:22) come from 0x101D getProgram, getInterface and getStateHead views (D20)."
ac_2 = "The registry serves cached reads only: the deployment LNI socket (platform/hosted/registry/src/main.rs:434) and the kernel deploy call (platform/hosted/registry/src/node_state.rs:236) leave the service."
ac_3 = "The cache records the height it reflects and rebuilds from module queries when behind (platform/hosted/registry/src/program_state.rs:134, platform/hosted/registry/src/program_state.rs:165)."

[req.7019]
title = "Core boundary sends treasury payouts as EVM transactions"
ac_1 = "Treasury sends are EVM transfers from the treasury account (bank send precompiles/bank/bank.go:22 or a value transfer) signed by a secp256k1 key from the shared EVM sender loader; the ed25519 treasury signer (platform/hosted/core/src/custody.rs:28) and its socket (platform/hosted/core/src/main.rs:305-307) are replaced."
ac_2 = "Withdrawal configuration and caps are held in the core boundary configuration; the LNI reads (platform/hosted/core/src/withdrawal.rs:8, platform/hosted/core/src/caps_reads.rs:80-87) leave the service."
ac_3 = "The reserve disclosure built from the system reserve account (platform/hosted/core/src/lib.rs:533-536) is removed; the treasury balance is the bank balance of the treasury address (precompiles/bank/bank.go:24)."
ac_4 = "A failed send leaves no partial send and is retried only by the operator (platform/hosted/core/src/main.rs:868 is replaced by the EVM send path)."

[req.7020]
title = "Indexer indexes one chain with the merged construct ABIs"
ac_1 = "The indexer decodes blocks and receipts from eth_getBlockByNumber (platform/hosted/indexer/src/paxeer.rs:715) and CometBFT tx_search (platform/hosted/indexer/src/paxeer.rs:802) as the only source; the LayerX ingester (platform/hosted/indexer/src/layerx.rs:382, started at platform/hosted/indexer/src/main.rs:152) is removed at retirement."
ac_2 = "The precompile ABI table (platform/hosted/indexer/src/abi.rs:22) adds feetoken 0x1018, xweb 0x1019, layerxledger 0x101A, layerxpay 0x101B, layerxauth 0x101C and layerxprograms 0x101D, and drops layerxverify 0x1012 (platform/hosted/indexer/src/abi.rs:36) and the custody and anchor rows at retirement."
ac_3 = "Finality of indexed AI market and settlement data is block commit plus an ICS23 proof; the checkpoint certificate path (platform/hosted/indexer/src/ai_market.rs:1383) and the checkpoint verifier (platform/hosted/indexer/src/settlement.rs:15) are removed."
ac_4 = "A stale indexer serves reads with its freshness head and resumes from its last indexed height (platform/hosted/indexer/src/paxeer.rs:771)."

[req.7021]
title = "Webhooks deliver on block-commit finality"
ac_1 = "AI market notifications are delivered on block commit plus an ICS23 proof, replacing the checkpoint certificate check (platform/hosted/webhooks/src/ai_market.rs:20, call at platform/hosted/webhooks/src/ai_market.rs:921)."
ac_2 = "Merchant notifications read the authority verified route (platform/hosted/webhooks/src/trusted.rs:645) and the receipt key list in place of the single key file (platform/hosted/webhooks/src/trusted.rs:240)."
ac_3 = "Redelivery resumes from the authority and indexer cursor; the chain is never written by the webhook service (platform/hosted/webhooks/src/trusted.rs:364)."

[req.7022]
title = "Gas station relayer submits sponsored batches to the sequencer"
ac_1 = "The sponsor nonce is eth_getTransactionCount(sponsor, pending) from the sequencer (interop/crates/layerx-gas-station/src/station.rs:603) and each quote gets one paymaster nonce; the submission is eth_sendRawTransaction to the sequencer (interop/crates/layerx-gas-station/src/rpc.rs:175)."
ac_2 = "There is no cancellation and no same-nonce replacement: the replacement path (interop/crates/layerx-gas-station/src/station.rs:391-406) and its journal record (interop/crates/layerx-gas-station/src/journal.rs:94-99) are deleted; a refused send leaves the nonce free for the next quote."
ac_3 = "Budgets are keyed per DID resolved through addr 0x1004 getLayerXDid at pending state (precompiles/addr/addr.go:40); an unbound account falls back to its address; the per-account check (interop/crates/layerx-gas-station/src/policy.rs:98-107) uses that key (D14)."
ac_4 = "Budgets and the balance floor fail closed before signing (interop/crates/layerx-gas-station/src/policy.rs:76, limits validated at interop/crates/layerx-gas-station/src/config.rs:152-159)."
ac_5 = "With the sequencer down the intent stays in the journal and recover() reconciles it against pax_sequencerReceipt (interop/crates/layerx-gas-station/src/station.rs:769)."
ac_6 = "Registered sender addresses (faucet, treasury, feeder, perps keeper, attestor submitter, worker, evaluator, agentd and onboarding) are sponsored under their own budgets; the routes stay /quote, /submit, /status and /retry (interop/crates/layerx-gas-station/src/service.rs:270-274)."

[req.7023]
title = "SID rate publisher posts setRate to the sequencer"
ac_1 = "The publisher signs setRate(uint256) (interop/crates/layerx-gas-station/src/rate.rs:440, contract contracts/src/BatchCallAndSponsor.sol:88) with a key distinct from the relayer key (interop/crates/layerx-gas-station/src/rate.rs:225-228) and sends it to the sequencer."
ac_2 = "The cadence stays strictly below max_rate_age, at most 300 s (interop/crates/layerx-gas-station/src/config.rs:147-148, cadence field interop/crates/layerx-gas-station/src/rate.rs:190); quotes are refused once the published rate is older than max_rate_age."
ac_3 = "Publication is refused below the balance floor, past the daily gas budget (interop/crates/layerx-gas-station/src/rate.rs:401) or above the fee cap (interop/crates/layerx-gas-station/src/rate.rs:360-367); an unconfirmed publication is not replaced at its nonce."
ac_4 = "The chain fee-token rate for self-paid SID is not published by this service; it moves only by governance (modules/evm/gov.go:26) and its age bound (modules/evm/keeper/params.go:310, default modules/evm/types/params.go:39) is raised by governance; the value is set at activation rehearsal."

[req.7024]
title = "Paymaster and fee token both stay"
ac_1 = "Sponsored batches run through executeSponsored (contracts/src/BatchCallAndSponsor.sol:135), which checks the quote price (contracts/src/BatchCallAndSponsor.sol:169) and emits Sponsored (contracts/src/BatchCallAndSponsor.sol:71)."
ac_2 = "Self-paid SID gas keeps the fee-token path (modules/evm/keeper/feetoken.go:46-47)."
ac_3 = "The paymaster address in the deployment template (interop/deploy/gas-station/railway.env.example:21) is set at activation rehearsal; the station refuses to start with an empty or SID-address paymaster (interop/crates/layerx-gas-station/src/config.rs:142)."

[req.7025]
title = "Interop service settles on sequencer receipts"
ac_1 = "The interop service no longer posts to the kernel /v1/activities (interop/crates/layerx-interop-service/src/server.rs:2526); settlement legs are user-signed EVM transactions to layerxledger 0x101A draw or payExact, relayed by eth_sendRawTransaction."
ac_2 = "Authorised batch reads (interop/crates/layerx-interop-service/src/server.rs:2675) are replaced by pax_sequencerReceipt plus committed inclusion."
ac_3 = "Without a receipt the service retries with the same idempotency key (draw) or payment reference (payExact) and never replaces a transaction at its nonce; payExact is decided as a typed exact payment carrying a payment reference."

[req.7026]
title = "Protocol adapters verify settlement legs on sequencer receipts"
ac_1 = "The x402 seller adapter verifies a ProtocolReceipt v2 against the ReceiptKeys list instead of the authorised batch verify (interop/crates/layerx-x402/src/seller.rs:13, call at interop/crates/layerx-x402/src/seller.rs:243)."
ac_2 = "The AP2, UCP, Visa TAP and fiat adapters take the same verification (interop/crates/layerx-ap2/src/adapter.rs:10, interop/crates/layerx-ucp/src/lib.rs:12, interop/crates/layerx-visa-tap/src/lib.rs:13, interop/crates/layerx-fiat/src/lib.rs:11)."
ac_3 = "An adapter refusal is a payment not accepted, never a relay of an unsigned transaction (interop/crates/layerx-x402/src/seller.rs:258)."

[req.7027]
title = "Portable receipts verify offline against the ReceiptKeys list"
ac_1 = "A portable receipt v2 carries the ProtocolReceipt v2 bytes, keyId and block inclusion, and verifies against the ReceiptKeys entry chosen by keyId and height (interop/crates/layerx-portable/src/receipt.rs:120)."
ac_2 = "The v1 format (interop/crates/layerx-portable/src/receipt.rs:11) keeps its verifier for receipts issued before the activation height."
ac_3 = "Export refuses a receipt that does not verify (interop/crates/layerx-portable/src/receipt.rs:45-53)."

[req.7028]
title = "x402 seller middleware verifies sequencer receipts"
ac_1 = "The middleware submits with eth_sendRawTransaction and reads pax_sequencerReceipt(txHash) instead of lx_sendActivity, lx_getReceipt and lx_getActivityStatus (platform/middleware/seller/src/rpc.ts:56-59)."
ac_2 = "The receipt signature is verified against the ReceiptKeys list instead of the single key argument (platform/middleware/seller/src/commitment.ts:96), and the payment matches a PaymentExact or PaymentDrawn log of 0x101A."
ac_3 = "An unverifiable receipt or a key outside its window means the request is not served (platform/middleware/seller/src/commitment.ts:94-98)."

[req.7029]
title = "x-websearch settles paid requests on layerxledger and fulfils xweb through the sequencer"
ac_1 = "Paid /search and /fetch requests settle by one layerxledger 0x101A draw per request at USD 0.001 under the payer grant, replacing the kernel calls lx_getSequence, lx_sendActivity and lx_getReceipt (interop/crates/x-websearch/src/payment.rs:1951, interop/crates/x-websearch/src/payment.rs:1981, interop/crates/x-websearch/src/payment.rs:2011)."
ac_2 = "The payment gate verifies the sequencer receipt against the ReceiptKeys list instead of the single configured key (interop/crates/x-websearch/src/config.rs:874); no receipt means no release, and a retry reuses the idempotency key (interop/crates/x-websearch/src/payment.rs:2194 is replaced by the receipt read)."
ac_3 = "Origin-1 fulfilment keeps the xweb watcher and fulfil calldata (interop/crates/x-websearch/src/watch.rs:299, interop/crates/x-websearch/src/submit.rs:65) and sends the fulfil transaction to the sequencer with the submitter key sponsored as a registered sender (interop/crates/x-websearch/src/keys.rs:8-10)."
ac_4 = "Below threshold an origin-1 request stays refundable after its timeout height (modules/xweb/keeper/refund.go:28, default modules/xweb/types/state.go:69); the timeout in blocks is set at activation rehearsal for the sequencer cadence."

[req.7030]
title = "Bridge relayer submits bridgeIn to the sequencer"
ac_1 = "Each attested remote deposit becomes one layerxbridge 0x1016 bridgeIn transaction (precompiles/layerxbridge/layerxbridge.go:41, keeper modules/layerxbridge/keeper/bridge.go:65) sent by eth_sendRawTransaction to the sequencer (interop/crates/layerx-bridge-relayer/src/rpc.rs:89)."
ac_2 = "The relayer reads through the sequencer and full-node RPC instead of the checkpoint verifier client (interop/crates/layerx-bridge-relayer/src/config.rs:15); confirmation is pax_sequencerReceipt followed by committed inclusion."
ac_3 = "A duplicate submission is refused by the nullifier and never retried as a new deposit (precompiles/layerxbridge/layerxbridge.go:47); the chain checks the threshold signatures (modules/layerxbridge/keeper/bridge.go:33)."
ac_4 = "Outbound releases follow BridgeOut logs (interop/crates/layerx-bridge-relayer/src/abi.rs:23) read from committed blocks; keys stay with the mirror signer and the relayer configuration holds handles only (interop/crates/layerx-bridge-relayer/src/config.rs:320)."

[req.7031]
title = "Mirror publisher archives committed Paxeer headers"
ac_1 = "The mirror source is committed Paxeer headers and app hashes read by eth_getBlockByNumber at the finalized tag and px_getCommit, replacing checkpoint acquisition (interop/crates/layerx-mirror/src/node.rs:352) and the anchor settlement contract (interop/crates/layerx-mirror/src/node.rs:591)."
ac_2 = "The anchor status read (interop/crates/layerx-mirror/src/node.rs:624) and the guarantor membership read (interop/crates/layerx-mirror/src/node.rs:704) are removed; once the anchor store is deleted they would answer LXP_MODULE_DISABLED, so finality is block height and commit only."
ac_3 = "The archive contract keeps begin, append and finalize under onlyPublisher (interop/contracts/ethereum-mirror/LayerXMirrorArchive.sol:76, interop/contracts/ethereum-mirror/LayerXMirrorArchive.sol:81, interop/contracts/ethereum-mirror/LayerXMirrorArchive.sol:155) with the payload changed to the Paxeer header and app hash."
ac_4 = "Recovery resumes from the last finalized segment; publisher keys come only through the mirror signer client (interop/crates/layerx-mirror/src/signer.rs:51)."

[req.7032]
title = "Mirror signer stays a private socket signer"
ac_1 = "The signer keeps its Ethereum and Solana key files (interop/crates/layerx-mirror-signer/src/lib.rs:44-46, loaded at interop/crates/layerx-mirror-signer/src/lib.rs:428) and serves only the operator socket."
ac_2 = "Bridge attestation and release keys stay in the signer (interop/crates/layerx-mirror-signer/src/lib.rs:456); the bridge relayer and mirror publisher fail closed when it is down."
ac_3 = "The signer is absent from the public route catalogue and never routed (tools/paxeer-x/route-catalogue.json:46106)."

[req.7033]
title = "Account mapping v2 and the one-shot merge tools read committed state"
ac_1 = "Mapping v2 reads addr 0x1004 bindings (interop/crates/layerx-migrate/src/mapping_v2.rs:9-11, selectors for precompiles/addr/addr.go:33-34) at one finalized block (interop/crates/layerx-migrate/src/mapping_v2.rs:128) and writes nothing on chain."
ac_2 = "Every precompile read in one run uses the same block number (interop/crates/layerx-migrate/src/mapping_v2.rs:149, call at interop/crates/layerx-migrate/src/mapping_v2.rs:157); a run that sees the head move does not mix heights."
ac_3 = "The one-shot merge tools are a bring-up at the activation height; no account-state migration is required, so they produce reports and bindings only and carry no service liveness."

[req.7034]
title = "One shared EVM sender loader for every hosted sender"
ac_1 = "A shared loader in the internal crate (platform/hosted/internal/src/lib.rs:11-21) loads a secp256k1 sender key from a key file (platform/hosted/internal/src/secret.rs:21) or a KMS handle, selected by environment, and exposes the sender address."
ac_2 = "The loader uses the k256 version already pinned in the platform workspace (platform/hosted/webhooks/Cargo.toml:32) and the existing key store for KMS handles (platform/hosted/internal/src/kms.rs:81)."
ac_3 = "Faucet, core treasury, feeder, perps keeper, paxai-worker, AI evaluator and the gas station relayer (interop/crates/layerx-gas-station/src/signer.rs:32, env field interop/crates/layerx-gas-station/src/config.rs:104) take their EVM sender from this loader."

[req.7035]
title = "Monitoring watches the sequencer, standby, sponsors and services"
ac_1 = "Sequencer readiness for primary and hot standby replaces the kernel readiness alert (tools/ops/monitoring/rules.yml:56, scrape job tools/ops/monitoring/prometheus.yml:28, test tools/ops/monitoring/rules_test.yml:54)."
ac_2 = "Receipt-order divergence between signed receipts and committed blocks is a critical alert fed by the receipt authority."
ac_3 = "Sponsor balance floor, rate age against max_rate_age, oracle staleness, funding tick age, heartbeat age, evaluator quorum and attestor threshold are alerts; the chain alerts stay (tools/ops/monitoring/rules.yml:4, tools/ops/monitoring/rules.yml:11)."
ac_4 = "Probe targets come from the host inventory variables (tools/ops/monitoring/hosts.env.example:11 is replaced by sequencer readiness targets) and blackbox modules (tools/ops/monitoring/blackbox.yml:1)."

[req.7036]
title = "Rollout controller deploys the merged service set"
ac_1 = "The rollout plan (tools/rollout/rollout.py:61) adds sequencer primary and standby, the archive node, the AI evaluator and the perps keeper as box or hosted services and drops kernel, intent-ingester and the relay archives at retirement (deploy/rollout.kvx:41, deploy/rollout.kvx:192, deploy/rollout.kvx:155, deploy/rollout.kvx:162)."
ac_2 = "Box services log in to the image registry before pulling (tools/rollout/box-apply.sh:36, caller tools/rollout/rollout.py:175) with a token read from a file, never from the command line."
ac_3 = "Ordering checks move from kernel-before-router (tools/rollout/tests/rollout.test.sh:42-43) to sequencer-before-router and standby-after-primary."

[req.7037]
title = "Sequencer primary and hot standby operation"
ac_1 = "The sequencer is the proposer and executes at receipt; blocks it proposes are checked by validators in ProcessProposal (node/app.go:1457), with MsgSequenceBatch as transaction 0 of every block."
ac_2 = "Pending-tag reads are served from the sequencer pending state (node/app.go:2895, tags at rpc/utils.go:66); other nodes answer -32000."
ac_3 = "The hot standby holds its own ed25519 receipt key published in ReceiptKeys and takes over only after the primary entry gets a lastHeight; the kernel sequencer route (platform/hosted/core/src/main.rs:1645) is retired."

[req.7038]
title = "Archive node serves historical state"
ac_1 = "A paxd archive node with pruning off serves eth_getProof and eth_call at past heights (rpc/state.go:110); the router routes past-height reads to it (tools/paxeer-x/route-catalogue.json:434)."
ac_2 = "The relay archive services (deploy/rollout.kvx:155) are replaced by the archive node."
ac_3 = "Archive lag is monitored as head minus archived height; while lagging, past-height reads above the archived height answer an upstream error."

[req.7039]
title = "Perps price feeder pushes signed observations as EVM transactions"
ac_1 = "The feeder sends layerxexchange 0x1015 pushOracle(observation, signature) as an EVM transaction through the gas station, replacing LNI submission (platform/hosted/feeder/src/lib.rs:609-614, socket platform/hosted/feeder/src/main.rs:44)."
ac_2 = "The observation stays signed by the ed25519 oracle key (platform/hosted/feeder/src/main.rs:47, platform/hosted/feeder/src/lib.rs:479) and the EVM sender is the address bound to that key through 0x1004."
ac_3 = "The round cadence (platform/hosted/feeder/src/lib.rs:86-88) stays below each market's staleness bound and the health window stays three cadences (platform/hosted/feeder/src/main.rs:55-58)."

[req.7040]
title = "Perps keeper drives funding ticks, liquidation and ADL"
ac_1 = "A new keeper sends layerxexchange 0x1015 (platform/hosted/gateway/src/evm.rs:43) fundingTick per market every funding interval; it is the only driver of fundingTick and adl."
ac_2 = "Positions below maintenance read from getPerpsPositions are liquidated with liquidatorAccount set to the caller DID main, and a remaining deficit is closed by adl with 1 to 16 ascending position ids."
ac_3 = "The keeper sender comes from the shared loader and is sponsored as a registered sender (interop/crates/layerx-gas-station/src/service.rs:270-274); a duplicate tick is refused by the chain and is not retried."

[req.7041]
title = "paxai-worker submits ai-market operations through layerxprograms"
ac_1 = "Worker operations (accept, commit result, heartbeat, seal evidence, enroll) are layerxprograms 0x101D call transactions, one per operation, sponsored as a registered sender (programs/crates/layerx-programs-ai-market/src/admission.rs:823, programs/crates/layerx-programs-ai-market/src/workers.rs:827)."
ac_2 = "Job results stay signed by the admitted delegate ed25519 key (platform/hosted/paxai-worker/src/main.rs:43, check at platform/hosted/paxai-worker/src/jobs.rs:226-228)."
ac_3 = "Program state reads come at committed height; the job submission path (platform/hosted/paxai-worker/src/auth.rs:48) is unchanged."

[req.7042]
title = "ai-artifacts retention follows block commit"
ac_1 = "Retention promotes evidence on block commit plus state proof instead of verified checkpoint finality (platform/hosted/ai-artifacts/src/retention.rs:46, observers platform/hosted/ai-artifacts/src/authority.rs:28)."
ac_2 = "The market state read and its finality evidence (platform/hosted/ai-artifacts/src/main.rs:322) are read from 0x101D getStateHead at committed height."
ac_3 = "A missing payload is never reported as present; recovery restores from replicas."

[req.7043]
title = "AI evaluator service commits and reveals scores"
ac_1 = "A new evaluator service signs assessments with its granted ed25519 key through the SDK signer interface (agent/sdk/python/layerx_sdk/ai_market.py:798) and sends CommitScore and RevealScore calls (programs/crates/layerx-programs-ai-market/src/commit_reveal.rs:564, programs/crates/layerx-programs-ai-market/src/commit_reveal.rs:598)."
ac_2 = "Below quorum (programs/crates/layerx-programs-ai-market/src/aggregation.rs:55) there is no result and funds stay refundable; an absent reveal forfeits its commitment."
ac_3 = "Grants come from the operator schedule (programs/crates/layerx-programs-ai-market/src/evaluators/authority.rs:656); the EVM sender is bound via 0x1004 and sponsored."

[req.7044]
title = "Services outside the repository keep their chain interfaces"
ac_1 = "Stream metering providers sign meter attestations with a key in the stream meter authority list (src/modules/stream/lx_stream_meter.c:27); accrual stops while no attestation lands (src/modules/stream/lx_stream_meter.c:58) and resumes with the next one."
ac_2 = "Compute-lease providers act through the market program (programs/crates/layerx-programs-market/src/lib.rs:846) and are slashed per stake on a dispute decided against them (programs/crates/layerx-programs-market/src/stake.rs:256); height limits are set at activation rehearsal."
ac_3 = "Validator oracle feeders keep MsgAggregateExchangeRateVote (modules/oracle/keeper/msg_server.go:23) under delegated feed consent (modules/oracle/keeper/msg_server.go:70); wallet app backends need no chain change."

[req.7045]
title = "Agent, wallet and human services operate on EVM transactions"
ac_1 = "agentd completes session.open and agent.register on the merged authorisation and 0x1004 paths, replacing the refusal at agent/crates/layerx-agentd/src/agent_rpc_dispatch.rs:1355-1359 (required change); session keys stay under the configured root (agent/crates/layerx-agentd/src/main.rs:862)."
ac_2 = "The embedded wallet gateway signs through the attestor quorum (human/wallet/gateway/src/env.ts:217-218); its own sponsor key (human/wallet/gateway/src/env.ts:240, read at human/wallet/gateway/src/routes/wallet.ts:37-38) is retired and sponsorship goes through the gas station."
ac_3 = "Wallet attestors keep threshold 3 of 5 (human/wallet/attestor/internal/tss/eddsa/eddsa.go:21-22, human/wallet/attestor/internal/tss/ecdsa/ecdsa.go:26) and fail closed below it; the human service onboarding sponsor key (human/crates/layerx-human-service/src/onboarding/native.rs:28) is retired."
ac_4 = "The KMS signs user EVM actions (human/crates/layerx-human-kms/src/evm.rs:178) through the attestor signer (human/crates/layerx-human-kms/src/attestor.rs:505); the payment grant path (human/crates/layerx-human-kms/src/attestor.rs:594) is retired for the web payer."

[req.7046]
title = "Explorer and explorer index read one chain"
ac_1 = "The explorer index reads blocks and logs from node RPC (rpc/block.go:207, rpc/filter.go:569) including layerxprograms ProgramDeployed, ProgramGuestEvent and ProgramCallOutcome and layerxbridge events (precompiles/layerxbridge/layerxbridge.go:49-50)."
ac_2 = "The receipt authority reader (human/crates/layerx-explorer-index/src/receipt_authority.rs:38) reads the authority verified answers for sequencer receipts."
ac_3 = "A lagging index re-indexes from its last height and balances stay correct from chain state."

[req.7047]
title = "Retired bridging services leave operation"
ac_1 = "Guarantor checkpoint settlement, membership, deposit-root publication and challenge submission (platform/hosted/paxeer/anchor-guarantors.sh:143) stop at the activation height; their code deletion belongs to the retirements domain."
ac_2 = "The intent ingester (deploy/rollout.kvx:192, signer interop/crates/layerx-intent-ingester/src/submit.rs:178) is removed from operation because layerxexchange executes intents directly."
ac_3 = "The Paxeer eth relay boundary (platform/hosted/paxeer/src/main.rs:30-40), the Comet custody proof boundary (platform/hosted/paxeer/src/comet.rs:133), the relay archives, replica and data availability services stop; the kernel node bootstrap precompile settings (platform/hosted/node/bootstrap.sh:132-134) leave operation with them."

