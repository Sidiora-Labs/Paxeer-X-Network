[observation.4.16-src.1]
task       = "4.16"
file       = "tools/bringup/sync-fleet.sh"
symbol     = "resync_target"
observed   = "resync installs its pinned release over any target whose binary differs, so after a rollout of a newer paxd a later resync would put the older pinned binary back on the resynced host."
assumption = "The pin stays as the brief requires and rollout never uses it; the pin must be moved to the rolled-out sha256 by a ruled follow-up before the next resync."
severity   = "major"

[observation.1.5.1]
task       = "1.5"
file       = "tools/bringup/check-live.sh"
symbol     = "check_kernel_app"
observed   = "timeout 20m tools/bringup/check-live.sh kernel-app exited 1 at 3df583333 plus this task's change (log .logs/verify.log): the app runs one started machine with no volume at /data, the volumeless machine do_4 replaces."
assumption = "The image push, CA root secret, volume, scale to zero, deploy and machine start are the deploy fleet's steps in the owner handoff; the gate reruns after them."
severity   = "blocker"

[observation.1.5.2]
task       = "1.5"
file       = "docker/kernel/init.sh"
symbol     = "guarantor, treasury-signer"
observed   = "The treasury signer waits on keys/publication/binding-policy.json, whose publication-policy.py treasury render needs a recipient address, and both guarantors wait on keys/checkpoint-authority/key.pem, the key the Paxeer custody genesis pins as depositRootAuthority; neither value is fixed by the spec or the tree."
assumption = "The owner supplies both; the init never generates or guesses them, so kernel-app reports the signer as waiting until the policy is on the volume."
severity   = "blocker"

[observation.1.5.3]
task       = "1.5"
file       = "docker/kernel/init.sh, human/wallet/deploy/human.toml"
symbol     = "task 1.4 do_1, [design.fly] layout"
observed   = "Task 1.4 writes the sequencer key and metadata under /data/layerx/node, which bootstrap.sh refuses inside --data-dir, and [design] layout puts the pod env in [env] while check-deploy env-no-secrets refuses the 64-hex asset and replica ids."
assumption = "The init keeps --data-dir /data/layerx/node, reads the key at /data/layerx/keys/sequencer.key and the metadata at /data/layerx/genesis/metadata.lxgb, and exports the pod ConfigMap values itself; task 1.4 writes to those paths."
severity   = "warning"

[observation.1.5.4]
task       = "1.5"
file       = "tools/bringup/check-live.sh"
symbol     = "check_kernel_app"
observed   = "kernel-app asserts do_5 only: one started machine with its volume at /data, the root init as entrypoint, and each recorded service running under its uid or waiting on the genesis; req 6.3's supervisor readiness, LNI socket, replica head and clock authority do not exist before the genesis."
assumption = "Task 1.4's kernel-node subcommand asserts 6.3's readiness after kernel-genesis.sh; kernel-app does not claim it."
severity   = "note"

[observation.1.5.5]
task       = "1.5"
file       = "docker/kernel/init.sh"
symbol     = "LAYERX_NODE_NETWORK_ID"
observed   = "The kernel network id is not fixed for this network: the tree's testnet ConfigMap carries 402, and the asset and replica ids the init exports are that testnet ConfigMap's values."
assumption = "The init requires LAYERX_NODE_NETWORK_ID from a staged Fly secret the owner sets; the asset and replica ids stay the tree's values until the owner rules otherwise."
severity   = "blocker"

[observation.1.5.6]
task       = "1.5"
file       = "tools/bringup/human-state-preserve.sh"
symbol     = "do_4, export, import, verify"
observed   = "do_4 destroyed the volumeless machine without carrying its writable-root state, while the human README requires retained encrypted state to keep its matching material and its PVC retention covers Kubernetes only; the old image runs only the stateless layerx-human-service front and the app holds no secrets, so the carried set may be empty."
assumption = "Closed by the export, import and verify subcommands and a cutover that imports before the kernel init first runs and keeps the old machine stopped as rollback until the gates pass; an export that refuses with nothing to preserve is the evidence that no state existed, and nothing is regenerated in its place."
severity   = "blocker"

[observation.1.5.7]
task       = "1.5"
file       = "spec/paxeer-x-bringup/spec.kvx, tools/bringup/check-live.sh"
symbol     = "task.1.5 do_4, check_kernel_app"
observed   = "do_4 still orders flyctl scale count 0 before the deploy, and kernel-app fails on machines=2 while the stopped old machine is kept as the rollback the cutover requires."
assumption = "Ruled and applied: check_kernel_app stays one machine and one volume, the handoff order stands with the pre-destroy checks and verify as the rollback window and kernel-app after the destroy, and do_4 now states that order instead of scale count 0."
severity   = "warning"

[observation.1.5.8]
task       = "1.5"
file       = "tools/bringup/check-live.test.sh"
symbol     = "check_live_kernel_app_passing, check_live_kernel_app_failing"
observed   = "timeout 20m bash tools/bringup/check-live.test.sh exited 1 on two consecutive runs with no other harness running (log .logs/check-live-test.log): both kernel-app cases report init status=absent, while all eleven human_state_preserve cases and every other case pass."
assumption = "The kernel-app command reads only /proc/ and /run/layerx/init/, which this change's stand-in rewrites do not touch, so the failure predates it; it is left for the manager rather than chased here."
severity   = "warning"

[observation.4.11.1]
