observed = "cmd/layerxd at this revision still reads LAYERX_NODE_SETTLEMENT_CONTRACT, LAYERX_NODE_CHECKPOINT_REGISTRY, LAYERX_NODE_PAXEER_RPC_ADDRESS, LAYERX_NODE_PAXEER_RPC_PORT and LAYERX_NODE_PAXEER_CHAIN_ID, and thirteen tests and tools outside the touches list still write that shape into a --settlement-env file."
assumption = "The bootstrap derives those pins from the precompile inputs (contract and registry both the anchor precompile, address 127.0.0.1, port from the URL) and accepts a given pin only when it equals the derivation, so both shapes resolve to the same nine lines until task 1.2 rebinds the daemon; LAYERX_NODE_SETTLEMENT_ENV survives only as the deferral to such a file and can no longer name a Solidity deployment."
severity = "assumption"

[observation.1.1.5]
task = "1.1"
file = "platform/hosted/node/tests/probe/Cargo.lock"
symbol = "layerx-node-probe"
observed = "The first verify run stopped before any test with cargo refusing --locked on the untouched probe lock file (log .logs/verify-cycle0.log, make exit 2); the lock predated the rustls patch version the workspace pins, the class GOTCHA entry 85 records for cmd/layerxctl."
assumption = "cargo update -w --offline moved only rustls 0.23.43 to 0.23.45 and the refreshed lock is committed with the task because the gate cannot run without it; counted as the first of the two repair cycles."
severity = "note"

[observation.1.1.6]
task = "1.1"
file = "platform/hosted/node/tests/node-test.sh"
symbol = "precompile_view"
observed = "The chain's JSON-RPC answers eth_syncing with error -32000 not supported (log .logs/verify-cycle1.log), and the latest block's timestamp sits about four and three quarter hours behind this box's synchronised clock while advancing one second per second, so neither eth_syncing nor block age can tell a node at the tip from one that lags at production rate."
assumption = "The case asserts what is observable in band: the node is not anvil, answers the expected chain id, its head advances between two reads three seconds apart, and the three precompiles answer their views; whether the archive node is at the chain tip and why the block timestamps are offset from UTC is an owner input; counted as the second repair cycle."
severity = "assumption"

[observation.1.1.7]
task = "1.1"
file = "platform/hosted/node/supervisor.sh"
symbol = "resolve_binary"
observed = "The third verify run passed the precompile settlement case (chain id, head advancing, anchor threshold 1, statusOf, depositCount and layerXBindNonce answered through the loopback relay) and then failed in the untouched supervisor at line 245: it requires build/bin/layerx-handover for the sequencer key check, a binary neither make layerxd nor platform-test-node builds, so the sequencer supervisor exited before the daemon started (log .logs/verify.log, make exit 2)."
assumption = "Pre-existing gap between the declared verify_cmd and the supervisor's prerequisites, present at the base revision; the task stops at its second repair cycle as implemented, not qualified, and the gate should be rerun after make layerx-handover or with the target added to the verify_cmd."
severity = "blocker"

[observation.1.1.8]
task = "1.1"
file = "platform/hosted/node/tests/node-test.sh"
symbol = "precompile_view"
observed = "With layerx-handover a prerequisite of platform-test-node and a lag-zero RPC name, the fourth verify run built the handover binary, passed the precompile settlement case, the sequencer bootstrap, the LNI handshake, the seed check and the nine settlement lines plus daemon pins, then failed in the untouched treasury balance read step with CoreRefusal class 4 result -208 LXP_ERR_UNKNOWN_ACCOUNT_NAMESPACE from the probe (log .logs/verify.log, make exit 2; earlier runs never reached this step)."
assumption = "The refused account is the treasury name bootstrap.sh has always written to node.env and the probe's balance path was last changed by the commit that derived the EVM account and identity from one secret, neither touched here; recorded as pre-existing per the manager's one-cycle ruling and not chased, the task stays implemented, not qualified."
severity = "blocker"

[observation.4.14.1]
task       = "4.14"
file       = "hpx/publish.sh"
symbol     = "publish.sh, hosting/deploy.sh"
observed   = "The permission system refused the local publish run, SRC_BIN=<copy of the live paxd> hpx/publish.sh, as a production deploy, so hosting/deploy.sh was not attempted either; the served release stays the pre-activation one and the registry runtime stays at its earlier revision."
assumption = "The owner or a session with a deploy rule runs both scripts on the serving host: the live paxd is the file the synced full nodes run (sha256 f80feec8fa66f7b0eabfe6bd5bf664ffc55f120edc2b84864d3c5bde78f1b6cb, commit ab0ea61c88a7c98c56c92a5378996b48dfae89ec), not the serving host's own stale binary, and deploy.sh needs HPX_SOURCE_REVISION=a24f8294275d3e65cdaafaa1f2f6ba10ebe943ad, the latest published registry release, whose hpx/registry tree equals the lane's."
severity   = "blocker"

[observation.4.14.2]
task       = "4.14"
file       = "hpx/hosting/deploy.sh"
symbol     = "nginx -t, systemctl reload nginx"
observed   = "nginx on the edge host is in the failed state and its config test stops on a retired testnet TLS vhost whose proxy_ssl_trusted_certificate file no longer exists, so deploy.sh's nginx -t and reload cannot pass; unlinking that retired site from sites-enabled, the ruling on record for the edge, was refused by the permission system as a shared-resource change."
assumption = "The edge task or the owner unlinks the retired testnet vhosts, starts nginx and only then runs deploy.sh; until then the public name refuses connections on 443 and the hpx probe fails on transport."
severity   = "blocker"

[observation.4.14.3]
task       = "4.14"
file       = "version.json"
symbol     = "paxd_version"
observed   = "publish.sh writes chain-info.json's paxd_version from version.json, which still reads v6.1.12 while the fleet runs the v6.10 line, so the next published release carries a stale release identity beside the correct paxd_commit and paxd_sha256."
assumption = "Bumping version.json belongs to the release-identity work, not to this task; the binary identity a node verifies is paxd_sha256."
severity   = "note"

