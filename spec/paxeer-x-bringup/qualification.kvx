[observation.1.6.6]
task       = "1.6"
file       = "docker/kernel/Dockerfile.dockerignore, tools/bringup/kernel-genesis.sh"
symbol     = "value_loop"
observed   = "layerx-custody-proof, which both kernel-genesis.sh genesis (light-profile) and value-loop.sh (light-credit) call inside the machine, is a Go binary whose trees (daemon, custodyproof, consensus, sdk, storage, engine, modules) the kernel image's dockerignore excludes and whose build stage is Rust-only; the ruling limits the Dockerfile change to the probe and the credit signer, so the image does not carry it and both scripts stop with a named line while it is absent."
assumption = "A follow-up adds a Go build stage (the pinned golang image of docker/layerx/Dockerfile, make custody-proof-build) and the dockerignore exceptions for its trees to the kernel image; until then step C of the genesis order cannot run."
severity   = "blocker"

