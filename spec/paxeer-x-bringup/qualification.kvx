observed  = "Fourteen assertion tests passed after one repair cycle that moved a test-side key-set hit-count assertion before the state reopen; the run needed a dedicated cargo target directory."

[observation.4.15.1]
task       = "4.15"
file       = "tools/bringup/check-live.sh"
symbol     = "check_rpc_nodes"
observed   = "The read-only survey of the sixteen public RPC hosts found every unit active without restarts, panics or bind errors, fifteen on the release binary and one on a pre-release binary; nine names trail the head: four by about 93k blocks, two by about 70k, one by about 13k, all advancing at chain speed without catching up, one by about 530k and the pre-release one by about 1.96M blocks, but every remote write (unit restart, block sync switch, binary swap, data copy) was refused by the session's permission classifier, so do_1 did not run and the verify_cmd fails on those nine names."
assumption = "The operator runs the repair from a session allowed to write over ssh: restart with block sync on for the seven names within the retain window, a data copy from a synced host for the two beyond it plus the staged release binary for the pre-release host; the verify_cmd then passes once every restarted unit has been active for an hour."
severity   = "blocker"

[observation.4.15.2]
task       = "4.15"
file       = "tools/bringup/check-live.sh"
symbol     = "check_rpc_nodes"
observed   = "RPC_HOSTS in the private host map lists fifteen destinations; the twelfth public name resolves from this box, its host answers ssh, runs the release binary at the head and is not on the never-place line, but no RPC_HOSTS entry maps to it, so the probe prints unit=unmapped for that name."
assumption = "The operator appends the twelfth name's destination to RPC_HOSTS in the private host map; the probe needs no change."
severity   = "blocker"

[observation.4.3.1]
task       = "4.3"
file       = "tools/bringup/install-archive.sh"
symbol     = "install-archive"
observed   = "The archive host already ran paxd active and enabled under the hpx unit with min-retain-blocks 0, ss-keep-recent 0 and sc-keep-recent 0 in its app.toml, hpx present, and nginx serving its public RPC name over a Let's Encrypt certificate with the fleet vhost; the installer was written idempotent against that state and not run, since this run may not write on any host."
assumption = "The task's state-sync keep-recent is the ss-keep-recent state-store key that the earlier archive conversion and the intended-shape survey name; the probe's retention line reads exactly those two keys."
severity   = "note"

[observation.4.3.2]
task       = "4.3"
file       = "tools/bringup/check-live.sh"
symbol     = "check_archive_node"
observed   = "The verify_cmd exits 1 on the head line only: the archive node answers a block 200000 below its head and reports catching_up false, yet its head trails the highest public answer by about 93500 blocks with its latest block time about five hours behind the clock, advances slower than the head, and sits only about 6000 blocks inside the 100000-block window the pruned public nodes retain."
assumption = "A paxd restart on the archive host refills the gap through block sync while the pruned peers still hold those blocks; that is a remote write outside this run's scope, so the task stays implemented until an operator restarts the node and the probe is rerun."
severity   = "blocker"

[observation.4.3.3]
task       = "4.3"
file       = "tools/bringup/install-archive.sh"
symbol     = "hpx setup, hpx update"
observed   = "The hpx mirror name refused connections from the operator host during this run, so the installer's fresh-node, hpx download and published-release steps have no reachable authority, and the archive host's current paxd could not be compared with the mirror's publication."
assumption = "The mirror returns with the hpx registry task; a fresh archive host state-syncs from the newest snapshot its peers offer, so the blocks before that point come from the explorer's history copy rather than from an earliest snapshot the node could choose."
severity   = "suspect"

[observation.1.1.1]
task = "1.1"
file = "platform/hosted/node/checkpoint-authority.py"
symbol = "checkpoint_authority"
observed = "do_1 and do_2 name this file, but at this revision it only provisions the Ed25519 checkpoint-authority keys and holds no settlement input, address or submission code; the certificate and checkpoint submission the guarantor runs lives in cmd/layerx-guarantor/settlement.py, which already pins the anchor precompile and encodes submitCheckpoint, finalize and statusOf from their signatures."
assumption = "The file is left as it is; guarantor.sh now asserts those three signatures against the anchor ABI shipped under precompiles/ before it starts, so the submission path is bound to the ABI without a second encoder."
severity = "note"

[observation.1.1.2]
