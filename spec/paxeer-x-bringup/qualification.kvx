command = "systemctl stop hpx-registry.service; systemctl disable hpx-registry.service; rename reviewed unit, legacy vhost and environment into private rollback archive; systemctl daemon-reload"
exit_code = 0
log_path = ".logs/4.21-retirement.log"
observed = "Old unit is inactive and not found; reviewed originals absent, environment mode preserved and artifacts/data untouched. Serving gate already passed; task remains in_progress pending host-role fixture and README completion."

