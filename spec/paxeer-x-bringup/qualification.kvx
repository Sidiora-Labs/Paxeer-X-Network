symbol = "paxeer_contracts_deploy"
observed = "do_2 asks to delete the call to platform/hosted/paxeer/deploy-contracts.sh; no such call exists at this revision, the function only writes deployment.json from the precompile addresses and registers the guarantors, so nothing was deleted and the script stays available for private networks."
assumption = "The settlement ConfigMap the cluster publishes now carries the chain id, the loopback relay URL and the three precompile addresses instead of the contract and registry pins."
severity = "note"

