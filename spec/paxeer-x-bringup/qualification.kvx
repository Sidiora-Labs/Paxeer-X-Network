[observation.1.9.1]
task       = "1.9"
file       = "platform/hosted/authority/src/main.rs"
symbol     = "lookup_receipt"
observed   = "Commit 5d3b3d31f moved LNI to minor 6, where every receipt-lookup selector carries a trailing wait byte (0 immediate, 1 published, 2 durable), and updated the daemon, the SDK client and the core boundary but not the receipt authority, which still sent the bare 33-byte selector and got class 1, result -105; the authority now appends the 0 byte at minor 6 as the core boundary does, and real_node.rs:1515 passes."
assumption = "The daemon, the SDK client and the core boundary fix the contract, so only the authority side changed; the envelope check is untouched; severity medium, resolved."

[observation.1.9.2]
task       = "1.9"
file       = "platform/hosted/authority/tests/real_node.rs"
