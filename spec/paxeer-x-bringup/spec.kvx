[task.1]
section = "Wave 1 - Kernel app"
title   = "Settle on the precompiles, bind the finality verifier, fix the abort points, run the kernel pod as one Fly app, generate the genesis inside it and prove a value loop"
status  = "pending"

[task.1.1]
title      = "Point the node pod's settlement inputs at the registry, custody and anchor precompiles and retire the Solidity path from the bring-up"
status     = "implemented"
wave       = 1
requires   = []
do_1       = "Replace LAYERX_NODE_SETTLEMENT_CONTRACT and LAYERX_NODE_SETTLEMENT_ENV in platform/hosted/node/bootstrap.sh, sequencer-env.sh, cmd/layerx-guarantor/settlement.py and deployment.yaml by LAYERX_NODE_REGISTRY_PRECOMPILE, LAYERX_NODE_CUSTODY_PRECOMPILE and LAYERX_NODE_ANCHOR_PRECOMPILE defaulting to 0x0000000000000000000000000000000000001004, 0x0000000000000000000000000000000000001013 and 0x0000000000000000000000000000000000001014 on chain 125, read through LAYERX_NODE_PAXEER_RPC_URL on loopback."
do_2       = "Make the guarantor (guarantor.sh, cmd/layerx-guarantor/settlement.py) submit certificates and checkpoints to the anchor precompile's submitCheckpoint and finalize and read statusOf, using the ABI under precompiles/, and delete the call to platform/hosted/paxeer/deploy-contracts.sh from platform/hosted/tests/beta-cluster.sh while keeping the script for private networks."
do_3       = "Extend platform/hosted/node/tests/node-test.sh with a precompile settlement case against the loopback RPC of a synced node when LAYERX_NODE_PAXEER_RPC_URL is set, refusing to run against anvil."
verify_cmd = "timeout 30m make layerxd platform-test-node"
symbols    = ["settlement_resolve", "layerx_sequencer_environment", "guarantor_anchor_abi", "precompile_view"]
touches    = ["platform/hosted/node/bootstrap.sh", "platform/hosted/node/sequencer-env.sh", "cmd/layerx-guarantor/settlement.py", "platform/hosted/node/guarantor.sh", "platform/hosted/node/deployment.yaml", "platform/hosted/node/tests/node-test.sh", "platform/hosted/tests/beta-cluster.sh", "platform/Makefile.inc", "docker/platform-node/Dockerfile", "docker/platform-node/Dockerfile.dockerignore", "platform/hosted/node/tests/fixtures/settlement-configuration.txt", "platform/hosted/node/tests/probe/Cargo.lock"]
tests      = ["platform/hosted/node/tests/node-test.sh"]
reqs       = ["5.1"]

[task.1.2]
title      = "Bind a real finality-authority verifier in layerxd so the sequencer bootstraps against the chain"
status     = "pending"
wave       = 1
requires   = ["1.1"]
supersedes = ["layerx-beta 6.10"]
do_1       = "Bind the finality-authority verifier in cmd/layerxd to the anchor precompile's certificate rules: the certificate threshold, the bonded guarantor set and the finalized checkpoint read from 0x0000000000000000000000000000000000001014 over the loopback JSON-RPC named by LAYERX_NODE_PAXEER_RPC_URL, so the sequencer bootstraps under a real authority and refuses to start without one."
do_2       = "Make tests/daemon/lxp_test_finality_authority drive the bound verifier through a recorded JSON-RPC fixture captured from the live chain under tests/daemon/fixtures/finality-authority/ and, when LAYERX_NODE_PAXEER_RPC_URL is set, through the loopback RPC itself; no anvil, no stub verifier."
verify_cmd = "timeout 30m make layerxd test-daemon-finality-authority"
symbols    = ["lxp_finality_authority_bind", "lxp_finality_authority_verify"]
touches    = ["cmd/layerxd", "src/sequencer", "tests/daemon/lxp_test_finality_authority.c", "tests/daemon/lxp_test_finality_json.c", "tests/daemon/fixtures/finality-authority"]
tests      = ["tests/daemon/lxp_test_finality_authority.c"]
reqs       = ["5.2", "5.3"]

[task.1.3]
title      = "Fix the seven bare-host abort points of the kernel bring-up"
status     = "implemented"
wave       = 1
requires   = ["1.1"]
do_1       = "Generate the LXGB v2 genesis metadata in platform/hosted/node/bootstrap.sh before the node starts and fail with a clear message when it is absent, instead of relying on a volume that was never applied."
do_2       = "Implement a probe subcommand in layerx-human-identity-provider, layerx-human-security-provider and layerx-human-movement-provider that connects to the provider's own socket and exits 0 only on a healthy answer, and add tests/probe.rs in each of the three provider crates proving a healthy answer exits 0 and a missing socket does not."
do_3       = "Add localhost and the loopback address to the receipt-authority certificate SANs in beta-cluster.sh and tools/bringup/ca.sh; set the evidence provisioning journal in platform/hosted/human/provision.sh to the work directory's registry journal; make builder_release_publish fail when LAYERX_BETA_BUILDER_ENVIRONMENT_DIR is missing; set CANDIDATE_ABI_MODULE in programs/sdk/rust/lint to the runtime's response module name."
do_4       = "Add the human-test-provider-probe target to the root Makefile beside the other human-test targets, running the probe tests of the three providers under human/ with cargo."
verify_cmd = "timeout 30m tools/runtime/run-with-clock.sh make platform-hosted-topology-check programs-reference-escrow human-test-provider-probe"
symbols    = ["probe", "write_genesis_metadata", "builder_release_publish", "CANDIDATE_ABI_MODULE"]
touches    = ["platform/hosted/node/bootstrap.sh", "human/crates/layerx-human-identity-provider/src/main.rs", "human/crates/layerx-human-security-provider/src/main.rs", "human/crates/layerx-human-movement-provider/src/main.rs", "human/crates/layerx-human-identity-provider/tests/probe.rs", "human/crates/layerx-human-security-provider/tests/probe.rs", "human/crates/layerx-human-movement-provider/tests/probe.rs", "platform/hosted/human/native_manifest.py", "platform/hosted/human/provision.sh", "platform/hosted/tests/beta-cluster.sh", "tools/bringup/ca.sh", "programs/sdk/rust/lint/src/lib.rs", "Makefile"]
tests      = ["human/crates/layerx-human-identity-provider/tests/probe.rs", "human/crates/layerx-human-security-provider/tests/probe.rs", "human/crates/layerx-human-movement-provider/tests/probe.rs"]
reqs       = ["6.1"]

[task.1.4]
title      = "Generate the genesis manifest and the sequencer key inside the kernel machine, start the sequencer and hand custody to the owner"
status     = "pending"
wave       = 1
requires   = ["1.2", "1.3", "1.5", "1.7"]
do_1       = "Write tools/bringup/kernel-genesis.sh that runs inside the kernel app's machine through flyctl ssh console: build the genesis manifest with layerx-genesis-build from platform/hosted/node/genesis-modules.conf and genesis-module-fees.json with the anchor point read from the chain through the pod's paxeer relay and an LXGB v2 genesis metadata file passed as --genesis-metadata that carries one canonical Asset record for each asset of the custody precompile's asset map on chain 125, SID, PAX, USDC and USDL among them, read from the chain at run time, generate the sequencer key through the pod's signer material contract, write everything under /data/layerx/node on the app's volume with mode 0600 owned by the node user, and print only the genesis digest, the sequencer public key and the registered asset ids."
do_2       = "Record /data/layerx/node on the kernel app's volume as the custody path: the script prints the owner handoff line naming that path and the two digests, refuses to run twice without an explicit rotate argument, and lets the init start layerxd, the authority replica and the guarantor on the new genesis."
do_3       = "Add the kernel-node subcommand: the genesis digest under /data/layerx/node matches the replica's /v1/sync/network document, the public key matches core.env, supervisor.sock reports ready, the LNI socket exists, the replica answers its head on loopback and every process runs under the clock authority."
verify_cmd = "timeout 15m tools/bringup/check-live.sh kernel-node"
symbols    = ["kernel_genesis", "check_kernel_node"]
touches    = ["tools/bringup/kernel-genesis.sh", "tools/bringup/check-live.sh"]
tests      = ["tools/bringup/check-live.test.sh"]
reqs       = ["6.2", "6.3"]

[task.1.5]
title      = "Build the kernel image and run the kernel pod as one Fly app with one machine and one volume"
status     = "pending"
wave       = 1
requires   = ["1.3", "0.5"]
do_1       = "Write docker/kernel/Dockerfile and docker/kernel/Dockerfile.dockerignore as the union of docker/platform-node, platform-core, platform-authority, platform-agent-boundary, interop-mirror and human-service plus layerx-mcp from agent/crates/layerx-mcp on a Debian base with socat and util-linux, reusing each image's build stages and entrypoints."
do_2       = "Write docker/kernel/init.sh as the root entrypoint: replay the init containers of platform/hosted/node/deployment.yaml (guarantor storage, checkpoint authority, publication policy, human directories and human authority material) on the volume, mount tmpfs for /run/layerx, the private directories and /tmp, then start every long-running container command of that pod under its uid through setpriv and restart one that exits, starting a TLS listener only once its certificate is on the volume; every listen value and socat bind is [::] for the private network."
do_3       = "Make human/wallet/deploy/human.toml the kernel app's toml: build docker/kernel/Dockerfile, one machine of a performance class with at least four CPUs and 16GB in the region nearest the RPC nodes by measured round trip, one volume mounted at /data holding /data/layerx and /data/human-state with daily snapshots and retention, only the CA roots as [[files]] secret_name entries while every private key and signing request is generated inside the machine on the volume and tools/bringup/ca.sh writes each certificate back to the volume, and the existing plain 8080 http_service with LAYERX_HUMAN_LISTENER plain and LAYERX_HUMAN_BIND [::]:8080 from the first deploy; add every new [env] name of the toml to human/wallet/deploy/env with one line each so tools/wallet/check-deploy.sh keeps passing."
do_4       = "The existing machine of the app is a volumeless machine in ams, and a deploy does not attach a new volume to it: create the volume in ams, the machine's region, then run flyctl scale count 0 for the app so the volumeless machine is destroyed, and deploy with the [mounts] section so flyctl creates the one machine on that volume; the app name, and so the fly.dev target of the human.paxeer.network CNAME, is unchanged."
do_5       = "Add the kernel-app subcommand: the app has exactly one started machine with its volume mounted at /data, the init runs as the entrypoint, and every process of the pod not waiting on the genesis runs under its uid."
verify_cmd = "timeout 20m tools/bringup/check-live.sh kernel-app"
symbols    = ["check_kernel_app"]
touches    = ["docker/kernel/Dockerfile", "docker/kernel/Dockerfile.dockerignore", "docker/kernel/init.sh", "human/wallet/deploy/human.toml", "human/wallet/deploy/env", "tools/bringup/check-live.sh"]
tests      = ["tools/bringup/check-live.test.sh"]
reqs       = ["6.3"]

[task.1.6]
