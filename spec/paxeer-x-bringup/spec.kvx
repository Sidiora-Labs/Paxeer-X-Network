# paxeer-x-bringup — feature spec. Requirements, design, then the task list.
#
# The unified Paxeer X Network brought up end to end on five host roles: the
# edge host terminates every public name, the kernel host runs the LayerX
# kernel and the human graph, the platform host runs the developer plane and
# the interop services, the explorer fork already runs on Railway behind
# paxscan.io, and the archive host keeps the whole chain history. Hosts are named by role only;
# the operator's private host map is the file named by BRINGUP_HOSTS_FILE.

[meta]
feature   = "paxeer-x-bringup"
title     = "Bring every LayerX system of Paxeer X Network live on its own hosts"
kind      = "product-feature-specification"
version   = "1.0.0"
status    = "in_progress"
language  = "Rust (platform/, human/, agent/, interop/ crates), C (cmd/layerxd, src/), Go (hpx/registry, tools/flyci, bridge/deploy), POSIX shell for units, probes and installers, Python where the hosted pod definitions already use it"
repo_root = "platform/hosted/ (the pod definitions, entrypoints and env contracts every unit reuses); docker/ (one directory per service image); tools/bringup/ (the host-map contract and the live probe, new); cmd/layerxd and src/ (the kernel); human/crates/ (the human graph); agent/crates/ (agentd and MCP); interop/ (interop gateway, mirrors, x-websearch, bridge relayer, gas station); explorer/ (the explorer fork); docs/site and docs/wiki (the public names); spec/paxeer-x-bringup/ (this feature and its qualification log)"
intro     = "Every LayerX system that the surveys found ready, blocked or incomplete is brought up on real hosts with real keys and served under a public name, and nothing that is still useful is disabled or removed. The kernel host carries the sequencer, the boundaries, the human graph, the agent daemon and the MCP server; the platform host carries the gateway at the router URL and the developer plane; the edge host fronts every name with nginx and Let's Encrypt. Work is ordered in five waves from the edge and the docs to the kernel, the boundaries, the human graph and finally everything that runs beside them. A task whose only missing piece is an owner input carries blocked_on naming that input and stays a real task with a real probe."

[decision]
retired          = "Off every task list, code kept for private networks: testnet control and the faucet (platform/hosted/testnet, platform/hosted/faucet), the Solidity settlement path (platform/hosted/paxeer/init-chain.sh, deploy-contracts.sh, the anvil-based forge tests and the contracts/ deployment scripts), the old human web application (human/apps/web) and the explorer-index crate (human/crates/layerx-explorer-index). Nothing else is turned off; an incomplete system is completed."
router_url       = "The unified LayerX plus Paxeer interface, the hosted gateway of platform/hosted/gateway, is served only at https://api.mainnet-beta.router.paxeer.network. Every document, example, manifest and config that says api.paxeer.network is rewritten to that URL. The sixteen public RPC names api1 to api16.mainnet-beta.paxeer.network stay exactly as docs/site/docs/reference/public-rpc.md lists them."
host_roles       = "edge host: nginx and certbot terminating every public name, proxying to the backends over the backends' own TLS under the internal CA, backend ports firewalled to the edge. kernel host: a synced full node with the chain JSON-RPC on loopback, the layerxd sequencer, the authority replica, the clock authority, the core boundary, the receipt authority, the agent boundary, two Paxeer boundaries, the whole human graph, agentd and the MCP server. platform host: the gateway and its Redis, the identity service, the internal kms and its four event sources, webhooks, the dashboard API and web, the program registry with its builder rootfs, the relay archive, the interop gateway, the gas station and the bridge relayer. explorer: the fork's frontend, backend and database already run on Railway behind paxscan.io and follow the archive host through its public RPC name; the explorer host role stays in the host map for a self-hosted explorer and is unused. archive host: a full node with min-retain-blocks 0 as the explorer upstream and the second Paxeer boundary source."
edge_server      = "nginx with certbot, already installed on the edge host and already fronting the sixteen RPC proxies, is the edge server; no Caddy vhost is added for a new name. The wallet endpoint's existing Caddy definition under human/wallet/deploy/cutover is left as the wallet feature wrote it."
supervision      = "systemd units on each host, one unit per container of the platform/hosted pod definitions, reusing their entrypoints, env names and materials; no Kubernetes, no new supervisor. The runtime clock wraps every binary the pod definitions wrap."
key_custody      = "Secrets and key material are generated on the host that uses them by the task's script, never printed, never copied into the repository or the ops directory; each task records the custody path under /etc/layerx on that host for the owner in its do lines. The internal CA key lives on the edge host only; every other host generates its own service keys and sends a signing request."
cutover          = "The Fly shared endpoint and the Fly human service are cut over to the platform host and the kernel host once the new hosts pass their probes, by repointing the names and the wallet PWA variables; the Fly apps are stopped, never deleted. Fly keeps the five attestors and the wallet gateway."
no_placeholders  = "No config, unit or document carries a placeholder value. When the only missing piece of a task is something the owner alone can produce, the task carries blocked_on = the exact input, its do lines and verify_cmd are real, and the task is worked the moment the input arrives; it is never marked done, weakened or removed while blocked."
host_map         = "BRINGUP_HOSTS_FILE names a private env file with EDGE_HOST, KERNEL_HOST, PLATFORM_HOST, EXPLORER_HOST, ARCHIVE_HOST, VALIDATOR_HOSTS, RPC_HOSTS and HPX_HOST, each an ssh destination the operator can reach. tools/bringup/check-live.sh sources it and never prints it; no spec file, unit or document contains a host address."

[decision.public_names]
title = "Public names, each justified by a survey, all under paxeer.network unless the owner named the host"
router       = "api.mainnet-beta.router.paxeer.network -> gateway on the platform host (the unified endpoint of docs/site/docs/overview/unified-network.md)"
rpc          = "api1..api16.mainnet-beta.paxeer.network -> the sixteen public RPC nodes, unchanged"
human        = "human.paxeer.network -> human service on the kernel host (the wallet SDK's human API base, NEXT_PUBLIC_PAXEER_HUMAN_API)"
agent        = "agent.paxeer.network -> agentd boundary on the kernel host (the mTLS 9454 surface platform/hosted/agentd/probe.sh checks)"
identity     = "identity.paxeer.network -> identity service on the platform host (every developer-plane service dials it)"
registry     = "registry.paxeer.network -> program registry on the platform host (the deployment ingress of platform/hosted/registry)"
developers   = "developers.paxeer.network -> dashboard web; api.developers.paxeer.network -> dashboard API; webhooks.paxeer.network -> webhooks; all on the platform host, replacing developers.layerx.example"
archive      = "archive.paxeer.network -> relay archive on the platform host (public LayerX history and forwarding, replacing relay.layerx.example)"
interop      = "interop.paxeer.network -> interop gateway on the platform host (x402, AP2, UCP, Visa TAP, fiat, http, mcp, a2a)"
gas          = "gas.paxeer.network -> gas station on the platform host (Sidiora-priced sponsored gas)"
search       = "search.paxeer.network -> the x-websearch sidecars on the validator hosts (paid search and fetch over 402LXP)"
ramp         = "ramp.paxeer.network -> reference ramp on the platform host (the beta contract's hosted reference-ramp name)"
explorer     = "paxscan.io -> the deployed explorer fork frontend on Railway, whose API host is the Railway explorer backend; no explorer.paxeer.network name is served"
wallet       = "paxportwallet.com -> wallet PWA on Railway; the wallet gateway and the five attestors stay on Fly"
hpx          = "node.hyperpaxeer.com -> hpx registry on the serving host the host map names as HPX_HOST"
kernel_private = "The chain archive node, the sequencer, the replica, the core boundary, the receipt authority, the internal kms, the event sources, Redis, the mirror publisher and the bridge relayer get no public name; they are reached only from the edge or from their own host."

[design]
overview = "Wave 0 gives every later deploy task its two tools: the edge (nginx vhosts, certificates, the internal CA) and the probe (tools/bringup/check-live.sh with one subcommand per system, reading BRINGUP_HOSTS_FILE). Wave 1 makes the kernel real on the kernel host: settlement inputs on the precompiles, the finality verifier bound in layerxd, the bare-host abort points fixed, the genesis and sequencer key generated on the host, systemd units, and a value loop proven through layerxctl. Wave 2 puts the boundaries on the kernel host and the gateway, identity, internal services and registry on the platform host and cuts the Fly endpoint over. Wave 3 completes the human graph for the wallet identity and brings agentd and MCP live. Wave 4 runs in parallel over everything else."

[design.probe]
script   = "tools/bringup/check-live.sh <subcommand> follows tools/wallet/check-live.sh: one subcommand per system, one line per check printed as pass or fail with the observed value, exit 0 only when every check passes, exit 2 on usage, CHECK_LIVE_TIMEOUT per request; ssh checks use the host map and never print it; tools/bringup/check-live.test.sh exercises the argument parsing and the pass and fail lines against local fixtures."
subcommands = "hosts, ca, edge, kernel-genesis, kernel-node, kernel-value-loop, paxeer-boundary, kernel-boundaries, router, router-cutover, identity, internal, registry, human, agent, human-cutover, wallet, search, archive-node, explorer, developers, relay, interop, mirrors, ramp, gas, bridge, hpx, rpc-nodes"

[design.units]
layout   = "Each host gets /etc/layerx/<service>/env (0600, root) with exactly the env names the pod definition declares, /etc/layerx/<service>/tls with the host-generated key and the CA-signed certificate, and one systemd unit per container named layerx-<service>.service with ExecStart taken from the container command, LoadCredential for every secret file, a dedicated system user matching the pod's uid where one is declared (4020, 4021, 4026, 65532) and Requires or After edges mirroring the pod's init order."

[documentation]
mode      = "auto"
status    = "pending"
audiences = ["user", "developer", "operator"]
targets   = ["README.md", "docs/**", "platform/docs/**", "CONTRIBUTING.md", "CHANGELOG.md"]

[req.1]
title = "Edge host serves every public name"
story = "As a user of any Paxeer X surface, I reach it under its public name over a valid certificate and never a backend port."
ac_1  = "WHEN any name of [decision.public_names] under paxeer.network is requested over HTTPS THE edge host SHALL answer with a Let's Encrypt certificate valid for that name and proxy to the backend named for it over the backend's own TLS under the internal CA."
ac_2  = "WHEN a backend port is opened from anywhere but the edge host THE backend host SHALL refuse the connection, and WHEN tools/bringup/check-live.sh edge runs THE probe SHALL report every public name and every firewalled port."
ac_3  = "WHEN a backend is not yet up THE edge host SHALL answer 502 or 503 for its name rather than refuse the TLS connection, so the name and certificate exist before the backend."

[req.2]
title = "Internal CA and per-service certificates"
story = "As an operator, every service on every host presents a certificate chained to one internal CA whose key never leaves the edge host."
ac_1  = "WHEN tools/bringup/ca.sh init runs on the edge host THE script SHALL generate the CA key and certificate under /etc/layerx/ca with mode 0600 and print nothing but the certificate fingerprint."
ac_2  = "WHEN tools/bringup/ca.sh issue <service> <host role> runs THE target host SHALL generate its own key and signing request, THE edge host SHALL sign it with the SANs the pod definition needs including localhost and the loopback address for services reached on loopback, and THE certificate SHALL land under /etc/layerx/<service>/tls without the key ever leaving the target host."
ac_3  = "WHEN tools/bringup/check-live.sh ca runs THE probe SHALL verify every issued certificate chains to the CA, carries its SANs and is at least thirty days from expiry."

[req.3]
title = "Docs and configs name the router URL and the real hosts"
story = "As a developer reading the docs or an example, I find the endpoint that answers today."
ac_1  = "WHEN any tracked file outside spec/ is searched for api.paxeer.network THE repository SHALL contain no match; the unified endpoint is written as https://api.mainnet-beta.router.paxeer.network everywhere."
ac_2  = "WHEN any tracked file outside spec/ is searched for a layerx.example host, a name of the form label.layerx.example, THE repository SHALL contain no match; the names of [decision.public_names] replace them. A package identifier or a file name that merely contains the words layerx and example is not a host."
ac_3  = "WHEN docs/site/docs/reference/public-rpc.md is read THE sixteen RPC endpoints SHALL be unchanged and the page SHALL link the router URL as the unified interface."

[req.4]
title = "Operator host map and live probe"
story = "As an operator, one script tells me whether each system is live, reading the host map from BRINGUP_HOSTS_FILE and never printing it."
ac_1  = "WHEN BRINGUP_HOSTS_FILE is unset or lacks one of the eight role names of [decision] host_map THE probe SHALL exit 2 naming the missing role and nothing else."
ac_2  = "WHEN tools/bringup/check-live.sh <subcommand> runs THE probe SHALL print one pass or fail line per check with the observed value and exit 0 only when every check passes."
ac_3  = "WHEN tools/bringup/check-live.test.sh runs THE test SHALL prove the usage error, one passing subcommand and one failing subcommand against local fixtures without the network."

[req.5]
title = "Kernel settlement on the precompiles and a bound finality verifier"
story = "As the network, the LayerX sequencer settles against the live chain's precompiles and bootstraps under a real finality authority."
ac_1  = "WHEN the node pod's settlement inputs are read THE sequencer SHALL take the registry precompile 0x0000000000000000000000000000000000001004, the custody precompile 0x0000000000000000000000000000000000001013 and the anchor precompile 0x0000000000000000000000000000000000001014 on chain 125 through the loopback JSON-RPC, and LAYERX_NODE_SETTLEMENT_CONTRACT and LAYERX_NODE_SETTLEMENT_ENV SHALL no longer name a Solidity deployment."
ac_2  = "WHEN layerxd starts as the sequencer THE finality-authority verifier SHALL be bound to the anchor precompile's certificate rules and the chain's finalized head read over the loopback RPC, and the sequencer SHALL bootstrap without a fake or a stub verifier."
ac_3  = "WHEN make layerxd test-daemon-finality-authority runs THE test SHALL exercise the bound verifier against the real chain through the loopback RPC or a recorded chain fixture of it, never through anvil."

[req.6]
title = "Kernel node on the kernel host"
story = "As the network, the sequencer, its replica, the guarantor and the clock authority run under systemd on the kernel host from a genesis and a sequencer key made on that host."
ac_1  = "WHEN the bare-host bring-up of platform/hosted/node runs THE seven abort points of the readiness report SHALL be fixed: the genesis metadata is generated before the node starts, the three human providers implement probe, the Solidity deploy step is not called, the receipt-authority certificate carries the loopback SANs, the evidence provisioning journal path is set, a missing builder environment directory fails loudly, and the program lint's ABI module name matches the runtime's."
ac_2  = "WHEN tools/bringup/kernel-genesis.sh runs on the kernel host THE script SHALL build the genesis manifest with layerx-genesis-build, generate the sequencer key with the pod's signer material contract, write both under /etc/layerx/node with mode 0600, print only the genesis digest and the sequencer public key, and record that path as the custody path."
ac_3  = "WHEN the layerxd units are started THE supervisor socket SHALL report ready, the LNI socket SHALL exist, the authority replica SHALL answer its head on loopback and every process SHALL run under the clock authority."
ac_4  = "WHEN one SEND activity is submitted with layerxctl over the LNI THE replica SHALL show the batch that carries it and THE anchor precompile SHALL show a checkpoint at or after that batch as submitted or final."

[req.7]
title = "Trusted boundaries on the kernel host"
story = "As the gateway and the human graph, I reach the core boundary, the receipt authority, the agent boundary and two Paxeer boundaries over TLS on the kernel host."
ac_1  = "WHEN the core boundary, receipt authority and agent boundary units run THE three SHALL answer their readiness routes over TLS under the internal CA with their pod env names, the receipt authority bound to the replica on loopback and the identity binding socket, and the agent boundary bound to the LNI socket."
ac_2  = "WHEN the two Paxeer boundary units run THE first SHALL relay to the loopback node and the second to one of the sixteen public RPC names, both with LAYERX_PAXEER_CHAIN_ID 125, so a reader requiring agreement of two has two sources."

[req.8]
title = "Gateway at the router URL"
story = "As any client, https://api.mainnet-beta.router.paxeer.network answers eth_, lx_ and px_ methods from one endpoint with the kernel available."
ac_1  = "WHEN the gateway and Redis units run on the platform host THE gateway SHALL be in kernel mode with core_agent_boundary, independent_receipt_authority and program_registry configured and its readiness SHALL report every backend up."
ac_2  = "WHEN tools/bringup/check-live.sh router runs THE probe SHALL see eth_chainId 0x7d, px_getNetwork with kernel.available true and lx_getAccount answering a read for a bound account, all through the edge."
ac_3  = "WHEN the router passes its probe THE Fly shared endpoint SHALL be cut over: the wallet gateway and the PWA point at the router URL, the Fly app is stopped and not deleted, and tools/bringup/check-live.sh router-cutover confirms the router answers where the endpoint did."

[req.9]
title = "Identity, internal services and program registry on the platform host"
story = "As the developer plane, I dial the identity service, the internal kms with its four event sources and the program registry on real names."
ac_1  = "WHEN the identity unit runs THE service SHALL answer readiness at identity.paxeer.network through the edge with its pod env names and its key material generated on the platform host."
ac_2  = "WHEN the internal kms and the journeys, payments, approvals and programs event source units run THE five SHALL answer readiness over mandatory mTLS under the internal CA on the platform host, reachable only from that host and the edge."
ac_3  = "WHEN the program registry unit and its builder rootfs run THE registry SHALL answer /healthz over mTLS at registry.paxeer.network, the builder environment directory SHALL exist from builder-environment/build-env.sh, and one reference program deploy SHALL return a sequencer-signed receipt with result code 0."

[req.10]
title = "Human graph on the kernel host for the wallet identity"
story = "As a wallet user signed in with the Supabase identity, the human service admits my assertion, resolves my principal and signs through the five attestors."
ac_1  = "WHEN the identity provider receives LXIP operation 4 with an assertion THE provider SHALL verify it against the configured JWKS and return the principal and did:layerx identity, and THE provider's serve command SHALL wire the assertion configuration at startup."
ac_2  = "WHEN a wallet-facing operation arrives with an Authorization bearer from a listed origin THE human service SHALL admit the assertion through operation 4, keep the passkey cookie path unchanged, and pass the same assertion to admit_assertion for attestor signing."
ac_3  = "WHEN LAYERX_HUMAN_ATTESTOR_NODES is set THE components loader SHALL accept an absent LAYERX_HUMAN_KMS group, use the five attestors at protocol 3 with threshold three, and refuse to start only when neither custody backend is complete."
ac_4  = "WHEN the identity, security, movement, components, service and onboarding units run on the kernel host under their uids THE service SHALL answer /livez and /readyz ready at human.paxeer.network through the edge, admitting https://paxportwallet.com."
ac_5  = "WHEN every HTTP route the wallet SDK calls is compared with the routes the human service serves THE service SHALL serve each one with the schema the SDK expects."
ac_6  = "WHEN the wallet PWA on Railway carries NEXT_PUBLIC_PAXEER_HUMAN_API=https://human.paxeer.network THE check-live human-session gate of the wallet feature SHALL pass against that name, and the Fly human service SHALL then be stopped and not deleted."

[req.11]
title = "Agent daemon and MCP live"
story = "As a model client, I open an MCP session whose every call goes through a live agentd on the kernel host."
ac_1  = "WHEN the agentd unit runs in human-owner mode on the kernel host THE daemon SHALL answer /healthz ready with the program bearer after its LNI handshake and authority read, and THE agentd boundary SHALL publish it over mTLS at agent.paxeer.network."
ac_2  = "WHEN tools/bringup/mcp-enrol.sh runs on the kernel host THE script SHALL enrol one session and capability through the daemon and write the binding document with two owner-only secret files, and THE layerx-mcp unit SHALL serve the peer-admitted socket."
ac_3  = "WHEN an admitted client runs layerx mcp serve with the binding THE tools/list answer SHALL contain the read tools and the web tools."

[req.12]
title = "Wallet move completed"
story = "As the owner, the production wallets are migrated with the ceremony tool and the wallet endpoint serves the new gateway."
ac_1  = "WHEN the pre-approved move runbook steps 00 to 11 have run THE wallet endpoint SHALL answer through the new gateway with the x-served-by header and readiness true, as tools/wallet/check-live.sh cutover checks."

[req.13]
title = "Paid web search on the validator sidecars"
story = "As an agent, I pay 402LXP for a search and the sidecar settles through the router."
ac_1  = "WHEN the four sidecar configs are re-rendered THE gateway.endpoint SHALL be the router URL's /rpc, the sequencer id and public key SHALL be the kernel host's real ones, the four asset ids SHALL be the kernel-registered ids, and the units SHALL restart with /health ok."
ac_2  = "WHEN one /search is paid with a PAYMENT-SIGNATURE THE sidecar SHALL answer 200 through search.paxeer.network, and WHEN the submitters are funded and one fetch request is sent to the xweb precompile THE loop SHALL end in XWebFulfilled."

[req.14]
title = "Explorer fork in production over the archive host"
story = "As a user, paxscan.io shows the whole chain history and the kernel entities."
ac_1  = "WHEN the archive host's node runs with min-retain-blocks 0 THE node SHALL answer eth_getBlockByNumber for a block below the first pruned height of the public nodes and follow the head."
ac_2  = "WHEN the deployed explorer backend reads the archive host's public RPC name as its primary endpoint THE frontend SHALL answer 200 at paxscan.io, the backend's /api/health and /api/v2/stats SHALL answer 200, and PAXEER_X_CAPABILITIES_ENABLED SHALL be true with /api/v2/paxeer-x/capabilities answering 200."
ac_3  = "WHEN the history copy job has run THE block count from the first indexed block SHALL match the legacy source."

[req.15]
title = "Developer plane"
story = "As a developer, I register webhooks and read my dashboard at their names."
ac_1  = "WHEN the webhooks, dashboard API and dashboard web units run on the platform host THE three SHALL answer readiness at webhooks.paxeer.network, api.developers.paxeer.network and developers.paxeer.network through the edge, dialing identity, the internal event sources and the gateway Redis."

[req.16]
title = "Relay archive, interop gateway, mirrors and ramp"
story = "As an independent reader, a payments integrator, a verifier and a market maker, I reach each surface as far as its real inputs allow."
ac_1  = "WHEN the relay archive unit runs on the platform host with the kernel's pins and the sequencer-colocated origin THE service SHALL answer /readyz and /v1/sync/head at archive.paxeer.network and forward one signed activity to the router with the router's verdict."
ac_2  = "WHEN the interop gateway unit runs with a config rendered by render.py --check THE service SHALL answer /readyz at interop.paxeer.network and complete one x402 exact-scheme exchange."
ac_3  = "WHEN the AP2 keys, Visa TAP identities and fiat provider credentials are supplied THE rendered config SHALL enable those adapters and their conformance legs SHALL pass against the deployed host."
ac_4  = "WHEN the mirror chain inputs are supplied THE archive contract and program SHALL be deployed, the signer and publisher units SHALL run beside the node, and layerx-mirror-verify SHALL verify one receipt from the mirror alone."
ac_5  = "WHEN the ramp's provider, compliance, KMS and custody-owner coordinates are supplied THE reference ramp unit SHALL answer /readyz at ramp.paxeer.network and the sandbox journey SHALL record done."

[req.17]
title = "Gas station and bridge relayer"
story = "As a holder of SID, I pay gas in SID; as a bridge user, my deposit on a foreign chain is credited on Paxeer X."
ac_1  = "WHEN the gas station unit runs on the platform host with the sponsor account THE station SHALL answer readiness at gas.paxeer.network and complete one sponsored batch at the owner-set rate."
ac_2  = "WHEN the bridge inputs are supplied THE vaults and program SHALL be deployed, the governance proposals SHALL open each chain, the checklist SHALL read every chain back, and the relayer unit with its remote signer SHALL journal one observed deposit as bridgeIn."

[req.18]
title = "CI runners, hpx registry and the public RPC fleet"
story = "As the project, CI runs on Fly, new nodes install from the registry, and all sixteen public RPC nodes follow the head."
ac_1  = "WHEN the controller's GitHub token is supplied THE runner image and controller SHALL be deployed, CI_LINUX_RUNNER SHALL be fly-linux and the canary SHALL run on a fly- runner."
ac_2  = "WHEN publish.sh and hosting/deploy.sh have run on the serving host THE registry SHALL answer /healthz at node.hyperpaxeer.com with the chain id and the source revision, and a clean install SHALL state-sync."
ac_3  = "WHEN tools/bringup/check-live.sh rpc-nodes runs THE sixteen public RPC names SHALL each answer eth_blockNumber within ten blocks of the highest answer and none SHALL be frozen or crash-looping."

[tasks]
heading = "Implementation Plan: paxeer-x-bringup"

[task.0]
section = "Wave 0 - Edge and docs"
title   = "Front every public name, issue the internal CA, fix the docs and deliver the probe"
status  = "pending"

[task.0.1]
title      = "Deliver the operator host-map contract and the bring-up live probe"
status     = "done"
wave       = 0
requires   = []
do_1       = "Write tools/bringup/check-live.sh after tools/wallet/check-live.sh: a usage block, one function per subcommand of [design.probe], pass and fail lines with the observed value, CHECK_LIVE_TIMEOUT, exit 0 only when every check passes and 2 on usage; every subcommand of a later task is added by that task."
do_2       = "Source BRINGUP_HOSTS_FILE in a load_hosts function that exits 2 naming the first missing role of EDGE_HOST, KERNEL_HOST, PLATFORM_HOST, EXPLORER_HOST, ARCHIVE_HOST, VALIDATOR_HOSTS, RPC_HOSTS and HPX_HOST, and never echoes a value; implement the hosts subcommand as one ssh true per role."
do_3       = "Write tools/bringup/check-live.test.sh after tools/wallet/check-live.test.sh proving the usage exit, a passing subcommand and a failing subcommand against local fixtures with no network."
verify_cmd = "timeout 10m tools/bringup/check-live.test.sh"
symbols    = ["load_hosts", "check_hosts", "usage"]
touches    = ["tools/bringup/check-live.sh", "tools/bringup/check-live.test.sh"]
tests      = ["tools/bringup/check-live.test.sh"]
reqs       = ["4.1", "4.2", "4.3"]

[task.0.2]
title      = "Create the internal CA on the edge host and issue per-service certificates on their hosts"
status     = "implemented"
wave       = 0
requires   = ["0.1"]
do_1       = "Write tools/bringup/ca.sh with init (CA key and certificate under /etc/layerx/ca on the edge host, 0600, printing only the fingerprint) and issue <service> <role> (the target host generates key and CSR under /etc/layerx/<service>/tls, the edge signs with the SAN list the pod definition declares plus localhost and the loopback address for loopback-reached services, the certificate is copied back; the key never leaves the host)."
do_2       = "Take the SAN list per service from platform/hosted/tests/beta-cluster.sh issue_cert calls so the receipt authority, core, agent boundary, identity, internal, registry, gateway, human and interop certificates match what their clients verify."
do_3       = "Add the ca subcommand to tools/bringup/check-live.sh: every issued certificate chains to the CA, carries its SANs and expires in more than thirty days."
verify_cmd = "timeout 10m tools/bringup/check-live.sh ca"
symbols    = ["ca_init", "ca_issue", "check_ca"]
touches    = ["tools/bringup/ca.sh", "tools/bringup/check-live.sh"]
tests      = ["tools/bringup/check-live.test.sh"]
reqs       = ["2.1", "2.2", "2.3"]

[task.0.3]
title      = "Serve every public name from the edge host with nginx and certbot"
status     = "pending"
wave       = 0
requires   = ["0.2"]
do_1       = "Write tools/bringup/edge/render.sh producing one nginx vhost per name of [decision.public_names] under paxeer.network, each proxying to its backend role and port over HTTPS with proxy_ssl_trusted_certificate /etc/layerx/ca/ca.pem and proxy_ssl_verify on, WebSocket upgrade for the router, and 502 or 503 while the backend is down; the sixteen RPC vhosts are not touched."
