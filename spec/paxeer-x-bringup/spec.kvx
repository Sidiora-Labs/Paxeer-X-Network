# paxeer-x-bringup — feature spec. Requirements, design, then the task list.
#
# The unified Paxeer X Network brought up end to end. Every LayerX service that
# is an ordinary container runs as a Fly app on the private network of the
# wallet fleet's organisation, on several machines where the service gains from
# them and on one machine with a volume where it has a single writer. Our own
# servers keep only what holds chain data: the sixteen public RPC nodes, the
# archive node and the private validators; the edge host is the operator host
# and keeps the internal CA key. The explorer fork runs on Railway, and paxscan.io
# reaches it through our own nginx proxy. Hosts are named by role
# only; the operator's private host map is the file named by BRINGUP_HOSTS_FILE.

[meta]
feature   = "paxeer-x-bringup"
title     = "Bring every LayerX system of Paxeer X Network live on Fly and on the chain hosts"
kind      = "product-feature-specification"
version   = "1.4.0"
status    = "in_progress"
language  = "Rust (platform/, human/, agent/, interop/ crates), C (cmd/layerxd, src/), Go (hpx/registry, tools/flyci, bridge/deploy), POSIX shell for the probe, the Fly inits and the host scripts, Fly toml for the app definitions, Python where the hosted pod definitions already use it"
repo_root = "platform/hosted/ (the pod definitions, entrypoints and env contracts every Fly app reuses, with each new fly.toml beside its definition); docker/ (one directory per service image, docker/kernel for the kernel app); human/wallet/deploy/ (the Fly toml files of the wallet fleet, including the router and the kernel app); tools/bringup/ (the host-map contract, the internal CA and the live probe); cmd/layerxd and src/ (the kernel); human/crates/ (the human graph); agent/crates/ (agentd and MCP); interop/ (interop gateway, mirrors, x-websearch, bridge relayer, gas station); explorer/ (the explorer fork); docs/site and docs/wiki (the public names); spec/paxeer-x-bringup/ (this feature and its qualification log)"
intro     = "Every LayerX system that the surveys found ready, blocked or incomplete is brought up with real keys and served under a public name, and nothing that is still useful is disabled or removed. What can run on Fly runs on Fly: the kernel pod with its boundaries, the human graph, agentd and MCP as one app with one machine and one volume, the router on the existing endpoint app across two regions, the wallet endpoint on the existing wallet gateway app, and the identity service, the internal services, the registry, the indexer, the developer plane, the relay archive, the interop gateway, the ramp, the gas station, the bridge relayer, the hpx registry, the search front and each of the four x-websearch attestors as its own app. Our servers keep the chain: the sixteen RPC nodes, each also serving paid search from a loopback sidecar and none on a validator host, the archive node and the private validators, which serve no public surface. Work is ordered in five waves from the tooling and the search front to the kernel, the router and the platform apps, the human graph, and finally everything that runs beside them. A task whose only missing piece is an owner input carries blocked_on naming that input and stays a real task with a real probe."

[decision]
retired          = "Off every task list, code kept for private networks: testnet control and the faucet (platform/hosted/testnet, platform/hosted/faucet), the Solidity settlement path (platform/hosted/paxeer/init-chain.sh, deploy-contracts.sh, the anvil-based forge tests and the contracts/ deployment scripts), the old human web application (human/apps/web) and the explorer-index crate (human/crates/layerx-explorer-index). Nothing else is turned off; an incomplete system is completed."
router_url       = "The unified LayerX plus Paxeer interface, the hosted gateway of platform/hosted/gateway run by the existing Fly endpoint app of human/wallet/deploy/endpoint.toml, is served only at https://api.mainnet-beta.router.paxeer.network. Every document, example, manifest and config that says api.paxeer.network is rewritten to that URL. The sixteen public RPC names api1 to api16.mainnet-beta.paxeer.network stay exactly as docs/site/docs/reference/public-rpc.md lists them. The endpoint app's fly.dev name exists only as the target of the router's CNAME and is never published, documented or configured as an endpoint."
placement        = "Whatever can run on Fly runs on Fly, in the organisation of the wallet fleet, and a service that gains from several machines runs on several. Stateless services run on at least two machines in two regions: the router, the wallet gateway, the search front, the dashboard web and API, both process groups of webhooks, the interop gateway and the relay archive, whose machines each keep their own volume and sync from the origin. A service with a single writer runs on one machine with a volume, because parallel machines would race its journal, its nonce or its state directory: the identity service, the internal kms and each event source, the internal Redis, the router's Redis, the program registry, the indexer, the reference ramp, the gas station, the bridge relayer, the hpx registry, whose node directory has one writer, and each x-websearch attestor, whose attestor key signs as one registered signer. The router's Redis stays one machine in the router's primary region because Redis has one writer and the gateway keeps its idempotency and session keys in it; the router's machines in the second region cross regions for those keys, and the router probe reports that round trip from each region. The kernel pod runs as one app with exactly one machine and one volume, because its sequencer, replica, boundaries, human graph, agentd and MCP talk over unix sockets under peer-uid checks that cannot cross machines; the human graph therefore cannot be split from it, and the existing human service app becomes the kernel app. Our servers keep only what holds or fronts chain data."
host_roles       = "edge host: the operator host; it holds the internal CA key and the Fly and Railway operator logins, is the landing point of the *.paxeer.network wildcard, so a name without an explicit record reaches it, and serves with nginx and certbot the hpx registry at node.hyperpaxeer.com until task 4.21 serves it from Fly, the hpx host role naming the same host until then. explorer proxy host: a server of ours whose nginx answers paxscan.io and forwards to the frontend service of the Railway explorer project; no task of this feature changes it. old wallet host: the old wallet service with its Compose database and Caddy proxy, named by the OLD_WALLET_HOST role of the host map until task 4.1 retires the service. archive host: the full node with min-retain-blocks 0 behind one of the sixteen public RPC names and the explorer's primary upstream. validator hosts: the private validators only; no public name, certificate SAN, Fly upstream, boundary hop, RPC setting or public-facing command names them, and the only access is private ssh from the operator host in tasks 0.6, 4.22 and 4.23; task 4.22 moves the public full node that one validator host still runs to its own server, and task 4.23 moves the four x-websearch attestor sidecars they still run to Fly one slot at a time, their attestor ports open meanwhile only to loopback and to the other validator host. RPC hosts: the sixteen public RPC nodes with nginx and certbot. The serving RPC names are the apiN names of the RPC_HOSTS destinations that are not VALIDATOR_HOSTS, each destination mapped to its apiN name through its nginx site as rpc_unit of tools/bringup/check-live.sh reads it, all sixteen once task 4.22 is done; each serving node also serves paid search from a loopback x-websearch sidecar, and every RPC setting of this feature names a serving RPC name. No host of ours runs the kernel, the platform services, the search front or the explorer; the explorer proxy host only forwards paxscan.io."
private_network  = "Fly apps of the organisation reach each other at <app>.internal over the private network, which resolves to IPv6 only, so every listen value and socat bind of a Fly app is [::]:PORT and every internal-CA certificate of a Fly app carries its app's .internal name. A service that runs as one process group of an app with several groups is reached at <group>.process.<app>.internal, because the app's .internal name resolves to the machines of every group, and its certificate carries that name. A Fly app reaches our servers only through their public TLS names. A public name served by Fly is an http_service on a plain listener behind a Fly certificate, except an mTLS surface, which is a TCP passthrough service on a dedicated IPv4 because the client certificate is checked in the backend."
edge_server      = "nginx with certbot, already installed on each RPC node, serves the sixteen RPC names on their nodes; on the edge host, which the hpx host role also names, nginx with certbot serves node.hyperpaxeer.com until task 4.21 and answers the names that reach it through the *.paxeer.network wildcard; no Caddy vhost is added. Every Fly-served name takes a Fly certificate from flyctl certs add, search.paxeer.network on the search front app included, and the public wallet endpoint name and node.hyperpaxeer.com once tasks 4.1 and 4.21 move them. The Caddy proxy of human/wallet/deploy/cutover on the old wallet host is not the endpoint's future: task 4.1 serves the name from the wallet gateway app and removes the wallet site from that proxy."
supervision      = "Fly Machines run and restart every Fly app. The kernel app runs its processes under a root init in its image that starts each under its uid and restarts one that exits; the bridge relayer, the hpx registry and each x-websearch attestor run their processes under an entrypoint that exits when any of them exits, so Fly Machines restart the machine; Fly process groups become separate machines that cannot share unix sockets. Every single-machine app with state takes daily volume snapshots with retention, and every machine of the relay archive app in both regions holds the kernel's genesis, snapshot and batches verified under the sequencer key. systemd on our servers supervises only the chain nodes, the serving x-websearch sidecars and nginx. The runtime clock wraps every binary the pod definitions wrap."
key_custody      = "Secrets and key material are generated where they are used and never printed, copied into the repository or into the ops directory. A single-machine Fly app generates each key and its signing request inside its machine on its volume; tools/bringup/ca.sh fetches the request through flyctl ssh console, signs it on the edge host and writes the certificate back to the volume the same way, only the CA roots it verifies against reach it as Fly secrets mounted through [[files]], and its init starts a TLS listener only once that listener's certificate is on the volume. An app with several machines gets its keys as Fly secrets: the task's script generates them in a tmpfs directory on the edge host, which is the operator host holding the Fly and Railway operator logins, pipes them into flyctl secrets import on standard input, then removes the directory. A key on our servers is generated on the host that uses it. Each task records the custody path for the owner in its do lines. The internal CA key lives on the edge host only."
internal_ca      = "The internal CA of tools/bringup/ca.sh keeps its consumers on Fly: the core, receipt authority and agent boundary client CAs, the kms and event source client CAs, the registry client CA, the agentd socat verify, the guarantor peer TLS, the Redis TLS of the router's Redis and of the internal Redis, the relay archive origin in the kernel app, the webhooks ingress that the event producers of the router, the registry and the human service dial over https with their client identities, the indexer and the gateway's mandatory outbound CA all verify against it. It is kept and its certificates carry the .internal names of the apps. A certificate carries a public name only for the two TCP passthrough surfaces, registry.paxeer.network and agent.paxeer.network, because every other public name is terminated by a Fly certificate or by certbot. The x-websearch row is removed because the binary serves no TLS, the developer row becomes the webhooks ingress certificate, an internal-redis row is added, every client row is kept, and the server rows of the gateway, the interop gateway, the ramp and the gas station are removed because each serves only a plain listener behind the Fly edge and no client dials their TLS."
search           = "Paid search is served by x-websearch sidecars on the serving RPC nodes of host_roles. By the owner's product ruling the web search sidecar is a node sidecar: each serving RPC node runs it beside its own node over loopback, holds its own receiver key and settles its own paid requests through the router, so the node operator is the party paid; it is part of the node role, not a platform service, and the many-servers rule is met by serving from every public RPC node whose host is not a validator host. Each sidecar is routed by an nginx snippet inside its apiN vhost for /search, /fetch, /content/ and /xweb/health. search.paxeer.network is served by the search front, an nginx Fly app on at least two machines in two regions whose split_clients on the Fly-Client-IP header picks the same serving node for a client address on every machine, because the 402 answer and the paid retry must reach the receiver that priced the request; the https://apiN.mainnet-beta.paxeer.network/search URL of every serving node is the redundant path a client uses directly. The four attestor sidecars fetch the URL of every on-chain fetch request, so they run as four private Fly apps, one per registered attestor key, once the owner approves moving the keys in task 4.23, and serve on-chain attestation and the kernel relay only; their peers setting admits https or loopback http only, so each reaches its peers through loopback socat hops to the peers' .internal names."
cutover          = "No Fly app moves to our servers and none is stopped: the existing endpoint app becomes the router, the existing human service app becomes the kernel app and serves human.paxeer.network, the wallet gateway and the wallet PWA are repointed at the router URL, and the public wallet endpoint name moves from the old wallet host's Caddy proxy to a Fly certificate on the wallet gateway app. Fly keeps the five attestors and the wallet gateway; Railway keeps the explorer and the wallet PWA. The wallet ops app, one alpine machine with no toml, runs no service: it holds the operator and gateway client identities of the attestor fleet as its secrets, the move runbook materialises from it through flyctl ssh console the identities that the ceremony and tools/wallet/check-live.sh use, and it is kept as that custody store."
no_placeholders  = "No config, unit or document carries a placeholder value. When the only missing piece of a task is something the owner alone can produce, the task carries blocked_on = the exact input, its do lines and verify_cmd are real, and the task is worked the moment the input arrives; it is never marked done, weakened or removed while blocked."
host_map         = "BRINGUP_HOSTS_FILE names a private env file with EDGE_HOST, ARCHIVE_HOST, VALIDATOR_HOSTS and RPC_HOSTS, HPX_HOST until task 4.21 serves the hpx registry from Fly and OLD_WALLET_HOST until task 4.1 retires the old wallet service, each an ssh destination the operator can reach or, for the plural roles, a space-separated list of them. tools/bringup/check-live.sh sources it and never prints it; a Fly check reads the app name from the app's toml and reaches its machines through flyctl ssh console; no spec file, unit, toml or document contains a host address."
public_roots     = "A Fly app that verifies a public certbot certificate with a single-root verifier, the event producers' upstream CA of platform/hosted/internal/src/tls.rs and the indexer's endpoint CA DER, pins ISRG Root X1, because each takes exactly one DER root per upstream and every certbot chain of our RPC names ends at that root; the probe of each such consumer checks that the upstream's chain ends at ISRG Root X1; the router's Fly certificate can be served on a chain ending at ISRG Root X2, so a consumer of the router pins whichever of the two roots ends the chain the router serves, and its probe accepts either and checks the pin matches. A consumer that reads a PEM bundle, the relay archive's ca_file, carries ISRG Root X1 and ISRG Root X2 beside the internal CA root."
derivation_message = "The account-derivation message of agent/crates/layerx-crypto/src/account_derivation.rs, the SDKs, the conformance fixture and material.py names app.paxeer.network as the signing origin; that name is part of every derived account and is not a served name. Changing it changes every derived account, so task 4.26 carries the owner's ruling as its blocked_on: either the message and every copy of it name paxportwallet.com together, or app.paxeer.network is served as a redirect to paxportwallet.com under a Fly certificate."

[decision.public_names]
title = "Public names, each with its serving platform and its DNS shape, all under paxeer.network unless the owner named the host"
router       = "api.mainnet-beta.router.paxeer.network -> Fly: the gateway of the existing endpoint app of human/wallet/deploy/endpoint.toml on its plain http_service with a Fly certificate. DNS: an explicit CNAME to that app's fly.dev name."
rpc          = "api1..api16.mainnet-beta.paxeer.network -> our sixteen RPC nodes with nginx and certbot, unchanged; each serving RPC name of [decision] host_roles also routes /search, /fetch, /content/ and /xweb/health to its loopback x-websearch sidecar. DNS: the existing explicit records, unchanged except the one record task 4.22 moves off a validator host to its own server."
human        = "human.paxeer.network -> Fly: the human service in the kernel app of human/wallet/deploy/human.toml on its plain 8080 http_service with a Fly certificate. DNS: an explicit CNAME to that app's fly.dev name."
agent        = "agent.paxeer.network port 9454 -> Fly: the agentd mTLS surface of the kernel app through a TCP passthrough service on the app's dedicated IPv4. DNS: an explicit CNAME to the kernel app's fly.dev name."
identity     = "No public name: every caller of the identity service is a Fly app, and it answers at its app's .internal name on the private network."
registry     = "registry.paxeer.network port 443 -> Fly: the program registry app of platform/hosted/registry/fly.toml through a TCP passthrough service on the app's dedicated IPv4, presenting its internal-CA server certificate to mTLS clients. DNS: an explicit CNAME to that app's fly.dev name."
developers   = "developers.paxeer.network -> Fly: the dashboard web app of platform/hosted/dashboard/web/fly.toml; api.developers.paxeer.network -> Fly: the dashboard API app of platform/hosted/dashboard/fly.toml; webhooks.paxeer.network -> Fly: the webhooks app of platform/hosted/webhooks/fly.toml; each on a plain http_service with a Fly certificate. DNS: one explicit CNAME each to its app's fly.dev name."
archive      = "archive.paxeer.network -> Fly: the relay archive app of platform/relay_archive/fly.toml on its plain http_service with a Fly certificate. DNS: an explicit CNAME to that app's fly.dev name."
interop      = "interop.paxeer.network -> Fly: the interop gateway app of platform/hosted/interop/fly.toml on its plain http_service with a Fly certificate (x402, AP2, UCP, Visa TAP, fiat, http, mcp, a2a). DNS: an explicit CNAME to that app's fly.dev name."
gas          = "gas.paxeer.network -> Fly: the gas station app of interop/deploy/gas-station/fly.toml on its plain http_service with a Fly certificate (Sidiora-priced sponsored gas). DNS: an explicit CNAME to that app's fly.dev name."
search       = "search.paxeer.network -> Fly: the search front app of interop/deploy/search-front/fly.toml, nginx on a plain http_service with a Fly certificate, one client kept on one serving node by client address, proxying over verified TLS to the serving RPC names, whose nginx routes the search paths to their sidecars. DNS: an explicit CNAME to that app's fly.dev name, which wins over the wildcard."
ramp         = "ramp.paxeer.network -> Fly: the reference ramp app of platform/ramps/fly.toml on its plain http_service with a Fly certificate. DNS: an explicit CNAME to that app's fly.dev name."
explorer     = "paxscan.io -> our explorer proxy host of [decision] host_roles, whose nginx forwards to the Explorer Frontend service of the Railway project paxeer-x-explorer-dev; that frontend's API host is the project's Explorer Backend service with its Postgres. DNS: as deployed, unchanged; the proxy keeps answering the name, and no explorer.paxeer.network name is served."
wallet       = "paxportwallet.com -> Railway: the wallet PWA, the service paxport of the Railway project honest-spontaneity. DNS: as deployed, unchanged. The five attestors stay on Fly on the private network."
wallet_endpoint = "The public wallet endpoint name, the host of the wallet PWA's NEXT_PUBLIC_PAXEER_WALLET_API on Railway -> Fly: the wallet gateway app of human/wallet/deploy/gateway.toml on its http_service with a Fly certificate from task 4.1. DNS: an explicit CNAME at that name's DNS provider to the gateway app's fly.dev name, added by the owner."
hpx          = "node.hyperpaxeer.com -> Fly: the hpx registry app of hpx/hosting/fly.toml on its http_service with a Fly certificate from task 4.21; until that task runs, the hpx registry on the hpx host with nginx and certbot. DNS: an explicit CNAME in the hyperpaxeer.com zone to that app's fly.dev name, added by the owner."
kernel_private = "The chain archive node's peer side, the validators, the sequencer, the replica, the core boundary, the receipt authority, the Paxeer boundaries, the identity service, the internal kms, the event sources, both Redis apps, the indexer, the mirror publisher, the bridge relayer and the four x-websearch attestor apps get no public name; Fly apps reach them at <app>.internal over the private network, and no public name, certificate SAN, Fly upstream or owner command targets a validator host."

[design]
overview = "Wave 0 retargets the tooling from host roles to Fly apps, fronts search from a Fly app, closes the validator attestor ports and keeps the docs on the router URL. Wave 1 makes the kernel real: settlement on the precompiles, the finality verifier bound in layerxd, the bare-host abort points fixed, the kernel image and app on Fly with its init, two Paxeer boundaries inside it, the genesis and sequencer key made inside the machine and a value loop proven through layerxctl. Wave 2 runs the kernel's boundaries, turns the existing endpoint app into the router, brings the identity service and the registry up as Fly apps and gives the TLS-only public services a plain listener for the Fly edge. Wave 3 completes the human graph inside the kernel app for the wallet identity, brings the internal services up once the human service's event listener exists and brings agentd and MCP live. Wave 4 runs in parallel over everything else and ends with the probe of every public name."

[design.probe]
script   = "tools/bringup/check-live.sh <subcommand> follows tools/wallet/check-live.sh: one subcommand per system, one line per check printed as pass or fail with the observed value, exit 0 only when every check passes, exit 2 on usage, CHECK_LIVE_TIMEOUT per request; ssh checks use the host map and never print it; Fly checks read the app name from the app's toml and run inside a machine through flyctl ssh console; tools/bringup/check-live.test.sh exercises the argument parsing and the pass and fail lines against local fixtures."
subcommands = "hosts, ca, search-front, validators, kernel-app, kernel-node, kernel-value-loop, paxeer-boundary, kernel-boundaries, router, identity, internal, registry, human, agent, human-session, wallet, search, xweb-attest, xweb-attestors, archive-node, explorer, developers, relay, interop, interop-adapters, mirrors, ramp, gas, bridge, ci, hpx, rpc-nodes, rpc-placement, indexer, agent-public, names"

[design.fly]
layout   = "Each Fly app has a fly.toml beside its pod definition, or under human/wallet/deploy for the apps of the wallet fleet, and builds from its docker/ directory. Its env carries exactly the env names the pod definition declares with listen values on [::]; its secrets are [[files]] entries with a secret_name; a single-writer app mounts one volume at /data, except the hpx registry, whose image serves its node directory from /srv/hpx and mounts its volume there; a public name is an http_service on a plain listener or, for an mTLS surface, a [[services]] TCP passthrough. The kernel app's image docker/kernel is the union of docker/platform-node, platform-core, platform-authority, platform-agent-boundary, interop-mirror and human-service plus layerx-mcp on a Debian base with socat and util-linux; its init docker/kernel/init.sh replays the init containers of platform/hosted/node/deployment.yaml and then supervises every container command of that pod under its uid (4020, 4021, 4026); its volume holds /data/layerx and /data/human-state; its machine is a performance class with at least four CPUs and 16GB in the region nearest the RPC nodes by measured round trip."

[documentation]
mode      = "auto"
status    = "pending"
audiences = ["user", "developer", "operator"]
targets   = ["README.md", "docs/**", "platform/docs/**", "CONTRIBUTING.md", "CHANGELOG.md"]

[req.1]
title = "Every public name is served from its platform"
story = "As a user of any Paxeer X surface, I reach it under its public name over a valid certificate, and nothing public reaches a validator."
ac_1  = "WHEN a name of [decision.public_names] served by a Fly http_service is requested over HTTPS THE Fly edge SHALL answer with a certificate for that name from flyctl certs add and route to the app its toml declares; WHEN registry.paxeer.network or agent.paxeer.network is dialled on its passthrough port THE backend SHALL present its internal-CA certificate for that name; and WHEN search.paxeer.network is requested THE search front app SHALL answer under its Fly certificate and proxy over verified TLS to a serving RPC name only."
ac_2  = "WHEN the x-websearch attestor ports of a validator host are dialled from anywhere but loopback and the other validator host THE host SHALL refuse the connection, and WHEN tools/bringup/check-live.sh names runs THE probe SHALL show each Fly-served name except ramp.paxeer.network, which task 4.10 probes, search.paxeer.network included, as an explicit CNAME to its app's fly.dev name and no public name resolving to a validator host."
ac_3  = "WHEN the backend of a name served by a Fly http_service is not yet up THE Fly edge SHALL answer 502 or 503 for its name rather than refuse the TLS connection, so the name and certificate exist before the backend; a passthrough name is probed once its backend is up."

[req.2]
title = "Internal CA and per-service certificates"
story = "As an operator, every internal TLS surface on Fly presents a certificate chained to one internal CA whose key never leaves the edge host."
ac_1  = "WHEN tools/bringup/ca.sh init runs on the edge host THE script SHALL generate the CA key and certificate under /etc/layerx/ca with mode 0600 and print nothing but the certificate fingerprint."
ac_2  = "WHEN tools/bringup/ca.sh issue <service> <host role> runs THE target host SHALL generate its own key and signing request, THE edge host SHALL sign it with the SANs the pod definition needs including localhost and the loopback address for services reached on loopback, and THE certificate SHALL land under /etc/layerx/<service>/tls without the key ever leaving the target host."
ac_3  = "WHEN tools/bringup/check-live.sh ca runs THE probe SHALL verify every issued certificate chains to the CA, carries its SANs and is at least thirty days from expiry."
ac_4  = "WHEN tools/bringup/ca.sh issue <service> runs for a service of a single-machine Fly app THE machine SHALL generate its key and signing request on its volume, THE script SHALL fetch the request through flyctl ssh console, sign it on the edge host and write the certificate back to the volume the same way; WHEN it runs for an app with several machines THE key and request SHALL be generated in a tmpfs directory on the edge host, the operator host, piped into flyctl secrets import on standard input and the directory removed; every such certificate SHALL carry the app's .internal name beside the SANs of ac_2, and no key SHALL be printed."

[req.3]
title = "Docs and configs name the router URL and the real hosts"
story = "As a developer reading the docs or an example, I find the endpoint that answers today."
ac_1  = "WHEN any tracked file outside spec/ is searched for api.paxeer.network THE repository SHALL contain no match; the unified endpoint is written as https://api.mainnet-beta.router.paxeer.network everywhere."
ac_2  = "WHEN any tracked file outside spec/ is searched for a layerx.example host, a name of the form label.layerx.example, THE repository SHALL contain no match; the names of [decision.public_names] replace them. A package identifier or a file name that merely contains the words layerx and example is not a host."
ac_3  = "WHEN docs/site/docs/reference/public-rpc.md is read THE sixteen RPC endpoints SHALL be unchanged and the page SHALL link the router URL as the unified interface."
ac_4  = "WHEN tools/bringup/docs-names.sh runs THE tracked user, developer and operator docs SHALL name no *.paxeer.network host outside [decision.public_names], the sixteen RPC names and the signing origin of [decision] derivation_message, SHALL carry no FAUCET_URL, and SHALL fund accounts through the custody-credit path; the faucet, beta-control and testnet pages SHALL be marked private-network only with no public name."

[req.4]
title = "Operator host map and live probe"
story = "As an operator, one script tells me whether each system is live, reading the host map from BRINGUP_HOSTS_FILE and never printing it."
ac_1  = "WHEN BRINGUP_HOSTS_FILE is unset or lacks one of the role names of [decision] host_map THE probe SHALL exit 2 naming the missing role and nothing else."
ac_2  = "WHEN tools/bringup/check-live.sh <subcommand> runs THE probe SHALL print one pass or fail line per check with the observed value and exit 0 only when every check passes."
ac_3  = "WHEN tools/bringup/check-live.test.sh runs THE test SHALL prove the usage error, one passing subcommand and one failing subcommand against local fixtures without the network."
ac_4  = "WHEN a subcommand checks a Fly app THE probe SHALL read the app's name from the app line of its toml and reach its machines through flyctl ssh console, bounded by CHECK_LIVE_TIMEOUT."

[req.5]
title = "Kernel settlement on the precompiles and a bound finality verifier"
story = "As the network, the LayerX sequencer settles against the live chain's precompiles and bootstraps under a real finality authority."
ac_1  = "WHEN the node pod's settlement inputs are read THE sequencer SHALL take the registry precompile 0x0000000000000000000000000000000000001004, the custody precompile 0x0000000000000000000000000000000000001013 and the anchor precompile 0x0000000000000000000000000000000000001014 on chain 125 through the loopback JSON-RPC, and LAYERX_NODE_SETTLEMENT_CONTRACT and LAYERX_NODE_SETTLEMENT_ENV SHALL no longer name a Solidity deployment."
ac_2  = "WHEN layerxd starts as the sequencer THE finality-authority verifier SHALL be bound to the anchor precompile's certificate rules and the chain's finalized head read over the loopback RPC, and the sequencer SHALL bootstrap without a fake or a stub verifier."
ac_3  = "WHEN make layerxd test-daemon-finality-authority runs THE test SHALL exercise the bound verifier against the real chain through the loopback RPC or a recorded chain fixture of it, never through anvil."

[req.6]
title = "Kernel node as one Fly app"
story = "As the network, the sequencer, its replica, the guarantor and the clock authority run in the kernel app's one machine from a genesis and a sequencer key made inside that machine."
ac_1  = "WHEN the bare-host bring-up of platform/hosted/node runs THE seven abort points of the readiness report SHALL be fixed: the genesis metadata is generated before the node starts, the three human providers implement probe, the Solidity deploy step is not called, the receipt-authority certificate carries the loopback SANs, the evidence provisioning journal path is set, a missing builder environment directory fails loudly, and the program lint's ABI module name matches the runtime's."
ac_2  = "WHEN tools/bringup/kernel-genesis.sh runs inside the kernel app's machine through flyctl ssh console THE script SHALL build the genesis manifest with layerx-genesis-build, its LXGB metadata carrying one canonical Asset record for each asset of the custody precompile's asset map, SID, PAX, USDC and USDL among them, whose ids the x-websearch configs name, generate the sequencer key with the pod's signer material contract, write both under /data/layerx/node on the app's volume with mode 0600, print only the genesis digest, the sequencer public key and the asset ids, and record that path as the custody path."
ac_3  = "WHEN the kernel app's machine runs THE init SHALL run every container command of the node pod under its uid and restart one that exits, THE supervisor socket SHALL report ready, the LNI socket SHALL exist, the authority replica SHALL answer its head on loopback and every process SHALL run under the clock authority."
ac_4  = "WHEN one SEND activity is submitted with layerxctl over the LNI THE replica SHALL show the batch that carries it and THE anchor precompile SHALL show a checkpoint at or after that batch as submitted or final."
ac_5  = "WHEN the relay archive app runs its machines in both regions, each with its own volume syncing from the origin in the kernel machine, THE volume of every machine SHALL hold the kernel's genesis, snapshot and every batch up to the head verified under the sequencer public key, as the relay subcommand of task 4.6 proves on each machine with /v1/sync/head within one batch of the origin and genesis_sha256 equal to the kernel's, so the kernel's history survives the loss of its one Fly volume."

[req.7]
title = "Trusted boundaries in the kernel app"
story = "As the router and the human graph, I reach the core boundary, the receipt authority, the agent boundary and two Paxeer boundaries over TLS in the kernel app."
ac_1  = "WHEN the core boundary, receipt authority and agent boundary run in the kernel machine THE three SHALL answer their readiness routes over TLS under the internal CA at the kernel app's .internal name with their pod env names, the receipt authority bound to the replica on loopback and the identity binding socket, the agent boundary bound to the LNI socket, and no public service of the app SHALL reach them."
ac_2  = "WHEN the two Paxeer boundaries run in the kernel machine THE two SHALL relay to two different serving RPC names that follow the head, each through its own loopback hop with LAYERX_PAXEER_CHAIN_ID 125, the pod's paxeer relay SHALL dial the first, and a reader requiring agreement of two SHALL have two sources."

[req.8]
title = "Gateway at the router URL"
story = "As any client, https://api.mainnet-beta.router.paxeer.network answers eth_, lx_ and px_ methods from one endpoint with the kernel available."
ac_1  = "WHEN the existing endpoint app runs the gateway THE gateway SHALL be in kernel mode with core_agent_boundary and independent_receipt_authority at the kernel app's .internal name over mTLS, its Redis the existing Redis app, its Paxeer RPC at least two serving RPC names tried in order, on at least two machines in two regions, and its readiness SHALL report every configured backend up."
ac_2  = "WHEN tools/bringup/check-live.sh router runs THE probe SHALL see eth_chainId 0x7d, px_getNetwork with kernel.available true and lx_getAccount answering a read for a bound account, all through the router URL."
ac_3  = "WHEN the router passes its probe THE wallet gateway's RPC_URLS SHALL name the router URL first followed by serving RPC names, the wallet PWA SHALL name the router URL as its RPC endpoint and the wallet gateway's readiness SHALL report its rpc pool up."
ac_4  = "WHEN LAYERX_GATEWAY_PAXEER_RPC_URLS names two to eight https URLs and the first fails at transport or answers other than 200 THE gateway SHALL answer from the next, and its Paxeer status SHALL report up while any one answers."

[req.9]
title = "Identity, internal services and program registry on Fly"
story = "As the developer plane, I dial the identity service and the internal kms with its four event sources on the private network and the program registry at its name."
ac_1  = "WHEN the identity app runs on one machine with a volume THE service SHALL answer readiness over TLS under the internal CA at its app's .internal name with its pod env names and its key material generated inside the machine, and the app SHALL hold no public IP."
ac_2  = "WHEN the internal kms and the journeys, payments, approvals and programs event sources run as one Fly app with one process group each, every group one machine with its own volume, beside the internal Redis app THE five SHALL answer readiness over mandatory mTLS under the internal CA at their <group>.process.<app>.internal names on the private network only."
ac_3  = "WHEN the program registry app and its builder rootfs run on one machine with a volume THE registry SHALL answer /healthz over mTLS at registry.paxeer.network through its TCP passthrough, the builder environment directory SHALL exist from builder-environment/build-env.sh, one reference program deploy SHALL return a sequencer-signed receipt with result code 0, and the router SHALL name the registry app's .internal name as program_registry and report it up in its readiness."

[req.10]
title = "Human graph in the kernel app for the wallet identity"
story = "As a wallet user signed in with the Supabase identity, the human service admits my assertion, resolves my principal and signs through the five attestors."
ac_1  = "WHEN the identity provider receives LXIP operation 4 with an assertion THE provider SHALL verify it against the configured JWKS and return the principal and did:layerx identity, and THE provider's serve command SHALL wire the assertion configuration at startup."
ac_2  = "WHEN a wallet-facing operation arrives with an Authorization bearer from a listed origin THE human service SHALL admit the assertion through operation 4, keep the passkey cookie path unchanged, and pass the same assertion to admit_assertion for attestor signing."
ac_3  = "WHEN LAYERX_HUMAN_ATTESTOR_NODES is set THE components loader SHALL accept an absent LAYERX_HUMAN_KMS group, use the five attestors at protocol 3 with threshold three, and refuse to start only when neither custody backend is complete."
ac_4  = "WHEN the identity, security, movement, components, service and onboarding processes run in the kernel machine under their uids THE service SHALL answer /livez and /readyz ready at human.paxeer.network through the Fly edge, admitting https://paxportwallet.com as its web origin and its passkey relying party id paxportwallet.com, and a second service process SHALL serve the event sources over TLS under the internal CA on the private network."
ac_5  = "WHEN every HTTP route the wallet SDK calls is compared with the routes the human service serves THE service SHALL serve each one with the schema the SDK expects."
ac_6  = "WHEN the wallet PWA on Railway carries NEXT_PUBLIC_PAXEER_HUMAN_API=https://human.paxeer.network THE check-live human-session gate of the wallet feature SHALL pass against that name."

[req.11]
title = "Agent daemon and MCP live"
story = "As a model client, I open an MCP session whose every call goes through a live agentd in the kernel app."
ac_1  = "WHEN agentd runs in full mode in the kernel machine as one daemon THE daemon SHALL serve its human-owner listener, its program listener and its MCP binding, SHALL answer /healthz ready with the program bearer after its LNI handshake and authority read, and THE agentd boundary SHALL publish the program listener over mTLS at agent.paxeer.network port 9454 through a TCP passthrough."
ac_2  = "WHEN tools/bringup/mcp-enrol.sh runs inside the kernel machine THE script SHALL enrol one session and capability through the full-mode daemon and write the binding document with two owner-only secret files under the daemon's MCP binding root on the volume, and THE layerx-mcp process SHALL serve the peer-admitted socket."
ac_3  = "WHEN an admitted client runs layerx mcp serve with the binding THE tools/list answer SHALL contain the read tools and the web tools."
ac_4  = "WHEN an SDK posts the agent-plane envelope of an operation of the operation catalogue to the daemon's program listener THE daemon SHALL authorize it under tenant control for that operation and surface, run it through the same handler its read or program route runs, and answer the request_id, value and verification_status envelope the router's agent routes answer; the JVM SDK SHALL name that listener at agent.paxeer.network as its agent endpoint."

[req.12]
title = "Wallet move completed"
story = "As the owner, the production wallets are migrated with the ceremony tool and the wallet endpoint serves the new gateway."
ac_1  = "WHEN steps 1 to 9 of human/wallet/docs/cutover.md have run, the public wallet endpoint name is served by the wallet gateway app under its Fly certificate in place of step 10's endpoint proxy, and steps 11 to 13 have made the old database role read-only, sealed the old master key and retired the old wallet service THE wallet endpoint SHALL answer through the new gateway with the x-served-by header and readiness true, as tools/wallet/check-live.sh cutover checks."

[req.13]
title = "Paid web search on the RPC nodes and attestation from the Fly attestor apps"
story = "As an agent, I pay 402LXP for a search on any serving RPC name and the sidecar settles through the router; as the network, the four attestor apps fulfil fetch requests on chain."
ac_1  = "WHEN the serving sidecar config is rendered on the host of a serving RPC name THE sidecar SHALL listen on loopback only with gateway.endpoint the router URL's /rpc, the kernel's sequencer id and public key, the kernel-registered asset ids and a receiver key generated on that host, and THE host's apiN vhost SHALL route /search, /fetch, /content/ and /xweb/health to it."
ac_2  = "WHEN one /search is paid with a PAYMENT-SIGNATURE THE sidecar SHALL answer 200 on a serving RPC name, the redundant path a client uses directly, and through search.paxeer.network, whose search front keeps the 402 answer and the paid retry on one node."
ac_3  = "WHEN the four attestor configs are rendered for the four private Fly attestor apps with the router, the real sequencer, the kernel block and their peers reached through loopback hops, the attestor receiver DIDs are registered and funded on the kernel, the submitters are funded and one fetch request is sent to the xweb precompile THE loop SHALL end in XWebFulfilled, and no validator host SHALL run an x-websearch process or listen on the attestor ports."

[req.14]
title = "Explorer fork in production over the archive host"
story = "As a user, paxscan.io shows the whole chain history and the kernel entities."
ac_1  = "WHEN the archive host's node runs with min-retain-blocks 0 THE node SHALL answer eth_getBlockByNumber for a block below the first pruned height of the public nodes and follow the head."
ac_2  = "WHEN the deployed explorer backend reads the archive host's public RPC name as its HTTP, WebSocket, trace and eth_call endpoint and the frontend names it as its network RPC URL THE frontend SHALL answer 200 at paxscan.io and the backend's /api/health and /api/v2/stats SHALL answer 200."
ac_3  = "WHEN the history copy job has run from the legacy source and, above its ceiling, from the read-only copy source up to the archive node's first retained block, and FIRST_BLOCK and TRACE_FIRST_BLOCK sit at that block THE block count from the first copied block SHALL match the sources and the backend's missing block ranges SHALL lie only inside the ranges recorded as lost in the source."

[req.15]
title = "Developer plane"
story = "As a developer, I register webhooks and read my dashboard at their names."
ac_1  = "WHEN the webhooks, dashboard API and dashboard web apps run on Fly on at least two machines in two regions each THE three SHALL answer readiness at webhooks.paxeer.network, api.developers.paxeer.network and developers.paxeer.network through the Fly edge, dialing identity, the internal event sources, the internal Redis and the router's Redis over the private network, and the event producers of the router, the registry and the human service SHALL deliver to the webhooks ingress."

[req.16]
title = "Relay archive, interop gateway, mirrors and ramp"
story = "As an independent reader, a payments integrator, a verifier and a market maker, I reach each surface as far as its real inputs allow."
ac_1  = "WHEN the relay archive app runs on several machines in two regions, each with its own volume, with the kernel's pins and the origin in the kernel machine THE service SHALL answer /readyz and /v1/sync/head at archive.paxeer.network and forward one signed activity to the router with the router's verdict."
ac_2  = "WHEN the interop gateway app runs on several machines with a config rendered by render.py --check THE service SHALL answer /readyz at interop.paxeer.network and complete one x402 exact-scheme exchange."
ac_3  = "WHEN the AP2 keys, Visa TAP identities and fiat provider credentials are supplied THE rendered config SHALL enable those adapters and their conformance legs SHALL pass against the deployed host."
ac_4  = "WHEN the mirror chain inputs are supplied THE archive contract and program SHALL be deployed, the signer and publisher SHALL run in the kernel machine, and layerx-mirror-verify SHALL verify one receipt from the mirror alone."
ac_5  = "WHEN the ramp's provider, compliance, KMS and custody-owner coordinates are supplied THE reference ramp app SHALL answer /readyz at ramp.paxeer.network and the sandbox journey SHALL record done."

[req.17]
title = "Gas station and bridge relayer"
story = "As a holder of SID, I pay gas in SID; as a bridge user, my deposit on a foreign chain is credited on Paxeer X."
ac_1  = "WHEN the gas station app runs on one machine with the sponsor account THE station SHALL answer POST /quote at gas.paxeer.network and complete one sponsored batch through /submit at the owner-set rate."
ac_2  = "WHEN the bridge inputs are supplied THE vaults and program SHALL be deployed, the governance proposals SHALL open each chain, the checklist SHALL read every chain back, and the relayer app with its remote signer in the same machine SHALL journal one observed deposit as bridgeIn."

[req.18]
title = "CI runners, hpx registry and the public RPC fleet"
story = "As the project, CI runs on Fly, new nodes install from the registry, and all sixteen public RPC nodes follow the head."
ac_1  = "WHEN the controller's GitHub token is supplied THE runner image and controller SHALL be deployed, CI_LINUX_RUNNER SHALL be fly-linux and the canary SHALL run on a fly- runner."
ac_2  = "WHEN publish.sh and hosting/deploy.sh have run on the serving host THE registry SHALL answer /healthz at node.hyperpaxeer.com with the chain id and the source revision, and a clean install SHALL state-sync."
ac_3  = "WHEN tools/bringup/check-live.sh rpc-nodes runs THE sixteen public RPC names SHALL each answer eth_blockNumber within ten blocks of the highest answer and none SHALL be frozen or crash-looping."
ac_4  = "WHEN the hpx registry runs as a Fly app on one machine with its artifacts and node directory on one volume THE registry SHALL answer /healthz, the landing page and the checksummed release artifacts at node.hyperpaxeer.com under a Fly certificate, take the client address for its rate limit and node directory from Fly-Client-IP, and the hpx host SHALL no longer serve the name."

[req.19]
title = "Plain listeners behind the Fly edge"
story = "As an operator, every TLS-only service that serves a public name from Fly can run a plain listener behind the Fly certificate, as the gateway and the human service already do."
ac_1  = "WHEN LAYERX_DASHBOARD_LISTENER, LAYERX_WEBHOOKS_LISTENER or LAYERX_INTEROP_LISTENER is plain, or the reference ramp's or the relay archive's config sets its listener to plain, THE service SHALL serve plain HTTP on its listen address and refuse to start when its TLS certificate or key is also set, as listener_config of platform/hosted/gateway does."
ac_2  = "WHEN the listener is unset or tls THE service SHALL keep today's TLS listener unchanged."
ac_3  = "WHEN make platform-test-plain-listeners runs THE tests SHALL prove both modes and the refusal for each of the five services through their real listeners."

[req.20]
title = "Indexer behind the router's history methods"
story = "As a wallet or explorer client, lx_getHistory, px_getHistory and px_getUnifiedHistory at the router URL answer from a live indexer."
ac_1  = "WHEN the indexer app runs on one Fly machine with its SQLite database on a volume, its TLS listener under the internal CA at its app's .internal name on [::] and no public IP THE indexer SHALL read EVM and CometBFT data from the archive node's public RPC name, hold the history from the archive node's first retained block up to its cutover height through a backfill from the explorer database verified block by block against the archive node, follow live from the cutover and read the relay archive; history below the archive node's first retained block stays served by the explorer database copy of task 4.4."
ac_2  = "WHEN LAYERX_GATEWAY_INDEXER_URL names the indexer's .internal name on the router THE router's history methods SHALL answer from the indexer, as tools/bringup/check-live.sh indexer checks through the router URL."

[tasks]
heading = "Implementation Plan: paxeer-x-bringup"

[task.0]
section = "Wave 0 - Tooling, search front and docs"
title   = "Retarget the tooling to Fly apps, front search from Fly, close the validator attestor ports, fix the docs and deliver the probe"
status  = "pending"

[task.0.1]
title      = "Deliver the operator host-map contract and the bring-up live probe"
status     = "done"
wave       = 0
requires   = []
do_1       = "Write tools/bringup/check-live.sh after tools/wallet/check-live.sh: a usage block, one function per subcommand of [design.probe], pass and fail lines with the observed value, CHECK_LIVE_TIMEOUT, exit 0 only when every check passes and 2 on usage; every subcommand of a later task is added by that task."
do_2       = "Source BRINGUP_HOSTS_FILE in a load_hosts function that exits 2 naming the first missing role of EDGE_HOST, KERNEL_HOST, PLATFORM_HOST, EXPLORER_HOST, ARCHIVE_HOST, VALIDATOR_HOSTS, RPC_HOSTS and HPX_HOST, and never echoes a value; implement the hosts subcommand as one ssh true per role."
do_3       = "Write tools/bringup/check-live.test.sh after tools/wallet/check-live.test.sh proving the usage exit, a passing subcommand and a failing subcommand against local fixtures with no network."
verify_cmd = "timeout 10m tools/bringup/check-live.test.sh"
symbols    = ["load_hosts", "check_hosts", "usage"]
touches    = ["tools/bringup/check-live.sh", "tools/bringup/check-live.test.sh"]
tests      = ["tools/bringup/check-live.test.sh"]
reqs       = ["4.1", "4.2", "4.3"]

[task.0.2]
title      = "Create the internal CA on the edge host and issue per-service certificates on their hosts"
status     = "implemented"
wave       = 0
requires   = ["0.1"]
do_1       = "Write tools/bringup/ca.sh with init (CA key and certificate under /etc/layerx/ca on the edge host, 0600, printing only the fingerprint) and issue <service> <role> (the target host generates key and CSR under /etc/layerx/<service>/tls, the edge signs with the SAN list the pod definition declares plus localhost and the loopback address for loopback-reached services, the certificate is copied back; the key never leaves the host)."
do_2       = "Take the SAN list per service from platform/hosted/tests/beta-cluster.sh issue_cert calls so the receipt authority, core, agent boundary, identity, internal, registry, gateway, human and interop certificates match what their clients verify."
do_3       = "Add the ca subcommand to tools/bringup/check-live.sh: every issued certificate chains to the CA, carries its SANs and expires in more than thirty days."
verify_cmd = "timeout 10m tools/bringup/check-live.sh ca"
symbols    = ["ca_init", "ca_issue", "check_ca"]
touches    = ["tools/bringup/ca.sh", "tools/bringup/check-live.sh"]
tests      = ["tools/bringup/check-live.test.sh"]
reqs       = ["2.1", "2.2", "2.3"]

[task.0.3]
title      = "Serve search.paxeer.network from a Fly nginx app that keeps each client on one serving RPC node"
status     = "pending"
wave       = 0
requires   = ["0.5"]
blocked_on = "The owner's explicit DNS record search.paxeer.network CNAME to the fly.dev name of the app of interop/deploy/search-front/fly.toml, which wins over the *.paxeer.network wildcard."
do_1       = "Write docker/search-front/Dockerfile and Dockerfile.dockerignore on the nginx stable image with interop/deploy/search-front/nginx.conf: listen [::]:8080 plain; a split_clients map on $http_fly_client_ip over an upstream name list that nginx includes from a file mounted as a Fly [[files]] secret, so every machine picks the same serving node for one client; proxy_pass over HTTPS to the chosen name with proxy_set_header Host $proxy_host so the apiN vhost matches, proxy_ssl_server_name on, proxy_ssl_verify on against the image's system roots and resolver [fdaa::3] valid=30s for dynamic upstream resolution; the other request and response headers passed through unchanged plus add_header X-Search-Node $xweb_node always, naming the chosen serving name, so the header also rides 4xx and 5xx answers; /healthz answered locally; 502 while no node serves search."
do_2       = "Write interop/deploy/search-front/fly.toml, an http_service on internal port 8080 with a /healthz check, the upstream list mounted through [[files]] with a secret_name, at least two machines in two regions and no volume; write tools/bringup/search-front.sh that renders the upstream list from the host map, each RPC_HOSTS destination not in VALIDATOR_HOSTS mapped to its apiN name through rpc_unit of tools/bringup/check-live.sh, imports it through flyctl secrets import on standard input, deploys the app, scales it to two regions and runs flyctl certs add search.paxeer.network."
do_3       = "Add the search-front subcommand: search.paxeer.network answers /healthz over TLS with a valid certificate for the name, the app runs at least two started machines in two regions, the rendered upstream list equals the serving RPC names and names no validator host's apiN name, and two requests from one client address report the same X-Search-Node."
verify_cmd = "timeout 10m tools/bringup/check-live.sh search-front"
symbols    = ["search_front", "check_search_front"]
touches    = ["docker/search-front/Dockerfile", "docker/search-front/Dockerfile.dockerignore", "interop/deploy/search-front/nginx.conf", "interop/deploy/search-front/fly.toml", "tools/bringup/search-front.sh", "tools/bringup/check-live.sh"]
tests      = ["tools/bringup/check-live.test.sh"]
reqs       = ["1.1", "1.3"]

[task.0.4]
title      = "Replace api.paxeer.network by the router URL and every layerx.example host by its public name"
status     = "done"
wave       = 0
requires   = []
do_1       = "Rewrite every occurrence of api.paxeer.network outside spec/ to https://api.mainnet-beta.router.paxeer.network in docs/site, docs/wiki, platform/docs, platform/hosted (gateway README, deployment, testnet lib, topology regressions, beta-cluster.sh), platform/relay_archive, platform/examples, platform/sdk/jvm and .github/workflows/platform.yml."
do_2       = "Replace developers.layerx.example, relay.layerx.example and every other layerx.example host in manifests, examples and docs by the names of [decision.public_names]; keep the sixteen RPC names and public-rpc.md unchanged except linking the router URL as the unified interface."
do_3       = "Update docs/site/docs/overview/unified-network.md's single endpoint section and the hosted-gateway pages so the router URL is the only unified endpoint and paxscan.io and paxportwallet.com are the explorer and wallet names."
verify_cmd = "timeout 5m sh -c '! git grep -nE -e \"api\\.paxeer\\.network\" -e \"(^|[^a-z0-9.])[a-z0-9-]+\\.layerx\\.example\" -- . \":(exclude)spec/**\"'"
symbols    = []
touches    = ["docs/site/docs/overview/unified-network.md", "docs/site/docs/reference/public-rpc.md", "docs/site/docs/platform/hosted-gateway.md", "docs/wiki/HostedGateway.md", "platform/hosted/gateway/README.md", "platform/hosted/gateway/deployment.yaml", "platform/docs/content/beta.md", "platform/relay_archive/README.md", "platform/relay_archive/config.example.json", "platform/examples", "platform/hosted/dashboard", "platform/hosted/webhooks"]
tests      = []
reqs       = ["3.1", "3.2", "3.3"]
revision   = "558221843356a5683f6bfd20a27e31630261ea48"
command    = "timeout 5m sh -c '! git grep -nE -e \"api\\.paxeer\\.network\" -e \"(^|[^a-z0-9.])[a-z0-9-]+\\.layerx\\.example\" -- . \":(exclude)spec/**\"'"
exit_code  = 0
log_path   = ".logs/verify.log"

[task.0.5]
title      = "Retarget the host map, the CA service list and the fleet script from host roles to Fly apps"
status     = "pending"
wave       = 0
requires   = ["0.1"]
do_1       = "In tools/bringup/check-live.sh make the roles EDGE_HOST, ARCHIVE_HOST, VALIDATOR_HOSTS, RPC_HOSTS, HPX_HOST and OLD_WALLET_HOST, update the usage text and the hosts subcommand, and add the helpers every Fly check uses: the app name read from the app line of a toml and a command run inside the app's machine through flyctl ssh console, bounded by CHECK_LIVE_TIMEOUT; these six roles replace the eight roles that task 0.1 introduced; move the fixtures of tools/bringup/check-live.test.sh and tools/bringup/sync-fleet.test.sh to the six roles and make check-live.test.sh run sync-fleet.test.sh as its last case, so the one verify_cmd covers both."
do_2       = "In tools/bringup/ca.sh make every row of ca_services that named the kernel or platform host name the toml of the Fly app that runs the service and add that app's .internal name to its SANs, the five internal rows <group>.process.<app>.internal of their process group; add an internal-redis row after the internal-redis issue_cert of platform/hosted/tests/beta-cluster.sh carrying the internal Redis app's .internal name; keep a public name only in the agentd and registry rows, dropping the router URL, human.paxeer.network and identity.paxeer.network from the rows that carry them; turn the relay-archive row into the certificate of the relay archive origin in the kernel app; turn the developer row into the webhooks ingress certificate for ingress.process.<app>.internal of the webhooks app; keep every client row; delete the server rows gateway, interop-gateway, ramp and gas-station, whose services serve only a plain listener behind the Fly edge, and the x-websearch row, whose binary serves no TLS, with their fixtures in check-live.test.sh."
do_3       = "Make ca_issue issue for a Fly app: a single-machine app generates its key and signing request on its volume, ca_issue fetches the request through flyctl ssh console, signs it on the edge host and writes the certificate back to the volume the same way; for an app with several machines the key and request are generated in a tmpfs directory on the edge host, which is the operator host holding the Fly login, piped into flyctl secrets import on standard input, and the directory is removed; make check_ca read a Fly app's certificates the same way; nothing is printed but fingerprints."
verify_cmd = "timeout 10m tools/bringup/check-live.test.sh"
symbols    = ["load_hosts", "check_hosts", "ca_services", "ca_issue", "check_ca"]
touches    = ["tools/bringup/check-live.sh", "tools/bringup/check-live.test.sh", "tools/bringup/ca.sh", "tools/bringup/sync-fleet.test.sh"]
tests      = ["tools/bringup/check-live.test.sh", "tools/bringup/sync-fleet.test.sh"]
reqs       = ["4.1", "4.3", "4.4", "2.4"]

[task.0.6]
title      = "Close the x-websearch attestor ports of the validator hosts to everything but loopback and the peer host"
status     = "pending"
wave       = 0
requires   = ["0.5"]
do_1       = "Write tools/bringup/validator-firewall.sh that adopts on each of VALIDATOR_HOSTS the table inet xweb that /etc/xweb-firewall.nft and xweb-firewall.service already install and persist: when the loaded rules accept tcp 8480 and 8481 only from loopback and from the other validator host and reject them with tcp reset from every other source, so a probe sees a refusal rather than a timeout, it changes nothing; otherwise it rewrites /etc/xweb-firewall.nft to exactly those rules, leaving every validator and chain port as it is, and restarts xweb-firewall.service; it is idempotent and prints one line per host with the rule state and never an address."
do_2       = "Add the validators subcommand: from the operator host 8480 and 8481 are refused on every validator host, over ssh each attestor answers /health on loopback, and each validator host still reaches its peer's attestor ports."
verify_cmd = "timeout 10m tools/bringup/check-live.sh validators"
symbols    = ["check_validators"]
touches    = ["tools/bringup/validator-firewall.sh", "tools/bringup/check-live.sh"]
tests      = ["tools/bringup/check-live.test.sh"]
reqs       = ["1.2"]

[task.0.7]
title      = "Rewrite the user-facing pages so no retired or unserved name is promised and accounts are funded through custody credit"
status     = "pending"
wave       = 0
requires   = ["0.4"]
