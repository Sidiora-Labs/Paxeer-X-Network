touches    = ["human/wallet/deploy/endpoint.toml", "human/wallet/deploy/env", "tools/bringup/check-live.sh"]
tests      = ["tools/bringup/check-live.test.sh"]
reqs       = ["8.1", "8.2", "8.3"]

