# Monorepo layout: target tree core, sdk, services, apps, tests; phase A runs now, phase B is held until release v6.12.0 is applied on mainnet.

[meta]
name = "Monorepo layout: core, sdk, services, apps, tests"
slug = "monorepo-layout"
version = "1.0.2"
status = "draft"
goal = "Every top-level directory of the repository sits under core, sdk, services, apps, tests, scripts or the group that stays at the root (contracts, docs, deploy, docker, tools, spec, api), the upstream Paxeer-Network repositories the node builds from live in the tree as pinned directory snapshots, and the build, CI, deploy and spec references follow every move in the same commit."
scope = "Phase A: eleven upstream directory imports, the tests consolidation, the off-chain moves to apps, services, sdk, contracts and tools, and the phase A docs refresh. Phase B: the kernel C tree and every root Go package to core, the Cosmos SDK fork to core/cosmos-sdk, programs, the go.mod directory replace wiring of the vendored Go deps and the sdk/js wiring of the integration tests."
revision = "39dd0991d"
phase_a = "Waves 0 to 7, tasks 0.1 to 7.1; runs now."
phase_b = "Waves 8 to 11, tasks 8.1 to 11.3; held. Phase B: runs only after release v6.12.0 is applied on mainnet, because every core move rewrites the import paths, build paths and chain-spec paths the release is built and qualified from."
completion = "Every task verify_cmd passes at one revision; the wave check tasks 3.6, 4.7, 5.5, 6.7 and 9.12 and the docs tasks 7.1 and 11.3 pass on their merged wave revisions; every acceptance criterion of req.1 to req.11 holds on the final revision."

[design]
layout = "apps: user-facing frontends (perps, wallet, web, explorer, launchpad). services: off-chain programs (agent, interop, platform, human, wallet, explorer, launchpad, bridge). sdk: client and guest SDKs (platform, integrations, wallet, chainflow, launchpad, programs, js). core: the chain (kernel, every root Go package, cosmos-sdk, programs, deps). tests: every test tree (fuzz, integration, fixtures/example, occ, testutil and the existing kernel, Python, Solidity and vector suites). tools: developer and operator tools (hpx, platform cli, emulator and release, launchpad tools, loadtest, paxctl, uci, wasm-tools). contracts: on-chain sources (the root Foundry tree, bridge, launchpad)."
stays = "api (buf module buf.build/pax-protocol/pax-chain), contracts, docs, deploy, docker, scripts, spec, tools, and the root build and community files: Makefile, chain.mk, go.mod, go.sum, buf.yaml, buf.gen.yaml, buf.lock, foundry.toml, foundry.paxeer.toml, rust-toolchain.toml, package.json, package-lock.json, README.md, LICENSE, NOTICE, CONTRIBUTING.md, SECURITY.md, SUPPORT.md, CHANGELOG.md, CODE_OF_CONDUCT.md, CONTRIBUTORS.md, GOVERNANCE.md, CITATION.cff, RELEASE.md, GOTCHA.kvx, CODEMAP.md, AGENTS.md, CLAUDE.md, codify.kvx and the dot-directories and dot-files of tool configuration."
vendoring = "Each imported repository is a plain directory snapshot without .git at its final home, with a VENDOR.kvx pin record (url, ref, full sha), and, when upstream tracks no go.mod at the tree root, one boundary go.mod holding exactly a module line and a go line, and a nested .gitignore whose appended negations re-include every upstream file the root ignore patterns hide; scripts/ci/vendor-verify.sh proves the tree equals a fresh fetch of the pinned sha. Phase A changes no consumer; phase B wires go.mod and the integration tests to the directories."
sdk_overlap = "During phase A sdk/ holds the Cosmos SDK fork beside the new SDK directories; no fork entry shares a name with them, and task 9.1 moves the fork entries by name to core/cosmos-sdk."
go_module = "go.mod stays at the root and the module path github.com/Sidiora-Labs/Paxeer-X-Network does not change; every moved root-module package changes its import path, which is rewritten mechanically in the same commit. Nested modules keep their module paths."
references = "scripts/ci/layout-check.sh is the dangling-reference gate: it fails while any tracked file sits under an old path or any build, CI, deploy or tool configuration file names an old root-anchored path."

[execution]
planning_state = "Task completion requires the declared implementation and its verify_cmd evidence at one revision. A specification or task status alone establishes no runtime result."
task_policy = "Read the exact declared paths, move with git mv, rewrite every reference in the same commit, then run one bounded qualification pass. Implementation and qualification evidence are recorded separately."
gate_policy = "A verify_cmd names a target that exists at the revision or is listed in planned_paths with gate_kind planned. Every verify_cmd runs from the repository root."
candidate_policy = "Aggregate, sanitizer and full CI matrices run once per wave on the merged wave revision through the wave check task, not per task."
parallelism = "The eleven import tasks of wave 1 touch disjoint directories and run in parallel. Every move task edits Makefile, .github, docker or the active spec files, so the move tasks of a wave run one after another in requires order."
phase_policy = "Task status uses the workflow set pending, in_progress, done. Phase B tasks carry phase = B and a hold reason and stay pending until release v6.12.0 is applied on mainnet; no phase B task is claimed before then."
privacy = "Credentials, key material, operational inventories, host names and raw execution logs stay in access-controlled storage. Everything in this feature directory is public and is reviewed before publication."
path_policy = "Every move uses git mv so history follows the files; every reference to a moved path in the repository is rewritten in the same commit; open tasks of the active specs are rewritten in the same commit and done tasks keep their historical paths."
requirement_ids = "req.1 to req.11 are the requirements of this feature; a task reqs entry <n>.<a> names acceptance criterion a of req.<n>."

[req.1]
title = "Every top-level entry has its target home"
ac_1 = "After phase B the tracked top-level directories are exactly apps, core, sdk, services, tests, scripts, tools, contracts, docs, deploy, docker, spec, api and the dot-directories of tool configuration, beside the root build and community files listed in [design] stays."
ac_2 = "Phase A tests consolidation: fuzz -> tests/fuzz, integration_test -> tests/integration, example -> tests/fixtures/example, occ_tests -> tests/occ, testutil -> tests/testutil; the existing tests tree, tests/solidity and tests/vectors stay where foundry.toml reads them."
ac_3 = "Phase A services: agent -> services/agent whole with its shared Rust crates and its sdk; interop -> services/interop; platform/cli, platform/emulator and platform/release -> tools/platform; platform/sdk -> sdk/platform; platform/integrations -> sdk/integrations; the rest of platform -> services/platform; the human Rust workspace -> services/human; human/wallet -> services/wallet; human/wallet/sdk -> sdk/wallet; human/apps/{perps,wallet,web} -> apps/{perps,wallet,web}."
ac_4 = "Phase A other trees: chainflow -> sdk/chainflow; hpx -> tools/hpx; explorer/frontend -> apps/explorer and the rest of explorer -> services/explorer; bridge/evm, bridge/solana, bridge/vectors and the bridge docs -> contracts/bridge and bridge/deploy -> services/bridge/deploy."
ac_5 = "Phase A launchpad flatten: launchpad/client/apps/{web,mobile} -> apps/launchpad/{web,mobile} with the client workspace files at apps/launchpad; launchpad/client/packages/* -> sdk/launchpad/packages/*; launchpad/protocol and launchpad/shared -> sdk/launchpad; launchpad/core/* and launchpad/media/* -> services/launchpad/<name>; launchpad/security, go.work, Makefile and licenses -> services/launchpad; launchpad/deploy -> deploy/launchpad; launchpad/tools -> tools/launchpad; launchpad/contracts -> contracts/launchpad."
ac_6 = "Phase B core: src, include, cmd and migrations -> core/kernel/{src,include,cmd,migrations}; sdk -> core/cosmos-sdk; consensus, interchain, wasm, wasm-runtime, storage, modules, precompiles, node, rpc, engine, daemon, admin, custodyproof, layerxproof and utils -> core/<name>; programs/sdk -> sdk/programs; the rest of programs -> core/programs."
ac_7 = "api stays at the root; docs/MONOREPO.md describes the tree of the current phase."

[req.2]
title = "Every wave ends with a green build"
ac_1 = "Every task that touches the root Go module ends with go build ./... and go vet of the touched packages passing."
ac_2 = "Every moved tree with make targets passes them after its move: fuzz-codec-smoke, agent-build, interop-build, platform-build, human-build, bridge-test-evm, hpx-public-check, programs-build, test-kernel, test-layerxctl, test-lxphost and make -f chain.mk build."
ac_3 = "Every moved TypeScript app or package passes its typecheck (pnpm -C <dir> typecheck, or -r for workspaces) and npm ls --workspaces passes for the root npm workspace."
ac_4 = "Every moved Rust workspace passes cargo check or cargo metadata with --locked, and no resolved crate version changes; only path entries of Cargo.toml and Cargo.lock change."
ac_5 = "Every moved contract tree passes forge build (or the hardhat compile of its own toolchain), and the root forge build skips contracts/bridge and contracts/launchpad."
ac_6 = "The wave check task runs the wave gate once on the merged wave revision."

[req.3]
title = "References follow every move in the same commit"
ac_1 = "Every moved path is rewritten in Makefile, chain.mk, the included .mk files, .github (workflows, labeler, codecov, dependabot, codeql config and the review assignment file), Dockerfiles and compose files under docker and deploy, buf.yaml and buf.gen.yaml."
ac_2 = "Every moved path is rewritten in Fly tomls, Railway json files, vercel.json and nixpacks.toml, package.json workspaces and lockfiles, pnpm workspace files, Cargo path dependencies, nested go.mod replace directives and go.work use lines."
ac_3 = "Every moved path is rewritten in codify.kvx, .gitignore, .cgignore, .gitattributes, .pre-commit-config.yaml, spec/specgen and scripts/specgen.sh, the scripts and tools trees, and the required-file list and secret-scan allowlist of scripts/ci/public-repo-audit.sh, which passes after every task that touches it."
ac_4 = "docs/MONOREPO.md, README.md, the seven translations under docs/readme, docs/site/docs/overview and the in-tree READMEs of moved trees name only current paths after the docs task of each phase."
ac_5 = "Every move is a git mv so git log --follow traces each moved file."

[req.4]
title = "No dangling path references"
ac_1 = "scripts/ci/layout-check.sh exits 0 for every old path a wave moved: no tracked file remains under the old path and no build, CI, deploy or tool configuration file names it as a root-anchored path."
ac_2 = "One check task per wave (3.6, 4.7, 5.5, 6.7, 9.12) and each docs task (7.1, 11.3) runs layout-check.sh over every path moved so far."

[req.5]
title = "Active spec paths follow every move"
ac_1 = "In the same commit as each move, the open tasks of spec/layerx-merge/spec.kvx and spec/release-v6-12-0/spec.kvx name only post-move paths in touches, do_n, build_cmd, verify_cmd and planned_paths, and their [req.*], [acceptance.*], [capability.*], [decision.*] and [resolution.*] text names only post-move paths."
ac_2 = "Each commit that rewrites an active spec raises the minor version in that spec's [meta]."
ac_3 = "Done tasks and their evidence keep their historical paths."

[req.6]
title = "Upstream repositories are vendored as pinned snapshots"
ac_1 = "The eleven trees sit at their final homes: pax-geth -> core/deps/geth (v1.15.7-pax.17, d9111440), pax-tm-db -> core/deps/tm-db (v0.0.5-pax.1, beba0f87), pax-db-backend -> core/deps/db-backend (v0.0.4-pax.1, 152aa183), paxlog -> core/deps/log (v0.0.3-pax.1, 5eeb5730), pax-utils -> core/deps/utils (v0.0.2-pax.1, 8cb50156), pax-load -> tools/loadtest (v0.0.1-pax.1, c3b0feb1), pax-js -> sdk/js (v1.0.6-pax.1, 5d299156), paxctl -> tools/paxctl, pax-uci -> tools/uci, pax-cosmwasm -> core/deps/cosmwasm and pax-wasm-tools -> tools/wasm-tools (the last four at the main head)."
ac_2 = "Each tree holds VENDOR.kvx with url (https://github.com/Paxeer-Network/<repo>), ref (tag or main) and the full 40-hex sha; a tag sha starts with the prefix listed in ac_1."
ac_3 = "scripts/ci/vendor-verify.sh <dir> exits 0: the tracked files of the tree equal a fresh fetch of the pinned sha byte for byte and mode for mode, with no .git, beside VENDOR.kvx and, when upstream tracks no go.mod at the tree root, one boundary go.mod holding exactly a module line and a go line, and the appended negations of the tree's .gitignore."
ac_4 = "Every upstream file is tracked: the nested .gitignore negates each root pattern (*.o, *.a, *.so, *.key, *.pem, .env, node_modules/, /target/ and the rest) that would hide one."
ac_5 = "The phase A imports change no go.mod, go.sum, package.json or lockfile outside the imported tree, and the root .gitignore no longer ignores the core directory while it still ignores a root core dump."
ac_6 = "Phase B wires the root module to core/deps/geth, core/deps/db-backend, core/deps/tm-db, core/deps/log, core/deps/utils and tools/loadtest with directory replace lines, and the integration rpc tests to the @pax-js/cosmos package in sdk/js."

[req.7]
title = "Generated files stay in step"
ac_1 = "spec/specgen leaves AGENTS.md and CLAUDE.md with no diff after every wave check and docs task."
ac_2 = "CODEMAP.md is regenerated with cg codemap in the docs task of each phase, and the vendored trees are excluded from the index through .cgignore."

[req.8]
title = "Settings held outside the repository change when the task lands"
ac_1 = "When task 6.1 lands, the Railway services built from explorer/deploy/railway/backend.railway.json and frontend.railway.json have their config-as-code path and root directory set to services/explorer/deploy/railway and the split trees."
ac_2 = "When task 5.1 lands, the Railway service of human/apps/wallet/railway.json (and its nixpacks.toml) points at apps/wallet, and the Vercel project of human/apps/perps/vercel.json has its root directory set to apps/perps."
ac_3 = "When tasks 4.2, 4.5 and 6.6 land, the Fly apps of platform/hosted/interop/fly.toml, platform/hosted/dashboard/web/fly.toml, platform/hosted/node/fly.toml and hpx/hosting/fly.toml are deployed from their new paths; tools/flyci stays."
ac_4 = "Each such change is made by the operator of that service in the landing window of the task, and the task's commit message names the setting that must change."

[req.9]
title = "Phase B waits for the release"
ac_1 = "Every phase B task (8.1 to 11.3) carries phase = B and its hold reason, stays pending until release v6.12.0 is applied on mainnet, and is never claimed before then."
ac_2 = "The core moves keep each buf module root whole: proto file paths inside a module root do not change, the go_package options are rewritten and every *.pb.go is regenerated with buf generate, and buf generate leaves no diff."
ac_3 = "The -X version ldflags of chain.mk and Makefile move with the sdk move in the same commit and ./build/paxd version prints the release version afterwards."
ac_4 = "The depth-relative cgo -I and -L flags of lxphost follow the kernel, modules and programs moves; BUILD_DIR=build stays at the root."

[req.10]
title = "Moved trees keep their own invariants"
ac_1 = "services/wallet/attestor and services/wallet/ceremony keep the replace => ../../.. directive at depth 3 to the root module."
ac_2 = "tools/hpx/registry keeps its module path and the hpx-registry-<sha> tag scheme; the registry workflow's working-directory and go-version-file follow the move."
ac_3 = "The launchpad Go modules keep their module paths; every replace directive and go.work use line points at the new relative paths and make -C services/launchpad build passes."
ac_4 = "sdk/chainflow/go and the other nested modules keep their module paths."
ac_5 = "Rust workspace members that leave their workspace root directory keep resolving the same crate versions as the workspace lock they left."

[req.11]
title = "Vendored trees pass the repository audit"
ac_1 = "scripts/ci/public-repo-audit.sh passes after the imports, with any allowlist entry naming one exact upstream test file, never a whole tree."

[task.0.1]
title = "Add the layout and vendor check scripts and fix the root ignore rules the new tree needs"
status = "done"
mode = "BUILD"
phase = "A"
wave = 0
requires = []
reqs = ["4.1", "6.3", "6.6", "11.1"]
do_1 = "Add scripts/ci/layout-check.sh taking old root-relative paths as arguments: exit 1 when git ls-files lists any file under an argument, or when git grep finds the argument followed by a slash and not preceded by a letter, digit, dot, dash, underscore or slash in a file whose paths resolve from the repository root: Makefile, chain.mk, the .mk files under tools, .github, docker, deploy, the shell and Python scripts under scripts, buf.yaml, buf.gen.yaml, codify.kvx, the root package.json, .gitignore, .cgignore, .gitattributes, .pre-commit-config.yaml, foundry.toml, foundry.paxeer.toml and go.mod; print every hit as path:line. Manifests that resolve paths from their own directory (nested Cargo.toml, package.json, go.mod, go.work, pnpm-workspace.yaml, fly.toml, railway.json) are proven by the build gates instead."
do_2 = "Add scripts/ci/vendor-verify.sh taking one directory: read url, ref and sha from <dir>/VENDOR.kvx, fetch that sha at depth 1 into a fresh temporary clone, and exit 1 unless the sha matches, every file tracked upstream is tracked under <dir> with identical bytes and mode, no other file is tracked under <dir> except VENDOR.kvx and, when upstream tracks no go.mod at the tree root, one boundary go.mod holding exactly a module line and a go line, and <dir>/.gitignore equals the upstream .gitignore (or is absent upstream) followed only by negation lines; print each difference."
do_3 = "In .gitignore replace the broken last line CONSTITUTION.md.pytest_cache/ with two lines /CONSTITUTION.md and /.pytest_cache/."
do_4 = "In .gitignore keep the root core-dump rules /core and /core.* but add !/core/ after them so the core/ directory is not ignored while a root core file still is."
do_5 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = []
touches = ["scripts/ci/layout-check.sh", "scripts/ci/vendor-verify.sh", ".gitignore"]
build_cmd = "bash -n scripts/ci/layout-check.sh && bash -n scripts/ci/vendor-verify.sh"
verify_cmd = "bash -n scripts/ci/layout-check.sh && bash -n scripts/ci/vendor-verify.sh && git check-ignore -q .pytest_cache/CACHEDIR.TAG && git check-ignore -q core.1 && ! git check-ignore -q core/deps/geth/go.mod"
gate_kind = "planned"
planned_paths = ["scripts/ci/layout-check.sh", "scripts/ci/vendor-verify.sh"]
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark complete without the declared evidence."
path_policy = "Every move uses git mv so history follows the files; every reference to a moved path in the repository is rewritten in the same commit; open tasks of the active specs are rewritten in the same commit and done tasks keep their historical paths."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

[task.1.1]
title = "Import pax-geth at v1.15.7-pax.17 into core/deps/geth with its pin record"
status = "done"
mode = "BUILD"
phase = "A"
wave = 1
requires = ["0.1"]
reqs = ["6.1", "6.2", "6.3", "6.4", "6.5"]
do_1 = "Fetch https://github.com/Paxeer-Network/pax-geth at v1.15.7-pax.17 and copy its tracked tree without .git into core/deps/geth; add core/deps/geth/VENDOR.kvx with one [vendor] section holding url = https://github.com/Paxeer-Network/pax-geth, ref and sha."
do_2 = "Record ref v1.15.7-pax.17 and the full 40-hex sha of that tag, which starts with d9111440, in core/deps/geth/VENDOR.kvx; refuse the import when the tag resolves to a different sha."
do_3 = "Run git status --ignored on core/deps/geth and append to core/deps/geth/.gitignore (after any upstream content) one negation line per root pattern that hides an upstream file (for example *.o, *.a, *.so, *.key, *.pem, .env, node_modules/, /target/), so git ls-files core/deps/geth lists every upstream file."
do_4 = "Leave go.mod and go.sum unchanged: the root module keeps requiring github.com/ethereum/go-ethereum => github.com/paxeer-network/pax-geth v1.15.7-pax.17; the nested go.mod of core/deps/geth keeps the tree out of the root ./... pattern. Wiring the root module to the tree is task 11.1."
do_5 = "Finish the entire scoped implementation first; then format touched files, run one build and verify_cmd once, at most two task-scoped repair cycles; record unrelated findings once in qualification.kvx without expanding scope."
symbols = []
touches = ["core/deps/geth"]
build_cmd = "git ls-files --error-unmatch core/deps/geth/VENDOR.kvx"
verify_cmd = "scripts/ci/vendor-verify.sh core/deps/geth"
gate_kind = "planned"
planned_paths = ["core/deps/geth/VENDOR.kvx"]
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark complete without the declared evidence."
path_policy = "Every move uses git mv so history follows the files; every reference to a moved path in the repository is rewritten in the same commit; open tasks of the active specs are rewritten in the same commit and done tasks keep their historical paths."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

