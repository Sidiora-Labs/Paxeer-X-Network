# Qualification findings for monorepo-layout: one [finding.<task>] per failure outside the task scope.
# Keys: revision, command, exit_code, log_path, observed_and_assumption.

[finding.0.1-gate-core-directory]
revision = "fa73ea981"
command = "git check-ignore -q .pytest_cache && git check-ignore -q core"
exit_code = 1
log_path = "scratch done-0.1.log"
observed_and_assumption = "Both checks test paths that only pass by accident of the checkout: a directory-only pattern never matches a missing .pytest_cache, and once core/ holds tracked files the negation !/core/ makes git check-ignore core report not ignored, contradicting req.6 ac_5 which wants the directory tracked and a root core dump ignored. Spec 1.0.1 rewrites the gate to .pytest_cache/CACHEDIR.TAG and core.1, which test the same two rules against the intended state; the ignore rules themselves are unchanged."

[finding.wave1-done-record-tool-hang]
revision = "e8df8dca9"
command = "cg spec done -f monorepo-layout 1.1"
exit_code = 124
log_path = "scratch layout-wave1-verify.log"
observed_and_assumption = "The spec tool's done command produced no output for 1500 s on two attempts while its background trace subprocesses spun at full CPU, so the eleven wave 1 statuses were set by hand after each task's declared verify_cmd was run once at this revision and exited 0 (all eleven vendor directories equal their pinned upstream sha); the tool defect is assumed independent of the spec content."

[finding.2.1-tracked-symlink-specgen]
revision = "e8df8dca9"
command = "scripts/ci/public-repo-audit.sh"
exit_code = 1
log_path = ".logs/task-2.1.log"
observed_and_assumption = "The tracked symbolic link spec/specgen (to ../scripts/specgen.sh) fails the symlink check, masked until the Docker actions of publish-images.yml were pinned; it predates the imports, so spec 1.0.2 lists it as a reviewed link that must resolve inside the repository."

[finding.2.1-eventdriver-root-module]
revision = "e8df8dca9"
command = "go build ./..."
exit_code = 1
log_path = ".logs/task-2.1.log"
observed_and_assumption = "launchpad/tools/production/load/eventdriver has no go.mod and is not in launchpad/go.work, so it falls under the root module and cannot resolve its KindleLaunch shared, pgx and NATS imports; it predates the imports, so spec 1.0.2 gives it its own leaf module."

[finding.2.1-cosmwasm-go-root-module]
revision = "e8df8dca9"
command = "go build ./..."
exit_code = 1
log_path = ".logs/task-2.1.log"
observed_and_assumption = "core/deps/cosmwasm tracks no go.mod, so its Go test material under packages/go-gen/tests (files without a package clause) lands under the root ./... pattern; spec 1.0.2 fences it with a boundary go.mod that vendor-verify accepts as the only extra file beside VENDOR.kvx."

[finding.2.1-private-references-tracked]
revision = "b7b362b50 with the scrub of this commit applied"
command = "scripts/ci/public-repo-audit.sh"
exit_code = 1
log_path = ".logs/task-2.1.log"
observed_and_assumption = "Four GOTCHA.kvx entries, launchpad/.github/copilot-instructions.md and three tools/paxeer-x and tools/qualification/paxeer-x scripts carried private workspace paths or an infrastructure address that predate the imports; after their scrub the private-reference check passes and the audit stops at the secret scan on twelve tracked non-vendored files (base64 PNG data in SVG assets matching the case-insensitive JWT shape, PEM header literals in tests and node/testdata/v6120-halt-export.json), which need their own task."

[finding.2.1-secret-scan-shapes]
revision = "fe6575020 with the scanner of this commit applied"
command = "scripts/ci/public-repo-audit.sh"
exit_code = 1
log_path = ".logs/task-2.1.log"
observed_and_assumption = "The twelve secret-scan hits were the case-insensitive AWS key shape inside base64 (SVG PNG data and the halt export) and bare PEM header literals; the scan moves to scripts/ci/secret-scan.sh, case-sensitive with key boundaries, JWT header decoding and a PEM body requirement, guarded by a self-test, and passes with no new allowlist entry."

[finding.2.1-specgen-check-stale]
revision = "fe6575020 with the scanner of this commit applied"
command = "scripts/ci/public-repo-audit.sh"
exit_code = 1
log_path = ".logs/task-2.1.log"
observed_and_assumption = "The audit's last step ran cd spec/specgen, which has been the bash entry point to tools/specgen since before the imports, and now runs spec/specgen -check, which reports 1426 validation errors in the active layerx-merge feature spec; that predates this task and needs its own task."

[finding.3.6-layout-check-relative-matches]
revision = "d1ba6a2b8 with the three rewrites of this commit applied"
command = "scripts/ci/layout-check.sh fuzz integration_test example occ_tests testutil && go vet ./tests/... && make fuzz-codec-smoke && make -f chain.mk build && spec/specgen && git diff --exit-code AGENTS.md CLAUDE.md"
exit_code = 0
log_path = "fleet/logs/layout-3.6.log"
observed_and_assumption = "The first run exited 1 on five lines whose paths resolve from another directory (the programs fuzz corpus after cd programs, the unanchored example/ ignore pattern, the $example shell variable); resolved by passing $(CURDIR)/programs/fuzz/corpus in the Makefile, anchoring /tests/fixtures/example/ in .cgignore and writing ${example} in the fixture script, after which the rerun exits 0 and specgen leaves AGENTS.md and CLAUDE.md unchanged."

[finding.4.1-layerx-mcp-verification-level]
revision = "b2cc11a4e with the task 4.1 move applied"
command = "make agent-build"
exit_code = 0
log_path = "fleet/logs/layout-4.1.log"
observed_and_assumption = "The first run on e96594254 with the move applied exited 2 on E0609 in crates/layerx-mcp/src/tools/write.rs, where TrackedSubmission no longer had a verification_level field, in files the move left byte-identical; resolved by the layerx-mcp write tool fix on main b2cc11a4e, which the rebase carried onto services/agent, after which the rerun exits 0."

[finding.4.3-workspace-gate-mandates-platform-root]
revision = "15265d831 with the task 4.3 move applied"
command = "cargo run --offline --manifest-path platform/Cargo.toml --locked -p layerx-platform-workspace-gate -- platform/workspace.kvx ."
exit_code = "NOT_RUN"
log_path = "fleet/logs/layout-4.3.log"
observed_and_assumption = "The platform workspace gate mandates dir.cli, dir.emulator and dir.release under the workspace root platform and its tests build their fixture from platform/workspace.kvx, so after the move it refuses either the old paths (directory missing) or the new ones (escapes the workspace root); the gate, its tests and platform/workspace.kvx are left unchanged as written and need a task that decides where the moved directories are declared."

[finding.4.3-agent-root-variable-paths]
revision = "15265d831"
command = "git grep -n -E '(CURDIR\\)|/src)/agent/' -- platform/Makefile.inc docker"
exit_code = 0
log_path = "fleet/logs/layout-4.3.log"
observed_and_assumption = "platform-sample-install still installs $(CURDIR)/agent/sdk/python and docker/human-service and docker/kernel still copy /src/agent/target/release binaries after the task 4.1 move to services/agent; read only, outside task 4.3, left for the wave 4 check."

[finding.4.4-workspace-gate-sdk-dirs]
revision = "b1c7ccf18 with the task 4.4 move applied"
command = "cargo run --offline --manifest-path platform/Cargo.toml --locked -p layerx-platform-workspace-gate -- platform/workspace.kvx ."
exit_code = "NOT_RUN"
log_path = "fleet/logs/layout-4.4.log"
observed_and_assumption = "platform/workspace.kvx still declares dir.sdk-generators and dir.integrations under the workspace root platform, the same conflict as finding.4.3-workspace-gate-mandates-platform-root, so it is left unchanged as written for the task that decides where moved directories are declared."

[finding.4.4-go-module-path-directory]
revision = "b1c7ccf18 with the task 4.4 move applied"
command = "git grep -n LayerX-Network/platform/sdk/go"
exit_code = 0
log_path = "fleet/logs/layout-4.4.log"
observed_and_assumption = "The Go SDK keeps its module path github.com/Sidiora-Labs/LayerX-Network/platform/sdk/go and its platform/sdk/go/v tag prefix as req.10 ac_4 requires, while its directory is now sdk/platform/go, so the Go proxy cannot resolve the published module until a task rules on the module path or the tag layout."

[finding.4.4-npm-ls-empty-tree]
revision = "b1c7ccf18 with the task 4.4 changes applied"
command = "npm ls --workspaces"
exit_code = 0
log_path = "fleet/logs/layout-4.4.log"
observed_and_assumption = "The qualification checkout has no node_modules and npm ci --offline stops at ENOTCACHED for ai-7.0.77, so npm ls --workspaces exits 0 on an empty tree; every workspace entry of package.json names a directory with its package.json and a package-lock.json key of the same package name, and an installed-tree check is left for the wave 4 gate."

[finding.4.5-platform-build-reserve-namespace]
revision = "a460c243d with the task 4.5 changes applied"
command = "make platform-build"
exit_code = 2
log_path = "fleet/logs/layout-4.5.log"
observed_and_assumption = "cargo build of the platform workspace stops at human/crates/layerx-paxeer-client/src/deposit.rs:1709, which names AccountNamespace::SystemPaxeerReserve that services/agent/crates/layerx-types no longer declares; neither file is changed by task 4.5, so the failure is assumed to exist at the base revision and is left for the task that owns the reserve namespace."

[finding.4.5-workspace-gate-root]
revision = "a460c243d with the task 4.5 changes applied"
command = "cargo run --offline --manifest-path services/platform/Cargo.toml --locked -p layerx-platform-workspace-gate -- services/platform/workspace.kvx ."
exit_code = "NOT_RUN"
log_path = "fleet/logs/layout-4.5.log"
observed_and_assumption = "The gate now reads services/platform/workspace.kvx, while the manifest keeps root = \"platform\" and the dir entries already stale since tasks 4.3 and 4.4, and the gate tests build their fixture under a platform root; both are left unchanged as written for the task that decides where moved directories are declared."

[finding.4.5-pay2-unlocked-manifest]
revision = "a460c243d with the task 4.5 changes applied"
command = "cargo metadata --locked --format-version 1 --manifest-path services/agent/qualification/pay2/Cargo.toml"
exit_code = 101
log_path = "fleet/logs/layout-4.5.log"
observed_and_assumption = "The pay2 qualification manifest has no tracked Cargo.lock and its .gitignore ignores /Cargo.lock, so --locked cannot hold for it at any revision; its path entries into services/platform were rewritten and every other affected workspace passes cargo metadata --locked."

[finding.4.5-stale-segment-paths]
revision = "a460c243d with the task 4.5 changes applied"
command = "git grep -n -E '\"platform\"|\\x27agent\\x27|\"agent\"|\"interop\"' -- tests/agent/sdk/python tools/jev/checks/deps.py tests/daemon/custody_chain.py tests/bridge/paxeer_x_multiasset_credit.py scripts/qualification/paxeer-x/program-http-producer.py tools/qualification/paxeer-x"
exit_code = 0
log_path = "fleet/logs/layout-4.5.log"
observed_and_assumption = "Segment-joined paths left by tasks 4.1, 4.2 and 4.4 still name agent, interop and platform/integrations in tests/agent/sdk/python/test_web_search.py, test_x402.py, tools/jev/checks/deps.py, tests/daemon/custody_chain.py, tests/bridge/paxeer_x_multiasset_credit.py, program-http-producer.py, human_native_custody.py and native_send_purpose.py; task 4.5 rewrote only their platform segments and leaves the rest for the wave 4 check."
