[meta]
title = "PAXAI INTEGRATION MAP AND READINESS CONTRACT — V1"
version = "1"
status = "RUNTIME_DEPLOYMENT_AND_QUALIFICATION_UNRUN"
canonical_spec = "../../spec.kvx"
task_authority = "Canonical ai.* tasks and requirements are defined in ../../spec.kvx."
qualification = "runtime/deployment and application qualification UNRUN."
paragraph_001 = "This map names Paxeer interfaces only. It does not assert that a declared API is enabled in the target deployment. Future implementation must preserve exact native authorization, meter, proof and atomicity behavior."

[integration.I01]
title = "EXISTING INTERFACES"
paragraph_001 = "Programs SDK programs/sdk/rust/src/abi.rs declares default ABI4, v2 context/crypto/scoped storage/program-account transfer APIs, key256/value1048576/call1048576/eventtopic64/payload65536/eventgraph64/accountseed128. App protocol1 is unrelated to ABI1. Minimum functionality needs the existing v2 extension surface; use the actual admitted deployed ABI and a matching pinned artifact manifest, not a new invented ABI number."
paragraph_002 = "ai.T-C02-STATE first qualifies the pure bounded state codec and concrete SDK adapter compilation. Original ai.T-C02 later qualifies the actual executable guest and native host using make paxai-host-boundary-build and the unchanged host_boundary command; CORE-A02 remains mandatory and UNRUN until that gate passes."
paragraph_003 = "programs/sdk/rust/src/storage.rs storage::shared::{read,write,delete,scan,drop_namespace} binds program-shared namespace, using SharedStorageKey. Program-private principal namespace is a different scope. PAXAI uses exactly one shared key. programs/sdk/rust/src/capability.rs grants SharedStorageRead/Write and EmitEvent; programs/sdk/rust/src/payments.rs supports mixed PaymentGrant::Basic and ProgramSpend through ProgramPaymentCapabilities. A program's own role registry must reject unauthorized writes even if the invoker presents broad host storage grants."
paragraph_004 = "programs/sdk/rust/src/crypto.rs hash(Sha256,HashInput) and ed25519_verify(Ed25519Message,key,signature) expose deterministic hashing and signature checks; hash input maximum1MiB and Ed25519 message maximum64bytes. PAXAI signs32byte domain-separated digests. Hashing/signature availability must be exercised on the admitted host before release. Cryptographic validity never substitutes for delegated-role or live-revocation checks."
paragraph_005 = "programs/sdk/rust/src/payments.rs PreparedProgramAccount::new(program,seed,asset) produces the exact existing account derivation; registration_payload emits the native ProgramAccount registration payload and requires deployment registration authority. funding_grant returns Transfer402 to exact derived account. spend_grant and ProgramPaymentCapabilities encode ProgramSpend tag9 with owner/seed/source/asset/recipient/maximum. programs/sdk/rust/src/transfer.rs fund_program_account requests principal-funded deposit; pay_from_program_account requests program-derived-account transfer. Native checks are in src/modules/programs/accounts.c and src/modules/programs/transfer.c, with Programs runtime capability and transfer law in programs/crates/layerx-programs-runtime/src/abi/capability.rs, abi/mod.rs and transfer.rs."
paragraph_006 = "No balance setter, mint host or fabricated escrow API is assumed. programs/sdk/rust/src/balance.rs read is sight-only."
paragraph_007 = "agent/crates/layerx-types/src/program_call.rs provides native ProgramCall bytes; the existing106-byte BE fixed header, access declarations and ABI capability encoding are not replaced by the inner PAXAI envelope. Clients build an ordinary signed native activity carrying ordinary ProgramCall calldata. Application replay and native activity sequence are separate."

[integration.I02]
title = "CONTENT BLOB LIFECYCLE BLOCKER"
paragraph_001 = "src/modules/programs/storage.c lxp_programs_storage_stage_final hashes each nonempty value and persists it through lxp_ctx_blob_put, then persists the namespace manifest and updates its native KV head. It reuses identical existing content by digest but distinct mutation versions require fresh blobs. A zero-cell namespace deletes the KV head; the native finalizer does not demonstrate content garbage collection. App history eviction and storage::shared::delete cannot be advertised as physical reclamation."
paragraph_002 = "Native ceilings defined by the native architecture are committedblob512, committedbytes64MiB, stagednewblob4/activity, blobsize1MiB, moduleKV512 and stagedwrites64. PAXAI one sharedvalue+manifest uses at most2newblobs per normal mutation, but this is insufficient for unlimited operation under append-only retention. Four admitted markets do not imply that four markets can operate indefinitely. Native cap failures must remain atomic. Artificially raising capacities, ignoring errors, deleting proof-referenced blobs or silently falling back to offchain authority is prohibited."
paragraph_003 = "A proposed NEW integration task, prerequisite for CONTINUOUS_OPERATION release, must specify and implement a global content lifecycle within existing storage/snapshot/log architecture. Required semantics: enumerate roots reachable from committed module KV, in-flight staged transactions, retained certified state snapshots, replay checkpoints and proof-retention policy; retain their transitive manifests/content/artifacts; never collect a digest reachable by any live root. Collection candidates must be unreferenced and outside the declared finality/replay/proof horizon. Existing narrow consensus-staged sandbox cleanup is not a general collector: it does not establish complete shared namespace-head reachability and cannot be reused without a full versioned reachability design. Every blob is itself part of the canonical module root."
paragraph_004 = "Therefore removing a blob is an authenticated consensus state transition that produces a new correct root; background mutation claiming an unchanged current root is forbidden. Preserve historical certified roots and their proof data under an explicit archive/retention contract, rather than claiming deletion leaves the current root unchanged. References held by pending activities and crash recovery are part of reachability. A crash before/after mark/sweep/checkpoint publication must either restore the prior complete index or the new complete index, with no partially missing reachable content. Deterministic application results cannot depend on collector timing. The cleanup activity itself must have deterministic authenticated deletion inputs and be replayed identically; its root change is explicit."
paragraph_005 = "Existing prepare capacity accounting may count additions before crediting deletes, so a cleanup cannot promise that simultaneous deletions make a full-store mutation admissible; demonstrate required ordering and headroom on actual paths."
paragraph_006 = "Concrete future target files are existing src/modules/programs/storage.c and include/layerx/lxp_module.h for the storage boundary, with new proposed src/storage/lxp_blob_lifecycle.c and tests/programs/test_blob_lifecycle.c; the underlying native blob store owner must identify its exact persistence file before modifying it. No currently qualified GC entrypoint is asserted. The future single focused verify command is PROPOSED, not currently existing: make test-paxai-blob-lifecycle. Its gate must be added by that task and run real storage/native replay, not mock blob maps. One future build target must be defined with the actual project Makefile owner before task admission; it is unresolved today, not guessed as runnable."
paragraph_007 = "This gate must demonstrate more than512 distinct PAXAI state mutations over real checkpoint/replay boundaries while remaining within unchanged512/64MiB capacities, reclaim only legitimately unreferenced content, preserve every retained-root proof and restart integrity, and refuse atomically when all capacity remains reachable. It must also show concurrent finalize/collector operation cannot lose a referenced value and a malicious finality/proof-retention request cannot force unsound collection. Qualification cannot weaken proof retention merely to pass. If actual native store intentionally retains every historical root, continuous operation requires an explicit versioned storage design and retention contract, not an application workaround."
paragraph_008 = "Headroom policy is proposed operator admission: do not admit a new market without demonstrated current free budget for its deployment/account records and at least64 free content slots; do not admit a mutating transaction if available host admission headroom is below4newslots or reserve-needed bytes. Existing app Context has no authoritative freeblob count field, so this is an operator/admission-service preflight, NOT a guest-enforced guarantee. The native finalizer remains the definitive atomic capacity check. A future capacity reservation/readiness endpoint must authenticate actual current store counts and bind them to a committed revision, without claiming a read reserves slots. Reservation serialization and finalizer refusal remain necessary under contention. Calls already accepted may still return CAPACITY safely."
paragraph_009 = "If the target deployment lacks reliable preflight, report UNKNOWN readiness and disable automatic market expansion."

[integration.I03]
title = "REQUIRED READINESS RECORD"
paragraph_001 = "Before ENABLED, record actual chain domain/genesis/config source, executing program ID/artifact hash, admitted host ABI/runtime/fee schedule, program account registration receipt and immutable asset binding, effective native capabilities, current finality verifier configuration and proof trust roots, and native capacity evidence. Run the actual context/hash/signature/shared-storage/funding/payout round trip on real host paths in a future focused integration gate. Native grant violations must preserve business-state rollback and real balances. Fund must prove invoking-principal funding rather than a supplied arbitrary source; payout must prove exact program-derived ownership and ProgramSpend ceiling."
paragraph_002 = "Unknown registration authority, incompatible host version, absent authenticated height, unavailable balance proof, missing finality verifier or failed capacity preflight is READINESS_BLOCKED, not a guessed fallback."
paragraph_003 = "If authenticated Context::batch_height does not execute in the selected deployment despite interface availability, do not implement caller timestamps. The remedy is deploying/qualifying the existing admitted v2 context_read implementation and matching artifact ABI, or a separately approved versioned host integration preserving selector semantics. This is a prerequisite for enablement."

[integration.I04]
title = "FUTURE COMMON IMPLEMENTATION TASKS"
paragraph_001 = "ai.T-C01, no dependencies: create proposed package programs/crates/layerx-programs-ai-market and shared types/codec/errors matching core.kvx and wire.schema.json. Intended future compile: cargo build --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --target wasm32-unknown-unknown --release. Intended single verify: cargo test --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --test canonical_contract. This future test target does not exist yet. Gate must cover canonical bytes, domain separation, overflow, exact signature messages and JSON diagnostic range checks with canonical vectors."
paragraph_002 = "ai.T-C02, requires ai.T-C01: implement single-value bounded state schema and real host adapter in proposed src/state.rs and src/host_adapter.rs. Same futurecompile; verify cargo test --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --test host_boundary. Requires actual context and storage finalization; no fake grants. Verify section maxima192KiB, onevaluewrite, <=2newapplication-namespaceblobs (plus native replay witness/KV when present, all within host bounds), no nested application call, authority failure rollback."
paragraph_003 = "ai.T-C03, requires ai.T-C02 and registrationauthority: qualify actual native program account, immutableasset and fee/finality adapter using proposed tests/value_boundary.rs. Same futurecompile; verify cargo test --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --test value_boundary. Must reach real runtime/native transfer and verified balances, not a simulated ledger. No current success is claimed."
paragraph_004 = "ai.T-C04, storageowner-approved prerequisite: resolve and qualify native global blob lifecycle described in I02, with exact build target and existing persistence ownership fixed before admission. This task directly blocks continuous production operation, although bounded read-only and documented finite mutation experiments can still be designed. Qualification remains UNRUN."
paragraph_005 = "Every implementation task follows implementation-first then one bounded build/one focused verify with at most two task-scoped repair cycles."

[integration.I05]
title = "STORAGE PROFILE AUTHORITY"
paragraph_001 = "The storage-lifecycle.kvx contract is the detailed normative prerequisite for a future versioned authenticated storage lifecycle. Its actual native-root and replay constraints prevail over any abbreviated lifecycle summary in I02. Storage-owner approval and exact profile qualification remain prerequisites; this document does not authorize deployment or pretend background GC exists."

[integration.I06]
title = "NATIVE REPLAY CAPTURE IS ADDITIONAL STORAGE"
paragraph_001 = "Existing src/modules/programs/state_record.c lxp_programs_replay_capture_stage (535–575) persists capture bytes as one content blob and creates an activity-keyed native KV replay record. This is additional to the application namespace value/manifest. Thus an ordinary PAXAI mutation with replay capture may consume three new blobs in total, not two, and one additional native replay KV entry; distinct witnesses can remain pinned by these entries. The four-new-blob ceiling remains unchanged. Readiness, ai.T-C04 and the storage lifecycle profile must cover both module KV512 growth and blob512/64MiB growth, plus replay witness retention and proof/recovery promises. A namespace-only capacity estimate is insufficient. Do not change or bypass replay capture to satisfy capacity."
paragraph_002 = "The lifecycle design must enumerate native replay records as roots and govern their authenticated expiry/archive/cleanup explicitly."

[integration.I07]
title = "Shared-state and native-host qualification order"
paragraph_001 = "The ai.T-C02 focused gate shall execute the immutable built AI market Wasm through a dedicated production-linked native process. A composed build target shall produce the guest, Programs host-FFI interpreter archive and native executable before the existing Rust host_boundary verify command. The process shall register actual local identities, verify signed native activities, resolve native authority and use authenticated kernel batch height. The gate shall measure committed shared namespace value/manifest and actual replay witness/KV/native overhead under unchanged bounds, and prove atomic application rollback. Public authenticated-context constructors, fake native storage, substitute interpreter symbols, test-only guest mutation opcodes and placeholder handlers are forbidden. Exact shared-file ownership and a concrete real guest mutation/signature-handler producer are admission prerequisites. The preliminary ai.T-C02-STATE codec gate proves only pure canonical state behavior and successful Wasm compilation of the host adapter. Existing ai.T-C02 retains AI.CORE-A02 unchanged and pending until concrete feature-handler producers exist. Source consumers may depend on ai.T-C02-STATE only; native value qualification and candidate release depend on original ai.T-C02. Neither codec success nor compilation may satisfy or skip the full host acceptance. The early adapter task owns the actual SDK dependency/lock changes; later artifact assembly owns the cdylib and concrete SDK guest entry exports through the same serial core writer. An rlib-only target build is compile evidence only and cannot satisfy native artifact readiness."

