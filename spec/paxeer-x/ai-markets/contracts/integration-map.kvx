obligation_01_task = "ai.F04-T02"
obligation_01_assertions = "Retain all current original acceptance references and add AI.F04-A07. Require all A01/A02/A03/A04/A05/A08 host/window/state/retry/concurrency assertions; A06 reveal refusal and admitted-only output; A07 empty refusal and exact zero admission; A10 actual max-size admission,33-entry no mutation, currentreports/whole-state cap rollback and overflow fixture through real F01; A11 late reveal refusal; A12 next-epoch frozen versions/immediate revocation/epoch replay. Require production SDK hash vector and signature checks including host/context failures and preserved row/sequence/revision. No F05 final seal substitute."
obligation_02_task = "ai.F05-T03"
obligation_02_assertions = "Add mandatory original AI.F04-A06/A07/A11 and A12 rollover/aggregation-consumer assertions. Consume actual admitted F04 rows: missing/expired/refused remain no vote, explicitzero is a vote, two of eight reveals supply exactlytwo rows, stable eligible set after reveal_end without expiry maintenance, quorum handled only by F05; no reward/slash from F04 event. Test actual seal/output not a locally invented eligible vector."
obligation_03_task = "ai.F03-T04"
obligation_03_assertions = "Add mandatory original AI.F04-A12 revocation/seal assertions unchanged: preseal excludes while retaining acceptance history, postseal leaves sealed set unchanged. Actual interpreter/native adapter and F05 seal implementation, already required by this task. Consume T02 admission evidence without rerunning its passed gate."
obligation_04_task = "ai.F04-T03"
obligation_04_assertions = "Retain original A09/A12 references as feature obligations; task-local A12 recovery witness covers real next-epoch binding and historical-retry no recreation after actual rollover. Preserve first accepted/reveal heights and immutable C, exact expiry-limited replay, finalized crash/dropped-response reconciliation and missing-salt refusal. Add mandatory real OS-CSPRNG/per-report salt/persist-before-send client assertions; client implementation remains FM-F10-owned. Sealed exclusion witness is completed in F03-T04, never fake an F05 seal here."
obligation_05_task = "ai.F01-T03-EPOCH"
obligation_05_assertions = "A10 overflow witness uses actual checked OpenEpoch arithmetic and refuses T+128 overflow without mutation. Its recorded producer result can be consumed by T02; do not rerun its gate or write another F01 implementation."
obligation_06_task = "ai.RELEASE-CANDIDATE"
obligation_06_assertions = "Original AI.F04-A01..A12 remain UNRUN until all assigned compatible mandatory real evidence completes each entire unchanged scenario. Consume records via existing declared dependencies; no release approval from codec acceptance alone or waived missing runtime producer. A global original case may remain UNRUN while a bounded codec task passes its new local cases."

