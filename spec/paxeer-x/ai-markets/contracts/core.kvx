[meta]
title = "PAXAI SHARED APPLICATION CONTRACT — VERSION 1"
version = "1"
status = "IMPLEMENTATION_AND_QUALIFICATION_UNRUN"
canonical_spec = "../../spec.kvx"
task_authority = "Canonical ai.* tasks and requirements are defined in ../../spec.kvx."
qualification = "implementation and qualification UNRUN."
paragraph_001 = "This file is normative for F01–F10. It defines a proposed application atop existing Paxeer Programs. Its version is not the Programs host ABI version. Feature requirements may narrow these bounds but must not silently substitute identities, encoding, accounting or clock semantics."

[contract.C01]
title = "DEPLOYMENT AND TRUST BOUNDARY"
paragraph_001 = "One market is one independently deployed instance of the same proposed WASM program. The proposed new package is programs/crates/layerx-programs-ai-market, package layerx-programs-ai-market, registered in programs/Cargo.toml by future implementation. Modules codec/types/state are shared-owned work; registry, workers, evaluators, commit_reveal, aggregation, rewards, reputation, admission, evidence and queries belong to their feature owners. No feature adds a native module, replaces consensus, issues a new asset, changes custody or weakens finality. Native Programs module ID remains 9 and existing eleven-module proof namespaces remain authoritative."
paragraph_002 = "All authoritative application data use program-shared storage in one value under the exact ASCII key paxai/state/v1. Principal-scoped storage is not authoritative for market state. The application accepts direct calls only in v1: immediate_caller must be absent; no nested application composition, callbacks or reentrancy. SharedStorageRead, SharedStorageWrite and EmitEvent capabilities are requested explicitly when needed. A granted host capability does not establish an application role; the program must independently check its registry and context principal. Signed delegate permission never manufactures a host capability."
paragraph_003 = "External services perform all model inference, training, benchmarking, artifact handling and semantic evaluation. Deterministic guest code validates compact signed statements and conserves existing assets. A signed score is an authorized assessment, not proof that an AI answer is true or a model was executed faithfully."

[contract.C02]
title = "TYPES AND CANONICAL ENCODING"
paragraph_001 = "ID32 is exactly 32 bytes, nonzero; Digest32 is exactly 32 bytes and may be zero only where a field explicitly declares absence. PrincipalId, ProgramId, MarketId, WorkerId, EvaluatorId, AccountId, AssetId and RequestId are distinct ID32 types. PublicKey is an Ed25519 32-byte public key, Signature is 64 bytes, Salt is 32 bytes. Application schema_version is u16 and equals 1. config_version, key_version, grant_version, actor_sequence, epoch and height are u64. Versions begin at 1, epoch begins at 0, successful actor sequence begins at 1. Overflow is an explicit refusal, never wraparound. Scores are u32 integers from 0 through 1000000 inclusive (parts per million). Monetary Amount is u128 in the immutable registered asset's smallest units. Asset display decimals are metadata only; no rescaling occurs in settlement."
paragraph_002 = "V1 computation has no floating point."
paragraph_003 = "Canonical binary integers are unsigned fixed-width big endian. Fixed bytes are raw bytes. Vector count is u16 followed by its elements. Variable bytes are u32 byte length followed by exact bytes; unknown trailing bytes are rejected. Booleans are one byte 0 or 1. Optional values use presence byte followed by the value only when present. Reserved fields are fixed zero. Vectors declared sets are strictly ascending by raw ID bytes and duplicate-free. Strings are UTF-8 where expressly permitted, have byte bounds, and never determine identity through Unicode normalization. The JSON schema is a diagnostic transport shape: JSON serialization is not a signature or state-root preimage. Decimal strings carrying u64/u128 must be canonical base ten, with no leading zero except the value zero, and must be range-checked after schema validation."
paragraph_004 = "Define H(D,B) as SHA-256 of ASCII domain D followed by one NUL byte followed by canonical byte string B. Domain literals below include no implicit length or additional separators. Domain binding prevents equal byte strings under different record purposes from being interchangeable. Hash collisions and zero-derived identities are refusal conditions; there is no retry counter invented by the implementation."
paragraph_005 = "market_id = H(PAXAI/market/v1, chain_domain32 || executing_program32)."
paragraph_006 = "worker_id = H(PAXAI/worker/v1, market_id32 || owner_principal32 || enrollment_nonce32)."
paragraph_007 = "evaluator_id = H(PAXAI/evaluator/v1, market_id32 || owner_principal32 || enrollment_nonce32)."
paragraph_008 = "Enrollment nonce is explicit fresh public 32 bytes, bound in the enrollment event; it need not persist in the compact record. A replaced identity has a new nonce and ID. Identity does not transfer reputation to a replacement automatically."
paragraph_009 = "chain_domain32 is the immutable deployment identifier selected from the actual chain genesis/config by the authorized installer. Existing listed Context fields do not independently expose genesis identity. Enablement requires an operator record tying this value to the actual chain and client configuration; its omission blocks enabling signatures and funding. All clients must compare it with their authenticated chain configuration."

[contract.C03]
title = "OPERATION ENVELOPE, AUTHORITY AND REPLAY"
paragraph_001 = "The binary application envelope is ordered: magic six bytes ASCII PAXAI1; schema_version:u16; operation:u16; chain_domain:32; program_id:32; market_id:32; actor_principal:32; epoch:u64; config_version:u64; roster_hash:32; actor_sequence:u64; expiry_height:u64; request_id:32; payload_length:u32; payload bytes; authentication_kind:u8; then either no extra bytes for kind0 or public_key32 plus signature64 for kind1. Entire envelope maximum is 16384 bytes; payload maximum is 15965 bytes, additionally bounded by the operation. Kind0 obtains authority only from authenticated invoking_principal; actor_principal must match it. Kind1 may be relayed only for worker operational statements and evaluator score statements; the enrolled key must be active, scoped to that identity and current epoch, and must sign the request digest."
paragraph_002 = "Funding, policy changes, membership authority changes, revocations and refunds require kind0. Permissionless deterministic settlement and fixed-recipient claims use kind0 with the relayer principal, but do not acquire owner or worker privileges."
paragraph_003 = "request_digest = H(PAXAI/request/v1, every envelope byte from magic through the end of payload, excluding authentication_kind/key/signature). Ed25519 verifies exactly the 32 digest bytes. This fits the existing host's maximum Ed25519 message length 64. No 'sign JSON', EIP personal-sign prefix or implicit Ed25519ph transform is admitted."
paragraph_004 = "For role-bound mutations, actor_sequence must equal last_successful_sequence+1. State retains bounded last_sequence, last_request_id, last_request_digest and last_result_digest for owner, treasury, current workers and current evaluators; no unbounded arbitrary-principal replay table. A repeat of the last request with identical sequence/ID/digest returns ALREADY_APPLIED and the retained result digest without changing application state or moving funds. Same sequence with different body returns REPLAY_CONFLICT. Earlier sequences return SEQUENCE_CONSUMED with no effects; gaps return SEQUENCE_GAP. A failed operation consumes no application sequence. An SDK retry must reuse exactly the same request bytes; a newly signed native activity may still incur ordinary network fees. Business idempotency never promises zero network fees."
paragraph_005 = "Permissionless operations use object-local state: settlement cursor and sealed input digest, claim bit and immutable entitlement identity, or epoch state. They require actor_sequence=0 and preserve no relayer record. Their repeated semantic requests return ALREADY_APPLIED or the current cursor; a contradictory expected cursor returns STALE_CURSOR. Request expiry is inclusive refusal at height >= expiry_height. An expiry_height of zero is invalid. epoch/config/roster must equal the operation's exact frozen binding; registry operations before any epoch use epoch=0 and all-zero roster_hash, explicitly distinguished by operation."
paragraph_006 = "Roles: Owner controls policy, activation and membership grants but cannot rewrite frozen scoring or accrued entitlements. One optional immutable Treasury principal chosen at CREATE may make irrevocable contributions; C16 fixes its binding. Worker principal controls its registered execution identity and one operational delegate. Evaluator principal controls one granted evaluation identity and one delegate. A roster evaluator principal may not equal a roster worker principal or market Owner principal. This is an identity-level conflict check, not proof of different beneficial ownership. Relayer has no privileged authority. Revocation is immediate for new admission; rekeys and new grants are staged for next roster snapshot. A grant/key revoked before aggregation seal excludes that row."
paragraph_007 = "Revocation after the aggregation seal is prospective and does not recompute already sealed settlement."

[contract.C04]
title = "CLOCK, EPOCHS AND IMMUTABILITY"
paragraph_001 = "Use authenticated Context::batch_height during execution. This is executing batch height, not independently finalized height. External services initiate costly work and publish irreversible outcomes only from the existing chain's authenticated finalized view. They must reconcile a speculative observation to the finalized receipt or discard it; no local wall clock or confirmations heuristic replaces Paxeer finality."
paragraph_002 = "origin_height is fixed at market creation. epoch e has scheduled start T=origin_height+128*e. Checked arithmetic is mandatory. Default half-open windows: Work [T,T+64), Commit [T+64,T+80), Reveal [T+80,T+96), scheduled Settlement [T+96,T+128). These constants are v1 fixed defaults; changing them requires an explicitly versioned application upgrade rather than an unnoticed operator override. OpenEpoch is lazy and may occur only during that epoch's Work window, never backdate the opening. Missed scheduled epochs are marked skipped by the bounded next-open transition, without constructing fake AI work or zero reputation samples. A prior opened epoch must be terminal before a later one opens. Settlement may complete after its scheduled end, but blocks the next open until terminal. Late commitment/reveal is never admitted."
paragraph_003 = "OpenEpoch atomically freezes config_version, task_policy_digest, worker/evaluator roster, recipient accounts, delegate/grant/key versions and budget cap. Roster order is ascending identity IDs, never mutable registration slots. roster_hash = H(PAXAI/roster/v1, schema_version:u16 || market_id32 || epoch:u64 || config_version:u64 || worker_count:u16 || ascending worker entries || evaluator_count:u16 || ascending evaluator entries). Worker entry is worker_id32 || owner_principal32 || recipient_account32 || generation:u64 || key_version:u64 || public_key32 || metadata_digest32. Evaluator entry is evaluator_id32 || owner_principal32 || grant_version:u64 || key_version:u64 || public_key32 || rubric_digest32. Generation is u64 starting1; it distinguishes accepted operating generations while stable WorkerId remains fixed until replacement."
paragraph_004 = "All identity and policy changes preserve this snapshot."
paragraph_005 = "BeginAggregation at or after reveal_end atomically seals eligibility and admitted-row digests. No program changes sealed inputs afterward. ProcessAggregation handles at most eight frozen workers per call in ascending roster order, checking expected cursor and input digest. FinalizeAggregation is allowed only at terminal cursor and commits one immutable output root. Interrupted processing resumes from the committed cursor, never re-awards a processed item. V1 exposes no abort operation, discretionary or otherwise. Any future abort needs a versioned deterministic predicate and independent authority/qualification contract; no owner may discard valid work or seize pending reward budget."
paragraph_006 = "FinalizeAggregation and the F06 entitlement/ledger seal are ONE atomic terminal transition; a completed processing cursor is provisional and not independently claimable. Owner suspension forbids new epochs and new work while permitting commitments and reveals for already admitted work of the current frozen epoch within their ordinary windows, deterministic settlement and claims unless that participant is revoked. Closed means no live epoch, no reserve/claim liability and successful fixed-recipient free refund or zero Free."

[contract.C05]
title = "SIGNED REPORT AND COMMITMENT"
paragraph_001 = "ReportBody has exact order: schema_version:u16=1; chain_domain32; program_id32; market_id32; epoch:u64; config_version:u64; roster_hash32; evaluator_id32; grant_version:u64; key_version:u64; evidence_root32; vector_count:u16; ascending unique (worker_id32, score:u32) entries. vector_count is 1..32; empty report is NO_SCORES. Maximum body is 1380 bytes. report_digest = H(PAXAI/score-report/v1, ReportBody). Report signature is Ed25519 over H(PAXAI/score-attestation/v1, report_digest32). No total normalization is imposed on individual evaluator scores. A missing worker is no vote, not a zero score. An explicit zero is valid."
paragraph_002 = "commit_digest = H(PAXAI/score-commit/v1, chain_domain32 || program_id32 || market_id32 || epoch:u64 || config_version:u64 || roster_hash32 || evaluator_id32 || grant_version:u64 || key_version:u64 || report_digest32 || salt32). One immutable commitment per evaluator/epoch. Exact repeats are idempotent; conflicting replacement is refused. Reveal must match commitment, frozen bindings, valid signature, active authority and deadline. Failed reveal changes no row or sequence. Salt must be generated cryptographically externally; disclosure before reveal can compromise concealment. No randomness beacon is presumed."
paragraph_003 = "evidence_root commits the F09 off-chain manifest of exact task policy, worker generations, requests, outputs and provenance. Guest admission checks the committed root and roster membership; it cannot fetch or semantically validate arbitrary external content. Authorized evaluators must validate bundle bindings before signing. Report receipt means authorized signed assessment admission, not on-chain proof of the bundle's truth."

[contract.C06]
title = "AGGREGATION AND CONSERVED ECONOMICS"
paragraph_001 = "For each worker, eligible scores are those explicit entries from distinct sealed eligible evaluators. Quorum is 3. Fewer votes gives ineligible/no reward score, not an invented measured zero. With n>=3, order the n integers and choose lower median at zero-based index floor((n-1)/2). No stake weighting or economic voting power in v1. All ties are deterministic. The result score remains in 0..1000000. Maximum votes processed is 32*8=256, bounded across chunks. All-zero valid scores are a real result but allocate no rewards."
paragraph_002 = "One immutable asset and one registered program-derived rewards account are used per market. Exact seed is ASCII paxai/rewards/v1 (16 bytes). Existing PreparedProgramAccount computes the account and registration payload; the application must not substitute its own native address derivation. Funding is only Owner or the optional immutable Treasury bound by C16, in kind0 calls, with exact principal-to-derived-account host funding grant and amount. Fund payload includes immutable refund_recipient_account and explicit irrevocable-contribution consent. Contributions are pooled market funds, not refundable individual sponsor claims. Externally transferred/unreconciled funds are not automatically accounting Free or entitlements."
paragraph_003 = "Ledger fields are tracked_deposits, tracked_refunds, total_claimed, Free, Reserved, Liability, all checked u128. After every successful operation: tracked_deposits = tracked_refunds + total_claimed + Free + Reserved + Liability. Onchain sight balance for the derived account must be at least Free+Reserved+Liability; unexplained excess is unaccounted and cannot be spent by this contract. Deposit and funding-ledger credit commit atomically. OpenEpoch transfers B<=Free into Reserved; B is frozen. No mint or balance write exists. Final entitlement seal transfers exact allocation from Reserved to Liability; unused budget returns Free atomically. Claimed transfers decrease Liability and increase total_claimed, atomically with the actual native transfer. Failed host transfer or storage/event failure commits neither payment nor ledger mutation."
paragraph_004 = "For sealed positive scores s_i, S=sum_i s_i. If S=0 or no qualified worker, allocate zero and return all B to Free. Otherwise a_i=floor(B*s_i/S), computed with checked u256 product; remainder r_i=(B*s_i) mod S. Let L=B-sum_i a_i. Increase the L largest remainders by one unit, ties by ascending WorkerId. Since positive eligible worker count<=32, residual units are strictly fewer than that count. No owner/evaluator cut exists. Entitlements bind market/epoch/WorkerId/frozen recipient/asset/amount/settlement root and have an immutable claimed flag. Claims are permissionless, fixed-recipient, one claim per call v1; zero entitlement does not produce a zero-value host transfer."
paragraph_005 = "Claim expiry is terminal_height+4096, using checked height arithmetic and half-open claim window [terminal_height,expiry). Expiry transitions unclaimed Liability to Free once; it does not claw back claimed amounts. At most32 completed epoch records are retained. Never evict an unexpired claim record. If the ring is full and the oldest record cannot be safely pruned, refuse new epoch opening RETENTION_FULL; delayed terminalization can therefore reduce throughput. Archive data externally before pruning, but application safety never relies on an archive inventing missing proof. Only Free may be refunded after winding down, to immutable refund recipient fixed at creation. Owner changes cannot alter it; v1 does not expose ownership transfer."

[contract.C07]
title = "STORAGE, WORK AND CAPACITY"
paragraph_001 = "Application state maximum is 196608 bytes (192KiB), including 32 epochs of recipient-bound entitlements. Bound each serialized section: F01policy/lifecycle16384; F02/F03identity+frozen roster24576; F03/F04currentreports24576; F05/F06settlement+historicalclaims81920; F07/F08reputation/admission24576; common/F09/F10control24576. Sum196608. Fields not needed for future validation belong in authenticated events/offchain stores. No per-task model input/output, large endpoint manifest or complete evidence document is stored onchain. Arrays are bounded and canonical. Report evidence root plus compactmetadata replace full task histories. The proposed serializer must reject both section and total overflow before effects."
paragraph_002 = "Every mutating application call writes at most this one shared value once and emits at most two application events of maximum2048 bytes each. SDK/application payload maximum16384, successful response maximum16384; event topic ASCII PAXAI/v1/<operation-name> maximum64 bytes. The native finalizer then requires one content value and one namespace manifest, at most2 new content blobs for this namespace. No nested app calls or principal namespace writes are allowed. At most one monetary transfer per funding/claim/refund call, so transaction-local transfer cost is bounded independently from32workers. Process chunks contain at most8workers and cannot emit perworker transfers during aggregation."
paragraph_003 = "Existing native ceilings include module KV512, staged writes64, committed contentblob512, total committed blob bytes64MiB, at most4 new stagedblobs per activity and1MiB per blob. Shared application limits do not enlarge these. A four-market initial pilot is operator admission policy, not guaranteed physical capacity. Admission also requires current module/KV/blob/headroom and release capability checks; actual host limits can refuse earlier. Distinct historic versions of the same shared value generate distinct blobs. Deleting a key or pruning app history is NOT proven to reclaim those native blobs. Without verified global reclamation, continuous mutation eventually exhausts the content store."
paragraph_004 = "Continuous-operation release is therefore BLOCKED until the lifecycle prerequisite in integration-map.kvx is implemented and qualified; bounded app retention alone does not resolve it. Existing capacity errors must remain atomic and visible, never silently discard old roots or expand native constants."

[contract.C08]
title = "COMMON RESULTS, ERRORS AND RECOVERY"
paragraph_001 = "Operation result body is schema_version:u16, status:u16, application_error:u16, request_digest32, state_revision:u64, result_digest32, payload_length:u32, payload. The uniform fixed result header is82bytes. C15 defines exact error results. state_revision increases once per successful semantic mutation; exact retry does not increase it. ALREADY_APPLIED is a result status, not a new success effect. result_digest hashes the operation-specific canonical result using domain PAXAI/result/v1. Each emitted application event includes market, epoch, config, state_revision, request_digest and result_digest; indexers attach native finalized receipt/batch identity rather than pretending a guest can predict its enclosing receipt digest."
paragraph_002 = "Common error names: BAD_VERSION, NON_CANONICAL, WRONG_DOMAIN, WRONG_PROGRAM, WRONG_MARKET, UNAUTHORIZED, ROLE_CONFLICT, REVOKED, KEY_MISMATCH, BAD_SIGNATURE, EXPIRED, WRONG_EPOCH, WRONG_CONFIG, WRONG_ROSTER, WRONG_PHASE, REPLAY_CONFLICT, SEQUENCE_CONSUMED, SEQUENCE_GAP, STALE_CURSOR, CONFLICT, NOT_FOUND, CAPACITY, RETENTION_FULL, INSUFFICIENT_FREE, ACCOUNT_BINDING, HOST_CAPABILITY, HOST_TRANSFER, ARITHMETIC, EVIDENCE_BINDING, READINESS_BLOCKED. Feature errors extend a declared namespace; error names are proposed application codes, not changes to native result enums. A failure has no business effects. Native fee law can still charge for admitted failed execution; F10 must report actual fee receipts. Never claim host-error rollback if the real finalization path has not been qualified."
paragraph_003 = "Durable services record request bytes/digest and submitted native activity identity before transmission. On timeout they query existing finality/receipt paths and fixed state binding before retrying. No timeout means implicit refund, success or source of new authority. Finalized client cursors bind market, requested epoch, config, sealed root and finalized batch; a mutable-head query cannot claim historical immutability. Loss of offchain evidence does not erase onchain liabilities. Recovery must preserve canonical state bytes, authenticated program account balance, replay state, claim bits and sealed inputs."

[contract.C09]
title = "CROSS-FEATURE ACCEPTANCE OBLIGATIONS"
paragraph_001 = "A future real-path test must show context height63 accepts Work but64 rejects Work and admits Commit,79 accepts Commit,80 rejects Commit and admits Reveal,95 accepts Reveal,96 admits BeginAggregation. Context and record bindings must prevent another program/market/chain/epoch from replaying signatures. Two requests with the same actor sequence and different payload must leave second effects absent. A failed funded call must leave both ledger and real principal/derived balances unchanged except independently charged native fees. After a crash between settlement chunks, exactly the remaining workers are processed. For scores [10,20,30,100] the lower median is20; two votes produce no qualified score. Budget10 with equal positive scores on three ascendingIDs allocates4,3,3. Budget7 with scores1,2 allocates2,5."
paragraph_002 = "All-zero valid reports return the whole frozen budget Free. Claim at expiry-1 succeeds once; claim at expiry fails and later expiry release changes Liability toFree once. Pruning a live claim is refused. Key revocation before aggregation seal excludes the row; afterseal leaves sealed root unchanged. Exhausting native blob headroom must refuse without loss of authoritative state or transfer conservation."
paragraph_003 = "These are design acceptance cases, not current passes. Genuine future qualification must use real Programs host paths, native activity authorization, registered derived accounts, actual storage finalization and finality verification; do not use fake authority/balances or only a serializer-level test to claim integration success."

[contract.C10]
title = "BOUNDED OBJECT-LOCAL EXCEPTIONS AND DICTIONARIES"
paragraph_001 = "Task admission allows arbitrary authenticated requester principals without adding them to the role replay table. kind0 requester must equal invoking_principal; actor_sequence=0. task_id = H(PAXAI/task/v1, market_id32 || epoch:u64 || requester_principal32 || nonce32). The maximum64 task records of the current epoch retain the immutable admitted task body digest; sameID+samebody returns ALREADY_APPLIED, sameID+differentbody returns CONFLICT. Task IDs include epoch and cannot authorize another epoch after pruning. Request body must still bind chain/program/market and expiry through the common envelope."
paragraph_002 = "F01's fixed task record maximum233bytes gives14912bytes for64, leaving1472bytes of its16384section for current/next compact policy and lifecycle fields; if exact serializer exceeds this, reduce supported task cap at creation rather than overflow or omit authority checks. Historical task bodies live offchain, with only authenticated epoch roots retained."
paragraph_003 = "Advisory evaluator challenges likewise use bounded object-local IDs and actor_sequence=0, maximum8 current-epoch records. An arbitrary challenge cannot itself freeze settlement, revoke authority or invalidate an entitlement. Its record identifies immutable report/reason/evidence/requester; duplicate exact challenge is idempotent. Any consequential owner action must satisfy its own authority and pre-aggregation-seal cutoff."
paragraph_004 = "F06 uses a maximum256-entry payout dictionary of immutable (WorkerId32, recipientAccount32) pairs, with deterministic free-slot allocation and reference counts from retained epoch entitlements. A claim record uses dictionary index:u16, amount:u128, claimed_or_expired:u8 and required epoch metadata, rather than duplicating64 identitybytes1024times. Refcounts and dictionary slot re-use must prove no retained record points to replaced contents. A new payout identity that cannot fit returns CAPACITY before opening an epoch; it never overwrites a live referenced slot. This makes32*32 claims plus dictionary feasible inside81920bytes, subject to exact future serialization measurement."
paragraph_005 = "Zero entitlements may omit claim storage only if epoch result root still represents their zero result and duplicate claims deterministically return NOTHING_TO_CLAIM. Per-feature metadata can narrow but never enlarge the192KiB aggregate ceiling."

[contract.C11]
title = "OPERATOR AND WORST-CASE BYTE WORKSHEET"
paragraph_001 = "One optional Operator principal has only F01 metadata/suspend authority, kind0, with a bounded replay record in common control. Operator operation payloads bind operator_grant_version:u64; old-grant replay fails after revocation/replacement even if the same principal later returns. It never funds, evaluates, settles discretionarily or refunds. Grant sequence reset is permitted only with strictly increased checked grant version and explicit binding in every operator operation."
paragraph_002 = "The following are serialization budgets, not claims of measured future binaries. Current F01 design:64*233=14912bytes for task records, 1423 for current compactpolicy/lifecycle/Treasury/assessment-mode fields, total16335<=16384 with49bytes headroom. Identity hard allocation:worker currentrecord<=384 and frozenrecord176 gives32*560=17920; evaluator current<=384 and frozen152 gives8*536=4288; remaining2368 covers identity headers/references. Current score storage:8*(1380body+64signature+256commit/authoritymetadata)=13600, leaving10976within24576 for sealedinputs/digests/flags. F06 compact dictionary256*(64pair+2refs+1flag)=17152;32epochrecords*(174header+32*(2index+16amount+1status))=25024;1135control gives43311, below its narrow49152 reservation."
paragraph_003 = "Combined F05/F06 allocation81920 leaves32768 for F05cursor/output/currentsettlement beyond the narrow F06reservation. F07 current32*184=5888 plus32*92history=2944 plus256control=9088; its shared24576allocation leaves15488for F08. Common/evidence/control must fit24576including boundedrole replay,64task/evidencecompactreferences asneeded, dictionary bookkeeping andqueryroots. Features must publish their exact field layout and serialized-byte computation; future serializer gate rejects any inconsistency and does not omit required binding fields to meet a count. Large replacement churn reaches dictionary CAPACITY before overwriting references; throughput may stop safely. Section caps sum196608exactly and totalstate capincludes all framing/padding."

[contract.C12]
title = "OPCODE AND ERROR NAMESPACES; BOOTSTRAP"
paragraph_001 = "Operation is u16. 0x0000..0x00FF is common reserved space; 0x0000 is invalid. F01 owns0x0100..0x01FF, F02owns0x0200..0x02FF, F03owns0x0300..0x03FF, F04owns0x0400..0x04FF, F05owns0x0500..0x05FF, F06owns0x0600..0x06FF, F07owns0x0700..0x07FF, F08owns0x0800..0x08FF, F09owns0x0900..0x09FF, F10owns0x0A00..0x0AFF. Feature operation tables assign exact low bytes in their normative operation tables and structured operations records; the operation registry collates these without changing semantics. Unassigned or unknown operation refuses UNKNOWN_OPERATION; unknown application schema refuses BAD_VERSION. Service-only offchain envelopes are separately typed and cannot be submitted as native application operations merely because they use a nearby number."
paragraph_002 = "Result status is u16:0=OK,1=ALREADY_APPLIED,2=ERROR; other values refuse. Every result includes application_error:u16 immediately after status, zero for statuses0/1 and nonzero for status2. Failures have no business effects; C15 freezes their canonical body. Common application errors are frozen below; feature-specific errors occupy their feature's highbyte plus nonzero lowordinal. Native status codes remain separate and are never renumbered by this table."
paragraph_003 = "0001 BAD_VERSION"
paragraph_004 = "0002 NON_CANONICAL"
paragraph_005 = "0003 WRONG_DOMAIN"
paragraph_006 = "0004 WRONG_PROGRAM"
paragraph_007 = "0005 WRONG_MARKET"
paragraph_008 = "0006 UNAUTHORIZED"
paragraph_009 = "0007 ROLE_CONFLICT"
paragraph_010 = "0008 REVOKED"
paragraph_011 = "0009 KEY_MISMATCH"
paragraph_012 = "000a BAD_SIGNATURE"
paragraph_013 = "000b EXPIRED"
paragraph_014 = "000c WRONG_EPOCH"
paragraph_015 = "000d WRONG_CONFIG"
paragraph_016 = "000e WRONG_ROSTER"
paragraph_017 = "000f WRONG_PHASE"
paragraph_018 = "0010 REPLAY_CONFLICT"
paragraph_019 = "0011 SEQUENCE_CONSUMED"
paragraph_020 = "0012 SEQUENCE_GAP"
paragraph_021 = "0013 STALE_CURSOR"
paragraph_022 = "0014 CONFLICT"
paragraph_023 = "0015 NOT_FOUND"
paragraph_024 = "0016 CAPACITY"
paragraph_025 = "0017 RETENTION_FULL"
paragraph_026 = "0018 INSUFFICIENT_FREE"
paragraph_027 = "0019 ACCOUNT_BINDING"
paragraph_028 = "001a HOST_CAPABILITY"
paragraph_029 = "001b HOST_TRANSFER"
paragraph_030 = "001c ARITHMETIC"
paragraph_031 = "001d EVIDENCE_BINDING"
paragraph_032 = "001e READINESS_BLOCKED"
paragraph_033 = "001f UNKNOWN_OPERATION"
paragraph_034 = "Before any epoch has opened, initial membership/grant/key records may declare effective_epoch0. Once any epoch has opened, newly granted or rotated records target a strictly future roster snapshot, never retroactively enter current work. Epoch opening itself freezes them. Noinitializationpermission permits backdatingcommit/reveal windows."

[contract.C13]
title = "NATIVE REPLAY WITNESS CAPACITY QUALIFIER"
paragraph_001 = "The two-new-blob bound applies only to the PAXAI shared namespace value and its manifest. It is NOT a total native-activity bound. Existing native replay capture, when present, additionally stores a witness content blob and an activity-keyed native KV record. A normal mutation with replay capture can therefore require three new blobs (two namespace plus one replay witness), within the unchanged four-new-blob activity ceiling, plus the native replay KV record. Additional native effects must be budgeted separately and cannot be assumed free. Witness blobs remain reachable through their replay KV records."
paragraph_002 = "Both committed blob512/64MiB capacity and native module KV512 growth can exhaust even when the application retains only one shared key. ai.T-C04/storage-lifecycle prerequisites must include authenticated replay-record/witness retention, proof archive, deterministic cleanup and headroom accounting. Do not disable replay capture, discard witnesses or relax retention merely to keep the application operating. The application state bound remains196608bytes."

[contract.C14]
title = "READ-ONLY DISCOVERY EXCEPTION AND EXACT SELECTORS"
paragraph_001 = "READ_HEADER uses operation0x0A01; READ_STATE_CHUNK uses0x0A02. These two selectors are noncommitting application reads carried by the existing ProgramRead path. They require kind0 authenticated invoking principal, actor_sequence0 and epoch0/config_version0/roster_hash all-zero as discovery selectors. This is an explicit exception to C03's mutation binding/sequence rules only. Chain domain, executing program, market ID, schema, request ID and the ordinary strict expiry_height check remain mandatory. Current policy controls reader visibility. Kind1, mutations, event emission, transfers, state/replay-record writes and new application blobs are prohibited in these reads. Returned actual bindings never inherit the zero selector values."
paragraph_002 = "The outer ProgramRead expected native root and independently verified finality govern publication; the inner digest does not replace them."
paragraph_003 = "READ_HEADER has an empty payload. Its canonical result payload is schema_version:u16=1; actual_state_revision:u64; actual_state_digest32; total_bytes:u32; chain_domain32; program_id32; market_id32; epoch_present:bool and epoch:u64 only when present; config_version:u64; roster_present:bool and roster_hash32 only when present. Maximum192bytes. The actual_state_digest is H(PAXAI/view-state/v1, exact common serialized state bytes), identical to F10. Before any epoch opens epoch_present=false; opened epoch0 is present with value0, never absence. The roster absence is explicit. A missing market returns NOT_FOUND, not an empty state."
paragraph_004 = "READ_STATE_CHUNK has the exact46byte payload defined in F10: expected_state_revision:u64, expected_state_digest32, offset:u32, requested_bytes:u16. Discovery revision0/digestzero are permitted together only. The result payload is schema_version:u16=1; actual_state_revision:u64; actual_state_digest32; total_bytes:u32; offset:u32; chunk_bytes:u16; exactly chunk_bytes data. F10's 8192byte chunk ceiling, alignment, state-end and same-root24chunk capture rules apply. Neither read increments state_revision. All responses remain inside the common16384byte result limit."
paragraph_005 = "The operation registry maps the remaining feature operations to unique fixed selectors. Unknown selectors return UNKNOWN_OPERATION. Named offchain service operations are not ProgramCall opcodes unless separately registered as onchain operations."

[contract.C15]
title = "CANONICAL APPLICATION FAILURE RESULT"
paragraph_001 = "All results use the uniform C08 header with application_error immediately after status. Status0 OK and1 ALREADY_APPLIED require application_error0. Status2 ERROR requires a known nonzero common or feature error code, payload_length0 and no payload bytes in v1. A feature-specific error name maps through its fixed feature error namespace; it never renumbers a native error. For ERROR, result_digest = H(PAXAI/error/v1, application_error:u16 || request_digest32). request_digest is the normal C03 digest if the request envelope was validated; before canonical envelope validation it is exactly zero, an explicit absence representation limited to error responses. Unauthorized or predecode failures use state_revision0 to avoid exposing private state; otherwise return the unchanged visible current revision."
paragraph_002 = "No error changes application actor sequence, business state, transfer, event or semantic result cursor. Existing native admission/execution/fee/refusal laws and transport errors remain distinct and must be reported truthfully; a host failure without an application response is not invented as this byte string. Maximum total result16384 includes82headerbytes, leaving16302payloadbytes for successful results."

[contract.C16]
title = "IMMUTABLE OPTIONAL TREASURY AUTHORITY"
paragraph_001 = "CREATE and MarketHeader contain treasury_present:u8 followed by treasury_principal32 only if present, immediately after refund_recipient_account32 in their authority layout. treasury_present is0or1; default0 means Owner-only funding. Present principal must be nonzero and differ from Owner. This binding is immutable for applicationv1: no designation, rotation, replacement or ownership-transfer operation exists. Funding policy version is fixed1. FUND may be invoked in kind0 only by Owner or that exact present Treasury; neither can alter the immutable refund recipient. The33byte maximum belongs to F01's16384byte policy/lifecycle section and must be counted with the one-byte assessment_mode policy field. No F06 shadow authority or caller-supplied Treasury is accepted."
paragraph_002 = "A future change requires an explicitly versioned application/migration contract."

[contract.C17]
title = "SHARED STATE AND EVENT BINARY FRAMING"
paragraph_001 = "The version1 shared-state header is ASCII PAXAS1 at offset0 for6bytes, schema_version:u16=1 at offset6, and nonzero state_revision:u64 at offset8. Six sections follow in the C11 order starting at offset16. Each section has index:u16=1..6 in exact order, reserved:u16=0, payload_length:u32, then exactly that many feature-owned canonical payload bytes. All integers are big endian and no padding is permitted. The next section starts at previous_start+8+previous_payload_length. Missing, duplicate, unknown or reordered sections, invalid reserved/schema/revision fields, truncated or trailing bytes and checked arithmetic overflow refuse."
paragraph_002 = "Each section allocation includes its own8-byte container header; section6 also charges the16-byte global header. Section allocations remain16384,24576,24576,81920,24576,24576bytes, with payload maxima16376,24568,24568,81912,24568,24552. Total wire length is16+sum(8+payload_length), minimum64 and maximum196608inclusive. Feature-internal lengths and framing remain inside their payload. The unchanged F01 design worksheet is16335bytes including its own4-byte length; its8-byte common container uses8of the worksheet49bytes of headroom, for16343chargedbytes, within16384. This allocation does not lower64-task capacity or claim measurement of the future full F01 serializer."
paragraph_003 = "Event topic is ASCII PAXAI/v1/ followed by the exact registered mutation operation name, maximum64bytes; reads and unknown operation names refuse. Event body is at most2048bytes. Common body is122bytes: schema:u16 at0, market32 at2, epoch:u64 at34, config:u64 at42, revision:u64 at50, request_digest32 at58 and result_digest32 at90. Required IDs/digests and config are nonzero. The common-only codec accepts exactly122bytes; a feature consumer must validate its exact additional suffix."
paragraph_004 = "CommitScore body is194bytes: common122, evaluator32 at122, commitment32 at154, accepted_height:u64 at186. RevealScore body is228bytes: common122, evaluator32 at122, report_digest32 at154, evidence_root32 at186, vector_count:u16 at218 and admitted_height:u64 at220. Evaluator and required digests are nonzero, vector_count is1..32, and truncated/trailing or noncanonical suffixes refuse. Native finalized receipt and batch bindings remain supplied by the existing native indexer path. Exact structured allocations are also recorded in wire.schema.json under x-paxai-binary-framing-v1."

[contract.C18]
title = "FROZEN VERSION1 ERROR ALLOCATIONS"
paragraph_001 = "operation-registry.json frozen_application_errors and frozen_error_aliases are the exact version1 numeric application error registry. Existing common, F03 and F06 codes remain unchanged. Remaining feature codes use their feature high byte and nonzero declaration ordinal, with explicit common aliases consuming no feature ordinal; operation-only supplementary declarations follow the normative catalog declarations. Unknown application error codes refuse. Numeric mappings never depend on Rust enum layout."
paragraph_002 = "Offchain error spaces remain independent from application and native status spaces. frozen_offchain_errors records each service declaration order with ordinal1first and0reserved. A service error is not a native application operation or status. The registry freezes names and values; it does not implement any service or feature handler."
