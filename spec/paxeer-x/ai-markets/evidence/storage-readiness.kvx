[blocked]
status = "BLOCKED"
verify_command = "python3 tools/paxeer-x/ai_evidence.py --selector storage-prerequisite-evidence"
verify_authority_env = "PAXAI_ADMISSION_RECORD and PAXAI_APPROVAL_RECORD set to the ai.P-WORKSPACE admission and approval records"
verify_exit_code = 1
verify_log = "private ops log wt/logs/ai.T-C04-verify-1.log"
verify_result = "REFUSE evidence validation failed stage=authority reason=git-head"
verify_meaning = "The workspace admission's pinned checkout HEAD no longer equals its base revision, so the validator stops before reading any selector record; no storage-prerequisite-evidence or storage-profile-admission selector record exists for it to read."
workspace_authority = "The validator reads PAXAI_ADMISSION_RECORD and PAXAI_APPROVAL_RECORD; the ai.P-WORKSPACE admission pins base ce269bfe23c1db984a8ae62ce13aa36c238ce2fd on branch px26/fm1/ai-workspace and its other_selector_records is empty."
needs_admission = "A re-pinned workspace admission on the current candidate whose other_selector_records carries both storage-prerequisite-evidence and storage-profile-admission entries (path and SHA-256 inside the private evidence directory)."
needs_selector_record = "An APPROVED paxai.selector-admission.v1 record for storage-prerequisite-evidence with task_id ai.T-C04, the workspace decision_id and approved_by, base_revision equal to the admission base, contract_version 1, native_caps equal to [fact.caps], namespace one-program-shared-key, finality_policy verified-authoritative-finality, and evidence entries for exactly ai.T-S01, ai.T-S02 and ai.T-S03."
needs_evidence_records = "One PASS paxai.selector-evidence.v1 record per producer with kind and task_id equal to the producer id, observed_at_unix not before the admission issuance, exit_code 0, a log copied into the private evidence directory at owner-only permissions pinned by SHA-256, and facts task_id, revision, command, exit_code, profile_sha256, native_caps and producer_rerun false with an attachment for profile_sha256."
needs_single_revision = "The validator binds every producer revision to the one admission base_revision; the producers ran at three different revisions (c8bad8e76, 3c6b645db, 0652584e8), none equal to the current base, so the admission must pin one candidate revision that the recorded producer evidence covers."
needs_profile = "One approved storage profile digest shared by all three producers and equal to the SHA-256 of the storage-profile-admission selector record, which must itself validate with its thirteen evidence items; ai.P-STORAGE-PROFILE has no approval, so no profile digest exists."
needs_private_logs = "Producer logs are currently group and world readable in a shared log directory; the validator requires owner-only files under the private evidence directory."
