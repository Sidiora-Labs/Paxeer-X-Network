compile_cmd = "cargo build --manifest-path programs/Cargo.toml -p layerx-programs-ai-market"
verify_cmd = "cargo test --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --test artifact_binding"
acceptance_case_ids = ["F09-A06", "F09-A18", "F09-A19", "F09-A20", "F09-A21", "F09-A23", "F09-A24", "F09-A25"]
qualification = "UNRUN"
canonical_task = "ai.F09-T02"
canonical_spec = "../../spec.kvx"
authority = "subordinate"

[implementation.F09-T03]
id = "F09-T03"
depends_on = ["F09-T01", "ADMITTED_TENANT_AUTHORITY", "REAL_KMS_CONFIGURATION"]
proposed_paths = ["platform/hosted/ai-artifacts/Cargo.toml", "platform/hosted/ai-artifacts/src/main.rs", "platform/hosted/ai-artifacts/src/store.rs", "platform/hosted/ai-artifacts/src/authority.rs", "platform/hosted/ai-artifacts/src/resolver.rs", "platform/hosted/ai-artifacts/src/crypto.rs", "platform/hosted/ai-artifacts/tests/artifact_service.rs"]
deliverable = "Real durable offchain publication/retrieval, purpose restrictions, authenticated encryption, authority and SSRF-safe resolver."
compile_cmd = "cargo build --manifest-path platform/hosted/ai-artifacts/Cargo.toml"
verify_cmd = "cargo test --manifest-path platform/hosted/ai-artifacts/Cargo.toml --test artifact_service"
acceptance_case_ids = ["F09-A07", "F09-A08", "F09-A09", "F09-A10", "F09-A11", "F09-A12", "F09-A13", "F09-A17"]
qualification = "UNRUN"
canonical_task = "ai.F09-T03"
canonical_spec = "../../spec.kvx"
authority = "subordinate"

[implementation.F09-T04]
id = "F09-T04"
