paths_status = "PROPOSED_NEW; shared dispatch requires exclusive owner assignment"
build_cmd = "cargo build --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --target wasm32-unknown-unknown --release"
verify_cmd = "cargo test --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --test f04_canonical"
qualification = "UNRUN"
acceptance_case_ids = ["F04-A03", "F04-A04", "F04-A05", "F04-A07", "F04-A10"]
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_cap_minutes = 30
canonical_task_authority = "../../spec.kvx"
admission = "Canonical task sections only"
contract = "F04-T01, dependencies commoncodec,F01,F03codec: add proposed src/commit_reveal/commitment.rs and tests/f04_canonical.rs implementing only exact F04 framing, commitment digest and report-binding verification against the common report codec. Deliver bounded typed values and cases A03,A04,A05,A07,A10; use fixtures covering the stated requirements. Proposed build: cargo build --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --target wasm32-unknown-unknown --release. Proposed single verify_cmd: cargo test --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --test f04_canonical. This test target must be created and must use actual SDK cryptographic functions/independently calculated mathematical vectors as appropriate; no host-fake shortcut. Its ability to run SDK host crypto on the selected test target is an explicit prerequisite, not an existing assurance."

