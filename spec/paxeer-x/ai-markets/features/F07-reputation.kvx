[meta]
id = "F07"
title = "Quality history, continuity and reputation"
schema_version = 1
status = "SPECIFICATION_ONLY"
mode = "SPEC"
implementation = "UNRUN"
build = "UNRUN"
test = "UNRUN"
runtime = "UNRUN"
deployment = "UNRUN"
qualification = "UNRUN"
canonical_spec = "../../spec.kvx"
task_authority = "Canonical task sections in ../../spec.kvx govern implementation order, ownership and gates."

[contract.00]
title = "Specification conventions"
paragraph_1 = "Version 1.0. Status: SPECIFICATION ONLY; implementation/build/runtime/qualification UNRUN."
paragraph_2 = "Normative interpretation: MUST and SHALL define acceptance requirements. Shared contracts/core.kvx and contracts/integration-map.kvx govern common types and execution boundaries. This feature defines the Paxeer market reputation policy."

[contract.01]
title = "Purpose, AI relevance, scope and exclusions"
paragraph_1 = "F07-R001. The application shall preserve a bounded history of admitted quality observations for one worker enrollment in one AI market. A buyer may compare quality under an identical pinned task policy, benchmark and model declaration; operators may distinguish sustained evaluated performance from a newly advertised worker. History records evaluator agreement and protocol evidence availability. It does not establish factual correctness, model execution, safety, intellectual-property ownership, unique personhood or economic entitlement."
paragraph_2 = "F07-R002. Version 1 computes an integer quality estimate, a count of qualifying observations in the current history segment, and an independent evidence-coverage indicator. It binds these to stable enrollment identity, task-policy version and model commitment. Operational-key rotation preserves the segment. A replacement enrollment, model change, policy change or explicit administrative reset starts a distinct segment. Existing funded claims survive every history change unchanged. The feature has no authority to mint, burn, seize, fine, automatically pay, adjust stake or alter consensus."
paragraph_3 = "F07-R003. Initial worker admission, liveness eviction, evaluator authorization and quality aggregation MUST NOT require F07. Version 1 scheduling and replacement do not consume quality as an automatic eligibility rule. A future explicitly versioned scheduling policy may use a finalized quality value only as a tie-breaker after its primary eligibility checks. Such a policy must still distinguish unobserved history from poor observed performance. No global worker ranking or cross-market history merge is provided."

[contract.02]
title = "Existing architecture and proposed integration"
paragraph_1 = "Paxeer integration surfaces: src/state/lxp_identity.c provides stable DID identity independent of primary signing key; src/modules/governance/lxp_governance_rotation.c verifies key-change consent and records DID-bound history; programs/crates/layerx-programs-runtime/src/abi/context.rs and programs/sdk/rust/src/context.rs expose authenticated ABI-v2 context including invoking principal, activity sequence and batch height; programs/crates/layerx-programs-runtime/src/host/storage.rs and src/storage/mod.rs within the same crate provide scoped Program storage; programs/crates/layerx-programs-market/src/lib.rs demonstrates principal/height consumption in a real application dispatch path. Deployment qualification is UNRUN."
paragraph_2 = "F07-R004. New reputation behavior belongs to the proposed programs/crates/layerx-programs-ai-market/src/reputation.rs within the common single market Program. It SHALL use the common shared state value at paxai/state/v1. It SHALL NOT introduce a native module ID, rewrite identity records, enlarge storage/ABI/proof namespaces, change chain finality or import independent monetary issuance. Owner/delegate authority remains the existing authenticated Program principal plus the common application records."
paragraph_3 = "F07-R005. The executing batch height is the existing authenticated Context field 5. It is not finalized during execution. On-chain transitions are deterministic against the current canonical execution state; off-chain public history is usable as finalized only after an existing Paxeer finality proof binds the resulting state/receipt. A caller-provided timestamp, head, worker assertion or cached projection cannot substitute for these boundaries."

[contract.03]
title = "Normative glossary, types and canonical bytes"
paragraph_1 = "All counts are unsigned fixed-width big-endian. Identifiers, digests and principals are exact 32 bytes. Unknown version/enums, nonzero reserved bytes, extra trailing bytes, out-of-range counts and noncanonical order refuse before mutation. SHA-256 domains are exact ASCII followed by one zero byte; no JSON serialization is hashed. Existing common signed-operation and state codecs govern envelopes."
paragraph_2 = "F07-R006. MarketId and WorkerId have their common definitions. WorkerId is stable for one enrollment and differs from owner principal, delegate key and mutable seat position. SegmentKey is the tuple (market_id32, worker_id32, config_version:u64, policy_digest32, model_digest32, reset_generation:u64). reset_generation starts 1 and changes only by an authorized reset or deterministic policy/model rollover at OpenEpoch. The model_digest equals the F01 frozen TaskPolicyV1.model_artifact_digest; policy_digest equals its task-policy digest. Configuration/benchmark changes create different immutable bindings; scores MUST NOT be averaged across SegmentKeys. Reset generation is F07-local and distinct from the common worker operating generation or key_version. Key rotation never increments this reset generation. At most one current segment per enrolled worker is stored. A historical segment can be reconstructed from finalized events, not silently resumed."
paragraph_3 = "F07-R007. ReputationCurrent wire field order is worker_id32; segment_digest32; owner_principal32; reset_generation:u64; quality_ppm:u32; qualifying_count:u32; coverage_ppm:u32; last_applied_epoch:u64; last_observed_epoch:u64; last_observed_height:u64; last_transition_height:u64; previous_segment_digest32; status:u8; flags:u8; reserved:u16=0. The record is 184 bytes. status=1 ACTIVE, 2 SUSPENDED, 3 RETIRED; other values refuse. flags bit 0 means quality observed, bit 1 means coverage available, bit 2 means last_applied_epoch is present, all other bits zero. quality_ppm and coverage_ppm range 0..1000000. qualifying_count saturates at 32 deliberately; epoch/generation/height counters never wrap. Epoch0 is valid; the observed flag distinguishes observed epoch0 from absence. last_observed_height must be nonzero when observed; absent observation requires both last_observed fields zero. Zero previous_segment_digest means first segment; other digests cannot be zero. Shared roster storage may deduplicate owner and worker references through a canonical stable index only if the complete reference resolves unambiguously to the same IDs."
paragraph_4 = "F07-R008. Segment digest is SHA256(PAXAI/reputation-segment/v1 followed by zero byte, then canonical SegmentKey fields). Retired/reset history is committed as PreviousSegmentDigest, the SHA256 digest under PAXAI/reputation-close/v1 of market32, worker32, old segment digest32, old reset_generation:u64, final quality:u32, final count:u32, final coverage:u32, last_applied_epoch:u64, closure_reason:u8 and prior previous_segment_digest32. A digest is an audit commitment, never an authority key or proof of model correctness. Plaintext evidence is absent from this feature."
paragraph_5 = "F07-R009. CompletedHistory is a ring of at most 32 records. Each record is epoch:u64; execution_height:u64; config_version:u64; epoch_result_digest32; current_reputation_root32; observed_workers:u8; total_workers:u8; covered_workers:u8; reserved:u8=0. Each is 92 bytes. observed_workers and covered_workers range0..total_workers, and total_workers ranges0..32. Reputation root hashes PAXAI/reputation-root/v1, zero byte, market32, epoch:u64, entry_count:u16 and all current records in ascending WorkerId byte order. Root includes status and flags. It does not include itself or CompletedHistory, avoiding recursive hashing. This is an application commitment in normal Program state, not a new native proof tree."

[contract.04]
title = "Roles, grants, revocation and binding"
paragraph_1 = "F07-R010. Anyone may relay the common epoch-completion operation; the Program computes history from its own sealed F05 result and canonical task state. Relay identity cannot choose a score. Worker delegates may read and request their own voluntary reset only through owner approval; they cannot write numerical history. Owner principal may authorize a reset of its worker to unobserved zero; cannot change owner, copy another record, lift a suspension or select arbitrary positive values. Market administrator means the common Market Owner principal; no new privileged native role exists. Market administrator may suspend/resume future history admission under F01 policy and reset with an enumerated reason and published commitment; cannot retroactively amend a completed epoch or confiscate rewards. Evaluators act only through F03/F04/F05. Indexers verify finalized receipts/state and cannot sign numerical overrides."
paragraph_2 = "F07-R011. Administrative operations bind common network/program/market/config/actor sequence/expiry/request ID plus worker_id, expected segment_digest, expected reset_generation, operation tag and reason. Reset-generation or segment mismatch refuses even if the same delegate key was once authorized. Native identity freeze and application revocation checks remain authoritative. An old alias, old signing key or later owner key cannot remove durable history by presenting a historical snapshot."

[contract.05]
title = "Operation contracts and failure effects"
paragraph_1 = "On-chain operation selectors are ResetHistory=0x0701, SuspendHistory=0x0702 and ResumeHistory=0x0703 under the common operation registry. ApplyCompletedEpoch is internal only and ReadHistory is off-chain only; neither receives an independent on-chain selector. Result status and error types remain separate from operation selectors."
paragraph_2 = "F07-R012. ApplyCompletedEpoch is an internal phase of the common terminal entitlement-seal transition, with no caller-supplied quality vector. Preconditions: F05 immutable result for exactly the current closing epoch exists; result/config/roster/task roots match common frozen state; F06 completion conditions permit epoch completion; all required input dimensions are bounded; every current record has either no applied epoch or an earlier applied epoch. Transition computes one update for each worker present in that epoch's frozen roster, including a missing-observation decay when applicable, computes history root, appends one CompletedHistory record aligned with the common retained-epoch ring and publishes the common epoch-completion receipt. F07 and the other completion writes SHALL commit atomically in the single state value. Idempotent duplicate of the same completion returns its existing receipt/root without a second update. A changed result digest for an already completed epoch returns EpochConflict. Out-of-order application returns EpochOrder. Failure leaves every history field, ring entry and economic record unchanged."
paragraph_3 = "F07-R013. ResetHistory request carries WorkerId, expected segment digest, expected reset_generation and reason enum OWNER_RESET=1, MODEL_CHANGED=2, POLICY_CHANGED=3, ADMIN_INTEGRITY=4. Preconditions: authorized owner or designated market administrator as applicable; no nonterminal opened epoch currently binds this worker's segment; current record exists; reset_generation checked addition succeeds. Transition commits old segment closure digest, increments reset_generation, binds the new current policy/model, sets quality/count/coverage and observation flags to zero, sets last-applied to the latest actually completed market epoch with its presence flag (or absent if none), and retains status/owner. It does not remove membership cooldowns, revocation, prior closure commitment, owner grouping or reward liabilities. Receipt HistoryReset carries old/new segment digests, reset_generation and reason; no private explanation text. Repeat exact operation is idempotent; changed payload under same RequestId refuses IdempotencyConflict."
paragraph_4 = "F07-R014. SuspendHistory payload order is worker_id32, expected_segment_digest32, expected_reset_generation:u64, reason:u8 with SECURITY=1, POLICY=2. ResumeHistory payload order is worker_id32, expected_segment_digest32, expected_reset_generation:u64, reason:u8=1 meaning ADMIN_RESUME. Both require kind0 common Market Owner authority and the common actor-sequence/expected-context checks; exact replay uses the common retained result digest. Both emit one HistoryStatus event with worker/segment/reset generation/new status/reason inside the common event envelope, never more than2048 bytes. Preconditions: common live admin authority and not already retired. It sets SUSPENDED prospectively; it cannot rewrite a sealed aggregation decision. At BeginAggregation a history_allowed bit is frozen per worker from its F07 status and retained with the shared seal metadata. Before that seal, SUSPENDED makes the bit false; after seal, a status change is prospective and cannot alter the bit. This affects only F07 numerical observation admission, never F03/F05 voting, F06 rewards or F08 membership. ResumeHistory sets ACTIVE prospectively, retains all scores/counters and cannot revive revoked delegate authority or expired membership. Suspension does not freeze historical decay or disappear on key rotation. Administrative state changes are receipts, not fines."
paragraph_5 = "F07-R015. ReadHistory is an external F10 gateway/indexer operation, not a guest finality oracle. Its request is MarketId32, WorkerId32, optional exact epoch:u64 and minimum_finalized_height:u64. It returns one finalized current record, optional completed ring entries in ascending epoch order, their common state proof, and verification status. A request for an evicted epoch returns HistoryOutsideRetention with the oldest retained epoch and optional archive locator separately. Archives cannot be promoted to current authority without proof. A current value beyond expiry returns STALE/UNOBSERVED for routing while preserving committed raw record. No client may silently replace a failed proof with last cached data. Typed errors also include NonCanonical, UnsupportedVersion, WrongDomain, Unauthorized, IdentityFrozen, SegmentMismatch, GenerationMismatch, UnknownWorker, EpochNotSealed, BindingMismatch, ResourceLimit, Overflow and FinalityUnavailable."

[contract.06]
title = "Lifecycle, boundaries and version changes"
paragraph_1 = "F07-R016. Enrollment creates ACTIVE unobserved history at the first applicable roster snapshot; initial quality0 means no positive evidence, not a failing benchmark. Rotation of primary owner key or operational delegate preserves WorkerId, segment, count, history and status. Replacing a seat with a different WorkerId never inherits any of them. Different owner principal cannot acquire positive history in v1 because ownership transfer is excluded. Leaving/retiring records closes the segment and preserves its digest through the bounded common retired state/event policy. Re-enrollment receives a distinct WorkerId and unobserved segment; prior finalized events remain attributable to the old enrollment."
paragraph_2 = "F07-R017. V1 has no abort operation and produces no aborted epoch status. Any reserved future abort label is unsupported/unreachable and MUST refuse as current input; it cannot generate a numerical update or fabricated history sample. CompletedHistory entries refer to successfully aggregated/terminalized epochs only and obey the shared ring retention rule; F07 never evicts a record whose corresponding F06 claims cannot be safely pruned. Common epochs have 128 executing batch heights: Work64, Commit16, Reveal16, Settle32. History changes numerically once during successful epoch completion, never on a query, heartbeat, score submit or retry. Late settlement blocks the next opening under common rules. Skipped wall-clock intervals or unopened epochs are not fabricated observations or repeated decay steps. Policy/model/config changes become effective through the next frozen roster. At OpenEpoch, if frozen config_version/task policy/model differs from a worker current SegmentKey, the same atomic opening transition closes its former segment using reason POLICY_CHANGED or MODEL_CHANGED, increments reset_generation with checked arithmetic and bootstraps the new segment before freezing it. No separate owner reset request is required for that deterministic rollover. Older inputs cannot cross that boundary. An explicit voluntary reset is allowed only when no nonterminal epoch binds the worker. Reserved algorithm version is fixed v1; any coefficient change requires a new policy/config binding and unobserved segment, not reinterpretation of existing records."

[contract.07]
title = "Independent deterministic mathematics and exact boundaries"
paragraph_1 = "F07-R018. Let U=1000000. For one sealed epoch and worker, let s be the F05 median_score_ppm and q the stored quality. A qualifying observation exists exactly when F05 marked result_status 1=SCORED_ZERO or 2=SCORED_POSITIVE with support_count>=3 under its quorum rule, its policy/model/task/worker bindings match the current segment, canonical ownership separation checks accepted the contributing evidence, and history_allowed was true at the aggregation seal. A QUALIFIED zero score is a real observation and differs from no score. For a qualifying observation the next quality is floor((7q+s)/8). Otherwise it is floor(63q/64). These coefficients are fixed v1 defaults; arithmetic is unsigned checked u64 and integer floor toward zero. Since q,s<=U, the largest numerator is8000000, with no float, sigmoid, pair matrix or stake weighting. Bootstrap q=0. No neutral or positive starting score is assigned."
paragraph_2 = "F07-R019. qualifying_count becomes min(32,old_count+1) for a qualifying observation and otherwise remains unchanged; an explicit reset starts0. The display confidence_ppm is min(U,qualifying_count*125000). This is evidence-count maturity, not a probability of truth; eight observations reach1000000 and further observations do not imply perfect correctness. Last-observed epoch/height change only on qualifying observations. Every applied roster epoch updates last_applied_epoch and last_transition_height, even when missing. Suspended/revoked workers follow the frozen history_allowed/epoch eligibility rule; if no qualifying observation remains, decay still occurs once. Workers not in that frozen roster are not numerically updated by that epoch."
paragraph_3 = "F07-R020. Coverage is independent from model quality. For one frozen worker let E be the number of distinct evaluator identities still eligible at BeginAggregation seal, and N be that worker's F05 support_count from explicit accepted scores. Sealed F03 eligibility is the denominator producer; F05 admitted contributions are the numerator producer. Require 0<=N<=E<=8. If E>0, coverage_ppm=floor(U*N/E), with coverage-available flag set. If E=0, N must be0, coverage_ppm=0 and flag cleared. An explicit zero vote counts toward N; an omitted worker entry does not. Coverage may be nonzero even when N<3 and quality is unobserved. The metric is labeled EVALUATOR_EVIDENCE_COVERAGE, not uptime, completed-task fraction or proof of AI execution. It objectively records accepted protocol assessments, not semantic truth. F08 heartbeats, endpoint reachability, worker-reported latency, signed usage, and off-chain task/evidence-manifest assertions do not enter it. V1 has no canonical task-completion availability metric because the guest stores only evidence commitments and cannot inspect external bundles. If a future operational-receipt producer is introduced, it requires a new explicit policy/version and cannot retroactively relabel this metric."
paragraph_4 = "F07-R021. Stale display threshold is 4096 authenticated executing heights after last_observed_height. For finalized read height H, quality is stale exactly when never observed or H-last_observed_height>=4096; H<last_observed_height is InvalidProof. A raw stored stale value may be displayed only with stale label and MUST NOT be used as a live scheduling signal. Expiry does not delete financial claims, permit missed epoch fabrication or run unbounded decay. Ties in any future permitted scheduling consumer use existing primary policy, then ascending WorkerId bytes as final deterministic tie; no owner privilege. Canonical record and ring ordering use byte order/epoch order respectively."

[contract.08]
title = "Replay, restart, concurrency, finality and ambiguity"
paragraph_1 = "F07-R022. One common state version and serialized Program execution determine ordering. Apply uses the actual current state plus frozen result; clients cannot race numerical writes. Re-executing an already completed activity resolves the same receipt and root. Crash before atomic state commit yields no history update; crash after commit but before response yields receipt reconciliation by original activity/RequestId. A client MUST NOT submit a new reset to resolve an uncertain prior reset. Generation/order checks prevent replay across restarts and configuration changes."
paragraph_2 = "F07-R023. F10 consumer persists last accepted finalized height, market state commitment and reputation root. A proof at a lower height cannot replace a newer accepted proof. Two different roots at the same purported finalized height are a finality/evidence conflict: stop projection updates and surface conflict, never choose by arrival order. A higher-height valid proof is required to advance a cached view. No rollback of numerical history is performed by an indexer. Observation-only unfinalized views may be shown separately with that explicit label, never routed into admission/rewards or a finalized reputation API."

[contract.09]
title = "Abuse, trust and privacy"
paragraph_1 = "F07-R024. Identity continuity prevents operational-key rotation from resetting history; it does not identify secretly common owners. F03 ownership grouping and no self-owner scoring apply equally to market administrators and their workers, with no exemption. Accepted tasks and score evidence bind stable owner/worker identity and original policy, so address rotation, duplicate TaskIds and a copied result cannot multiply observations. A new enrollment starts at zero and cannot import a prior positive score. Resets retain closure linkage and cannot lift suspension/cooldowns. Cross-policy/model comparisons are refused rather than advertising a universal reputation."
paragraph_2 = "F07-R025. Colluding evaluators can still agree on false quality. Quorum3 and the lower median are aggregate trust assumptions, not a proof that AI output is true. Coverage can fall because evaluator evidence is unavailable; interfaces must not mislabel it provider misconduct. This feature never automatically punishes or pays. Public records contain commitments, stable identity and coarse metrics only; no prompts, outputs, benchmark answers, customer data, secrets or opaque private reason strings. F09 authorizes access to original evidence. Model/data/service-license review remains separate from these history calculations."

[contract.10]
title = "Storage, resources and bounded work"
paragraph_1 = "F07-R026. F07 and F08 share a24576-byte budget inside the common196608-byte shared value. Maximum32 current reputation records require5888 bytes;32 CompletedHistory records require2944 bytes; feature header, ring cursor and bookkeeping reserve256 bytes. F07 therefore reserves at most9088 bytes, leaving15488 bytes for the F08 encoding under this joint budget. No persistent per-worker32-entry history matrix or per-task reputation blobs are allowed. Full histories beyond ring digests are reconstructible off-chain from normal finalized events and their proofs. The future layout task must measure the actual joint encoding and fail if over budget; these totals do not authorize F08 to omit required fields."
paragraph_2 = "F07-R027. Completion scans at most32 frozen workers and at most256 admitted evaluator/worker entries. It updates at most32 numerical records, hashes at most32 current records, rewrites the single shared value once and creates no additional application state value; the existing native finalizer may create the one content blob plus namespace-manifest blob specified by the common contract. No key-alias traversal, dynamic dense matrix, unbounded epoch catch-up or all-market query is permitted. Existing Program storage key256bytes/value1048576bytes are upper host bounds; the stricter196608-byte application value remains mandatory. Host fuel, native committed blob cap512, total blob allocation64MiB and max4 new blobs/activity remain unchanged. Any resource refusal rolls back all epoch/history/economic effects atomically."

[contract.11]
title = "Required producers, consumers and immutable contracts"
paragraph_1 = "F01 supplies immutable policy/model bindings and task policy; external task facts remain commitments unless a separate canonical producer is specified. F02 supplies owner principal, WorkerId, delegate-generation lifecycle and signed service commitments; none alone supplies quality. F03 supplies accepted evaluator evidence and ownership separation. F04 controls disclosure eligibility. F05 supplies sealed worker quality result, qualification status and input commitments, and MUST NOT read F07 to authorize its own result. F06 shares common epoch-completion atomicity and remains the sole funded entitlement authority; F07 values never change its mathematics. F08 owns seats/admission/liveness and is independent of F07 in v1. F09 defines artifact commitments/privacy. F10 publishes proof-bound values, stale labels and monotonic finalized snapshots."
paragraph_2 = "F07-R028. All producers SHALL agree on exact WorkerId, MarketId, epoch, config version, frozen roster digest, policy/model digests, task identifiers and result digest. Missing or conflicting bindings refuse; there is no loose match by endpoint, model display name, delegate key, owner alias or numeric seat. Numerical update shall execute only once per genuinely completed epoch; it shall not be separately callable to race completion or bypass F06."

[contract.12]
title = "Acceptance cases and future qualification"
paragraph_1 = "All acceptance cases require qualification; qualification is UNRUN. Future qualification uses actual Program execution/storage and real finalized proof verification; no separate fake state machine qualifies the boundary. Economic outcomes in every F07-only case are zero mint, zero burn, zero transfer and unchanged existing F06 claim commitments."
paragraph_2 = "F07-A01. New segment q0,count0 observes qualified s800000 in epoch7: q100000,count1,confidence125000,observed flag set. A second qualified800000 at epoch8 yields187500,count2,confidence250000. Operational-key rotation between7 and8 changes none of the carried values."
paragraph_3 = "F07-A02. q123457, qualified s765433 gives floor(1629632/8)=203704. With no qualifying score, q becomes floor(7777791/64)=121527 instead; a reported worker success alone cannot select the qualified branch."
paragraph_4 = "F07-A03. q800000 and qualified s0 yields700000,count increases. No eligible score yields787500,count unchanged. API labels zero-observed versus missing distinctly. All-zero q with missing input stays0 without overflow."
paragraph_5 = "F07-A04. q1000000,s1000000 stays1000000. Input1000001 refuses NonCanonical/score range before mutation. count31 becomes32; another qualifying epoch remains32,confidence1000000. Generation u64max reset refuses Overflow with byte-identical state."
paragraph_6 = "F07-A05. E6 eligible evaluators and N4 explicit accepted scores give coverage666666 regardless of score values. Three additional copies from the same evaluator cannot increase N. E8,N2 gives250000 coverage and insufficient quorum, so quality decays rather than observes. E0,N0 gives coverage unavailable; E0,N1 refuses BindingMismatch. A heartbeat or worker-signed success cannot change N or quality."
paragraph_7 = "F07-A06. Complete epoch12 once from q100000,s800000 yields187500. Identical retry leaves187500 and one ring append. Different result digest for12 refuses EpochConflict. Epoch11 arriving afterward refuses EpochOrder. An unopened interval of ten epochs produces no fabricated numerical updates."
paragraph_8 = "F07-A07. WorkerW uses keyK1, rotatesK2, retains segment and quality. Replacement WorkerV in the same seat starts unobserved0. A stale W evaluation naming the reused seat cannot contribute to V. Model digest change causes atomic segment closure/rollover at the next opening before accepting new-model observations; old-model score refuses BindingMismatch."
paragraph_9 = "F07-A08. Reset a suspended q900000,count8 segment with valid owner approval: new generation+1,q0,count0,suspended retained,old closure digest nonzero. Reset does not cancel existing rewards, grant revocation or cooldown. Worker delegate without owner authority receives Unauthorized. Previous generation replay receives GenerationMismatch."
paragraph_10 = "F07-A09. Last observed height10000: finalized14095 is fresh;14096 is stale; purported proof9999 refuses. A cached finalized15000 view cannot be replaced by proof14096. Different roots at finalized15000 halt projection and expose conflict; no last-writer-wins."
paragraph_11 = "F07-A10. One market-policy segment q600000 cannot be looked up as quality for another policy/model/market even with the same owner. A forged high-score administrative request cannot set numerical q. An owner evaluator for its own worker is inadmissible even when that owner administers the market."
paragraph_12 = "F07-A11.33rd worker refuses common capacity. Maximum32 current records plus32 history records fit F07<=9088bytes and F07/F08<=24576; full common state<=196608. When the common ring permits safe pruning on the33rd completed epoch, only the oldest complete summary is removed; current cumulative history continues. If an unexpired claim prevents pruning, RETENTION_FULL blocks new opening with no reputation mutation. A request for the evicted epoch returns HistoryOutsideRetention."
paragraph_13 = "F07-A12. Inject actual host storage/resource refusal during the common terminal entitlement-seal transition: no partial q/count/root/ring/F06 changes survive. Restart after committed completion but lost response recovers same receipt. History suspension before aggregation seal freezes history_allowed=false: F07 decays even if F05 produces a positive score, while F06 reward mathematics remain unchanged. Suspension after seal cannot rewrite that epoch and applies to a later seal. F03/F05 never read F07 for scoring eligibility."

[contract.13]
title = "Future implementation decomposition and gates"
task_authority = "Detailed implementation contracts are subordinate to canonical task sections in ../../spec.kvx."
qualification = "UNRUN"
paragraph_1 = "Implementation, build, runtime and deployment qualification are UNRUN. Proposed package layerx-programs-ai-market and the following test targets are new, not preexisting commands. Each task has one proposed build and one focused future verification, at most two task-scoped repair cycles,30minute cap; missing prerequisite yields UNRUN/BLOCKED, never fake qualification."
paragraph_2 = "F07-T01 after common state codec and F01/F02 IDs: add proposed programs/crates/layerx-programs-ai-market/src/reputation.rs, src/reputation_codec.rs and tests/reputation_vectors.rs; update proposed crate Cargo.toml only as necessary. Deliver exact184/92-byte records, segment/root domains, checked equations, zero/missing distinction, canonical ordering, maximum budget accounting and independent vectorsA01-A05/A10-A11. Proposed build: cargo build --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --target wasm32-unknown-unknown --release. Proposed verify: cargo test --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --test reputation_vectors. New workspace membership and real runtime harness must first be implemented by common tasks."
paragraph_3 = "F07-T02 after T01 plus F03/F04/F05/F06 completion integration and F08 lifecycle: add proposed src/reputation_transition.rs and tests/reputation_lifecycle.rs; touch proposed src/epoch.rs only for single completion integration. Deliver once-only updates, independent coverage counts, reset/suspension/rotation/retirement linkage, atomic epoch writes and typed failures. Proposed build: cargo build --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --target wasm32-unknown-unknown --release. Proposed verify: cargo test --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --test reputation_lifecycle. Tests exercise actual Program storage refusal/recovery and economic immutability forA06-A08/A12, not hand-simulated callbacks."
paragraph_4 = "F07-T03 after T02 and F10 finalized client: add proposed platform/hosted/indexer/src/ai_reputation.rs and platform/hosted/indexer/tests/ai_reputation_finality.rs in existing package layerx-indexer; integrate existing gateway public-read surface only via established proof verification. Deliver monotonic finalized projections, root equality checking, stale/unknown distinction and bounded ring/archive responses. Proposed build: cargo build --manifest-path platform/Cargo.toml -p layerx-indexer. Proposed verify: cargo test --manifest-path platform/Cargo.toml -p layerx-indexer --test ai_reputation_finality. The indexer package exists; this new test target and exact real verifier harness/deployment inputs are implementation prerequisites, andA09 must exercise valid/invalid actual proof objects."

[contract.14]
title = "Decisions, fixed defaults, prerequisites and release conditions"
paragraph_1 = "Fixed v1:32workers/8evaluators common limits, quorum3/lower median in F05, quality scale1000000, q bootstrap0, qualified update7/8 old plus1/8 current floored, no-observation decay63/64 floored per completed roster epoch only, count cap32, display maturity8 observations, staleness4096 executing heights,32 completed history records, single shared state, F07<=9088bytes jointF07/F08<=24576bytes, no automatic quality gating/rewards/fines, no cross-policy/model merge, no owner transfer or historical positive-score import. Coefficient changes require a fresh bound configuration/segment; administrators cannot hot-edit history."
paragraph_2 = "Prerequisites include measured joint state encoding; verified canonical score eligibility and evidence bindings; unambiguous F05 qualification and result root; actual epoch completion/F06 atomicity; existing native identity/authority integration; finalized gateway proof verification; permissioned evidence access and customer/model/data rights review. Continuous-operation release additionally requires the qualified native content-blob lifecycle prerequisite in contracts/integration-map.kvx; history-ring eviction is not physical content reclamation. Runtime cost, real proof availability, deployed behavior are not established by this specification. Release requires revision-bound actual runtime acceptance for all vectors, no-double-update/no-cross-segment contamination, actual maximum-state/fuel feasibility, reset/revocation/restart evidence, verified finalized monotonic projection and zero economic side effects. Implementation follows the canonical task list."

[requirement.F07-R001]
id = "F07-R001"
normative_text = "The application shall preserve a bounded history of admitted quality observations for one worker enrollment in one AI market. A buyer may compare quality under an identical pinned task policy, benchmark and model declaration; operators may distinguish sustained evaluated performance from a newly advertised worker. History records evaluator agreement and protocol evidence availability. It does not establish factual correctness, model execution, safety, intellectual-property ownership, unique personhood or economic entitlement."
normative = true
paragraph = "The application shall preserve a bounded history of admitted quality observations for one worker enrollment in one AI market. A buyer may compare quality under an identical pinned task policy, benchmark and model declaration; operators may distinguish sustained evaluated performance from a newly advertised worker. History records evaluator agreement and protocol evidence availability. It does not establish factual correctness, model execution, safety, intellectual-property ownership, unique personhood or economic entitlement."

[requirement.F07-R002]
id = "F07-R002"
normative_text = "Version 1 computes an integer quality estimate, a count of qualifying observations in the current history segment, and an independent evidence-coverage indicator. It binds these to stable enrollment identity, task-policy version and model commitment. Operational-key rotation preserves the segment. A replacement enrollment, model change, policy change or explicit administrative reset starts a distinct segment. Existing funded claims survive every history change unchanged. The feature has no authority to mint, burn, seize, fine, automatically pay, adjust stake or alter consensus."
normative = true
paragraph = "Version 1 computes an integer quality estimate, a count of qualifying observations in the current history segment, and an independent evidence-coverage indicator. It binds these to stable enrollment identity, task-policy version and model commitment. Operational-key rotation preserves the segment. A replacement enrollment, model change, policy change or explicit administrative reset starts a distinct segment. Existing funded claims survive every history change unchanged. The feature has no authority to mint, burn, seize, fine, automatically pay, adjust stake or alter consensus."

[requirement.F07-R003]
id = "F07-R003"
normative_text = "Initial worker admission, liveness eviction, evaluator authorization and quality aggregation MUST NOT require F07. Version 1 scheduling and replacement do not consume quality as an automatic eligibility rule. A future explicitly versioned scheduling policy may use a finalized quality value only as a tie-breaker after its primary eligibility checks. Such a policy must still distinguish unobserved history from poor observed performance. No global worker ranking or cross-market history merge is provided."
normative = true
paragraph = "Initial worker admission, liveness eviction, evaluator authorization and quality aggregation MUST NOT require F07. Version 1 scheduling and replacement do not consume quality as an automatic eligibility rule. A future explicitly versioned scheduling policy may use a finalized quality value only as a tie-breaker after its primary eligibility checks. Such a policy must still distinguish unobserved history from poor observed performance. No global worker ranking or cross-market history merge is provided."

[requirement.F07-R004]
id = "F07-R004"
normative_text = "New reputation behavior belongs to the proposed programs/crates/layerx-programs-ai-market/src/reputation.rs within the common single market Program. It SHALL use the common shared state value at paxai/state/v1. It SHALL NOT introduce a native module ID, rewrite identity records, enlarge storage/ABI/proof namespaces, change chain finality or import independent monetary issuance. Owner/delegate authority remains the existing authenticated Program principal plus the common application records."
normative = true
paragraph = "New reputation behavior belongs to the proposed programs/crates/layerx-programs-ai-market/src/reputation.rs within the common single market Program. It SHALL use the common shared state value at paxai/state/v1. It SHALL NOT introduce a native module ID, rewrite identity records, enlarge storage/ABI/proof namespaces, change chain finality or import independent monetary issuance. Owner/delegate authority remains the existing authenticated Program principal plus the common application records."

[requirement.F07-R005]
id = "F07-R005"
normative_text = "The executing batch height is the existing authenticated Context field 5. It is not finalized during execution. On-chain transitions are deterministic against the current canonical execution state; off-chain public history is usable as finalized only after an existing Paxeer finality proof binds the resulting state/receipt. A caller-provided timestamp, head, worker assertion or cached projection cannot substitute for these boundaries."
normative = true
paragraph = "The executing batch height is the existing authenticated Context field 5. It is not finalized during execution. On-chain transitions are deterministic against the current canonical execution state; off-chain public history is usable as finalized only after an existing Paxeer finality proof binds the resulting state/receipt. A caller-provided timestamp, head, worker assertion or cached projection cannot substitute for these boundaries."

[requirement.F07-R006]
id = "F07-R006"
normative_text = "MarketId and WorkerId have their common definitions. WorkerId is stable for one enrollment and differs from owner principal, delegate key and mutable seat position. SegmentKey is the tuple (market_id32, worker_id32, config_version:u64, policy_digest32, model_digest32, reset_generation:u64). reset_generation starts 1 and changes only by an authorized reset or deterministic policy/model rollover at OpenEpoch. The model_digest equals the F01 frozen TaskPolicyV1.model_artifact_digest; policy_digest equals its task-policy digest. Configuration/benchmark changes create different immutable bindings; scores MUST NOT be averaged across SegmentKeys. Reset generation is F07-local and distinct from the common worker operating generation or key_version. Key rotation never increments this reset generation. At most one current segment per enrolled worker is stored. A historical segment can be reconstructed from finalized events, not silently resumed."
normative = true
paragraph = "MarketId and WorkerId have their common definitions. WorkerId is stable for one enrollment and differs from owner principal, delegate key and mutable seat position. SegmentKey is the tuple (market_id32, worker_id32, config_version:u64, policy_digest32, model_digest32, reset_generation:u64). reset_generation starts 1 and changes only by an authorized reset or deterministic policy/model rollover at OpenEpoch. The model_digest equals the F01 frozen TaskPolicyV1.model_artifact_digest; policy_digest equals its task-policy digest. Configuration/benchmark changes create different immutable bindings; scores MUST NOT be averaged across SegmentKeys. Reset generation is F07-local and distinct from the common worker operating generation or key_version. Key rotation never increments this reset generation. At most one current segment per enrolled worker is stored. A historical segment can be reconstructed from finalized events, not silently resumed."

[requirement.F07-R007]
id = "F07-R007"
normative_text = "ReputationCurrent wire field order is worker_id32; segment_digest32; owner_principal32; reset_generation:u64; quality_ppm:u32; qualifying_count:u32; coverage_ppm:u32; last_applied_epoch:u64; last_observed_epoch:u64; last_observed_height:u64; last_transition_height:u64; previous_segment_digest32; status:u8; flags:u8; reserved:u16=0. The record is 184 bytes. status=1 ACTIVE, 2 SUSPENDED, 3 RETIRED; other values refuse. flags bit 0 means quality observed, bit 1 means coverage available, bit 2 means last_applied_epoch is present, all other bits zero. quality_ppm and coverage_ppm range 0..1000000. qualifying_count saturates at 32 deliberately; epoch/generation/height counters never wrap. Epoch0 is valid; the observed flag distinguishes observed epoch0 from absence. last_observed_height must be nonzero when observed; absent observation requires both last_observed fields zero. Zero previous_segment_digest means first segment; other digests cannot be zero. Shared roster storage may deduplicate owner and worker references through a canonical stable index only if the complete reference resolves unambiguously to the same IDs."
normative = true
paragraph = "ReputationCurrent wire field order is worker_id32; segment_digest32; owner_principal32; reset_generation:u64; quality_ppm:u32; qualifying_count:u32; coverage_ppm:u32; last_applied_epoch:u64; last_observed_epoch:u64; last_observed_height:u64; last_transition_height:u64; previous_segment_digest32; status:u8; flags:u8; reserved:u16=0. The record is 184 bytes. status=1 ACTIVE, 2 SUSPENDED, 3 RETIRED; other values refuse. flags bit 0 means quality observed, bit 1 means coverage available, bit 2 means last_applied_epoch is present, all other bits zero. quality_ppm and coverage_ppm range 0..1000000. qualifying_count saturates at 32 deliberately; epoch/generation/height counters never wrap. Epoch0 is valid; the observed flag distinguishes observed epoch0 from absence. last_observed_height must be nonzero when observed; absent observation requires both last_observed fields zero. Zero previous_segment_digest means first segment; other digests cannot be zero. Shared roster storage may deduplicate owner and worker references through a canonical stable index only if the complete reference resolves unambiguously to the same IDs."

[requirement.F07-R008]
id = "F07-R008"
normative_text = "Segment digest is SHA256(PAXAI/reputation-segment/v1 followed by zero byte, then canonical SegmentKey fields). Retired/reset history is committed as PreviousSegmentDigest, the SHA256 digest under PAXAI/reputation-close/v1 of market32, worker32, old segment digest32, old reset_generation:u64, final quality:u32, final count:u32, final coverage:u32, last_applied_epoch:u64, closure_reason:u8 and prior previous_segment_digest32. A digest is an audit commitment, never an authority key or proof of model correctness. Plaintext evidence is absent from this feature."
normative = true
paragraph = "Segment digest is SHA256(PAXAI/reputation-segment/v1 followed by zero byte, then canonical SegmentKey fields). Retired/reset history is committed as PreviousSegmentDigest, the SHA256 digest under PAXAI/reputation-close/v1 of market32, worker32, old segment digest32, old reset_generation:u64, final quality:u32, final count:u32, final coverage:u32, last_applied_epoch:u64, closure_reason:u8 and prior previous_segment_digest32. A digest is an audit commitment, never an authority key or proof of model correctness. Plaintext evidence is absent from this feature."

[requirement.F07-R009]
id = "F07-R009"
normative_text = "CompletedHistory is a ring of at most 32 records. Each record is epoch:u64; execution_height:u64; config_version:u64; epoch_result_digest32; current_reputation_root32; observed_workers:u8; total_workers:u8; covered_workers:u8; reserved:u8=0. Each is 92 bytes. observed_workers and covered_workers range0..total_workers, and total_workers ranges0..32. Reputation root hashes PAXAI/reputation-root/v1, zero byte, market32, epoch:u64, entry_count:u16 and all current records in ascending WorkerId byte order. Root includes status and flags. It does not include itself or CompletedHistory, avoiding recursive hashing. This is an application commitment in normal Program state, not a new native proof tree."
normative = true
paragraph = "CompletedHistory is a ring of at most 32 records. Each record is epoch:u64; execution_height:u64; config_version:u64; epoch_result_digest32; current_reputation_root32; observed_workers:u8; total_workers:u8; covered_workers:u8; reserved:u8=0. Each is 92 bytes. observed_workers and covered_workers range0..total_workers, and total_workers ranges0..32. Reputation root hashes PAXAI/reputation-root/v1, zero byte, market32, epoch:u64, entry_count:u16 and all current records in ascending WorkerId byte order. Root includes status and flags. It does not include itself or CompletedHistory, avoiding recursive hashing. This is an application commitment in normal Program state, not a new native proof tree."

[requirement.F07-R010]
id = "F07-R010"
normative_text = "Anyone may relay the common epoch-completion operation; the Program computes history from its own sealed F05 result and canonical task state. Relay identity cannot choose a score. Worker delegates may read and request their own voluntary reset only through owner approval; they cannot write numerical history. Owner principal may authorize a reset of its worker to unobserved zero; cannot change owner, copy another record, lift a suspension or select arbitrary positive values. Market administrator means the common Market Owner principal; no new privileged native role exists. Market administrator may suspend/resume future history admission under F01 policy and reset with an enumerated reason and published commitment; cannot retroactively amend a completed epoch or confiscate rewards. Evaluators act only through F03/F04/F05. Indexers verify finalized receipts/state and cannot sign numerical overrides."
normative = true
paragraph = "Anyone may relay the common epoch-completion operation; the Program computes history from its own sealed F05 result and canonical task state. Relay identity cannot choose a score. Worker delegates may read and request their own voluntary reset only through owner approval; they cannot write numerical history. Owner principal may authorize a reset of its worker to unobserved zero; cannot change owner, copy another record, lift a suspension or select arbitrary positive values. Market administrator means the common Market Owner principal; no new privileged native role exists. Market administrator may suspend/resume future history admission under F01 policy and reset with an enumerated reason and published commitment; cannot retroactively amend a completed epoch or confiscate rewards. Evaluators act only through F03/F04/F05. Indexers verify finalized receipts/state and cannot sign numerical overrides."

[requirement.F07-R011]
id = "F07-R011"
normative_text = "Administrative operations bind common network/program/market/config/actor sequence/expiry/request ID plus worker_id, expected segment_digest, expected reset_generation, operation tag and reason. Reset-generation or segment mismatch refuses even if the same delegate key was once authorized. Native identity freeze and application revocation checks remain authoritative. An old alias, old signing key or later owner key cannot remove durable history by presenting a historical snapshot."
normative = true
paragraph = "Administrative operations bind common network/program/market/config/actor sequence/expiry/request ID plus worker_id, expected segment_digest, expected reset_generation, operation tag and reason. Reset-generation or segment mismatch refuses even if the same delegate key was once authorized. Native identity freeze and application revocation checks remain authoritative. An old alias, old signing key or later owner key cannot remove durable history by presenting a historical snapshot."

[requirement.F07-R012]
id = "F07-R012"
normative_text = "ApplyCompletedEpoch is an internal phase of the common terminal entitlement-seal transition, with no caller-supplied quality vector. Preconditions: F05 immutable result for exactly the current closing epoch exists; result/config/roster/task roots match common frozen state; F06 completion conditions permit epoch completion; all required input dimensions are bounded; every current record has either no applied epoch or an earlier applied epoch. Transition computes one update for each worker present in that epoch's frozen roster, including a missing-observation decay when applicable, computes history root, appends one CompletedHistory record aligned with the common retained-epoch ring and publishes the common epoch-completion receipt. F07 and the other completion writes SHALL commit atomically in the single state value. Idempotent duplicate of the same completion returns its existing receipt/root without a second update. A changed result digest for an already completed epoch returns EpochConflict. Out-of-order application returns EpochOrder. Failure leaves every history field, ring entry and economic record unchanged."
normative = true
paragraph = "ApplyCompletedEpoch is an internal phase of the common terminal entitlement-seal transition, with no caller-supplied quality vector. Preconditions: F05 immutable result for exactly the current closing epoch exists; result/config/roster/task roots match common frozen state; F06 completion conditions permit epoch completion; all required input dimensions are bounded; every current record has either no applied epoch or an earlier applied epoch. Transition computes one update for each worker present in that epoch's frozen roster, including a missing-observation decay when applicable, computes history root, appends one CompletedHistory record aligned with the common retained-epoch ring and publishes the common epoch-completion receipt. F07 and the other completion writes SHALL commit atomically in the single state value. Idempotent duplicate of the same completion returns its existing receipt/root without a second update. A changed result digest for an already completed epoch returns EpochConflict. Out-of-order application returns EpochOrder. Failure leaves every history field, ring entry and economic record unchanged."

[requirement.F07-R013]
id = "F07-R013"
normative_text = "ResetHistory request carries WorkerId, expected segment digest, expected reset_generation and reason enum OWNER_RESET=1, MODEL_CHANGED=2, POLICY_CHANGED=3, ADMIN_INTEGRITY=4. Preconditions: authorized owner or designated market administrator as applicable; no nonterminal opened epoch currently binds this worker's segment; current record exists; reset_generation checked addition succeeds. Transition commits old segment closure digest, increments reset_generation, binds the new current policy/model, sets quality/count/coverage and observation flags to zero, sets last-applied to the latest actually completed market epoch with its presence flag (or absent if none), and retains status/owner. It does not remove membership cooldowns, revocation, prior closure commitment, owner grouping or reward liabilities. Receipt HistoryReset carries old/new segment digests, reset_generation and reason; no private explanation text. Repeat exact operation is idempotent; changed payload under same RequestId refuses IdempotencyConflict."
normative = true
paragraph = "ResetHistory request carries WorkerId, expected segment digest, expected reset_generation and reason enum OWNER_RESET=1, MODEL_CHANGED=2, POLICY_CHANGED=3, ADMIN_INTEGRITY=4. Preconditions: authorized owner or designated market administrator as applicable; no nonterminal opened epoch currently binds this worker's segment; current record exists; reset_generation checked addition succeeds. Transition commits old segment closure digest, increments reset_generation, binds the new current policy/model, sets quality/count/coverage and observation flags to zero, sets last-applied to the latest actually completed market epoch with its presence flag (or absent if none), and retains status/owner. It does not remove membership cooldowns, revocation, prior closure commitment, owner grouping or reward liabilities. Receipt HistoryReset carries old/new segment digests, reset_generation and reason; no private explanation text. Repeat exact operation is idempotent; changed payload under same RequestId refuses IdempotencyConflict."

[requirement.F07-R014]
id = "F07-R014"
normative_text = "SuspendHistory payload order is worker_id32, expected_segment_digest32, expected_reset_generation:u64, reason:u8 with SECURITY=1, POLICY=2. ResumeHistory payload order is worker_id32, expected_segment_digest32, expected_reset_generation:u64, reason:u8=1 meaning ADMIN_RESUME. Both require kind0 common Market Owner authority and the common actor-sequence/expected-context checks; exact replay uses the common retained result digest. Both emit one HistoryStatus event with worker/segment/reset generation/new status/reason inside the common event envelope, never more than2048 bytes. Preconditions: common live admin authority and not already retired. It sets SUSPENDED prospectively; it cannot rewrite a sealed aggregation decision. At BeginAggregation a history_allowed bit is frozen per worker from its F07 status and retained with the shared seal metadata. Before that seal, SUSPENDED makes the bit false; after seal, a status change is prospective and cannot alter the bit. This affects only F07 numerical observation admission, never F03/F05 voting, F06 rewards or F08 membership. ResumeHistory sets ACTIVE prospectively, retains all scores/counters and cannot revive revoked delegate authority or expired membership. Suspension does not freeze historical decay or disappear on key rotation. Administrative state changes are receipts, not fines."
normative = true
paragraph = "SuspendHistory payload order is worker_id32, expected_segment_digest32, expected_reset_generation:u64, reason:u8 with SECURITY=1, POLICY=2. ResumeHistory payload order is worker_id32, expected_segment_digest32, expected_reset_generation:u64, reason:u8=1 meaning ADMIN_RESUME. Both require kind0 common Market Owner authority and the common actor-sequence/expected-context checks; exact replay uses the common retained result digest. Both emit one HistoryStatus event with worker/segment/reset generation/new status/reason inside the common event envelope, never more than2048 bytes. Preconditions: common live admin authority and not already retired. It sets SUSPENDED prospectively; it cannot rewrite a sealed aggregation decision. At BeginAggregation a history_allowed bit is frozen per worker from its F07 status and retained with the shared seal metadata. Before that seal, SUSPENDED makes the bit false; after seal, a status change is prospective and cannot alter the bit. This affects only F07 numerical observation admission, never F03/F05 voting, F06 rewards or F08 membership. ResumeHistory sets ACTIVE prospectively, retains all scores/counters and cannot revive revoked delegate authority or expired membership. Suspension does not freeze historical decay or disappear on key rotation. Administrative state changes are receipts, not fines."

[requirement.F07-R015]
id = "F07-R015"
normative_text = "ReadHistory is an external F10 gateway/indexer operation, not a guest finality oracle. Its request is MarketId32, WorkerId32, optional exact epoch:u64 and minimum_finalized_height:u64. It returns one finalized current record, optional completed ring entries in ascending epoch order, their common state proof, and verification status. A request for an evicted epoch returns HistoryOutsideRetention with the oldest retained epoch and optional archive locator separately. Archives cannot be promoted to current authority without proof. A current value beyond expiry returns STALE/UNOBSERVED for routing while preserving committed raw record. No client may silently replace a failed proof with last cached data. Typed errors also include NonCanonical, UnsupportedVersion, WrongDomain, Unauthorized, IdentityFrozen, SegmentMismatch, GenerationMismatch, UnknownWorker, EpochNotSealed, BindingMismatch, ResourceLimit, Overflow and FinalityUnavailable."
normative = true
paragraph = "ReadHistory is an external F10 gateway/indexer operation, not a guest finality oracle. Its request is MarketId32, WorkerId32, optional exact epoch:u64 and minimum_finalized_height:u64. It returns one finalized current record, optional completed ring entries in ascending epoch order, their common state proof, and verification status. A request for an evicted epoch returns HistoryOutsideRetention with the oldest retained epoch and optional archive locator separately. Archives cannot be promoted to current authority without proof. A current value beyond expiry returns STALE/UNOBSERVED for routing while preserving committed raw record. No client may silently replace a failed proof with last cached data. Typed errors also include NonCanonical, UnsupportedVersion, WrongDomain, Unauthorized, IdentityFrozen, SegmentMismatch, GenerationMismatch, UnknownWorker, EpochNotSealed, BindingMismatch, ResourceLimit, Overflow and FinalityUnavailable."

[requirement.F07-R016]
id = "F07-R016"
normative_text = "Enrollment creates ACTIVE unobserved history at the first applicable roster snapshot; initial quality0 means no positive evidence, not a failing benchmark. Rotation of primary owner key or operational delegate preserves WorkerId, segment, count, history and status. Replacing a seat with a different WorkerId never inherits any of them. Different owner principal cannot acquire positive history in v1 because ownership transfer is excluded. Leaving/retiring records closes the segment and preserves its digest through the bounded common retired state/event policy. Re-enrollment receives a distinct WorkerId and unobserved segment; prior finalized events remain attributable to the old enrollment."
normative = true
paragraph = "Enrollment creates ACTIVE unobserved history at the first applicable roster snapshot; initial quality0 means no positive evidence, not a failing benchmark. Rotation of primary owner key or operational delegate preserves WorkerId, segment, count, history and status. Replacing a seat with a different WorkerId never inherits any of them. Different owner principal cannot acquire positive history in v1 because ownership transfer is excluded. Leaving/retiring records closes the segment and preserves its digest through the bounded common retired state/event policy. Re-enrollment receives a distinct WorkerId and unobserved segment; prior finalized events remain attributable to the old enrollment."

[requirement.F07-R017]
id = "F07-R017"
normative_text = "V1 has no abort operation and produces no aborted epoch status. Any reserved future abort label is unsupported/unreachable and MUST refuse as current input; it cannot generate a numerical update or fabricated history sample. CompletedHistory entries refer to successfully aggregated/terminalized epochs only and obey the shared ring retention rule; F07 never evicts a record whose corresponding F06 claims cannot be safely pruned. Common epochs have 128 executing batch heights: Work64, Commit16, Reveal16, Settle32. History changes numerically once during successful epoch completion, never on a query, heartbeat, score submit or retry. Late settlement blocks the next opening under common rules. Skipped wall-clock intervals or unopened epochs are not fabricated observations or repeated decay steps. Policy/model/config changes become effective through the next frozen roster. At OpenEpoch, if frozen config_version/task policy/model differs from a worker current SegmentKey, the same atomic opening transition closes its former segment using reason POLICY_CHANGED or MODEL_CHANGED, increments reset_generation with checked arithmetic and bootstraps the new segment before freezing it. No separate owner reset request is required for that deterministic rollover. Older inputs cannot cross that boundary. An explicit voluntary reset is allowed only when no nonterminal epoch binds the worker. Reserved algorithm version is fixed v1; any coefficient change requires a new policy/config binding and unobserved segment, not reinterpretation of existing records."
normative = true
paragraph = "V1 has no abort operation and produces no aborted epoch status. Any reserved future abort label is unsupported/unreachable and MUST refuse as current input; it cannot generate a numerical update or fabricated history sample. CompletedHistory entries refer to successfully aggregated/terminalized epochs only and obey the shared ring retention rule; F07 never evicts a record whose corresponding F06 claims cannot be safely pruned. Common epochs have 128 executing batch heights: Work64, Commit16, Reveal16, Settle32. History changes numerically once during successful epoch completion, never on a query, heartbeat, score submit or retry. Late settlement blocks the next opening under common rules. Skipped wall-clock intervals or unopened epochs are not fabricated observations or repeated decay steps. Policy/model/config changes become effective through the next frozen roster. At OpenEpoch, if frozen config_version/task policy/model differs from a worker current SegmentKey, the same atomic opening transition closes its former segment using reason POLICY_CHANGED or MODEL_CHANGED, increments reset_generation with checked arithmetic and bootstraps the new segment before freezing it. No separate owner reset request is required for that deterministic rollover. Older inputs cannot cross that boundary. An explicit voluntary reset is allowed only when no nonterminal epoch binds the worker. Reserved algorithm version is fixed v1; any coefficient change requires a new policy/config binding and unobserved segment, not reinterpretation of existing records."

[requirement.F07-R018]
id = "F07-R018"
normative_text = "Let U=1000000. For one sealed epoch and worker, let s be the F05 median_score_ppm and q the stored quality. A qualifying observation exists exactly when F05 marked result_status 1=SCORED_ZERO or 2=SCORED_POSITIVE with support_count>=3 under its quorum rule, its policy/model/task/worker bindings match the current segment, canonical ownership separation checks accepted the contributing evidence, and history_allowed was true at the aggregation seal. A QUALIFIED zero score is a real observation and differs from no score. For a qualifying observation the next quality is floor((7q+s)/8). Otherwise it is floor(63q/64). These coefficients are fixed v1 defaults; arithmetic is unsigned checked u64 and integer floor toward zero. Since q,s<=U, the largest numerator is8000000, with no float, sigmoid, pair matrix or stake weighting. Bootstrap q=0. No neutral or positive starting score is assigned."
normative = true
paragraph = "Let U=1000000. For one sealed epoch and worker, let s be the F05 median_score_ppm and q the stored quality. A qualifying observation exists exactly when F05 marked result_status 1=SCORED_ZERO or 2=SCORED_POSITIVE with support_count>=3 under its quorum rule, its policy/model/task/worker bindings match the current segment, canonical ownership separation checks accepted the contributing evidence, and history_allowed was true at the aggregation seal. A QUALIFIED zero score is a real observation and differs from no score. For a qualifying observation the next quality is floor((7q+s)/8). Otherwise it is floor(63q/64). These coefficients are fixed v1 defaults; arithmetic is unsigned checked u64 and integer floor toward zero. Since q,s<=U, the largest numerator is8000000, with no float, sigmoid, pair matrix or stake weighting. Bootstrap q=0. No neutral or positive starting score is assigned."

[requirement.F07-R019]
id = "F07-R019"
normative_text = "qualifying_count becomes min(32,old_count+1) for a qualifying observation and otherwise remains unchanged; an explicit reset starts0. The display confidence_ppm is min(U,qualifying_count*125000). This is evidence-count maturity, not a probability of truth; eight observations reach1000000 and further observations do not imply perfect correctness. Last-observed epoch/height change only on qualifying observations. Every applied roster epoch updates last_applied_epoch and last_transition_height, even when missing. Suspended/revoked workers follow the frozen history_allowed/epoch eligibility rule; if no qualifying observation remains, decay still occurs once. Workers not in that frozen roster are not numerically updated by that epoch."
normative = true
paragraph = "qualifying_count becomes min(32,old_count+1) for a qualifying observation and otherwise remains unchanged; an explicit reset starts0. The display confidence_ppm is min(U,qualifying_count*125000). This is evidence-count maturity, not a probability of truth; eight observations reach1000000 and further observations do not imply perfect correctness. Last-observed epoch/height change only on qualifying observations. Every applied roster epoch updates last_applied_epoch and last_transition_height, even when missing. Suspended/revoked workers follow the frozen history_allowed/epoch eligibility rule; if no qualifying observation remains, decay still occurs once. Workers not in that frozen roster are not numerically updated by that epoch."

[requirement.F07-R020]
id = "F07-R020"
normative_text = "Coverage is independent from model quality. For one frozen worker let E be the number of distinct evaluator identities still eligible at BeginAggregation seal, and N be that worker's F05 support_count from explicit accepted scores. Sealed F03 eligibility is the denominator producer; F05 admitted contributions are the numerator producer. Require 0<=N<=E<=8. If E>0, coverage_ppm=floor(U*N/E), with coverage-available flag set. If E=0, N must be0, coverage_ppm=0 and flag cleared. An explicit zero vote counts toward N; an omitted worker entry does not. Coverage may be nonzero even when N<3 and quality is unobserved. The metric is labeled EVALUATOR_EVIDENCE_COVERAGE, not uptime, completed-task fraction or proof of AI execution. It objectively records accepted protocol assessments, not semantic truth. F08 heartbeats, endpoint reachability, worker-reported latency, signed usage, and off-chain task/evidence-manifest assertions do not enter it. V1 has no canonical task-completion availability metric because the guest stores only evidence commitments and cannot inspect external bundles. If a future operational-receipt producer is introduced, it requires a new explicit policy/version and cannot retroactively relabel this metric."
normative = true
paragraph = "Coverage is independent from model quality. For one frozen worker let E be the number of distinct evaluator identities still eligible at BeginAggregation seal, and N be that worker's F05 support_count from explicit accepted scores. Sealed F03 eligibility is the denominator producer; F05 admitted contributions are the numerator producer. Require 0<=N<=E<=8. If E>0, coverage_ppm=floor(U*N/E), with coverage-available flag set. If E=0, N must be0, coverage_ppm=0 and flag cleared. An explicit zero vote counts toward N; an omitted worker entry does not. Coverage may be nonzero even when N<3 and quality is unobserved. The metric is labeled EVALUATOR_EVIDENCE_COVERAGE, not uptime, completed-task fraction or proof of AI execution. It objectively records accepted protocol assessments, not semantic truth. F08 heartbeats, endpoint reachability, worker-reported latency, signed usage, and off-chain task/evidence-manifest assertions do not enter it. V1 has no canonical task-completion availability metric because the guest stores only evidence commitments and cannot inspect external bundles. If a future operational-receipt producer is introduced, it requires a new explicit policy/version and cannot retroactively relabel this metric."

[requirement.F07-R021]
id = "F07-R021"
normative_text = "Stale display threshold is 4096 authenticated executing heights after last_observed_height. For finalized read height H, quality is stale exactly when never observed or H-last_observed_height>=4096; H<last_observed_height is InvalidProof. A raw stored stale value may be displayed only with stale label and MUST NOT be used as a live scheduling signal. Expiry does not delete financial claims, permit missed epoch fabrication or run unbounded decay. Ties in any future permitted scheduling consumer use existing primary policy, then ascending WorkerId bytes as final deterministic tie; no owner privilege. Canonical record and ring ordering use byte order/epoch order respectively."
normative = true
paragraph = "Stale display threshold is 4096 authenticated executing heights after last_observed_height. For finalized read height H, quality is stale exactly when never observed or H-last_observed_height>=4096; H<last_observed_height is InvalidProof. A raw stored stale value may be displayed only with stale label and MUST NOT be used as a live scheduling signal. Expiry does not delete financial claims, permit missed epoch fabrication or run unbounded decay. Ties in any future permitted scheduling consumer use existing primary policy, then ascending WorkerId bytes as final deterministic tie; no owner privilege. Canonical record and ring ordering use byte order/epoch order respectively."

[requirement.F07-R022]
id = "F07-R022"
normative_text = "One common state version and serialized Program execution determine ordering. Apply uses the actual current state plus frozen result; clients cannot race numerical writes. Re-executing an already completed activity resolves the same receipt and root. Crash before atomic state commit yields no history update; crash after commit but before response yields receipt reconciliation by original activity/RequestId. A client MUST NOT submit a new reset to resolve an uncertain prior reset. Generation/order checks prevent replay across restarts and configuration changes."
normative = true
paragraph = "One common state version and serialized Program execution determine ordering. Apply uses the actual current state plus frozen result; clients cannot race numerical writes. Re-executing an already completed activity resolves the same receipt and root. Crash before atomic state commit yields no history update; crash after commit but before response yields receipt reconciliation by original activity/RequestId. A client MUST NOT submit a new reset to resolve an uncertain prior reset. Generation/order checks prevent replay across restarts and configuration changes."

[requirement.F07-R023]
id = "F07-R023"
normative_text = "F10 consumer persists last accepted finalized height, market state commitment and reputation root. A proof at a lower height cannot replace a newer accepted proof. Two different roots at the same purported finalized height are a finality/evidence conflict: stop projection updates and surface conflict, never choose by arrival order. A higher-height valid proof is required to advance a cached view. No rollback of numerical history is performed by an indexer. Observation-only unfinalized views may be shown separately with that explicit label, never routed into admission/rewards or a finalized reputation API."
normative = true
paragraph = "F10 consumer persists last accepted finalized height, market state commitment and reputation root. A proof at a lower height cannot replace a newer accepted proof. Two different roots at the same purported finalized height are a finality/evidence conflict: stop projection updates and surface conflict, never choose by arrival order. A higher-height valid proof is required to advance a cached view. No rollback of numerical history is performed by an indexer. Observation-only unfinalized views may be shown separately with that explicit label, never routed into admission/rewards or a finalized reputation API."

[requirement.F07-R024]
id = "F07-R024"
normative_text = "Identity continuity prevents operational-key rotation from resetting history; it does not identify secretly common owners. F03 ownership grouping and no self-owner scoring apply equally to market administrators and their workers, with no exemption. Accepted tasks and score evidence bind stable owner/worker identity and original policy, so address rotation, duplicate TaskIds and a copied result cannot multiply observations. A new enrollment starts at zero and cannot import a prior positive score. Resets retain closure linkage and cannot lift suspension/cooldowns. Cross-policy/model comparisons are refused rather than advertising a universal reputation."
normative = true
paragraph = "Identity continuity prevents operational-key rotation from resetting history; it does not identify secretly common owners. F03 ownership grouping and no self-owner scoring apply equally to market administrators and their workers, with no exemption. Accepted tasks and score evidence bind stable owner/worker identity and original policy, so address rotation, duplicate TaskIds and a copied result cannot multiply observations. A new enrollment starts at zero and cannot import a prior positive score. Resets retain closure linkage and cannot lift suspension/cooldowns. Cross-policy/model comparisons are refused rather than advertising a universal reputation."

[requirement.F07-R025]
id = "F07-R025"
normative_text = "Colluding evaluators can still agree on false quality. Quorum3 and the lower median are aggregate trust assumptions, not a proof that AI output is true. Coverage can fall because evaluator evidence is unavailable; interfaces must not mislabel it provider misconduct. This feature never automatically punishes or pays. Public records contain commitments, stable identity and coarse metrics only; no prompts, outputs, benchmark answers, customer data, secrets or opaque private reason strings. F09 authorizes access to original evidence. Model/data/service-license review remains separate from these history calculations."
normative = true
paragraph = "Colluding evaluators can still agree on false quality. Quorum3 and the lower median are aggregate trust assumptions, not a proof that AI output is true. Coverage can fall because evaluator evidence is unavailable; interfaces must not mislabel it provider misconduct. This feature never automatically punishes or pays. Public records contain commitments, stable identity and coarse metrics only; no prompts, outputs, benchmark answers, customer data, secrets or opaque private reason strings. F09 authorizes access to original evidence. Model/data/service-license review remains separate from these history calculations."

[requirement.F07-R026]
id = "F07-R026"
normative_text = "F07 and F08 share a24576-byte budget inside the common196608-byte shared value. Maximum32 current reputation records require5888 bytes;32 CompletedHistory records require2944 bytes; feature header, ring cursor and bookkeeping reserve256 bytes. F07 therefore reserves at most9088 bytes, leaving15488 bytes for the F08 encoding under this joint budget. No persistent per-worker32-entry history matrix or per-task reputation blobs are allowed. Full histories beyond ring digests are reconstructible off-chain from normal finalized events and their proofs. The future layout task must measure the actual joint encoding and fail if over budget; these totals do not authorize F08 to omit required fields."
normative = true
paragraph = "F07 and F08 share a24576-byte budget inside the common196608-byte shared value. Maximum32 current reputation records require5888 bytes;32 CompletedHistory records require2944 bytes; feature header, ring cursor and bookkeeping reserve256 bytes. F07 therefore reserves at most9088 bytes, leaving15488 bytes for the F08 encoding under this joint budget. No persistent per-worker32-entry history matrix or per-task reputation blobs are allowed. Full histories beyond ring digests are reconstructible off-chain from normal finalized events and their proofs. The future layout task must measure the actual joint encoding and fail if over budget; these totals do not authorize F08 to omit required fields."

[requirement.F07-R027]
id = "F07-R027"
normative_text = "Completion scans at most32 frozen workers and at most256 admitted evaluator/worker entries. It updates at most32 numerical records, hashes at most32 current records, rewrites the single shared value once and creates no additional application state value; the existing native finalizer may create the one content blob plus namespace-manifest blob specified by the common contract. No key-alias traversal, dynamic dense matrix, unbounded epoch catch-up or all-market query is permitted. Existing Program storage key256bytes/value1048576bytes are upper host bounds; the stricter196608-byte application value remains mandatory. Host fuel, native committed blob cap512, total blob allocation64MiB and max4 new blobs/activity remain unchanged. Any resource refusal rolls back all epoch/history/economic effects atomically."
normative = true
paragraph = "Completion scans at most32 frozen workers and at most256 admitted evaluator/worker entries. It updates at most32 numerical records, hashes at most32 current records, rewrites the single shared value once and creates no additional application state value; the existing native finalizer may create the one content blob plus namespace-manifest blob specified by the common contract. No key-alias traversal, dynamic dense matrix, unbounded epoch catch-up or all-market query is permitted. Existing Program storage key256bytes/value1048576bytes are upper host bounds; the stricter196608-byte application value remains mandatory. Host fuel, native committed blob cap512, total blob allocation64MiB and max4 new blobs/activity remain unchanged. Any resource refusal rolls back all epoch/history/economic effects atomically."

[requirement.F07-R028]
id = "F07-R028"
normative_text = "All producers SHALL agree on exact WorkerId, MarketId, epoch, config version, frozen roster digest, policy/model digests, task identifiers and result digest. Missing or conflicting bindings refuse; there is no loose match by endpoint, model display name, delegate key, owner alias or numeric seat. Numerical update shall execute only once per genuinely completed epoch; it shall not be separately callable to race completion or bypass F06."
normative = true
paragraph = "All producers SHALL agree on exact WorkerId, MarketId, epoch, config version, frozen roster digest, policy/model digests, task identifiers and result digest. Missing or conflicting bindings refuse; there is no loose match by endpoint, model display name, delegate key, owner alias or numeric seat. Numerical update shall execute only once per genuinely completed epoch; it shall not be separately callable to race completion or bypass F06."

