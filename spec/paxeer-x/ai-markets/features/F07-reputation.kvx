[metadata.version]
value = "1.0"

[metadata.dependencies]
value = ["contracts/core.kvx", "contracts/integration-map.kvx", "F01", "F02", "F03", "F04", "F05", "F06"]

[metadata.integration_dependencies]
value = ["F08 lifecycle (initial admission remains F07-independent)", "F10 shared finality projection primitives (not a whole-feature build cycle)"]

[metadata.defaults]
workers_max = 32
evaluators_max = 8
scale_ppm = 1000000
quorum = 3
quality_bootstrap = 0
qualified_update = "floor((7*q+s)/8)"
missing_update = "floor(63*q/64)"
count_cap = 32
confidence_maturity_observations = 8
stale_after_executing_heights = 4096
history_ring_max = 32
coverage = "floor(1000000*F05.support_count/sealed_eligible_evaluators), unavailable if denominator0"
application_state_bytes_max = 196608
F07_F08_section_bytes_max = 24576
F07_reserved_bytes_max = 9088
automatic_reward_fine_or_admission_influence = false

[metadata.qualification]
documentation_parse = "UNRUN"
build = "UNRUN"
test = "UNRUN"
runtime = "UNRUN"
deployment = "UNRUN"

[metadata.operation_selectors]
ResetHistory = "0x0701"
SuspendHistory = "0x0702"
ResumeHistory = "0x0703"

[metadata.non_selector_operations]
ApplyCompletedEpoch = "INTERNAL_ONLY"
ReadHistory = "OFFCHAIN_ONLY"

