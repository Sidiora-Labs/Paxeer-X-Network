[acceptance.F07-A11]
id = "F07-A11"
case = "33rd worker refuses common capacity. Maximum32 current records plus32 history records fit F07<=9088bytes and F07/F08<=24576; full common state<=196608. When the common ring permits safe pruning on the33rd completed epoch, only the oldest complete summary is removed; current cumulative history continues. If an unexpired claim prevents pruning, RETENTION_FULL blocks new opening with no reputation mutation. A request for the evicted epoch returns HistoryOutsideRetention."
qualification = "UNRUN"
paragraph = "33rd worker refuses common capacity. Maximum32 current records plus32 history records fit F07<=9088bytes and F07/F08<=24576; full common state<=196608. When the common ring permits safe pruning on the33rd completed epoch, only the oldest complete summary is removed; current cumulative history continues. If an unexpired claim prevents pruning, RETENTION_FULL blocks new opening with no reputation mutation. A request for the evicted epoch returns HistoryOutsideRetention."

