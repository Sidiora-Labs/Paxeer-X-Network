max_verify_runs_initial = 1
max_task_scoped_repair_cycles = 2
time_cap_minutes = 30
stop_condition = "Pass declared task gate with real-path evidence, or report exact blocker without weakening checks."
canonical_task = "ai.F06-T03"
canonical_spec = "../../spec.kvx"
authority = "subordinate"
paragraph = "depends on F06-T02, F05-T03 atomic finalization integration and T-C03 verified existing account/ABI integration: wire Fund/Claim/Refund to existing SDK deposits and program-account payments through the new application entrypoint and rewards.rs; create genuine native integration cases in new tests/rewards_native.rs using the repository's real execution harness selected by the integration map. Compile is the same guest build. Verify: cargo test --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --test rewards_native reward_conservation_authority_and_rollback -- --exact. Exact real harness linkage is a prerequisite to implementing this target; it must not be replaced with fake accounts or host functions."

