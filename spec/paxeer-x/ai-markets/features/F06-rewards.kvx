authority = "subordinate"
paragraph = "depends on F06-T01, F01 epoch primitives, F02 frozen-roster primitives and F05-T02 aggregation math/types: implement funding replay, reserve, frozen dictionary, atomic producer settlement, ledger invariants and close/expiry/prune state transitions in new src/rewards.rs; require A06/A07/A10/A11/A13/A14/A16. Same one compile command. Verify: cargo test --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --test rewards reward_state_transitions -- --exact. Do not merge a detached F05 settlement commit path."

[implementation.F06-T03]
id = "F06-T03"
dependencies = ["F06-T02", "F05-T03", "T-C03"]
proposed_new_paths = ["programs/crates/layerx-programs-ai-market/src/rewards.rs", "programs/crates/layerx-programs-ai-market/tests/rewards_native.rs"]
compile_cmd = "cargo build --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --target wasm32-unknown-unknown --release"
