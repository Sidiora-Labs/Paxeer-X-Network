[implementation.F06-T01]
id = "F06-T01"
dependencies = ["T-C01", "T-C02"]
proposed_new_paths = ["programs/crates/layerx-programs-ai-market/src/reward_math.rs", "programs/crates/layerx-programs-ai-market/src/rewards.rs", "programs/crates/layerx-programs-ai-market/tests/rewards.rs"]
compile_cmd = "cargo build --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --target wasm32-unknown-unknown --release"
verify_cmd = "cargo test --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --test rewards reward_math_and_encoding -- --exact"
qualification = "UNRUN"
test_targets_exist = false
implementation_first = true
max_builds = 1
max_verify_runs_initial = 1
max_task_scoped_repair_cycles = 2
time_cap_minutes = 30
stop_condition = "Pass declared task gate with real-path evidence, or report exact blocker without weakening checks."
