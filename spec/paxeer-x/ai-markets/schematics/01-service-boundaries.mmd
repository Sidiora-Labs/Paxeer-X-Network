  archive["Private native archive / storage keeper; candidate profile approval required"]
  customer --> sdk
  owner --> sdk
  sdk --> router
  router --> gateway
  gateway --> native
  customer -->|"authenticated service request; private payload separate"| worker
  receipts --> verifier
