[diagram.05]
title = "Conserved funded rewards"
file = "05-conserved-rewards.mmd"
purpose = "Track exact existing-asset deposits, reservation, largest-remainder allocation, fixed-recipient claims, lawful expiry, safe pruning and Free-only refunds."
status = "PROPOSED_UNRUN"
edge_semantics = "Solid monetary arrows are exact ledger movements with stated native transfer boundaries; dotted edges assert conservation or preserve a refused operation. Internal reserve and terminal seal are not independently selectable calls."
linked_contract_files = ["../contracts/core.kvx", "../contracts/integration-map.kvx", "../contracts/operation-registry.json"]
linked_feature_files = ["../features/F01-markets.kvx", "../features/F05-aggregation.kvx", "../features/F06-rewards.kvx", "../features/F08-admission.kvx"]
requirements = ["AI.F06-R01", "AI.F06-R02", "AI.F06-R06", "AI.F06-R08", "AI.F06-R09", "AI.F06-R10", "AI.F06-R11", "AI.F06-R13", "AI.F06-R14", "AI.F06-R15", "AI.F06-R16", "AI.F06-R19", "AI.F06-R20", "AI.F06-R21", "AI.F06-R22", "AI.F06-R25"]
acceptance_cases = ["F06-A01", "F06-A02", "F06-A04", "F06-A05", "F06-A06", "F06-A07", "F06-A08", "F06-A09", "F06-A10", "F06-A11", "F06-A12", "F06-A14", "F06-A16", "F06-A19"]
invariant_1 = "tracked_deposits = tracked_refunds + total_claimed + Free + Reserved + Liability after every success."
invariant_2 = "Proof-bound sight balance covers Free+Reserved+Liability; unexplained surplus is unaccounted."
invariant_3 = "One immutable asset/account/refund recipient and optional immutable creation-time Treasury; funding requires true irrevocable consent."
invariant_4 = "Positive weights allocate the entire frozen budget using checked u256 products and largest remainders; no owner/evaluator cut."
invariant_5 = "No positive score releases the whole budget to Free; no fallback reward."
invariant_6 = "Claims pay exactly one frozen recipient atomically before terminal_height+4096; expiry releases unpaid liability once."
invariant_7 = "No live dictionary reference or unsafe oldest claim record is overwritten to admit new work."
node_count = 19

