[node.05.reserved]
label = "Reserved R: one immutable prefunded epoch budget B"
purpose = "Reserved R: one immutable prefunded epoch budget B"

[node.05.math]
label = "q_i = floor of B*s_i/S using checked u256; r_i = B*s_i modulo S"
purpose = "q_i = floor of B*s_i/S using checked u256; r_i = B*s_i modulo S"

[node.05.residual]
label = "L = B - sum of q_i; largest remainders gain one; ties ascending WorkerId"
purpose = "L = B - sum of q_i; largest remainders gain one; ties ascending WorkerId"

[node.05.liability]
label = "Liability C: immutable allocation root and frozen recipient entitlements"
purpose = "Liability C: immutable allocation root and frozen recipient entitlements"

[node.05.claim]
label = "Permissionless single claim: positive amount, unclaimed, height before expiry"
purpose = "Permissionless single claim: positive amount, unclaimed, height before expiry"

[node.05.transfer]
label = "One exact ProgramSpend payment to frozen recipient; mark claimed in same commit"
purpose = "One exact ProgramSpend payment to frozen recipient; mark claimed in same commit"

[node.05.paid]
label = "total_claimed P"
purpose = "total_claimed P"

[node.05.expiry]
label = "At terminal_height+4096: unclaimed C moves to F once; no transfer"
purpose = "At terminal_height+4096: unclaimed C moves to F once; no transfer"

[node.05.refund]
label = "WindingDown: permissionless refund of Free only to immutable refund recipient"
purpose = "WindingDown: permissionless refund of Free only to immutable refund recipient"

[node.05.refunded]
label = "tracked_refunds X; monotonic refund cursor prevents duplicate payment"
purpose = "tracked_refunds X; monotonic refund cursor prevents duplicate payment"

[node.05.dictionary]
label = "256 immutable worker / recipient dictionary pairs; live references cannot be replaced"
purpose = "256 immutable worker / recipient dictionary pairs; live references cannot be replaced"

[node.05.retention]
label = "32 completed epochs; safe oldest pruning only; unsafe ring or dictionary blocks opening"
purpose = "32 completed epochs; safe oldest pruning only; unsafe ring or dictionary blocks opening"

[node.05.invariant]
label = "After success: tracked_deposits D = X + P + F + R + C; sight balance at least F+R+C"
purpose = "After success: tracked_deposits D = X + P + F + R + C; sight balance at least F+R+C"

[node.05.surplus]
label = "Unsolicited physical excess is unaccounted; never Free or spend authority"
purpose = "Unsolicited physical excess is unaccounted; never Free or spend authority"

[node.05.failure]
label = "Any host transfer / state / event refusal commits no business effects; native fees remain separate"
purpose = "Any host transfer / state / event refusal commits no business effects; native fees remain separate"

[node.05.score]
