[diagram.07]
title = "Native archive and authenticated retirement"
file = "07-storage-archive-retirement.mmd"
purpose = "Describe the candidate storage prerequisite, complete archives, independent archive attestations, current liveness checks, deterministic root-changing retirement and historical recovery."
status = "PROPOSED_UNRUN"
edge_semantics = "Solid arrows are proposal approval, durable archive, deterministic admission/cleanup and recovery dependencies. New root and immutable historical proof identities are shown as separate outputs."
linked_contract_files = ["../contracts/core.kvx", "../contracts/integration-map.kvx", "../contracts/storage-lifecycle.kvx"]
linked_feature_files = ["../features/F01-markets.kvx", "../features/F06-rewards.kvx", "../features/F09-artifacts.kvx", "../features/F10-views-sdk.kvx"]
requirements = ["AI.F01-R039", "AI.F06-R26", "AI.F09-R23", "AI.F10-R034"]
acceptance_cases = ["F06-A17", "F10-A13"]
invariant_1 = "Application 192KiB retention is independent from native 512 blob /64MiB /4 staged blob /512KV bounds."
invariant_2 = "Replay capture can add witness content and activity-keyed KV beyond the application value/manifest pair."
invariant_3 = "Candidate profile retires only proven obsolete PAXAI namespace versions and eligible replay record/witness pairs."
invariant_4 = "Two separately administered archive signatures follow exact durable inventory verification; signatures are an approved availability trust assumption."
invariant_5 = "All supported shared/principal heads, manifests, values, artifacts, replay and prepared transitions participate in current transitive liveness checks."
invariant_6 = "Unknown reference formats, current-root races, missing provenance/archive/reserve and full live pinned stores refuse atomically."
invariant_7 = "Actual native deletions change the canonical current root through deterministic native commit; original historical proofs remain valid against original archived roots."
invariant_8 = "Finite capacity with reserved terminal obligations remains the only advertised profile until continuous-operation approval and qualification."
node_count = 22

