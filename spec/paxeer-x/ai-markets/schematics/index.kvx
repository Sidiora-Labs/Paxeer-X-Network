purpose = "Atomic terminal result has positive total weight S?"

[diagram.06]
title = "Evidence privacy and finalized reads"
file = "06-evidence-privacy-finalized-reads.mmd"
purpose = "Keep encrypted content custody and revocable access separate from public commitments, then require coherent same-root state capture and independent finality before canonical views/events."
status = "PROPOSED_UNRUN"
edge_semantics = "Solid arrows identify ciphertext publication/retrieval, independently checked evidence and proof-gated projection. The dotted health path carries expiring observations only."
linked_contract_files = ["../contracts/core.kvx", "../contracts/integration-map.kvx", "../contracts/wire.schema.json"]
linked_feature_files = ["../features/F02-workers.kvx", "../features/F03-evaluators.kvx", "../features/F09-artifacts.kvx", "../features/F10-views-sdk.kvx"]
requirements = ["AI.F09-R01", "AI.F09-R11", "AI.F09-R15", "AI.F09-R17", "AI.F09-R18", "AI.F09-R19", "AI.F09-R21", "AI.F09-R22", "AI.F09-R27", "AI.F09-R28", "AI.F10-R008", "AI.F10-R014", "AI.F10-R015", "AI.F10-R019", "AI.F10-R020", "AI.F10-R021", "AI.F10-R025", "AI.F10-R029"]
acceptance_cases = ["F09-A09", "F09-A10", "F09-A11", "F09-A12", "F09-A20", "F09-A24", "F10-A01", "F10-A02", "F10-A05", "F10-A06", "F10-A11", "F10-A13", "F10-A14"]
invariant_1 = "Private public commitments identify randomized authenticated ciphertext, never an unsalted plaintext secret digest."
invariant_2 = "Current task-purpose-principal grants and revocations govern key release; old snapshot possession gives no access authority."
invariant_3 = "Evidence root, artifact manifest root, report digest and native root are distinct types and verification claims."
invariant_4 = "Read-only discovery selectors are kind0 with sequence0 and zero epoch/config/roster selectors; actual returned bindings remain exact."
invariant_5 = "Complete maximum state capture uses exactly 24 aligned 8192-byte chunks at one native root and state digest; heads cannot be joined."
invariant_6 = "Checkpoint rank at least4 for the same root/batch gates finalized publication; sequencer signature/depth/time alone cannot."
invariant_7 = "Snapshot rows, cursor and outbox commit together; private data never enters public views/events."
node_count = 23

