[meta]
name = "AI market supporting schematics"
status = "PROPOSED_SPECIFICATION"
implementation = "UNRUN"
runtime_qualification = "UNRUN"
continuous_operation = "BLOCKED"
canonical_spec = "../../spec.kvx"
canonical_authority = "Canonical requirements AI.<requirement> and tasks ai.<task ID> in spec.kvx govern behavior, admission, global waves and gates."
diagram_count = 8
diagram_validation = "Bounded text structural checks; parser only when an existing callable installation is available. No browser rendering validation is claimed."
verification_scope = "Documentation KVX syntax, linked contract existence, requirement/case identifiers and Mermaid text structure only; no product build or runtime test."
builds_allowed = 0
verify_runs_initial = 1
repair_cycles_max = 2
time_cap_minutes = 30
stop_condition = "Stop after the document check and report its exit/log; no task claims, product implementation, build, deployment or git action."

[diagram.01]
title = "Architectural service boundaries"
file = "01-service-boundaries.mmd"
purpose = "Separate deterministic market authority, native capabilities, AI service processes, private artifact custody, finalized projections and storage maintenance."
status = "PROPOSED_UNRUN"
edge_semantics = "Solid arrows are authenticated control, data or native effect paths; dotted arrows are display-only operational observations. Service process boxes do not allocate developer implementation tasks."
linked_contract_files = ["../contracts/core.kvx", "../contracts/integration-map.kvx", "../contracts/storage-lifecycle.kvx"]
linked_feature_files = ["../features/F01-markets.kvx", "../features/F02-workers.kvx", "../features/F03-evaluators.kvx", "../features/F06-rewards.kvx", "../features/F09-artifacts.kvx", "../features/F10-views-sdk.kvx"]
requirements = ["AI.F01-R001", "AI.F01-R004", "AI.F01-R005", "AI.F01-R006", "AI.F02-R004", "AI.F02-R017", "AI.F06-R03", "AI.F10-R003", "AI.F10-R031"]
acceptance_cases = ["F01-A01", "F02-A17", "F06-A08", "F09-A17", "F10-A02"]
invariant_1 = "One independently deployed market Program; deterministic code validates compact statements and conserves existing assets."
invariant_2 = "Host capabilities and application roles are independently required; direct application calls only."
invariant_3 = "No model execution, private artifact fetch, automatic truth adjudication or new native module occurs in the guest."
invariant_4 = "Existing owner consent and native activity framing remain authoritative."
node_count = 21

