[acceptance.storage]
contract = "../contracts/storage-lifecycle.kvx"
clauses = ["S14"]
archive = "Exact snapshot-root reconstruction, all needed replay proofs, corrupt/missing/conflicting bytes refusal, independently durable matching certificate inventories and restore with one archive unavailable."
retirement = "Shared and principal heads, dedup protection, paired replay retirement, unknown formats, root races, authority/profile/cutoff failures, bounded deletions, changed current root, preserved old proofs and untouched liabilities."
capacity = "No early credit for staged deletes, reads are not reservations, concurrent reserve admission, crash-safe request identity, full pinned-store refusal and terminal obligation reserve."
continuity = "More than512 distinct real native mutations, multiple checkpoints, archive/commit crashes, independent replica replay, historical proofs, balance proof consistency and one fixed-recipient claim after restart; all UNRUN."

