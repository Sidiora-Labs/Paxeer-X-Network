[diagram.02]
title = "Task lifecycle and epoch timing"
file = "02-task-and-epoch-lifecycle.mmd"
purpose = "Show onchain task admission, durable worker ACK, finalized acceptance before real dispatch, strict task deadline, explicit task-set sealing and the immutable epoch cadence."
status = "PROPOSED_UNRUN"
edge_semantics = "Solid arrows are prerequisite transitions or retained rights; labeled edges distinguish accepted work, requester cancellation, missed Work windows and delayed terminalization."
linked_contract_files = ["../contracts/core.kvx"]
linked_feature_files = ["../features/F01-markets.kvx", "../features/F02-workers.kvx", "../features/F05-aggregation.kvx", "../features/F06-rewards.kvx", "../features/F08-admission.kvx", "../features/F09-artifacts.kvx"]
requirements = ["AI.F01-R026", "AI.F01-R027", "AI.F01-R028", "AI.F01-R041", "AI.F01-R042", "AI.F01-R043", "AI.F01-R044", "AI.F01-R046", "AI.F02-R017", "AI.F02-R018", "AI.F02-R024", "AI.F05-R06", "AI.F06-R18"]
acceptance_cases = ["F01-A02", "F01-A05", "F01-A12", "F01-A13", "F01-A14", "F01-A15", "F01-A17", "F02-A17", "F05-A12", "F06-A13"]
invariant_1 = "Authenticated executing batch height controls Work [0,64), Commit [64,80), Reveal [80,96) and scheduled Settlement [96,128)."
invariant_2 = "External costly work waits for independently verified finalized task acceptance and exact ACK binding."
invariant_3 = "Task acceptance, cancellation and result commitment all stop at Work end and the task deadline."
invariant_4 = "F09 evidence sealing requires a prior explicit F01 task-set seal; it never seals another feature implicitly."
invariant_5 = "Suspension or graceful close preserves admitted work, ordinary commit/reveal, settlement and claims; v1 has no abort."
invariant_6 = "Delayed settlement blocks later opening; skipped unopened epochs produce no quality samples."
node_count = 25

[node.02.schedule]
label = "T = origin_height + 128 * epoch; checked u64 arithmetic"
purpose = "T = origin_height + 128 * epoch; checked u64 arithmetic"

