purpose = "Previous opened epoch terminal, if any?"

[diagram.03]
title = "Worker and evaluator authorization"
file = "03-participant-authorization.mmd"
purpose = "Distinguish native authentication, operational delegates, owner consent, finite membership permits, roster activation, rotation and different worker/evaluator revocation effects."
status = "PROPOSED_UNRUN"
edge_semantics = "Solid arrows carry separate native consent, delegated operational authority, finite nomination/admission transitions and frozen roster rights. They never imply one principal can impersonate the other party."
linked_contract_files = ["../contracts/core.kvx", "../contracts/operation-registry.json"]
linked_feature_files = ["../features/F01-markets.kvx", "../features/F02-workers.kvx", "../features/F03-evaluators.kvx", "../features/F08-admission.kvx"]
requirements = ["AI.F02-R010", "AI.F02-R011", "AI.F02-R012", "AI.F02-R015", "AI.F03-R08", "AI.F03-R09", "AI.F03-R10", "AI.F03-R11", "AI.F03-R12", "AI.F08-R009", "AI.F08-R010", "AI.F08-R015"]
acceptance_cases = ["F02-A01", "F02-A04", "F02-A18", "F02-A19", "F03-A07", "F03-A08", "F03-A09", "F03-A10", "F03-A16", "F08-A17", "F08-A18", "F08-A19"]
invariant_1 = "Worker nomination requires exact nominated worker-owner kind0 acceptance and registered delegate proof of possession."
invariant_2 = "Evaluator nomination remains PENDING until evaluator-owner kind0 F08 admission and registered delegate consent; the same record is activated only at snapshot."
invariant_3 = "Membership authority changes and funding/refunds do not use relayed delegate authentication."
invariant_4 = "Bootstrap membership may target epoch0 before any opening; later new admission targets checked clock_epoch+1."
invariant_5 = "Roster evaluator principal cannot equal a worker principal or Market Owner; undisclosed common control remains a limitation."
invariant_6 = "Worker revocation preserves completed task evidence and frozen claims; only evaluator revocation before aggregation seal excludes a row."
node_count = 26

