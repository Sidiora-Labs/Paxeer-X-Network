[diagram.04]
title = "Score commit, reveal and deterministic aggregation"
file = "04-score-commit-reveal-aggregation.mmd"
purpose = "Connect evidence sealing, exact signed reports, concealed commitments, bounded reveal admission, sealed evaluator eligibility, lower-median chunks and atomic economic terminalization."
status = "PROPOSED_UNRUN"
edge_semantics = "Solid arrows express ordered admission and deterministic computation. Branches explicitly separate insufficient quorum, observed zero and positive scores; the cursor loop is bounded by 32 workers."
linked_contract_files = ["../contracts/core.kvx", "../contracts/operation-registry.json", "../contracts/wire.schema.json"]
linked_feature_files = ["../features/F03-evaluators.kvx", "../features/F04-commit-reveal.kvx", "../features/F05-aggregation.kvx", "../features/F06-rewards.kvx", "../features/F07-reputation.kvx", "../features/F09-artifacts.kvx"]
requirements = ["AI.F04-R01", "AI.F04-R03", "AI.F04-R04", "AI.F04-R05", "AI.F04-R06", "AI.F04-R07", "AI.F04-R08", "AI.F04-R09", "AI.F05-R01", "AI.F05-R05", "AI.F05-R07", "AI.F05-R10", "AI.F09-R27", "AI.F09-R28"]
acceptance_cases = ["F04-A01", "F04-A02", "F04-A03", "F04-A05", "F04-A07", "F04-A09", "F04-A12", "F05-A02", "F05-A03", "F05-A13", "F05-A14", "F05-A16", "F09-A23", "F09-A25"]
invariant_1 = "Report signature and request-envelope signature bind distinct exact 32-byte domain-separated digests."
invariant_2 = "One immutable commitment and admitted report per evaluator/epoch; failed reveal consumes no row or application sequence."
invariant_3 = "Missing workers and unrevealed rows are no votes; an explicit zero is a valid observation."
invariant_4 = "Quorum is three distinct sealed eligible evaluator identities; lower median index is floor((n-1)/2)."
invariant_5 = "Each Process handles exactly min(8,remaining) consecutive frozen workers, once; maximum four chunks."
invariant_6 = "A complete cursor is provisional until aggregate, F06 ledger/entitlements, F07 history and terminal epoch commit together."
node_count = 24

