[shared_writer.CORE]
manager = "FM-CORE"
default_writer = "W-CORE-INTEGRATION"
paths = ["programs/Cargo.toml", "programs/crates/layerx-programs-ai-market/Cargo.toml", "programs/crates/layerx-programs-ai-market/src/lib.rs"]
rule = "Common codec/types/state/errors/dispatch/access/capability exact files are additionally bound by canonical T-C01/T-C02; FM-CORE assigns one active writer for each. Feature specialists submit typed integration requests; a shared writer completes them before the feature gate."
transfer = "Record exact path, prior/new named writer, canonical task, accepted revision/interface and reservation start/end. No simultaneous writer; no implicit transfer through a role or broad task path. Main integrator resolves conflicts before edits."

[shared_writer.STORAGE]
manager = "FM-STORAGE"
default_writer = "W-STORAGE-RETIREMENT"
paths = ["Makefile", "include/layerx/lxp_kernel.h", "include/layerx/lxp_module.h", "src/protocol/lxp_kernel.c", "src/protocol/lxp_module_ctx.c"]
rule = "FM-STORAGE reserves every overlapping native/archive/LNI file serially across T-S01..T-S04 and reconciles active repository owners before admission. Root Makefile changes register only the owning focused targets."
transfer = "Record exact path, prior/new named writer, canonical task, accepted revision/interface and reservation start/end. No simultaneous writer; no implicit transfer through a role or broad task path. Main integrator resolves conflicts before edits."

[shared_writer.SDK]
manager = "FM-F10"
default_writer = "W-F10-RUST-CLIENT"
paths = ["platform/sdk/schema/paxai-v1.kvx", "platform/sdk/generators/src/main.rs"]
rule = "The F10-T03 writer alone changes central schema/generator files within its canonical scope; other clients consume the accepted generated contract."
transfer = "Record exact path, prior/new named writer, canonical task, accepted revision/interface and reservation start/end. No simultaneous writer; no implicit transfer through a role or broad task path. Main integrator resolves conflicts before edits."

[shared_writer.PROJECTION]
manager = "FM-F10"
default_writer = "W-F10-PROJECTION"
paths = ["platform/hosted/indexer/src/store.rs", "platform/hosted/indexer/src/layerx.rs", "platform/hosted/gateway/src/lib.rs", "platform/hosted/gateway/src/public_reads.rs"]
rule = "F02 transport discovery and all projection consumers submit route/store integration requests to FM-F10. Canonical tasks must explicitly admit each shared path before its serial writer changes it."
transfer = "Record exact path, prior/new named writer, canonical task, accepted revision/interface and reservation start/end. No simultaneous writer; no implicit transfer through a role or broad task path. Main integrator resolves conflicts before edits."

[shared_writer.EPOCH]
manager = "FM-F01"
default_writer = "W-F01-EPOCH"
paths = ["programs/crates/layerx-programs-ai-market/src/epoch.rs"]
rule = "F07 lifecycle wiring uses an explicit FM-F01 to FM-F07 serial writer handoff after epoch opening; only the recorded active writer may edit epoch.rs."
transfer = "Record exact path, prior/new named writer, canonical task, accepted revision/interface and reservation start/end. No simultaneous writer; no implicit transfer through a role or broad task path. Main integrator resolves conflicts before edits."

[handoff.contract]
required_fields = ["task_id", "manager", "specialist", "canonical_task_ref", "exact_paths", "active_shared_writer", "dependency_evidence", "requirements_ref", "acceptance_ref", "deliverable", "revision", "command", "exit_code", "log_path", "blocker"]
consumer_rule = "A dependent manager accepts only the complete producer interfaces and authentic recorded evidence named by its canonical requires. A later unavailable producer stays explicit; no substitute implementation or fabricated result."
failure_rule = "Preserve assertions, bounds, types, tests and authority checks. Record unrelated failure once through the canonical qualification log writer. Escalate cross-task contradictions without rerunning or neighboring repair."
authority_rule = "Only the canonical task section may change scope, dependencies, paths or gates; MAIN-INTEGRATOR records an approved revision before affected work resumes."

