[meta]
name = "Paxeer AI markets roles and task responsibility"
status = "draft"
qualification = "UNRUN"
canonical_spec = "spec/paxeer-x/spec.kvx"
task_count = 55
gate_authority = "Every task scope, dependency, exact path, requirement, acceptance case, build and verify command is authoritative only in the canonical task section. This role map adds responsibility and handoff rules; it never substitutes a gate or broadens a task."
session_scope = "Each implementation task begins in a fresh task session with tool and file access scoped to its assigned Paxeer paths. Reconcile current ownership and owner changes before admitting edits."

[workflow]
hierarchy = ["MAIN-INTEGRATOR", "FM-F01 through FM-F10", "FM-CORE", "FM-STORAGE", "FM-OPERATIONS", "assigned implementation specialist"]
main_branch = "{main}"
feature_branch = "feature/{feature}"
worker_branch = "wave/{feature}/{wave}"
admission = "Main integrator admits only an authorized pending task whose canonical requires are done; manager records exact paths, named writer, session, deliverable and acceptance handoff before dispatch. Same-wave tasks may run concurrently only with disjoint effective ownership."
entry = "Canonical task eligible; manager assigned; approved interfaces and resources present; shared-file writer reservation recorded. All 55 assignments below begin pending and UNRUN."
implementation = "The assigned specialist writes the entire scoped implementation and specified real-path tests before format, build or verify. No neighboring repair or incomplete producer substitute."
qualification = "Use only the canonical task build and single verify_cmd, with at most two task-scoped repair cycles and 30-minute cap. Prerequisite/marker tasks consume their canonical control records; they do not add builds or rerun producer gates."
exit = "Task stays in_progress until its exact acceptance and declared qualification pass. A failed bounded task stops implemented-not-qualified with its blocker; no false completion. Publication follows the repository workflow only within explicit task authorization."
handoff = "Specialist hands exact changed paths, typed interfaces, immutable revision, acceptance references and revision/command/exit/log evidence to its manager; manager transfers that same record to the integrator and direct dependent managers."
escalation = "Specialist stops for missing authority, unknown interface, path collision, cross-task contradiction, unrelated failure, required weakening or budget exhaustion. Manager escalates to main integrator; only the actual owner resolves authority/profile/production decisions."
evidence = "revision, command, exit code, log path"
no_reverify = "Managers and integrator consume recorded passed results; they do not rerun a specialist gate, add review campaigns or infer runtime/deployment success from a document or build."
release = "Aggregate, sanitizer, cluster, browser and historical matrices belong only to the canonical release candidate after independent task qualification and explicit release authority."

[role.MAIN-INTEGRATOR]
title = "Main integrator"
kind = "development-coordinator"
parent = "owner"
owns = ["spec/paxeer-x/spec.kvx", "spec/paxeer-x/qualification.kvx"]
responsibility = "Maintain canonical task admission, dependency order, exact path reservations, shared writer handoffs and candidate integration. Coordinate all thirteen managers; never expand authorized scope from this role map."
entry = "User-authorized feature work and current canonical ownership reconciled."
exit = "Accepted task handoffs integrated with exact evidence, or explicit unresolved blocker retained."
handoff = "Pass immutable canonical task contracts and producer evidence to managers; collect one result per task without rerunning gates."
escalation = "Refer native profile, secrets, deployment, production or irreversible authority decisions to the actual owner."
evidence = "Canonical task acceptance and revision/command/exit/log; qualification remains UNRUN until the actual gate runs."

[role.FM-F01]
title = "Market policy, task admission and epoch lifecycle manager"
kind = "feature-manager"
parent = "MAIN-INTEGRATOR"
tasks = ["ai.F01-T01", "ai.F01-T02", "ai.F01-T03-EPOCH", "ai.F01-T04", "ai.F01-T04-SERVICE", "ai.F01-T03-CLOSE"]
ownership = "Only canonical exact paths of assigned F01 tasks for registry/policy/registry_ops/epoch/closure/tasks modules and named tests. Shared files remain under the named single writer; package/directory names do not grant recursive write permission."
responsibility = "Allocate each F01 task to its named specialist, check dependency evidence and referenced AI.F01 requirements/acceptance, resolve task interfaces with producer managers and preserve the canonical split scopes."
entry = "All canonical dependencies complete and exact effective path ownership reserved."
exit = "Complete scoped deliverable and passing canonical acceptance evidence accepted, or implemented-not-qualified blocker escalated."
handoff = "Supply task contract, exact paths, producer types and acceptance references; return immutable revision/path/interface/evidence handoff to MAIN-INTEGRATOR and dependent managers."
escalation = "Stop and escalate path collisions, missing producer/authority, unrelated failures or required weakening; never broaden feature ownership."
evidence = "revision, command, exit code, log path"

