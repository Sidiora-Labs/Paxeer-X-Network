[service_role.RUNTIME-WORKER]
title = "External AI worker service"
kind = "runtime-service"
development_owner = "FM-F02"
qualification = "UNRUN"
responsibility = "Execute accepted finalized task bindings using its enrolled worker/delegate service identity, signed TLS transport, durable idempotent jobs and real pinned runner."
authority_boundary = "No developer task claim, repository edit, evaluator grant, finality authority, entitlement creation or arbitrary payout authority."
entry = "Real service and credentials provisioned under explicit operational authority; prerequisite and applicable producer gates qualified."
exit = "Durable identity-bound output or explicit unavailable/refused state with restart reconciliation."
handoff = "Exchange canonical signed/domain-bound records through specified service interfaces; no repository ownership or development role is conveyed."
escalation = "Report missing resources, revoked authority, stale finality, privacy or recovery failures through operational readiness; close affected admission safely."
evidence = "Actual identity/artifact/profile/root/receipt and durable service evidence; runtime availability remains distinct from task implementation qualification."

[service_role.RUNTIME-EVALUATOR]
title = "Independent evaluator service"
kind = "runtime-service"
development_owner = "FM-F03"
qualification = "UNRUN"
responsibility = "Use its separately accepted evaluator grant and signing key to assess actual permitted task/artifact data and submit canonical commitments/reveals or signed reports under live revocation."
authority_boundary = "Runtime evaluator identity is distinct from developer specialists and worker execution identity; assessment cannot mint rewards or substitute for chain finality."
entry = "Real service and credentials provisioned under explicit operational authority; prerequisite and applicable producer gates qualified."
exit = "Durable identity-bound output or explicit unavailable/refused state with restart reconciliation."
handoff = "Exchange canonical signed/domain-bound records through specified service interfaces; no repository ownership or development role is conveyed."
escalation = "Report missing resources, revoked authority, stale finality, privacy or recovery failures through operational readiness; close affected admission safely."
evidence = "Actual identity/artifact/profile/root/receipt and durable service evidence; runtime availability remains distinct from task implementation qualification."

[service_role.RUNTIME-ARTIFACT]
title = "Artifact service"
kind = "runtime-service"
development_owner = "FM-F09"
qualification = "UNRUN"
