[capability.105.5.2]
title = "Enforce the fsync and write-boundary discipline"
reference_namespace = "feature.105"
reqs = ["1114.10", "1121.5", "1137.3"]
touches = ["src/storage/lxp_log.c", "include/layerx/lxp_storage.h", "tests/storage/lxp_test_log_durability.c"]
tests = []
verification_contract = "make test-log-durability"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement the per-activity write order: append the encoded activity and sync, execute on the writer, then append the receipt, effect list and state diff and sync again."
do_2 = "Define durable head as the highest global sequence holding both an activity record and its receipt, since an activity without a receipt never had durable effects."
do_3 = "Append the sealed batch header with its own sync before publishing anything derived from it."
do_4 = "Implement lxp_log_sync and lxp_log_durable_head so no acknowledged receipt can be lost or altered by a crash occurring after acknowledgement."
do_5 = "Add a fault-injection harness that aborts the process at each distinct durable write boundary and asserts the boundary invariant at that point."
symbols = ["lxp_log_sync", "lxp_log_durable_head", "lxp_log_write_boundary", "lxp_log_fault_point"]

[capability.105.5.3]
title = "Implement crash recovery and partial tail truncation"
reference_namespace = "feature.105"
reqs = ["1114.10", "1120.10", "1130.9", "1137.3"]
touches = ["src/storage/lxp_log_recover.c", "include/layerx/lxp_storage.h", "tests/storage/lxp_test_recovery.c"]
tests = []
verification_contract = "make test-recovery"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_log_recover scanning the last segment forward, validating magic and CRC and truncating at the first invalid or short record, treating a partial tail as a crash artifact and never as a fork."
do_2 = "Load the newest snapshot at or before durable head, replay forward, recompute state roots and compare them against the recorded receipts."
do_3 = "Halt with the replay divergence fatal code on any mismatch, because the binary and the history disagree and continuing would serve state the node cannot justify."
do_4 = "Resume at the next unused global sequence with no re-execution, duplication or skipping of any already sealed activity."
do_5 = "Test recovery from an abort at every write boundary, asserting each activity is either fully contained or fully excluded and no partially applied transfer set is ever observable."
symbols = ["lxp_log_recover", "lxp_log_scan_tail", "lxp_log_truncate_partial", "lxp_log_resume_sequence"]

