ac_1 = "Interface-bearing native Deploy, Upgrade and subsequent Call accept valid ABI1–4 modules using the central version policy and version-specific import validator."
ac_2 = "The interface binds the exact code hash, ABI, entrypoints, canonical argument/result schemas and declared capabilities; unknown ABI, wrong hash or unsupported import is rejected."
ac_3 = "Compatible upgrades preserve existing interface contracts and capability narrowing; breaking changes require the explicit existing authorization policy rather than implicit widening."
ac_4 = "Persisted interface bytes and lifecycle ABI remain consistent after restart and are consumable by the registry and typed client path."

[req.120]
