do_2 = "Fail the build when a vector changes without an intent-version bump."
do_3 = "Build the differential gate proving compile, decode and disclosure re-encoding yield byte-identical payloads through layerx-wire for every vector and for generated intents."
do_4 = "Implement the disclosure-matches-intent checker that verifies field-for-field agreement between a returned disclosure and the originating intent, as the pre-signature gate journeys will use."
do_5 = "Wire both gates into make human-test-intents and CI."
symbols = ["layerx_intents::golden", "layerx_intents::DisclosureCheck"]

[capability.102.3.4]
title = "Reject the unknown deterministically and fuzz the surface"
reference_namespace = "feature.102"
reqs = ["1030.5", "1030.8", "1030.6"]
touches = ["human/crates/layerx-intents/fuzz/fuzz_targets/intent.rs", "human/crates/layerx-intents/src/reject.rs"]
tests = []
verification_contract = "make human-test-intents"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Reject unknown intent versions and unknown intent kinds with typed errors, preserving the input for diagnosis without executing it."
do_2 = "Add fuzz targets for intent deserialisation and compilation with committed corpora, treating a panic, hang or unbounded allocation as a build-breaking defect."
do_3 = "Assert no floating-point type appears anywhere in the crate through the lint set."
do_4 = "Property-test bound enforcement: every over-long and out-of-range field is rejected at construction, never truncated."
do_5 = "Wire the fuzz targets into the scheduled fuzz job alongside the agent workspace targets."
symbols = ["layerx_intents::fuzz_targets"]

[capability.102.3.5]
title = "Enforce the single payload authority"
reference_namespace = "feature.102"
reqs = ["1030.9", "1024.1"]
touches = ["human/tools/boundary-check/src/main.rs", "human/tools/boundary-check/tests/fixtures.rs", "Makefile"]
tests = []
verification_contract = "make human-check"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
