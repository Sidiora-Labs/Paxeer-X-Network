obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "On the revision that merges waves 5 and 6, run scripts/explorer/gate-lint.sh once, writing its log under build/explorer-gates/."
do_2 = "At that same revision run scripts/explorer/gate-test.sh once with its budget set to fit this task's timeout, writing its logs under build/explorer-gates/."
do_3 = "At that same revision run scripts/explorer/test-ratio.sh once over the range that spans waves 5 and 6, so that every source file those waves changed is proven to have a changed test referencing it."
do_4 = "At that same revision build the frontend image once from explorer/frontend/Dockerfile, writing its log under build/explorer-gates/."
do_5 = "Append one gate record per run to spec/paxeer-x-explorer/qualification.kvx as gate.7.1.1 through gate.7.1.4, each carrying the task, the requirements the run qualifies, the revision, the exact command, the exit code and the log path, written only from a command that actually ran."
do_6 = "Record the Playwright visual baselines of the redesigned components in the same log as a release-time refresh item, because no task in waves 5 and 6 changes a file ending in .pw.tsx or a __screenshots__ directory and the baselines are refreshed once at release."
do_7 = "Append one observation per failure the run exposes that belongs to no task in this feature - revision, command, exit code, log path, one sentence of what was observed and one sentence of what is assumed - and do not investigate it further and do not rerun it."
do_8 = "Rerun nothing that already passed at this revision, spawn no review of a task whose verify_cmd passed, and write no gate record for a command that did not run."
symbols = ["gate-lint", "gate-test", "test-ratio"]

