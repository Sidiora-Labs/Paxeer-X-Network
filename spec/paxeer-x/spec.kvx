do_3 = "Refuse a scan into a namespace the program holds no read grant for, and refuse a cursor that does not belong to the scan that issued it."
do_4 = "Make iteration order independent of insertion order, host allocator and platform, proven on the determinism differential."
do_5 = "Test iteration over an empty prefix, a single entry, a prefix spanning the per-call ceiling, and a resumption across two activities."
