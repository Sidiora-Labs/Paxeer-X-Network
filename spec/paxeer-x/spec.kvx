touches = ["platform/docs/content/guide/sandboxes.md", "platform/docs/content/concepts/programs.md"]
tests = []
verification_contract = "make platform-test-docs"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Document the sandbox as deterministic, replicated, metered compute: every node executes every sandbox activity, and the price reflects that replication."
do_2 = "Publish the measured cost per unit of sandbox compute beside the ordinary program cost, so the premium is visible rather than implied."
do_3 = "State plainly which workloads belong here - deterministic, small, settlement-adjacent - and which belong in the off-platform market of the next wave."
do_4 = "Ship a worked example of an agent renting a sandbox, running work, reading its accruing spend and having it destroyed, end to end."
do_5 = "Add the sandbox capabilities to the enforced-by tables in the same shape as every other documented capability."
