do_8 = "Leave the status chips of the transaction, block, address and token title rows, the method chips of the table rows and the counts of the section tabs taking their height from these recipes alone, writing no literal colour, font family, radius or shadow, adding no dependency, keeping both appearances resolving through the same tokens, and changing no file ending in .pw.tsx and no __screenshots__ directory."
do_9 = "Extend explorer/frontend/toolkit/theme/recipes/recipes.spec.ts so that every badge size, every chip size and the pill tab prove the height they declare is their line box plus their padding plus their border, that none of them pins a height its text could outgrow, and that the label truncation and the icon are declared as the recipes intend."
do_10 = "Extend explorer/frontend/ui/shared/scan/ScanDirectionBadge.spec.tsx, explorer/frontend/ui/shared/scan/ScanMethodChip.spec.tsx, explorer/frontend/ui/shared/scan/ScanSectionTabs.spec.tsx and explorer/frontend/ui/shared/statusTag/StatusTag.spec.tsx so each renders the real component through explorer/frontend/vitest/lib.tsx and reads the declarations Chakra emitted for it, asserting the line height, the vertical padding, the minimum height, the absence of a fixed height, the single line and the ellipsis of the label."
do_11 = "Check the rendered result once with the repository's browser driver against a local development server of this branch at 1280 and at 375 in both appearances over the home, transactions, transaction, block, address and token pages, read the screenshots and fix what they show inside this task's paths."
symbols = ["pillMinHeight", "pillPaddingY", "ScanDirectionBadge", "ScanSectionTabs", "ScanMethodChip", "StatusTag"]

