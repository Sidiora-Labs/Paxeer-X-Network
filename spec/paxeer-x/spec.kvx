obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement the KMS-backed keystore holding human and managed-agent keys with per-principal isolation, zeroization on release and no plaintext key material at rest outside the KMS boundary."
do_2 = "Implement the custody signer as a layerx-crypto remote signer: it signs only given the exact canonical bytes plus a disclosure that re-encodes byte-identically, refusing on any mismatch."
do_3 = "Gate designated operations on step-up evidence bound to the disclosure digest, refusing a signature without it."
do_4 = "Append every signing grant and refusal to the audit log with digest, operation, principal and step-up evidence, never key material or payload secrets."
do_5 = "Enforce per-principal signing throughput limits as declared configuration with typed refusals, and refuse honestly with no fallback when the KMS is unavailable."
symbols = ["layerx_human_service::custody::Keystore", "layerx_human_service::custody::CustodySigner"]

