[capability.103.6.11]
title = "Version the receipt transition to commit the full account state without changing legacy receipts"
reference_namespace = "feature.103"
reqs = ["1060.1", "1060.2", "1060.3", "1060.4"]
touches = ["include/layerx", "src/protocol", "src/modules", "src/state", "src/replica", "src/codec", "src/ledger", "contracts", "scripts", "cmd/layerxd", "cmd/layerx-genesis", "agent/crates", "interop/crates", "human/crates/layerx-intents", "platform/hosted", "tests", "Makefile"]
tests = []
verification_contract = "make layerx-genesis-build test-state-commitment-transition test-genesis && make -s check && cargo test --locked --manifest-path agent/Cargo.toml -p layerx-wire && cargo test --locked --manifest-path agent/Cargo.toml -p layerx-crypto --test verify && cargo test --locked --manifest-path agent/Cargo.toml -p layerx-proof && cargo test --locked --manifest-path human/Cargo.toml -p layerx-intents --test compile --test differential && forge test --match-path 'tests/solidity/{CheckpointRegistry,PaxeerBetaDeploymentValidator,ContractManager}.t.sol'"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Add explicit protocol version 3 for the composite-state commitment transition. Preserve protocol versions 1 and 2 and their recorded receipt-root algorithms. Version 3 resulting_state_root is the exact post-commit composite state root calculated using the real prepared module context and journal preview; verify it against committed state before publication. Preserve receipt signatures, inclusion checks, owner authorization, fee checks, replay determinism and all existing account-proof equalities. Never substitute the receipt transition hash for the composite root or add an unsigned trust bridge. A protocol-3 SEND refusal binds attempted operation, asset and participants from the strictly decoded signed activity and actual account balances without claiming successful effects; undecodable SEND payloads are rejected before durable admission and never receive invented metadata."
do_2 = "Make fresh version-3 genesis select the exact Programs V4 plus Asset V1 module table and make the daemon pin activity and LNI protocol version to its signed genesis. Preserve legacy genesis reconstruction with the original Programs-only table. Extend real client/wire receipt decoding to explicit version 3 using existing occupancy field layouts and preserve legacy encodings. Use version 3 explicitly in new beta artifacts and real-node qualification fixtures. Version-3 Rust account derivation, intent compilation and disclosure verification must match native canonical account names and IDs byte-for-byte while preserving legacy vectors."
do_3 = "Qualify both legacy and new transitions with native real-kernel tests, including exact preview-versus-committed roots and tamper rejection, native genesis and aggregate checks, Rust wire/crypto/proof checks, versioned intent golden vectors and selected-version settlement contracts. The real fresh-genesis SEND and independent replica/account-evidence gate remains mandatory in dependent task 6.10; do not mark that integration complete until actual receipt and account evidence verify."
symbols = ["lxp_module_ctx_preview_state_root", "receipt_state_root", "lxp_protocol_version_supported", "lxp_genesis_materialize"]

[req.1061]
title = "Public relay and archive nodes"
story = "As an independent operator, I can join the existing LayerX network, forward users' signed activities, retain complete canonical history and serve public reads without executing or ordering activities."
ac_1 = "Expose versioned public HTTPS synchronization of the signed genesis manifest, genesis snapshot, head and complete canonical batch bodies including every activity, receipt and maintenance record. Preserve native canonical encodings and verify signatures and all committed section roots using native codecs."
ac_2 = "Provide layerxd --relay-archive CONFIG with independently pinned network, genesis manifest digest and sequencer public identity. Validate downloaded genesis and snapshot before accepting history; never trust an upstream's self-declared identity."
ac_3 = "Backfill from genesis and continuously follow batches in order. Atomically persist raw bytes, indexes and synchronization position, reject gaps, root discontinuity, tampering and conflicting history, and resume after interruption without duplication."
ac_4 = "Serve bounded cursor-paginated complete activity, receipt and batch history and filters for actor, account, module and batch. Preserve raw bytes for every protocol kind and label cryptographic inclusion separately from execution replay or settlement finality."
ac_5 = "Discover compatible peers with bounded advertisements and expiration. Peer discovery cannot replace trust pins, redirect submission credentials or trigger arbitrary private-network probes."
ac_6 = "Forward original signed activities with durable idempotency and bounded upstream failover, retrying only the identical bytes after transport or availability failure. Preserve definitive refusals and unknown outcomes. Never sign or rebuild activities on behalf of users."
ac_7 = "Ship an integrity-pinned operator installer, example configuration, systemd and container deployment paths, and an executable real-process integration gate proving installation, bootstrap, backfill, live sync, public reads, forwarding, failover, restart and negative integrity cases."
contract_profile = "retained-with-explicit-resolutions"
reference_namespace = "feature.103"

[capability_group.103.7]
