[capability.105.23.1]
title = "Define and validate the LXP payment requirement"
reference_namespace = "feature.105"
reqs = ["1134.1", "1134.2", "1134.9", "1115.7"]
touches = ["include/layerx/lxp_gateway.h", "src/network/lxp_gateway_http.c", "fuzz/fuzz_gateway_json.c", "tests/test_gateway_requirement.c"]
tests = []
verification_contract = "make test-gateway"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Define struct lxp_payment_requirement carrying exactly network_id, recipient, asset, amount, invoice_id, purpose_hash, expiry, acceptable_conditions and service_signature."
do_2 = "Implement lxp_payment_requirement_verify to reject a requirement missing any field, encoding amount as anything other than a non-negative integer in the asset base unit, naming a foreign network_id, or carrying a service signature that does not verify against the declared recipient service key."
do_3 = "Implement lxp_gateway_translate so JSON is converted to canonical bytes before any signature is verified, and a submission whose JSON does not translate to exactly the signed bytes is rejected."
do_4 = "State and test the gateway boundary: disabling, changing or removing the gateway alters no accepted outcome, receipt field, result code or state root."
do_5 = "Add a fuzz target over the JSON translation layer so malformed input cannot reach the kernel as anything but canonical bytes or a rejection."
symbols = ["lxp_payment_requirement", "lxp_payment_requirement_verify", "lxp_gateway_translate"]

[capability.105.23.2]
title = "Settle the SEND-first payment model end to end"
reference_namespace = "feature.105"
reqs = ["1134.3", "1134.6", "1134.7", "1117.1", "1116.4"]
touches = ["src/network/lxp_gateway_send.c", "tests/test_gateway_send.c"]
tests = []
verification_contract = "make test-gateway-send"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_gateway_send_settle to build a SEND whose to, asset and amount equal the requirement, whose context_hash equals purpose_hash, whose expires_at is not later than the requirement expiry and whose conditions are a subset of acceptable_conditions."
do_2 = "Execute the payment through the single transfer-set primitive and return exactly one signed receipt to the paying agent."
do_3 = "Implement lxp_gateway_invoice_state so the same invoice_id and idempotency_key pair produces at most one economic result and returns the original receipt for every subsequent attempt."
do_4 = "Reject settlement attempted after the requirement expiry or after the batch timestamp exceeds the SEND expires_at, crediting nothing."
do_5 = "Test the identical payment submitted directly over the canonical binary transport and assert the outcome, the receipt bytes and the state root are the same as through the gateway."
symbols = ["lxp_gateway_send_settle", "lxp_gateway_invoice_state", "lxp_gateway_receipt_return"]

[capability.105.23.3]
title = "Settle the RECEIVE-claim payment model against payer grants"
reference_namespace = "feature.105"
reqs = ["1134.4", "1134.5", "1118.3", "1118.5", "1122.3"]
touches = ["src/network/lxp_gateway_receive.c", "tests/test_gateway_receive.c"]
tests = []
verification_contract = "make test-gateway-receive"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_gateway_receive_claim so the service submits a RECEIVE accompanied by the signed payer grant naming authorised recipient, asset, maximum amount, total or recurring allowance, expiration, permitted purpose, service or invoice identifier and revocation sequence."
do_2 = "Debit the payer only inside those bounds and only for that invoice_id, executing the identical internal transfer function used by SEND."
do_3 = "Reject a claim from a non-authorised recipient, above the maximum or remaining allowance, after expiration, for another purpose, or against a consumed revocation sequence, leaving every balance unchanged."
do_4 = "Implement lxp_gateway_grant_present so a client can hand the service a grant instead of a receipt, and both models converge on one ledger outcome."
do_5 = "Test a repeated exchange mixing one SEND and one RECEIVE for the same invoice and assert exactly one economic result."
symbols = ["lxp_gateway_receive_claim", "lxp_gateway_grant_present", "lxp_gateway_grant_bounds_check"]

[capability.105.23.4]
title = "Verify receipts offline in a service-side library"
reference_namespace = "feature.105"
reqs = ["1134.8", "1134.10", "1121.4", "1121.8"]
touches = ["src/protocol/lxp_receipt_verify.c", "cmd/layerx-verify/lxp_verify_receipt.c", "tests/test_receipt_offline.c"]
