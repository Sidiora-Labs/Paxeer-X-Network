[resolution.19]
title = "Unified specification and evidence-based release state"
contract = "This specification defines the product contract. Requirements and capabilities retain stable traceability across revisions. Implementation records do not establish current runtime qualification; all qualification preserves assertions, independent verification and bounded gate execution."
applies_to = ["contract_context.111.decision.publication", "contract_context.112.decision.publication", "contract_context.110.decision.publication", "contract_context.107.decision.publication", "contract_context.113.decision.publication"]

[resolution.20]
title = "Current running chain and explicit upgrade compatibility"
contract = "Accept established running Paxeer nodes/validators. Replace blanket historical halt/unanchored claims with an inventory of actual deployed LayerX components, supported protocol/ABI and governed upgrade activation. Preserve before-height compatibility and governance authorization for any newly required consensus change; never reapply a historical upgrade by assumption."
applies_to = ["contract_context.111.decision.kernel_dependency", "contract_context.112.decision.chain_frozen", "contract_context.112.decision.governance_gate", "contract_context.107.decision.chain_frozen", "contract_context.113.decision.governance_gate"]

[resolution.21]
title = "Wallet identity and participant reconciliation"
contract = "Supabase Auth remains the active wallet identity and recovery provider. Record the actual approved wallet participants, quorum parameter semantics, key epochs and failure tolerance against code Participants=5/Threshold=3 before claiming operational readiness. Do not silently convert to four signers or alter threshold. Any approved membership transition preserves keys/addresses and uses qualified add-share/refresh. Wallet, xweb and bridge memberships remain distinct."
applies_to = ["contract_context.111.decision.custody_model", "contract_context.111.decision.attestor_topology", "contract_context.111.decision.identity_plane", "req.1204", "req.1206"]

[resolution.22]
title = "Unified router without API1 DNS relocation"
contract = "Use the existing unified router contract at https://api-mainnet-beta.paxeer.network for eth_/lx_/px_ and supported routed product services. Preserve API1 at its current DNS provider and current-host proxy cutover pattern; no task relocates API1 DNS. Router availability and per-backend readiness are explicit; chain-only degradation is a supported state, not the full-product release state."
applies_to = ["contract_context.111.decision.shared_router", "contract_context.111.decision.production_safety", "req.1215", "capability.111.3.7", "capability.111.5.3"]

[resolution.23]
title = "Address-preserving staged migration and cutover"
contract = "Split historical combined tasks into ordered rehearsal, source snapshot/schema copy, durable import/refresh/verify, counts/digests/archive verification, owner/agent-consented backfill, proxy cutover, delta reconciliation and post-soak retirement. Source production DB stays read-only, old master key remains sealed, no secret export is added, and no user signs by operator substitution. Reconcile existing migration state before repeating any step."
applies_to = ["req.1207", "capability.111.5.2", "capability.111.5.3", "capability.111.5.4"]

[resolution.24]
title = "PWA supersedes native app packaging"
contract = "The active wallet is the self-hosted PWA with embedded and injected providers. Preserve release/browser/install/offline/update checks, and remove the old requirement to retain iOS/Android/Capacitor projects. Authentication, RPC, signing and payment data remain network-only and never enter offline caches."
applies_to = ["capability.111.4.4", "capability.111.4.10", "contract_context.111.decision.distribution", "req.1213.ac_8"]

[resolution.25]
title = "Retained private Human features and active wallet equivalents"
contract = "Retired human/apps/web remains a supported private-network surface where selected; its custody, receipt verification, account and sponsored-fee functions are repaired and qualified privately. Active public wallet equivalents live in human/apps/wallet. Do not republish the retired frontend or erase private journeys; no old managed funded/treasury lane or arbitrary bare-digest signing returns."
applies_to = ["req.1195", "req.1236", "capability.113.1.5", "contract_context.111.decision.funded_lane", "req.1213"]

[resolution.26]
title = "Fixed initial search price and distinct governed gas rate"
contract = "Initial search price is USD0.001 at USD13.44/PAX = 1/13440 PAX. For 18-decimal PAX, charge the explicitly documented ceiling 74404761904762 base units, never zero or float-rounded. Preserve approved explicit base-unit prices for SID/USDC/USDL; missing asset pricing blocks that offer. SID/PAX gas conversion separately uses the effective approved governed rate with age/spread bounds, not a retired oracle or an unqualified hard-coded historical rate."
applies_to = ["contract_context.112.decision.payment", "contract_context.112.design.payment.p2", "req.1220.ac_3", "contract_context.113.decision.oracle_retired"]

[resolution.27]
title = "Explicit fee fallback semantics"
contract = "An allowed selected fee denom with invalid/missing/stale/future/overflowing conversion is refused without fallback. A preference explicitly withdrawn from the allowed list resolves as no preference and uses normal PAX charging; clearing remains available. Show this distinction in consent/status and never charge a different denom silently."
applies_to = ["contract_context.113.decision.no_weakening", "req.1242.ac_6", "req.1243.ac_2", "req.1243.ac_7"]

[resolution.28]
title = "Complete explorer schemas may evolve compatibly to carry omitted truth"
contract = "Presentation-only freezes on payloads/hooks apply to redesign work, not to necessary corrections for producer-backed receipt provenance, server pagination, LayerX activity, index freshness and advancing verification. Make explicit strict schema/version/consumer changes that preserve existing fields and behavior; do not widen schemas or fabricate totals/provenance to pass checks."
applies_to = ["req.1198.ac_2", "req.1202.ac_4", "req.1203.ac_4"]

[resolution.29]
title = "Settlement evidence is distinct from display timing and index stability"
contract = "Instant/sealed/final labels derive from named verified evidence. A transaction hash, animation timer, observed depth, stale cache or source liveness is not proof of final settlement. Preserve pending/reverted/dropped/unknown and expose index freshness; use bounded polling/subscription to advance nonterminal receipts."
applies_to = ["contract_context.111.decision.shared_router", "req.1210.ac_3", "req.1187", "req.1203"]

[resolution.30]
title = "Bridge scope and collision-checked identities"
contract = "Keep all eight EVM chains and Solana in scope, their native assets and the exclusive Solana SID mapping. PAX/native pairs refer to product exchange/bridged native balances, not foreign PAX minting; no wrapped-PAX or EVM-mainnet SID representation is invented. Any future expansion is an explicit governed requirement. The reserved Solana identifier is checked against configured/registered networks; remove the mathematically unsupported assertion that no EIP-155 identifier can ever collide."
applies_to = ["contract_context.107.decision.sidiora_scope", "contract_context.107.decision.native_pair", "contract_context.107.design.identity.p3", "contract_context.107.design.chains"]

[resolution.31]
title = "Approved deployment configuration is distinct from rejecting examples"
contract = "Committed placeholder examples must remain non-deployable. Offline schema tests validate example shape and expected placeholder refusal; operational tools accept only a separately approved complete nonsecret configuration plus secret references. Replace the contradictory demand that every placeholder-bearing committed example be operationally accepted."
applies_to = ["contract_context.107.decision.fail_closed", "req.1144.ac_6", "req.1144.ac_7"]

[resolution.32]
title = "Local proofs and complete operational journey proofs have separate gates"
contract = "Preserve local anvil/Solana dry runs and recorded-exchange tests as component evidence. Add mandatory candidate/runtime journey gates through real served binaries, independent authorities and actual balances/receipts; an impersonated xweb precompile callback, library-only call or replay fixture does not qualify operational fulfilment. Each future release gate inventories/reuses existing systems before any separately authorized deployment."
applies_to = ["req.1231", "req.1154", "req.1193", "req.1216"]

[resolution.33]
title = "Historical paths and task-only prohibitions do not disable current boundary repairs"
contract = "Resolve old packaging paths to the current docker/ layout and retain path traceability. Historical no-change-to-existing-loop/no-new-tests-outside-feature restrictions do not prevent explicitly scoped cross-boundary repairs for burn/deposit admissibility, durable worker scheduling, receipt producers and shared ABI support. Preserve frozen wire formats and all safety assertions unless an explicit versioned migration contract is approved."
applies_to = ["contract_context.107.decision.relayer_scope", "req.1148.ac_5", "req.1228", "capability.111.6.10", "capability.111.6.11", "capability.111.6.12"]

