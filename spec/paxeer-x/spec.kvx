verification_contract = "make programs-test"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Model StorageNamespace as a closed enum over a principal-scoped namespace and a program-shared namespace, both carrying the owning program, so a namespace names its scope in the type rather than by convention."
do_2 = "Fix both namespaces before guest code runs exactly as the principal-scoped namespace is fixed today, so no guest-visible operation can choose, widen or construct a namespace."
do_3 = "Keep the address ordering canonical and stable across both variants so state roots and iteration order are deterministic everywhere."
do_4 = "Migrate the existing storage plane and its tests to the enum with no behavioural change to principal-scoped access."
do_5 = "Prove by construction that no program can name another program's namespace of either kind, with the type system carrying the guarantee rather than a runtime check."
