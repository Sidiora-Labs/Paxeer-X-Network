obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Inject connection loss at every stage of submission, process kill between signing and transmission, duplicate delivery, delayed acknowledgement, restart mid-resolution and clock disturbance."
do_2 = "Assert exactly-once economic effect and honest unknown reporting in every case."
do_3 = "Prove idempotency end to end through repeated retries, concurrent duplicates and post-restart resubmission, asserting exactly one receipt and one economic effect."
do_4 = "Assert no leaked reservation, no lost outbox entry and no submission left without an owner across every scenario."
do_5 = "Wire the suite into make agent-qualify-faults as a release gate."
symbols = ["agent_fault_injection_suite", "agent_exactly_once_suite"]

[capability.101.23.5]
