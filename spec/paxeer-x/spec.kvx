do_1 = "Add agent/sdk/typescript/src/browser.ts as the browser entry of @sidiora/layerx-sdk: it re-exports only the modules whose import graph is free of node: built-ins (the generated client, mirror and receipt types, mirror, production, stream, verifier, native program call and capability codecs, account derivation, the exchange, gas station, bridge, launchpad, perps, spot and xweb api modules) and package.json publishes it as the ./browser export beside the root entry, built by the same tsc run into dist/src/browser.js."
do_2 = "Make xweb-api.ts node-free without changing its exported API or wire format: the ECIES envelope moves from node:crypto onto @noble/curves secp256k1 for the ephemeral key, point decompression and the shared x coordinate, @noble/hashes hkdf and randomBytes, and @noble/ciphers aes-256-gcm with the same key, nonce, aad and 16-byte tag layout; hex, unhex and latin1 decoding no longer use Buffer; @noble/ciphers 2.4.0 joins the dependencies and the lock file."
do_3 = "Point every human/wallet/sdk/src/modules import of the agent SDK at @sidiora/layerx-sdk/browser and resolve that specifier in the wallet app the same way the root entry is resolved: the webpack alias in next.config.mjs, the tsconfig paths entry and the vitest alias each map it to agent/sdk/typescript/src/browser.ts; the webpack build, extension alias and SDK-scoped module lookup from 6.10 stay."
do_4 = "Keep parseTokenMetadata in src/app/api/token-metadata/route.ts module-local so the route module exports only the route fields the Next type check accepts; nothing outside the module imported it."
symbols = ["browser.ts", "sealXWebEnvelope", "xwebAttestorAddress", "decompress", "hex", "unhex", "latin1"]

