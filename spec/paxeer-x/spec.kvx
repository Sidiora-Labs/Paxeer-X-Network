[capability.105.5.6]
title = "Implement the single deterministic state writer and its journal"
reference_namespace = "feature.105"
reqs = ["1114.9", "1120.1", "1120.10", "1122.6"]
touches = ["src/state/lxp_journal.c", "include/layerx/lxp_state.h", "tests/state/lxp_test_journal.c"]
tests = []
