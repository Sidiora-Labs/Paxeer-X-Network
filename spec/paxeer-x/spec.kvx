obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Add the program call operation to the agent layer contract as an additive change within the current contract major, carrying calldata, declared budget, requested capabilities and the typed response."
do_2 = "Add layerx program call to the CLI with machine-readable output, an idempotency key because a call is a money-adjacent state change, and receipt-verified result rendering."
