obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement connection establishment, reconnection with bounded jittered backoff, and a connection state surface that distinguishes connected, degraded, incompatible and unreachable."
do_2 = "Track the chain head sequence, the latest sealed batch and the latest finalised checkpoint continuously, and expose them so every read can report what it is relative to."
do_3 = "Track the authorised sequencer key set and refuse to accept a receipt signature verified against a key the node did not advertise for that batch."
do_4 = "Enforce that this crate is the only one in the workspace that opens a boundary connection, and add the check to the boundary purity gate."
do_5 = "Add tests covering reconnect during a request, head regression, and a node that advertises an unexpected network mid-session."
symbols = ["Client", "layerx_client::head::HeadTracker"]

[capability.101.7.2]
title = "Implement submission with exact-byte transmission"
reference_namespace = "feature.101"
reqs = ["1007.2", "1007.3", "1007.5", "1001.6"]
touches = ["agent/crates/layerx-client/src/submit.rs", "agent/crates/layerx-client/tests/submit.rs"]
tests = []
verification_contract = "make agent-test-client-submit"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement submit to transmit exactly the signed bytes it was given, with no re-encoding, normalisation, reordering or augmentation anywhere in the path."
do_2 = "Verify before transmission that the signature verifies over the exact bytes about to be sent, and fail rather than transmit otherwise."
do_3 = "Treat the acknowledgement as admission evidence only, returning a distinct type that cannot be confused with an executed outcome."
do_4 = "Classify an attempt that ends without a determinate outcome as unknown, and expose that classification rather than an error that reads as failure."
do_5 = "Add tests asserting byte equality between the signed bytes and the transmitted bytes under fragmentation, retry and reconnect."
symbols = ["layerx_client::submit::submit_signed", "layerx_client::submit::Acknowledgement", "layerx_client::submit::Unknown"]

[capability.101.7.3]
title = "Implement receipt retrieval, verification and unknown resolution"
reference_namespace = "feature.101"
reqs = ["1007.4", "1007.5", "1013.4", "1013.5"]
touches = ["agent/crates/layerx-client/src/receipt.rs", "agent/crates/layerx-client/tests/receipt.rs"]
tests = []
verification_contract = "make agent-test-client-receipt"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement receipt lookup by activity identifier, idempotency key and global sequence, returning the exact core-produced bytes."
do_2 = "Verify every retrieved receipt through layerx-proof before returning it and attach the achieved verification level."
do_3 = "Implement unknown resolution that repeatedly looks up the receipt for an idempotency key under bounded jittered backoff and never resubmits as a way of resolving."
do_4 = "Resend byte-identical bytes under the original idempotency key when a resend is warranted, and treat the return of an existing receipt as the correct outcome."
do_5 = "Add tests covering a receipt that appears late, a receipt that never appears within the deadline, and a node that returns a receipt for a different activity."
symbols = ["layerx_client::receipt::lookup", "layerx_client::receipt::resolve_unknown"]

[capability.101.7.4]
title = "Implement verified reads at a requested level"
reference_namespace = "feature.101"
reqs = ["1007.6", "1014.1", "1014.2", "1014.3"]
touches = ["agent/crates/layerx-client/src/read.rs", "agent/crates/layerx-client/tests/reads.rs"]
tests = []
verification_contract = "make agent-test-client-reads"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement balance, account, module state and history reads that take a requested verification level and fetch the proof material that level requires."
do_2 = "Verify the proof material locally before returning and attach the level actually achieved together with the head and checkpoint the value is relative to."
do_3 = "Refuse rather than downgrade when the requested level cannot be achieved, returning a typed error naming the missing evidence."
do_4 = "Implement history reads that preserve core bytes exactly and expose stable cursors with no gap and no repetition across pages."
do_5 = "Add tests proving a value is never returned at a level higher than its evidence and that a hostile node cannot raise the level by asserting it."
symbols = ["layerx_client::read::balance", "layerx_client::read::history", "layerx_client::read::Requested"]

[capability.101.7.5]
title = "Implement the ordered event stream and resumable cursors"
reference_namespace = "feature.101"
reqs = ["1007.7", "1016.1", "1016.4"]
touches = ["agent/crates/layerx-client/src/stream.rs", "agent/crates/layerx-client/tests/stream.rs"]
tests = []
verification_contract = "make agent-test-client-stream"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement the event stream that delivers core-produced events in strict global sequence order with no synthesis, enrichment or reordering."
do_2 = "Expose a resumable cursor that survives disconnection and process restart and resumes without a gap or a duplicate at the seam."
do_3 = "Detect a sequence gap and surface it explicitly as a gap with the missing range rather than closing it silently."
do_4 = "Apply bounded buffering with explicit backpressure so a slow consumer cannot cause unbounded memory growth or event loss."
do_5 = "Add tests covering disconnect mid-stream, restart from cursor, an out-of-order node and a deliberately skipped sequence."
symbols = ["layerx_client::stream::subscribe", "layerx_client::stream::Cursor", "layerx_client::stream::Gap"]

[capability.101.7.6]
title = "Implement availability retrieval and verification"
reference_namespace = "feature.101"
reqs = ["1015.1", "1015.2", "1015.5", "1015.7"]
touches = ["agent/crates/layerx-client/src/availability.rs", "agent/crates/layerx-client/tests/availability.rs"]
tests = []
verification_contract = "make agent-test-client-availability"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement availability retrieval by checkpoint identifier, batch number, sequence range and activity identifier, streaming large retrievals rather than buffering them whole."
do_2 = "Verify each chunk and the reassembled bytes through layerx-proof before treating the retrieval as successful, and report which availability classes were obtained."
do_3 = "Support multiple providers, treat a provider serving non-verifying bytes as failed for that request, and never merge bytes from two providers into one unverified result."
do_4 = "Bound retrieval by explicit size, chunk-count and deadline limits and report partial completion honestly."
do_5 = "Add tests covering a withholding provider, a corrupting provider, a partial class set and a retrieval that exceeds its bound."
symbols = ["layerx_client::availability::fetch", "layerx_client::availability::ProviderSet"]

