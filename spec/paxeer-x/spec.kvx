[capability.104.29.2]
title = "Grant and enforce shared-namespace access through explicit capabilities"
reference_namespace = "feature.104"
reqs = ["1099.2", "1093.1", "1093.3"]
touches = ["programs/crates/layerx-programs-runtime/src/abi/storage_ops.rs", "programs/crates/layerx-programs-runtime/src/abi/capability.rs", "programs/crates/layerx-programs-runtime/src/host/storage.rs"]
tests = []
verification_contract = "make programs-test"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Add distinct shared-read and shared-write capabilities so an activity can invoke a program with read-only access to shared state, and keep principal-scoped grants conferring no shared access whatsoever."
do_2 = "Extend the storage host functions with a namespace selector, refusing an unselected or out-of-range selector with a typed invalid result before any access occurs."
do_3 = "Keep narrowing downward only across a program-to-program edge for the new grants exactly as it holds for the existing ones, with an attempted widening failing typed."
do_4 = "Meter shared access on the same per-byte basis as principal-scoped access so no namespace is cheaper to abuse."
do_5 = "Test a two-participant program end to end - a shared total mutated by two different principals - which has no representation before this task."
symbols = ["layerx_programs_runtime::Capability", "layerx_programs_runtime::abi::storage_ops"]

