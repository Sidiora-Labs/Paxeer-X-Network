[meta]
name = "Paxeer X"
slug = "paxeer-x"
version = "1.0.0"
status = "draft"
goal = "Operate the complete Paxeer X product: native LayerX execution and all retained capabilities integrated with Paxeer, reachable through the unified router, with every required subsystem operational and qualified on one identified candidate."
scope = "Protocol, Programs, custody, Human, identity, wallet, agents, developer platform, markets, search, gas, bridges, interop, explorer, data services, packaging, runtime assembly and release qualification."
completion = "All applicable acceptance criteria, task evidence, routed product journeys and subsystem operational gates pass against one compatible source, image, configuration and state manifest."

[decision]
chain_id = 125
router_url = "https://api-mainnet-beta.paxeer.network"
wallet_api = "https://wallet-api.paxeer.network"
chain_foundation = "The existing Paxeer network, nodes and validators are an operating prerequisite. This work integrates Paxeer X with that network and preserves its RPC assignments; it does not schedule validator replacement, DNS relocation or a repeated activation solely from historical backlog state."
public_entry = "The unified router is the canonical entry and discovery surface for every product capability. Product domains remain compatible aliases or frontends with upstreams in the same route catalogue. Private custody, signing shares, administration, event publication and control-plane endpoints remain authenticated private services."
wallet = "Supabase handles wallet authentication. The wallet frontend is a user interface. The signing gateway delegates protected signing to enrolled wallet attestors; the approved threshold and actual roster must agree with ceremony, gateway and attestor configurations before changes. Wallet, bridge and xweb signer fleets are independent."
wallet_hosting = "Preserve the existing Docker-hosted wallet frontend and its data until a separately qualified cutover is applicable; do not infer its deployment platform from a stale service placeholder."
pricing = "A search costs USD 0.001. At USD 13.44 per PAX the nominal charge is 1/13440 PAX. Use integer base-unit arithmetic and the specified rounding/refund policy; never charge 0.001 PAX as an equivalent amount."
precedence = "Current unified requirements and explicit resolution sections control integration behavior. Retained capability contracts continue to apply except for the specific scope or interface clauses replaced by those resolutions. A contradiction without a resolution remains blocking; implementations, tests and checks must not be weakened to conceal it."
private_network = "Retain private-network testing, faucet and retired Human web capabilities within their private deployment profile; expose the complete current user functionality through the active wallet and Human services. Do not advertise private-network services as mainnet production endpoints."
evidence = "Source presence, focused qualification, image publication, deployment and production journey evidence are separate states. Task status is pending until current-scope evidence exists; historical completion is not automatically current deployment certification."

[design]
flow = "Wallet or developer client -> unified router -> authenticated product gateway or boundary -> native kernel and durable services -> independent replica and guarantor/finality evidence -> Paxeer settlement -> verified index/history -> client outcome."
control_plane = "Identity, policy, KMS, private event sources, signer shares, provisioners, CI controllers and state stores retain their service-specific authenticated internal boundaries. A unified router does not turn a private authority endpoint into a public API."
durability = "Acknowledged monetary state, consumed payments, authorization and pending external actions are persisted atomically before advancing cursors. Recovery reuses exact identities and cannot duplicate financial effects."
topology = "One compatibility manifest identifies every source revision, image digest, chain and kernel network identifier, ABI/version, authority fingerprint, role, dependency, durable volume, health predicate and route. Discover actual deployed state before proposing any replacement."
subsystem_completion = "Each service proves its usable dependency path, persistence, recovery, authorization boundary, monitoring and rollback conditions. A port accepting connections, an image existing in a registry or an app object alone is insufficient."

[execution]
planning_state = "Task completion requires the declared implementation and qualification evidence. A specification or task status alone establishes no runtime result."
task_policy = "Inspect the exact declared source and existing evidence, preserve implementations that satisfy the contract, implement all unmet criteria before one bounded qualification pass. Record implementation, qualification, runtime and certification independently."
gate_policy = "Every planned gate is implemented by the task that owns its acceptance criteria. The dispatcher rejects unknown, empty, skipped or placeholder selectors. Existing reference commands preserve coverage requirements but are not evidence that the command still exists or ran."
candidate_policy = "Reuse a passing gate only when its exact source, inputs, scope and environment identity remain applicable. Aggregate, sanitizer, browser, cluster, real-chain and historical matrices are release-stage gates, once per candidate and scope, not repeated per source task."
parallelism = "At most 12 implementation tasks may be in progress; dependencies and intersecting touches serialize work. This plan does not authorize starting all tasks at once."
privacy = "Credentials, authority material, operational inventories and raw execution evidence remain in access-controlled storage. Public product material is reviewed for confidential information before publication."

[req.1]
title = "Complete product route coverage"
ac_1 = "Every native, EVM, Programs, Human, wallet, agent, market, search, gas, bridge, interop, developer and explorer capability has a canonical route or authenticated discovery entry at the unified router."
ac_2 = "The route catalogue declares method or path, transport, authentication, upstream, timeout, health predicate, supported version and consumer; HTTP, JSON-RPC, WebSocket, MCP/A2A and required mTLS passthrough behave consistently."
ac_3 = "Unavailable required dependencies produce a precise non-ready or refused outcome; no route silently falls back to another network, stale authority or weaker authentication."
ac_4 = "Existing api1 through api16 mainnet-beta RPC records and chain125 remain unchanged; product aliases use the same validated router/upstream catalogue."

[req.2]
title = "Coherent source, image and runtime assembly"
ac_1 = "A candidate manifest binds each deployed executable and configuration to its actual source revision and image digest; branch-only implementations receive no mainline credit before integration."
ac_2 = "Every required process, service identity, role-specific UID, private directory, volume, certificate and policy is present with correct ownership before dependent roles start."
ac_3 = "For every required subsystem, current runtime inventory determines preserve, configure, update or deploy action; an existing healthy service is retained when it meets the candidate contract."
ac_4 = "Every image contains its actual runtime binaries and dependencies; staged images and empty application records are not counted as running services."

[req.3]
title = "Verified complete monetary journeys"
ac_1 = "A funded user can authenticate, deposit an admitted asset, receive verified credit, transfer, authorize an agent or program, withdraw and verify the resulting Paxeer payout through routed product surfaces."
ac_2 = "Amounts, asset identifiers, account identifiers, chain/kernel network identifiers, receipt/proof versions and finality state agree across UI, SDK, gateway, kernel and chain."
ac_3 = "Duplicate submission, timeout, restart, reorganization, refusal, insufficient funding and lost response preserve exactly one economic outcome and a recoverable truthful user state."

[req.4]
title = "Complete supported subsystem operation"
ac_1 = "Every subsystem in the service catalogue has an operational owner role, manifest, authenticated dependencies, durable state where needed and an exercised product operation."
ac_2 = "Readiness proves the capability served by that subsystem, including dependency state and data freshness, rather than only process, TCP or database liveness."
ac_3 = "External providers, enrolled signers, supported foreign chains, governance settings and funded accounts are verified from actual configured inputs before readiness or release credit."

[req.5]
title = "Custody and authority separation"
ac_1 = "Wallet Supabase principals resolve to the correct tenant and authorized account; protected signatures are produced only through the approved attestor/KMS authority path."
ac_2 = "No migrated wallet route falls back to a retained whole-key envelope; independent approved disclosure, signed activity and session/capability constraints bind the same operation."
ac_3 = "Wallet, bridge and xweb participant sets remain distinct; certificates, rotation, revocation, key ceremonies, export and recovery enforce their complete acceptance contracts."

[req.6]
title = "Programs and financial feature completeness"
ac_1 = "Every supported Programs ABI is consistent across admission, sandbox execution, migration, account/proof views, interfaces, registry, reproducible verification, bindgen and language SDKs."
ac_2 = "Native asset, budget, escrow, stream, service, perps, spot, exchange, launchpad, program custody, sandbox leasing and compute-market lifecycles include termination, disputes, governance and recovery."
ac_3 = "All monetary effects retain the canonical monetary law, deterministic execution, bounded resources, replay safety, finality and proof verification."

[req.7]
title = "Durable consumers and projections"
ac_1 = "Event sources, webhooks, indexers, mirror publishers, archive relays, paid-web consumers, gas recovery and bridge relayers persist pending work before advancing durable cursors."
ac_2 = "Restart, one failing principal/provider, key rotation and reorganization neither lose accepted work nor block independent work indefinitely."
ac_3 = "Explorer history, receipts, balances, metadata, pagination, finality badges and SDK/CLI responses originate from the verified canonical producers and reflect rollback and freshness."

[req.8]
title = "Runtime recovery and operation"
ac_1 = "For every durable subsystem, restart and bounded dependency outage recover acknowledged state without duplicate money movement or authority rollback."
ac_2 = "Certificate and signer rotation, backup/restore, resource exhaustion, storage bounds, queue backlog and dependency loss have fail-closed behavior and measurable alerts."
ac_3 = "Rollback preserves custody state, journal compatibility and already finalized effects; migrations declare compatibility and a tested recovery route before mutation."

[req.9]
title = "Exact candidate qualification"
ac_1 = "Every acceptance criterion is mapped to a task and evidence from the identified candidate; empty, skipped, synthetic-only or dirty-source results cannot stand in for a real required gate."
ac_2 = "Release matrices include required negative, historical, cross-language, browser, sanitizer, fuzz, load/soak, cluster, settlement and recovery coverage from retained capability contracts."
ac_3 = "Release closure identifies the exact running image/configuration set and successful routed user/developer journeys; no required criterion or required subsystem remains unverified."

[req.10]
title = "Retained feature contract coverage"
ac_1 = "All retained acceptance criteria and capability contracts remain addressable within this specification, including capabilities whose earlier implementation was recorded complete."
ac_2 = "An explicit resolution identifies the exact clause and replacement when a later interface or deployment profile supersedes a retained contract; a broad omission is not a resolution."
ac_3 = "Private-network capabilities remain retained and qualified in the private profile; no public profile claims them operational by hiding or deleting their contract."

[req.11]
title = "Deterministic specification tooling"
ac_1 = "A deterministic KVX parser, dependency validator and renderer support this unified feature and preserve requirement, task and evidence traceability."
ac_2 = "Generated projections contain the active feature pointer and only their intended neutral technical content; private operational records are not rendered into tracked documentation."
ac_3 = "Dependency graphs contain no unknown IDs, cycles or forward wave violations; each implementation task declares exact paths and one focused gate."

[req.12]
title = "Exact paid service economics"
ac_1 = "Search charges USD0.001 at the configured conversion; the nominal13.44USD/PAX quote is1/13440PAX before specified base-unit rounding."
ac_2 = "SID gas sponsorship, exchange/launchpad orders, compute settlement, bridge caps and ramp quotes enforce their declared units, decimals, rate freshness, ceilings, refunds and refusal behavior."
ac_3 = "User-visible completion requires authoritative receipt/finality or service delivery evidence; a returned hash, local timer or consumed payment alone cannot assert successful delivery."

