[task.103.6.10]
title = "Bind a real finality-authority verifier in layerxd so the sequencer bootstraps"
status = "done"
mode = "BUILD"
wave = 3
requires = ["0.2", "103.6.11"]
reqs = ["1060.1", "1060.2"]
do_1 = "Reconcile the retained capability against the current candidate and explicit resolution sections. Reuse conforming implementation; complete only unmet criteria. Resolve historical paths against the current source without narrowing the capability or repeating operational transitions already completed."
do_2 = "Add cmd/layerxd/lxp_daemon_finality_authority.c implementing lxp_daemon_finality_authority_verify_fn for the sequencer: hash the certificate checkpoint with lxp_checkpoint_certificate_hash and require it to equal the registration's checkpoint_id; require the certificate attestations' paxeer_chain_id and paxeer_settlement_contract to equal the registration and the daemon's configured LAYERX_NODE_PAXEER_CHAIN_ID and LAYERX_NODE_SETTLEMENT_CONTRACT; run lxp_checkpoint_finalisable against the evidence store's finalisation state, bonded set and requirements; then independently confirm the registration on the Paxeer chain through a loopback JSON-RPC endpoint LAYERX_NODE_PAXEER_RPC_ADDRESS/PORT (127.0.0.1 only, reusing the daemon's loopback HTTP client conventions) with eth_chainId, eth_getTransactionReceipt(transaction_id) - status 1, to equals the separately configured LAYERX_NODE_CHECKPOINT_REGISTRY, blockNumber equals observed_block_number, an exact CheckpointRegistered event from that registry carrying the checkpoint_id and matching certificate commitments; independently query the registry guarantorEligibility() and require it to equal LAYERX_NODE_SETTLEMENT_CONTRACT - and eth_blockNumber at or beyond the observed block; bind it in open_process with lxp_daemon_evidence_open so LXP_ERR_MODULE_DISABLED can no longer occur; no environment variable may disable verification."
do_3 = "Fix every other defect that stops layerxd --serve bootstrapping from a fresh layerx-genesis-build genesis with absent log files, including log creation capacity in path_empty_or_absent/lxp_log_open and the replica's log growth, so that the sequencer and --authority-replica start, accept a SEND over the LNI, and publish batch evidence to the replica; keep bootstrap_storage_empty and verify_bootstrap_genesis strict."
do_4 = "Add tests/daemon/lxp_test_finality_authority.c wired into the Makefile test list: a real anvil (pinned Foundry on PATH) chain with the settlement contracts deployed, a registered checkpoint, and proofs that a genuine registration verifies, that a mismatched chain id, contract, checkpoint id, block number, or reverted transaction is refused, and that an unreachable chain returns an unavailability error rather than success; add a shell test that boots layerxd --serve and the replica end to end from genesis and submits one activity."
do_5 = "Provide this task selector in tools/paxeer-x/gates and execute the full scoped acceptance contract using real production paths. Preserve the retained verification command coverage; move aggregate matrices to release scope and refuse an unknown or unimplemented selector."
