do_1 = "Implement lxp_activity_check_timestamp_bound comparing the batch-supplied timestamp against not_before and not_after, with the window width bounded by the declared maximum."
do_2 = "Read time only from the batch header and never from a wall clock, a monotonic clock, a timezone or a locale, so the same rejection occurs on every node."
