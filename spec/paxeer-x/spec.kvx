reqs = ["402"]
do_1 = "Prepare the complete bounded gate harness before qualification. Reuse only exact candidate-bound accepted evidence; execute each required aggregate leg once, preserve all declared coverage, and reject skipped, missing or synthetic substitutes. An existing command is not sufficient until its declared acceptance scope is implemented."
do_2 = "Before dispatch, freeze the complete versioned gate manifest: inherited requirement and case identifiers, all matrix cells, exact commands, mandatory negative cases, original duration minima and thresholds, candidate source identity, environment/toolchain pins and required artifact inventory. Refuse dispatch if any duration or required case is unresolved."
do_3 = "Locate the durable logical run key for this candidate and manifest. Reuse its queued, running or completed execution record. Dispatch a new external CI execution only if no execution exists and the workflow already has execution authorization; persist the returned job identity before acknowledging dispatch. Dispatch acceptance alone leaves qualification pending."
do_4 = "Let the durable CI workflow run every declared case for its full required duration and retain structured result, timing, exit status and artifacts. The agent does not wait synchronously for the long job and does not stop it merely because its own 30-minute task budget ends."
do_5 = "When the workflow has finished, run the single bounded evidence-validation command below. Validate complete coverage and source/environment/job binding, including actual uninterrupted duration where required. Do not rerun the execution to validate evidence."
do_6 = "Record a qualifying pass only on validator exit 0. For exit 75 or task-budget exhaustion, retain the job identity and pending state with the exact missing evidence; resume evidence collection in a later bounded task. For invalid or failed evidence, record the failure and retain the task as unqualified."
touches = ["tools/qualification/paxeer_x_release.py", "agent/tests", "agent/crates/layerx-agentd", "agent/crates/layerx-mcp"]
verify_cmd = "timeout 25m python3 tools/qualification/paxeer_x_release.py evidence --gate agent-boundary --profile full --candidate-manifest build/qualification/paxeer-x/candidate.json --job-record build/qualification/paxeer-x/jobs/agent-boundary.json --deadline-seconds 1500"
gate_kind = "planned"
max_builds = 0
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result or time limit; record exact revision, command, exit code and private evidence location. Do not mark complete without the declared evidence."
planned_paths = ["tools/qualification/paxeer_x_release.py"]
path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to their current equivalents before the gate can run; historical references never authorize a duplicate implementation tree. Complete scoped path reconciliation without dropping acceptance criteria."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

