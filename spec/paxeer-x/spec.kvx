do_2 = "Write the projection watermark inside the same SQLite transaction that applies a projected record batch, so the watermark can never disagree with the tables."
do_3 = "Open the database in WAL mode from a single projection thread and forbid every other thread from writing it."
do_4 = "Add a CI check asserting that no translation unit under src/protocol, src/state, src/storage consensus paths or src/modules links any sqlite3 symbol, since no consensus code may read a projection."
do_5 = "Make a projection failure mark the projection stale and nothing more, never blocking execution and never sitting on the consensus path."
