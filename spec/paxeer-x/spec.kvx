reference_namespace = "feature.111"
reqs = ["1209.1", "1209.2", "1209.3", "1209.4", "1209.5", "1209.6"]
touches = ["human/wallet/gateway/src/provision/state.ts", "human/wallet/gateway/src/provision/bind.ts", "human/wallet/gateway/src/provision/backfill.ts", "human/wallet/gateway/src/routes/wallet.ts", "human/wallet/gateway/test/provisioning.test.ts"]
tests = []
verification_contract = "timeout 20m sh -c 'pnpm --dir human/wallet/gateway test -- provisioning'"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
