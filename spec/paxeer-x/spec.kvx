verification_contract = "timeout 15m tools/bringup/check-live.sh search"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Rewrite interop/deploy/x-websearch/config.example.json as a working serving example with no placeholder value and no note: listen 127.0.0.1:8482, gateway.endpoint https://api-mainnet-beta.paxeer.network/rpc, evm a serving RPC name, and the SID, PAX, USDC and USDL asset ids the task 1.4 genesis registered with their prices in base units; then write tools/bringup/xweb-config.sh that renders the serving config for each serving RPC name of [contract_context.108.decision] host_roles: listen on the loopback address at port 8482, gateway.endpoint https://api-mainnet-beta.paxeer.network/rpc, the kernel's sequencer id and public key, the SID, PAX, USDC and USDL asset ids the task 1.4 genesis registered, each with its price in base units, evm the node's loopback JSON-RPC, chain and network 125, peers the https names of the other serving RPC names and no kernel block, with a receiver key generated on that host and never printed."
do_2 = "Install on each serving RPC host the x-websearch binary from the same release artifact the attestor sidecars run, checked against that artifact's sha256 digest, with interop/deploy/x-websearch/x-websearch-serve.service, a separate unit that loads the receiver key only through one LoadCredential line and sets no attestor or submitter env, so only the serving role runs, and its config with no kernel block and no attestor key; include interop/deploy/x-websearch/nginx-search.conf once in the host's apiN server block routing /search, /fetch and /content/ to the sidecar and /xweb/health to its /health, check nginx -t and reload."
do_3 = "From the kernel machine register every serving receiver's DID on the kernel, and credit the payer account in PAX through custody credit from the owner's deposit."
do_4 = "Add the search subcommand: /xweb/health ok on every serving RPC name, and one /search answering 402 and then 200 after a PAYMENT-SIGNATURE in PAX from the credited payer account settled at the router, on one serving RPC name and through https://search.paxeer.network."
symbols = ["xweb_config", "check_search"]

