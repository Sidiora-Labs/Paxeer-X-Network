do_1 = "Implement lxp_ct_memcmp with no data-dependent branch or memory access and lxp_secure_zero that the compiler may not elide."
do_2 = "Route every digest, signature, key and nullifier comparison in consensus code through lxp_ct_memcmp and add a CI check rejecting plain memcmp on those types."
do_3 = "Zero every stack buffer holding key or preimage material before return."
do_4 = "Add a timing-variance test asserting comparison cost is independent of the position of the first differing byte."
do_5 = "Run the whole crypto suite under the address, undefined-behaviour and thread sanitizers with zero findings."
