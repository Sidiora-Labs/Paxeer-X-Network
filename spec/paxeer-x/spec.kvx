obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_reserve_reconcile to compute, per asset, the sum of every agent account, subaccount, escrow, budget, margin, liquidity, insurance, fee treasury and withdrawal balance."
do_2 = "Implement lxp_supply_invariant_check to reject any payout or credit that would leave custody below LayerX balances plus outstanding claims, or make any account negative."
do_3 = "Run the check at every checkpoint boundary and refuse to produce a batch whose resulting state root violates full reserve accounting."
do_4 = "Implement lxp_reserve_report as an operator-facing per-asset report with zero tolerance and an explicit list of contributing account classes."
do_5 = "Test that an injected phantom credit is caught at the first checkpoint boundary rather than at audit time."
symbols = ["lxp_reserve_reconcile", "lxp_reserve_report", "lxp_supply_invariant_check"]

[capability_group.105.23]
title = "Build the optional JSON and HTTP 402 gateway and operator tooling"
