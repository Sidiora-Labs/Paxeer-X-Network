obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Define the versioned intent types for v1: DID registration, key rotation, recovery registration, EVM payout binding, 402LXP send, 402LXP receive under a payer grant, payer grant registration, budget create, budget fund, budget defund, bridge deposit credit and bridge withdraw request."
do_2 = "Build every intent field from layerx-types domain types only - amounts as protocol integers, identifiers through their namespaces - so an invalid intent is unconstructible."
do_3 = "Give the vocabulary an explicit version with the rule that a change to any intent's compiled bytes requires a version bump."
do_4 = "Enforce protocol length and range bounds at intent construction with typed errors."
do_5 = "Document each intent kind with the journey it serves and the module payload it compiles to."
