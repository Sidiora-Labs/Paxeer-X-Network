do_2 = "Implement lxp_daemon_config as an explicit file-driven configuration with no environment-dependent consensus input."
do_3 = "Wire the threading model as specified: one executor thread touching consensus state, plus verify, network, projection and checkpoint workers that never mutate it."
do_4 = "Add the nightly serial-execution mode reducing all worker pools to zero and asserting byte-identical output."
do_5 = "Implement lxp_daemon_shutdown for a clean stop at a write boundary, and test start, stop and restart under load with no sequence gap."
symbols = ["lxp_daemon_main", "lxp_daemon_config", "lxp_daemon_role", "lxp_daemon_shutdown"]

