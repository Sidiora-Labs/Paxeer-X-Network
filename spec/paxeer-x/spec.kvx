obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Define struct lxp_batch_body carrying the header, the activities, the receipts, the events, the accepted oracle inputs, the state-diff material and the recovery metadata as one canonically encoded unit."
do_2 = "Implement lxp_batch_publish to push the complete body to the configured replica set over the canonical binary transport, with resumable chunked transfer."
do_3 = "Implement lxp_replica_ack and lxp_batch_eligibility so a batch becomes checkpoint-eligible only once acknowledgements from the configured replica threshold are durably recorded."
do_4 = "Make eligibility a hard gate: a batch with insufficient acknowledgements is never offered to guarantors and never enters a checkpoint."
do_5 = "Test that withholding acknowledgements from a majority of replicas leaves the batch sealed, readable and permanently ineligible until they arrive."
symbols = ["lxp_batch_body", "lxp_batch_publish", "lxp_replica_ack", "lxp_batch_eligibility"]

[capability.105.17.6]
title = "Recover the sequencer at every write boundary"
reference_namespace = "feature.105"
reqs = ["1110.9", "1114.10", "1120.10", "1130.8", "1130.9", "1130.10"]
touches = ["src/sequencer/lxp_recovery.c", "src/storage/lxp_log_recover.c", "tests/test_sequencer_recovery.c"]
