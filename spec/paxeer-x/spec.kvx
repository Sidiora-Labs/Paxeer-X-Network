[capability.108.4.4]
title = "Complete the deployed explorer fork: archive RPC, history copy and the probe through paxscan.io"
reference_namespace = "feature.108"
reqs = ["1170.2", "1170.3"]
touches = ["explorer/deploy/railway/README.md", "spec/paxeer-x/qualification.kvx", "tools/bringup/check-live.sh"]
tests = ["tools/bringup/check-live.test.sh"]
verification_contract = "timeout 20m tools/bringup/check-live.sh explorer"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Identify the explorer services from the NEXT_PUBLIC_API_HOST of the envs.js that https://paxscan.io serves through our explorer proxy host: the Explorer Backend and Explorer Frontend services of the Railway project paxeer-x-explorer-dev, their Postgres, its production database explorer_10_2_6 and its legacy database railway; the Railway project paxscan is read-only and is touched only as the copy source for the range from the legacy database's ceiling up to the archive node's first retained block. On the Explorer Backend set as service variables ETHEREUM_JSONRPC_HTTP_URL, ETHEREUM_JSONRPC_TRACE_URL and ETH_CALL_URL to the archive host's public RPC name over https, ETHEREUM_JSONRPC_WS_URL to that name over wss, ETHEREUM_JSONRPC_FALLBACK_HTTP_URL to another serving RPC name, and FIRST_BLOCK and TRACE_FIRST_BLOCK to the archive node's first retained block, keeping CHAIN_TYPE paxeer_x and ETHEREUM_JSONRPC_VARIANT paxeer_x; on the Explorer Frontend set NEXT_PUBLIC_NETWORK_RPC_URL to the archive host's public RPC name; no other variable changes, nothing else is redeployed and no DNS record changes; record these production values in the variable table of explorer/deploy/railway/README.md; confirm after the backend restarts on its new variables that it indexes a block below the pruned nodes' first retained height."
do_2 = "Run explorer/deploy/tools/copy-blockscout-11-to-10.sh into explorer_10_2_6 on the same Postgres from the legacy database railway from block 0 up to its ceiling, and from the read-only paxscan project for the range from that ceiling up to the archive node's first retained block; when that range is not available read-only, record the gap as one entry in spec/paxeer-x-bringup/qualification.kvx and do not fill it; add the explorer subcommand: https://paxscan.io 200 with the archive host's public RPC name as NEXT_PUBLIC_NETWORK_RPC_URL in its envs.js, the backend's /api/health and /api/v2/stats 200, the block count from the first copied block equal to the sources', and missing block ranges only inside the ranges recorded as lost in the source."
do_3 = "The owner allowed one redeploy of the explorer services to apply these settings: after the backend variables and the frontend's NEXT_PUBLIC_NETWORK_RPC_URL are set, redeploy the Explorer Backend and the Explorer Frontend once each and never again; the probe then reads the new values through paxscan.io."
symbols = ["check_explorer"]

