obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_log_scan_tail to scan the last log segment forward, validate the record magic and body CRC, and truncate at the first short or invalid record, treating a partial tail as a crash artifact and never as a fork."
do_2 = "Implement lxp_sequencer_recover to establish durable_head as the highest sequence carrying both an activity record and its receipt, load the newest snapshot at or below it, replay forward and hard-halt on any recomputed root mismatch."
do_3 = "Implement lxp_projection_rebuild to drop and rebuild every SQLite projection from the log whenever the projection watermark is ahead of, or behind, durable_head."
do_4 = "Implement lxp_sequencer_equivocation_detect to refuse a second distinct header for a batch_number already sealed and to publish both signed headers as slashable evidence."
do_5 = "Define the sequencer-loss posture: stop accepting activities rather than order out of band, and require a governance handover activity naming the new sequencer_id and its first batch_number."
do_6 = "Add a fault-injection test that aborts the process at each distinct write boundary and asserts each activity is fully present or fully absent after restart."
