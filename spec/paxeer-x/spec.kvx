[capability_group.104.29]
title = "Give programs shared state, iteration and bounded state lifetimes"
children = ["104.29.1", "104.29.2", "104.29.3", "104.29.4", "104.29.5", "104.29.6", "104.29.7"]

[capability.104.29.1]
title = "Extend the namespace model with a program-shared namespace"
reference_namespace = "feature.104"
reqs = ["1099.1"]
touches = ["programs/crates/layerx-programs-runtime/src/storage/namespace.rs", "programs/crates/layerx-programs-runtime/src/storage/mod.rs"]
