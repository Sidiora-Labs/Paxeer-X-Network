[capability.111.5.2]
title = "Rehearse the ceremony against the production data"
reference_namespace = "feature.111"
reqs = ["1207.5", "1216.4"]
touches = ["spec/paxeer-x/qualification.kvx", "human/wallet/ceremony/internal/rehearsal/source.go", "human/wallet/ceremony/internal/rehearsal/schema.go", "human/wallet/ceremony/internal/rehearsal/rehearsal.go", "human/wallet/ceremony/internal/rehearsal/rehearsal_test.go", "human/wallet/ceremony/internal/testsupport/postgres.go", "human/wallet/ceremony/cmd/ceremony/main.go", "human/wallet/ceremony/cmd/ceremony/main_test.go"]
tests = []
verification_contract = "timeout 20m sh -c 'cd human/wallet/ceremony && go run ./cmd/ceremony rehearse --report-only-counts'"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Take a read-only copy of the production wallet data from the current wallet host into a temporary database on an operator machine, run the ceremony tool in rehearsal mode against five locally started daemons with the master key supplied through its environment variable, and require every standard and agent wallet to match and every funded wallet to archive."
do_2 = "Append the report's counts to spec/paxeer-x-wallet/qualification.kvx; a passing rehearsal is the readiness check of the live ceremony, which runs as its own task."
do_3 = "Add a source mode to the rehearse subcommand in human/wallet/ceremony/internal/rehearsal and cmd/ceremony/main.go that replaces the operator-dump input: it connects to the production wallet database through a connection URL named by environment variable for a read-only role, refuses to start when that role can write (superuser, a write privilege on any table it reads, or a session where default_transaction_read_only is off and cannot be forced on), opens one transaction with BEGIN ISOLATION LEVEL REPEATABLE READ and SET TRANSACTION READ ONLY so every table is read from a single snapshot, and streams each table with COPY ... TO STDOUT straight into the temporary database's COPY ... FROM STDIN, never writing to the source and never producing a file on disk."
do_4 = "Record the row count of every copied table on both sides and refuse to continue when they differ, carry the per-table counts in the rehearsal report, and add rehearsal tests against a real source database with a read-only role proving the copy, the single-snapshot read under a concurrent write, the count check, the refusal of a writable role, and that no file is created during the run."
do_5 = "Add a --report-only-counts flag to the rehearse, deliver and archive subcommands in human/wallet/ceremony/cmd/ceremony/main.go, whose run accepts exactly one argument today and answers any second one with usage and exit 2: with the flag, rehearse runs the rehearsal and prints only its counts report with the per-table counts; deliver and archive import nothing, write no archive and mark no row, and instead read the database named by CEREMONY_DATABASE_URL, and for archive the file named by CEREMONY_ARCHIVE_PATH opened under its passphrase, and print the counts their reports carry for the current state (deliver: wallets, eligible, funded, migrated and eligible not yet migrated; archive: funded rows, archive rows, verified and the archive file's SHA-256 digest), exiting non-zero when deliver finds an eligible wallet not migrated or archive finds the archive and the funded rows disagree; any other second argument keeps answering usage and exit 2, and command tests cover each subcommand with and without the flag and the refusal of an unknown argument."
do_6 = "Prepare the source-mode target so the copied rows meet the gateway's schema, since PlanMigration and Deliver refuse a wallets table without migrated_at and the production schema predates it: into an empty target the copy first applies exactly the gateway migration files, read from the directory named by CEREMONY_GATEWAY_MIGRATIONS_DIR (human/wallet/gateway/migrations in a checkout), that the source's _migrations ledger lists, refusing when the ledger names a file the directory does not carry or when a source table or column has no counterpart in the resulting schema; it then streams every table of the source schema including the ledger, and afterwards applies the remaining files in lexical order, recording each in _migrations exactly as the gateway's runner in src/db/migrate.ts does, so migrated_at, attestor_key_id, the funded archive marks and the unified account tables exist on the copied rows as after an upgrade in place and the gateway finds nothing left to apply at start; rehearsal tests prove a source at an older ledger ends at the directory's full ledger with every row intact and a ledger naming an unknown file refused."
symbols = ["Rehearse", "CopySource", "checkReadOnlyRole", "TableCounts", "PrepareSchema", "reportOnlyCounts"]

[capability.111.5.3]
