[capability.104.38.7]
title = "Restore complete SDK generation-lock coverage"
reference_namespace = "feature.104"
reqs = ["1109.7", "1087.1", "1087.2"]
touches = ["platform/sdk/generators", "platform/sdk/pipeline.kvx", "platform/sdk/jvm", "platform/sdk/conformance", "spec/paxeer-x/qualification.kvx"]
tests = []
verification_contract = "make platform-sdk-check"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Classify every file under a generated output root as generated or explicitly handwritten and make the drift gate cover that classification."
do_2 = "Bring LocalVerifier.java, ConformanceMain.java and run-jvm.sh back into byte-for-byte agreement with the declared pipeline lock."
do_3 = "Reject untracked files inside explicit-list output roots unless the pipeline declares them handwritten."
do_4 = "Keep schema inputs, generator revision and every output digest in one atomic lock update."
do_5 = "Record the current mismatch as superseded only after the canonical source and lock agree."
symbols = ["drift_gate", "write_lock"]

[capability.104.38.8]
title = "Repair frozen interpreter refusal-vector stage fidelity"
reference_namespace = "feature.104"
reqs = ["1109.8", "1103.5"]
touches = ["programs/crates/layerx-programs-interpreter/vectors/v1-refusals.hex", "programs/crates/layerx-programs-interpreter/tests/conformance.rs", "programs/crates/layerx-programs-runtime/tests/interpreter_program.rs", "spec/paxeer-x/qualification.kvx"]
tests = []
verification_contract = "make programs-test"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Correct the overflow and division refusal vectors so their declared register file admits every encoded operand."
do_2 = "Keep each vector's intended arithmetic refusal and expected no-effect outcome unchanged."
do_3 = "Make the conformance oracle name and assert the expected refusal stage rather than accepting any earlier error."
do_4 = "Keep the runtime integration vector expectations aligned with the independent interpreter oracle."
do_5 = "Record that execution of the repaired vectors remains a human qualification gate."
symbols = ["fixed_refusals_cover_structure_arithmetic_amount_and_depth_without_effects"]

[capability.104.38.9]
title = "Unify Programs ABI upgrade policy across consensus and projections"
reference_namespace = "feature.104"
reqs = ["1109.9", "1092.4", "1092.7"]
touches = ["include/layerx/programs.h", "src/modules/programs/deploy.c", "tests/programs/test_registration.c", "programs/crates/layerx-programs-runtime/src/abi_policy.rs", "programs/crates/layerx-programs-runtime/src/lib.rs", "programs/crates/layerx-programs-runtime/src/lifecycle.rs", "programs/crates/layerx-programs-runtime/tests/lifecycle.rs", "programs/crates/layerx-programs-registry/src", "programs/crates/layerx-programs-registry/tests", "spec/paxeer-x/qualification.kvx"]
tests = []
verification_contract = "make programs-test"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Freeze one ABI transition policy and enforce it in the C deploy and upgrade transition before any artifact or state mutation."
do_2 = "Apply the identical rule in registry replay, executable admission and receipt-backed interface evidence."
do_3 = "Return one typed version refusal for a downgrade rather than allowing consensus state that projections cannot ingest."
do_4 = "Keep historical ABI replay under the version recorded in the receipt and do not rewrite existing versions."
do_5 = "Write cross-language upgrade and downgrade cases for human qualification."
symbols = ["execute_upgrade", "Registry::record_deployment_version"]

[capability.104.38.10]
title = "Align Programs event metering and capability transport bounds"
reference_namespace = "feature.104"
reqs = ["1109.10", "1091.3", "1093.1"]
touches = ["programs/crates/layerx-programs-runtime/src", "programs/sdk", "programs/crates/layerx-programs-runtime/tests", "include/layerx/programs.h", "src/modules/programs/call.c", "src/modules/programs/event.h", "tests/programs/test_call_activity.c", "Makefile", "spec/paxeer-x/qualification.kvx"]
tests = []
verification_contract = "make programs-test"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Charge event topic and data bytes through the ordinary output meter before allocating or staging the event."
do_2 = "Enforce the aggregate event-count ceiling at emission time and retain the canonical-envelope check as a final invariant."
do_3 = "Define one capability-encoding byte ceiling and derive the guest reads, C ingress and SDK constants from it."
do_4 = "Keep capability count and encoded-byte ceilings mutually satisfiable for every constructible canonical capability set."
do_5 = "Write boundary and exhaustion cases for event count, event bytes and maximum capability sets without running qualification."
symbols = ["Abi::emit_event", "layerx_programs_call_begin"]

