ac_3 = "Private sponsored submission tracks station status across retry/reload without signing changed or expired construction bytes."
ac_4 = "No public mainnet exposure or deployment of the retired Human web application follows from completing this compatibility path."

[req.156]
title = "Present the supported wallet model in SDK exports and demo flows"
ac_1 = "The demo presents embedded threshold custody and injected wallets accurately and offers no removed funded-account or treasury path."
ac_2 = "SDK public exports match supported gateway routes; legacy funded calls return an explicit unsupported/deprecated contract instead of advertising a working unavailable endpoint."
ac_3 = "The demo exercises sign-in, provisioning, transaction, typed-data, custody handoff and kernel plan with supported decoders and availability states."
ac_4 = "No secret/private key enters the demo bundle, and rebuilding/reloading the example does not restore removed funded choices or mislabel embedded custody as self-custody."

[req.157]
title = "Validate the authority’s explicit readiness contract at the router"
ac_1 = "The gateway accepts the actual authority readiness schema including numeric protocol_network_id and validates it against configured protocol network identity, label and wire version."
ac_2 = "Missing, wrongly typed, mismatched or unexpected fields remain a typed unready condition; strict decoding is preserved."
ac_3 = "A ready authority yields the authority-ready backend result, and false-ready/transport/TLS failures yield unavailable without being converted into healthy status."
ac_4 = "The producer-to-consumer contract is exercised with the real authority serializer and gateway decoder across restart/configuration mismatch."

[req.158]
title = "Preserve resolvable identities alongside native account references"
ac_1 = "A resolved unified identity retains an EVM or DID lookup key separately from the native account ID used for display and native reads."
ac_2 = "EVM/DID lookup -> canonical identity selection -> repeated account/balance/history lookup resolves the same owner and account; a bare native account is never silently reinterpreted as a DID public key."
ac_3 = "Unsupported bare native reverse resolution receives an explicit typed unsupported/unresolvable result unless an authenticated reverse index is implemented and proven; wrong-network or conflicting identity joins refuse."
ac_4 = "Shared client and OpenRPC declarations agree, and retained private explorer-index joins use the same distinction without reviving that retired service as a public mainnet dependency."

[req.159]
title = "Include every configured public-core and identity dependency in router readiness"
ac_1 = "Kernel-mode readiness includes configured PublicCore and Identity alongside existing durable store, events, Paxeer relay, component, authority and registry dependencies."
ac_2 = "Each backend is checked with its actual bounded authenticated contract: public core’s numeric network identity encoded as text is validated with the correct semantics, and identity writable readiness is not misparsed as another backend shape."
ac_3 = "Losing either required dependency makes readiness unavailable and identifies it; recovery restores the result, and chain-only mode still serves supported chain methods with typed kernel-unavailable errors."
ac_4 = "A healthy vector corresponds to usable configured read/session paths and survives restart with the same dependency roster; omission of a configured dependency fails the focused gate."

[req.160]
title = "Establish authenticated LNI receipt capability in authority readiness"
ac_1 = "Authority readiness independently requires the replica and a bounded non-mutating authenticated LNI handshake with the receipt capabilities/version needed by lookup_receipt."
ac_2 = "Healthy replica with absent LNI, wrong peer identity, incompatible protocol/capability or handshake timeout reports unavailable."
ac_3 = "An empty but valid replica/genesis remains distinguishable from a broken dependency and never bypasses LNI admission."
ac_4 = "LNI loss withdraws readiness and reconnection restores it without submitting an activity, mutating chain state or relaxing receipt/header/finality verification."

[req.161]
title = "Bootstrap registry identity before router activation with an acyclic dependency order"
ac_1 = "The deployment plan orders shared gateway client identity and registry token/trust/builder material, registry app readiness, router kernel-mode activation, then registry-through-router receipt proof without a dependency cycle."
ac_2 = "Router activation retains mandatory registry configuration/readiness and fails with a named missing prerequisite; the registry bootstrap does not require a previously passing router gate."
ac_3 = "Existing services, images, retained volumes and credentials are inventoried before deployment actions; each reused or newly supplied prerequisite has an explicit producer and no key material is fabricated or printed."
ac_4 = "The public unified interface remains https://api-mainnet-beta.paxeer.network; API1–API16 DNS remains unchanged and app fly.dev names remain internal edge upstreams only."
ac_5 = "A future staged proof records the selected candidate/image and ordered outcomes, culminating in a real successful signed registry receipt read through the router; failed stages resume without discarding state or weakening checks."

[req.162]
title = "Serve receipt-verified program discovery and value accounts for every supported guest ABI"
ac_1 = "The hosted deployment verifier, registry projection and emulator shall implement the same explicit guest ABI1–4 support and upgrade matrix as native deployment, independently of protocol version3 and module version4."
ac_2 = "For every supported ABI, a real deployed and upgraded program shall expose matching identifier, code hash, version, interface, lifecycle and permitted value-account state through hosted discovery and emulator routes; ABI1 shall remain explicitly account-incapable."
ac_3 = "Unknown ABIs, forbidden downgrades, altered program records, mismatched interface/artifact hashes, stale heads, foreign signer keys and invalid proof membership shall retain typed refusals and shall never become discoverable by merely broadening a numeric predicate."
ac_4 = "Restart shall rebuild identical version/lifecycle history from sealed deployment evidence and independently refreshed current heads; remote attestation shall work without a local LNI socket while preserving exact signer/head binding."
ac_5 = "Source publication shall retain separate operator authority, pinned reproducible builder provenance and explicit unpublished/mismatch/verified states; source availability shall not substitute for deployment receipt verification."

[req.163]
title = "Preserve source-verification idempotency across isolated request workers"
ac_1 = "An authenticated principal/program/idempotency-key scope shall durably bind the canonical source request digest and terminal response before acknowledging completion."
ac_2 = "The same key and request in a later HTTP connection, worker process or registry restart shall return the same recorded response without rerunning a completed build; a changed request shall return409 and shall not modify verified-source state."
ac_3 = "Concurrent identical requests shall have one build owner; different principals shall not observe or collide with each other's records. Quota and bounded retention rules shall preserve live/ambiguous request identities."
ac_4 = "A crash before reservation, during rebuild, after artifact persistence and before response acknowledgement shall recover an explicit pending or completed state, without returning an unbacked success or abandoning a committed publication."
ac_5 = "Corrupt idempotency records, uncertain writes and unavailable storage shall fail closed while preserving evidence and existing process isolation, authentication and resource limits."

[req.164]
title = "Prove emulator and hosted execution parity with a nonempty canonical corpus"
ac_1 = "The conformance gate shall require a nonempty validated corpus with declared positive and negative cases, known initial state, explicit network/protocol versions and supported ABI coverage; empty/comment-only/malformed input shall fail."
ac_2 = "Every case shall actually reach the intended production operation or refusal stage; transport failure, authentication rejection, missing response or malformed JSON shall not count as a matching protocol outcome."
ac_3 = "Comparison shall include verified canonical receipt observations, result/error taxonomy, declared effects, metered cost and resulting state under equivalent controlled inputs; any legitimate environment-dependent fields shall have explicit justified normalization."
ac_4 = "At least one same-status/different-effect or different-state case shall demonstrate comparator refusal; restart/replay shall produce the declared identical canonical observations."
ac_5 = "The completed comparison shall be registered as an explicit merged-candidate qualification gate; a tooling/unit-test pass shall never satisfy this parity gate implicitly."

[req.165]
title = "Expose registry serving readiness through the authenticated health contract"
ac_1 = "The Fly and retained Kubernetes serving checks shall reflect the authenticated /healthz verdict, not solely an open TCP socket; transport liveness shall remain separately identifiable."
ac_2 = "Mutated or stale builder verification, unavailable required event delivery dependencies and invalid/unavailable node authority shall withdraw serving readiness within a declared bounded interval, while preserving typed request refusals."
ac_3 = "Readiness shall require the pinned rootfs/entrypoint, distinct request/publication credentials, cgroupv2 cpu/memory/pids/io delegation, hard ext4 quota slots, matching sequencer history/replica identity and configured node/receipt authorities; missing material shall remain waiting or refused."
ac_4 = "The probe shall not expose keys/tokens or bypass mTLS and shall not use an exec mechanism forbidden by the registry cgroup process boundary."
ac_5 = "After recovery or restart, readiness shall resume only after the existing builder and authority verification succeeds; a candidate operation record shall bind image/rootfs identity to a real signed deploy, discovery read and gateway program_registry readiness result."

[req.166]
title = "Separate public webhook APIs from authenticated private producer ingress"
ac_1 = "The public webhook process shall serve only its explicit developer route set and reject every /internal route before processing producer or operator bearer credentials."
ac_2 = "Private ingress shall require both a verified internal client certificate with permitted producer/operator role and the existing correct bearer for source publication or dispatch; absent, foreign, expired and role-incompatible certificates shall be refused."
ac_3 = "Each Fly process group shall mount only credentials needed by its role; private ingress shall have no public exposure, and retained Kubernetes routes shall enforce the same route and identity contract."
ac_4 = "Canonical source retrieval, principal binding, receipt verification, destination controls, Redis CAS/leases, ordered at-least-once delivery, replay protection and KMS signing shall remain enforced."
ac_5 = "Restart and certificate/token rotation shall preserve durable deliveries and shall not temporarily enable internal routes on the public listener or accept an unauthenticated producer."

[req.167]
title = "Refresh enrolled principal credentials atomically while event sources run"
ac_1 = "Journey, approval, payment and program sources shall accept authorized principal enrollment, rotation and removal through one versioned bounded lifecycle without requiring a source restart for every user."
ac_2 = "A complete validated credential snapshot shall replace the prior snapshot atomically; malformed, oversized, duplicate, mismatched-principal or unauthenticated updates shall be refused without partially replacing the last valid state."
ac_3 = "Revoked/removed credentials shall lose authority under an explicit effective-generation rule; rotation shall not allow cross-principal event publication or disclosure of old stored events."
ac_4 = "Persisted enrollment generations and event ownership shall replay consistently on restart; pending deliveries shall retain their canonical identities and only authorized credentials may rebind them."
ac_5 = "Empty valid enrollment shall remain live but not ready for first-event acceptance; protected credential contents shall not enter logs, public responses or generated artifacts."

[req.168]
title = "Provision real journey and approval principals through the event bootstrap lifecycle"
ac_1 = "Authorized Human onboarding/session issuance shall install principal-bound credentials for journey and approval sources, with equivalent declared ownership for payments/programs; placeholders or fabricated principals shall never satisfy readiness."
ac_2 = "A fresh deployment shall have an explicit dependency order: internal source processes and producer credentials may exist before Human, but accepting user events requires completed principal enrollment and successful upstream binding."
ac_3 = "Empty enrollment shall return readyz503 with a precise waiting reason; malformed credentials, wrong tenant/principal, invalid session and unauthorized writers shall fail closed."
ac_4 = "All five internal groups shall retain independent persistent state, private-only networking and mandatory mTLS; webhook Redis/KMS/identity/source/authority and sequencer/network material shall be supplied through protected references."
ac_5 = "After authorized provisioning and after restart/rotation, a real user journey and approval shall produce canonical events and ordered signed webhook delivery; the record shall identify the candidate and exact principal binding without disclosing credentials."

[req.169]
title = "Schedule durable Human events fairly across principals"
ac_1 = "Pending event selection shall allow each eligible principal to make bounded progress even when another principal has an unprovisioned credential, unavailable destination or persistent delivery refusal."
ac_2 = "Ordering and exact retries shall remain strict within each declared principal/subject stream; a failed earlier event shall not be overtaken within that stream."
ac_3 = "Per-principal backoff, retry state, selection cursor and terminal disposition shall be bounded and durable enough to avoid restart starvation; healthy principal progress shall not reset another principal's refusal evidence."
ac_4 = "Only canonical acknowledged delivery shall remove a pending event; retry exhaustion shall retain an explicit operator/redelivery state rather than silently drop the event."
ac_5 = "A real-process case shall place a repeatedly failing principal before a healthy principal, demonstrate healthy delivery within the scheduler bound, restart the worker and then recover the failed principal without duplicate economic effect."

[req.170]
title = "Report idle producer readiness from its first-delivery dependencies"
ac_1 = "An idle producer shall report readiness only when the required source can accept its principal-bound first event and the webhook ingress can accept the authenticated trigger; livez shall continue to indicate process reachability separately."
ac_2 = "A source that is waiting for principals, a rejected producer identity or a failed webhook ingress shall not be marked recovered merely because source livez returns200."
ac_3 = "Readiness checks shall use bounded deadlines and a declared freshness window, preserving startup progress without circular readiness dependencies between producers and consumers."
ac_4 = "Human and registry mandatory producer groups shall fail startup on incomplete configuration; gateway optionality shall apply only to an entirely absent group, never to partially supplied credentials."
ac_5 = "On dependency restoration or process restart, health shall recover after a real successful dependency check; queued event state and canonical delivery acknowledgement shall remain independent of health polling."

[req.171]
title = "Advertise interop settlement readiness only for a usable LayerX activity boundary"
ac_1 = "Interop shall parse the complete versioned gateway readiness document and require its LayerX core activity boundary and required protocol/network pins to be ready before advertising settlement capability."
ac_2 = "HTTP200 with degraded, absent or unconfigured kernel state, malformed/unknown required fields, wrong chain/network pins or expired readiness evidence shall not advertise LayerX settlement readiness; chain-serving availability shall remain a separate capability."
ac_3 = "Configured x402 HTTP/MCP/A2A, AP2, UCP, Visa TAP and fiat adapters shall retain their exact manifest membership and trust requirements; absent AP2 assets/roots, Visa identities, fiat roots, Redis or receipt authority material shall not silently disable required adapters."
ac_4 = "A successful adapter outcome shall still require independently verified exact activity/receipt/batch evidence; pending, reversed and chargeback states shall retain their distinct semantics and no adapter shall gain custody/protocol authority."
ac_5 = "Restart and dependency loss/restoration shall update readiness/metadata consistently, and qualification shall execute a real exact-scheme exchange plus each configured adapter's constrained refusal path on the selected candidate."

[req.172]
title = "Acquire and publish independently verified checkpoint proofs to both archive mirrors"
ac_1 = "The production LNI acquisition path shall obtain complete authenticated checkpoint certificate/root/coordinate evidence and independent head coordinates, construct NodeCheckpoint and pass verified material to Archive::from_node."
ac_2 = "A bare checkpoint identifier, mismatched sequence/root/domain, invalid signer membership/threshold or unverifiable authority report shall never count as a finalized checkpoint or restore readiness."
ac_3 = "Publisher state shall track latest verified and successfully mirrored batch/checkpoint separately for Ethereum and Solana, with explicit freshness budgets; observing later batches without checkpoint evidence shall not erase a proof failure."
ac_4 = "Restart shall resume durable publication/reconciliation without duplicate inconsistent anchors, and completed publication shall be reconciled against canonical chain observations before progress is acknowledged."
ac_5 = "Both Ethereum and Solana configurations shall use supplied independent RPC trust, funded authorized deployment/publisher identities and read-back addresses; a receipt shall verify from each mirror with LayerX services unavailable, without assigning custody or settlement authority to mirror chains."

[req.173]
title = "Derive relay archive freshness from successful pinned origin observations"
ac_1 = "The archive shall maintain separate timestamps and outcomes for poll attempts, successful pinned-head observations and durable batch progress."
ac_2 = "When all configured origins are unreachable or invalid, synchronization shall record an unavailable/stale result and readyz shall fail after the declared freshness budget; a genuinely observed equal head shall remain distinguishable from no observation."
ac_3 = "Wrong genesis/network/sequencer pins, malformed heads, signature failures and discontinuous batch history shall retain explicit refusal without advancing canonical progress."
ac_4 = "Restart shall retain the last proven head and freshness state, not manufacture a fresh observation; reconnection shall validate continuity before clearing degradation."
ac_5 = "Explicit local-source-only operation shall use a separately defined local source health/progress contract rather than require nonexistent remote origins; status shall truthfully identify the selected mode."

[req.174]
title = "Gate ramp readiness on a healthy durable journal and verified recovery"
ac_1 = "Ramp readyz shall require operational durable journal state including the halted/uncertain-write flag; obtaining the mutex shall not by itself imply readiness."
ac_2 = "Interrupted append, corrupt record, exclusive-writer conflict and ambiguous durable state shall withdraw readiness and preserve mutation refusal without discarding journal history."
ac_3 = "Restart or explicit recovery shall validate journal framing, identities and external settlement state before clearing the halt; a status read shall not reset a persistent halt."
ac_4 = "Real provider, compliance decision key, identity, non-exporting signer handles, custody-owner interface, quote catalogue and operator identifiers shall be explicit protected inputs; current chain/network pins and agreeing RPC reads shall be validated."
ac_5 = "A recovered sandbox ramp journey shall declare external custody and reach done only against the verified LayerX-side receipt; provider pending, reversal and chargeback cases shall retain their declared typed states."

[req.175]
title = "Package and qualify redundant pinned relay archives on Fly"
ac_1 = "The relay source package shall include an explicit Fly manifest for at least two machines in two regions, each with its own durable archive volume and a bounded resource configuration."
ac_2 = "A sequencer-colocated LayerX origin shall expose the pinned canonical genesis/network/sequencer data over authenticated TLS, while relay replicas validate those exact pins and continuity before readiness."
ac_3 = "The public archive route shall expose readyz and sync head and forward original signed activity bytes to the configured unified router, returning its verified verdict without signing/reconstructing the request."
ac_4 = "The future bringup relay mode shall be registered and shall require every selected replica's genesis equality and lag within one batch of a contemporaneously read origin, refusing missing replicas, wrong pins, stale origins and altered bytes."
ac_5 = "Existing deployment inventory and image/source identity shall precede runtime changes; restart on each replica shall preserve history and revalidate freshness, and a failed replica shall not cause private origin material or credentials to be exposed."

[req.176]
title = "Retain EVM web-attestation work before advancing event cursors"
ac_1 = "Confirmed decoded EVM requests and their canonical source identity shall be durably queued before the watcher cursor is committed beyond them."
ac_2 = "Restart before fetch, during independent attestation, before quorum, after quorum and before signed-transaction journaling shall restore incomplete work and retain or deterministically reconstruct valid partial signature progress."
ac_3 = "Transient fetch/peer errors shall enter bounded retry state; terminal invalid requests shall have durable explicit refusal, and neither class shall disappear merely because its event range was scanned."
ac_4 = "Signatures shall remain bound to the exact origin/domain/request/content digest and registered membership; wrong digest, duplicate/unsorted signers and insufficient threshold shall never authorize fulfilment."
ac_5 = "After signed bytes are journaled, recovery shall reuse their transaction identity and reconcile already-fulfilled/refunded or reorged requests before another economic action, preserving exactly-once completion under the declared finality depth."

[req.177]
title = "Recover kernel web requests and submitted observations across restarts"
ac_1 = "Kernel event progress shall advance only after every discovered paid request is durable with program/request/topic identity and its exact attestation/submission state."
ac_2 = "Awaiting-quorum and retryable attestation/post failures shall remain queued across restart; terminal refusal shall be recorded explicitly without silently dropping paid work."
ac_3 = "Observation submission shall persist exact signed activity bytes and idempotency identity before send, and recover pending/unknown outcomes through committed receipt lookup before deciding to resubmit."
ac_4 = "Kernel observations shall retain origin2 preimage, program/request/payload-hash binding, ascending registered signers, low-s and majority-threshold checks, and exactly-once fee splitting/intake."
ac_5 = "A reference program shall request and pay, survive relay restart before quorum and after submit, receive one verified observation and read the same committed data through web_read without duplicate charge or observation."

[req.178]
title = "Bind settled payments to durable recoverable search and fetch delivery"
ac_1 = "Invalid/missing/duplicate query parameters and malformed resource requests shall be rejected before any settlement draw or receipt consumption."
ac_2 = "After verified settlement, one receipt shall bind to one canonical request/resource identity and durable delivery state; a handler/index/content-store failure shall preserve a recoverable paid entitlement instead of irreversibly consuming it."
ac_3 = "A retry of the same canonical paid request shall return its persisted result or resume the same delivery without a second charge; a changed request, foreign receipt, replay for another resource or unverified/pending settlement shall release no content."
ac_4 = "Crash after settlement, during resource computation, after result persistence and before response acknowledgement shall retain the exact payment/result association, with explicit pending or failed delivery state rather than unbacked success."
ac_5 = "PAYMENT-RESPONSE and content digest shall name verified evidence and the actual canonical result; configured metered and exact schemes and SID/PAX/USDC/USDL base-unit rules shall remain intact."

[req.179]
title = "Advertise paid-web readiness from role-specific usable dependencies"
ac_1 = "Serving, attestor and kernel-relay roles shall expose separate bounded readiness reflecting required index/content storage, settlement authority, peer quorum or relay progress, while process liveness remains independent."
ac_2 = "Empty upstream selection, unavailable required index, unbound settlement trust, insufficient registered peers and stale relay progress shall not produce serving-ready merely because a health handler runs."
ac_3 = "The search frontend shall route only to eligible serving backends and preserve the same backend/resource binding between PAYMENT-REQUIRED and paid retry; a failed dependency shall not turn a paid retry into a second charge."
ac_4 = "Restart/recovery shall restore durable pending work before readiness, and recent progress shall have a declared freshness budget rather than be inferred from source presence or an open socket."
ac_5 = "Private attestor listeners and peer routes shall remain private and authenticated; no public API or DNS relocation shall be introduced to satisfy the readiness check."

[req.180]
title = "Provision priced paid search and authorized web-attestor settlement identities"
ac_1 = "Search pricing shall use the approved USD0.001 per request at USD13.44/PAX, exactly 1/13440PAX before documented ceiling conversion to configured PAX base units; all accepted asset IDs/decimals and conversion inputs shall be validated against registered kernel metadata."
ac_2 = "Actual serving receivers, kernel submitter/payout DIDs, payer authority/balance, web signer membership and EVM submitter funding shall be inventoried and reconciled through authorized registration/custody-credit paths; absent amounts or authority shall remain explicit inputs, never invented."
ac_3 = "The four intended private web-attestor slots shall retain distinct web/submitter/receiver key roles and approved majority membership, protected per-slot volumes and peer connectivity; wallet membership/threshold decisions shall not be borrowed or silently changed."
ac_4 = "A serving RPC endpoint, the client's redundant path and search.paxeer.network shall each demonstrate a verified paid search at the declared price; the 402 challenge and retry shall remain bound to the same resource/backend."
ac_5 = "A real EVM request shall produce XWebFulfilled with verified signer membership and callback disposition, and a real kernel paid request shall produce a committed observation and correct payout; insufficient funding/quorum, wrong membership and wrong asset/price shall refuse."
ac_6 = "Candidate image/config identity, account/registration read-backs and nonsecret receipt references shall be retained after restart; private attestor operation shall not require validator changes or API1 DNS movement."

[req.181]
title = "Sponsor a consent-bound first transaction for an undelegated SID holder"
ac_1 = "An undelegated EOA holding sufficient six-decimal SID and no PAX shall be able to obtain a valid first-use quote and submit an account-consented sponsor-paid EIP7702 authorization plus batch."
ac_2 = "Initial nonce/replay state shall derive only from verified account-code/delegation status and the defined authorization semantics; an empty eth_call result shall not be blindly treated as zero for an incompatible or unknown account."
ac_3 = "Existing incompatible delegation, wrong chain/delegate/account, invalid low-s signature, expired authorization/quote, consumed nonce, wrong sponsor/token or excess signed maximum shall be refused before sponsor funds are committed."
ac_4 = "Success shall atomically execute the authorized calls and repay the exact governed SID amount; failed SID transfer shall revert the entire batch, and direct account execution shall retain its existing behavior."
ac_5 = "Restart during first-use submission shall recover the same durable transaction identity and reconcile delegation/receipt outcome before another nonce or charge; client consent shall display amount, maximum and deadline before signing."
ac_6 = "Sponsored EIP7702 execution shall remain distinct from the native fee-token preference path; native fee preference shall be exposed only under the actual registered upgrade and governed enabled/allowed-denom parameters, with exact six-decimal SID metadata and no inferred parameter activation."

[req.182]
title = "Drive sponsored-transaction recovery autonomously from the durable journal"
ac_1 = "The actual station binary shall run a bounded single-writer startup and periodic recovery driver over all unresolved submissions without requiring a repeated client POST."
ac_2 = "Prepared, broadcast, dropped, replaced, cancelled and finalized states shall reconcile exact signed transaction identities against finalized height/canonical block and receipt evidence before allocating or releasing sponsor nonces."
ac_3 = "A crash before/after broadcast and during replacement/cancellation shall resume exact durable bytes, retain ambiguous liabilities and avoid duplicate execution or SID repayment."
ac_4 = "Authenticated submission status and same-identity retry shall remain available after quote expiry without requiring fresh signing of the expired quote; new expired authorization shall still be refused."
ac_5 = "One unreachable RPC or unresolved submission shall yield bounded honest pending/refusal state; competing writers, corrupt journals and divergent majority observations shall fail closed."
ac_6 = "A real-process restart case shall progress to finalized settlement or verified cancellation without client resubmission and shall unblock the next safe sponsor nonce."

[req.183]
title = "Account durably for outstanding gas promises separately from historical usage"
ac_1 = "Quote policy shall distinguish active outstanding PAX liability from historical per-account/per-interval usage and finalized spend; capacity shall not remain consumed by safely expired unused or finalized completed/cancelled quotes."
ac_2 = "Every reservation/release shall have a durable identity and justified terminal event, replay exactly once on restart and preserve liabilities for ambiguous broadcasts, replacements and still-executable promises."
ac_3 = "Concurrent quote/submit/recovery operations shall enforce configured per-quote/per-account/per-interval limits and the actual sponsor balance floor without overpromising funds."
ac_4 = "Quote issuance shall have explicit authenticated binding or bounded anti-exhaustion limits appropriate to its public contract; malformed/replayed issuance shall not multiply reservations."
ac_5 = "Repeated expiry/completion and process restart shall restore the same available capacity; early release, double release, dropped-but-still-valid submission and balance deterioration shall produce refusal rather than a false available balance."

[req.184]
title = "Resume governed-rate publications from exact durable signed transactions"
ac_1 = "Before broadcast, every rate publication shall durably retain exact signed bytes plus owner/chain/paymaster/nonce/hash/rate/gas/fee identity; no private key or credential shall enter the record."
ac_2 = "After a crash between append and send, the publisher shall reconcile/rebroadcast that same prepared transaction before constructing another publication; deterministic duplicate hash shall be an idempotent recovery state rather than fatal append conflict."
ac_3 = "Replacement and cancellation shall retain one coherent nonce/liability history, bounded fee ceilings and canonical finalized outcome checks; different hashes at one nonce shall not create independent unbounded reservations."
ac_4 = "Published rates shall retain governed age, spread and owner authorization checks; publisher cadence shall be strictly below station maximum age with declared allowance for confirmation/retry, and stale/future/missing rates shall refuse new quotes."
ac_5 = "Interrupted write, changed owner/paymaster/chain, malformed bytes and uncertain finality shall fail closed while preserving history; a real publisher restart shall recover before rate age expiry when dependencies remain available."
ac_6 = "Configuration shall supply distinct named sponsor and paymaster-owner key sources, protected persistent journals, owner-controlled rate input and sufficient authorized funding; no address/rate/key shall be fabricated."

[req.185]
title = "Serve browser sponsorship requests through an explicit permitted-origin boundary"
ac_1 = "The wallet SDK shall complete quote and submission/status requests from the configured wallet origin through an authenticated same-origin gateway or an explicit station origin policy, with documented endpoint configuration."
ac_2 = "If cross-origin service is selected, OPTIONS shall accept only allowed origin/method/header combinations and return the required exact Access-Control/Vary headers; disallowed origins and unsupported methods/headers shall be refused."
ac_3 = "Public origin handling shall not bypass account/quote authorization, signature validation, replay protection, request bounds or rate limits; wildcard credentialed access shall not be introduced."
ac_4 = "A real browser-origin gate shall execute preflight and actual JSON request, then verify typed unavailable/refused/cancelled/pending/completed outcomes and authenticated recovery after restart."
ac_5 = "Client amounts shall retain SID six-decimal representation, signed maximum/deadline presentation and approved sponsor/token identity; transaction-hash receipt alone shall not be rendered as completed settlement."

[req.186]
title = "Admit only mintable recipients before EVM custody moves"
ac_1 = "Both deposit entrypoints accept exactly a nonzero EVM address left-padded to bytes32; a nonzero high prefix or zero low address is rejected before balance, nonce, outstanding or event changes."
ac_2 = "Accepted recipient bytes remain identical through BridgeDeposit, inbound digest, relayer decoding and Keeper.BridgeIn; selectors, event topics and digest layouts remain unchanged."
ac_3 = "Token and native custody use the same rule, while pause, exact token balance delta, threshold, replay and rescue restrictions remain intact."
ac_4 = "Any existing incompatible deposit is reported as requiring an explicit authorized recovery disposition; consumers never rewrite signed recipient bytes or manufacture credit."

[req.187]
title = "Bind outbound burn admission to the enforceable release amount"
ac_1 = "BridgeOut rejects a nonpositive, over-supply or above-registered-per-transaction amount before debiting, burning, incrementing nonce or emitting BridgeOut."
ac_2 = "Two independently admissible deposits cannot be combined into one burn above the active release cap; a burn at the cap remains valid."
ac_3 = "The configured Paxeer admission cap is no greater than the foreign release cap; cap changes use an explicit coordination contract that prevents new unfulfillable burns and preserves already-authorized pending releases."
ac_4 = "EVM and Solana release caps, fixed attested amount and once-only nullifier remain enforced; an existing pending burn receives a visible resolution state rather than a rewritten or split attestation."

[req.188]
title = "Advance independent outbound destinations despite item failures"
ac_1 = "A destination-specific RPC, receipt or signer error is recorded for the affected item while ready items for other EVM destinations and Solana still advance in the same bounded pass."
ac_2 = "Corrupt or unwritable shared journal state remains fatal; error isolation never permits signing or sending without a durable valid record."
ac_3 = "A restart rebroadcasts the identical pending bytes, preserves per-submitter nonce order and never duplicates completed economic effects."
ac_4 = "Repeated failures remain visible with the item and destination identity and do not cause an unbounded retry loop inside one poll."

[req.189]
title = "Provide the approved bridge attestor quorum with durable share delivery"
ac_1 = "Inventory the existing bridge relayers, approved attestor membership/threshold, signer handles, share transport and journal ownership before declaring any deployment absent or creating a replacement."
ac_2 = "The approved threshold is reached through distinct bridge attestors with independent fee-payer handles and journals; wallet membership and xweb attestors remain separate authorities."
ac_3 = "Share delivery rejects wrong-digest, unknown, duplicate and malformed shares; insufficient quorum stays waiting without submitting a partial authorization."
ac_4 = "Loss or restart of one operator preserves published valid shares and once-only completion; private keys never enter relayer configuration or shared storage."

[req.190]
title = "Publish an executable Solana relayer configuration contract"
ac_1 = "The operator runbook describes optional solana configuration, reserved chain ID, program/vault identity, commitment, slot depth, RPC quorum and separate ed25519 fee-payer handle."
ac_2 = "The release_mints activation rule and recipient PDA plus initialized token-account prerequisites are explicit; omission is described as observation-only rather than claimed outbound readiness."
ac_3 = "The example is accepted by the production configuration validator; unknown fields, wrong chain identity, invalid commitment and attestor/fee-payer handle reuse are refused."
ac_4 = "Examples carry public identity and handle references only and do not invent production addresses or credentials."

[req.191]
title = "Feed public receipt routes from verified kernel receipt provenance"
ac_1 = "A real LayerX relay/archive receipt reaches the PostgreSQL receipt projection and list/detail routes with batch, sequence, activity and proof provenance."
ac_2 = "Kernel-origin receipts do not require fabricated EVM transaction/log/block fields; EVM-derived rows retain their own provenance class."
ac_3 = "Malformed, mismatched or insufficiently authorized receipt evidence cannot acquire a verified label; no route reads private node internals or user profile data."
ac_4 = "Durable ingestion resumes after restart, deduplicates replay and rebuilds the projection from the declared public boundary."

[req.192]
title = "Restore canonical asset and account projections during rollback"
ac_1 = "Rolling back a supply-bearing receipt removes its observed supply metadata and orphan-only asset/account discovery without deleting configured pointer records."
ac_2 = "A replacement branch containing no supply update derives the last surviving canonical metadata rather than retaining an orphan value."
ac_3 = "Transfer, event, asset, account, chain-link and cursor changes commit atomically and remain consistent after database reopen."
ac_4 = "Rollback beyond the finalized boundary remains refused and configured asset metadata has explicit provenance separate from observed updates."

[req.193]
title = "Expose source-aware history freshness and readiness"
ac_1 = "Health distinguishes process/database liveness from readiness of each required ingestion source, with last successful observation and indexed/source cursor positions."
ac_2 = "A stalled or repeatedly failing LayerX source makes history readiness degraded or unavailable despite a healthy database; gateway history status preserves that state."
ac_3 = "Idle but healthy sources remain ready when current head observation succeeds; readiness does not require new transactions."
ac_4 = "After restart, persisted cursor progress is reconciled with a fresh source observation before readiness becomes positive; stale rows remain labeled with freshness."

[req.194]
title = "Return verified LayerX activity and continuation in unified account responses"
ac_1 = "GET /v1/accounts/{id}/unified serializes the complete UnifiedAccountView, including LayerX activity, achieved verification level and continuation."
ac_2 = "Before/limit parameters govern the returned LayerX page with stable ordering, bounded limits and typed invalid-cursor refusal."
ac_3 = "Identity, balances, settlement and Paxeer activity retain their existing fields; missing or unverified evidence is not upgraded by serialization."
ac_4 = "A receipt-backed nonempty response survives service restart/rebuild with stable identifiers and no discarded activity page."

[req.195]
title = "Run the standalone explorer receipt ingestion lifecycle"
ac_1 = "The standalone serving binary retrieves checkpoint/availability data through the node boundary and receipt authority through the independent verifier before publishing receipt-backed activity."
ac_2 = "An empty or behind projection reports incomplete-from-head rather than complete empty history; missing authority never produces a verified row."
ac_3 = "Cursors/checkpoints are durable or safely rebuildable, and restart converges without duplicate receipt/activity rows."
ac_4 = "Program-state refresh and receipt ingestion coexist with bounded retry and shutdown; node internals and private state are never read."

[req.196]
title = "Publish explicit index stability and settlement verification levels"
ac_1 = "The API distinguishes local reversible-depth stability from independently verified LayerX settlement and identifies the evidence source for each level."
ac_2 = "No depth-only calculation, challenge-window default or receipt ordering alone sets a settlement-final label."
ac_3 = "If settlement is claimed, the label requires verified checkpoint/anchor evidence bound to the receipt; unavailable or invalid evidence yields the corresponding lower/unknown level."
ac_4 = "Rollback and restart preserve provenance and can lower local stability when warranted without silently retaining a stronger unsupported claim."

[req.197]
title = "Navigate the complete server-paginated unified account history"
ac_1 = "The backend returns a stable continuation for every nonterminal page and the frontend requests that continuation instead of slicing only the first array."
ac_2 = "An account spanning multiple backend pages exposes every item once in the declared order; concurrent new entries do not create skipped or repeated older entries."
ac_3 = "Counts are labeled page-local unless an authoritative total is supplied; malformed, expired or wrong-account cursors fail clearly."
ac_4 = "Back/forward navigation preserves account and page identity and remains usable after reload without silently changing filters."

[req.198]
title = "Support the published bounded Programs event query in the CLI library"
ac_1 = "RpcClient accepts lx_getProgramEvents using the exact published positional parameter and bound rules and decodes the gateway response."
ac_2 = "The CLI OpenRPC fixture and strict published-method equality assertions match the authoritative gateway contract without deleting assertions or filtering the new method out."
ac_3 = "Missing, extra, malformed and out-of-bound arguments are rejected before transport; authenticated subscription behavior remains separate."
ac_4 = "The change covers the existing library interface and does not claim an unimplemented generic CLI RPC subcommand."

[req.199]
title = "Refresh receipt evidence while verification is advancing"
ac_1 = "An open nonterminal receipt detail view obtains later indexed verification evidence through bounded polling or a real invalidation subscription."
ac_2 = "The view displays freshness and distinguishes settlement rung from independently achieved verification; elapsed time alone never upgrades either."
ac_3 = "Terminal, hidden or unmounted views stop unnecessary refresh work; transient transport failure preserves the last evidence with a visible stale/error state."
ac_4 = "Reconnection resumes refresh without overlapping unbounded requests or downgrading a stronger verified row to an unsupported claim."

[req.200]
title = "Create isolated Human role runtime directories before privilege drop"
ac_1 = "Every configured Human role receives its own root-created private runtime child owned by the declared role UID/GID and mode0700 before the role drops privileges."
ac_2 = "A fresh runtime starts each role without requiring world-writable parents or permission broadening; another role UID cannot traverse or modify its child."
ac_3 = "Restart recreates ephemeral directories safely while preserving durable material/state and refusing symlinks or unexpected ownership."
ac_4 = "The selected integrated source includes the intended role-directory repair, with unmerged source reconciled explicitly rather than attributed to main."

[req.201]
title = "Produce and order the complete Human policy and authority material graph"
ac_1 = "Every consumed policy, principal-policy, authority, owner/native/naming evidence and registry document has a declared real producer or a named required owner input."
ac_2 = "Bootstrap ordering from genesis through sequencer identity, registry material, deployment journal, assembled policy and role authority is acyclic and publishes complete validated generations atomically."
ac_3 = "Missing or inconsistent inputs keep affected roles in a typed waiting/refusal state; no placeholder principal, fabricated deployment evidence or trust bypass is accepted."
ac_4 = "Restart resumes the existing generation and detects inconsistent partial publication without regenerating identity or abandoning durable Human state."

[req.202]
title = "Run the Human movement signer through the intended KMS and CA identities"
ac_1 = "The selected kernel candidate launches the Human KMS service expected by movement configuration with declared endpoint/server identity and required executor/client certificate identities."
ac_2 = "Movement and KMS use the same intended trust relationship; wrong CA, server name, client role or signer policy is refused without relaxing existing equality checks."
ac_3 = "The KMS starts only after its private role directories and validated material are available, and movement readiness reflects KMS readiness."
ac_4 = "A restart resumes authorized signing without exposing private key material or converting wallet/xweb authority into Human KMS authority."

[req.203]
title = "Require the complete configured kernel service roster for readiness"
ac_1 = "The kernel-app gate compares observed roles to an explicit expected roster and refuses a missing, duplicate, unexpected or wrong-UID role."
ac_2 = "Each role required for usable journeys has its process/material boundary checked; mere existence of one status file cannot establish whole-app readiness."
ac_3 = "Pre-genesis waiting remains an explicit permitted bootstrap state only where the contract allows it and cannot be reported as fully operational."
ac_4 = "A missing KMS or another required role fails the gate while a complete valid roster passes; evidence records the candidate identity and role-specific reason."

[req.204]
title = "Reconcile persisted Human identity bindings during explicit rotation"
ac_1 = "Before explicit key/genesis rotation, the tool inventories persisted trust history, receipt-authority replica bindings and role material and produces a concrete compatibility plan."
ac_2 = "Incompatible old bindings cannot start consumers against a new identity; they yield a precise refusal until an authorized validated migration completes."
ac_3 = "Rotation preserves custody, financial and audit state and never blindly deletes durable Human data or regenerates independent trust history."
ac_4 = "Interrupted rotation/restart resumes or restores one coherent identity generation; unchanged compatible deployments remain idempotent."

[req.205]
title = "Recover precisely quiesced Human processes after export refusal"
ac_1 = "The exporter records the exact process identities and prior running state it quiesces, with safeguards against PID reuse."
ac_2 = "An export failure produces a precise safe recovery path that resumes only those recorded processes; interruption and repeated resume are idempotent."
ac_3 = "A successful export remains quiesced until an explicit migration disposition authorizes resume or cutover, preserving a consistent snapshot."
ac_4 = "Empty manifests, failed streaming, archive mismatch and interrupted export leave source data intact and never report a successful migration."

[req.206]
title = "Verify the complete integrated CA identity roster exactly"
ac_1 = "The expected CA roster is an independently declared exact identity set matching the approved integrated services, including Human KMS roles when selected."
ac_2 = "Every expected row verifies name, ownership, role, EKU/SAN and trust properties; extra, missing, duplicate and incorrectly typed identities are rejected."
ac_3 = "Cardinality derives from that independently pinned set rather than an obsolete constant or the producer table itself; assertions are strengthened rather than removed."
ac_4 = "Existing certificate generations remain idempotent and incompatible material is refused without exposing private key values."

[req.207]
title = "Deliver one authenticated kernel identity generation to the registry"
ac_1 = "The registry receives replica identity and trust history copied byte-for-byte from the selected kernel producer over an authenticated private handoff."
ac_2 = "An independently generated history, mismatched identity, partial generation or wrong owner/mode is refused before registry readiness."
ac_3 = "Replaying or restarting the same handoff is idempotent; interrupted publication leaves the prior complete generation usable or the registry explicitly waiting."
ac_4 = "The producer order is acyclic and each registry consumer can identify which kernel generation its material belongs to without exposing secret values."

[req.208]
title = "Include the complete websearch dependency closure in its image build context"
ac_1 = "The x-websearch image stage receives its Cargo manifest, lockfile, crate source and all local path dependencies under the Dockerfile-specific ignore contract."
ac_2 = "The context excludes credentials, private evidence and unrelated large artifacts while preserving every required source input."
ac_3 = "The selected build stage produces the expected executable from the selected source revision without copying a stale prebuilt binary."
ac_4 = "A missing required manifest or path dependency is detected before publication with a precise context error."

[req.209]
title = "Credit release evidence only to an immutable clean candidate"
ac_1 = "Every focused result carries machine-readable start/end source identity, commit, clean/dirty status, command, environment, exit status and retained evidence reference."
ac_2 = "A passing dirty-tree run remains useful development evidence but cannot increase release coverage or evidence rungs."
ac_3 = "Ledger validation and report generation reject missing, changed, mismatched or dirty candidate identity for every evidence format, including plain-log gates."
ac_4 = "A source change during execution invalidates release eligibility even when the command succeeds; prior clean evidence at a different revision is never silently reused."

[req.210]
title = "Bind ephemeral runner cleanup to actual job assignment"
ac_1 = "Finished-job cleanup resolves the GitHub runner identity and actual assigned job, rather than assuming the provisioning trigger is the executing job."
ac_2 = "Two same-label runners with crossed job assignments and unequal durations cannot lose a machine while its actual job remains active."
ac_3 = "Unknown or unavailable assignment fails closed for finished-job cleanup; stopped/orphan policy remains explicit and separately bounded."
ac_4 = "Unmanaged machines are untouched, repeated reconciliation is idempotent and cleanup records the actual assignment evidence without credentials."

[req.211]
title = "Bind manually published candidate artifacts to their accepted provenance source"
ac_1 = "The publication workflow defines one explicit relationship between dispatch event SHA and accepted candidate SHA before any artifact is pushed."
ac_2 = "Either differing SHAs are refused before publication, or a supported attestation mechanism binds the exact accepted candidate source digest; image digest, source digest and signer policy all agree."
ac_3 = "The earlier-default-branch-candidate case has a deterministic accepted-and-verifiable or pre-publication refusal outcome, never an unexplained failure after promotion."
ac_4 = "Registry digest, signature, SBOM and provenance verification remain mandatory before moving promotion tags; no source-digest check is weakened."

[req.212]
title = "Maintain one current CI build and canary contract in the consolidated specification"
ac_1 = "The consolidated CI contract uses repository-root build context with docker/flyci-runner/Dockerfile and docker/flyci-controller/Dockerfile, matching their COPY inputs."
ac_2 = "Canary verification reads runner_name through the supported REST jobs API and binds it to the dispatched run; stale runnerName/old-context commands are not executable tasks."
ac_3 = "Archived recipes remain archival evidence with explicit supersession; only spec/paxeer-x/spec.kvx supplies pending task commands for the current system."
ac_4 = "Recipe checks inspect declared source paths and command contracts without dispatching workflows, changing CI_LINUX_RUNNER or claiming a historical gate reran."

