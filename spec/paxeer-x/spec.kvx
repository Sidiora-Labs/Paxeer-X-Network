[capability.111.4.23]
title = "Decode kernel asset operations in the layout the kernel encodes"
reference_namespace = "feature.111"
reqs = ["1205.5", "1205.6", "1205.7"]
touches = ["human/wallet/attestor/internal/lxwire/send.go", "human/wallet/attestor/internal/lxwire/send_test.go", "human/wallet/attestor/internal/policy/lx/lx.go", "human/wallet/attestor/internal/policy/lx/lx_test.go", "human/wallet/attestor/internal/policy/lx/testdata/kernel_activities.json", "human/wallet/attestor/internal/policy/lx/testdata/kernelvectors/Cargo.toml", "human/wallet/attestor/internal/policy/lx/testdata/kernelvectors/Cargo.lock", "human/wallet/attestor/internal/policy/lx/testdata/kernelvectors/src/main.rs", "human/wallet/attestor/internal/server/e2e_test.go", "spec/paxeer-x/evidence/111/"]
tests = []
verification_contract = "timeout 20m sh -c 'cd human/wallet/attestor && go test -count=1 ./internal/policy/... ./internal/lxwire/...'"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Add human/wallet/attestor/internal/lxwire/send.go decoding asset operation 5 only in the kernel's tagged send layout (tag 0x5301, ten fields: debit, credit, asset, amount, source sequence, idempotency key, payload expiry, context hash, at most eight not-before or not-after conditions, and the embedded authorization with kind, controller, public key, signature, signed context hash, network and protocol version), refusing any other tag, field count, condition kind, trailing byte or payload above 512 bytes, re-encoding it byte for byte, and verifying the embedded authorization signature over the signature-preimage digest of the authorization message."
do_2 = "The kernel evaluator reads the asset send's policy fields from that layout and refuses it unless the authorization is the owner kind, its controller is the debit account, its signed context hash is the context hash, its network, protocol version and idempotency key are the envelope's, its public key is the envelope authority, the debit and credit differ and the amount is not zero; the bare 112-byte transfer is refused with decode_error. Budget operation 2 is read in the tagged fund layout layerx-crypto's disclosure decodes (tag 0x4202, six fields: budget id, debit, credit, asset, amount, idempotency key) with the same envelope checks, replacing the untagged allowance layout no kernel encoder emits; asset operation 7 and Programs operation 5 keep their decoders."
do_3 = "Generate byte-level vectors with a generator under internal/policy/lx/testdata/kernelvectors that uses layerx-crypto's send debit encoder and local signer, its payment payload encoders, its payment envelope encoder and its disclosure binder: a native send, a token send with conditions, a budget fund, a grant issue and a Programs transfer that the binder accepts, and a bare transfer, an untagged allowance layout and a send with a tampered authorization that the binder refuses; the Go tests decode every vector, compare the policy fields and the re-encoding, prove the refused vectors refused, and run the accepted sends through the evaluator."
symbols = ["Send", "SendCondition", "DecodeSend", "Encode", "AuthorizationMessage", "AuthorizationValid", "DecodeEffect", "OpBudgetFund", "decodeAssetSend", "decodeBudgetFund"]

[capability.111.4.24]
title = "Sign the kernel send authorization with the attestor-held owner key"
reference_namespace = "feature.111"
reqs = ["1211.2", "1205.5", "1205.6", "1206.3"]
touches = ["human/wallet/attestor/internal/lxwire/send.go", "human/wallet/attestor/internal/lxwire/send_test.go", "human/wallet/attestor/internal/policy/lx/lx.go", "human/wallet/attestor/internal/policy/lx/lx_test.go", "human/wallet/attestor/internal/server/sign.go", "human/wallet/attestor/internal/server/server_test.go", "human/wallet/attestor/internal/server/send_authorization_test.go", "human/wallet/schema/attestor-api/v1.kvx", "human/wallet/schema/attestor-api/golden/sign.request.lx_send_authorization.json", "human/crates/layerx-human-kms/src/attestor.rs", "human/crates/layerx-human-kms/Cargo.toml", "human/crates/layerx-human-kms/tests/attestor.rs", "human/wallet/docs/security-review.md", "spec/paxeer-x/qualification.kvx"]
tests = []
verification_contract = "timeout 20m sh -c 'cd human/wallet/attestor && go test -count=1 ./internal/policy/... ./internal/server/... && cd ../../.. && cd human && cargo test -p layerx-human-kms attestor'"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Add the sign kind lx_send_authorization to human/wallet/attestor/internal/server: the request carries in activity the unsigned activity envelope of an asset send (operation 5) whose tagged send payload holds a placeholder owner authorization, the envelope authority's public key and a zero signature; the daemon decodes the send with the tagged send layout of task 4.23 through lxwire.DecodeSendForAuthorization, which differs from DecodeSend only in requiring the zero signature in place of a valid one, applies every envelope check decodeAssetSend applies (owner kind, the debit account as controller, the signed context hash, the envelope network, protocol version, idempotency key and authority), evaluates the kernel policy of lx_activity (chain id, actor did:layerx of the signing key, validity window around now, allowed module and operation, owned debit account, destination list and caps) through the durable spend ledger, and signs the 32-byte authorization digest Send.AuthorizationDigest computes with the threshold Ed25519 key; the send's amount is counted once, at the lx_activity sign of the completed envelope, while the authorization checks the caps against the ledger without recording a spend; every refusal is audited as sign.lx_send_authorization and the gateway identity requests it under the authority rules of lx_activity."
do_2 = "In human/crates/layerx-human-kms AttestorSigner gains sign_send, which builds the placeholder send from a layerx-crypto SendDebit, requests lx_send_authorization with its own session and token, verifies the returned signature over SendDebit's authorization message, embeds it with SendDebit::encode_signed, encodes the completed envelope with encode_send_envelope and signs it through sign_activity with a fresh session and token, returning the canonical envelope, its disclosure and both signatures; AttestorError::Refused carries the node, status, category, code and policy code of every refusal into its message and a code accessor, so no attestor refusal reads as a bare refused."
do_3 = "human/wallet/schema/attestor-api/v1.kvx lists lx_send_authorization with its request and signing rule and sign.request.lx_send_authorization.json is generated by the golden test; server tests over five in-process daemons prove an attestor-held send authorized and then accepted by lx_activity through the strict decoder, a refusal for a foreign debit account, a refusal outside the validity window, a refusal of a send that carries a signature, and the amount counted once; lxwire tests cover the authorization decoder; a kms test runs sign_send against the real daemon binary as the crate's attestor tests do; human/wallet/docs/security-review.md lists the kind."
symbols = ["KindLXSendAuth", "DecodeSendForAuthorization", "SendAuthorizationRequest", "EvaluateSendAuthorization", "sign_send", "KIND_SEND_AUTHORIZATION"]

[capability_group.111.5]
