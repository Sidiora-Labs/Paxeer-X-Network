[capability.107.2.12]
title = "Pin platform tools whose cargo accepts edition 2024 for every cargo build-sbf"
reference_namespace = "feature.107"
reqs = ["1151.3", "1151.5", "1154.2", "1155.2"]
touches = [".github/workflows/bridge-test.yml", "bridge/deploy/deploy-solana-program.sh", "bridge/deploy/tests/deploy-scripts-check.sh", "bridge/deploy/tests/solana-dry-run-check.sh", "bridge/deploy/tests/fixtures/solana_dry_run.json"]
