do_1 = "Implement lxp_fee_compute as a versioned integer-only function of activity type, canonical encoded byte length, metered execution units and metered storage units."
do_2 = "Round any fractional base unit upward through the basis-point ceiling helper so the fee is bit-identical on every machine, compiler and architecture."
do_3 = "Reject the activity with the fee limit code when the computed fee exceeds fee_limit, applying no module effect and charging no more than the limit."
do_4 = "Require at admission that the actor spendable balance in the fee asset is at least fee_limit, so the fee charge can never fail because of the activity own spending."
