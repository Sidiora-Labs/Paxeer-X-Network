[capability.105.17.1]
title = "Define the BatchHeader and its canonical serialisation"
reference_namespace = "feature.105"
reqs = ["1130.1", "1115.1", "1115.4", "1111.10"]
touches = ["include/layerx/lxp_batch.h", "src/sequencer/lxp_batch_header.c", "tests/test_batch_header.c", "fuzz/fuzz_batch_header.c"]
tests = []
verification_contract = "make test-batch"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Declare struct lxp_batch_header in include/layerx/lxp_batch.h carrying exactly protocol_version, network_id, epoch, batch_number, first_sequence, last_sequence, previous_state_root, resulting_state_root, activity_merkle_root, receipt_merkle_root, event_merkle_root, data_availability_root, oracle_root, timestamp_ms and sequencer_id, every field a fixed-width integer or a fixed-length hash."
do_2 = "Implement lxp_batch_header_encode and lxp_batch_header_decode on the canonical binary codec, rejecting trailing bytes, non-minimal integers, optional fields and any unknown field identifier with a deterministic result code."
do_3 = "Implement lxp_batch_header_hash under the domain tag `LX:BATCH_HEADER:v1` so a header digest can never be confused with a merkle leaf, an internal node or an activity id."
do_4 = "Add golden encoding vectors and a round-trip test proving that re-encoding any successfully decoded header reproduces the original bytes exactly."
do_5 = "Ship fuzz/fuzz_batch_header.c so the header decoder is total over arbitrary input and never allocates unbounded memory."
symbols = ["lxp_batch_header", "lxp_batch_header_encode", "lxp_batch_header_decode", "lxp_batch_header_hash"]

[capability.105.17.2]
title = "Assign contiguous gap-free global sequence numbers"
reference_namespace = "feature.105"
reqs = ["1130.2", "1130.3", "1111.5", "1122.9"]
touches = ["include/layerx/lxp_sequencer.h", "src/sequencer/lxp_sequence.c", "src/sequencer/lxp_admission.c", "tests/test_sequencer_sequence.c"]
tests = []
verification_contract = "make test-sequencer"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_seq_allocator over the durable sequence watermark so every admitted activity occupies exactly one global sequence and no number is skipped, duplicated or reused across the whole chain history."
do_2 = "Implement lxp_admission_queue as a single-producer queue whose order is admission order, never verification completion order, so worker threads cannot influence sequencing."
do_3 = "Implement lxp_batch_range_check rejecting a batch whose first_sequence is not the previous last_sequence plus one, whose last_sequence is below first_sequence, or whose previous_state_root does not equal the prior resulting_state_root."
do_4 = "Bind account_sequence consumption to global sequence assignment so an activity that fails admission is never assigned a sequence and never consumes the actor sequence."
do_5 = "Test a million-activity assignment run for contiguity, and test that a rejected activity leaves both counters untouched."
symbols = ["lxp_seq_allocator", "lxp_seq_assign", "lxp_admission_queue", "lxp_batch_range_check"]

[capability.105.17.3]
title = "Supply deterministic batch timestamps to execution"
reference_namespace = "feature.105"
reqs = ["1130.4", "1130.5", "1114.7", "1114.8", "1136.10"]
touches = ["src/sequencer/lxp_batch_time.c", "src/protocol/lxp_exec_clock.c", "tests/protocol/lxp_check_no_clock.sh", "tests/test_batch_time.c"]
tests = []
verification_contract = "make test-batch-time"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_batch_timestamp_select to choose timestamp_ms once at seal time and freeze it, and lxp_batch_timestamp_validate to reject any batch whose timestamp is not strictly greater than the previous batch or exceeds it by more than the configured forward drift bound."
do_2 = "Implement lxp_exec_clock as the only time source visible to transition functions, reading the sealed batch timestamp and nothing else."
do_3 = "Route every time-dependent decision - timestamp_bound checks, authority and grant expiry, escrow timeout, stream accrual, funding interval and governance activation - through lxp_exec_clock."
do_4 = "Add tests/protocol/lxp_check_no_clock.sh to CI to fail the build if any translation unit under src/protocol, src/state, src/ledger or src/modules references time, gettimeofday, clock_gettime or rand."
do_5 = "Test that replaying the same history a year later, on a machine with a wrong system clock, yields identical receipts and roots."
symbols = ["lxp_batch_timestamp_select", "lxp_batch_timestamp_validate", "lxp_exec_clock"]

[capability.105.17.4]
title = "Seal and sign batches over all five merkle roots"
reference_namespace = "feature.105"
reqs = ["1130.1", "1130.6", "1115.5", "1121.4"]
touches = ["src/sequencer/lxp_batch_seal.c", "src/sequencer/lxp_batch_roots.c", "tests/test_batch_seal.c"]
