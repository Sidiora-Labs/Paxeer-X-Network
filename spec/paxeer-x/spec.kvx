[capability.103.6.1]
title = "Build the layerx-node image and the genesis-bootstrapped node pod"
reference_namespace = "feature.103"
reqs = ["1060.1", "1053.1", "1053.2"]
touches = ["docker/platform-node/Dockerfile", "docker/platform-node/Dockerfile.dockerignore", "cmd/layerxctl", "Makefile", "platform/hosted/node/bootstrap.sh", "platform/hosted/node/supervisor.sh", "platform/hosted/node/deployment.yaml", "platform/hosted/node/tests", "platform/Makefile.inc"]
