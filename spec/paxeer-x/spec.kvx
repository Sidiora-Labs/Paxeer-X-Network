do_2 = "Assert that a rebuilt database reproduces every balance byte for byte, because the log and the 402LXP transfers recorded in it are the sole authority for balances."
do_3 = "Detect a projection watermark ahead of durable head and drop and rebuild rather than attempting to reconcile forward."
do_4 = "Emit the recovery metadata a rebuild needs as part of the served availability data, so a third party can rebuild without the sequencer."
