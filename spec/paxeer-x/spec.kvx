reqs = ["1208.2", "1208.3", "1208.6"]
touches = ["human/wallet/gateway/src/attestor/client.ts", "human/wallet/gateway/src/attestor/quorum.ts", "human/wallet/gateway/src/nonce/store.ts", "human/wallet/gateway/src/rpc/pool.ts", "human/wallet/gateway/src/routes/wallet.ts", "human/wallet/gateway/src/audit.ts", "human/wallet/gateway/test/attestor.test.ts", "human/wallet/gateway/test/nonce.test.ts", "human/wallet/gateway/test/rpc-pool.test.ts"]
