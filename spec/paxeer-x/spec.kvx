[task.103.6.5]
title = "Implement the layerx-identity principal and session service"
status = "done"
mode = "BUILD"
wave = 2
requires = ["0.2"]
reqs = ["1060.6", "1053.3"]
do_1 = "Reconcile the retained capability against the current candidate and explicit resolution sections. Reuse conforming implementation; complete only unmet criteria. Resolve historical paths against the current source without narrowing the capability or repeating operational transitions already completed."
do_2 = "Preserve the existing crate platform/hosted/identity (package layerx-platform-identity, binary layerx-identity) in the hosted house style listening on LAYERX_IDENTITY_LISTEN (default 0.0.0.0:9443) with rustls server TLS, a durable fsync-backed store under LAYERX_IDENTITY_STATE_DIR holding principals {sub, allowed_signer_public_keys, account, audiences} and sessions {session_id, principal, token_digest, csrf_digest, csrf_token sealed at rest with the store key, expires_at, revoked_at}, and service tokens from LAYERX_IDENTITY_SERVICE_TOKENS_DIR where each file name is the calling service (gateway, registry, webhooks, dashboard, faucet, testnet, ramp, provisioning, registrar) and the content its token."
do_3 = "Serve POST /v1/principals only for the provisioning or distinct registrar service token; serve POST /v1/sessions and DELETE /v1/sessions/{id} only for provisioning. Mint an opaque session token of the form ses_<id>.<secret> and return the token and csrf_token once. Registrar has principal-creation authority only: it cannot mint, revoke or introspect sessions, bind publication keys or use the registry-only publication-principal resolver. Registry remains distinct from registrar: its existing authenticated publication-principal resolver access grants no principal creation, session management or introspection authority. Preserve every existing service-token refusal, missing or duplicate-token startup refusal, tenant-binding check and negative assertion. Serve POST /v1/sessions/introspect and POST /v1/introspect answering per presented service token exactly the shape that caller parses with Content-Type application/json and no charset - gateway {active, sub, allowed_signer_public_keys}, webhooks and dashboard {active, sub, csrf_token}, faucet and testnet {active, sub}, ramp with audience {active, principal_id, account, audience, expires_at} - inactive for unknown, expired or revoked tokens, constant-time digest comparison, and GET /readyz unauthenticated 200 only when the store is writable, GET /livez."
do_4 = "Preserve the existing identity implementation, deployment contract, and all 39 existing tests without changing, deleting, skipping or weakening any assertion. Retain every introspection shape, revocation, expiry, wrong-service-token refusal, principal and session authority boundary, tenant binding, uncertain-write refusal, retained-history bound and store-restart case. The identity runtime sources, deployment manifests, Docker recipe, platform/Cargo.toml and platform/Cargo.lock are read-only for this task. In platform/hosted/identity/tests/service.rs only, replace lint-rejected unwrap and unwrap_err operations with explicit equivalent Result propagation or exhaustive match and failure, inline format arguments, and remove an unused receiver. Preserve all 39 tests, their assertions, refusal paths, fail-on-error behavior and timing; do not allow, suppress or lower lint checks. Other source deficiencies require an explicitly scoped follow-up and must not be hidden by the adapter."
do_5 = "Implement tools/paxeer-x/gates/103.6.5.sh, apply only the test lint corrections specified in do_4, and execute the full unchanged reference_verify_cmd: the complete layerx-platform-identity cargo test suite followed by strict cargo clippy for all targets with -D warnings. Preserve all 39 existing tests and all refusal assertions; no test-name filter, ignored-test waiver, runtime source rewrite, role widening or check relaxation is permitted. Report actual executed test and skipped counts, refuse zero tests or any skipped required case, and propagate either command failure. Retain the existing bounded verify_cmd, build/run limits and repair-cycle limits."
