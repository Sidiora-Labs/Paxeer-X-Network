obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement passkey registration and assertion as the primary credential with a fallback credential path that never weakens the passkey path."
do_2 = "Implement session issuance bound to the authenticated principal with anti-forgery protections for the browser client, expiry, refresh, per-session revocation including sign-out-everywhere, and per-principal request rate limiting with typed refusals carrying retry timing."
do_3 = "Implement step-up: a fresh passkey ceremony bound to a specific operation digest, with a validity window, required by the designated operation classes."
do_4 = "Record every device and session in the inventory with last-activity, and emit the new-device security notification."
do_5 = "Test session expiry honesty: expired sessions land on re-authentication with destination preserved, and no money operation succeeds on an expired session."
symbols = ["layerx_human_service::auth::Passkeys", "layerx_human_service::auth::StepUp"]

[capability.104.5.3]
title = "Implement the KMS keystore and the custody signer"
reference_namespace = "feature.104"
reqs = ["1067.1", "1067.2", "1067.10"]
touches = ["human/crates/layerx-human-service/src/custody/mod.rs", "human/crates/layerx-human-service/src/custody/signer.rs", "human/crates/layerx-human-service/tests/custody.rs"]
