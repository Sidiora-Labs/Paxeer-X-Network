children = ["105.19.1", "105.19.2", "105.19.3", "105.19.4", "105.19.5"]

[capability.105.19.1]
title = "Implement the six guarantor duties as one pipeline"
reference_namespace = "feature.105"
reqs = ["1131.1", "1131.2", "1131.3", "1131.5"]
touches = ["include/layerx/lxp_guarantor.h", "src/guarantor/lxp_guarantor.c", "tests/test_guarantor_duties.c"]
tests = []
verification_contract = "make test-guarantor"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_guarantor_process_batch to run the duties in the fixed order: download the complete batch body, verify every signature, replay every transition, recompute all roots, store the availability data, and only then consider signing."
do_2 = "Implement lxp_guarantor_verify_signatures over every actor signature, every session key, capability grant and delegated authority proof, every oracle signature and the sequencer header signature."
do_3 = "Implement lxp_guarantor_recompute_roots to derive resulting_state_root, activity_merkle_root, receipt_merkle_root, event_merkle_root, oracle_root and data_availability_root from first principles, trusting no sequencer-supplied value."
do_4 = "Define struct lxp_guarantor_ctx to hold the guarantor identity, its secp256k1 Paxeer-facing key, its bond view and its independent state, sharing no execution state with the sequencer."
do_5 = "Fail the pipeline closed: a duty that cannot be completed withholds attestation instead of assuming success."
symbols = ["lxp_guarantor_ctx", "lxp_guarantor_process_batch", "lxp_guarantor_verify_signatures", "lxp_guarantor_recompute_roots"]

[capability.105.19.2]
title = "Assemble threshold checkpoint certificates"
reference_namespace = "feature.105"
reqs = ["1131.6", "1131.10", "1121.7", "1121.8"]
touches = ["src/guarantor/lxp_attestation.c", "src/paxeer/lxp_checkpoint_cert.c", "tests/test_guarantor_cert.c"]
tests = []
verification_contract = "make test-guarantor-cert"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Define struct lxp_guarantor_attestation with checkpoint_id, checkpoint_hash, guarantor_id, a replayed flag, a da_possessed flag, attested_at_ms and a secp256k1 signature."
do_2 = "Implement lxp_guarantor_attest to sign only when replayed and da_possessed are both true, so one signature is simultaneously a correctness and a possession attestation."
do_3 = "Implement lxp_guarantor_cert_assemble to collect attestations sorted by guarantor_id over a byte-identical checkpoint certificate, and lxp_guarantor_cert_verify to count distinct valid signatures against the threshold."
do_4 = "Reserve an explicit optional validity-proof field in the certificate so a later version can add proofs without changing the activity envelope, the receipt format or the batch header."
do_5 = "Augment finalised receipts with activity_inclusion_proof, state_inclusion_proof, checkpoint_id, guarantor_certificate and paxeer_settlement_reference, altering no pre-checkpoint field."
symbols = ["lxp_guarantor_attestation", "lxp_guarantor_attest", "lxp_guarantor_cert", "lxp_guarantor_cert_assemble", "lxp_guarantor_cert_verify"]

[capability.105.19.3]
title = "Track bonding state and threshold eligibility"
reference_namespace = "feature.105"
reqs = ["1131.7", "1131.8", "1132.2", "1110.6"]
touches = ["src/guarantor/lxp_bond_state.c", "src/paxeer/lxp_finalisation.c", "tests/test_guarantor_bond.c"]
tests = []
verification_contract = "make test-guarantor-bond"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_guarantor_set as versioned state carrying guarantor_id, the secp256k1 public key, bond amount, joined epoch and jail flag, changed only by ordered governance activities."
do_2 = "Implement lxp_guarantor_eligible to exclude any guarantor whose bond was below the minimum at the checkpoint epoch, that is jailed, that is under an unresolved slashing action, or that governance removed - even when its signature verifies."
do_3 = "Implement lxp_checkpoint_finalisable evaluating all finalisation preconditions: threshold of distinct eligible attestations, bonds at or above the minimum, replayed and possession flags set, no equivocation, previous_state_root equal to the finalised root, challenge window elapsed and availability challenges answered."
do_4 = "Leave a checkpoint unfinalised when the threshold is not met before the deadline, settling no withdrawal, no deposit credit and no dispute against it, and keeping the previous finalised checkpoint as the anchor."
do_5 = "Test each precondition independently by making exactly one of them fail and asserting finalisation is refused with no override path."
symbols = ["lxp_guarantor_set", "lxp_guarantor_bond_state", "lxp_guarantor_eligible", "lxp_checkpoint_finalisable"]

[capability.105.19.4]
title = "Produce portable slashable equivocation evidence"
reference_namespace = "feature.105"
reqs = ["1131.9", "1130.8", "1137.8", "1115.8"]
touches = ["src/guarantor/lxp_equivocation.c", "src/paxeer/lxp_slashing_submit.c", "tests/test_equivocation.c"]
tests = []
verification_contract = "make test-equivocation"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_equivocation_detect to recognise two conflicting attestations from one guarantor for the same checkpoint_id or batch height, and the sequencer analogue of two distinct signed headers at one batch_number."
do_2 = "Define struct lxp_equivocation_evidence holding both signed statements verbatim, with lxp_equivocation_encode producing a canonical, self-contained byte string."
do_3 = "Implement lxp_equivocation_verify so any party can validate the contradiction from the evidence alone, with no trusted intermediary and no access to LayerX state."
do_4 = "Make the evidence directly submittable to the Paxeer slashing entry point and remove the offender from the active attesting set on acceptance."
do_5 = "Test that evidence produced by one node verifies unchanged on another and that a non-contradictory pair is rejected as evidence."
symbols = ["lxp_equivocation_evidence", "lxp_equivocation_detect", "lxp_equivocation_encode", "lxp_equivocation_verify"]

[capability.105.19.5]
title = "Refuse to sign on any mismatch and publish dissent"
reference_namespace = "feature.105"
reqs = ["1131.4", "1131.7", "1137.8", "1122.14"]
touches = ["src/guarantor/lxp_dissent.c", "tests/test_guarantor_disagreement.c"]
tests = []
verification_contract = "make test-guarantor-disagreement"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_guarantor_withhold as the single exit path taken when any signature, root, result code, fee, effect list or resulting balance differs by even one byte."
do_2 = "Implement lxp_guarantor_first_divergence to name the batch_number and the first divergent global_sequence rather than reporting an aggregate mismatch."
do_3 = "Implement lxp_guarantor_dissent to publish a signed dissent record and halt attestation for the epoch."
do_4 = "Add a disagreement test harness running three guarantors: one replaying to a different root, one refusing to sign, and one signing two conflicting checkpoints for the same batch number."
do_5 = "Assert the harness leaves finality withheld below threshold and yields a portable equivocation proof for the double signer."
symbols = ["lxp_guarantor_dissent", "lxp_guarantor_withhold", "lxp_guarantor_first_divergence"]

[capability_group.105.20]
title = "Build the data availability layer"
children = ["105.20.1", "105.20.2", "105.20.3", "105.20.4", "105.20.5"]

[capability.105.20.1]
title = "Commit the availability bundle in the batch header"
reference_namespace = "feature.105"
reqs = ["1132.1", "1130.1", "1115.5", "1132.9"]
touches = ["include/layerx/lxp_da.h", "src/network/lxp_da_bundle.c", "tests/test_da_bundle.c"]
tests = []
verification_contract = "make test-da"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Define the five availability classes as the complete activity batch, every receipt, every accepted oracle input with its signature, the state-diff material and the recovery metadata."
do_2 = "Implement lxp_da_bundle_build to serialise those classes in fixed order into bounded chunks of struct lxp_da_chunk, each with batch_number, chunk_index, length and a domain-separated chunk hash."
do_3 = "Implement lxp_da_bundle_root as a merkle root over chunk hashes in ascending chunk_index, and write it into the header field data_availability_root at seal time."
do_4 = "Include in the recovery metadata the module state-root vector, the account-tree frontier and the sequence watermarks, sufficient to rebuild every SQLite projection from the log alone."
do_5 = "Test that a bundle rebuilt from served bytes reproduces the committed data_availability_root exactly."
symbols = ["lxp_da_chunk", "lxp_da_class", "lxp_da_bundle_build", "lxp_da_bundle_root"]

[capability.105.20.2]
title = "Require guarantor possession attestation over every class"
reference_namespace = "feature.105"
reqs = ["1132.2", "1131.5", "1131.6", "1137.9"]
touches = ["src/guarantor/lxp_da_possession.c", "tests/test_da_possession.c"]
tests = []
verification_contract = "make test-da-possession"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_da_store_bundle so a guarantor durably persists the full bundle before any attestation step that mentions availability."
do_2 = "Implement lxp_da_possession_attest to cover all five availability classes named in the certificate and the exact data_availability_root being attested."
do_3 = "Implement lxp_da_possession_verify to reject any attestation covering fewer classes or a different availability root as invalid rather than partial."
do_4 = "Make a guarantor that replayed correctly but stored no availability data uncountable towards the finality threshold."
do_5 = "Test that possession cannot be asserted for data the guarantor does not hold, by challenging immediately after attestation."
symbols = ["lxp_da_possession_attest", "lxp_da_possession_verify", "lxp_da_store_bundle"]

[capability.105.20.3]
title = "Publish a retrieval interface agents can replay from"
reference_namespace = "feature.105"
reqs = ["1132.3", "1132.4", "1132.10", "1121.8"]
touches = ["src/network/lxp_da_service.c", "cmd/layerx-verify/lxp_verify_fetch.c", "tests/test_da_retrieval.c"]
tests = []
verification_contract = "make test-da-retrieval"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_da_serve_chunk to answer requests by batch_number and chunk_index over the canonical binary transport, returning committed bytes verbatim."
do_2 = "Define struct lxp_da_retrieval_request supporting lookup by checkpoint_id, batch_number, global_sequence range and activity_id."
do_3 = "Implement lxp_da_fetch as the client side used by layerx-verify to reconstruct state from genesis using only retrieved bundles and the public transition function, with no index database as input."
do_4 = "Implement lxp_da_verify_served_bytes so a retriever re-hashes what it received and compares against every committed root before using it."
do_5 = "Test an end-to-end retrieve-and-replay run on a second machine reproducing byte-identical receipts and roots."
symbols = ["lxp_da_serve_chunk", "lxp_da_fetch", "lxp_da_retrieval_request", "lxp_da_verify_served_bytes"]

[capability.105.20.4]
title = "Run deterministic availability sampling challenges"
reference_namespace = "feature.105"
reqs = ["1132.5", "1132.6", "1132.10", "1114.8"]
touches = ["src/guarantor/lxp_da_challenge.c", "src/paxeer/lxp_da_challenge_record.c", "tests/test_da_challenge.c"]
tests = []
verification_contract = "make test-da-challenge"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_da_challenge_indices to derive challenged chunk indices deterministically from the checkpoint hash and the chunk count, so no randomness ever enters execution."
do_2 = "Implement lxp_da_challenge_issue and lxp_da_challenge_respond so a challenged guarantor returns the chunk plus an inclusion proof against data_availability_root inside the configured response window."
do_3 = "Implement lxp_da_challenge_judge to treat a missing, late, non-hashing or non-proving response as an availability failure rather than a satisfied request."
do_4 = "Record failures on Paxeer, make them slashable under the availability policy, and exclude the guarantor from later availability and finality thresholds until governance restores it."
do_5 = "Publish the mismatching signed commitment together with the served bytes as evidence whenever a response fails to verify."
symbols = ["lxp_da_challenge_indices", "lxp_da_challenge_issue", "lxp_da_challenge_respond", "lxp_da_challenge_judge"]

[capability.105.20.5]
title = "Simulate unavailability and block finalisation"
reference_namespace = "feature.105"
reqs = ["1132.7", "1132.8", "1137.9", "1133.8"]
touches = ["src/paxeer/lxp_finalisation.c", "tests/paxeer/lxp_da_withhold.sh", "tests/test_da_unavailable.c"]
tests = []
verification_contract = "make test-da-unavailable"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Build tests/paxeer/lxp_da_withhold.sh and lxp_da_withhold_sim to withhold, one class at a time, the activity batch, the receipts, the oracle inputs, the state-diff material or the recovery metadata."
do_2 = "Implement lxp_checkpoint_block_on_da so an unfinalised checkpoint whose data is unavailable can never be finalised, and no withdrawal, deposit credit or dispute settles against it."
do_3 = "Implement lxp_da_unavailable_mode so unavailability behind an already finalised checkpoint keeps that checkpoint valid for emergency exit, halts further finalisation and resumes only on restored availability or a governance reconstitution of the guarantor set."
do_4 = "Assert in the test that agents can detect the unavailability from public information alone."
do_5 = "Assert that no availability attestation can be produced for withheld data in any of the five withholding scenarios."
symbols = ["lxp_da_withhold_sim", "lxp_da_unavailable_mode", "lxp_checkpoint_block_on_da"]

[capability_group.105.21]
title = "Build the governance module, fees and resource metering"
children = ["105.21.1", "105.21.2", "105.21.3", "105.21.4", "105.21.5", "105.21.6"]

[capability.105.21.1]
title = "Hold protocol parameters as versioned state"
reference_namespace = "feature.105"
reqs = ["1129.1", "1129.10", "1113.9", "1114.6"]
touches = ["include/layerx/lxp_governance.h", "src/modules/governance/lxp_params.c", "tests/test_governance_params.c"]
tests = []
verification_contract = "make test-governance"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_param_table mapping parameter identifiers to value, activation epoch, proposed value and proposal id, iterated in canonical byte-lexicographic key order."
do_2 = "Implement lxp_param_version so every execution resolves parameters through an explicit version and every receipt records the parameter_version in force."
do_3 = "Implement lxp_param_set_bounds declaring the legal range and target module of every key, so an out-of-bounds or unknown key is rejected rather than clamped."
do_4 = "Implement lxp_param_get as the only read path, forbidding any module from caching a parameter across an epoch boundary."
do_5 = "Test that replaying a historical batch resolves the parameter values of that batch epoch, not the newest values."
symbols = ["lxp_param_table", "lxp_param_get", "lxp_param_version", "lxp_param_set_bounds"]

[capability.105.21.2]
title = "Enact parameter changes with activation delay and staged rollout"
reference_namespace = "feature.105"
reqs = ["1129.2", "1129.3", "1129.4", "1129.5"]
touches = ["src/modules/governance/lxp_gov_param.c", "tests/test_governance_activation.c"]
tests = []
verification_contract = "make test-governance-activation"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_gov_param_propose to record target_module, parameter_key, proposed_value, activation_epoch and rollout_scope as an ordered activity signed by the governance authority."
do_2 = "Reject a proposal naming an activation_epoch earlier than the current epoch plus the minimum activation delay, an unknown module or key, or a value outside declared bounds, with no state change beyond sequence and fee."
do_3 = "Implement lxp_gov_activation_apply to apply the new value atomically at the first batch whose epoch equals the pending activation epoch and to increment parameter_version at that deterministic boundary."
do_4 = "Implement lxp_gov_stage_cohort so a staged rollout applies only to the enumerated cohort by module, market or account set, leaving every other cohort on the prior value until its own stage activates."
do_5 = "Reject retroactive application outright and preserve the original versioned transition function for sequences already sealed."
do_6 = "Test that two replicas activating from different starting snapshots compute the identical resulting_state_root at the activation boundary."
symbols = ["lxp_gov_param_propose", "lxp_gov_param_enact", "lxp_gov_activation_apply", "lxp_gov_stage_cohort"]

[capability.105.21.3]
title = "Implement scoped emergency pause and emergency mode"
reference_namespace = "feature.105"
reqs = ["1129.6", "1129.7", "1129.8", "1129.9"]
touches = ["src/modules/governance/lxp_emergency.c", "tests/test_governance_emergency.c"]
tests = []
verification_contract = "make test-governance-emergency"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_gov_emergency_halt to apply a pause at the declared scope of one module, one market or the whole network, recorded as an ordered activity."
do_2 = "Implement lxp_pause_scope_check so every submitted activity inside a paused scope is rejected with the paused-scope result code while activities outside that scope remain fully executable."
do_3 = "Keep ordering, sealing, distribution and checkpointing running while paused, and keep receipts, inclusion proofs and balance proofs servable so withdrawal and exit paths stay usable."
do_4 = "Implement lxp_gov_emergency_resume requiring an explicit signed governance activity, never elapsed wall-clock time and never an implicit background timer."
do_5 = "Reject any governance activity that would write a balance, mint or burn supply, alter an issued receipt, rewrite a sealed batch or substitute a state root."
do_6 = "Test module-scoped, market-scoped and network-scoped pauses independently, including that a paused perps market still permits order cancellation paths defined by that module."
symbols = ["lxp_gov_emergency_halt", "lxp_gov_emergency_resume", "lxp_pause_scope_check", "lxp_gov_module_enable"]

[capability.105.21.4]
title = "Compute fees deterministically and charge them as a transfer"
reference_namespace = "feature.105"
reqs = ["1135.1", "1135.4", "1116.4", "1122.1"]
touches = ["src/protocol/lxp_fee.c", "src/modules/governance/lxp_fee_params.c", "tests/test_fees.c"]
tests = []
verification_contract = "make test-fees"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_fee_compute as a versioned integer-only function of activity type, canonical encoded byte length, metered execution units and metered storage units, using checked fixed-width arithmetic only."
do_2 = "Apply exactly one rounding rule that rounds any fractional base unit upward, and prove bit-identical results across compilers, optimisation levels and architectures."
do_3 = "Implement lxp_fee_charge to move the fee as a 402LXP transfer from the actor main account to system fees, through the single balance-mutation primitive and no other path."
do_4 = "Record the charged amount in the receipt field fee_charged and guarantee it never exceeds the declared fee_limit."
do_5 = "Implement lxp_fee_schedule resolved from governance parameters at the batch epoch so historical fees stay reproducible after later parameter changes."
do_6 = "Test per-asset conservation: the sum of fee debits equals the sum of fee treasury credits over a long replay."
symbols = ["lxp_fee_charge", "lxp_fee_schedule", "lxp_fee_treasury_account"]

[capability.105.21.5]
title = "Meter execution and storage against fee_limit"
reference_namespace = "feature.105"
reqs = ["1135.2", "1135.3", "1135.7", "1135.8"]
touches = ["src/protocol/lxp_meter.c", "tests/test_metering.c", "fuzz/fuzz_meter.c"]
tests = []
verification_contract = "make test-metering"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_meter_ctx accumulating execution units and net state storage bytes for the activity currently executing on the single writer."
do_2 = "Implement lxp_meter_charge_exec and lxp_meter_charge_storage at every metered site, pricing storage growth at the storage rate parameter in force for that batch."
do_3 = "Implement lxp_meter_exhausted to abort with the deterministic resource exhaustion result code when either metered quantity exceeds its governance ceiling."
do_4 = "Reject any envelope lacking fee_limit or encoding it as a floating point or ambiguous numeric value, and require the actor spendable balance to be at least fee_limit at admission."
do_5 = "Reject with the arithmetic overflow result code rather than wrapping, saturating or truncating at any step of metering accumulation or treasury credit."
do_6 = "Add fuzz/fuzz_meter.c driving adversarial payload shapes at the metering path."
symbols = ["lxp_meter_ctx", "lxp_meter_charge_exec", "lxp_meter_charge_storage", "lxp_meter_exhausted"]

[capability.105.21.6]
title = "Apply one fee rejection policy and prove fee replay"
reference_namespace = "feature.105"
reqs = ["1135.5", "1135.6", "1135.9", "1135.10", "1122.1"]
touches = ["src/protocol/lxp_fee_policy.c", "tests/test_fee_replay.c"]
tests = []
verification_contract = "make test-fee-replay"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_fee_admission_check so an activity failing admission is assigned no global sequence, consumes no account sequence and is charged nothing."
do_2 = "Implement lxp_fee_rejection_policy so an admitted activity that fails execution consumes its account sequence exactly once, is charged the computed fee up to fee_limit, and yields a durable failure receipt with zero module effects."
do_3 = "Charge the fee before applying any module effect so the fee transfer can never fail because of the activity own spending."
do_4 = "Implement lxp_fee_replay_check asserting that replay from the log reproduces every fee_charged value, the fee treasury balance and every resulting state root exactly."
do_5 = "Test the boundary where the computed fee equals fee_limit exactly, and the case where it exceeds it by one base unit."
symbols = ["lxp_fee_rejection_policy", "lxp_fee_admission_check", "lxp_fee_replay_check"]

[capability_group.105.22]
title = "Build the Paxeer contracts and the bridge module"
children = ["105.22.1", "105.22.2", "105.22.3", "105.22.4", "105.22.5", "105.22.6"]

[capability.105.22.1]
title = "Deploy custody and checkpoint registration contracts"
reference_namespace = "feature.105"
reqs = ["1133.1", "1110.2", "1110.3", "1110.4"]
touches = ["contracts/LayerXCustody.sol", "contracts/CheckpointRegistry.sol", "src/paxeer/lxp_paxeer_client.c", "tests/test_paxeer_custody.c"]
tests = []
verification_contract = "make test-paxeer"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Define the custody contract surface to accept exactly six inputs: a finalised checkpoint certificate, membership or balance proofs against its state root, withdrawal nullifiers, guarantor signatures, challenge-window state and emergency-exit eligibility."
do_2 = "Implement lxp_checkpoint_register to submit only the header commitments of a checkpoint, never individual activity envelopes, payloads or receipts."
do_3 = "Implement lxp_paxeer_verify_cert on the contract side to count distinct bonded guarantor signatures over the checkpoint hash and advance the registered finalised state root."
do_4 = "Keep the contract free of any LayerX business logic: no perps order, no market or funding rule, no service agreement, no escrow or budget rule and no ordinary transfer is interpretable by it."
do_5 = "Test that a checkpoint carrying millions of underlying activities registers as one submission whose payload size is independent of activity count."
symbols = ["lxp_checkpoint_register", "lxp_checkpoint_registry_state", "lxp_paxeer_verify_cert", "lxp_paxeer_custody_abi"]

[capability.105.22.2]
title = "Hold guarantor bonds and execute slashing on Paxeer"
reference_namespace = "feature.105"
reqs = ["1131.8", "1131.9", "1110.6", "1137.8"]
touches = ["contracts/GuarantorBond.sol", "src/paxeer/lxp_bond_client.c", "tests/test_paxeer_bond.c"]
tests = []
verification_contract = "make test-paxeer-bond"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement the bond contract holding per-guarantor bonds with an explicit minimum expressed as a fraction of custodied value, and expose lxp_paxeer_bond_state to LayerX as read-only mirrored state."
do_2 = "Implement lxp_paxeer_slash_submit to accept a portable equivocation proof from any party and slash without any judgement about correctness, because the contradiction is self-evident."
do_3 = "Implement lxp_paxeer_jail_guarantor to remove a slashed or under-bonded guarantor from the active attesting set immediately."
do_4 = "Exclude signatures from jailed, removed or under-bonded guarantors from every threshold count even when cryptographically valid."
do_5 = "Test slashing driven purely by the evidence bytes produced in the guarantor task, submitted by a third party with no privileged access."
symbols = ["lxp_paxeer_bond_deposit", "lxp_paxeer_bond_state", "lxp_paxeer_slash_submit", "lxp_paxeer_jail_guarantor"]

[capability.105.22.3]
title = "Credit deposits only against a finalised custody proof"
reference_namespace = "feature.105"
reqs = ["1133.2", "1133.3", "1122.12", "1116.6", "1120.6"]
touches = ["include/layerx/lxp_bridge.h", "src/modules/bridge/lxp_bridge_deposit.c", "tests/test_bridge_deposit.c"]
tests = []
verification_contract = "make test-bridge-deposit"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_deposit_proof_verify to require a Paxeer deposit proof bound to a finalised checkpoint, matching network_id and protocol_version, before any credit is considered."
do_2 = "Implement lxp_bridge_deposit_credit to perform the credit as one authenticated transfer from system paxeer-reserve to the agent main account, through the single balance-mutation primitive."
do_3 = "Implement lxp_deposit_nullifier and record consumed deposit identifiers so a replayed proof credits at most once."
do_4 = "Reject a deposit whose proof is absent, unverifiable, references an unfinalised checkpoint or reuses a consumed identifier, crediting nothing."
do_5 = "Assert the credit is conserving: total LayerX supply of the asset is unchanged because the reserve mirror already held the units."
symbols = ["lxp_bridge_deposit_credit", "lxp_deposit_proof_verify", "lxp_deposit_nullifier"]

[capability.105.22.4]
title = "Settle withdrawals under nullifiers and challenge windows"
reference_namespace = "feature.105"
reqs = ["1133.4", "1133.5", "1133.6", "1133.7", "1122.13"]
touches = ["contracts/WithdrawalClaims.sol", "src/modules/bridge/lxp_bridge_withdraw.c", "tests/test_bridge_withdraw.c"]
tests = []
verification_contract = "make test-bridge-withdraw"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_bridge_withdraw_request to debit the agent by an authenticated transfer into system paxeer-withdrawals, so the LayerX debit is committed and checkpointed before any payout is claimable."
do_2 = "Implement lxp_withdrawal_nullifier as a domain-separated deterministic function of network_id, withdrawal_id, account, asset, amount and checkpoint_id, recorded identically on both ledgers."
do_3 = "Implement the Paxeer claim path to require a balance or membership proof against a finalised checkpoint state root plus threshold guarantor signatures, and to reject an already-recorded nullifier before doing any other work."
do_4 = "Implement lxp_paxeer_challenge_window to hold payouts while the window is open and to cancel payouts and slash attesting guarantors when a fraud, availability or equivocation challenge succeeds."
do_5 = "Implement lxp_bridge_withdraw_finalize to retire the withdrawal against the reserve mirror exactly once per nullifier."
do_6 = "Test double payment attempts by resubmission, by an alternative inclusion proof, by a later checkpoint and after a settlement-chain reorganisation."
symbols = ["lxp_bridge_withdraw_request", "lxp_bridge_withdraw_finalize", "lxp_withdrawal_nullifier", "lxp_paxeer_challenge_window"]

[capability.105.22.5]
title = "Execute emergency exit against the last finalised checkpoint"
reference_namespace = "feature.105"
reqs = ["1133.8", "1133.9", "1110.10", "1122.13"]
touches = ["contracts/EmergencyExit.sol", "src/modules/bridge/lxp_bridge_exit.c", "tests/test_emergency_exit.c"]
tests = []
verification_contract = "make test-emergency-exit"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_exit_eligibility to declare exit availability when no checkpoint has finalised within the liveness bound, when governance declares an emergency, or when a fraud claim against the latest checkpoint is accepted."
do_2 = "Implement lxp_exit_claim_build to assemble a claim from the finalised certificate, its state root, a balance proof and the recorded guarantor signatures, and nothing else."
do_3 = "Implement lxp_exit_verify_balance_proof on the contract side so the exit requires no sequencer cooperation, no newly sealed batch and no ongoing guarantor liveness."
do_4 = "Compute exits from finalised state only and state plainly that activities sequenced after the last finalised checkpoint are discarded, not honoured."
do_5 = "Share the nullifier space between ordinary withdrawals and exits so one withdrawal_id can never pay through both routes."
symbols = ["lxp_exit_declare", "lxp_exit_claim_build", "lxp_exit_eligibility", "lxp_exit_verify_balance_proof"]

[capability.105.22.6]
title = "Reconcile reserves at the custody boundary"
reference_namespace = "feature.105"
reqs = ["1133.10", "1123.10", "1120.8", "1122.5"]
touches = ["src/modules/bridge/lxp_reserve.c", "tools/lxp_reserve_report.c", "tests/test_reserve_reconcile.c"]
tests = []
