[resolution.34]
title = "Canonical commit with deterministic parallel Programs execution"
contract = "Retain one active sequencer and one canonical ordered commit authority. Permit nonconflicting Programs activities to execute on private candidates in parallel under declared access sets; commit in canonical order with roots, receipts, events and fuel identical to serial execution. Absent access declarations conservatively conflict. General role-worker settings must describe real work."
applies_to = ["contract_context.105.decision.sequencing", "req.1114.ac_9", "capability.105.5.6", "capability.105.6.3"]

[resolution.35]
title = "Versioned runtime language boundary"
contract = "Keep the C17 native kernel and canonical ABI authoritative while permitting the already specified deterministic Rust Programs runtime behind bounded C FFI, and Go custody proof/native Paxeer boundary tooling. Preserve integer determinism, ownership, bounds and no ambient guest authority across FFI. The legacy blanket prohibition of Rust anywhere linked into runtime is superseded for this named Programs boundary, not a license for ad-hoc implementations."
applies_to = ["contract_context.105.decision.language"]

[resolution.36]
title = "One supported ABI contract across the complete Programs lifecycle"
contract = "Retain historical ABI1 semantics; explicitly support admitted guest ABI1..4 under a shared policy for validation, interfaces, Deploy, Upgrade with migration, Call, account capabilities, authenticated views, wind-down, source verification, bindings and language SDKs. ABI2..4 account capabilities must follow their actual versioned host contract. Reject unknown versions/downgrades consistently; bind code hash, runtime, ABI and fee versions in receipts and cache keys. Repair incomplete consumers before declaring support complete."
applies_to = ["req.1113.ac_6", "req.1114.ac_6", "req.1115.ac_6"]

[resolution.37]
title = "Native mainnet settlement and retained private Solidity settlement"
contract = "Paxeer X mainnet uses registry0x1004, custody0x1013 and anchor0x1014 on chain125 through the configured trusted Paxeer boundary. Retain all Solidity primitive, custody, migration, deterministic-deployment and contract qualification contracts as private-network capability. Mainnet final integration must use the native boundary and must not deploy Anvil/Solidity settlement as a substitute. Keep nodes/validators established running."
applies_to = ["req.1133", "req.1138", "capability.105.22", "capability.105.24.6", "capability.105.24.7", "capability.105.24.8", "capability.105.24.9", "capability.105.24.10"]

[resolution.38]
title = "Versioned custody proof profiles and advancing trust"
contract = "Current native mainnet custody uses LXBC3/LXDC3 and LXLB1 with explicit immutable profile/domain plus authenticated evolving light trust. Keep LXBC1/LXDC1 and LXBC2/LXDC2 exact historical/private verification contracts; do not reinterpret bytes or present LXDC2 fixed proof offsets as the LXDC3 contract. Proof construction and kernel/publication verification must select the same authenticated per-asset trust state, progress across validator changes, enforce trust expiry and refuse caller-selected unauthenticated resets. Supply all required asset profiles before claiming multi-asset funding."
applies_to = ["req.1133.ac_11", "req.1133.ac_12", "req.1123.ac_7", "capability.105.22.3"]

[resolution.39]
title = "Historical finality and current signer eligibility"
contract = "Bind new checkpoint admission to the configured eligible bonded signer set and final status. Verify already finalized history against authenticated membership and policy at its registration/checkpoint context; later removal, bond-policy change or signer rotation must not alone invalidate a finalized record on replay. Keep exact certificate, domain, header, receipt/event, availability and finality checks. For nonzero challenge windows persist pending progression until FINAL; do not treat SUBMITTED as final."
applies_to = ["req.1131.ac_8", "req.1132.ac_8", "req.1133.ac_7"]

[resolution.40]
title = "Fresh genesis and explicit imported-state migration"
contract = "Fresh mainnet genesis opens zero balances with signed schedules, custody profiles and both canonical state and receipt-state root domains; use the correct settlement root field. Funding follows verified custody credit, never invented preload/faucet balances. Preserve the complete migration/import categories and shadow comparison as a distinct intentional import path requiring reconciliation and registered genesis; an existing database cannot replace the signed manifest. Inventory whether any legacy authority is actually being migrated before making cutover claims."
applies_to = ["req.1136", "capability.105.24.1", "capability.105.24.2", "capability.105.24.3", "capability.105.24.4", "capability.105.24.5"]

[resolution.41]
title = "Native issuance and custody reserve accounting are distinct"
contract = "Preserve one transfer primitive and per-transfer conservation. Native registration creates explicit finite issuance reserve; authorized mint/burn transfer from/to it and bind total_units. Custody assets instead reconcile verified custody, circulating balances, outstanding withdrawals and settled amounts without double-counting reserve/issuance mirrors. Supersede blanket all-assets-equal-custody and bridge-only supply wording with req14.ac10..12; no arbitrary direct balance write."
applies_to = ["req.1120.ac_6", "req.1120.ac_8", "req.1123", "req.1136.ac_3", "req.1137.ac_11"]

[resolution.42]
title = "Complete versioned account namespaces"
contract = "Account validation retains historical IDs and adds the explicitly specified per-asset, stream, per-market funding, internal module value and program-derived accounts with exact canonical derivation and reserved authority. Protocol3 OPEN/CREATE derives and atomically creates zero-balance escrow/budget/stream accounts; reject collisions, wrong asset/kind and unauthorized reserved debits. Do not treat req10.ac2 old namespace list as exhaustive for newer versions."
applies_to = ["req.1112.ac_1", "req.1119.ac_2", "req.1119.ac_11", "req.1123.ac_12"]

[resolution.43]
title = "Explicit versioned refusal and replay policy"
contract = "Resolve and record the complete admission/ordered-execution/acknowledged-terminal-refusal policy before release. Current terminal refusal consumes global sequence and durable idempotency state but no actor sequence or fee; old req26.ac6 specifies only two classes. Either explicitly version that third class with client/replay semantics or align implementation to an approved two-class contract; preserve existing assertions until the normative choice is made. Failure ActivityReceipts may bind fee effects; they never prove successful payment. Retry returns the original result without a second debit; distinguish replay rejection from receipt retrieval."
applies_to = ["req.1111.ac_5", "req.1111.ac_7", "req.1117.ac_4", "req.1117.ac_10", "req.1121.ac_10", "req.1135.ac_6"]

[resolution.44]
title = "Protocol3 maintenance sequence and fee schedule compatibility"
contract = "New protocol3 batches reserve the final global sequence for exactly one maintenance receipt and effects leaf, including zero-frame effects; activities precede it. Use the signed batch timestamp and authenticated epoch/term, canonical module/key order and atomic candidate/WAL/DA publication. Current admission refuses missing maintenance; explicitly historical authenticated occupancy-only recovery retains its decoder. Fee schedules1..4 retain exact bytes/roots; version4 requires both256/112-byte governance values, named prices and independent Programs CALL fees."
applies_to = ["req.1115.ac_11", "req.1130.ac_2", "req.1130.ac_11", "req.1130.ac_12", "req.1123.ac_15", "req.1123.ac_16"]

[resolution.45]
title = "Canonical timestamp and expiry equality boundaries"
contract = "Retain strict increasing sealed batch timestamps and bounded forward drift from req21.ac5; nondecreasing execution time is the weaker general invariant. Specify each authority/grant/activity expiry comparator in versioned vectors, including equality: req3.ac6 says at-or-after, while SEND and RECEIVE expiry clauses say strictly-greater. Resolve this equality conflict per accepted protocol version before release; never silently normalize historical behavior."
applies_to = ["req.1112.ac_6", "req.1114.ac_7", "req.1117.ac_5", "req.1118.ac_7", "req.1130.ac_5"]

[resolution.46]
title = "Public router transport and private canonical ingress"
contract = "Public product operations use https://api-mainnet-beta.paxeer.network and its authenticated declared routes, including JSON-RPC /rpc and /rpc/ws. Canonical signed bytes and proof verification remain authoritative. Trusted native LNI stays a bounded peer-authenticated Unix socket; router failure does not authorize exposing it or reviving port18545. Keep native/direct adapters only as explicitly private surfaces. Archive sync routes and authority-replica evidence routes are distinct origins and readiness must exercise their real contracts."
applies_to = ["contract_context.105.decision.wire", "req.1115.ac_7", "req.1134.ac_9", "req.1134.ac_10", "capability.105.23.5"]

[resolution.47]
title = "Current x402 envelope with retained explicit legacy validation"
contract = "The public HTTP payment contract is402lxp/protocol.md x402Version2 PAYMENT-REQUIRED/PAYMENT-SIGNATURE/PAYMENT-RESPONSE with bounded alternatives and exact/metered/subscription schemes. The older nine-field signed service requirement is a separate explicitly versioned legacy/private format, not mandatory undeclared fields inserted into v2. Preserve payer authorization, purpose/resource/request binding, expiry, exact asset/amount/payee checks, invoice single-settlement and independent receipts across adapters. Do not weaken any supported legacy signature validation."
applies_to = ["req.1134.ac_1", "req.1134.ac_2", "capability.105.23.1", "capability.105.23.2", "capability.105.23.3"]

[resolution.48]
title = "No automatic payment success or release-evidence promotion"
contract = "A grant, HTTP200, acknowledgement, pending state, transaction hash or certificate presence is never successful settlement by itself. Verify selected commitment, exact signed facts and configured authority; unknown results retain exact signed bytes and resource/budget reservations through restart. Release evidence additionally binds the clean integrated candidate and deployed identity; old task done, source presence, branch repair or image publication never proves current deployment."
applies_to = ["req.1121", "req.1134", "req.1137", "capability.105.25"]

[req.428]
title = "Qualify production replay at scale across architectures"
ac_1 = "Replay at least10000000 real signed canonical activities spanning every supported activity type through production kernel, ledger, modules and replica reconstruction; independent expected roots exist at every batch boundary and terminal state."
ac_2 = "Machines, operating systems, compilers, optimization levels and CPU architectures include64-bit and non-x86; compare exact activity bytes, receipts, events, batch headers, fuel and roots, failing any byte difference."
ac_3 = "Exercise serial and deterministic parallel Programs execution, historical ABI/fee/maintenance versions, more than512 durable idempotency entries and restart without dropping replay protection."

[req.429]
title = "Qualify durable recovery, partitions and authorized sequencer handover"
ac_1 = "Inject process termination at every distinct log/index/checkpoint/WAL/publication durable write boundary; each activity or transfer set is fully present or absent, with no partial receipt visibility."
ac_2 = "Restart reproduces exact root/receipt/idempotency results and resumes sequence without gap, reuse or reorder, including maintenance and terminal refusals under the resolved policy."
ac_3 = "Replica isolation, loss, reorder and prolonged sequencer loss never finalize conflicting sequence ranges; only authenticated governance handover permits the successor, with old history readable."

[req.430]
title = "Qualify adversarial canonical decoding, signatures and transfer sets"
ac_1 = "Malformed/truncated/overlong/deep/noncanonical/mutated inputs deterministically refuse without crash, hang, out-of-bounds access, unbounded memory or state change."
ac_2 = "Reject malleated/truncated/zero/wrong-curve/wrong-domain/wrong-network signatures over the exact canonical bytes and preserve original admission/fee policy."
ac_3 = "Fuzz real registered decoders, Programs sandbox/lifecycle/ABI boundaries, grant/receive/payment envelopes and atomic transfer sets seeded from real valid activity corpus; every refusal is attributable."

[req.431]
title = "Qualify checked arithmetic and complete sanitizer coverage"
ac_1 = "Every128/256-bit add/subtract/multiply/divide has exhaustive boundaries and machine-checked exact-result-or-error obligations; every rounding direction is explicit and conservation holds."
ac_2 = "Consensus paths contain no floating-point computation and every supported module/ABI retains integer metering and overflow refusal."
ac_3 = "The entire production test/fuzz/replay corpus runs under address, undefined-behavior, thread and memory sanitizers plus a leak checker, with zero errors/leaks/races; disabled checks or unreviewed suppression fails."

[req.432]
title = "Qualify native custody, guarantor disagreement, availability and exits"
ac_1 = "Against the actual approved native custody/anchor configuration, independently replaying bonded guarantors withhold finality below threshold, publish dissent for root mismatch and produce portable equivocation evidence sufficient for the configured slashing path."
ac_2 = "Withhold each required availability class and reject possession/finality; corruption refuses. Historical finalized evidence remains verifiable through permitted membership changes and restart."
ac_3 = "Exercise each supported custody asset deposit, proof trust advance and withdrawal at most once; reject wrong-domain, stale/untrusted, changed amount/recipient and reused nullifier proofs; pending challenge windows never become final prematurely."
ac_4 = "Emergency exit succeeds against approved real custody with sequencer offline/uncooperative, using last finalized proof and unspent nullifier without new batch or live guarantor assistance; preserve payout delays."
ac_5 = "Reconcile every custody asset exactly across all account classes and outstanding/settled claims with no reserve mirror double-count; native issuance follows its separate supply invariant and every historical transfer conserves."

[req.433]
title = "Qualify explicit migration and continuous shadow equivalence"
ac_1 = "Signed import manifest separately accounts for balances/reserves/holds/queued withdrawals/liquidity/insurance/positions/orders/funding/DID-EVM bindings and old receipts/roots, reconciled by asset and issuer kind."
ac_2 = "Any missing/mismatched custody category refuses the whole import, never partial materialization; locked value becomes real accounts and old receipts remain immutable and non-reexecutable."
ac_3 = "Where authority migration is selected, continuous real accepted legacy activity is shadowed without modifying the legacy system; every outcome/order/balance/fee/result/receipt divergence blocks promotion unless explicitly specified as an intentional version difference."
ac_4 = "Fresh genesis release declares zero import and proves custody-based initial funding; this is not evidence of a completed legacy migration."

[req.434]
title = "Qualify independent C API and wire conformance"
ac_1 = "An independently written implementation accepts every valid vector, refuses each adversarial/noncanonical vector, and reproduces exact identifiers/hashes/Merkle roots/receipts for all supported versions."
ac_2 = "An independent party verifies public C-header return codes, ownership/lifetimes/thread safety and sole balance-writer enforcement, including cross-language Programs ABI boundaries."
ac_3 = "Conformance includes resolved terminal-refusal and equality-boundary policy, account namespaces, maintenance/schedule versions and old bytes preserved; unknown versions refuse rather than normalize."

[req.435]
title = "Qualify complete402 payments through the unified public router"
ac_1 = "Real exact, metered and subscription buyer/seller flows settle registered native and custody assets under executed/batched/finalised commitments with independently verified receipts and successful resource fulfillment."
ac_2 = "Reject altered accepted offers, asset/amount/payee/payer/purpose/resource/activity bindings, unknown schemes/versions, bad signatures, expiry/revocation/allowance violations, excessive fees and weaker commitments."
ac_3 = "Concurrent retry, HTTP200 error, pending result, timeout and crash before/after submission preserve exact signed bytes and request/period/budget reservations; one receipt never releases two requests and restart cannot double debit."
ac_4 = "Public traffic uses router /rpc and /rpc/ws only as declared; native ingress stays private; unavailable router/proof never falls back to retired18545, faucet funding or unverified success."

[req.436]
title = "Qualify retained private-network contract systems"
ac_1 = "Private settlement manifest binds chain/protocol/release/config, deterministic addresses and runtime code hashes, with exact role completeness and collision refusal."
ac_2 = "Every external state-changing function has unit/fuzz/invariant/negative coverage including migration replay/partial execution/downgrade/storage mismatch/selector bounds/malicious returndata/decimal dust/cross-chain replay and direct/delegated-call rules."
ac_3 = "Custody conservation, one-time payouts, governance limits, no arbitrary execution or balance writes and exact historical wire bytes remain enforced; this evidence is never labeled native mainnet deployment."

[req.437]
title = "Qualify bounded real-value canary and final candidate identity"
ac_1 = "Declare approved real-agent canary duration and exposure cap before starting; general availability requires the full elapsed period with zero reserve discrepancy, unrecoverable crash, missed checkpoint deadline or independently unverifiable receipt."
ac_2 = "Every mandatory gate binds one clean integrated source identity plus built artifacts and actual deployed service identities; dirty development logs, earlier revisions and image publication alone cannot satisfy release."
ac_3 = "All mandatory matrix members and private/public scope decisions have explicit evidence; unresolved contradiction, missing independent proof or incomplete canary blocks release."
ac_4 = "Existing running Paxeer nodes/validators remain an established dependency; inventory LayerX roles/routes/current deployment before asserting all subsystems operational."

[resolution.49]
title = "The running chain and retained API1 topology are established inputs"
contract = "Accept existing Paxeer nodes and validators as running. No task in this consolidation schedules a chain activation, validator restart, node rebuild/resync, API1 record/certificate change, or API1 relocation. LayerX checks may consume authenticated chain125 interface data needed for product proofs; that does not reopen chain liveness. Preserve existing approved RETAINED_ON_VALIDATOR exceptions."
applies_to = ["contract_context.108.decision.host_roles", "contract_context.108.decision.retained_rpc", "req.1157.ac_2", "req.1174.ac_3", "capability.108.4.15", "capability.108.4.16", "capability.108.4.17", "capability.108.4.22", "capability.108.4.27"]

[resolution.50]
title = "One product router with complete capabilities and protected internal boundaries"
contract = "Every current LayerX/Paxeer product capability has an explicit operation in a versioned routing manifest under https://api-mainnet-beta.paxeer.network, with declared protocol, auth, backend, network, limits and receipt semantics. Existing named UIs and compatible aliases may remain; private administrative, signer, source-ingress and validator surfaces stay private. New facade mappings must be implemented and qualified, not described as already present."
applies_to = ["contract_context.108.decision.router_url", "contract_context.108.decision.public_names", "req.1164", "req.1166", "req.1167", "req.1171", "req.1172", "req.1173", "req.1176"]

[resolution.51]
title = "Inventory the existing runtime before changes or deployment claims"
contract = "First inventory existing LayerX apps/process groups/machines, source/image digests, regions, services, public/private ingress, volumes, snapshots, configured dependency names, role UIDs and protected material producer/consumer paths. Record observed-at and evidence status; collect secret names/presence only, never values. Classify each as running at candidate, running at another identity, absent, blocked or unknown. Reuse operational deployments and plan only necessary changes. A manifest, history success or source inspection is not current runtime proof."
applies_to = ["contract_context.108.design.overview", "capability.108.1.5", "capability.108.4.13", "req.1180"]

[resolution.52]
title = "Wallet frontend hosting, identity and signer membership are independent contracts"
contract = "paxportwallet.com remains the current owner-hosted Docker UI until an explicit frontend placement decision changes it. The active wallet PWA capability is completed without moving it by implication; Supabase remains human login, the Fly gateway coordinates requests and wallet attestors enforce signing. Distinguish wallet_frontend, wallet_gateway and human_api names instead of duplicate wallet keys. Code currently defines five wallet participants and threshold3; inventory enrolled operational membership and reconcile with approved membership before deployment, preserving cryptographic threshold safety and never silently replacing it with four. Wallet, xweb and bridge signer memberships remain separate."
applies_to = ["contract_context.108.decision.cutover", "contract_context.108.decision.public_names.wallet", "req.1164.ac_3", "req.1166.ac_3", "req.1166.ac_6", "capability.108.3.7", "capability.108.4.1"]

[resolution.53]
title = "Wallet cutover is resumable and cannot retire the active UI"
contract = "A cutover inventories frontend/backend container dependencies and all retained recovery material before quiescence. Complete durable partial-import and one-shot verification recovery, actual migrated-path signer enforcement, database read-only transition, owner sealing and defined soak before retiring only the superseded backend. Preserve active frontend availability and sealed legacy recovery. If export or migration fails, identify exactly which processes were quiesced and provide safe resume/rollback before leaving the phase."
applies_to = ["req.1168", "capability.108.4.1", "capability.108.1.11"]

[resolution.54]
title = "Public TLS termination follows the actual edge topology"
contract = "For wildcard-served aliases the edge nginx terminates the public certbot certificate and proxies to the backend Fly hostname; the Fly hostname remains an upstream, not the canonical published endpoint. Dedicated mTLS compatibility surfaces use TCP passthrough so backend client-certificate validation survives. Plain internal listeners are permitted only behind the declared trusted edge, and simultaneous plain-plus-TLS credential configuration is refused. Do not require public custom Fly certificates where the edge contract already terminates TLS."
applies_to = ["contract_context.108.decision.edge_server", "req.1157.ac_1", "req.1157.ac_3", "req.1168.ac_1", "req.1175", "capability.108.0.9"]

[resolution.55]
title = "Private-network retirement does not delete useful private features"
contract = "Retain testnet control, faucet, Solidity/private settlement deployment, old Human web and explorer-index compatibility under explicit private-network capability sections and private qualification. They remain excluded from public mainnet route and readiness inventories; unrelated retired funded-wallet demo APIs are replaced by supported product examples rather than restored."
applies_to = ["contract_context.108.decision.retired", "req.1159.ac_4"]

[resolution.56]
title = "Kernel runtime is a complete, expected role roster"
contract = "The release kernel roster explicitly enumerates sequencer/replica/supervisor/clock, core/authority/agent/Paxeer boundaries, guarantor and archive/mirror roles, Human components/service/private event service/identity/security/movement/KMS/onboarding, full-mode agentd and MCP. Optional feature roles are optional only in declared private profiles; the full Paxeer X release requires all promised roles. Every role has UID, private runtime dir, volume path, required input producers, listener, restart behavior and semantic readiness. Absence of a status file fails roster comparison. waiting-genesis is permitted only in a named pre-provision phase, never final ready."
applies_to = ["contract_context.108.design.fly", "req.1162", "req.1166", "req.1167", "capability.108.1.5"]

[resolution.57]
title = "Bootstrap order separates credentials, service start and routed proof"
contract = "Encode an acyclic producer/consumer graph: inventory/retained-state reconciliation; protected runtime directories and CA identities; existing/genesis identity inputs; registry and event ingress material bootstrap; authenticated kernel trust/replica material transfer; owner/native/naming/evidence/journal production; policy/authority/private projections; service startup; router kernel mode; routed program deployment and product proofs. Split registry ingress/token/shared gateway identity bootstrap from registry-through-router receipt proof. Explicitly resolve the trust-history/authority/journal cycle with existing authenticated producers, never a readiness bypass or invented owner evidence."
applies_to = ["capability.108.2.2", "capability.108.2.6", "capability.108.3.16", "capability.108.0.11", "capability.108.0.12"]

[resolution.58]
title = "Attestor activity custody does not remove movement executor requirements"
contract = "Optional Human KMS for activity signing under wallet attestors does not make the separate movement executor optional. Supply real versioned custody profile, executor identity, execution authority, restricted operations and protected state. Complete attestor-backed wallet discovery/planning and every intended operation; readiness authenticates the executor rather than accepting a configured pointer. Preserve strict CA equality, profile binding, key-export ceremony controls and independent disclosure verification."
applies_to = ["req.1166.ac_3", "capability.108.3.3", "capability.108.3.15", "capability.108.3.16"]

[resolution.59]
title = "Readiness means the advertised operation can use its dependencies"
contract = "Keep /livez process-level. Full-release readiness requires compatible protocol/network/schema identities and every mandatory serving dependency, actual durable journal health, authenticated LNI/executor access, enrolled event principals and bounded ingestion/proof freshness. Chain-only or unconfigured modes report degraded and cannot satisfy LayerX readiness. Kernel-node genesis/head uses the archive origin contract, and authority replica uses its actual evidence/status contract."
applies_to = ["contract_context.108.design.probe", "req.1162.ac_3", "req.1164.ac_1", "req.1172", "req.1176"]

[resolution.60]
title = "Search price input is resolved without changing signer topology"
contract = "Use USD0.001 per request and configured PAX/USD13.44, so exact rational PAX cost is1/13440. Render integer base units using an explicit deterministic rounding policy and disclose that policy in the pricing contract; do not retain the obsolete missing-PAX-price blocker. USDC/USDL cost0.001 units; SID follows the approved3.114 SID/PAX rate where that product contract applies. Asset registration, payer/receiver funding and provider readiness remain distinct real inputs."
applies_to = ["req.1169"]

[resolution.61]
title = "Operator upgrade-info supersedes compiled activation height"
contract = "Retain existing chain activation compatibility as source/archival contracts. The applicable activation contract is req2/task3.3: no compiled ForkHeight or automatic one-below scheduling/halt; apply a recognized not-yet-done plan only in the block its upgrade-info file names through the real upgrade keeper with mounted-store and tracing guards. Preserve added-store, migration, historical reachability and no-state-on-refusal invariants. Do not schedule or reapply any activation on the already-running network."
applies_to = ["contract_context.106.decision.one_height", "contract_context.106.design.activation", "req.1139.ac_5", "req.1139.ac_6", "req.1139.ac_7", "capability.106.1.1", "capability.106.3.3"]

[resolution.62]
title = "Activation initialization and later governance configuration are separate"
contract = "Initial activation defaults leave xweb paused/unconfigured and do not guess remote assets. The later v6.10 named handler may write only its specified chain/network/base-unit/governance fields and approved xweb list; it changes no store and leaves all other authority/deposit/quorum checks intact. Retain the implemented governance authority model until approved evidence selects another; an archived open alternative does not authorize replacing governance with a raw operator key. Preserve full atomic six-module authority-message routes, pending-store safety and historical giga execution selection as compatibility requirements. Their application through router products must not trigger a new chain rollout by inference."
applies_to = ["contract_context.106.decision.owner_actions", "contract_context.106.decision.owner_inputs", "contract_context.106.decision.wave4_order", "req.1141", "capability.106.4.2", "capability.106.4.3", "capability.106.4.4", "capability.106.4.8"]

[resolution.63]
title = "CI image and canary recipes use their canonical source contracts"
contract = "Current CI image builds use the repository root with docker/flyci-runner/Dockerfile and docker/flyci-controller/Dockerfile, matching their COPY inputs. The effective canary contract is tools/bringup/check-live.sh#check_ci, carried from archived paxeer-x-bringup task4.13 and superseding archived paxeer-x-ci task2.1. Dispatch returns workflow_run_id; the run, default branch, workflow path and candidate head_sha are bound before paginated REST jobs runner_id/runner_name evidence is credited. Preserve fork-PR fallback, excluded publishing/security/special-host jobs, single-use unprivileged runners, controller-only tokens, rate limits and reversible CI_LINUX_RUNNER. Inventory current CI before any separately authorized deployment; actual-job cleanup follows req.210."
applies_to = ["contract_context.109.design.deploy", "capability.109.1.1", "capability.109.1.2", "capability.109.2.1", "capability.108.4.13"]

supersedes = ["spec/paxeer-x-ci/spec.kvx#task.1.1", "spec/paxeer-x-ci/spec.kvx#task.1.2", "spec/paxeer-x-ci/spec.kvx#task.2.1"]
effective_source = "spec/paxeer-x-bringup/spec.kvx#task.4.13"
current_contract = "spec/paxeer-x/spec.kvx#capability.109.2.1"
source_authorities = ["docker/flyci-runner/Dockerfile", "docker/flyci-controller/Dockerfile", "tools/bringup/check-live.sh#check_ci"]
pending_task_source = "spec/paxeer-x/spec.kvx"
archival_policy = "Archived specifications and retained historical recipes supply evidence only, never executable pending tasks. This resolution overrides their old image contexts, Dockerfile locations, API fields and deployment commands; no historical gate is claimed rerun."

[resolution.64]
title = "Candidate evidence and deployment identity are inseparable"
contract = "Every release-eligible record binds clean immutable source revision/tree identity, artifact/image digest, exact command, exit code, private log location, target environment and timestamp. Dirty development success remains useful but cannot satisfy release gates. Manual publication provenance binds the requested candidate rather than silently the dispatch event SHA. Historical passes stay historical. Aggregate/sanitizer/cluster/browser matrices run once on the final integrated candidate, never as per-task confidence reruns. Full release cannot pass with waived mandatory features or missing owner inputs."
applies_to = ["contract_context.108.design.probe", "contract_context.106.decision.evidence", "capability.106.2.1", "capability.106.4.7", "req.1180"]

[req.438]
title = "Record the existing LayerX runtime inventory before deployment decisions"
ac_1 = "Every subsystem/role in the expected roster has a protected inventory entry with observed identity, exposure, state and dependencies or an explicit unknown."
ac_2 = "Inventory collection is read-only, omits credential values, accepts running Paxeer as established, and performs no API1/validator relocation or liveness campaign."
ac_3 = "The resulting deployment delta reuses already-correct services and stops dependent mutations for unresolved ownership, state or membership facts."

[req.439]
title = "Freeze the full route and role contract for the integrated candidate"
ac_1 = "Every active product feature has a registered route/backend/auth/receipt mapping at the canonical router; no declared operation is a stub or unconditional unavailable branch."
ac_2 = "Expected kernel/supporting-service roster is compared by identity rather than enumerating existing status files; omitted/misowned/misconfigured roles fail."
ac_3 = "Private ingress, signer, KMS/admin and retired private-network routes cannot be reached through the public mainnet router profile."

[req.440]
title = "Qualify a preserved-volume bootstrap with exact producers and complete semantic readiness"
ac_1 = "Both fresh setup and retained-volume restart reach the complete expected role roster with real identity/authority/profile/journal inputs and correct private ownership."
ac_2 = "Missing registry material, principals, Human executor, LNI receipt path or custody profile causes specific readiness refusal, not a green fallback or an infinite opaque cycle."
ac_3 = "A seeded interrupted migration/rotation is resumed or refused with exact recovery instructions while preserving custody state and existing account/receipt bindings."

[req.441]
title = "Bind qualification and publication to one immutable complete candidate"
ac_1 = "All release-eligible evidence records require matching clean source identity, artifact digests, exact command/exit and timestamped private logs; dirty logs remain development-only."
ac_2 = "Manual candidate publication proves the selected source digest even when the dispatch event differs; tags are not promoted before required signer/provenance/SBOM verification."
ac_3 = "All mandatory application fixes and their focused gates are complete before final aggregate/browser/cluster/replay suites; each final gate runs once at the unchanged candidate."

[req.442]
title = "Reconcile and prove the operating CI deployment for the selected candidate"
ac_1 = "Inventory shows the actual controller/runner image identities and routing variable before any delta deploy; canonical repository-root image recipes are used if changes are needed."
ac_2 = "A uniquely correlated canary succeeds on an actual fly- runner using REST runner_name/runner_id, and its actual job machine is retired after completion."
ac_3 = "Fork PRs and excluded jobs retain their previous hosts; two cross-assigned jobs do not cause active-job deletion; controller credentials never enter job machines."

[req.443]
title = "Prove every user and agent product journey through the unified router"
ac_1 = "Every subsystem route row has a successful authorized full lifecycle through the canonical router using actual provisioned services and independent terminal evidence."
ac_2 = "Wrong identity/tenant/network, expired/replayed authorization, unavailable backend and interrupted/restarted operation produce their specified bounded refusal/recovery; no timer or200 substitutes for finality."
ac_3 = "Wallet Supabase/attestor custody, SDK and MCP daemon authority, native finance/market/Programs, custody, paid search/xweb, sponsored gas, bridge, interop/ramp, events and explorer history are all represented; missing owner/provider inputs prevent full-release success."

[req.444]
title = "Issue the final full-product operational release verdict"
ac_1 = "The post-deployment inventory shows the approved candidate or an explicitly compatible immutable dependency for every required subsystem/role; all route-matrix legs have matching evidence."
ac_2 = "Every declared replicated service/region, single-writer state boundary, archive copy/freshness guarantee and retained-state recovery contract has required evidence; private control exposure remains refused."
ac_3 = "The verdict is full operational only when all mandatory features, owner inputs, scoped implementation gates and final release gates pass; otherwise it names exact incomplete contracts without downgrading the product scope or asserting chain failure."

[req.13]
title = "Versioned boundary semantics with complete refusal vectors"
ac_1 = "Before qualifying a candidate, publish the exact admission, ordered success/failure, durable terminal refusal and replay result table for each supported protocol version, including global/actor sequence, fee, events, receipt and idempotency effects."
ac_2 = "Specify grant, activity, SEND and RECEIVE expiry equality separately per accepted version; preserve historical canonical outcomes and reject unknown versions. Explicitly resolve incompatible general and operation-specific clauses without weakening existing checks."
ac_3 = "Versioned canonical vectors cover equality, one unit either side, restart, duplicate retry, failed module effects and fee-only failure. No release verdict accepts an unresolved sequence, expiry or receipt-domain conflict."

[req.14]
title = "Durable full-duration qualification with bounded evidence collection"
ac_1 = "The CI execution manifest retains every required case, matrix child, minimum uninterrupted duration and threshold from the complete feature contracts. No coverage or duration is shortened to fit an agent task budget."
ac_2 = "Dispatch is idempotent and durable across timeout and unknown acknowledgement; candidate, manifest, environment and logical run identities prevent duplicate execution during evidence collection."
ac_3 = "Bounded evidence validation verifies trusted completed jobs, actual durations, all required outcomes and artifact provenance. Pending, failed, cancelled, timed-out, skipped, missing or mismatched cases cannot become success."

[req.448]
title = "Registry and router material precedes activation"
ac_1 = "Inventory existing services, images, volumes and protected credential references before changes; identify actual reused or newly produced prerequisites without exposing key material or fabricating authority."
ac_2 = "The candidate-bound protected material record identifies shared gateway client identity, CA root, registry ingress and event identities, exact registry request token, builder rootfs/environment digest and authenticated production kernel replica/trust-history generation with explicit producers."
ac_3 = "Missing, stale, partial or incompatible material refuses the stage. Resume preserves retained state and compatible credentials. Use the qualified production producer path; isolated fixture authority is not production authority."

[req.449]
title = "Registry bootstrap readiness precedes router activation"
ac_1 = "Consume the passed material record and run the selected image on one machine with a durable volume, actual builder rootfs, cgroup v2 subtree, bubblewrap and quota-image initialization."
ac_2 = "Ingress9420 and public443 TCP passthrough require mTLS under the correct internal CA and name identities; index.paxeer.network /healthz succeeds through the SNI edge."
ac_3 = "Emit the candidate-bound registry-bootstrap record only after material equality and readiness pass without requiring router readiness. Missing, incompatible or failed prerequisites refuse; retained state survives resume."
ac_4 = "Bootstrap does not discharge req1165.ac_3: task108.2.9 retains the signed successful reference deployment, routed event readback and program_registry readiness."

