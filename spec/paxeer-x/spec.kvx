verification_contract = "make test-arith-u128"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Add include/layerx/lxp_u128.h defining lxp_u128 as a struct of hi and lo uint64 words, so bare plus, minus and multiply do not compile on an amount."
do_2 = "Implement lxp_u128_add returning the overflow result code and lxp_u128_sub returning the underflow result code, never wrapping, saturating or truncating."
do_3 = "Implement lxp_u128_cmp, lxp_u128_is_zero and the 16-byte big-endian conversions the codec uses for amounts and fee limits."
do_4 = "Prove correctness by exhaustive boundary tests at zero, one, max minus one, max and every carry and borrow boundary of the low word."
do_5 = "Assert under UndefinedBehaviorSanitizer that no signed overflow and no undefined shift exists anywhere in the amount path."
symbols = ["lxp_u128", "lxp_u128_add", "lxp_u128_sub", "lxp_u128_cmp", "lxp_u128_is_zero"]

[capability.105.4.2]
title = "Implement the 256-bit widening multiply and floor division"
reference_namespace = "feature.105"
reqs = ["1114.2", "1114.3", "1137.7"]
touches = ["include/layerx/lxp_u128.h", "src/protocol/lxp_u256.c", "tests/arith/lxp_test_u256.c"]
tests = []
verification_contract = "make test-arith-u256"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Define lxp_u256 as four uint64 words and implement lxp_u128_mul widening to 256 bits, so the multiply-then-divide shape of every ratio computation never loses precision to an intermediate overflow."
do_2 = "Implement lxp_u256_div_floor returning quotient and remainder with the divide-by-zero result code, and lxp_u256_add for the conservation accumulators."
do_3 = "Specify that integer division floors and that every residue is explicitly returned to the caller rather than dropped, so dust is never implicit."
do_4 = "Return the overflow result code when a 256-bit quotient does not fit the requested 128-bit output, rather than truncating it."
do_5 = "Test the full carry chain across all four words and the divisor boundaries one, two to the sixty-fourth power and max."
symbols = ["lxp_u256", "lxp_u128_mul", "lxp_u256_add", "lxp_u256_div_floor"]

[capability.105.4.3]
title = "Implement signed magnitude arithmetic and the fixed rounding rules"
reference_namespace = "feature.105"
reqs = ["1114.5", "1128.4", "1135.1", "1137.7"]
touches = ["include/layerx/lxp_u128.h", "src/protocol/lxp_i128.c", "tests/arith/lxp_test_rounding.c"]
