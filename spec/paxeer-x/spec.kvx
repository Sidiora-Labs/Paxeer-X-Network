verification_contract = "make test-batch-seal"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_batch_roots_compute to build activity_merkle_root, receipt_merkle_root, event_merkle_root, oracle_root and data_availability_root over canonically encoded leaves, with leaves and internal nodes hashed under distinct domain tags and one fixed rule for non-power-of-two leaf counts."
do_2 = "Implement lxp_batch_seal to freeze the sequence range, the timestamp, the state roots and all five commitments into one immutable header."
do_3 = "Implement lxp_batch_sign over the canonical header bytes excluding the signature field, and lxp_batch_verify_signature which rejects an absent, malformed or foreign-key signature and any sequencer_id governance has not authorised for that batch_number."
do_4 = "Prove by test that a one-bit change anywhere in the batch body changes at least one root and invalidates the header signature."
do_5 = "Record the sealed header in the append-only log with an fdatasync before the batch is published to anyone."
symbols = ["lxp_batch_seal", "lxp_batch_roots_compute", "lxp_batch_sign", "lxp_batch_verify_signature"]

[capability.105.17.5]
title = "Distribute full batches to replicas before checkpoint eligibility"
reference_namespace = "feature.105"
reqs = ["1130.7", "1132.1", "1131.1", "1110.2"]
touches = ["include/layerx/lxp_batch.h", "src/network/lxp_batch_publish.c", "src/sequencer/lxp_eligibility.c", "tests/test_batch_publish.c"]
