do_2 = "Encode activity_type as u32 whose high sixteen bits are the module id and low sixteen the type ordinal, and encode fee_limit as a 16-byte big-endian unsigned amount."
do_3 = "Implement lxp_activity_encode and lxp_activity_decode over the canonical codec, rejecting an omitted, repeated or undeclared field with the malformed envelope code."
do_4 = "Implement lxp_activity_id as the domain-separated hash of the canonical activity bytes, so altering the encoding yields a different identifier rather than a second valid form of one activity."
