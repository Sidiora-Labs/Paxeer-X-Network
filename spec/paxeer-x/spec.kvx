tests = []
verification_contract = "make test-grants"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Define lxp_authority_grant with grant id, grantor, grantee, kind, key, scope, not_before, not_after, grantor revocation sequence, revoked flag and grantor signature."
do_2 = "Define lxp_authority_scope with module mask, activity type ordinal range, asset, maximum per activity, maximum total, spent total, period length, maximum per period, spent this period, period start and purpose hash."
do_3 = "Require every session key to carry an explicit expiration, an explicit set of permitted activity types and an explicit revocation sequence, treating a key missing any bound as invalid."
do_4 = "Compute grant_id as the content hash of the canonical grant encoding so a grant is content-addressed and cannot be silently amended in place."
do_5 = "Reject a capability grant omitting the authorised holder, the asset, the maximum single amount, the total or recurring allowance, the expiration, the permitted purpose or the revocation sequence."
symbols = ["lxp_authority_grant", "lxp_authority_scope", "lxp_grant_encode", "lxp_grant_id_compute", "lxp_session_key_bind"]

[capability.105.7.3]
title = "Implement the authority resolver inside the state machine"
reference_namespace = "feature.105"
reqs = ["1112.7", "1112.10", "1117.2", "1122.2"]
touches = ["src/state/lxp_authority.c", "include/layerx/lxp_authority.h", "tests/state/lxp_test_authority_resolve.c"]
tests = []
verification_contract = "make test-authority-resolve"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_authority_resolve accepting exactly the six kinds owner direct signature, session key, delegated capability, budget allowance, escrow authority and protocol-module capability, and rejecting any other kind."
do_2 = "Produce lxp_authority_resolved carrying actor, the principal whose funds may move, kind, verified key, scope pointer and authority hash."
do_3 = "Compute the authority hash as a domain-separated commitment over kind, grant id and verified key, and record it in every receipt so every debit is attributable to one named authority artifact."
do_4 = "Reject an authority that does not explicitly name the activity type being executed, or that names a broader scope than the module declares for that type."
do_5 = "Evaluate every authorisation decision inside the deterministic transition, consulting no HTTP session state, no gateway authentication, no in-memory challenge and no transport credential."
do_6 = "Test that the identical activity yields the identical authorisation result code on every node even when the submitting gateway accepted the request."
symbols = ["lxp_authority_resolve", "lxp_authority_resolved", "lxp_authority_hash", "lxp_authority_check_scope"]

[capability.105.7.4]
title = "Enforce delegated spending and trading limits"
reference_namespace = "feature.105"
reqs = ["1112.4", "1118.5", "1118.6", "1122.2"]
touches = ["src/state/lxp_authority.c", "include/layerx/lxp_authority.h", "tests/state/lxp_test_allowance.c"]
tests = []
verification_contract = "make test-allowance"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_authority_charge_allowance accumulating consumption against the grant inside state at execution time, never in a cache and never at admission only."
do_2 = "Reject the first activity that would carry cumulative consumption past the per-activity, total or per-period limit, so concurrent or reordered submissions cannot exceed a limit in aggregate."
do_3 = "Implement lxp_authority_period_roll advancing the period start by whole period lengths at the first activity that observes the boundary and resetting the remaining allowance deterministically."
do_4 = "Never carry unused recurring allowance forward, so an unused window is permanently unusable rather than accumulating into the next one."
do_5 = "Use only checked fixed-width arithmetic for allowance accumulation, rejecting with the overflow code rather than wrapping."
do_6 = "Test that a total allowance is exhausted at exactly the declared unit and never one unit past it, including several draws ordered inside a single batch."
symbols = ["lxp_authority_charge_allowance", "lxp_authority_period_roll", "lxp_authority_spend_check"]

[capability.105.7.5]
title = "Implement revocation, expiry and monotone amendment"
reference_namespace = "feature.105"
reqs = ["1112.5", "1112.6", "1118.8", "1125.9"]
touches = ["src/state/lxp_authority.c", "include/layerx/lxp_authority.h", "tests/state/lxp_test_revocation.c"]
tests = []
verification_contract = "make test-revocation"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_authority_revoke marking a grant unusable from the global sequence of the revocation onward, applying to activities already submitted but not yet executed."
do_2 = "Implement bulk revocation by bumping the identity revocation sequence, invalidating every grant referencing the superseded value in one activity without enumerating them."
do_3 = "Reject a revocation or capability update whose revocation sequence is not strictly greater than the recorded one, so a replayed authorisation can never reinstate a revoked delegate."
do_4 = "Implement lxp_authority_amend as narrowing only, permitting lower caps, earlier expiry and fewer modules, and requiring a fresh grant to widen anything."
do_5 = "Reject an expired authority using only the batch-supplied timestamp, and never retroactively invalidate an activity already executed before the revocation sequence."
symbols = ["lxp_authority_revoke", "lxp_authority_amend", "lxp_authority_is_live", "lxp_identity_bump_revocation_sequence"]

[capability.105.7.6]
title = "Implement key rotation, recovery and the optional EVM payout binding"
reference_namespace = "feature.105"
reqs = ["1112.8", "1112.9", "1114.7", "1119.6"]
touches = ["src/state/lxp_identity.c", "include/layerx/lxp_identity.h", "tests/state/lxp_test_rotation.c"]
tests = []
verification_contract = "make test-rotation"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement two-phase rotation: lxp_identity_rotate_announce records the pending key and effective timestamp, and lxp_identity_rotate_commit promotes it only after the configured challenge delay measured in batch timestamps."
do_2 = "Verify both the old and the new key inside the rotation window so an in-flight activity signed by the superseded key is not orphaned, and treat a lapsed rotation as a no-op rather than a lockout."
do_3 = "Reject a competing rotation submitted during an open challenge delay and invalidate the superseded key for every activity executed at or after the effective sequence."
do_4 = "Implement k-of-n recovery where lxp_identity_recover_begin opens a challenge window in which the existing primary key can veto, and lxp_identity_recover_commit applies only after that window elapses."
do_5 = "Implement lxp_identity_bind_evm_payout requiring a secp256k1 signature over a domain-separated binding statement naming the DID and network id, and granting the bound address no authority to move, debit or authorise any balance."
do_6 = "Test that retirement is refused unless every balance in every asset is zero, so no value is stranded outside the reachable account namespace."
symbols = ["lxp_identity_rotate_announce", "lxp_identity_rotate_commit", "lxp_identity_recover_begin", "lxp_identity_recover_commit", "lxp_identity_bind_evm_payout"]

[capability_group.105.8]
title = "Implement the activity kernel and module dispatch"
children = ["105.8.1", "105.8.2", "105.8.3", "105.8.4", "105.8.5", "105.8.6"]

[capability.105.8.1]
title = "Implement the kernel state handle and the module registration table"
reference_namespace = "feature.105"
reqs = ["1110.5", "1113.1", "1113.2", "1113.3"]
touches = ["src/protocol/lxp_kernel.c", "include/layerx/lxp_kernel.h", "include/layerx/lxp_module.h", "tests/protocol/lxp_test_kernel.c"]
tests = []
verification_contract = "make test-kernel"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Add src/protocol/lxp_kernel.c defining the kernel handle over the state tree, the journal, the parameter set and the registered module table."
do_2 = "Define lxp_module_iface with module id, ABI version, name and the genesis, decode, validate, execute, epoch begin, epoch end, state root and release entry points."
do_3 = "Restrict the kernel to identities, accounts, assets, authority, nonces and sequences, fees, state transitions, events, receipts, checkpoints and modules, defining no payment product, market rule, service workflow or oracle semantic."
do_4 = "Implement lxp_kernel_register_module recording the module identifier, its version and the exhaustive list of activity types it declares, whether at genesis or by a governance activity."
do_5 = "Reject with the unknown activity code any activity whose type is not declared by a currently registered and epoch-enabled module."
do_6 = "Reserve module ids one through eight for asset, escrow, budget, stream, service, perps, governance and bridge, none of them privileged above the kernel rules."
symbols = ["lxp_kernel", "lxp_kernel_create", "lxp_kernel_register_module", "lxp_module_iface", "lxp_module_ctx"]

[capability.105.8.2]
title = "Implement the module context capability surface"
reference_namespace = "feature.105"
reqs = ["1113.4", "1116.1", "1116.2", "1116.10", "1122.1", "1122.10"]
touches = ["src/protocol/lxp_module_ctx.c", "include/layerx/lxp_module.h", "tests/protocol/lxp_test_module_ctx.c", "scripts/ci/symbol-allowlist.sh"]
tests = []
verification_contract = "make test-module-ctx"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Provide namespaced state access through lxp_ctx_kv_get, lxp_ctx_kv_put, lxp_ctx_kv_del and lxp_ctx_kv_iter, with the kernel prefixing every key by module id so a module physically cannot address another module subtree."
do_2 = "Make lxp_ctx_emit_transfer_set the only monetary capability a module has, so every monetary effect compiles into one or more authenticated 402LXP transfers applied by the single kernel primitive."
do_3 = "Expose the deterministic environment as batch timestamp, epoch, global sequence, parameter read, gas charge and arena allocation, and nothing else."
do_4 = "Define no now function, no random function, no HTTP function and no set-balance function, so determinism and the no-direct-balance-write invariant are enforced by what does not exist."
do_5 = "Add a CI check asserting that no module translation unit links the ledger apply internals and that the account balance field is unreachable from the module ABI."
do_6 = "Test that a module attempting a balance write outside the transfer primitive aborts the transition with the balance bypass code, leaves every balance unchanged and emits no success receipt."
symbols = ["lxp_ctx_kv_get", "lxp_ctx_kv_put", "lxp_ctx_kv_iter", "lxp_ctx_emit_transfer_set", "lxp_ctx_batch_timestamp_ms"]

[capability.105.8.3]
title = "Implement versioned transition dispatch in fixed order"
reference_namespace = "feature.105"
reqs = ["1113.6", "1113.8", "1114.6", "1135.6"]
touches = ["src/protocol/lxp_kernel.c", "include/layerx/lxp_kernel.h", "tests/protocol/lxp_test_dispatch.c"]
tests = []
verification_contract = "make test-dispatch"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_kernel_execute_activity in fixed order: decode, envelope and module enablement checks, identity and authority resolution with signature verification, exact sequence equality, timestamp bound, idempotency short-circuit, fee computation against the limit, journal open, validate then execute, commit or roll back, then fee charge and sequence consumption and idempotency record and receipt on both paths, then state root chaining."
do_2 = "Select the transition version recorded for the batch rather than the newest available version, so replay of old history is unaffected by later upgrades."
do_3 = "Record in each receipt the module version under which the activity executed, and apply a new module version only from a declared epoch boundary onward."
do_4 = "On a module failure discard every state write that activity attempted, leave every other module unchanged, and still consume the account sequence and charge the metered fee for a well-formed authorised activity."
do_5 = "Forbid a validate implementation from mutating state and assert that property against the test module the suite registers."
do_6 = "Test that a failure receipt carries the failure result code, zero module effects and correctly chained state roots."
symbols = ["lxp_kernel_execute_activity", "lxp_kernel_dispatch", "lxp_module_version_for_epoch", "lxp_kernel_step_order"]

[capability.105.8.4]
title = "Implement the event and receipt emission path"
reference_namespace = "feature.105"
reqs = ["1111.9", "1113.10", "1121.1", "1121.4"]
touches = ["src/protocol/lxp_receipt.c", "include/layerx/lxp_receipt.h", "tests/protocol/lxp_test_receipts.c"]
tests = []
verification_contract = "make test-receipts"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_effect_buffer collecting module effects sorted by module id and effect ordinal, and require every monetary effect to be a transfer effect carrying a transfer set root."
do_2 = "Trap on any other monetary effect kind, because such an effect is a kernel bug rather than a module error."
do_3 = "Emit events only through lxp_ctx_emit_event and commit them under the batch event merkle root, providing no module-private or process-local channel by which an effect could become observable without appearing in that commitment."
do_4 = "Build the ActivityReceipt with activity id, global sequence, previous state root, resulting state root, activity root, result code, effects, fee charged, batch id and sequencer signature, every value computed by the protocol from the resulting state."
do_5 = "Sign the receipt over the domain-separated canonical encoding of the receipt without its own signature, verifiable against the published sequencer key with no further interaction with the node."
do_6 = "Reject any client-supplied assertion of a result, an effect, a resulting balance or a state root."
symbols = ["lxp_effect_buffer", "lxp_ctx_emit_event", "lxp_receipt_build", "lxp_receipt_sign", "lxp_receipt_encode"]

[capability.105.8.5]
title = "Compute and chain the state root"
reference_namespace = "feature.105"
reqs = ["1114.1", "1114.4", "1115.5", "1122.5"]
touches = ["src/state/lxp_state_root.c", "include/layerx/lxp_state.h", "tests/state/lxp_test_state_root.c"]
tests = []
verification_contract = "make test-state-root"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_state_root as a pure function of state composing each module subtree root under the kernel domain tags into a single root."
do_2 = "Iterate every account, grant, order, position and effect collection in canonical byte-lexicographic key order, never in insertion, allocation, hash-seed or pointer order."
do_3 = "Recompute each asset total units against the account tree at every seal and return the supply mismatch fatal code on divergence rather than continuing."
do_4 = "Chain previous state root to resulting state root per activity and not only per batch, so the receipt at a global sequence names the resulting root of the preceding sequence."
do_5 = "Test that two nodes with different allocation patterns and optimisation levels produce byte-identical roots for the identical history."
symbols = ["lxp_state_root", "lxp_state_subtree_root", "lxp_state_root_chain", "lxp_state_supply_check"]

[capability.105.8.6]
title = "Enforce the execution guard and prove golden replay"
reference_namespace = "feature.105"
reqs = ["1110.1", "1114.7", "1114.8", "1122.14", "1122.15", "1137.1"]
touches = ["src/protocol/lxp_determinism_guard.c", "tests/replay/lxp_test_golden_replay.c", "tests/replay/golden/history.lxl", "scripts/ci/symbol-allowlist.sh"]
tests = []
verification_contract = "make test-replay-golden"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Extend the link-time symbol allowlist to forbid time, clock_gettime, gettimeofday, rand, random, getenv, getpid, gethostname, stat and every socket or HTTP entry point in execution translation units."
do_2 = "Implement lxp_determinism_guard_check so a transition path reaching a forbidden call halts the node rather than producing a state root it cannot justify."
do_3 = "Add tests/replay holding a golden activity history together with its recorded per-batch state roots, receipts and event roots."
do_4 = "Implement lxp_kernel_replay executing the golden history from genesis with no index database as an input, asserting byte-identical roots at every batch boundary."
do_5 = "Run the golden replay at two optimisation levels and on a second CPU architecture in CI, failing on a single differing byte with the replay divergence fatal code."
do_6 = "Assert that reducing the worker pool to zero threads changes no output byte, which is the operational definition that the threading model is not part of consensus."
symbols = ["lxp_determinism_guard_check", "lxp_kernel_replay", "lxp_replay_golden_run", "lxp_replay_compare_roots"]

[capability_group.105.9]
title = "Build the 402LXP ledger core as the single balance-mutation primitive"
children = ["105.9.1", "105.9.2", "105.9.3", "105.9.4", "105.9.5", "105.9.6"]

[capability.105.9.1]
title = "Derive the account and subaccount namespace deterministically"
reference_namespace = "feature.105"
reqs = ["1119.2", "1119.3", "1119.4", "1119.5", "1119.6", "1119.10"]
touches = ["include/layerx/lxp_ledger.h", "src/ledger/lx_account_id.c", "src/ledger/lx_account_registry.c", "tests/ledger/test_account_id.c"]
tests = []
verification_contract = "make test-ledger-accounts"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Define the canonical account string grammar in include/layerx/lxp_ledger.h as ASCII, lowercase, colon-delimited with no empty segments, admitting exactly agent:did:main, agent:did:budget:id, agent:did:escrow:id, agent:did:stream:id, agent:did:margin:position, system:liquidity:market, system:funding:market:long, system:funding:market:short, system:insurance, system:fees, system:paxeer-reserve and system:paxeer-withdrawals."
do_2 = "Implement lx_account_id_from_string as the domain-separated commitment over the tag LX:ACCOUNT:v1 followed by a big-endian u32 length and the canonical string bytes, so the identifier is byte-identical on every node, architecture and implementation and stable for the account lifetime."
do_3 = "Implement lx_account_name_parse and lx_account_kind_of to classify a name into enum lx_account_kind, and reject any transfer leg naming an account outside the namespace with ERR_UNKNOWN_ACCOUNT_NAMESPACE."
do_4 = "Implement lx_account_open so that a credit to a namespace-valid account that does not yet exist creates it deterministically at that global sequence with a zero opening balance before the credit is applied, and records the creation in the append-only activity log so replay recreates it identically."
do_5 = "Reject any presented account identifier that does not equal the derivation of its declared namespace string with ERR_ACCOUNT_ID_MISMATCH, and reject closure of an account whose balance is non-zero with ERR_ACCOUNT_NOT_EMPTY."
do_6 = "Add fixed conformance vectors covering every namespace form, a derivation mismatch, an unknown namespace and a lazily created credit destination, asserting exact identifier bytes and exact result codes."
symbols = ["lx_account_id_from_string", "lx_account_name_parse", "lx_account_kind_of", "lx_account_open", "lx_account_lookup"]

[capability.105.9.2]
title = "Implement lxp_apply_transfer as the one balance-mutation primitive"
reference_namespace = "feature.105"
reqs = ["1116.1", "1116.9", "1117.6", "1117.7", "1117.8", "1122.4"]
touches = ["src/ledger/lxp_apply.c", "include/layerx/lxp_transfer.h", "include/layerx/lxp_ledger.h", "tests/ledger/test_apply_transfer.c"]
tests = []
verification_contract = "make test-ledger-transfer"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_apply_transfer in src/ledger/lxp_apply.c as the one-leg case of the set form, and make that translation unit the only place in the tree that ever assigns struct lx_account.balance."
do_2 = "Implement lxp_precondition_check in the fixed order leg-count bound, non-zero amount, asset registered and unpaused, source and destination asset equality, neither endpoint frozen, authority covers every debited account, actor sequence exact, idempotency key unseen, batch timestamp within expiry, net debit within balance, credit addition overflow-free, per-asset conservation, so the failure code is deterministic and not merely the failure."
do_3 = "Route every amount computation through the checked helpers lx_u128_sub and lx_u128_add so an underflow returns LX_ERR_UNDERFLOW and an overflow returns LX_ERR_OVERFLOW instead of wrapping, saturating or truncating."
do_4 = "Capture from_balance_before, from_balance_after, to_balance_before and to_balance_after from the state actually mutated, and reject any payload carrying a client-asserted resulting balance or balance delta with ERR_CLIENT_SUPPLIED_BALANCE."
do_5 = "Add unit tests for zero amount, asset mismatch, unknown asset, frozen endpoint, insufficient balance, maximum-representable credit and an exact-boundary transfer, asserting the exact result code and unchanged balances for every rejection."
symbols = ["lxp_apply_transfer", "lxp_precondition_check", "lxp_balance_apply_leg", "lxp_state_balance_get"]

[capability.105.9.3]
title = "Implement atomic transfer sets with full rollback and per-asset conservation"
reference_namespace = "feature.105"
reqs = ["1113.7", "1120.1", "1120.2", "1120.4", "1120.5", "1120.9", "1122.6"]
touches = ["src/ledger/lxp_apply.c", "src/ledger/lxp_journal.c", "include/layerx/lxp_transfer.h", "tests/ledger/test_transfer_set.c"]
tests = []
verification_contract = "make test-ledger-set"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_apply_transfer_set to open exactly one state journal, apply the legs in their declared order, and either commit every leg or roll the whole set back before any reader, index, event stream or receipt can observe an intermediate state."
do_2 = "Bind each set to exactly one authorisation context and one execution sequence for the authorising account, and emit exactly one receipt for the whole set rather than one receipt per leg."
do_3 = "Implement lxp_conservation_check accumulating debits and credits per asset in 256-bit accumulators, returning LX_ERR_CONSERVATION when the net supply change for any asset is non-zero, and rejecting any non-bridge set that would increase or decrease total supply."
do_4 = "Evaluate the non-negativity precondition on net per-account movement across the whole set so a set may legitimately credit an account before debiting it, and fail the entire set rather than reordering, netting or deferring legs."
do_5 = "Report the zero-based index and result code of the first failing leg in the failure result, emit no success receipt for any leg, and omit computed-zero legs before authorisation so a set never contains a zero-amount leg."
do_6 = "Implement lxp_transfer_set_root as a merkle commitment over the canonically encoded legs in execution order under distinct leaf and node domain tags, and test the four-leg liquidation template, a failing final leg, a supply-mutating set and a crash injected between legs."
symbols = ["lxp_apply_transfer_set", "lxp_journal_open", "lxp_journal_commit", "lxp_journal_rollback", "lxp_conservation_check", "lxp_transfer_set_root"]

[capability.105.9.4]
title = "Implement the SEND operation over the shared internal transfer function"
reference_namespace = "feature.105"
reqs = ["1116.1", "1117.1", "1117.2", "1117.3", "1117.4", "1117.5", "1117.9", "1122.2"]
touches = ["src/ledger/lxp_send.c", "include/layerx/lxp_ledger.h", "tests/ledger/test_send.c", "fuzz/fuzz_lxp_send.c"]
tests = []
verification_contract = "make test-ledger-send"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Decode struct lxp_send with exactly the fields from, to, asset, amount, sequence, idempotency_key, expires_at, context_hash, conditions and authorization, rejecting an omitted field, an unknown field or a non-canonical encoding with ERR_MALFORMED_SEND."
do_2 = "Resolve the authorization to exactly one of the six admitted kinds, namely owner direct signature, session key, delegated capability, budget allowance, escrow authority or protocol-module capability, rejecting anything else with ERR_UNKNOWN_AUTHORITY_KIND and rejecting an authority that does not control the source account with ERR_UNAUTHORIZED_DEBIT."
do_3 = "Require sequence to equal exactly the next expected sequence of the account the authorization controls, consume it exactly once on success, and reject a lower or higher value with ERR_SEQUENCE_MISMATCH."
do_4 = "Evaluate expires_at and every declared condition against the batch-supplied timestamp only, returning ERR_EXPIRED or ERR_CONDITION_UNMET, and reject a submitted context_hash that differs from the one covered by the signed authorisation bytes with ERR_CONTEXT_MISMATCH."
do_5 = "Compile the accepted SEND into a one-leg transfer set with reason LXP_REASON_PAYMENT and hand it to lxp_apply_transfer_set, so SEND owns no balance-mutation code of its own."
do_6 = "Add a fuzz target over the SEND payload plus tests proving a byte-identical resubmission is rejected as a replay and a repeated idempotency key returns the first receipt with zero new economic effect."
symbols = ["lxp_send_decode", "lxp_send_validate", "lxp_send_execute", "lxp_send_build_transfer_set"]

[capability.105.9.5]
title = "Implement RECEIVE with signed payer grant storage and enforcement"
reference_namespace = "feature.105"
reqs = ["1116.1", "1118.1", "1118.2", "1118.3", "1118.4", "1118.5", "1118.7", "1118.9", "1118.10", "1122.3"]
touches = ["src/ledger/lxp_receive.c", "src/ledger/lxp_grant_store.c", "include/layerx/lxp_ledger.h", "tests/ledger/test_receive.c"]
tests = []
verification_contract = "make test-ledger-receive"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Decode struct lxp_receive with exactly the fields from, to, asset, amount, grant_id, receiver_sequence, idempotency_key, context_hash, receiver_authorization and payer_grant, rejecting an omission or non-canonical encoding with ERR_MALFORMED_RECEIVE."
do_2 = "Implement lxp_verify_payer_grant to check the grantor signature over the canonical grant bytes and require the authorized recipient, asset, per-draw maximum, total or recurring allowance with its window length, expiration, permitted purpose, optional service or invoice identifier and revocation sequence, rejecting an incomplete grant with ERR_MALFORMED_GRANT and a missing grant with ERR_NO_PAYER_GRANT."
do_3 = "Persist grant draw state in the state tree through lxp_grant_store_put and lxp_grant_draw_record so drawn_total and drawn_this_period are protocol-maintained and monotone, rejecting a draw past a total allowance or past the current window allowance with ERR_GRANT_EXHAUSTED even when several RECEIVE activities are ordered in the same batch."
do_4 = "Reset the recurring allowance at the deterministic start of each window computed from the batch timestamp, carry no unused allowance forward, and reject a grant past its expiration with ERR_GRANT_EXPIRED and a grant superseded by lxp_grant_revoke with ERR_GRANT_REVOKED from the revocation global sequence onward."
do_5 = "Reject a recipient that is not the named authorized recipient, an asset or account pair that does not match the grant, a purpose that the context_hash does not commit to, and an already settled invoice identifier, with ERR_GRANT_SCOPE_VIOLATION, ERR_PURPOSE_MISMATCH or ERR_INVOICE_ALREADY_SETTLED, moving no value."
do_6 = "Compile the accepted RECEIVE into the identical internal transfer set that SEND builds, so the emitted receipt differs from a SEND receipt only in the operation field and the authorisation evidence, and test that a recipient can never debit an account for which no grant exists."
symbols = ["lxp_receive_execute", "lxp_verify_payer_grant", "lxp_grant_store_put", "lxp_grant_draw_record", "lxp_grant_revoke"]

[capability.105.9.6]
title = "Emit the 402LXPReceipt and lock the ledger as the only balance writer"
reference_namespace = "feature.105"
reqs = ["1116.2", "1121.1", "1121.2", "1121.3", "1121.4", "1121.10", "1122.7", "1122.10"]
touches = ["src/ledger/lxp_receipt.c", "include/layerx/lxp_receipt.h", "tests/ledger/lxp_check_sole_writer.sh", "tests/ledger/test_receipt.c"]
tests = []
verification_contract = "make test-ledger-receipt"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_receipt_build populating protocol_version, transaction_id, operation, global_sequence, asset, amount, from, from_balance_before, from_balance_after, from_sequence, to, to_balance_before, to_balance_after, transfer_set_root, authorization_hash, context_hash, previous_state_root, resulting_state_root, batch_id and timestamp entirely from the state the ledger just mutated."
do_2 = "Guarantee for a single-leg operation that from_balance_after equals from_balance_before minus amount and to_balance_after equals to_balance_before plus amount, and for a multi-leg set that transfer_set_root commits to every leg in execution order."
do_3 = "Sign the canonical binary encoding of the receipt under the sequencer identity named in the batch header with lxp_receipt_sign, implement lxp_receipt_verify against the published sequencer key with no further node interaction, and append the receipt durably before it is returned so replay reproduces it exactly."
do_4 = "Return byte-identical receipt content for two submissions sharing an idempotency key, keep exactly one durable receipt per successful transfer or transfer set, and emit no signed receipt at all for a failed operation, only a failure result carrying the result code and unchanged balances."
do_5 = "Add tests/ledger/lxp_check_sole_writer.sh asserting that struct lx_account.balance is assigned in exactly one translation unit, src/ledger/lxp_apply.c, that no object under src/modules links the internal apply symbols, and that no balance-write entry point is exposed on the module context."
do_6 = "Wire lxp_balance_writer_guard and the sole-writer script into the test-ledger-receipt target so any bypass fails verification with ERR_BALANCE_BYPASS rather than being merely discouraged."
symbols = ["lxp_receipt_verify", "lxp_balance_writer_guard"]

[capability_group.105.10]
title = "Build the asset module over the ledger kernel"
children = ["105.10.1", "105.10.2", "105.10.3", "105.10.4", "105.10.5", "105.10.6"]

[capability.105.10.1]
title = "Implement the asset registry with integer decimals"
reference_namespace = "feature.105"
reqs = ["1123.1", "1123.2", "1113.2", "1113.3"]
touches = ["src/modules/asset/lx_asset_registry.c", "include/layerx/lx_asset.h", "tests/modules/test_asset_registry.c"]
tests = []
verification_contract = "make test-asset-registry"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Register the asset module as module id 1 through the kernel module interface, declaring exactly the activity types asset.register, asset.pause, asset.unpause, asset.account_open, asset.send, asset.receive, asset.grant_issue, asset.grant_revoke, asset.mint and asset.burn, at ordinals 1 through 8, 10 and 11; ordinal 9 is reserved."
do_2 = "Implement lx_asset_register recording asset_id, symbol, decimals, custody kind and the Paxeer custody reference, rejecting a duplicate asset id with ASSET_ALREADY_REGISTERED while still consuming the sequence and charging the metered fee."
do_3 = "Treat decimals strictly as display metadata: every amount is an unsigned fixed-width integer count of the smallest indivisible unit, and any amount encoded as a decimal fraction, an exponent form or a floating point value is rejected with INVALID_AMOUNT."
do_4 = "Implement lx_asset_pause and lx_asset_unpause so a paused asset fails the ledger precondition for every leg naming it, and expose lx_asset_lookup for the ledger to resolve asset existence and paused state."
do_5 = "Add tests for duplicate registration, a fractional amount, a paused-asset transfer and canonical round-trip of the registry record."
symbols = ["lx_asset_module_iface", "lx_asset_register", "lx_asset_lookup", "lx_asset_pause", "lx_asset_unpause"]

[capability.105.10.2]
title = "Implement balance queries and the asset module state root"
reference_namespace = "feature.105"
reqs = ["1119.1", "1119.5", "1114.4", "1123.10"]
touches = ["src/modules/asset/lx_asset_state.c", "include/layerx/lx_asset.h", "tests/modules/test_asset_state.c"]
tests = []
verification_contract = "make test-asset-balance"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_asset_balance_get as a read-only query over the balance tree keyed by account_id and asset_id, returning the exact fixed-width integer balance with no rounding or aggregation."
do_2 = "Implement lx_asset_account_open as the module-facing wrapper over the kernel account creation path so locked value is always a real account balance and never a reserved, held, locked or pending field on another account."
do_3 = "Maintain per-asset total_units as the sum of every account balance and implement lx_asset_total_units so reserve reconciliation has an authoritative figure."
do_4 = "Implement lx_asset_state_root as a pure function of module state, iterating accounts in canonical byte-lexicographic key order with no dependence on hash seeds, pointer values, allocation order or insertion order."
do_5 = "Add tests proving the state root is byte-identical across two differently ordered insertion histories that reach the same logical state."
symbols = ["lx_asset_balance_get", "lx_asset_account_open", "lx_asset_total_units", "lx_asset_state_root"]

[capability.105.10.3]
title = "Route asset transfers exclusively through the ledger kernel"
reference_namespace = "feature.105"
reqs = ["1116.1", "1116.4", "1122.1", "1123.3", "1123.4", "1123.5", "1123.6"]
touches = ["src/modules/asset/lx_asset_transfer.c", "include/layerx/lx_asset.h", "tests/modules/test_asset_transfer.c"]
tests = []
verification_contract = "make test-asset-transfer"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_asset_send_execute compiling asset.send into a single leg from agent main to agent main with reason LXP_REASON_PAYMENT, emitted only through the module transfer-set capability."
do_2 = "Implement lx_asset_receive_execute compiling asset.receive into a single leg from the grant payer account to the recipient main account, reusing the payer grant verification of the ledger rather than duplicating it."
do_3 = "Implement lx_asset_validate as a read-only admissibility check that mutates no state, so validation and execution stay separable and validation can never move value."
do_4 = "Reject with DIRECT_BALANCE_WRITE_FORBIDDEN any accepted activity or module effect that attempts to assign a balance value directly, and prove in test that the asset module holds the registry but no privilege over the ledger."
do_5 = "Add tests for insufficient funds, destination overflow, asset mismatch and a zero amount, asserting INSUFFICIENT_FUNDS, BALANCE_OVERFLOW, ASSET_MISMATCH and INVALID_AMOUNT with every balance left exactly as it was."
symbols = ["lx_asset_send_execute", "lx_asset_receive_execute", "lx_asset_validate"]

[capability.105.10.4]
title = "Credit deposits only against a finalised Paxeer custody proof"
reference_namespace = "feature.105"
reqs = ["1110.7", "1116.6", "1120.6", "1122.12", "1123.7", "1123.8"]
touches = ["src/modules/asset/lx_asset_custody.c", "include/layerx/lx_asset.h", "tests/modules/test_asset_deposit.c"]
tests = []
verification_contract = "make test-asset-deposit"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_asset_deposit_credit to execute a single leg from system:paxeer-reserve to the agent main account with reason LXP_REASON_DEPOSIT, so a deposit moves units the reserve mirror already holds and never mints."
do_2 = "Implement lx_bridge_verify_deposit to fail closed unless the activity carries a finalised Paxeer custody proof bound to a registered checkpoint state root and matching the executing network_id and protocol_version, rejecting otherwise with DEPOSIT_PROOF_NOT_FINAL."
do_3 = "Implement lx_deposit_nullifier_consume so a custody reference or deposit identifier already credited is rejected with DEPOSIT_ALREADY_CREDITED and a replayed proof produces at most one economic result."
do_4 = "Assert at runtime that a deposit credit lacking a finalised custody proof aborts the transition under invariant 12 rather than crediting anything."
do_5 = "Add tests for an unfinalised checkpoint reference, a replayed proof, a wrong-network proof and a valid credit, asserting exact result codes and conserved total supply in every case."
symbols = ["lx_asset_deposit_credit", "lx_bridge_verify_deposit", "lx_deposit_nullifier_consume"]

[capability.105.10.5]
title = "Debit withdrawals into the Paxeer withdrawal account under a unique nullifier"
reference_namespace = "feature.105"
reqs = ["1110.8", "1116.6", "1120.7", "1122.13", "1123.9"]
touches = ["src/modules/asset/lx_asset_custody.c", "include/layerx/lx_asset.h", "tests/modules/test_asset_withdraw.c"]
tests = []
verification_contract = "make test-asset-withdraw"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_asset_withdraw_request to execute a single leg from the agent main account to system:paxeer-withdrawals with reason LXP_REASON_WITHDRAWAL, so the LayerX debit is committed and checkpointable before any Paxeer payout becomes claimable."
do_2 = "Implement lx_withdrawal_nullifier as the domain-separated commitment over network_id, withdrawal_id, account, asset, amount and checkpoint_id, and record it in resulting state at request time."
do_3 = "Implement lx_asset_nullifier_seen so a settlement or a further withdrawal presenting an already recorded nullifier is rejected with WITHDRAWAL_ALREADY_SETTLED and no withdrawal can pay twice."
do_4 = "Keep total LayerX supply unchanged at request time, retiring value against system:paxeer-reserve only when a finalised settlement reference is presented, so the withdrawal path never burns."
do_5 = "Add tests for a duplicate nullifier, a withdrawal exceeding balance and a request-then-settle sequence, asserting conservation across every step."
symbols = ["lx_asset_withdraw_request", "lx_withdrawal_nullifier", "lx_asset_nullifier_seen"]

[capability.105.10.6]
title = "Report full reserve reconciliation per asset"
reference_namespace = "feature.105"
reqs = ["1123.10", "1120.6", "1120.8", "1137.11"]
touches = ["src/modules/asset/lx_asset_reserve.c", "include/layerx/lx_asset.h", "tests/modules/test_asset_reserve.c"]
tests = []
verification_contract = "make test-asset-reserve"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_asset_reserve_reconcile computing, per asset, the sum of all agent, module and system account balances excluding the reserve mirror, and comparing it against the custody amount attested by the most recent finalised Paxeer proof less the amount already settled out of the withdrawal account."
do_2 = "Implement lx_asset_supply_check at every batch seal, recomputing each asset total_units against the account tree and returning LX_FATAL_SUPPLY_MISMATCH on divergence rather than sealing a root that violates full reserve accounting."
do_3 = "Implement lx_asset_reserve_report emitting a canonical per-asset report with zero tolerance, enumerating agent, escrow, budget, stream, margin, liquidity, insurance, fee treasury and withdrawal balances separately."
do_4 = "Reject the offending activity rather than producing a batch whose resulting state root breaks reconciliation, and prove in test that a synthetic over-credit is caught at seal time."
do_5 = "Add a replay test that runs the report at every batch boundary of a mixed deposit, transfer and withdrawal history and asserts exact equality throughout."
symbols = ["lx_asset_reserve_reconcile", "lx_asset_supply_check", "lx_asset_reserve_report"]

[capability_group.105.11]
title = "Build the escrow module with holds, capture, timeout and disputes"
children = ["105.11.1", "105.11.2", "105.11.3", "105.11.4", "105.11.5"]

[capability.105.11.1]
title = "Create holds by moving funds into an escrow subaccount"
reference_namespace = "feature.105"
reqs = ["1124.1", "1116.5", "1119.1", "1122.1"]
touches = ["src/modules/escrow/lx_escrow_open.c", "include/layerx/lx_escrow.h", "tests/modules/test_escrow_open.c"]
tests = []
verification_contract = "make test-escrow-open"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Register the escrow module as module id 2 declaring escrow.open, escrow.capture, escrow.partial_capture, escrow.release, escrow.timeout, escrow.dispute_open and escrow.dispute_resolve."
do_2 = "Implement lx_escrow_open_execute to emit exactly one leg from agent owner main to agent owner escrow subaccount with reason LXP_REASON_ESCROW_LOCK, and no other monetary effect."
do_3 = "Record beneficiary, arbiter, asset, locked amount, captured amount, state, expiry timestamp, dispute window, terms hash and agreement reference through lx_escrow_state_put, all under the escrow module namespace."
do_4 = "Model the hold lifecycle as the explicit states Open, PartiallyCaptured, Captured, Released, Disputed, Resolved and TimedOut, rejecting any transition not defined for the current state with LX_ERR_ESCROW_STATE."
do_5 = "Add tests proving the opening transfer is the only effect, that the escrow subaccount is created with a zero opening balance before the credit, and that the recorded amount equals the transferred amount exactly."
symbols = ["lx_escrow_module_iface", "lx_escrow_open_execute", "lx_escrow_state_put", "lx_escrow_lookup"]

[capability.105.11.2]
title = "Implement capture and partial capture out of the escrow subaccount"
reference_namespace = "feature.105"
reqs = ["1124.3", "1124.4", "1124.5", "1124.10", "1116.5"]
touches = ["src/modules/escrow/lx_escrow_capture.c", "include/layerx/lx_escrow.h", "tests/modules/test_escrow_capture.c"]
tests = []
verification_contract = "make test-escrow-capture"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_escrow_capture_execute for the full remaining amount as one leg from the escrow subaccount to the beneficiary account with reason LXP_REASON_ESCROW_CAPTURE, setting the subaccount to zero and marking the hold closed."
do_2 = "Implement lx_escrow_partial_capture_execute to transfer exactly the named smaller amount to the beneficiary, reduce the remaining hold amount by exactly that amount, and keep the hold active for the remainder."
do_3 = "Implement lx_escrow_remaining as the authoritative remaining figure derived from the escrow subaccount balance, so allowance bookkeeping can never diverge from real funds."
do_4 = "Reject a capture exceeding the remaining amount with CAPTURE_EXCEEDS_HOLD, an unknown hold identifier, and a capturing authority that is neither the recorded beneficiary nor an authority delegated by the owner with UNAUTHORIZED_CAPTURE, moving no funds in any of those cases."
do_5 = "Return the original receipt with zero additional funds moved when a capture is resubmitted under an idempotency key that already produced an economic result."
symbols = ["lx_escrow_capture_execute", "lx_escrow_partial_capture_execute", "lx_escrow_remaining"]

[capability.105.11.3]
title = "Implement release and deterministic timeout from batch timestamps"
reference_namespace = "feature.105"
reqs = ["1124.6", "1124.7", "1130.4", "1136.10", "1116.5"]
touches = ["src/modules/escrow/lx_escrow_timeout.c", "include/layerx/lx_escrow.h", "tests/modules/test_escrow_timeout.c"]
tests = []
verification_contract = "make test-escrow-timeout"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_escrow_release_execute to return the entire remaining escrow subaccount balance to the owner main account with reason LXP_REASON_ESCROW_RELEASE, leaving the subaccount at zero and the hold closed."
do_2 = "Implement lx_escrow_timeout_execute so that when the batch timestamp reaches or passes the recorded expiry and the hold is neither closed nor disputed, the remaining balance is released to the owner deterministically during that batch."
do_3 = "Evaluate expiry solely against the sealed batch timestamp through the module context, never a wall clock, a timer or a background job, and drive the production deadline sweep from lx_escrow_batch_maintenance within the signed batch maintenance transition; retain lx_escrow_epoch_begin for authenticated sequencer-term transition callers."
do_4 = "Reject any capture attempted against a timed-out hold with HOLD_EXPIRED, and reject any transfer out of the escrow subaccount that is not a capture, release, expiry release or dispute resolution produced by this module with UNAUTHORIZED_ESCROW_SPEND."
do_5 = "Add a replay test that runs the identical history under two different real elapsed durations and asserts byte-identical roots, proving timeout depends only on batch time."
symbols = ["lx_escrow_release_execute", "lx_escrow_timeout_execute", "lx_escrow_epoch_begin"]

[capability.105.11.4]
title = "Implement dispute entry and atomic dispute resolution"
reference_namespace = "feature.105"
reqs = ["1124.8", "1124.9", "1120.1", "1120.5", "1122.6"]
touches = ["src/modules/escrow/lx_escrow_dispute.c", "include/layerx/lx_escrow.h", "tests/modules/test_escrow_dispute.c"]
tests = []
verification_contract = "make test-escrow-dispute"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_escrow_dispute_open_execute to mark an active hold disputed when the batch timestamp is inside the recorded dispute window, emitting zero transfer legs, and reject a dispute raised after the window with DISPUTE_WINDOW_CLOSED."
do_2 = "Reject subsequent capture, release and expiry release while a hold is disputed with HOLD_DISPUTED until a resolution is accepted."
do_3 = "Implement lx_escrow_dispute_resolve_execute as one atomic transfer set of at most two legs splitting the escrow subaccount balance between beneficiary and owner, requiring that the sum of the legs equals the subaccount balance exactly and leaves it at zero."
do_4 = "Implement lx_escrow_split_bps using integer basis points with floor division and assign the residue explicitly to the owner main account, so dust is never dropped and never implicit."
do_5 = "Roll the whole set back and leave the hold disputed if any leg violates an invariant, and add a test proving no partial split is ever observable."
symbols = ["lx_escrow_dispute_open_execute", "lx_escrow_dispute_resolve_execute", "lx_escrow_split_bps"]

[capability.105.11.5]
title = "Prove held funds are unspendable from the owner main account"
reference_namespace = "feature.105"
reqs = ["1124.2", "1119.9", "1119.1", "1122.2", "1122.4"]
touches = ["src/modules/escrow/lx_escrow_invariants.c", "include/layerx/lx_escrow.h", "tests/modules/test_escrow_invariants.c"]
tests = []
verification_contract = "make test-escrow-invariants"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_escrow_authority_check so the escrow subaccount is debitable only under the escrow authority owned by this module, and an attempted debit under an owner direct signature or a session key is rejected with ERR_UNAUTHORIZED_DEBIT."
do_2 = "Add an adversarial test that opens a hold for the full main balance and then attempts an ordinary transfer of the same amount from the main account, asserting INSUFFICIENT_FUNDS because the funds physically left."
do_3 = "Implement lx_escrow_invariant_check asserting that a terminal hold with a non-zero escrow subaccount balance is an invariant violation that halts the node rather than being logged and skipped."
do_4 = "Add a property test over randomised open, partial capture, release, timeout and dispute sequences asserting that locked amount always equals the escrow subaccount balance and that conservation holds at every step."
do_5 = "Extend the reserve report so every escrow subaccount balance appears as a distinct enumerated line rather than being folded into the owner main balance."
symbols = ["lx_escrow_authority_check", "lx_escrow_invariant_check"]

[capability_group.105.12]
title = "Build the budget module with recurring allowances and delegated spending"
children = ["105.12.1", "105.12.2", "105.12.3", "105.12.4", "105.12.5"]

[capability.105.12.1]
title = "Create and fund budget subaccounts"
reference_namespace = "feature.105"
reqs = ["1125.1", "1116.5", "1119.1", "1122.1"]
touches = ["src/modules/budget/lx_budget_create.c", "include/layerx/lx_budget.h", "tests/modules/test_budget_create.c"]
tests = []
verification_contract = "make test-budget-create"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Register the budget module as module id 3 declaring budget.create, budget.fund, budget.amend, budget.delegate_add, budget.delegate_remove, budget.spend and budget.close."
do_2 = "Implement lx_budget_create_execute and lx_budget_fund_execute to emit exactly one leg from agent owner main to agent owner budget subaccount with reason LXP_REASON_BUDGET_FUND."
do_3 = "Record asset, per-period limit, period length in protocol time units, period start timestamp, rollover policy with its carry cap, delegate set, purpose hash, expiry and revocation sequence through lx_budget_state_put."
do_4 = "Reject a budget whose period length, per-period limit or expiry is absent or out of declared bounds, and reject a duplicate budget identifier, before any funding leg is constructed."
do_5 = "Add tests proving the funding transfer is the only monetary effect and that the budget subaccount balance, not the recorded limit, is the source of spendable value."
symbols = ["lx_budget_module_iface", "lx_budget_create_execute", "lx_budget_fund_execute", "lx_budget_state_put"]

[capability.105.12.2]
title = "Compute recurring period windows from batch timestamps"
reference_namespace = "feature.105"
reqs = ["1125.6", "1130.4", "1136.10", "1114.7"]
touches = ["src/modules/budget/lx_budget_period.c", "include/layerx/lx_budget.h", "tests/modules/test_budget_period.c"]
tests = []
verification_contract = "make test-budget-period"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_budget_periods_elapsed as integer division of the batch timestamp minus period start by the period length, with no timer, no cron and no wall-clock read anywhere in the path."
do_2 = "Implement lx_budget_rollover to advance the period start by whole period lengths and reset the remaining allowance to the configured per-period limit at the first activity in a batch that observes the boundary."
do_3 = "Implement the carry-forward policy by adding unspent allowance into the new period up to the configured carry cap and discarding the excess, and the discard policy by dropping all unspent allowance."
do_4 = "Drive rollover of committed Budget KV records from lx_budget_batch_maintenance and the spend path so a budget untouched for many periods rolls forward identically however it is next observed; retain lx_budget_epoch_begin for authenticated sequencer-term transition callers."
do_5 = "Add a replay test crossing several period boundaries in one batch and assert byte-identical resulting state roots on repeat execution."
symbols = ["lx_budget_periods_elapsed", "lx_budget_rollover", "lx_budget_epoch_begin"]

[capability.105.12.3]
title = "Implement allowance accounting and budget spends"
reference_namespace = "feature.105"
reqs = ["1125.2", "1125.3", "1125.4", "1116.5", "1122.1"]
touches = ["src/modules/budget/lx_budget_spend.c", "include/layerx/lx_budget.h", "tests/modules/test_budget_spend.c"]
tests = []
verification_contract = "make test-budget-spend"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_budget_spend_execute to emit exactly one leg from the budget subaccount to the named recipient main account with reason LXP_REASON_BUDGET_SPEND."
do_2 = "Implement lx_budget_allowance_debit to reduce the remaining period allowance by exactly the spent amount at execution time, so concurrent or reordered submissions can never exceed the limit in aggregate."
do_3 = "Reject a spend above the remaining period allowance with BUDGET_ALLOWANCE_EXCEEDED even when the subaccount holds enough balance, and reject a spend within the allowance but above the subaccount balance with INSUFFICIENT_BUDGET_FUNDS, so allowance accounting alone never creates spendable value."
do_4 = "Implement lx_budget_remaining as the minimum of the remaining period allowance and the subaccount balance, and expose it to the read path so callers see the truly spendable figure."
do_5 = "Add tests for exhaustion at the exact limit, a spend straddling a period boundary and a spend against a defunded budget."
symbols = ["lx_budget_spend_execute", "lx_budget_allowance_debit", "lx_budget_remaining"]

[capability.105.12.4]
title = "Authorise delegated spenders and recipient-initiated pulls"
reference_namespace = "feature.105"
reqs = ["1125.5", "1125.10", "1112.3", "1112.4", "1118.3"]
touches = ["src/modules/budget/lx_budget_delegate.c", "include/layerx/lx_budget.h", "tests/modules/test_budget_delegate.c"]
tests = []
verification_contract = "make test-budget-delegate"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_budget_delegate_add_execute and lx_budget_delegate_remove_execute to maintain the delegate set in canonical byte-lexicographic order with no monetary effect of their own."
do_2 = "Implement lx_budget_authorize_delegate to reject a submitter absent from the delegate set, or whose capability has expired, or whose scope does not cover the asset, recipient or amount, with UNAUTHORIZED_DELEGATE and no monetary effect."
do_3 = "Accumulate delegated consumption inside state at execution time so the first activity that would carry cumulative consumption past a delegated limit is rejected."
do_4 = "Support recipient-initiated pulls only under a signed payer grant naming the authorised recipient, asset, maximum amount, allowance kind, expiry, permitted purpose and revocation sequence, rejecting anything beyond the grant with GRANT_SCOPE_VIOLATION."
do_5 = "Add tests for a revoked delegate, an expired capability, an out-of-scope recipient and a pull exceeding the grant maximum."
symbols = ["lx_budget_delegate_add_execute", "lx_budget_delegate_remove_execute", "lx_budget_authorize_delegate"]

[capability.105.12.5]
title = "Implement defunding, revocation and budget closure"
reference_namespace = "feature.105"
reqs = ["1125.7", "1125.8", "1125.9", "1116.5", "1122.2"]
touches = ["src/modules/budget/lx_budget_close.c", "include/layerx/lx_budget.h", "tests/modules/test_budget_close.c"]
tests = []
verification_contract = "make test-budget-revoke"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_budget_defund_execute to move the requested amount from the budget subaccount back to the owner main account and reduce the remaining period allowance so it never exceeds the resulting subaccount balance."
do_2 = "Implement lx_budget_revoke_execute to move the entire remaining subaccount balance to the owner main account in the same activity, mark the budget revoked, and reject every later spend with BUDGET_REVOKED."
do_3 = "Reject a revocation or capability update whose revocation sequence is not strictly greater than the recorded one with STALE_REVOCATION, so a replayed authorisation can never reinstate a revoked delegate."
do_4 = "Implement lx_budget_close_execute to drain the subaccount to zero, omitting the leg entirely when the balance is already zero rather than emitting a zero-amount leg."
do_5 = "Add tests proving a revoked budget leaves no stranded value and that a spend ordered before the revocation stays intact while one ordered after is rejected."
symbols = ["lx_budget_defund_execute", "lx_budget_revoke_execute", "lx_budget_close_execute"]

[capability_group.105.13]
title = "Build the stream module for time-based and metered payments"
children = ["105.13.1", "105.13.2", "105.13.3", "105.13.4", "105.13.5"]

[capability.105.13.1]
title = "Open and top up streams into a stream subaccount"
reference_namespace = "feature.105"
reqs = ["1126.1", "1116.5", "1119.1", "1122.1"]
touches = ["src/modules/stream/lx_stream_open.c", "include/layerx/lx_stream.h", "tests/modules/test_stream_open.c"]
tests = []
verification_contract = "make test-stream-open"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Register the stream module as module id 4 declaring stream.open, stream.top_up, stream.meter, stream.settle, stream.pause, stream.resume and stream.close."
do_2 = "Implement lx_stream_open_execute and lx_stream_top_up_execute to emit exactly one leg from agent payer main to agent payer stream subaccount with reason LXP_REASON_STREAM_FUND, and no other monetary effect."
do_3 = "Record recipient, asset, mode as TIME or METERED, rate per second or price per unit, rate unit, start timestamp, optional end timestamp, total cap, drawn total and remainder carry through lx_stream_state_put."
do_4 = "Register the meter authority key set for a metered stream at open time so later usage attestations have a recorded authority to verify against."
do_5 = "Add tests proving the funding transfer is the only effect at open and that a top up resumes a previously underfunded stream from the top-up timestamp."
symbols = ["lx_stream_module_iface", "lx_stream_open_execute", "lx_stream_top_up_execute", "lx_stream_state_put"]

[capability.105.13.2]
title = "Implement deterministic integer accrual from batch timestamps"
reference_namespace = "feature.105"
reqs = ["1126.2", "1126.3", "1126.4", "1126.10", "1114.5"]
touches = ["src/modules/stream/lx_stream_accrue.c", "include/layerx/lx_stream.h", "tests/modules/test_stream_accrue.c"]
tests = []
verification_contract = "make test-stream-accrual"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_stream_elapsed_ms deriving elapsed protocol time solely from sealed batch header timestamps, never an operating system clock or any value outside replayable history."
do_2 = "Implement lx_stream_accrue multiplying rate by elapsed time into 256 bits, adding the carried residue, floor-dividing to the smallest indivisible unit and writing the new residue back through lx_stream_carry_apply, so nothing is rounded away and the payer is never over-drawn by a rounding artifact."
do_3 = "Reject a negative elapsed interval or a batch timestamp earlier than the last settlement for that stream with NON_MONOTONIC_TIME and move no funds."
do_4 = "Reject an accrual product that would exceed the maximum representable fixed-width value with ACCRUAL_OVERFLOW rather than wrapping, saturating or truncating."
do_5 = "Stop accrual exactly at the recorded end timestamp or total cap and cap the lifetime paid amount at the recorded total cap."
do_6 = "Add a replay test running an identical timestamp history twice and asserting byte-identical accrued amounts and residues."
symbols = ["lx_stream_accrue", "lx_stream_elapsed_ms", "lx_stream_carry_apply"]

[capability.105.13.3]
title = "Implement metered accrual from signed usage attestations"
reference_namespace = "feature.105"
reqs = ["1126.5", "1126.2", "1126.4", "1116.8"]
touches = ["src/modules/stream/lx_stream_meter.c", "include/layerx/lx_stream.h", "tests/modules/test_stream_meter.c"]
tests = []
verification_contract = "make test-stream-meter"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_stream_meter_execute to accept a cumulative meter reading and accrue the delta multiplied by the recorded unit price under the same floor rounding rule as time-based accrual."
do_2 = "Implement lx_stream_meter_authority_check rejecting an attestation not signed by a meter authority recorded for the stream with UNAUTHORIZED_METER, verified over the canonical attestation bytes under its domain tag."
do_3 = "Reject a cumulative reading lower than the last recorded reading with METER_REGRESSION and accrue nothing, so meters are monotone by protocol rule."
do_4 = "Emit zero transfer legs from the meter activity itself, leaving all value movement to the settlement path."
do_5 = "Add tests for a regressed reading, an unauthorised meter, a duplicate reading and a reading that overflows the accrual product."
symbols = ["lx_stream_meter_execute", "lx_stream_meter_authority_check", "lx_stream_metered_accrue"]

[capability.105.13.4]
title = "Settle streams through the ledger kernel with underfunded clamping"
reference_namespace = "feature.105"
reqs = ["1126.3", "1126.6", "1126.9", "1116.5", "1122.4"]
touches = ["src/modules/stream/lx_stream_settle.c", "include/layerx/lx_stream.h", "tests/modules/test_stream_settle.c"]
tests = []
verification_contract = "make test-stream-settle"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_stream_settle_amount as newly accrued minus already settled, and lx_stream_settle_execute emitting one leg from the payer stream subaccount to the recipient main account with reason LXP_REASON_STREAM_DRAW."
do_2 = "Clamp a settlement that exceeds the stream subaccount balance to the available balance, mark the stream underfunded through lx_stream_mark_underfunded, and suspend further accrual from that settlement timestamp."
do_3 = "Create no debt and never allow any account to become negative, and resume accrual only from the timestamp of a later top-up activity."
do_4 = "Return the original receipt with no additional funds moved when a settlement is resubmitted under an idempotency key that already produced an economic result."
do_5 = "Add tests for exact-balance settlement, an underfunded clamp followed by a top up, and a settlement against a closed stream returning STREAM_CLOSED."
symbols = ["lx_stream_settle_execute", "lx_stream_settle_amount", "lx_stream_mark_underfunded"]

[capability.105.13.5]
title = "Implement pause, resume and cancellation"
reference_namespace = "feature.105"
reqs = ["1126.7", "1126.8", "1126.9", "1120.1", "1116.5"]
touches = ["src/modules/stream/lx_stream_lifecycle.c", "include/layerx/lx_stream.h", "tests/modules/test_stream_lifecycle.c"]
tests = []
verification_contract = "make test-stream-lifecycle"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_stream_pause_execute to settle accrual up to the batch timestamp of the pause and accrue nothing for the paused interval."
do_2 = "Implement lx_stream_resume_execute to accrue again only from the batch timestamp of the resume, with no retroactive catch-up for the paused window."
do_3 = "Implement lx_stream_close_execute as one atomic transfer set paying the accrued unsettled amount to the recipient and returning the entire remaining stream subaccount balance to the payer main account, leaving the subaccount at zero and the stream closed."
do_4 = "Roll the whole set back and leave the stream open if any leg violates an invariant, and omit a zero-amount return leg rather than emitting it."
do_5 = "Reject a pause, resume, settle or cancel against an already closed stream with STREAM_CLOSED and restrict pause and resume to an authorised party."
do_6 = "Add a property test over randomised pause, resume, meter, settle and close sequences asserting conservation and a zero terminal subaccount balance."
symbols = ["lx_stream_pause_execute", "lx_stream_resume_execute", "lx_stream_close_execute"]

[capability_group.105.14]
title = "Build the service module covering the complete agent work lifecycle"
children = ["105.14.1", "105.14.2", "105.14.3", "105.14.4", "105.14.5", "105.14.6"]

[capability.105.14.1]
title = "Implement offers and agreement formation"
reference_namespace = "feature.105"
reqs = ["1127.2", "1127.3", "1127.1", "1116.8", "1113.3"]
touches = ["src/modules/service/lx_service_offer.c", "include/layerx/lx_service.h", "tests/modules/test_service_offer.c"]
tests = []
verification_contract = "make test-service-offer"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Register the service module as module id 5 declaring service.offer_publish, service.offer_withdraw, service.agreement_propose, service.agreement_accept, service.commit_task, service.commit_abandon, service.tool_exec_attest, service.progress_report, service.deliver, service.accept, service.reject, service.dispute_open and service.dispute_resolve."
do_2 = "Implement lx_service_offer_publish_execute recording the offering agent, asset, price, terms hash, deliverable specification hash, delivery deadline, acceptance window, dispute window, default outcome and offer expiry, assigning it a global sequence and including it in the activity merkle root of its batch."
do_3 = "Implement lx_service_agreement_accept_execute binding the acceptance to the offer activity id and requiring an exact match of the recorded terms hash, rejecting an expired, already accepted or withdrawn offer with OFFER_UNAVAILABLE and a differing hash with TERMS_MISMATCH."
do_4 = "Emit zero transfer legs from every activity in this subtask, and reject with MODULE_MAY_NOT_WRITE_BALANCE any service payload that attempts to encode a balance mutation of its own."
do_5 = "Reference any escrow hold only by identifier through the agreement record, leaving the hold itself to the escrow module and the ledger."
symbols = ["lx_service_module_iface", "lx_service_offer_publish_execute", "lx_service_offer_withdraw_execute", "lx_service_agreement_accept_execute"]

[capability.105.14.2]
title = "Record work commitments as ordered attested activities"
reference_namespace = "feature.105"
reqs = ["1127.4", "1127.1", "1116.8", "1111.9"]
touches = ["src/modules/service/lx_service_commit.c", "include/layerx/lx_service.h", "tests/modules/test_service_commit.c"]
tests = []
verification_contract = "make test-service-commit"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_service_commit_task_execute recording the committing provider identity, the agreement id, the task hash, the deadline as a protocol timestamp bound, the declared resource bound and the identifier of any referenced escrow hold."
do_2 = "Move no funds from the commitment even when an escrow hold is named, so the commitment is evidence and the hold is a separate authenticated transfer."
do_3 = "Implement lx_service_commit_abandon_execute to close a commitment with a reason code, leaving any referenced hold to expire or be resolved by the escrow module on its own rules."
do_4 = "Reject a commitment from an identity that is not a party to the agreement, or against an agreement not in an admitting state, with LX_ERR_AGREEMENT_STATE."
do_5 = "Add tests asserting the receipt effect list for a commitment contains zero transfer effects and that the commitment record is reproduced byte-identically on replay."
symbols = ["lx_service_commit_task_execute", "lx_service_commit_abandon_execute", "lx_service_commitment_put"]

[capability.105.14.3]
title = "Implement tool execution attestations"
reference_namespace = "feature.105"
reqs = ["1127.5", "1112.7", "1113.10", "1116.8"]
touches = ["src/modules/service/lx_service_attest.c", "include/layerx/lx_service.h", "tests/modules/test_service_attest.c"]
tests = []
verification_contract = "make test-service-attest"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_service_tool_exec_attest_execute requiring a tool identifier, an input commitment hash, an output commitment hash, execution start and end timestamp bounds, resource units and an attestor identity."
do_2 = "Implement lx_service_attestor_verify to check the signature under a key holding attestation authority for the committing agent, rejecting an invalid signature, a revoked or expired key, or an absent required commitment hash with INVALID_ATTESTATION."
do_3 = "Order the attestation in the activity log and commit its exact payload bytes into the activity merkle root, storing the commitment on chain and the bytes behind the data availability reference."
do_4 = "Emit zero transfer legs, so an attestation is replayable evidence that a tool ran on a named input and produced a named output, never a payment trigger."
do_5 = "Add tests for a revoked attestor key, a missing output hash, a duplicate attestation and canonical round-trip of the attestation record."
symbols = ["lx_service_tool_exec_attest_execute", "lx_service_attestor_verify", "lx_service_execution_put"]

[capability.105.14.4]
title = "Implement delivery with deliverable hashes and availability references"
reference_namespace = "feature.105"
reqs = ["1127.6", "1127.1", "1132.1", "1116.8", "1115.4"]
touches = ["src/modules/service/lx_service_deliver.c", "include/layerx/lx_service.h", "tests/modules/test_service_deliver.c"]
tests = []
verification_contract = "make test-service-deliver"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_service_deliver_execute recording every deliverable hash with its artifact size and data availability reference, in canonical sorted order."
do_2 = "Implement lx_service_deliverable_check rejecting a deliverable hash that does not match the deliverable specification hash committed in the accepted offer with DELIVERABLE_MISMATCH."
do_3 = "Reject a delivery whose batch timestamp is later than the recorded delivery deadline with DELIVERY_DEADLINE_PASSED, evaluated only against the sealed batch timestamp."
do_4 = "Emit zero transfer legs and require any resulting payment to execute as a separate escrow capture or ledger transfer referencing the same agreement id through context_hash."
do_5 = "Add tests for a mismatched deliverable, a late delivery, a redelivery after rejection and a delivery whose availability reference is absent."
symbols = ["lx_service_deliver_execute", "lx_service_deliverable_check", "lx_service_delivery_put"]

[capability.105.14.5]
title = "Implement acceptance, rejection and the deterministic deadline outcome"
reference_namespace = "feature.105"
reqs = ["1127.7", "1127.8", "1127.9", "1116.8", "1136.10"]
touches = ["src/modules/service/lx_service_acceptance.c", "include/layerx/lx_service.h", "tests/modules/test_service_acceptance.c"]
tests = []
verification_contract = "make test-service-acceptance"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_service_accept_execute to mark the agreement accepted and closed for delivery purposes when the buyer accepts within the acceptance window, emitting zero transfer legs."
do_2 = "Implement lx_service_reject_execute recording the rejection reason code and the contested deliverable hashes, and holding the agreement in a disputable state until the recorded dispute window closes."
do_3 = "Implement lx_service_batch_maintenance to apply the default outcome recorded in the accepted offer terms deterministically during the first batch whose timestamp crosses the acceptance window end, as a receipted batch transition; retain lx_service_acceptance_default and lx_service_epoch_begin for authenticated sequencer-term transition callers."
do_4 = "Require any resulting payment to execute as a separate 402LXP escrow capture or transfer rather than as an effect of the acceptance activity itself."
do_5 = "Add a replay test proving the default outcome applies identically on every replay of the same history and is never influenced by when the replay is run."
symbols = ["lx_service_accept_execute", "lx_service_reject_execute", "lx_service_acceptance_default", "lx_service_epoch_begin"]

[capability.105.14.6]
title = "Implement service disputes and prove zero direct monetary effect"
reference_namespace = "feature.105"
reqs = ["1127.10", "1127.1", "1116.8", "1122.1"]
touches = ["src/modules/service/lx_service_dispute.c", "include/layerx/lx_service.h", "tests/modules/test_service_dispute.c"]
tests = []
verification_contract = "make test-service-dispute"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_service_dispute_open_execute ordering the dispute and recording the evidence hashes it carries when the raiser is a party and the batch timestamp is inside the recorded dispute window."
do_2 = "Reject a raiser who is not a party with UNAUTHORIZED_DISPUTANT and a dispute past the window end with DISPUTE_WINDOW_CLOSED."
do_3 = "Implement lx_service_dispute_resolve_execute to record the ruling and its basis points, and to reference the escrow dispute resolution that actually moves the funds rather than moving them here."
do_4 = "Implement lx_service_effect_audit asserting across every service activity type that the emitted effect list contains zero transfer effects, and wire it into the module test target."
do_5 = "Add an end-to-end test running offer, accept, commit, attest, deliver, accept-delivery and escrow capture, asserting that every unit of value moved through the ledger kernel and none through the service module."
symbols = ["lx_service_dispute_open_execute", "lx_service_dispute_resolve_execute", "lx_service_effect_audit"]

[capability_group.105.15]
title = "Build the oracle adapter and signed oracle activity intake"
children = ["105.15.1", "105.15.2", "105.15.3", "105.15.4", "105.15.5"]

[capability.105.15.1]
title = "Keep the Crossverse adapter entirely outside execution"
reference_namespace = "feature.105"
reqs = ["1113.5", "1128.5", "1136.8", "1114.8"]
touches = ["src/network/lx_oracle_adapter.c", "include/layerx/lx_oracle.h", "tests/network/test_oracle_adapter.c"]
tests = []
verification_contract = "make test-oracle-adapter"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_oracle_adapter_run in the network layer so it polls Crossverse, canonically encodes each observation and submits it as an ordinary signed activity, with no code path from a state transition out to the network."
do_2 = "Implement lx_oracle_observation_sign over the domain-separated canonical bytes of the observation using the oracle key, and lx_oracle_activity_encode to wrap it as a standard activity envelope with its own account sequence and fee limit."
do_3 = "Include market id, observation sequence, price scaled by the market quote decimals, observed-at timestamp and source identifier as integer fields only, with no floating point anywhere in the encoding."
do_4 = "Add lx_oracle_adapter_isolation_check to the build so no translation unit under src/modules, src/ledger, src/state or src/protocol links any socket, HTTP or DNS symbol, keeping the adapter strictly a submitter."
do_5 = "Add a test that runs a full replay with the adapter binary absent, proving execution outcomes depend only on already accepted oracle activities."
symbols = ["lx_oracle_adapter_run", "lx_oracle_observation_sign", "lx_oracle_activity_encode", "lx_oracle_adapter_isolation_check"]

[capability.105.15.2]
title = "Admit oracle observations as ordered signed activities"
reference_namespace = "feature.105"
reqs = ["1128.5", "1122.11", "1113.5", "1116.8"]
touches = ["src/modules/perps/lx_oracle_intake.c", "include/layerx/lx_oracle.h", "tests/modules/test_oracle_intake.c"]
tests = []
verification_contract = "make test-oracle-intake"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_oracle_push_execute to accept an observation only when signed by a key in the market permitted oracle key set, verified by lx_oracle_key_set_check over the canonical observation bytes."
do_2 = "Store the exact accepted payload bytes through lx_oracle_store_put so the observation becomes part of replayable history rather than a derived value."
do_3 = "Emit zero transfer legs from the observation itself, so external data can never directly alter a balance and any effect executes later as a separately authorised activity."
do_4 = "Implement lx_oracle_observation_decode rejecting a non-canonical encoding, an unknown market, an unregistered oracle key and any non-integer price representation."
do_5 = "Add tests proving an accepted observation changes no balance and that an unregistered oracle key is rejected outright rather than downgraded."
symbols = ["lx_oracle_push_execute", "lx_oracle_key_set_check", "lx_oracle_store_put", "lx_oracle_observation_decode"]

[capability.105.15.3]
title = "Enforce staleness, monotonicity, bounds and deviation limits"
reference_namespace = "feature.105"
reqs = ["1128.6", "1128.1", "1130.4", "1114.7"]
touches = ["src/modules/perps/lx_oracle_checks.c", "include/layerx/lx_oracle.h", "tests/modules/test_oracle_checks.c"]
tests = []
verification_contract = "make test-oracle-bounds"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_oracle_staleness_check comparing the observation time against the sealed batch timestamp and the configured maximum staleness for the market, with no wall-clock read."
do_2 = "Reject an observation sequence that is not strictly greater than the last accepted one for that market, so replayed or reordered observations cannot be admitted twice."
do_3 = "Implement lx_oracle_bounds_check and lx_oracle_deviation_check to reject a price outside the configured bounds or beyond the configured deviation limit from the last accepted price, using integer basis points only."
do_4 = "Implement lx_oracle_store_latest returning the most recently accepted in-bound observation for a market, and never substitute, extrapolate or reuse a last-known price for a rejected one."
do_5 = "Add tests for a stale observation, a regressed sequence, an out-of-bounds price and a price at the exact deviation boundary."
symbols = ["lx_oracle_staleness_check", "lx_oracle_bounds_check", "lx_oracle_deviation_check", "lx_oracle_store_latest"]

[capability.105.15.4]
title = "Commit accepted oracle inputs into the batch oracle root"
reference_namespace = "feature.105"
reqs = ["1130.1", "1115.5", "1132.1", "1131.3"]
touches = ["src/sequencer/lx_oracle_root.c", "include/layerx/lx_batch.h", "tests/sequencer/test_oracle_root.c"]
tests = []
verification_contract = "make test-oracle-root"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_oracle_leaf_encode as the canonical encoding of an accepted observation including its signature, and lx_oracle_root_compute as a merkle root over those leaves in canonical order."
do_2 = "Use distinct domain tags for oracle leaves and internal nodes and a single deterministic rule for leaf counts that are not a power of two, so a node can never be reinterpreted as a leaf."
do_3 = "Wire lx_batch_header_set_oracle_root into batch sealing so oracle_root is one of the header commitments a guarantor independently recomputes."
do_4 = "Include the accepted oracle inputs in the data availability bundle so a guarantor attesting possession is attesting to the exact bytes that were executed."
do_5 = "Add a test recomputing oracle_root from served availability bytes and asserting byte equality with the sealed header value."
symbols = ["lx_oracle_root_compute", "lx_oracle_leaf_encode", "lx_batch_header_set_oracle_root"]

[capability.105.15.5]
title = "Fail closed by halting an affected market rather than guessing"
reference_namespace = "feature.105"
reqs = ["1128.7", "1128.6", "1122.11", "1136.9"]
touches = ["src/modules/perps/lx_oracle_halt.c", "include/layerx/lx_oracle.h", "tests/modules/test_oracle_halt.c"]
tests = []
verification_contract = "make test-oracle-failclosed"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_oracle_fail_closed_eval so that when no acceptable observation exists for a market within the required freshness window the market is halted through lx_oracle_market_halt rather than falling back to any substituted price."
do_2 = "Implement lx_oracle_market_halted as the single query every market-touching path consults, rejecting new orders, position increases and liquidations for a halted market with MARKET_HALTED."
do_3 = "Suspend funding accrual for a halted market and permit only order cancellation and margin additions while it stays halted."
do_4 = "Resume a market only when a fresh in-bound observation from a permitted oracle key is accepted, never on elapsed time and never by operator action outside the ordered activity log."
do_5 = "Add tests for halt on staleness, rejection of every disallowed activity while halted, and resumption on the first valid fresh observation."
symbols = ["lx_oracle_fail_closed_eval", "lx_oracle_market_halt", "lx_oracle_market_halted"]

[capability_group.105.16]
title = "Build the perps module with real margin accounts and atomic liquidation"
children = ["105.16.1", "105.16.2", "105.16.3", "105.16.4", "105.16.5", "105.16.6"]

[capability.105.16.1]
title = "Define markets as integer parameter records"
reference_namespace = "feature.105"
reqs = ["1128.1", "1113.3", "1114.2", "1129.1"]
touches = ["src/modules/perps/lx_perps_market.c", "include/layerx/lx_perps.h", "tests/modules/test_perps_market.c"]
tests = []
verification_contract = "make test-perps-market"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Register the perps module as module id 6 declaring perps.market_create, perps.market_halt, perps.oracle_push, perps.order_place, perps.order_cancel, perps.position_open, perps.position_increase, perps.position_close, perps.funding_tick, perps.liquidate and perps.adl."
do_2 = "Implement lx_perps_market_create_execute recording market id, quote asset, contract size, tick size, lot size, initial and maintenance margin ratios in basis points, funding interval, maximum oracle staleness, price bounds and the permitted oracle key set, all as integer parameters."
do_3 = "Reject a duplicate market id with MARKET_ALREADY_EXISTS and reject any parameter outside its declared governance bounds before recording anything."
do_4 = "Implement lx_perps_market_put and lx_perps_market_lookup over the module namespace with canonical byte-lexicographic iteration order."
do_5 = "Add tests for a duplicate market, an out-of-bounds margin ratio and canonical round-trip of the market record."
symbols = ["lx_perps_module_iface", "lx_perps_market_create_execute", "lx_perps_market_put", "lx_perps_market_lookup"]

[capability.105.16.2]
title = "Implement the order book and deterministic matching rules"
reference_namespace = "feature.105"
reqs = ["1128.2", "1128.7", "1114.4", "1114.9"]
touches = ["src/modules/perps/lx_perps_book.c", "include/layerx/lx_perps.h", "tests/modules/test_perps_book.c"]
tests = []
verification_contract = "make test-perps-book"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement the resting book keyed by market id, side, price and global sequence, iterated in canonical order with no dependence on pointer values, allocation order or hash seeds."
do_2 = "Implement lx_perps_book_match applying fixed price then sequence priority in canonical global sequence order, so matching is a pure function of the ordered history."
do_3 = "Implement lx_perps_order_place_execute rejecting an order that would require more initial margin than the agent can fund with INSUFFICIENT_MARGIN before touching the book or any balance."
do_4 = "Implement lx_perps_order_cancel_execute and permit cancellation even while the market is halted, while rejecting placements and increases with MARKET_HALTED."
do_5 = "Emit zero transfer legs from order placement and cancellation, leaving margin movement to the position path."
do_6 = "Add a determinism test replaying an identical order stream twice and asserting byte-identical books and fills."
symbols = ["lx_perps_order_place_execute", "lx_perps_order_cancel_execute", "lx_perps_book_match", "lx_perps_book_iter"]

[capability.105.16.3]
title = "Hold position margin in a real margin subaccount"
reference_namespace = "feature.105"
reqs = ["1128.3", "1119.7", "1119.8", "1116.7", "1122.1"]
touches = ["src/modules/perps/lx_perps_position.c", "include/layerx/lx_perps.h", "tests/modules/test_perps_position.c"]
tests = []
verification_contract = "make test-perps-margin"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_perps_position_open_execute and lx_perps_position_increase_execute to move initial or additional margin by a transfer from agent main to agent margin subaccount for that position with reason LXP_REASON_MARGIN_POST."
do_2 = "Implement lx_perps_margin_release to move margin back from the margin subaccount to agent main with reason LXP_REASON_MARGIN_RELEASE, and never satisfy a margin requirement by setting a reserved-margin field."
do_3 = "Treat the margin subaccount balance as the collateral of record for the position, and record size, entry notional, margin account and funding index at entry in position state."
do_4 = "Drain the margin subaccount to zero through explicit legs on close, settle or liquidation, and reject any closure that would leave residual value stranded in it."
do_5 = "Reject a debit of a margin subaccount presented under an owner direct signature or a session key with ERR_UNAUTHORIZED_DEBIT, since only the protocol-module capability may debit it."
do_6 = "Add tests asserting that opening a position changes the main and margin balances by exactly the margin amount and that the reserve report shows the margin subaccount as its own line."
symbols = ["lx_perps_position_open_execute", "lx_perps_position_increase_execute", "lx_perps_margin_post", "lx_perps_margin_release"]

[capability.105.16.4]
title = "Compute PnL and funding deterministically and settle funding transfers"
reference_namespace = "feature.105"
reqs = ["1128.4", "1128.8", "1116.7", "1122.5", "1114.5"]
touches = ["src/modules/perps/lx_perps_funding.c", "include/layerx/lx_perps.h", "tests/modules/test_perps_funding.c"]
tests = []
verification_contract = "make test-perps-funding"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_perps_pnl_compute multiplying into 256 bits and floor-dividing back, with one fixed rounding rule that rounds against the trader and in favour of the protocol, and no floating point anywhere in the path."
do_2 = "Implement lx_perps_funding_rate from the last accepted in-bound oracle price and the market parameters using integer basis points only, and lx_perps_funding_index_update to advance the funding index."
do_3 = "Implement lx_perps_funding_tick_execute to settle funding when the funding interval elapses according to batch timestamps, emitting one sign-determined leg between the long and short funding accounts of that market with reason LXP_REASON_FUNDING."
do_4 = "Require the sum of debits to equal the sum of credits for every funding settlement so funding never mints or burns value, and suspend funding accrual entirely while the market is halted."
do_5 = "Reject any intermediate computation that would overflow with ARITHMETIC_OVERFLOW rather than wrapping, saturating or truncating."
do_6 = "Add exhaustive boundary tests over the funding and PnL routines plus a cross-architecture replay assertion on the resulting balances."
symbols = ["lx_perps_pnl_compute", "lx_perps_funding_rate", "lx_perps_funding_tick_execute", "lx_perps_funding_index_update"]

[capability.105.16.5]
title = "Execute liquidation as one atomic multi-leg transfer set"
reference_namespace = "feature.105"
reqs = ["1128.9", "1120.3", "1116.7", "1122.6", "1122.4"]
touches = ["src/modules/perps/lx_perps_liquidate.c", "include/layerx/lx_perps.h", "tests/modules/test_perps_liquidate.c"]
tests = []
verification_contract = "make test-perps-liquidation"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_perps_maintenance_check to detect a position whose margin ratio falls below the maintenance margin ratio at the most recently accepted in-bound oracle price."
do_2 = "Implement lx_perps_liquidation_legs_build producing the legs in the fixed order margin subaccount to market liquidity, margin subaccount to the liquidation fee accounts, insurance to market liquidity for any deficit, and remaining margin to agent main."
do_3 = "Implement lx_perps_liquidation_fee_split using integer basis points to divide the fee between the liquidator main account and system insurance, rounding up in favour of the protocol and assigning the residue explicitly."
do_4 = "Submit the whole thing as one transfer set with one authorisation context, one execution sequence and one receipt, omitting any computed-zero leg before authorisation."
do_5 = "Roll the entire set back and leave the position open and unchanged if any leg violates an invariant, and reject a liquidation while the market is halted."
do_6 = "Add tests reproducing the worked solvent and deficit cases leg by leg and asserting the margin subaccount reaches exactly zero with conservation holding on gross sums."
symbols = ["lx_perps_liquidate_execute", "lx_perps_liquidation_legs_build", "lx_perps_liquidation_fee_split", "lx_perps_maintenance_check"]

[capability.105.16.6]
title = "Cover deficits from the insurance pool without minting value"
reference_namespace = "feature.105"
reqs = ["1128.10", "1116.7", "1120.5", "1122.4", "1122.1"]
touches = ["src/modules/perps/lx_perps_insurance.c", "include/layerx/lx_perps.h", "tests/modules/test_perps_insurance.c"]
tests = []
verification_contract = "make test-perps-insurance"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lx_perps_insurance_cover emitting the insurance to liquidity leg only for the exact computed deficit, and failing the whole liquidation atomically when the pool cannot cover its net movement."
do_2 = "Implement lx_perps_deficit_record to record an explicit deficit against the insurance account when the loss exceeds both available margin and insurance balance, minting nothing and allowing no balance to become negative."
do_3 = "Implement lx_perps_adl_execute to deleverage counterparties from market liquidity in ascending position id order, one leg each, when a position cannot be liquidated solvently."
do_4 = "Express every monetary effect of the perps module and its oracle adapter exclusively as authenticated transfers, and assert in test that no perps path writes a balance directly."
do_5 = "Add a property test over randomised price paths, liquidations and deficits asserting per-asset conservation and a non-negative balance for every account at every step."
symbols = ["lx_perps_insurance_cover", "lx_perps_deficit_record", "lx_perps_adl_execute"]

[capability_group.105.17]
