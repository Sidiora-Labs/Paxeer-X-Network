obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Establish the test layout for the crates - unit, integration, property and fault-injection suites - and for the app - component, journey and end-to-end suites - each mapped to a make target."
do_2 = "Stand up the browser end-to-end harness able to drive both shells against a real service, with device profiles for the mobile and desktop shells and trace capture on failure."
do_3 = "Stand up visual regression across both shells at the canonical @layerx/ui mobile and desktop reference viewports with a reviewed-baseline workflow."
do_4 = "Build the state-matrix registry: every screen declares its loading, empty, error, offline, degraded and still-checking states in a manifest the suite enumerates, failing on a missing declaration or an unrenderable state."
do_5 = "Add the CI workflow running build, lint, UI gates, unit and component suites on every change and the browser suites on merge, with the longer suites scheduled."
symbols = ["human_test_harness", "human_state_matrix_registry"]

[capability_group.102.2]
title = "Extend the agent contract with approval operations"
children = ["102.2.1", "102.2.2", "102.2.3", "102.2.4", "102.2.5"]

[capability.102.2.1]
title = "Define the approval module schema"
reference_namespace = "feature.102"
reqs = ["1029.1", "1029.9"]
touches = ["agent/schema/agent-api/approval.kvx", "agent/schema/agent-api/v1.kvx", "agent/schema/agent-api/golden/approval.kvx"]
tests = []
verification_contract = "make agent-test"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Define approval.kvx in the agent-api schema with the list, get, approve and reject operations, the approval record carrying the held activity's structured disclosure, its canonical-bytes digest, its hold reason, its creation time and its deterministic expiry, and the lifecycle event types."
do_2 = "Include the module from v1.kvx as an additive minor-version change, leaving every existing declaration untouched, and record the minor bump in the schema compatibility notes."
do_3 = "Add golden request and response vectors for every approval operation and event."
do_4 = "Extend the schema conformance suite so the golden vectors and the additive-only rule are enforced for the new module."
do_5 = "Update the contract documentation to state that approvals are a daemon-enforced restriction and confer no protocol authority."
symbols = ["agent_api_approval_module"]

[capability.102.2.2]
title = "Implement approval operations in the daemon"
reference_namespace = "feature.102"
reqs = ["1029.2", "1029.3", "1029.4"]
touches = ["agent/crates/layerx-agentd/src/approval/mod.rs", "agent/crates/layerx-agentd/tests/approval_ops.rs"]
tests = []
verification_contract = "make agent-test-approvals"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement list, get, approve and reject in layerx-agentd over the existing policy hold store, scoped to the authenticated tenant like every other operation."
do_2 = "Carry the held activity's disclosure and digest on every approval record, verifying at read time that the disclosure re-encodes byte-identically to the digest's preimage and reporting a mismatch as a defective hold that cannot be approved."
do_3 = "Make approve release exactly the held prepared activity into the existing submission path, voiding the hold if the underlying activity changed in any way since the hold was created."
do_4 = "Make reject cancel the hold and release its reservations deterministically, reporting the refusal to the requesting agent with a typed result."
do_5 = "Return typed results for every outcome: granted, rejected, expired, defective, already-decided and conflict."
symbols = ["layerx_agentd::approval::ApprovalService"]

[capability.102.2.3]
title = "Enforce expiry, idempotency and concurrency semantics"
reference_namespace = "feature.102"
reqs = ["1029.5", "1029.6"]
touches = ["agent/crates/layerx-agentd/src/approval/expiry.rs", "agent/crates/layerx-agentd/tests/approval_semantics.rs"]
tests = []
verification_contract = "make agent-test-approvals"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Expire unactioned holds at exactly the deterministic expiry the policy engine computed, bounded by the held activity's submission validity window, releasing reservations on expiry, with an approval attempt after expiry returning the typed expired result."
do_2 = "Make approve and reject idempotent under their idempotency keys, with a repeated decision returning the original outcome."
do_3 = "Resolve concurrent conflicting decisions to exactly one winner, with the losing request receiving the typed conflict result naming the winning outcome."
do_4 = "Prove the semantics under crash-restart: a decision recorded before a crash survives it, and a hold expired during downtime is expired on recovery."
do_5 = "Cover all of it with concurrency and restart tests running against the real store."
symbols = ["layerx_agentd::approval::ApprovalExpiry"]

[capability.102.2.4]
title = "Emit approval lifecycle events and audit evidence"
reference_namespace = "feature.102"
reqs = ["1029.7", "1029.9"]
touches = ["agent/crates/layerx-agentd/src/approval/events.rs", "agent/crates/layerx-agentd/tests/approval_events.rs"]
tests = []
verification_contract = "make agent-test-approvals"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Emit created, approved, rejected and expired events on the existing ordered event stream with the approval's digest, so clients track holds without polling."
do_2 = "Record every lifecycle transition in the audit trail with the digest, the deciding principal where one exists, and the outcome."
do_3 = "Label the approval surface daemon-enforced in the restriction report and in every response that describes it."
do_4 = "Extend the streaming conformance tests to cover approval events, including resumption across a cursor gap."
do_5 = "Extend the audit export tests so approval decisions appear with their referenced evidence."
symbols = ["layerx_agentd::approval::ApprovalEvents"]

[capability.102.2.5]
title = "Regenerate the SDKs with the approval module"
reference_namespace = "feature.102"
reqs = ["1029.8", "1029.1"]
touches = ["agent/crates/layerx-sdk/src/approval.rs", "agent/sdk/typescript", "agent/sdk/python", "agent/COMPATIBILITY.md"]
tests = []
verification_contract = "make agent-test"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Regenerate the TypeScript and Python SDKs and extend the authored Rust SDK surface with the approval module from the same schema in the same build."
do_2 = "Extend the cross-SDK parity suite to cover every approval operation, event and error outcome."
do_3 = "Record the introducing minor version in the compatibility matrix and the guarantee documentation."
do_4 = "Prove the drift gate fails when generated output is stale by regenerating from a modified schema in a fixture."
do_5 = "Run the full agent qualification-relevant suites to prove the addition changed no existing behaviour."
symbols = ["layerx_sdk::approval"]

[capability_group.102.3]
title = "Build layerx-intents, the typed intent compiler"
children = ["102.3.1", "102.3.2", "102.3.3", "102.3.4", "102.3.5"]

[capability.102.3.1]
title = "Define the intent vocabulary and its versioning"
reference_namespace = "feature.102"
reqs = ["1030.1", "1030.6"]
touches = ["human/crates/layerx-intents/src/lib.rs", "human/crates/layerx-intents/src/vocabulary.rs"]
tests = []
