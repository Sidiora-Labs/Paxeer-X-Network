verification_contract = "make layerxd platform-test-node && docker build --file platform/hosted/node/Dockerfile --tag layerx-node:verify ."
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Add platform/hosted/node/Dockerfile building build/bin/layerxd, layerx-genesis and layerxctl with the root Makefile on a pinned Debian bookworm builder and runtime (libcrypto, libsqlite3), uid 4020, and add platform/hosted/node/bootstrap.sh that, given a data directory, a network id, a sequencer key pair and a treasury key pair, generates the ordinary genesis manifest and snapshot with layerx-genesis (zero treasury balance, single asset at genesis), with funding through the admin treasury SEND path after bootstrap, writes the eight-line layerxd config for the sequencer and for the replica, and starts the sequencer under a supervisor that answers a reset request on a pod-local unix socket by stopping the daemons, discarding the data directory contents, re-running bootstrap and restarting."
do_2 = "Write platform/hosted/node/deployment.yaml: the layerx-node StatefulSet in layerx-testnet with pod label layerx-plane: trusted-boundary, a data PersistentVolumeClaim, a shared emptyDir for the LNI socket and the supervisor socket, containers layerxd (sequencer, LNI on the shared socket, program listener 127.0.0.1:9401, authority publish to 127.0.0.1:9402) and layerxd-authority (--authority-replica on 127.0.0.1:9402), the four boundary containers of tasks 6.2 to 6.4 with container ports 9443, 9444, 9445, 9446, and the Services layerx-pending-core (9443 -> 9443), layerx-pending-core-admin (9444 -> 9444), layerx-receipt-authority (9443 -> 9445) and layerx-agent-boundary (9443 -> 9446), with ingress NetworkPolicies admitting testnet-control, the gateway, the registry and the faucet on exactly those ports and egress limited to DNS plus the pinned Paxeer TLS endpoint used by the finality verifier."
do_3 = "Build cmd/layerxctl as an operator executable using the canonical LNI client for authenticated state reads and one-shot signed activity admission, preserving explicit unknown outcomes and never interpreting an acknowledgement as execution. Include it in the image. Add a real-process test under platform/hosted/node/tests that runs bootstrap.sh against a temporary directory, starts layerxd and the replica from build/bin, proves the LNI handshake succeeds with layerx-client, proves the treasury balance is readable, exercises the supervisor reset, and stops everything; wire it as make platform-test-node."
symbols = ["layerx-node image", "bootstrap.sh", "node supervisor reset"]

[capability.103.6.2]
title = "Implement the layerx-pending-core boundary and its admin plane"
reference_namespace = "feature.103"
reqs = ["1060.2", "1060.3", "1053.3", "1053.4"]
touches = ["platform/hosted/core", "platform/Cargo.toml", "platform/Cargo.lock", "platform/hosted/node/bootstrap.sh"]
tests = []
verification_contract = "make layerxd && cargo test --manifest-path platform/Cargo.toml -p layerx-platform-core && cargo clippy --manifest-path platform/Cargo.toml -p layerx-platform-core --all-targets -- -D warnings"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Add the crate platform/hosted/core (package layerx-platform-core, binary layerx-core-boundary) in the hosted house style - std TcpListener, rustls server TLS from DER cert and PKCS#8 DER key, hand-framed HTTP/1.1, no tokio - opening two listeners: LAYERX_CORE_LISTEN (default 0.0.0.0:9443) and LAYERX_CORE_ADMIN_LISTEN (default 0.0.0.0:9444), each with its own certificate, the core listener accepting an optional client certificate chaining to LAYERX_CORE_CLIENT_CA_DER."
do_2 = "Back the core listener with layerx-client over the LNI socket named by LAYERX_CORE_LNI_SOCKET and with the daemon's loopback program listener named by LAYERX_CORE_NODE_URL and LAYERX_CORE_NODE_BEARER_TOKEN_FILE: serve GET /readyz (unauthenticated, 200 with {ready, network_id, wire_version, synchronous_receipts, state_snapshot} only when the handshake, the replica and the durable log are live), GET /livez, GET /v1/sequencer, POST /v1/activities (application/octet-stream canonical bytes or {activity: hex}, submit over the LNI once per idempotency key, answer {state, activity_id, batch_id, global_sequence, result_code, state_root, receipt} from the returned receipt, 202 on unknown outcome), GET /v1/receipts/{activity_id}, GET /v1/state, GET /v1/accounts, POST /v1/programs/call, POST /v1/programs/simulate, GET /v1/programs/activities/{id}, GET /v1/programs/receipts/by-idempotency/{key}, GET /v1/programs/registry and /v1/programs/registry/{id}[/interface], and relay the five daemon account-state GET routes unchanged; when the LNI advertises no capability for a route answer 503 {error: {code: capability_unavailable}} and never execute a transition in-process."
do_3 = "Back the admin listener with LAYERX_CORE_ADMIN_TOKEN_FILE, LAYERX_CORE_TREASURY_KEY_FILE and the supervisor socket LAYERX_CORE_SUPERVISOR_SOCKET: POST /admin/v1/testnet/fund validates {funding_id, did, public_key, amount}, resolves the account, builds and signs a SEND from the treasury with layerx-intents and layerx-crypto, submits it over the LNI, answers 200 {funding_id, state: funded, transaction_id} from the receipt and 4xx with a typed code for admin refusals caused by the request; durable-storage faults (journal write or lock failure) answer 503 with no state change; POST /admin/v1/testnet/reset with body {} sends reset to the supervisor and answers 200 {state: reset, reset_id}; both require Idempotency-Key and return the first outcome for a repeated key from a durable idempotency journal under LAYERX_CORE_STATE_DIR."
do_4 = "Write tests under platform/hosted/core/tests that start a real layerxd and replica from build/bin through platform/hosted/node/bootstrap.sh, drive every route over TLS with the beta CA shape, prove funding produces a receipt-verified balance, prove the repeated Idempotency-Key does not move value twice, prove /readyz is 503 while the daemon is down, and add platform/hosted/core/Dockerfile from the faucet template."
symbols = ["layerx-core-boundary", "core admin fund", "core admin reset"]

[capability.103.6.3]
title = "Implement the layerx-receipt-authority service over the independent replica"
reference_namespace = "feature.103"
reqs = ["1060.4", "1053.3"]
touches = ["platform/hosted/authority", "platform/Cargo.toml", "platform/Cargo.lock", "platform/ramps/toolkit/src/clients.rs", "spec/paxeer-x/qualification.kvx"]
tests = []
verification_contract = "make layerxd && cargo test --manifest-path platform/Cargo.toml -p layerx-platform-authority && cargo clippy --manifest-path platform/Cargo.toml -p layerx-platform-authority --all-targets -- -D warnings"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Add the crate platform/hosted/authority (package layerx-platform-authority, binary layerx-receipt-authority) in the hosted house style listening on LAYERX_AUTHORITY_LISTEN (default 0.0.0.0:9445) with rustls server TLS accepting an optional client certificate, authenticating the gateway, registry and webhooks bearer tokens from LAYERX_AUTHORITY_TOKEN_FILES, and dialing only the replica at LAYERX_AUTHORITY_REPLICA_URL (loopback) with LAYERX_AUTHORITY_REPLICA_BEARER_TOKEN_FILE and LAYERX_AUTHORITY_REPLICA_ID, plus the receipt source at LAYERX_AUTHORITY_RECEIPT_URL for receipt bytes by activity id."
do_2 = "Serve GET /v1/authorized-batches/by-activity/{activity_id} and GET /internal/v1/activities/{activity_id}/authority: fetch the canonical receipt for the activity, compute its digest, fetch the replica's batch evidence, verify the header signature and the Merkle inclusion with layerx-proof, re-derive batch_id with layerx_wire::hash::execution_batch_id and require it to equal the receipt's, and answer the eight fields {activity_id, batch_id, asset, previous_state_root, resulting_state_root, sequencer_public_key, network_id, wire_version}, plus batch_evidence only when the batch carries an occupancy-maintenance receipt, containing the maintained batch identity and proof the consumer verifies with Content-Type application/json and no charset; relay GET /v1/batches/{batch_id}/receipt-authority?receipt_digest= to the replica unchanged; serve GET /readyz with {ready, network_id, wire_version} and 200 for an unauthenticated probe only when the replica answers; 404 for an unknown activity, 503 with a typed code when the replica or receipt source is unavailable."
do_3 = "Write tests under platform/hosted/authority/tests against a real layerxd sequencer and replica from build/bin, proving a submitted activity's facts are served and verify with layerx-proof, that a tampered header signature or mismatched batch_id is refused, and that /readyz reflects replica loss; add platform/hosted/authority/Dockerfile from the faucet template; record the ramps toolkit six-field AuthorityBody conflict in qualification.kvx and align it to the eight-field contract."
symbols = ["layerx-receipt-authority", "authorized_batch_by_activity"]

[capability.103.6.4]
title = "Implement the layerx-agent-boundary component service over the LNI"
reference_namespace = "feature.103"
reqs = ["1060.5", "1053.3"]
touches = ["platform/hosted/agent-boundary", "platform/hosted/core", "platform/hosted/gateway", "agent/crates/layerx-client", "agent/schema/lni", "agent/tests/boundary/node/layerxd_lni.c", "programs/crates/layerx-programs-runtime", "include/layerx", "src/protocol", "src/modules/programs", "src/storage", "cmd/layerxd", "tests/protocol", "tests/storage", "tests/programs", "tests/daemon", "Makefile", "platform/Cargo.toml", "platform/Cargo.lock"]
tests = []
verification_contract = "make layerxd test-program-artifacts test-batch-wal-recovery && cargo test --manifest-path platform/Cargo.toml -p layerx-platform-agent-boundary && cargo clippy --manifest-path platform/Cargo.toml -p layerx-platform-agent-boundary --all-targets -- -D warnings"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Add the crate platform/hosted/agent-boundary (package layerx-platform-agent-boundary, binary layerx-agent-boundary) in the hosted house style listening on LAYERX_AGENT_BOUNDARY_LISTEN (default 0.0.0.0:9446) with rustls server TLS that accepts an optional client certificate chaining to LAYERX_AGENT_BOUNDARY_CLIENT_CA_DER, two distinct bearer tokens from LAYERX_AGENT_BOUNDARY_GATEWAY_TOKEN_FILE and LAYERX_AGENT_BOUNDARY_REGISTRY_TOKEN_FILE with per-token route entitlement, an LNI client over LAYERX_AGENT_BOUNDARY_LNI_SOCKET and the daemon program listener at LAYERX_AGENT_BOUNDARY_NODE_URL."
do_2 = "Serve the component contract exactly as the gateway parses it: GET /readyz (bearer or unauthenticated, {ready, network_id, wire_version, synchronous_receipts, state_snapshot}), POST /v1/activities and POST /v1/programs/call taking application/octet-stream canonical bytes with Idempotency-Key, submitting over the LNI exactly once per key from a durable journal under LAYERX_AGENT_BOUNDARY_STATE_DIR, answering 200 {result: {state, activity_id, receipt, terminal_payload, call_graph}} from the receipt, 202 when the outcome is unknown, 4xx carrying the typed refusal; POST /v1/programs/simulate answering {result: {execution, simulation_evidence}} when the LNI provides simulation and a typed 503 capability_unavailable otherwise; GET /v1/programs/activities/{id} with program_id; GET /v1/receipts/{id} as {result: {activity_id, receipt}} and 404 when unknown; GET /internal/v1/receipts/{id} for the developer plane; and the five account-state GET routes relayed to the daemon for the registry token."
do_3 = "Persist real ProgramCall graph and terminal artifacts with explicit ownership through direct/prepared execution and explicitly versioned publication WAL/receipt-authority records, preserving old record decoding. Retrieve them through an authenticated additive program-listener route bound to activity ID and receipt digest, verify the existing signed receipt/artifact commitments at the boundary, and persist verified completed results for replay. Successful executions with missing/corrupt artifacts must remain unavailable; preserve truthful pre-runtime refusal data. Write tests under platform/hosted/agent-boundary/tests against a real layerxd and replica from build/bin covering every route, the exactly-once journal across a restart, refusal mapping, the entitlement split between the two tokens, and readiness under daemon loss; add platform/hosted/agent-boundary/Dockerfile from the faucet template."
do_4 = "Owner-requested single BUILD wave: provide version-identified snapshot program reads with explicit freshness requirements outside the write queue; retain direct native transfers and conflict-aware parallel Programs execution including protocol accounts, sequences and budgets; minimize the durable commit-to-result path; deliver event-driven completion and bounded authenticated persistent connections; move reconstructible snapshot/publication work off live execution locks without changing recovery, required replica acknowledgements, receipt verification or unknown-outcome semantics. Implement the complete wave before one compile pass and one focused real-process behavior gate, with at most two repair cycles. This bounded BUILD checkpoint does not assert the task's full qualification chain passed."
symbols = ["layerx-agent-boundary", "component submit journal"]

[capability.103.6.5]
title = "Implement the layerx-identity principal and session service"
