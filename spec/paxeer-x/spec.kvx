do_2 = "Implement lxp_idempotency_lookup short-circuiting a repeat submission to the stored receipt with the idempotent replay code and zero new effects."
do_3 = "Implement lxp_idempotency_record writing the key at the same point the account sequence is consumed, on both the success and the failure path."
do_4 = "Return byte-identical receipt content to both submissions even when the later one differs in payload, amount, recipient or fee limit."
