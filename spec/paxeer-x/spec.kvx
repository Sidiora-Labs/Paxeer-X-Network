tests = []
verification_contract = "make agent-test-agentd-identity"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement agent registration that resolves the DID against current protocol state through the boundary and refuses registration for an unknown or frozen identity."
do_2 = "Record the identity binding with the head sequence it was verified at, and re-verify it before first use after a restart rather than trusting the stored copy."
do_3 = "Reject a registration that supplies identity facts as configuration instead of verifying them, and prove the absence of such a path in test."
do_4 = "Expose the identity record with its verification level and the protocol authority set it currently holds."
do_5 = "Add tests covering an unknown DID, a frozen identity, an identity that becomes frozen after registration and a core that is unavailable at registration time."
symbols = ["layerx_agentd::identity::register", "layerx_agentd::identity::revalidate"]

[capability.101.9.3]
title = "Implement the session lifecycle and token binding"
reference_namespace = "feature.101"
reqs = ["1008.2", "1008.6", "1008.7", "1008.8"]
touches = ["agent/crates/layerx-agentd/src/session.rs", "agent/crates/layerx-agentd/tests/session.rs"]
tests = []
verification_contract = "make agent-test-agentd-session"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement session open recording agent DID, tenant, presented authority, permitted activity types, expiry, opening client and policy version, refusing an open that omits any of them."
do_2 = "Issue session tokens bound to tenant, agent, scope and expiry, and treat a token strictly as a daemon authenticator that is never protocol authority."
do_3 = "Verify at open time that the presented protocol authority exists, is currently valid and is unrevoked, and refuse otherwise."
do_4 = "Support many concurrent sessions per agent and many agents per tenant with independent state, and prove closing one leaves others untouched."
do_5 = "Add tests covering an expired token, a token from another tenant, a token whose scope omits the operation and a session whose authority was never registered in protocol state."
symbols = ["layerx_agentd::session::open", "layerx_agentd::session::Token", "layerx_agentd::session::close"]

[capability.101.9.4]
title = "Re-evaluate protocol authority before every write"
reference_namespace = "feature.101"
reqs = ["1008.3", "1008.4", "1001.1"]
touches = ["agent/crates/layerx-agentd/src/authority.rs", "agent/crates/layerx-agentd/tests/authority.rs"]
tests = []
verification_contract = "make agent-test-agentd-authority"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Re-resolve the underlying protocol authority against core state before every preparation and refuse when it has expired, rotated, been revoked or fallen out of scope."
do_2 = "Cache the authority resolution only within an explicit freshness bound and revalidate past it rather than trusting the session record."
do_3 = "Name the failing authority condition in the refusal so a caller can distinguish expiry from revocation from scope."
do_4 = "Report in every response which protocol authority was actually used for the activity."
do_5 = "Add tests covering revocation between session open and preparation, and rotation between preparation and submission."
symbols = ["layerx_agentd::authority::resolve", "layerx_agentd::authority::require_valid"]

[capability.101.9.5]
title = "Propagate rotation and revocation into sessions"
reference_namespace = "feature.101"
reqs = ["1008.5", "1008.9", "1009.5"]
touches = ["agent/crates/layerx-agentd/src/session_revocation.rs", "agent/crates/layerx-agentd/tests/revocation.rs"]
tests = []
verification_contract = "make agent-test-agentd-revocation"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Observe identity, key rotation, session key and capability grant revocation events from the event stream and apply them to session state immediately."
do_2 = "Invalidate every session whose authority no longer verifies, report the invalidation reason to affected clients, and cancel prepared but unsubmitted activities bound to it."
do_3 = "Leave activities the protocol already executed untouched and prove that no local invalidation is presented as reversing a protocol effect."
do_4 = "Persist invalidations so a restart does not resurrect a session whose authority is gone."
do_5 = "Add tests covering revocation arriving while a preparation is in flight and while a submission is in the unknown state."
symbols = ["layerx_agentd::session::invalidate_on_revocation"]

[capability_group.101.10]
title = "Implement capabilities and their attenuation"
children = ["101.10.1", "101.10.2", "101.10.3", "101.10.4", "101.10.5"]

[capability.101.10.1]
title = "Implement the capability model and its dimensions"
reference_namespace = "feature.101"
reqs = ["1009.1", "1009.2", "1009.6"]
touches = ["agent/crates/layerx-agentd/src/capability/mod.rs", "agent/crates/layerx-agentd/tests/capability.rs"]
tests = []
verification_contract = "make agent-test-agentd-capability"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement the capability record with permitted activity types, permitted counterparties, permitted assets, amount ceilings, rate ceilings, purpose constraints and expiry, rejecting a capability that leaves any dimension unspecified."
do_2 = "Implement evaluation that checks a prepared activity against every dimension and refuses on the first exceeded dimension, naming it."
do_3 = "Make evaluation deterministic from the recorded capability and the prepared activity alone, with no ambient input, and prove identical decisions for identical inputs."
do_4 = "Persist capabilities with their tenant scope and expiry and restore them on restart."
do_5 = "Add tests covering each dimension at, inside and outside its bound."
symbols = ["layerx_agentd::capability::Capability", "layerx_agentd::capability::evaluate"]

[capability.101.10.2]
title = "Enforce narrowing against the underlying protocol authority"
reference_namespace = "feature.101"
reqs = ["1009.3", "1009.8", "1011.9"]
touches = ["agent/crates/layerx-agentd/src/capability/narrowing.rs", "agent/crates/layerx-agentd/tests/narrowing.rs"]
tests = []
verification_contract = "make agent-test-agentd-narrowing"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Resolve the underlying protocol authority at capability creation and reject any capability that would permit an activity type, asset, counterparty or amount that authority does not already permit."
do_2 = "Forbid presenting a capability to the core as authorisation, and prove in test that no submission path carries a capability identifier as protocol authority."
do_3 = "Record for every dimension whether it is protocol-enforced or daemon-enforced only."
do_4 = "Re-check narrowing when the underlying authority changes and disable a capability that would now be wider than its parent."
do_5 = "Add tests covering a capability created wider than its authority, and an authority narrowed after the capability was created."
symbols = ["layerx_agentd::capability::assert_narrowing", "layerx_agentd::capability::Enforcement"]

[capability.101.10.3]
title = "Implement attenuation, derivation chains and revocation subtrees"
reference_namespace = "feature.101"
reqs = ["1009.4", "1009.5"]
touches = ["agent/crates/layerx-agentd/src/capability/attenuate.rs", "agent/crates/layerx-agentd/tests/attenuation.rs"]
tests = []
verification_contract = "make agent-test-agentd-attenuation"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement attenuation as the intersection of every dimension and forbid a derived capability from exceeding its parent in any dimension."
do_2 = "Record the derivation chain so any exercised capability is traceable to its root authority."
do_3 = "Implement revocation of a capability, its parent or the underlying authority as refusal of the entire subtree, applied to prepared but unsubmitted activities."
do_4 = "Persist chains and revocations and restore them consistently after restart."
do_5 = "Add tests covering deep chains, a revoked middle node and an attempt to widen at derivation."
symbols = ["layerx_agentd::capability::attenuate", "layerx_agentd::capability::revoke_subtree"]

[capability.101.10.4]
title = "Account capability ceilings from verified receipts"
reference_namespace = "feature.101"
reqs = ["1009.7", "1010.5", "1010.6"]
touches = ["agent/crates/layerx-agentd/src/capability/consume.rs", "agent/crates/layerx-agentd/tests/ceiling.rs"]
tests = []
verification_contract = "make agent-test-agentd-ceiling"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Account consumption against a spending ceiling from verified receipts only, counting a failed activity as unconsumed."
do_2 = "Serialise the reservation decision so concurrent uses of one capability cannot exceed the ceiling in aggregate."
do_3 = "Hold a reservation while an outcome is unknown and release it only on a terminal state or a declared reservation expiry."
do_4 = "Rebuild consumption from persisted receipts on restart before permitting a write under that capability."
do_5 = "Add a concurrency test that drives many simultaneous uses of one ceiling and asserts the aggregate never exceeds it."
symbols = ["layerx_agentd::capability::consume", "layerx_agentd::capability::Reservation"]

[capability.101.10.5]
title = "Report protocol-enforced versus daemon-enforced restrictions"
reference_namespace = "feature.101"
reqs = ["1009.9", "1009.10", "1010.2", "1018.10"]
touches = ["agent/crates/layerx-agentd/src/capability/report.rs", "agent/crates/layerx-agentd/tests/enforcement_report.rs"]
tests = []
verification_contract = "make agent-test-agentd-enforcement-report"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement the capability report listing every restriction, its enforcement location and, for daemon-enforced restrictions, the plain statement that bypassing the daemon bypasses them."
do_2 = "Prefer expressing a restriction as a protocol capability grant, session key scope, budget or payer grant wherever the protocol offers an equivalent, and record the protocol object identifier when it does."
do_3 = "Expose the report through the contract, the command line and the audit trail with the same content."
do_4 = "Forbid any wording in the report or documentation that describes a daemon-enforced restriction as a protocol guarantee, and add a documentation check for it."
do_5 = "Add tests asserting the report is complete for every capability dimension."
symbols = ["layerx_agentd::capability::enforcement_report"]

[capability_group.101.11]
title = "Implement budgets and spend control"
children = ["101.11.1", "101.11.2", "101.11.3", "101.11.4", "101.11.5"]

[capability.101.11.1]
title = "Create protocol budgets and grants through signed activities"
reference_namespace = "feature.101"
reqs = ["1010.1", "1010.2", "1001.1"]
touches = ["agent/crates/layerx-agentd/src/budget/create.rs", "agent/crates/layerx-agentd/tests/budget_create.rs"]
tests = []
verification_contract = "make agent-test-agentd-budget-create"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement budget creation that offers to express the limit as a protocol budget or capability grant and creates it through an ordinary prepared, signed and submitted activity."
do_2 = "Return the resulting protocol object identifier and its receipt so the limit existence is evidence rather than a daemon record."
do_3 = "Label a limit that exists only in the daemon explicitly as daemon-enforced with its bypass statement."
do_4 = "Refuse to describe a daemon-enforced limit as equivalent to a protocol budget anywhere in the response."
do_5 = "Add tests covering creation, the failure of creation, and the state of the daemon record when creation fails."
symbols = ["layerx_agentd::budget::create_protocol_budget", "layerx_agentd::budget::LocalLimit"]

[capability.101.11.2]
title = "Reconcile local accounting against protocol budget state"
reference_namespace = "feature.101"
reqs = ["1010.3", "1010.7", "1010.9"]
touches = ["agent/crates/layerx-agentd/src/budget/reconcile.rs", "agent/crates/layerx-agentd/tests/budget_reconcile.rs"]
tests = []
verification_contract = "make agent-test-agentd-budget-reconcile"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Derive consumption from verified receipts and protocol budget state and treat the local figure strictly as a cache."
do_2 = "Take window boundaries and remaining allowance from protocol state rather than from a local timer, so the window view matches the deterministic protocol view."
do_3 = "Correct the local figure to the protocol figure whenever they differ and record the correction."
do_4 = "Expose reconciliation state including the last verified receipt applied, the protocol figure, the local figure and any divergence."
do_5 = "Add tests covering a rollover observed only through protocol state and a divergence introduced by a missed receipt."
symbols = ["layerx_agentd::budget::reconcile", "layerx_agentd::budget::ReconciliationState"]

[capability.101.11.3]
title = "Implement serialised reservations and deterministic release"
reference_namespace = "feature.101"
reqs = ["1010.4", "1010.5", "1010.8"]
touches = ["agent/crates/layerx-agentd/src/budget/reserve.rs", "agent/crates/layerx-agentd/tests/budget_reserve.rs"]
tests = []
verification_contract = "make agent-test-agentd-budget-reserve"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement reservation as a serialised decision per limit so concurrent or reordered requests cannot exceed the ceiling in aggregate."
do_2 = "Release a reservation deterministically on a terminal outcome or at a declared reservation expiry, and leave no reservation behind for a refused request."
do_3 = "Apply every applicable limit across tenant, agent, session, capability and counterparty simultaneously and refuse if any one is exceeded."
do_4 = "Name the limit, the ceiling, the consumed amount and the requested amount in every refusal."
do_5 = "Add a concurrency test asserting aggregate compliance and a test asserting no reservation leak across thousands of refused requests."
symbols = ["layerx_agentd::budget::reserve", "layerx_agentd::budget::release"]

[capability.101.11.4]
title = "Hold reservations across unknown outcomes and restarts"
reference_namespace = "feature.101"
reqs = ["1010.6", "1010.10", "1013.4"]
touches = ["agent/crates/layerx-agentd/src/budget/hold.rs", "agent/crates/layerx-agentd/tests/budget_unknown.rs"]
tests = []
verification_contract = "make agent-test-agentd-budget-unknown"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Keep a reservation held while the outcome of its activity is unknown and refuse to release it optimistically."
do_2 = "Persist reservations so a restart restores them before any write is accepted against that limit."
do_3 = "Rebuild spend accounting from persisted receipts and protocol state on restart and refuse writes against an unreconciled limit."
do_4 = "Expose held-but-unresolved amounts distinctly from consumed amounts so an operator can see why capacity is unavailable."
do_5 = "Add a fault-injection test that kills the daemon between submission and receipt and asserts the reservation survives and resolves correctly."
symbols = ["layerx_agentd::budget::hold_unknown", "layerx_agentd::budget::rebuild"]

[capability.101.11.5]
title = "Report divergence rather than adopting the local figure"
reference_namespace = "feature.101"
reqs = ["1010.9", "1020.8", "1001.3"]
touches = ["agent/crates/layerx-agentd/src/budget/divergence.rs", "agent/crates/layerx-agentd/tests/budget_divergence.rs"]
tests = []
verification_contract = "make agent-test-agentd-budget-divergence"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Raise an explicit alert when the local and protocol figures diverge and refuse to adopt the local figure silently."
do_2 = "Record the divergence in the audit trail with both figures, the last verified receipt and the head sequence."
do_3 = "Expose divergence through health so an operator sees it without reading logs."
do_4 = "Continue to enforce the more restrictive of the two figures while a divergence is open."
do_5 = "Add tests covering an injected divergence and its resolution once the missing receipt is verified."
symbols = ["layerx_agentd::budget::divergence_alert"]

[capability_group.101.12]
title = "Implement the policy engine"
children = ["101.12.1", "101.12.2", "101.12.3", "101.12.4", "101.12.5"]

[capability.101.12.1]
title = "Implement deterministic deny-by-default evaluation"
reference_namespace = "feature.101"
reqs = ["1011.1", "1011.2", "1011.6", "1011.7"]
touches = ["agent/crates/layerx-agentd/src/policy/eval.rs", "agent/crates/layerx-agentd/tests/policy.rs"]
tests = []
verification_contract = "make agent-test-agentd-policy"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement evaluation over the request, the session, the capability, the reconciled budget state and the loaded policy version alone, denying by default when no rule permits."
do_2 = "Forbid consulting wall-clock convenience, random values, load or non-deterministic ordering, and prove determinism with a repeated-evaluation test over a recorded corpus."
do_3 = "Support constraints over activity type, counterparty, asset, amount, cumulative rate, purpose, capability, session, agent, tenant, time window and required approval, with exact-integer thresholds only."
do_4 = "Deny on evaluation failure, timeout or internal error, and prove there is no path that fails open."
do_5 = "Add tests covering an empty policy set, a conflicting rule pair and an evaluation that panics internally."
symbols = ["layerx_agentd::policy::evaluate", "layerx_agentd::policy::Decision"]

[capability.101.12.2]
title = "Implement policy versioning, validation and activation"
reference_namespace = "feature.101"
reqs = ["1011.5", "1011.3", "1023.7"]
touches = ["agent/crates/layerx-agentd/src/policy/version.rs", "agent/crates/layerx-agentd/tests/policy_version.rs", "agent/fuzz/fuzz_targets/policy_loader.rs"]
tests = []
verification_contract = "make agent-test-agentd-policy-version"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Version every policy set, validate it before activation, and reject an invalid set while continuing under the previous version."
do_2 = "Apply a new version only to requests received after activation and retain prior versions for audit reconstruction."
do_3 = "Record the active policy version in every decision, session and audit entry."
do_4 = "Fuzz the policy loader so a malformed policy source cannot panic or hang the daemon."
do_5 = "Add tests covering activation during in-flight requests and a rejected invalid set."
symbols = ["layerx_agentd::policy::activate", "layerx_agentd::policy::validate"]

[capability.101.12.3]
title = "Implement dry-run and decision explanation"
reference_namespace = "feature.101"
reqs = ["1011.4", "1011.3", "1011.9"]
touches = ["agent/crates/layerx-agentd/src/policy/dry_run.rs", "agent/crates/layerx-agentd/tests/policy_dryrun.rs"]
tests = []
verification_contract = "make agent-test-agentd-policy-dryrun"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement dry-run evaluation returning the decision and its explanation without preparing, signing or submitting anything."
do_2 = "Return the matched rules, the deciding rule and the reason, and guarantee dry-run has no side effect beyond its audit entry."
do_3 = "State in every allow decision that policy is a local restriction and never protocol authorisation."
do_4 = "Make the explanation stable and machine-readable so it can be asserted in tests and diffed across policy versions."
do_5 = "Add tests asserting dry-run and live evaluation return identical decisions for identical inputs."
symbols = ["layerx_agentd::policy::dry_run", "layerx_agentd::policy::Explanation"]

[capability.101.12.4]
title = "Implement approval holds and deterministic expiry"
reference_namespace = "feature.101"
reqs = ["1011.8", "1012.2", "1020.2"]
touches = ["agent/crates/layerx-agentd/src/policy/approval.rs", "agent/crates/layerx-agentd/tests/approval.rs"]
tests = []
verification_contract = "make agent-test-agentd-approval"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement the awaiting-approval state holding the request with its disclosure until an approver decides."
do_2 = "Expire an unapproved request deterministically at its declared window and never auto-approve on expiry."
do_3 = "Present the disclosure to the approver rather than the caller request, so approval covers what would actually be signed."
do_4 = "Record the approver identity, the decision and the disclosure digest in the audit trail."
do_5 = "Add tests covering approval after expiry, approval of an altered request and concurrent approvals."
symbols = ["layerx_agentd::policy::approval::hold", "layerx_agentd::policy::approval::expire"]

[capability.101.12.5]
title = "Ship the policy test harness and the adversarial corpus"
reference_namespace = "feature.101"
reqs = ["1011.10", "1023.6", "1011.1"]
touches = ["agent/tools/policy-harness/src/main.rs", "agent/tests/policy/adversarial.rs", "Makefile"]
tests = []
verification_contract = "make agent-test-policy-adversarial"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Ship a harness that evaluates a policy set against recorded request corpora and reports every decision, so a change can be verified before activation."
do_2 = "Assemble an adversarial corpus attempting to widen scope through crafted purposes, counterparties, unicode confusables, oversized fields and boundary amounts."
do_3 = "Assert deny-by-default holds across the corpus and that no crafted input produces an allow the policy did not intend."
do_4 = "Report corpus coverage across the constraint vocabulary and fail if a constraint is unexercised."
do_5 = "Wire the harness into make agent-test-policy-adversarial as a build gate."
symbols = ["agent_policy_harness", "agent_policy_adversarial_corpus"]

[capability_group.101.13]
title = "Implement activity preparation and signing"
children = ["101.13.1", "101.13.2", "101.13.3", "101.13.4", "101.13.5"]

[capability.101.13.1]
title = "Prepare complete unsigned canonical activities from core state"
reference_namespace = "feature.101"
reqs = ["1012.1", "1012.3", "1012.8", "1001.1"]
touches = ["agent/crates/layerx-agentd/src/prepare/mod.rs", "agent/crates/layerx-agentd/tests/prepare.rs"]
tests = []
verification_contract = "make agent-test-agentd-prepare"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement preparation that constructs the complete unsigned canonical activity including actor, authority, account_sequence, timestamp_bound, idempotency_key, fee_limit, payload and payload_hash."
do_2 = "Take account_sequence and every other protocol-derived input from core state through the boundary and fail preparation when that state is unavailable rather than assuming a value."
do_3 = "Derive timestamp_bound and fee_limit from explicit caller input or explicit configured defaults and never widen a caller-supplied bound."
do_4 = "Return the exact canonical bytes and the signing preimage produced by layerx-wire, with no second encoding path anywhere in the daemon."
do_5 = "Add tests covering a stale sequence, an unavailable core, a widened bound attempt and a payload that exceeds a declared limit."
symbols = ["layerx_agentd::prepare::prepare_activity", "layerx_agentd::prepare::Prepared"]

[capability.101.13.2]
title = "Produce the structured disclosure and prove it matches the bytes"
reference_namespace = "feature.101"
reqs = ["1012.2", "1005.3", "1005.4"]
touches = ["agent/crates/layerx-agentd/src/prepare/disclose.rs", "agent/crates/layerx-agentd/tests/disclosure.rs"]
tests = []
verification_contract = "make agent-test-agentd-disclosure"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Produce the disclosure by decoding the prepared bytes rather than by copying the caller request, so the disclosure describes what would actually execute."
do_2 = "Include activity type, actor, authority, every counterparty, every amount, the asset, the fee limit, the expiry and the idempotency key."
do_3 = "Re-encode the disclosure and refuse preparation if the result is not byte-identical to the prepared bytes."
do_4 = "Return the disclosure with every preparation response and record its digest in the audit trail."
do_5 = "Add an adversarial test that mutates the prepared bytes after disclosure generation and asserts the mismatch is detected."
symbols = ["layerx_agentd::prepare::disclose", "layerx_agentd::prepare::DisclosureDigest"]

[capability.101.13.3]
title = "Support external signing and session-key self-signing"
reference_namespace = "feature.101"
reqs = ["1012.6", "1012.7", "1005.7"]
touches = ["agent/crates/layerx-agentd/src/sign.rs", "agent/crates/layerx-agentd/tests/signing.rs"]
tests = []
verification_contract = "make agent-test-agentd-signing"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement external signing as the default posture, in which preparation output leaves the daemon, a signature returns, and the daemon never holds an agent primary key."
do_2 = "Implement optional self-signing under an explicitly provisioned protocol session key, confined to the activity types, expiry and scope that key declares."
do_3 = "Record every self-signed activity distinctly in the audit trail and in the response so a reader can tell who signed."
do_4 = "Refuse self-signing for any activity type outside the provisioned session key scope even when policy would allow it."
do_5 = "Add tests covering an unprovisioned daemon asked to sign, a scope-exceeding self-sign attempt and an expired session key."
symbols = ["layerx_agentd::sign::external", "layerx_agentd::sign::self_sign"]

[capability.101.13.4]
title = "Verify signature over exact bytes before submission"
reference_namespace = "feature.101"
reqs = ["1012.4", "1012.5", "1007.2"]
touches = ["agent/crates/layerx-agentd/src/sign_verify.rs", "agent/crates/layerx-agentd/tests/signature_binding.rs"]
tests = []
verification_contract = "make agent-test-agentd-signature-binding"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Verify before submission that the signature verifies over the exact bytes about to be transmitted and refuse otherwise."
do_2 = "Detect any post-signature alteration through that verification and refuse submission, so a modified activity can never ride an earlier signature."
do_3 = "Carry the verified bytes through to the client submit path unchanged, with no re-encoding step between verification and transmission."
do_4 = "Record the activity identifier of the exact submitted bytes in the audit trail."
do_5 = "Add an adversarial test that alters amount, recipient and fee limit after signing and asserts refusal in each case."
symbols = ["layerx_agentd::sign::verify_before_submit"]

[capability.101.13.5]
title = "Expire prepared activities and release their reservations"
reference_namespace = "feature.101"
reqs = ["1012.9", "1012.10", "1010.5"]
touches = ["agent/crates/layerx-agentd/src/prepare/expiry.rs", "agent/crates/layerx-agentd/tests/prepare_expiry.rs"]
tests = []
verification_contract = "make agent-test-agentd-prepare-expiry"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Expire a prepared activity that is not submitted within its declared window and release every reservation it held."
do_2 = "Refuse to submit a prepared activity whose timestamp_bound has already passed relative to the core-reported batch time."
do_3 = "Retain signed bytes only for the retention needed to complete submission and receipt resolution, then discard them."
do_4 = "Redact payload contents in logs according to the configured redaction policy while keeping the activity identifier."
do_5 = "Add tests covering expiry during signing, expiry after signing and a retention sweep that must not delete an unresolved submission."
symbols = ["layerx_agentd::prepare::expire", "layerx_agentd::prepare::retention_sweep"]

[capability_group.101.14]
title = "Implement submission, idempotency and receipt tracking"
children = ["101.14.1", "101.14.2", "101.14.3", "101.14.4", "101.14.5", "101.14.6"]

[capability.101.14.1]
title = "Implement the durable outbox and the submission state machine"
reference_namespace = "feature.101"
reqs = ["1013.1", "1013.2", "1001.6"]
touches = ["agent/crates/layerx-agentd/src/outbox/mod.rs", "agent/crates/layerx-agentd/tests/outbox.rs"]
tests = []
verification_contract = "make agent-test-agentd-outbox"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Record every submission in a durable outbox before transmission and retain it until a terminal state of executed, failed, expired or superseded."
do_2 = "Implement the state machine over prepared, signed, queued, submitted, acknowledged, unknown, executed, failed and expired, recording every transition with its cause."
do_3 = "Expose the current state and its evidence through the contract, with unknown reported as unknown rather than as an error."
do_4 = "Forbid any transition that reports success without a verified receipt reference and prove the absence of such a path in test."
do_5 = "Add tests driving every legal transition and asserting every illegal transition is rejected."
symbols = ["layerx_agentd::outbox::Outbox", "layerx_agentd::outbox::SubmissionState"]

[capability.101.14.2]
title = "Implement idempotency records and conflict detection"
reference_namespace = "feature.101"
reqs = ["1013.6", "1013.3", "1023.5"]
touches = ["agent/crates/layerx-agentd/src/idempotency.rs", "agent/crates/layerx-agentd/tests/idempotency.rs"]
tests = []
verification_contract = "make agent-test-agentd-idempotency"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement caller-supplied idempotency keys across every mutating contract operation, storing the request digest and the original result."
do_2 = "Return the original result for a repeated key and a typed conflict error for a repeated key whose request body differs."
do_3 = "Carry the protocol idempotency_key through preparation and submission so one caller intent maps to exactly one protocol idempotency key."
do_4 = "Persist idempotency records durably with an explicit retention and prove that retention expiry cannot cause a duplicate economic effect within the protocol retention window."
do_5 = "Add a concurrency test issuing the same key from many callers simultaneously and asserting exactly one economic result."
symbols = ["layerx_agentd::idempotency::Store", "layerx_agentd::idempotency::Conflict"]

[capability.101.14.3]
title = "Implement unknown-state resolution by receipt lookup"
reference_namespace = "feature.101"
reqs = ["1013.4", "1001.6", "1010.6"]
touches = ["agent/crates/layerx-agentd/src/outbox/unknown.rs", "agent/crates/layerx-agentd/tests/unknown.rs"]
tests = []
verification_contract = "make agent-test-agentd-unknown"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Resolve an unknown submission only by looking up the receipt for its idempotency key, never by inferring the outcome from transport behaviour."
do_2 = "Apply bounded jittered backoff to resolution and expose the age and the attempt count of every unresolved submission."
do_3 = "Resend byte-identical bytes under the original idempotency key when a resend is warranted and treat an existing receipt as the outcome."
do_4 = "Keep every reservation and every consumed ceiling held while the state remains unknown."
do_5 = "Add fault-injection tests covering acknowledgement loss, response loss, node restart mid-flight and a receipt that appears minutes later."
symbols = ["layerx_agentd::outbox::resolve_unknown", "layerx_agentd::outbox::UnknownAge"]

[capability.101.14.4]
title = "Verify, store and serve receipt bytes unchanged"
reference_namespace = "feature.101"
reqs = ["1013.5", "1013.10", "1001.7"]
touches = ["agent/crates/layerx-agentd/src/receipt.rs", "agent/crates/layerx-agentd/tests/receipts.rs"]
tests = []
verification_contract = "make agent-test-agentd-receipts"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Verify every retrieved receipt through layerx-proof before recording a terminal state and record the achieved verification level with it."
do_2 = "Store the exact receipt bytes and serve them unchanged by activity identifier, idempotency key and global sequence."
do_3 = "Record the exact protocol result code for a rejection, classify it as terminal or retriable from the protocol taxonomy, and never retry a terminal rejection."
do_4 = "Surface the result code unmodified to the caller with no local reinterpretation or substituted explanation."
do_5 = "Add tests asserting byte equality between stored and served receipts and asserting no retry occurs for each terminal code class."
symbols = ["layerx_agentd::receipt::store", "layerx_agentd::receipt::serve", "layerx_agentd::receipt::classify"]

[capability.101.14.5]
title = "Augment records with checkpoint proofs as finality advances"
reference_namespace = "feature.101"
reqs = ["1013.8", "1013.9", "1006.4"]
touches = ["agent/crates/layerx-agentd/src/finality.rs", "agent/crates/layerx-agentd/tests/finality.rs"]
tests = []
verification_contract = "make agent-test-agentd-finality"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Follow checkpoint progress and augment stored submission records with the activity inclusion proof, the state inclusion proof, the checkpoint identifier, the guarantor certificate and the settlement reference."
do_2 = "Verify each augmentation before recording it and never alter a pre-checkpoint receipt field."
do_3 = "Raise the recorded verification level only to the level the verified evidence supports."
do_4 = "Allow a caller to wait for a declared level with an explicit deadline and return the level actually reached when the deadline elapses."
do_5 = "Add tests covering a checkpoint that never finalises, a certificate that arrives sub-threshold and a settlement reference that does not match."
symbols = ["layerx_agentd::finality::augment", "layerx_agentd::finality::wait_for_level"]

[capability.101.14.6]
title = "Recover the outbox on restart without duplication or loss"
reference_namespace = "feature.101"
reqs = ["1013.7", "1022.8", "1023.4"]
touches = ["agent/crates/layerx-agentd/src/outbox/recover.rs", "agent/crates/layerx-agentd/src/shutdown.rs", "agent/crates/layerx-agentd/tests/recovery.rs"]
tests = []
verification_contract = "make agent-test-agentd-recovery"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Recover the outbox on start, resume resolution of every non-terminal submission, and refuse writes until recovery completes."
do_2 = "Neither resubmit an activity already executed nor drop an activity that was signed and queued but never transmitted."
do_3 = "Reconstruct reservations, ceilings and budget accounting from persisted receipts before accepting a write."
do_4 = "Implement graceful shutdown that stops accepting work, durably records in-flight submissions and flushes audit entries."
do_5 = "Add a kill-and-restart test at every stage of the write path asserting exactly-once economic effect across the restart."
symbols = ["layerx_agentd::outbox::recover", "layerx_agentd::shutdown::graceful"]

[capability_group.101.15]
title = "Implement verified reads, proofs and availability in the daemon"
children = ["101.15.1", "101.15.2", "101.15.3", "101.15.4", "101.15.5", "101.15.6"]

[capability.101.15.1]
title = "Serve balances at a requested verification level"
reference_namespace = "feature.101"
reqs = ["1014.1", "1014.2", "1014.6", "1001.3"]
touches = ["agent/crates/layerx-agentd/src/read/balance.rs", "agent/crates/layerx-agentd/tests/balance.rs"]
tests = []
verification_contract = "make agent-test-agentd-balance"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Serve balances derived from core-produced state with the account, asset, global sequence and the batch or checkpoint the value is relative to."
do_2 = "Fetch and verify the proof material the requested level demands and return the level actually achieved."
do_3 = "Refuse rather than downgrade when the requested level cannot be achieved and name the missing evidence."
do_4 = "Return the current head, latest sealed batch and latest finalised checkpoint with every freshness-sensitive read."
do_5 = "Add tests asserting a value is never returned above its evidence and that a hostile node cannot raise the level by assertion."
symbols = ["layerx_agentd::read::balance", "layerx_agentd::read::Freshness"]

[capability.101.15.2]
title = "Serve ordered history with stable cursors"
reference_namespace = "feature.101"
reqs = ["1014.3", "1014.4", "1019.7"]
touches = ["agent/crates/layerx-agentd/src/read/history.rs", "agent/crates/layerx-agentd/tests/history.rs"]
tests = []
verification_contract = "make agent-test-agentd-history"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Serve activities, receipts and events as core-produced canonical bytes in strict global sequence order."
do_2 = "Implement stable cursors such that a resumed page continues exactly where the previous ended with no gap and no repetition."
do_3 = "Preserve served bytes exactly so a caller re-hashing them reproduces the committed roots for the covered batches."
do_4 = "Bound page size and total response size explicitly and report truncation as a cursor rather than as completeness."
do_5 = "Add tests covering concurrent writes during pagination, a restart mid-pagination and a cursor from a pruned range."
symbols = ["layerx_agentd::read::history", "layerx_agentd::read::Cursor"]

[capability.101.15.3]
title = "Serve checkpoints, certificates and proof bundles"
reference_namespace = "feature.101"
reqs = ["1014.5", "1006.4", "1015.8"]
touches = ["agent/crates/layerx-agentd/src/read/checkpoint.rs", "agent/crates/layerx-agentd/tests/checkpoint.rs"]
tests = []
verification_contract = "make agent-test-agentd-checkpoint"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Serve checkpoint certificates with their header commitments, guarantor signature set, achieved count and threshold, and settlement reference where one exists."
do_2 = "Verify a certificate before returning it and refuse to return an unverified certificate as verified."
do_3 = "Serve proof bundles for activity inclusion and state inclusion against a named root, with the root provenance included."
do_4 = "Report the checkpoint as unavailable for verification purposes when its availability data cannot be obtained."
do_5 = "Add tests covering sub-threshold, duplicated-signer and mismatched-settlement certificates."
symbols = ["layerx_agentd::read::checkpoint", "layerx_agentd::read::proof_bundle"]

[capability.101.15.4]
title = "Serve availability retrieval and report failures as evidence"
reference_namespace = "feature.101"
reqs = ["1015.3", "1015.4", "1015.6", "1015.9"]
touches = ["agent/crates/layerx-agentd/src/read/availability.rs", "agent/crates/layerx-agentd/tests/availability.rs"]
tests = []
verification_contract = "make agent-test-agentd-availability"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Expose retrieval by checkpoint, batch, sequence range and activity identifier with streaming and explicit bounds."
do_2 = "Verify chunks and reassembled bytes before returning and report which of the five availability classes were obtained."
do_3 = "Classify a verification mismatch as an availability failure, retain the served bytes and the mismatching commitment, and record the failure with checkpoint, batch, chunk index and provider in the audit trail."
do_4 = "Emit retrieved history in a form an independent verifier can replay with no index or database, and document the ordering and framing."
do_5 = "Add tests covering withholding, corruption, partial classes and repeated failures from one provider."
symbols = ["layerx_agentd::read::availability", "layerx_agentd::read::AvailabilityFailure"]

[capability.101.15.5]
title = "Cache only with evidence and revalidate before serving stale"
reference_namespace = "feature.101"
reqs = ["1014.7", "1001.3", "1022.4"]
touches = ["agent/crates/layerx-agentd/src/cache.rs", "agent/crates/layerx-agentd/tests/cache.rs"]
tests = []
verification_contract = "make agent-test-agentd-cache"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Cache core-produced bytes together with their verification evidence and never cache a decoded value without it."
do_2 = "Revalidate against the core before serving a value past its declared freshness bound and never serve above the evidence held."
do_3 = "Invalidate cached values on head movement, reorganisation-free sequence advance and checkpoint finalisation in a way that cannot raise a level."
do_4 = "Bound cache size and report hit and staleness metrics per tenant."
do_5 = "Add tests asserting a cached value cannot be served at a higher level than when it was cached and that a stale value is revalidated."
symbols = ["layerx_agentd::cache::EvidenceCache", "layerx_agentd::cache::revalidate"]

[capability.101.15.6]
title = "Implement the offline verification export"
reference_namespace = "feature.101"
reqs = ["1014.10", "1014.9", "1001.10"]
touches = ["agent/crates/layerx-agentd/src/export.rs", "agent/crates/layerx-proof/src/export.rs", "agent/crates/layerx-agentd/tests/export.rs"]
tests = []
verification_contract = "make agent-test-agentd-export"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement an export that emits the receipts, proofs, certificates and headers needed for a third party to verify a stated fact set offline."
do_2 = "Include only core-produced bytes and their provenance, with no daemon-computed value presented as a fact."
do_3 = "Ship a verifier example that consumes the export with layerx-proof alone and confirms the facts without the daemon or a node."
do_4 = "Identify every contributing receipt for any derived aggregate included in the export so the aggregate is reconstructible."
do_5 = "Add a test that verifies an export on a machine with no network and no access to the daemon."
symbols = ["layerx_agentd::export::build", "layerx_proof::export::verify"]

[capability_group.101.16]
title = "Implement streaming and durable subscriptions"
children = ["101.16.1", "101.16.2", "101.16.3", "101.16.4", "101.16.5"]

[capability.101.16.1]
title = "Ingest core events and preserve global order"
reference_namespace = "feature.101"
reqs = ["1016.1", "1001.5", "1019.5"]
touches = ["agent/crates/layerx-agentd/src/events/ingest.rs", "agent/crates/layerx-agentd/tests/ingest.rs"]
tests = []
verification_contract = "make agent-test-agentd-ingest"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Ingest events from the boundary stream and persist them in strict global sequence order with no synthesis, enrichment or reordering."
do_2 = "Attach to each stored event the receipt reference and verification level of any receipt it depends on."
do_3 = "Bound the ingestion buffer explicitly and apply backpressure to ingestion rather than dropping events."
do_4 = "Record the ingestion watermark durably so a restart resumes without re-ingesting or skipping."
do_5 = "Add tests covering ingestion restart, a node that repeats an event and a node that emits out of order."
symbols = ["layerx_agentd::events::ingest", "layerx_agentd::events::Watermark"]

[capability.101.16.2]
title = "Implement the durable subscription store and cursors"
reference_namespace = "feature.101"
reqs = ["1016.2", "1016.6", "1021.5"]
touches = ["agent/crates/layerx-agentd/src/events/subscription.rs", "agent/crates/layerx-agentd/tests/subscription.rs"]
tests = []
verification_contract = "make agent-test-agentd-subscription"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Persist each subscription with its filter, start position, delivery target, owning tenant, agent and scope."
do_2 = "Restore and resume subscriptions after restart from the last acknowledged cursor."
do_3 = "Apply tenant and scope restrictions before any filter so a filter can never widen visibility."
do_4 = "Implement pause, resume, delete and cursor acknowledgement with durable effect."
do_5 = "Add tests covering restart mid-delivery, a filter naming another tenant object and an acknowledgement for a cursor that was never delivered."
symbols = ["layerx_agentd::events::subscription::Store", "layerx_agentd::events::subscription::Cursor"]

[capability.101.16.3]
title = "Implement delivery semantics, deduplication identity and backfill seams"
reference_namespace = "feature.101"
reqs = ["1016.3", "1016.5", "1016.7"]
touches = ["agent/crates/layerx-agentd/src/events/deliver.rs", "agent/crates/layerx-agentd/tests/delivery.rs"]
tests = []
verification_contract = "make agent-test-agentd-delivery"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Deliver at least once with a monotonic cursor and a deduplication identifier derived from event identity, and document the consumer obligation to deduplicate."
do_2 = "Backfill from durable history for a subscription started at a historical position and transition to live delivery with no gap and no duplicate at the seam."
do_3 = "Make the backfill-to-live transition point observable to the consumer."
do_4 = "Apply bounded buffering with explicit backpressure and never drop an event silently to keep up."
do_5 = "Add tests covering the seam under load, a consumer that stalls at the seam and a subscription started before genesis of its filter subject."
symbols = ["layerx_agentd::events::deliver", "layerx_agentd::events::backfill"]

[capability.101.16.4]
title = "Detect and surface gaps instead of closing them silently"
reference_namespace = "feature.101"
reqs = ["1016.4", "1016.9", "1001.5"]
touches = ["agent/crates/layerx-agentd/src/events/gap.rs", "agent/crates/layerx-agentd/tests/gaps.rs"]
tests = []
verification_contract = "make agent-test-agentd-gaps"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Detect a global sequence gap and emit an explicit gap event naming the missing range."
do_2 = "Attempt backfill from the core for the missing range and report the outcome of that attempt to the consumer."
do_3 = "Refuse to continue delivering past a gap as though the stream were contiguous, and mark the subscription state accordingly."
do_4 = "Mark a subscription truncated rather than silently repaired when undelivered events fall outside the declared retention bound."
do_5 = "Add tests covering a skipped sequence, an unrecoverable gap and retention truncation during an outage."
symbols = ["layerx_agentd::events::gap::detect", "layerx_agentd::events::gap::Truncated"]

[capability.101.16.5]
title = "Implement outbound delivery, authentication and lag reporting"
reference_namespace = "feature.101"
reqs = ["1016.8", "1016.9", "1016.10"]
touches = ["agent/crates/layerx-agentd/src/events/outbound.rs", "agent/crates/layerx-agentd/tests/webhook.rs"]
tests = []
verification_contract = "make agent-test-agentd-webhook"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement delivery to external endpoints with mutual authentication and a signed or otherwise bound payload so a receiver can confirm origin."
do_2 = "Include the underlying receipt or event bytes required for the receiver to verify independently."
do_3 = "Retry failures with bounded jittered backoff without exceeding at-least-once semantics, and stop delivery immediately on revocation or deletion."
do_4 = "Expose subscription health including cursor position, lag in sequences, last delivery, failure count and last error."
do_5 = "Add tests covering an unreachable endpoint, a slow endpoint, revocation mid-flight and delivery after deletion."
symbols = ["layerx_agentd::events::outbound::deliver", "layerx_agentd::events::health"]

[capability_group.101.17]
title = "Implement rate limits, quotas and backpressure"
children = ["101.17.1", "101.17.2", "101.17.3", "101.17.4", "101.17.5"]

[capability.101.17.1]
title = "Implement layered limits and typed refusals"
reference_namespace = "feature.101"
reqs = ["1019.1", "1019.2", "1019.3", "1019.10"]
touches = ["agent/crates/layerx-agentd/src/limits/rate.rs", "agent/crates/layerx-agentd/tests/ratelimit.rs"]
tests = []
verification_contract = "make agent-test-agentd-ratelimit"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement rate limits per tenant, per agent, per session, per capability and per operation class, applying every applicable limit."
do_2 = "Return a typed rate-limit error carrying the limit, the window, the remaining quota and a retry-after hint, and never queue indefinitely in place of refusing."
do_3 = "Enforce limits deterministically from recorded counters and the request, and document the consistency model plainly for multi-instance deployment."
do_4 = "Expose live configuration and utilisation per tenant so a refusal is diagnosable without reading logs."
do_5 = "Add tests covering each limit scope, a burst at the boundary and a multi-instance counter divergence scenario."
symbols = ["layerx_agentd::limits::RateLimiter", "layerx_agentd::limits::Refusal"]

[capability.101.17.2]
title = "Implement boundary admission control and priority"
reference_namespace = "feature.101"
reqs = ["1019.4", "1019.5", "1007.8"]
touches = ["agent/crates/layerx-agentd/src/limits/admission.rs", "agent/crates/layerx-agentd/tests/admission.rs"]
tests = []
verification_contract = "make agent-test-agentd-admission"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Apply admission control to outbound boundary traffic so retries, backfills and subscription catch-up cannot saturate the node interface."
do_2 = "Prioritise submission delivery and receipt resolution over bulk reads under contention, and prove the priority holds under a synthetic bulk-read storm."
do_3 = "Propagate core backpressure and unavailability to callers as backpressure rather than absorbing it internally."
do_4 = "Bound every internal queue with explicit capacity and a defined overflow behaviour."
do_5 = "Add tests covering saturation, a slow node and a burst of reconnecting subscriptions."
symbols = ["layerx_agentd::limits::admission", "layerx_agentd::limits::Priority"]

[capability.101.17.3]
title = "Bound request lifetime and cancel orphaned work"
reference_namespace = "feature.101"
reqs = ["1019.6", "1013.4", "1001.6"]
touches = ["agent/crates/layerx-agentd/src/limits/deadline.rs", "agent/crates/layerx-agentd/tests/deadlines.rs"]
tests = []
verification_contract = "make agent-test-agentd-deadlines"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Apply an explicit deadline to every request and every boundary call within it."
do_2 = "Cancel downstream work when a caller disconnects, except work whose cancellation would orphan a submission."
do_3 = "Guarantee that no submission is left without an owner resolving its state, and prove it with a disconnect-mid-submission test."
do_4 = "Expose the population and age distribution of in-flight and unresolved work."
do_5 = "Add tests covering caller disconnect at every write stage and a deadline expiring during unknown resolution."
symbols = ["layerx_agentd::limits::deadline", "layerx_agentd::limits::cancel"]

[capability.101.17.4]
title = "Implement durable resource quotas and load shedding"
reference_namespace = "feature.101"
reqs = ["1019.7", "1019.8", "1021.4"]
touches = ["agent/crates/layerx-agentd/src/limits/quota.rs", "agent/crates/layerx-agentd/tests/quota.rs"]
tests = []
verification_contract = "make agent-test-agentd-quota"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Apply quotas to subscriptions, prepared activities, outbox entries, audit retention and stored receipts, refusing creation past a quota."
do_2 = "Detect a retry storm, a hot loop or a pathological client and shed load for that client specifically."
do_3 = "Never shed load for unrelated tenants to compensate and record every shedding decision."
do_4 = "Report quota utilisation per tenant through health and metrics."
do_5 = "Add tests covering quota exhaustion, a pathological client and the isolation of an unrelated tenant during shedding."
symbols = ["layerx_agentd::limits::Quota", "layerx_agentd::limits::shed"]

[capability.101.17.5]
title = "Prove limits never cause a duplicate economic effect"
reference_namespace = "feature.101"
reqs = ["1019.9", "1023.5", "1013.3"]
touches = ["agent/tests/limits/exactly_once.rs", "Makefile"]
tests = []
verification_contract = "make agent-test-limits-exactly-once"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Assert that a refused retry leaves the idempotency record and the outbox in a state that resolves to exactly one outcome."
do_2 = "Assert that shedding, quota refusal and deadline cancellation never release a reservation whose activity is unresolved."
do_3 = "Drive a combined storm of retries, shedding and restarts and assert exactly one receipt per intent."
do_4 = "Record any observed violation with the full submission history so it is diagnosable rather than flaky."
do_5 = "Wire the suite into make agent-test-limits-exactly-once as a build gate."
symbols = ["agent_limits_exactly_once_suite"]

[capability_group.101.18]
title = "Implement tenant isolation"
children = ["101.18.1", "101.18.2", "101.18.3", "101.18.4", "101.18.5"]

[capability.101.18.1]
title = "Enforce tenancy in the storage access path"
reference_namespace = "feature.101"
reqs = ["1021.1", "1009.1"]
touches = ["agent/crates/layerx-agentd/src/store/tenant.rs", "agent/crates/layerx-agentd/tests/tenant_store.rs"]
tests = []
verification_contract = "make agent-test-agentd-tenant-store"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Scope every stored object to exactly one tenant in its key and make a query without a tenant unrepresentable rather than filtered at the edge."
do_2 = "Audit every storage call site to prove no path constructs a key without a tenant, enforced by a compile-time or checker-level gate."
