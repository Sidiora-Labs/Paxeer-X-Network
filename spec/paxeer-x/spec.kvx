obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Run steps 1 through 9 of human/wallet/docs/cutover.md from the operator host, with the flyctl proxy tunnels to the wallet attestor apps (count unresolved) on the operator host open through step 8."
do_2 = "In place of step 10's proxy rewrite, scale the wallet gateway app of human/wallet/deploy/gateway.toml to a second region with at least one started machine there beside its machines in ams, register the public wallet endpoint name on the edge with tools/bringup/edge.sh add <name> <gateway app>; once the name reaches the edge, through the wildcard or after the owner's one record move when the name is not under paxeer.network, and scripts/wallet/check-live.sh cutover passes against the name, the public wallet endpoint name is answered only by the Fly wallet gateway behind the edge, and write CUTOVER_STATE_DIR/applied-at in the format human/wallet/deploy/cutover/apply.sh writes, holding the time the edge began serving it."
do_3 = "Run step 11, making the database at the backend origin that the deploy side's discovery packet names read-only through its admin access; step 12, the owner's sealing of the old master key; and step 13, once CUTOVER_SOAK_SECONDS have passed and only once the new PWA origin serves, because stopping the legacy container also removes the old PWA: human/wallet/deploy/cutover/retire.sh in container mode on OLD_WALLET_HOST with CUTOVER_CONTAINER the legacy wallet container, CUTOVER_PUBLIC_HOST the public wallet endpoint name, CUTOVER_STATE_DIR and CUTOVER_SOAK_SECONDS as the runbook sets them; retire.sh's check sees the name answered by the Fly wallet gateway with its x-served-by header, and after it clears the container's restart policy and stops it the Fly wallet gateway alone answers the name; then drop OLD_WALLET_HOST from the host-map roles of tools/bringup/check-live.sh and from the fixtures of tools/bringup/check-live.test.sh."
do_4 = "Add the wallet subcommand that runs scripts/wallet/check-live.sh cutover with CHECK_LIVE_CUTOVER_HOST the public wallet endpoint name of [contract_context.108.decision.public_names] wallet_endpoint, and scripts/wallet/check-live.sh gateway against the Fly wallet gateway, and checks that the wallet gateway app runs started machines in two regions."
symbols = ["check_wallet"]

[capability.108.4.2]
title = "Serve paid web search from sidecars on the serving RPC nodes, settled through the router"
reference_namespace = "feature.108"
reqs = ["1169.1", "1169.2"]
touches = ["interop/deploy/x-websearch/config.example.json", "tools/bringup/xweb-config.sh", "interop/deploy/x-websearch/x-websearch-serve.service", "interop/deploy/x-websearch/nginx-search.conf", "tools/bringup/check-live.sh"]
