ac_2 = "Correct magic/hash does not admit malformed bodies, forbidden float/ambient imports, invalid capabilities, excessive module/function/stack/depth limits or unsupported ABI."
ac_3 = "Valid legacy and canonical interface-bearing deployments remain usable under their recorded ABI, and failed deployment leaves no executable registry record or partially committed artifact."
