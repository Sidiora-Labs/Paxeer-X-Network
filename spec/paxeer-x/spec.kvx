obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Add src/state/lxp_journal.c providing one journal per activity, opened before dispatch and either committed in full or rolled back in full."
do_2 = "Guarantee that no partial-commit path exists, so no reader, index, event stream or receipt can observe a proper subset of a transfer set."
do_3 = "Bind mutation to exactly one executor thread and treat a mutating call from any other thread as a fatal invariant violation that halts the node."
do_4 = "Process activities in strict global sequence order and reduce every parallel verification result into the writer in a fixed deterministic order, so scheduling cannot alter outcomes."
do_5 = "Test under ThreadSanitizer with the worker pool at zero and at maximum threads and assert byte-identical output in both configurations."
