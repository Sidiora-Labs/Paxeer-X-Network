obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Add human/wallet/attestor/internal/lxwire decoding the kernel activity envelope from its canonical binary encoding as agent/crates/layerx-wire defines it (big-endian fixed-width integers, field tags, length-prefixed bytes, sorted maps), exposing the typed fields, the account sequence, the authority kind and the signature preimage under the signature-preimage domain."
do_2 = "Add the account id derivation (protocol 3, LX:ACCOUNT:v1 with length prefix), the DID derivation from an Ed25519 public key, the LX:PAXEER-BIND:v1 message builder and parser, and the 402 grant and receive preimages under their documented domains."
do_3 = "Add lxwire_test.go that decodes every activity golden under agent/schema/agent-api/golden and re-encodes it byte for byte, checks the binding vectors under layerxproof/testvectors and layerxproof/testdata, and checks account ids against values computed by layerxproof/codec."
symbols = ["DecodeActivity", "EncodeActivity", "SignaturePreimage", "AccountID", "DIDFromKey", "BindMessage", "GrantPreimage", "ReceivePreimage"]

[capability.111.1.8]
title = "Verify user tokens and agent request signatures at the attestor"
