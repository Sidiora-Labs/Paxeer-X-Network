[capability.112.1.13]
title = "Wire the sidecar binary: the payment gate on every paid route, the crawler cycle and the content route"
reference_namespace = "feature.112"
reqs = ["1218.1", "1219.1", "1220.1"]
touches = ["interop/crates/x-websearch/src/main.rs", "interop/crates/x-websearch/src/lib.rs", "interop/crates/x-websearch/src/search.rs", "interop/crates/x-websearch/src/content.rs", "interop/crates/x-websearch/src/fetch.rs", "interop/crates/x-websearch/src/crawl.rs", "interop/crates/x-websearch/tests/binary.rs", "interop/crates/x-websearch/tests/crawl.rs", "interop/crates/x-websearch/tests/fetch.rs", "interop/crates/x-websearch/tests/search.rs", "interop/crates/x-websearch/tests/content.rs", "interop/crates/x-websearch/tests/fixtures/binary"]
