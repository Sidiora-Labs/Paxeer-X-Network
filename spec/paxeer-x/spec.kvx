obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Implement lxp_receipt_verify_offline to check the sequencer signature over the canonical receipt bytes using only the published sequencer key, with no call back to LayerX."
do_2 = "Implement lxp_receipt_match_requirement to confirm asset, amount, recipient, network_id and context_hash match the requirement the service issued."
do_3 = "Implement lxp_receipt_verify_checkpointed to recompute the activity merkle root from activity_inclusion_proof, verify state_inclusion_proof against resulting_state_root, count threshold bonded signatures in the guarantor certificate and match the Paxeer settlement reference."
do_4 = "Ship the verifier as a small standalone unit a paid service can link without the node, and reuse it inside layerx-verify."
do_5 = "Test verification of a pre-checkpoint receipt and the same receipt after augmentation, asserting no pre-checkpoint field changed."
symbols = ["lxp_receipt_verify_offline", "lxp_receipt_match_requirement", "lxp_receipt_verify_checkpointed"]

[capability.105.23.5]
title = "Ship the layerxd daemon with its three roles"
