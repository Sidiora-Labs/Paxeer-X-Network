do_2 = "Serve the read through the core receipt-verification authority so a program observes only verified protocol facts, never raw kernel state."
do_3 = "Refuse a read for an account outside the grant with a typed denial rather than a zero balance, so absence and denial are distinguishable."
do_4 = "Meter the read and bound the number of accounts one activity can grant sight of."
do_5 = "Prove sight confers no authority: a program holding every read grant and no spending grant can move nothing."
