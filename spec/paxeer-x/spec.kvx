completion_policy = "Qualifies authority credential isolation and source-level Kubernetes provisioning. Kernel token provisioning is required by task24.1; deployed route and role qualification and the complete task22.5 lifecycle remain separate and mandatory."
path_policy = "Modify existing paths in place and create the two declared gate files. Kernel initialization is outside this task."
evidence_policy = "Retain credentials, build manifests and raw gate logs in access-controlled storage; publish only technical source."

[req.216]
title = "Durable caller-bound supervisor reset identity and recovery"
ac_1 = "Add a bounded versioned reset request with caller-supplied stable reset_id, request digest and network binding, plus read-only status by reset_id on the existing private Unix socket. Reject conflicting reuse, malformed identities, wrong network and unauthorized peers without mutation. No public endpoint or widened trust boundary."
ac_2 = "Persist admitted operation identity, target generation, one chosen genesis timestamp, canonical producer-input bindings and eventual original response in an owned fsync-backed state directory outside both discarded DATA_DIR and ephemeral RUN_DIR. Completed outcomes survive handler/supervisor/core restart and removal of RUN_DIR; successful responses do not delete them. Never persist raw credentials."
ac_3 = "Serialize duplicate callers onto the same admitted operation. A repeated completed identity returns the identical original reset_id/result without stopping daemons, deleting post-reset data, rebuilding genesis or advancing generation. Recovery reconciles durable phases before daemon startup and never blindly repeats an already completed reset."
ac_4 = "Use the actual existing bootstrap and native daemons unchanged. Freeze --genesis-timestamp-ms and canonical input identities at admission; interrupted recovery cannot select new time, metadata, fee parameters or authority. Distinguish recoverable incomplete operation from completed outcome; never fabricate completion from a live port."
ac_5 = "The actual-process gate covers first reset, concurrent/repeated identities, conflicting reuse, lost response, SIGKILL/restart, ephemeral RUN_DIR recreation, corrupt or unwritable durable records and preservation of original canonical rebuilt genesis. This prerequisite qualifies stable identity and recoverable state only; it does not discharge req1060.3 universal503/no-effect or authorize a destructive retry after an ambiguous activation. Ambiguous activation must remain explicit and block full core qualification."

[req.217]
title = "Preserve authoritative funding receipts across destructive node reset"
ac_1 = "Persist the full existing idempotency/request binding and exact signed SEND canonical bytes before native admission. Recovery uses the same activity identity and unchanged authoritative receipt verification; it never re-signs using a fresh sequence, validity window or idempotency value. Preserve every current response and refusal assertion."
ac_2 = "Before any destructive reset is admitted, enumerate every relevant durable funding intent under the existing admin serialization lock and resolve its authoritative outcome. Verify the original receipt, activity, network, asset, authorized signer and result using the existing production verification path; retain exact verified bytes and request/activity binding in durable core storage outside DATA_DIR. An unavailable, inconsistent, oversized, corrupt or unwritable required archive refuses reset before supervisor contact and before any economic state change."
ac_3 = "The receipt archive is a durable replay authority, not an invented outcome or an unverified response cache. After actual node and replica state are reset or restarted, a repeated funding key returns its original verified outcome without contacting an erased generation to re-execute the SEND. Preserve terminal refusals and conflicts and all receipt/finality checks."
ac_4 = "Use actual custody-funded treasury and recipient, real SEND, native receipt/balance proofs and real supervisor reset. Prove same-key replay before/after core restart and after node reset, no second economic effect, and real archive storage/read failure with no reset effect. No fake receipt source, mocked reset server or recorded-chain substitute."
ac_5 = "This independently implementable core path preserves evidence before reset; it does not alone solve post-effect final-journal failure or transactional reset activation. Keep task103.6.2 unqualified until req218 and its original full gate pass."

[req.218]
title = "Complete reset activation and remove mandatory post-effect outcome writes"
ac_1 = "Integrate stable supervisor identities and verified receipt preservation without changing any current assertion, response contract, native authority, receipt/finality check or storage bound. Every required storage operation that can yield503 must precede the associated irreversible economic/reset effect;503 leaves economic state unchanged. Do not reinterpret202/422/503 or substitute a dropped connection."
ac_2 = "Prepare the reset generation through the original canonical bootstrap/genesis builder while retaining the previous live generation until a validated durable activation decision is ready. Freeze the admitted timestamp and exact canonical inputs. Define secure prepare, activate and rollback/recovery operations that do not require a new successful durable write after irreversible activation to identify the original outcome. If that cannot be achieved with the leased production interfaces, stop unqualified; never replace actual reset with a marker-only operation."
ac_3 = "The stable caller identity, durable activation authority and existing real native state establish exactly which generation was committed. Recovery at every crash boundary either retains the previous economic generation or resumes the same admitted transition; it never clears a subsequently active generation or returns another reset_id. Successful reset still stops both daemons, discards the old node state through the real producer, rebuilds canonical genesis and restarts both."
ac_4 = "For SEND, eliminate a mandatory post-effect core outcome-journal write only after proving that the durable exact intent plus unchanged authoritative receipt recovery and pre-reset receipt preservation reconstruct the original result for the entire idempotency lifetime. Do not ignore a required failed write or infer funded state from admission, HTTP200 or account balance alone."
ac_5 = "One actual-process gate exercises the complete first-reset, real funded SEND, response-loss, crash-at-admission/prepare/activation/completion, persistent/ephemeral restart, actual filesystem failure, same-key conflict/replay and receipt preservation contract. Retain all original core tests and strict all-target Clippy coverage in the full task103.6.2 gate; this prerequisite supplies the missing interface and does not waive that original gate or release readiness."

[task.24.17]
title = "Persist stable supervisor reset identities and original outcomes"
status = "done"
completion_basis = "implementation"
qualification_status = "unverified"
mode = "BUILD"
wave = 3
requires = ["0.2", "24.16"]
