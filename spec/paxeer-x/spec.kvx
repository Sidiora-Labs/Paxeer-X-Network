verification_contract = "timeout 20m sh -c 'cargo test --locked --manifest-path interop/Cargo.toml -p layerx-gas-station --lib'"
obligation = "Retain the complete capability and qualify its applicable acceptance criteria on the candidate; preserve valid existing implementation and evidence."
do_1 = "Add interop/crates/layerx-gas-station to the members of interop/Cargo.toml and give it a Cargo.toml in the shape interop/crates/layerx-bridge-relayer/Cargo.toml uses - workspace version, edition, rust-version, license and lints, a lib at src/lib.rs and a bin at src/main.rs - taking its dependencies from the workspace table and adding none that is not already declared there."
do_2 = "Write src/config.rs loading the station's configuration from a file path: the chain endpoints, the paymaster address, the Sidiora token address and its six decimals, the source of the governed rate (the oracle pair this line first named is superseded by task 4.1 under the oracle_retired decision), the acceptable rate age, the spread, the station's margin, the per-account, per-interval and per-quote limits, the Paxeer balance floor and the relayer key source; refuse a configuration that is incomplete or self-contradictory with a typed error naming the field."
do_3 = "Write src/quote.rs building the quote the contract verifies and computing its digest byte for byte as contracts/src/BatchCallAndSponsor.sol computes it, asserted against the same vector contracts/test/BatchCallAndSponsorTest.t.sol asserts, and src/signer.rs signing that digest with the configured relayer key held behind a trait so the key never crosses a public boundary."
do_4 = "Write src/price.rs reading the governed rate (the oracle read this line first named is superseded by task 4.1 under the oracle_retired decision), refusing when the rate is absent, older than the configured age or outside the configured spread, and applying the station's margin in integer arithmetic over the six-decimal Sidiora side and the eighteen-decimal Paxeer side with no floating point."
do_5 = "Write src/policy.rs enforcing the per-account, per-interval and per-quote limits and the Paxeer balance floor, refusing to quote rather than quoting something the station cannot pay for, and returning a typed refusal that names which limit was hit."
do_6 = "Write the crate's unit tests as #[cfg(test)] modules beside each file: the digest vector, each pricing refusal, each limit refusal, the balance floor refusal and the configuration refusals; write src/lib.rs and src/main.rs so the binary takes --config PATH and exits with a distinct code for a refused configuration."
symbols = ["layerx-gas-station", "StationConfig", "Quote", "quote_digest", "PriceSource", "QuotePolicy"]

[capability.113.1.3]
