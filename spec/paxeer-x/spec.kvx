touches = ["human/wallet/attestor/internal/server/server.go", "human/wallet/attestor/internal/server/keys.go", "human/wallet/attestor/internal/server/server_test.go", "human/wallet/attestor/internal/server/e2e_test.go", "human/wallet/schema/attestor-api/v1.kvx", "human/wallet/schema/attestor-api/golden/keys.describe.request.json", "human/wallet/schema/attestor-api/golden/keys.describe.response.json", "human/wallet/docs/runbooks/node-replacement.md"]
