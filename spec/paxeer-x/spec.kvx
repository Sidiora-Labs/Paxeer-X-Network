do_1 = "In human/wallet/attestor/internal/policy/lx drop the ledger the Evaluator holds: lx.New takes the engine, the kernel policy and the chain reader, and EvaluateActivity, EvaluateBind and EvaluateGrant take the policy.Ledger view of the request, so every cap check reads Spent and every allowed request records its spends and its request count through that view under policy.AccountKey of the account, and each allowed decision returns its spends in policy.Decision.Spends in the shape the EVM kinds return (closes observation 4.11.7)."
do_2 = "In internal/server/sign.go pass the request's durable view, s.spends.ForRequest with the request id, to the kernel evaluator exactly as to the EVM policy, so kernel spends reach Announce, are applied by every non-signing participant, count once per request id and persist sealed in the store; in cmd/attestor/main.go build policy.NewSpendLedger over the node's store, pass it as the server's ledger and build the kernel evaluator without a ledger of its own, so no in-memory ledger remains in the daemon."
do_3 = "Extend lx_test.go to evaluate over a store-backed SpendLedger, and add server tests over five in-process daemons proving that a per-account request-rate cap reached by one EVM sign and one kernel sign, with the signing node restarted from its store between them, refuses the next request of either kind; that a kernel daily cap holds after a restart; that a kernel spend announced by one signer is counted once by every participant; and that spreading kernel requests over different signer sets cannot exceed a cap; extend main_test.go for the daemon's ledger wiring."
symbols = ["Evaluator", "New", "EvaluateActivity", "EvaluateBind", "EvaluateGrant", "SpendLedger", "ForRequest", "NewSpendLedger"]

[capability.111.4.20]
title = "Expose a key's public material to the operator for node replacement"
