[task.2.1]
title = "Consistency sweep: retarget rosters, qualification scripts and docs to the renamed env-init paths and box units"
status = "implemented"
mode = "BUILD"
wave = 2
requires = ["1.3", "1.9", "1.10", "1.12", "1.13"]
reqs = ["9.1", "11.1"]
do_1 = "Add the oracle-feeder row (uid 4021, logged) to kernel_roster in tools/bringup/check-live.sh so the roster matches what docker/kernel/init.sh launches."
do_2 = "Retarget tools/qualification/paxeer-x/event-delivery-contract.py, registry-router-bootstrap.py, registry-contract.py and tools/bringup/tests/paxeer-x-runtime-contract.py from fly-init paths and the registry-fly-init producer strings to the env-init paths and the new producer string."
do_3 = "Rename the registry-fly-init producer string in docker/platform-registry/init.sh and align the box unit name between deploy/rollout.kvx (layerx-program-registry.service) and docker/platform-registry/layerx-registry.service."
do_4 = "Repoint every reader of the deleted human/wallet/deploy/human.toml (tools/bringup/check-live.sh, check-live.test.sh, ca.sh, human-state-preserve.sh, kernel-genesis.sh, docker/kernel/Dockerfile) at docker/kernel/kernel.env.example and the kernel files table."
do_5 = "Update the IMAGE_NAMES pages (docs/site/docs/operators/beta-cluster.md, hosted-internal.md, platform/identity.md and docs/wiki BetaCluster.md, HostedIdentity.md, HostedInternal.md) to the image set in platform/hosted/tests/beta-images.sh."
touches = ["tools/bringup/check-live.sh", "tools/bringup/check-live.test.sh", "tools/bringup/ca.sh", "tools/bringup/human-state-preserve.sh", "tools/bringup/kernel-genesis.sh", "docker/kernel/Dockerfile", "tools/qualification/paxeer-x/event-delivery-contract.py", "tools/qualification/paxeer-x/registry-router-bootstrap.py", "tools/qualification/paxeer-x/registry-contract.py", "tools/bringup/tests/paxeer-x-runtime-contract.py", "docker/platform-registry/init.sh", "docker/platform-registry/layerx-registry.service", "deploy/rollout.kvx", "docs/site/docs/operators/beta-cluster.md", "docs/site/docs/operators/hosted-internal.md", "docs/site/docs/platform/identity.md", "docs/wiki/BetaCluster.md", "docs/wiki/HostedIdentity.md", "docs/wiki/HostedInternal.md"]
verify_cmd = "python3 tools/bringup/tests/paxeer-x-runtime-contract.py --case service-roster && python3 tools/qualification/paxeer-x/registry-router-bootstrap.py && python3 tools/qualification/paxeer-x/registry-contract.py && python3 tools/qualification/paxeer-x/event-delivery-contract.py"
max_builds = 0
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the verify result, two failed repair cycles or 30 minutes; record revision, command, exit code and log path."

