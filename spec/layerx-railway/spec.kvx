[meta]
name = "layerx-railway"
slug = "layerx-railway"
version = "1.0.0"
status = "active"
goal = "Retire Fly: every LayerX hosted service deploys on Railway (project layerx, environment beta) and every node, validator, key-holding or stateful service runs on owned boxes, all applied by our own rollout controller from pinned commits."
scope = "Images and Dockerfiles, the env-files secret shim, service runtime config, certificates and token minting, box systemd units, the rollout controller and manifest, the publish pipeline, the edge, and operator docs."
completion = "Every acceptance criterion below passes on one pinned main commit: no Fly reference outside docs, every Railway service deployed SUCCESS, every box unit active with health green, one rollout ledger line per applied service, and api-mainnet-beta served from the Railway router through the edge."

[decision]
source = "Orchestrator brief /root/lx-ops/railway-move-2026-10-07/fleet/BRIEF.md decisions D1-D10 and REPORT.md sections 1-5 (private); owner order 2026-10-07: Fly is retired."
pipeline = "git push -> image build -> registry -> tools/rollout applies to Railway and boxes."
railway_project = "layerx"
railway_environment = "beta"
image_repo = "ghcr.io/sidiora-labs"

[execution]
task_policy = "One lane per task, exact touches only, implementation first, then one build and one verify_cmd with at most two repair cycles inside 30 minutes."
evidence = "Gate and observation records go to spec/layerx-railway/qualification.kvx; lane logs live under the private fleet log directory."

[req.1]
title = "D1 Railway project, environment and service set"
ac_1 = "Railway project layerx with environment beta holds one service each for identity, router, redis-router, redis-internal, internal-kms, internal-journeys, internal-payments, internal-approvals, internal-programs, webhooks-public, webhooks-ingress, dashboard, dashboard-web, interop, search-front, ramp, relay-archive-a, relay-archive-b, wallet-gateway, wallet-postgres, gas-station, indexer and intent-ingester."
ac_2 = "Private calls use <service>.railway.internal over IPv6 and every service binds ::."
ac_3 = "Each former Fly process group is its own Railway service selected by env LAYERX_ROLE=<name>."

[req.2]
title = "D2 Kernel box and public box names"
ac_1 = "The kernel (native then full profile), program registry, oracle feeder and explorer-index run on one kernel box."
ac_2 = "kernel.paxeer.network carries kernel listeners 9443/9445/9446/9449/9457, index.paxeer.network carries registry 9420 and machine.paxeer.network:9454 carries agentd; Railway services reach them by those names over TLS."
ac_3 = "The box reaches journeys, approvals, webhooks-ingress and identity through Railway TCP proxies <name>.proxy.rlwy.net:<port>, and tools/bringup/ca.sh adds the proxy names to those server certs from env LAYERX_EXTRA_SANS_<ROW>."

[req.3]
title = "D3 Images built from the repository"
ac_1 = "Railway builds every Railway service from Sidiora-Labs/Paxeer-X-Network branch main with builder DOCKERFILE, build.dockerfilePath docker/<image>/Dockerfile, repo-root context and per-service watchPatterns."
ac_2 = "Box services pull ghcr.io/sidiora-labs/<image>:<12-hex sha> pushed by the publish pipeline."
ac_3 = "The last stage of every Dockerfile is the runtime stage that runs without --target and materialises file secrets before it execs the service; Railway deploys are pinned by commit sha."

[req.4]
title = "D4 File secrets from env through one shim"
ac_1 = "docker/common/env-files.sh installed as /usr/local/bin/layerx-env-files reads /etc/layerx/files.tsv (NAME, guest_path, mode, roles) and decodes each base64 NAME for the current LAYERX_ROLE to a temp file, chmods, renames and unsets NAME."
ac_2 = "A missing or invalid value for a required row fails closed; local_path rows are baked into the image by COPY; the shim ends with exec of its arguments."
ac_3 = "Every image that had Fly [[files]] entries carries its files.tsv and uses ENTRYPOINT [/usr/local/bin/layerx-env-files, <service-init>]."

[req.5]
title = "D5 One token producer"
ac_1 = "tools/bringup/mint-secrets.sh is the single producer of service tokens and emits Railway variables per service and box env files."
ac_2 = "Identity, internal and the kernel init read their tokens from env when set and generate only when unset, so each caller token equals the callee token."

[req.6]
title = "D6 Kernel public listeners unchanged"
ac_1 = "Kernel public listeners stay TLS plus bearer as coded; allow_unauthenticated is not modified by this feature."

[req.7]
title = "D7 Plain HTTP health for every Railway service"
ac_1 = "Every Railway service answers a plain HTTP GET health path on $PORT that its Railway healthcheck targets."
ac_2 = "TLS-only services add a plain listener on LAYERX_HEALTH_ADDR (default [::]:8080, path /healthz)."

[req.8]
title = "D8 Client IP from X-Forwarded-For"
ac_1 = "Services that read Fly-Client-IP read the rightmost untrusted X-Forwarded-For hop set by trusted proxies instead."

[req.9]
title = "D9 No Fly names in runtime config"
ac_1 = "No .internal, .fly.dev, fly-init or FLY_* name remains in runtime config; fly-init.sh scripts are renamed env-init.sh and Dockerfile stages named fly are renamed env-init."

[req.10]
title = "D10 Rollout controller"
ac_1 = "tools/rollout/ (python3 stdlib only) applies the manifest deploy/rollout.kvx wave by wave from a pinned commit to Railway services and box units."

[req.11]
title = "Every Fly reference gone"
ac_1 = "git grep -nE over the tree for fly.io, .internal, FLY_, fly-init and registry.fly returns nothing outside docs/."

[req.12]
title = "Every Railway service deploys"
ac_1 = "Every Railway service in deploy/rollout.kvx reaches deployment status SUCCESS from its repository Dockerfile at the pinned commit."

[req.13]
title = "Every box service healthy under systemd"
ac_1 = "Every box service in deploy/rollout.kvx runs under its systemd unit, systemctl is-active reports active and its manifest health check is green."

[req.14]
title = "Rollout applied and recorded"
ac_1 = "The rollout controller applies one sha to both Railway and box targets and tools/rollout/ledger.sh records one ledger line per applied service."

[req.15]
title = "Edge serves the router from Railway"
ac_1 = "Edge nginx serves api-mainnet-beta.paxeer.network from the Railway router service domain with Host and SNI set for Railway and X-Forwarded-Host kept."

[task.1.1]
title = "rw-01 Build the kernel native profile from source instead of the Fly registry base"
status = "done"
mode = "BUILD"
wave = 1
requires = []
reqs = ["3.1", "3.2", "3.3", "9.1"]
touches = ["docker/kernel/Dockerfile"]
verify_cmd = "docker build --check -f docker/kernel/Dockerfile ."
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the verify result, two failed repair cycles or 30 minutes; record revision, command, exit code and log path."

[task.1.2]
title = "rw-02 Add the env-files secret shim and per-image file tables"
status = "done"
mode = "BUILD"
wave = 1
requires = []
reqs = ["4.1", "4.2", "4.3"]
touches = ["docker/common/env-files.sh", "tools/railway/fly-files-to-table.py", "tools/railway/tests/env-files.test.sh", "docker/bridge-relayer/files.tsv", "docker/intent-ingester/files.tsv", "docker/interop-gateway/files.tsv", "docker/kernel/files.tsv", "docker/platform-dashboard/files.tsv", "docker/platform-gateway/files.tsv", "docker/platform-webhooks/files.tsv", "docker/ramps/files.tsv", "docker/relay-archive/files.tsv", "docker/search-front/files.tsv", "docker/wallet-attestor/files.tsv", "docker/wallet-gateway/files.tsv"]
