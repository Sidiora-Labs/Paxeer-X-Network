note = "Image pushed as kernel:fe0326d95a5d, :-full and :-native-runtime; the kernel unit now runs it and is active."

[gate.3.3.2]
task = "3.3"
reqs = ["2.1", "2.2", "13.1"]
revision = "65ccb175eb60708dcdf2f4f899944e45f25a50d5"
command = "systemctl start layerx-registry.service && systemctl is-active layerx-registry.service && curl -fsS http://127.0.0.1:9421/healthz"
environment = "registry box, image layerx-program-registry:65ccb175eb60 built and pushed from the box"
