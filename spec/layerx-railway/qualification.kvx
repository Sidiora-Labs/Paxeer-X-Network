outcome = "blocked"
evidence = "/root/lx-ops/railway-move-2026-10-07/handoff/owner-needs.md"
note = "Owner input: the agent harness refuses to create the four Railway TCP proxies; the owner creates them and sets LAYERX_EXTRA_SANS_<ROW>=DNS:<name>.proxy.rlwy.net before ca.sh issue."

