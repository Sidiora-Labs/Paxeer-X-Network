observed = "The task verify command exited 0, but cg spec done 1.12 exited 1 on two graph checks: the symbol test-ratio is a shell script the code graph does not index, and the touch check for explorer/README.md finds no match because the change is already committed without a spec tag in its message."
assumption = "Neither check can be satisfied without editing the task's own symbols entry or rewriting a published commit message, so the task is recorded done by hand from its passing verify command, as task 1.5 was for the same class of check."
severity = "note"

[observation.1.13.1]
