[observation.1.9.2]
task = "1.9"
file = "explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/http/throttle.ex"
symbol = "lint-backend"
observed = "Once the configuration was honoured every exit-affecting credo finding sat in a fork-owned or fork-modified file, several of them outside the task's touches list: the JSON-RPC application, transaction, receipt and throttle modules, the internal transaction fetcher and the logger metadata in config_helper.exs."
assumption = "do_4 does not apply because no finding came from a vendored file the fork has not modified, so every finding was fixed in code and .credo.exs gained no exclusion and no disabled check."
severity = "note"

