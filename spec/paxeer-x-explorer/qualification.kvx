symbol = "paxeer_x_receipt"
observed = "The twenty-seventh failure of the same leg is lib/api/services/general/paxeerX.spec.ts 'keeps one resource name per definition in both maps', which expects six resource names and reads five: the map the suite walks carries no general:paxeer_x_receipt beside the five other Paxeer X resources."
assumption = "The single-receipt resource belongs to the receipt detail path of the fork's API surface and its absence is a contradiction between that task's test and its source, not a consequence of the per-application backend legs this task adds."
severity = "blocker"

[observation.4.2.1]
task = "4.2"
file = "spec/paxeer-x-explorer/qualification.kvx"
symbol = "paxeer_x_receipt"
observed = "Observation 4.1.3 reads the twenty-seventh frontend failure the wrong way round: in expect(names).toEqual(defined) the hard-coded enumeration is the received value and the keys of the two resource maps are the expected one, so the gate log's five-against-six diff means the maps carry general:paxeer_x_receipt and the enumeration in lib/api/services/general/paxeerX.spec.ts did not."
assumption = "The resource has been registered since the receipt detail page landed and the receipt page queries it, so task 4.2 completes the enumeration in the test file and changes no production source; observation 4.1.3 is left as task 4.1 wrote it."
severity = "note"

[gate.3.1.1]
task = "3.1"
reqs = ["16.1","16.2"]
revision = "4ed6388c760d2c166acacffbb3de09c25c6a3697"
command = "timeout 20m sh -c 'EXPLORER_GATE_BUDGET_SECONDS=1080 tools/explorer/gate-test.sh'"
environment = "linux/x86_64, the pinned builder image explorer-elixir-builder:v10.2.6 with a postgres:16 sidecar of its own, node 22 and yarn 1 for the frontend legs"
outcome = "fail"
evidence = "build/explorer-gates/backend-paxeer-x.log"
note = "The backend Paxeer X leg ran all twenty Paxeer X test files the umbrella carries in one mix invocation and exited 1: the ethereum_jsonrpc project reported 25 tests and 0 failures, the explorer project reported 111 tests and 0 failures, and the indexer project then raised in its test helper before its first test. The gate stops on the first failing leg, so the frontend dependency install, the frontend type check and the frontend vitest legs never ran and no record is written for them."

[observation.3.1.1]
task = "3.1"
file = "explorer/backend/apps/indexer/test/test_helper.exs"
symbol = "Explorer.TestHelper.run_necessary_background_migrations/0"
observed = "At revision 4ed6388c760d2c166acacffbb3de09c25c6a3697 the gate command exited 1 with log build/explorer-gates/backend-paxeer-x.log: once ethereum_jsonrpc and explorer had passed inside the same mix invocation, the indexer project's test helper raised RuntimeError Background migrations failed, every background migration having reported DBConnection.OwnershipError against the sandbox pool, so the indexer and block_scout_web Paxeer X suites never started."
assumption = "The helper is an upstream test entry point no task in this feature touches and the indexer Paxeer X suite passes when that project is tested on its own, so the failure belongs to running several umbrella projects in one mix invocation rather than to any task's code, and it is recorded here rather than investigated or rerun."
severity = "blocker"

[observation.3.1.2]
task = "3.1"
file = "spec/paxeer-x-explorer/qualification.kvx"
symbol = "gate.started_at"
observed = "The gate record shape this file's header documents carries started_at, a UTC timestamp, while the feature's naming decision forbids any file this feature introduces from carrying a date."
assumption = "The record above is written without started_at because the revision, the command, the exit code and the log path identify the run without one, and the header is left exactly as written for its owner to reconcile."
