file = "explorer/deploy/tools/mix-in-builder.sh"
symbol = "mix-in-builder"
observed = "The runner mounted .formatter.exs but not .credo.exs, so mix credo --strict analysed the umbrella under credo's built-in defaults rather than the committed configuration, reporting findings in files the configuration excludes."
assumption = "Task 1.9 adds the missing mount because its verify_cmd cannot measure the fork's own configuration without it; the line belongs to task 1.1 and this work is stacked on that branch."
