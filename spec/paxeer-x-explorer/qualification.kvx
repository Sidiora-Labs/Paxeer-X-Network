file = "explorer/deploy/env/backend.example.env"
symbol = "rpc-fixture-server"
observed = "The published backend image is built with RELEASE_VERSION alone, so the release compiles with the default chain type while the environment example declares CHAIN_TYPE=paxeer_x."
assumption = "The declaration is honoured at runtime only, which is enough today: the release sets validate_compile_env false, no production module gates on the Paxeer X chain type at compile time, and the Paxeer X API paths are unconditional; adding the build argument belongs to the image workflow, which this task does not touch."
severity = "note"

[observation.2.10.3]
