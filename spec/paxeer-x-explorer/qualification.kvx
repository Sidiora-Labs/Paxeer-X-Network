[observation.3.1.4]
task = "3.1"
file = "spec/paxeer-x-explorer/spec.kvx"
symbol = "task.4.1.status"
observed = "Task 4.1 is recorded implemented rather than done, from a run of this same command that stopped in the frontend vitest leg, and its verify_cmd is the command this task just ran to exit code 0 at revision 068346118fbf3b9414f6a6ca57246ed25f41c01d with every one of its four per-application backend legs passing."
assumption = "The per-application legs task 4.1 added are qualified by this run and its status is an owner's to move, since this task may write only its own evidence and the no-reverify rule forbids running the command again to record it against 4.1."
severity = "note"

[observation.2.11.1]
task = "2.11"
file = "explorer/backend/apps/explorer/lib/explorer/chain/paxeer_x/capabilities.ex"
symbol = "Explorer.Chain.PaxeerX.Capabilities.init/1"
observed = "No arity-one init callback in the four umbrella applications makes a remote call, and the capability probe's first call ran from the continuation init/1 returned, which a child's start acknowledgement does not wait for, so the boot hang of requirement 14 was not reproduced from the committed image against a throttled node inside this task."
assumption = "The first probe is still moved off the continuation onto the message loop, so the process answers refresh/0 and every other message before its first probe returns instead of queueing behind a call a throttled node holds; the deployment-level hang stays with its owner to reproduce and this change is qualified by the boot regression test rather than by a live deployment."
severity = "assumption"

[observation.2.8.1]
task     = "2.8"
file     = "rpc/solidity/ERC20.sol, rpc/tests/solidity/ERC20.sol"
symbol   = "WPAX"
observed = "Both wrapped-coin fixtures under the JSON-RPC test trees still declare the old display name Wrapped Pax, unchanged by this task."
assumption = "They are inert JSON-RPC test fixtures outside this task's touches list, so renaming them opportunistically is out of scope and left to whoever owns those trees."
severity = "note"

[observation.2.8.2]
task     = "2.8"
file     = "foundry.paxeer.toml, contracts/bootstrap-libs.sh"
symbol   = "openzeppelin_remapping"
observed = "The task verify_cmd fetches forge-std when contracts/lib lacks it but says nothing about openzeppelin-contracts, which the Paxeer Foundry profile remaps into contracts/lib and nine sources under contracts/ import, so on a checkout where contracts/lib holds neither library the command cannot compile the project."
assumption = "contracts/bootstrap-libs.sh is the sanctioned way to populate contracts/lib and was run before the gate; extending the verify_cmd to call it would edit this task's own gate, so the gap is recorded for the owner of the contracts gates instead."
severity = "note"

[observation.1.3.1]
task = "1.3"
file = ".github/workflows/codeql.yml"
symbol = "public-audit"
observed = "The publication audit stops before its secret scan: the CodeQL workflow references actions/checkout, github/codeql-action/init and github/codeql-action/analyze by mutable tag, and the audit requires immutable commit pins for external actions."
assumption = "The repair is to pin those three references to immutable commit revisions, which no task of this feature is scoped to make: the one task that edits that workflow may change only the Go build mode. The publication audit stays red until a scope for the pinning exists."
severity = "blocker"

[observation.1.3.2]
task = "1.3"
file = "programs/fixtures/pay5/swap-cpmm.wasm"
symbol = "public-audit"
observed = "The audit's private-workspace check matches three committed WebAssembly fixtures - the two under programs/crates/layerx-programs-registry/tests/fixtures and the pay5 one - because each embeds the absolute build paths of the private workspace they were compiled in."
assumption = "The repair is to rebuild those fixtures with their source paths remapped so no absolute build path reaches the publication set. No allowlist entry is added, because the audit documents none for this case, and the audit stays red until the fixtures are rebuilt."
severity = "blocker"

[observation.1.3.3]
task = "1.3"
file = "bridge/deploy/tests/docs-check.sh"
symbol = "mutate"
observed = "The workflow references of observation 1.3.1 are immutable pins at this revision, so the audit now reaches its later checks and the secret-shape check matched one line that belongs to no explorer path: the bridge documentation check injects a PEM private-key header as a literal to prove its own detector bites."
assumption = "The line is repaired where it originates by assembling the same marker with printf, so the page the check mutates is byte identical and the mutation is still refused; the file sits outside this task's touched set and was edited because do_4 asks for every remaining finding to be handled at its source rather than allow-listed."
severity = "note"

[observation.2.13.1]
task = "2.13"
file = "explorer/services/libs/blockscout-client/crate/tests/it_works.rs"
symbol = "api_client"
observed = "The vendored suite starts one recorded stub server for all twenty-two cases from a spawned task and waits a fixed second for it, so under the default parallelism the wait expires before the server is up, the first case panics while holding the shared handle and every other case then reads a poisoned lock - timeout 20m sh -c 'tools/ci/path-length-check.sh && cd explorer/services/libs/blockscout-client/crate && cargo test --locked' exited 101 at df45d784f with 21 of 22 cases failing on a server that never started, log .logs/verify.log."
assumption = "The race belongs to the vendored bootstrap and not to the renamed stubs, because the same twenty-two cases pass with the shortened names when the suite runs one case at a time, so the gate serialises the suite and the bootstrap is left exactly as upstream wrote it for its owner to repair."
severity = "note"

[observation.2.14.1]
task = "2.14"
file = "programs/tools/program-fixtures.sh"
symbol = "program-fixtures"
observed = "Remapping the source prefix takes every checkout path out of the three rebuilt WebAssembly fixtures, and a rerun over the same checkout reproduces them byte for byte, but a rebuild from a differently located checkout still moves 203 of 25720 bytes in the naming artifact: the strings are identical and only whole functions swap places, because cargo derives the crate disambiguator of each path package from that package's absolute path and feeds it to rustc alongside the remapping."
assumption = "Holding that still needs the build to run at a fixed source root, which is what the hosted registry builder gets from its bind mount onto /build and what no in-tree script can give a developer's checkout, so the script regenerates the interface and the registry state value from the artifact it just built and the fixture set stays bound together whatever the checkout path."
severity = "note"

[observation.2.14.2]
task = "2.14"
file = "programs/crates/layerx-programs-registry/tests/registry.rs"
symbol = "DeploymentRecord"
observed = "The first leg of this task's verify_cmd exits 101 on three cases of tests/registry.rs - direct_deployment_insertion_refuses_the_reserved_upgrade_authority, noncontiguous_or_unverified_registry_history_is_refused and reproducible_build_verification_records_success_and_visible_mismatch - which read no fixture at all and fail with the same CorruptRecord refusals on the feature tip 431390302231ede2529b4ba44665282b6299e5b2 with none of this task's changes applied, log .logs/verify.log."
assumption = "They belong to the registry's own deployment-record encoding rather than to the rebuilt fixtures, because every target that does bind a fixture passes in the same run - the library's twenty cases, tests/interface.rs, tests/lxt20_reference.rs, tests/lxt721_reference.rs, tests/naming_reference.rs and, run on its own after the leg stopped, tests/swap_reference.rs - so the three cases are left exactly as written for the owner of that crate."
severity = "blocker"

[observation.2.14.3]
task = "2.14"
file = "human/crates/layerx-explorer-index/tests/verify.rs"
symbol = "explorer_fixture"
observed = "The second leg exits 101 on all four cases of tests/verify.rs, each because the C helper at build/tests/explorer_fixture that the case executes does not exist: cargo test builds no C target and the leg names no make target that produces one, while tests/reads.rs, the target that derives an interface from two of the rebuilt modules, passes its nine cases in the same run, log .logs/explorer-index.log."
assumption = "The absent helper is a prerequisite the gate never declares rather than a defect of this task, so the leg stays exactly as written for whoever owns the explorer index gate to give it the target that builds the helper first."
severity = "blocker"

