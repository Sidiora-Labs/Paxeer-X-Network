[meta]
name = "perf-db adoption: the embedded Rust engine as the perps hot path behind the existing gateway"
slug = "perf-db-adoption"
version = "0.1.0"
status = "draft"
goal = "Bring the imported perf-db engine (services/platform/perf-db, crate perfdb) to the monorepo standard and to production durability, then serve candles and ticks from it through the existing perps gateway so the application sees no change, move the hot state and the leaderboard and stats aggregations onto it, and retire the PostgreSQL paths it replaces only after parity gates against the PostgreSQL answers pass."
scope = "services/platform/perf-db (engine, CLI, a new sidecar crate), services/platform/perps-data (gateway client, UDF and kline routes behind a flag, feeds, REST and GraphQL aggregates, deploy manifests, a backfill command, a parity command and retirement migrations), services/platform/Makefile.inc and the repository CI workflows. The perps data services stay on PostgreSQL for release v6.12.0; this feature starts after that release."
revision = "ca7384d7c"
completion = "Every task verify_cmd passes at one revision; every acceptance criterion of req.1 to req.14 holds on that revision; with PERPS_PERFDB_URL unset the release negative tests of the gateway pass unchanged, and with it set the gateway serves UDF history and kline frames from the sidecar whose candles match a rebuild from the PostgreSQL facts; every retired PostgreSQL family has a recorded parity pass before its read path is removed."

[design]
flow = "Indexer (Go, perps-data) -> PostgreSQL facts and projections -> delivery outbox -> JetStream stream PERPS_V1 (subjects perps.<chain>.<market>.{fill,order,funding,index,liq,mark,oi,market}, perps.<chain>.user.<acct>.*, perps.<chain>.chain.{block,tx,rewind}; envelope services/platform/perps-data/internal/delivery/envelope.go:37-47) -> perf-db sidecar (Rust, embeds perfdb, durable JetStream consumer) -> HTTP surface -> perps gateway (Go) -> REST, WebSocket and GraphQL clients. Go cannot embed the engine, so the gateway reaches it only through the sidecar."
engine = "perfdb provides PerfDb and PerfDbConfig (services/platform/perf-db/src/engine.rs:33-45, :82-107): mmap tick and candle stores, a CRC WAL with segments (src/storage/wal.rs), bincode snapshots (src/storage/snapshot.rs:18-28), in-memory market state, position, order and balance tables, a tokio broadcast pub/sub bus, relational stores (users, referrals, checkpoint, alerts, api keys, competitions), an event store, trader and daily stats and a leaderboard, over sixteen timeframes from 1s to 1W (src/core/timeframe.rs:116-131)."
candles_today = "The application loads chart history through its candle proxy (Hyperpax:src/pages/api/candle/[...path].ts:5, :10), which forwards the UDF endpoints config, symbols, search, history, marks, timescale_marks, time and quotes to MARKET_PROXY_HOST /api/<sym>/, and streams klines as <SYM>@kline_<interval> on the Chainflow feed socket /ws/<sym> (Hyperpax:src/hooks/perps/useSidPaxMarketStream.ts:50-52, :69-70) as tuples [time, open, high, low, close, volume, closed] with time in unix seconds (Hyperpax:src/hooks/perps/useSidPaxMarketStream.ts:143-157). The perps gateway serves neither: the release pins 404 Not found for every UDF route (services/platform/perps-data/internal/rest/symbol_test.go:629-638), unknown_topic for every kline topic (services/platform/perps-data/internal/feeds/feeds_test.go:749-760) and no candle table or candle directory (services/platform/perps-data/internal/store/migrate_test.go:696-713, services/platform/perps-data/migrations/schema_test.go:741)."
flag_rule = "Every perf-db path of the gateway is enabled only when PERPS_PERFDB_URL is set. With it unset the gateway behaves exactly as at the release and the release negative tests run unchanged. No Go package or directory under services/platform/perps-data carries candle in its name; the client package is internal/perfdb and the sidecar lives under services/platform/perf-db."
external_revisions = "Hyperpax citations are at commit 242152b of the Hyperpax application repository."

[execution]
planning_state = "Task completion requires the declared implementation and its verify_cmd evidence at one revision. A specification or task status alone establishes no runtime result."
task_policy = "Read the exact declared source and contract section, keep code that already meets the contract, implement every unmet criterion of the task, then run one bounded qualification pass. Implementation, qualification and activation evidence are recorded separately."
gate_policy = "Every planned gate is implemented by the task that owns its acceptance criteria. A verify_cmd names a target that exists at the revision or is listed in planned_paths with gate_kind planned; unknown, empty or skipped selectors are refused."
candidate_policy = "A passing gate is reused only while its source, inputs, scope and environment stay the same. Aggregate, sanitizer and parity-matrix gates run once per wave on the merged wave revision, not per task."
parallelism = "tasks in the same wave with disjoint touches run in parallel; a requires entry inside the same wave orders those two tasks only"
privacy = "Credentials, key material, operational inventories, host names and raw execution logs stay in access-controlled storage. Everything in this feature directory is public and is reviewed before publication."
path_exclusivity = "every path appears in the touches of exactly one task per wave"
citation_policy = "every do_n names the path:line it changes or reproduces; paths in the Hyperpax repository carry the prefix Hyperpax:"
decision_policy = "A task with blocked_by is written for the first option of each named decision; it is not claimed until the decision is resolved, and it is rewritten before it is claimed if the decision resolves to another option."

[req.1]
title = "perf-db meets the monorepo standard"
ac_1 = "Given services/platform/perf-db/Cargo.toml, when it is read, then every dependency requirement is an exact pin (=x.y.z), rust-version equals the root rust-toolchain.toml channel 1.91.1 instead of 1.85 (Cargo.toml:11), the repository field names no external repository (Cargo.toml:7) and the license field equals the value of decision.13 (Cargo.toml:5 today reads MIT OR Apache-2.0)."
ac_2 = "Given the crate, when cargo build --locked runs on its manifest, then it exits 0, and Cargo.lock resolves tokio, serde, serde_json and clap to the versions the platform workspace pins (services/platform/Cargo.toml:36-65) where the crate uses them."
ac_3 = "Given the crate, when cargo clippy --all-targets runs with -D warnings -D clippy::pedantic, then it exits 0; unsafe appears only in src/storage/mmap.rs (today :75 and :256), each site under a SAFETY comment and an allow(unsafe_code) on that item, and unwrap or expect outside cfg(test) is refused by a crate-level deny (today src/aggregation/candle_builder.rs:119 unwraps on the hot path)."
ac_4 = "Given services/platform/perf-db/deny.toml, when cargo deny check bans licenses sources runs, then it exits 0 with multiple-versions = deny and the license confidence threshold of the platform policy, instead of multiple-versions warn and 0.8."
ac_5 = "Given README.md and ARCHITECTURE.md of the crate, when lychee --offline runs on them, then it exits 0: the links to CONTRIBUTING.md (README.md:315), SECURITY.md (README.md:329) and LICENSE-APACHE and LICENSE-MIT (README.md:335-336) point at files that exist, the git dependency snippet (README.md:168) names the monorepo path dependency, and the durability claim (README.md:278) states the sync policy it holds under."
ac_6 = "Given the repository CI, when a change under services/platform/perf-db is pushed, then .github/workflows/perf-db.yml runs make platform-perfdb-check on vars.CI_LINUX_RUNNER with every action pinned by full commit SHA, and the nested services/platform/perf-db/.github directory (unpinned actions/checkout@v4 at .github/workflows/ci.yml:22-23, its own dependabot and review assignment files) no longer exists."

[req.2]
title = "An acknowledged write survives a crash under the declared sync policy"
ac_1 = "Given SyncPolicy::Interval(d), when entries are appended and no further append follows, then a background flusher syncs them within d; today sync happens only inside append (src/storage/wal.rs:173-182), so the last entries before an idle period stay unsynced."
ac_2 = "Given a snapshot write, when the process is killed at any point of it, then the previous snapshot stays loadable: the snapshot is written to a temporary file, fsynced, renamed and the directory fsynced, instead of fs::write to the final path (src/storage/snapshot.rs:103-133)."
ac_3 = "Given a corrupt latest snapshot, when the engine opens, then it loads the newest valid older snapshot and replays the WAL from its block, instead of failing (src/storage/snapshot.rs:136-164)."
ac_4 = "Given a snapshot, when it is taken, then it carries alerts, api keys, competitions, referrals and the event store besides the state of StateSnapshot (src/storage/snapshot.rs:18-28), and an open after a restart returns the same events for a block range as before it; today replay skips events at or below the snapshot block (src/engine.rs:866-869) and the snapshot omits them."
ac_5 = "Given a successful snapshot at block b, when it completes, then WAL segments wholly below b are removed with wal::truncate_before (src/storage/wal.rs:336) and snapshots beyond the retention count are removed with snapshot::cleanup_snapshots (src/storage/snapshot.rs:222); today neither is called by the engine."

[req.3]
title = "Every on-disk format is versioned"
ac_1 = "Given a WAL segment, a snapshot, a tick file or a candle file written by this feature, when its first bytes are read, then they hold a four-byte magic of its kind and a u16 format version."
ac_2 = "Given a file with an unknown version or a wrong magic, when the engine opens, then it refuses with PerfDbError::UnsupportedFormat naming the path, kind and version, and writes nothing."
ac_3 = "Given a data directory written by the imported revision (no headers), when the engine opens it, then the files are read as version 0 and rewritten at the current version, and a second open reads the same ticks, candles and state."

[req.4]
title = "One writer per data directory"
ac_1 = "Given an engine open on a directory, when a second PerfDb::open runs on it, then it refuses with PerfDbError::DirectoryLocked; the lock is an exclusive File::lock on <data_dir>/LOCK held for the life of the engine."
ac_2 = "Given PerfDb::open_read_only, when it opens a directory locked by a writer, then it reads ticks, candles and state from the latest snapshot and WAL without taking the lock, and every write method returns PerfDbError::ReadOnly."
ac_3 = "Given the perfdb CLI (src/main.rs:164 opens with PerfDb::open as a writer), when a query command runs against a live directory, then it opens read-only and succeeds while the writer runs."

[req.5]
title = "The engine reports metrics and health"
ac_1 = "Given an engine, when Metrics::render is called, then it returns Prometheus text exposition with perfdb_ticks_ingested_total, perfdb_events_processed_total, perfdb_wal_bytes, perfdb_wal_sync_seconds, perfdb_snapshot_seconds, perfdb_snapshot_last_block and perfdb_last_block, each moving when the matching operation runs."
ac_2 = "Given the engine, when a WAL sync or a snapshot fails, then perfdb_wal_sync_failures_total or perfdb_snapshot_failures_total increases and the error is returned to the caller, not logged and dropped."

[req.6]
title = "A live engine can be backed up and restored"
ac_1 = "Given a running writer, when perfdb backup <dest> runs, then dest holds a snapshot and the WAL segments above it that open to the same state as the source at the backup block."
ac_2 = "Given a backup, when perfdb restore <backup> <data_dir> runs on an empty or absent data_dir, then an engine opened there returns the same ticks, candles, positions and leaderboard as the source at the backup block; restore refuses a non-empty data_dir."

[req.7]
title = "Markets are data, not a constant"
ac_1 = "Given the market table of the perps data services (services/platform/perps-data/migrations/0005_markets_seed.sql), when a market beyond the eighteen of src/core/market.rs:5 and :16-35 is registered, then the engine accepts its ticks and builds its candles; today candle_builder drops market ids at or above 18 (src/aggregation/candle_builder.rs:100-102) and the engine seeds state by MARKET_COUNT (src/engine.rs:200, :681)."
ac_2 = "Given a tick for an unregistered market id, when it is ingested, then ingest_tick returns PerfDbError::UnknownMarket instead of dropping it silently."

[req.8]
title = "A Rust sidecar embeds perf-db and serves a small HTTP surface"
ac_1 = "Given the perfdb-sidecar binary, when it starts with PERFDB_DATA_DIR, PERFDB_LISTEN, PERFDB_READ_TOKEN and PERFDB_ADMIN_TOKEN set, then it opens the engine as the single writer and listens; it refuses to start when a token is shorter than 32 bytes or PERFDB_LISTEN is not a socket address."
ac_2 = "Given a request to /v1/* without Authorization: Bearer <PERFDB_READ_TOKEN>, or to /v1/admin/* without the admin token, then it answers 401 with no body read beyond the headers."
ac_3 = "Given GET /healthz, then it answers 200 with last_block and lag_ms when the last ingested block is younger than PERFDB_MAX_LAG_MS and 503 otherwise; GET /metrics answers Metrics::render."
ac_4 = "Given the deploy manifests, when services.json is read, then it lists the sidecar as a service with its image, its volume for PERFDB_DATA_DIR and its NATS user, deploy/services_test.go:84 expects it in the fixed service order, and services_test.go:155 still requires at least two gateway replicas."
ac_5 = "Given deploy/nats/nats.conf, when the sidecar user is read, then it may subscribe perps.> and publish only $JS.API.CONSUMER.> and $JS.ACK.PERPS_V1.>, and the perps-gateway and perps-indexer permissions (nats.conf:24-40) are unchanged."

[req.9]
title = "Candles and ticks are built from the venue's own prices"
ac_1 = "Given a perps.<chain>.<market>.index message whose payload is an IndexPriceRow (services/platform/perps-data/internal/decode/pricefeed.go:196-205), when the sidecar ingests it, then one PriceTick of the source of decision.6 at TimestampMs and block height is ingested, with the 18-decimal string parsed into the representation of decision.2 without loss."
ac_2 = "Given a perps.<chain>.<market>.fill message, when it is ingested, then its size adds to the volume of every open bucket of that market; today volume from ticks is always 0."
ac_3 = "Given a bucket whose end time has passed by wall clock, when no new tick arrives, then close_due closes it and publishes the closed frame within one second; today a bucket closes only on the next tick (src/aggregation/candle_builder.rs:111-127)."
ac_4 = "Given a perps.<chain>.chain.rewind message carrying fork height h, when it is ingested, then every tick and candle contribution at or above h is removed and the affected buckets are rebuilt from the remaining ticks, so a read after the rewind never mixes two branches."
ac_5 = "Given the backfill command, when it runs against the PostgreSQL facts from a start height, then it posts ticks and fills to /v1/admin/ingest in block order and the candles of every timeframe equal those a live ingestion of the same messages produces; JetStream retention is 72 hours, so history older than that comes only from backfill."
ac_6 = "Given GET /v1/candles?market=<id>&tf=<tf>&from=<s>&to=<s>&limit=<n>, then it returns the candles of that range in ascending time as [time, open, high, low, close, volume, closed] tuples with time in unix seconds and closed 0 or 1 (Hyperpax:src/hooks/perps/useSidPaxMarketStream.ts:143-157), and GET /v1/candles/stream streams the same tuples as NDJSON, one per update."

[req.10]
title = "The gateway serves UDF and kline routes from the sidecar only when PERPS_PERFDB_URL is set"
ac_1 = "Given PERPS_PERFDB_URL unset, when TestSymbolREST, TestFeeds, TestMigrate and TestSchemaFiles run, then the subtests no_udf_<route> (internal/rest/symbol_test.go:629-638), no_kline_topic (internal/feeds/feeds_test.go:749-760) and no_candle_table (internal/store/migrate_test.go:696-713, migrations/schema_test.go:741) pass unchanged."
ac_2 = "Given PERPS_PERFDB_URL and PERPS_PERFDB_TOKEN set, when /api/<sym>/history?resolution=<r>&from=<s>&to=<s> is requested, then the gateway answers the UDF shape {s, t, o, h, l, c, v} from /v1/candles, or {s: no_data, nextTime} when the range is empty, for the resolutions 1, 2, 3, 5, 15, 30, 60, 240, 480, 1D and 1W."
ac_3 = "Given the flag set, when config, symbols, search, time, quotes, marks and timescale_marks are requested, then each answers the UDF shape the candle proxy forwards (Hyperpax:src/pages/api/candle/[...path].ts:10), marks and timescale_marks as empty arrays."
ac_4 = "Given the flag set, when a client subscribes <SYM>@kline_<interval> for an interval of feeds_test.go:752, then it receives a snapshot of the live bucket and one frame per update in the Chainflow kline tuple, and an unknown interval still answers unknown_topic."
ac_5 = "Given the flag set and the sidecar unreachable, when a UDF route is requested, then the gateway answers 503 with error perfdb_unavailable and its /health reports the sidecar as down; it never falls back to an empty 200."
ac_6 = "Given PERPS_PERFDB_URL set without PERPS_PERFDB_TOKEN, or with a scheme other than http or https, then config.Load refuses it, and Config.String prints the token as redacted (internal/config/config.go:31-40)."

[req.11]
title = "Hot state follows the Paxeer X perps events"
ac_1 = "Given every event of the Paxeer X perps decoding table (contracts/data-services.md section 6 of the release spec, thirty events), when it is delivered, then the sidecar adapter maps it to an engine event or records it as ignored by name; an event name outside the table increases perfdb_events_unknown_total and is not dropped silently. The engine Event enum (src/core/types.rs:184) carries seventeen variants today."
ac_2 = "Given orders placed, filled, amended and cancelled, when the book of a market is read, then it equals the release book (contracts/data-services.md section 10; services/platform/perps-data/internal/feeds/book.go:80-81): remaining_size_usd of active orders aggregated at limit_price per side; today the engine keys orders by trigger_price with id lists only (src/state/orders.rs:17-19, :145)."
ac_3 = "Given position and margin events, when positions of an account are read, then size, entry price, margin, realized PnL and funding equal the PostgreSQL projection for the same events (services/platform/perps-data/internal/store/projections.go:61)."
ac_4 = "Given a state change, when it is applied, then one pub/sub frame is published on the matching channel (Prices, Positions, Orders, Trades, Liquidations, Funding, Balances) after the state is visible to a read."

[req.12]
title = "Leaderboard and stats match the release rules"
ac_1 = "Given trader stats, when the leaderboard is built, then it ranks by realized_pnl, breaks ties by the lower account bytes and serves the windows all, 30d and 7d (contracts/data-services.md section 18; services/platform/perps-data/internal/pnl/pnl.go:431-479); today it sorts by total_pnl with no tie rule and no windows (src/aggregation/leaderboard.rs:119-125)."
ac_2 = "Given more traders than max_entries (500 by default), when a rank of a trader below the cut is requested, then the engine returns the exact rank, not None."
ac_3 = "Given fills, when user and market stats are read, then volume, trade count, fees and open interest equal projectStats and projectMarketStats (services/platform/perps-data/internal/store/projections.go:517, :553) for the same facts."

[req.13]
title = "A PostgreSQL path is retired only after a recorded parity pass"
ac_1 = "Given the perps-parity command, when it runs for a family (candles, book, positions, stats, leaderboard) over a block range, then it compares the PostgreSQL answer and the sidecar answer row by row and exits 0 only when they are equal, printing the first difference otherwise; its tests fail, never skip, when PERPS_DATA_TEST_DATABASE_URL or PERPS_DATA_TEST_PERFDB_URL is unset."
ac_2 = "Given PERPS_PERFDB_FAMILIES, when the gateway starts, then every listed family is read from the sidecar and every other family from PostgreSQL; the default is candles when PERPS_PERFDB_URL is set and empty otherwise, and an unknown family name is refused."
ac_3 = "Given a family listed in PERPS_INDEXER_RETIRED, when the indexer runs, then it stops writing that family's projection tables and keeps writing every fact table."
ac_4 = "Given a retired family, when the rollback command runs, then store.Rebuild re-projects its tables from the facts and the parity command for that family exits 0 against the sidecar."
ac_5 = "Given the retirement migration of a family, when it applies, then its projection tables are dropped only for the families of decision.10, and the tests that pinned those tables are updated in the same task without weakening any other assertion."

[req.14]
title = "Open decisions are recorded with options and costs"
ac_1 = "Given this spec, when it is read, then every choice that changes a public format, a dependency or the release contract is a [decision.N] block with status open, its options and their costs, and every task that depends on it names it in blocked_by."

[capability.0.1]
title = "Exact-pinned manifest at the monorepo toolchain"
reqs = ["1.1", "1.2"]
touches = ["services/platform/perf-db/Cargo.toml", "services/platform/perf-db/Cargo.lock", "services/platform/perf-db/tests/manifest.rs"]
tests = ["services/platform/perf-db/tests/manifest.rs"]
verification_contract = "cargo test --locked --manifest-path services/platform/perf-db/Cargo.toml --test manifest"

[capability.0.2]
title = "Clippy pedantic clean with unsafe confined to the mmap module"
reqs = ["1.3"]
touches = ["services/platform/perf-db/src", "services/platform/perf-db/tests/integration.rs", "services/platform/perf-db/tests/recovery.rs", "services/platform/perf-db/benches"]
tests = ["services/platform/perf-db/tests/integration.rs", "services/platform/perf-db/tests/recovery.rs"]
verification_contract = "cargo clippy --locked --manifest-path services/platform/perf-db/Cargo.toml --all-targets -- -D warnings -D clippy::pedantic"

[capability.0.3]
title = "Dependency policy aligned with the platform"
reqs = ["1.4"]
touches = ["services/platform/perf-db/deny.toml"]
tests = []
verification_contract = "cargo deny --manifest-path services/platform/perf-db/Cargo.toml check bans licenses sources"

[capability.0.4]
title = "Crate documentation with working links"
reqs = ["1.5"]
touches = ["services/platform/perf-db/README.md", "services/platform/perf-db/ARCHITECTURE.md"]
tests = []
verification_contract = "lychee --offline --no-progress services/platform/perf-db/README.md services/platform/perf-db/ARCHITECTURE.md"

[capability.0.5]
title = "perf-db in the monorepo CI"
