tests = ["services/platform/perf-db/tests/candle_path.rs"]
verification_contract = "cargo test --locked --manifest-path services/platform/perf-db/Cargo.toml --test candle_path"

[capability.2.2]
title = "perfdb-sidecar crate with the HTTP surface and JetStream ingestion"
reqs = ["8.1", "8.2", "8.3", "9.1", "9.6"]
