[decision.1]
title = "Workspace membership of perf-db"
status = "open"
option_1 = "Standalone manifest with its own lockfile and an empty [workspace] (services/platform/perf-db/Cargo.toml:76), wired into make as the examples/marketplace manifest is. Cost: a second lockfile to keep in step with the platform pins; the platform [lints] table (services/platform/Cargo.toml:66-75) is not inherited."
option_2 = "Member of the platform workspace (services/platform/Cargo.toml:2-27). Cost: inherits the float_arithmetic deny and the Rust 2021 edition of the workspace (Cargo.toml:31) against the 2024 edition of the crate (perf-db Cargo.toml:4), so decision.2 must land first and one of the editions changes; one lockfile."
option_3 = "Own perf-db workspace holding the engine and the sidecar. Cost: the same as option one plus a workspace manifest; keeps the sidecar's async-nats tree out of the platform lock."
affects = ["task.0.1", "task.2.2"]

[decision.2]
title = "Price representation in the engine"
status = "open"
option_1 = "Keep f64 (src/core/types.rs:11, :22-25). Cost: 18-decimal prices lose precision above 2^53 units, parity against the PostgreSQL decimal strings fails on exact compare, float_arithmetic cannot be denied."
option_2 = "i128 18-decimal fixed point. Cost: WAL, snapshot and candle record format bump (the headers of tasks 1.2 to 1.4 absorb it), doubled record size, every aggregation rewritten in integer arithmetic."
option_3 = "u64 scaled to a per-market tick size. Cost: needs a per-market scale in the registry and refuses prices beyond the scale; smaller records."
affects = ["task.2.1", "task.3.1", "task.4.1"]

[decision.3]
title = "Ingestion source of the sidecar"
status = "open"
option_1 = "Durable JetStream consumer on PERPS_V1. Cost: adds async-nats to the Rust tree and a NATS user; 72 hour retention means history older than that comes only from the backfill of task 2.7."
option_2 = "Read the chain directly. Cost: duplicates the decoders and the rewind logic of the indexer in Rust and adds a second follower against the nodes."
option_3 = "Poll PostgreSQL. Cost: adds a PostgreSQL client to the sidecar, polling latency, and ties the hot path to the store it is meant to relieve."
affects = ["task.2.2", "task.2.6", "task.3.3"]

[decision.4]
title = "Gateway to sidecar transport"
status = "open"
option_1 = "HTTP/1.1 JSON and NDJSON streams on a std TcpListener. Cost: hand-written request parsing; no new dependency; matches the platform hosted services."
option_2 = "gRPC. Cost: tonic and prost in the Rust tree and code generation in Go against the pinned grpc replace (go.mod:105, :300)."
option_3 = "Sidecar publishes candles and state to NATS subjects the gateway already reads. Cost: candle history still needs a request path, and the sidecar user needs publish rights on perps subjects."
affects = ["task.2.2", "task.2.3"]

[decision.5]
title = "Application cutover of chart history"
status = "open"
option_1 = "Point the server variable MARKET_PROXY_HOST of the candle proxy (Hyperpax:src/pages/api/candle/[...path].ts:5) at the gateway. Cost: none in application code; only UDF history moves."
option_2 = "Point NEXT_PUBLIC_MARKET_PROXY_HOST (Hyperpax:src/core/feeds.ts:2) at the gateway. Cost: every Chainflow surface the application reads through FEED_ORIGIN (Hyperpax:src/core/feeds.ts:8-14) must then be served by the gateway, including klines, tickers and depth."
option_3 = "Change the application to read the gateway routes directly. Cost: an application release; the application is not unchanged."
affects = ["task.2.4"]

[decision.6]
title = "Candle price source and history horizon"
status = "open"
option_1 = "Index price of perps.index_prices with volume from fills, backfilled from the start of the venue. Cost: the full backfill time on first start."
option_2 = "Mark price (services/platform/perps-data/internal/decode/perps.go:478). Cost: candles follow the funding basis, not the index the application charts today."
option_3 = "Fill prices only. Cost: empty buckets on illiquid markets."
affects = ["task.2.1", "task.2.2", "task.2.7"]

[decision.7]
title = "Release contract for UDF and kline routes"
status = "open"
option_1 = "Add a flag-conditional clause to the data services contract: the routes exist only when PERPS_PERFDB_URL is set, and the release negative tests run with it unset. Cost: two behaviours of one binary to document and test."
option_2 = "Revise the contract to serve the routes always and change the negative tests. Cost: removes the release tests and makes the sidecar a hard dependency of the gateway."
affects = ["task.2.4", "task.2.5"]

[decision.8]
title = "Default WAL sync policy"
status = "open"
option_1 = "Interval of 10 ms with the background flusher (src/storage/wal.rs:87). Cost: up to 10 ms of acknowledged writes lost on power failure; JetStream redelivers unacknowledged messages, so the sidecar acknowledges only after a sync."
option_2 = "EveryWrite. Cost: one fsync per entry on the ingest path."
affects = ["task.1.2"]

[decision.9]
title = "Use of the relational stores"
status = "open"
option_1 = "Keep users, referrals, alerts, api keys and competitions in PostgreSQL; the relational stores of the crate are unused by the sidecar. Cost: unused code kept in the crate."
option_2 = "Move them to perf-db. Cost: key material (src/relational/api_keys.rs:8 key_hash) in a store with no auth layer and no backup policy beyond task 1.6."
affects = ["task.3.3"]

[decision.10]
title = "Retirement scope"
status = "open"
option_1 = "Retire projection tables only; facts stay in PostgreSQL as the source for backfill, parity and rollback. Cost: two stores remain."
option_2 = "Remove PostgreSQL from the perps data services. Cost: no source for backfill, parity or rollback; the indexer and its tests are rewritten."
affects = ["task.4.3", "task.4.4"]

[decision.11]
title = "Sidecar topology"
status = "open"
option_1 = "One sidecar per gateway replica, each with its own volume and durable consumer. Cost: N copies of the state and N consumers; no cross-replica dependency."
option_2 = "One shared sidecar. Cost: a single point of failure for every gateway replica, against the replica floor of deploy/services_test.go:155."
affects = ["task.2.2", "task.2.6"]

[decision.12]
title = "WAL and snapshot encoding"
status = "open"
option_1 = "Keep bincode 1 behind the version headers and ignore its unmaintained advisory. Cost: an ignored advisory in deny.toml."
option_2 = "postcard. Cost: one-time v0 migration of every snapshot and WAL segment."
option_3 = "bincode 2. Cost: incompatible wire format, the same migration as option two."
option_4 = "Hand-rolled encoding. Cost: encoder and decoder code with its own tests."
affects = ["task.1.2", "task.1.3", "task.1.7"]

[decision.13]
title = "Crate license"
status = "open"
option_1 = "Apache-2.0, the repository license, with the README pointing at the root LICENSE. Cost: changes the imported dual license."
option_2 = "Keep MIT OR Apache-2.0 (services/platform/perf-db/Cargo.toml:5) and add LICENSE-APACHE and LICENSE-MIT to the crate. Cost: two license files and an allow entry for the dual expression."
affects = ["task.0.1", "task.0.4"]
