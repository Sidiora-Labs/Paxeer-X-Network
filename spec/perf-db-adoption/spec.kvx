touches = ["services/platform/perf-db/src/error.rs", "services/platform/perf-db/src/metrics.rs", "services/platform/perf-db/src/lib.rs", "services/platform/perf-db/tests/metrics.rs"]
tests = ["services/platform/perf-db/tests/metrics.rs"]
verification_contract = "cargo test --locked --manifest-path services/platform/perf-db/Cargo.toml --test metrics"

[capability.1.2]
