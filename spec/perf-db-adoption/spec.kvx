touches = ["services/platform/perf-db/src/storage/snapshot.rs", "services/platform/perf-db/src/storage/event_store.rs", "services/platform/perf-db/src/relational/referrals.rs", "services/platform/perf-db/src/relational/checkpoint.rs", "services/platform/perf-db/tests/snapshot_format.rs"]
