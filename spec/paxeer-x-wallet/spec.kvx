# spec.kvx - Paxeer X Network wallet. SINGLE SOURCE OF TRUTH for this feature.
#
# requirements.md / design.md / tasks.md next to this file are GENERATED from it
# by spec/specgen. Never hand-edit those; edit this file and regenerate.
#
# Drive the work with:  cg spec next -> cg spec start <id> -> cg spec done <id>
#
# One body of work with one bar: the hosted embedded wallet that people already
# use through their email or a social login keeps every user and every address,
# stops holding any key in one place, and becomes the first client of the
# unified account and the shared endpoint that serve the Paxeer X chain and the
# LayerX kernel as one network. Wave 1 builds the parts. Wave 2 assembles them.
# Wave 3 integrates them against real daemons. Wave 4 completes the app and the
# operations record. Wave 5 runs the merged gate and the rehearsal once.

[meta]
feature   = "paxeer-x-wallet"
title     = "Paxeer X Network Wallet - Embedded Custody on Sharded Keys and the Unified Account"
kind      = "product-feature-specification"
version   = "0.1.0"
status    = "active"
language  = "Go (the attestor daemon and the ceremony tool), TypeScript (the wallet gateway on Fastify, the wallet SDK, the Next.js and Capacitor wallet app), Rust (the human service custody adapter, identity acceptance and intent execution under human/crates, the hosted endpoint under platform/hosted/gateway), POSIX shell gates, deployment definitions"
repo_root = "human/wallet/ (attestor, ceremony, gateway, sdk, demo, schema, deploy, docs); human/apps/wallet (the app); human/crates/layerx-human-kms, layerx-human-identity-provider and layerx-human-service (the kernel-side custody plane); platform/hosted/gateway (the shared endpoint); tools/wallet/ (the gates); spec/paxeer-x-wallet/ (this feature and its qualification log)"
upstream  = "getamis/alice (Apache-2.0) supplies threshold ECDSA (CGGMP) on secp256k1 and FROST on Ed25519 and is consumed as an unmodified Go module dependency; the existing embedded-wallet API and SDK are imported from their current deployment as the starting revision and keep their public routes; Supabase Auth remains the identity provider; spec/layerx-platform and spec/layerx-beta remain binding for the human control plane and the beta contract, and where this feature departs from them the departure is recorded in [decision] and nothing else is relaxed"
intro     = "The most used service of Paxeer X Network is its hosted embedded wallet: a person signs in with an email link or a Google, Apple, X, GitHub or Discord account and receives an EVM address on chain 125 without a seed phrase, and agents receive wallets bound to their Ed25519 identities. Today that service holds every private key encrypted under one master key inside one process on one host, has no second copy of anything, knows nothing about the LayerX kernel, and the mobile app around it carries a second self-custody vault, a same-origin dapp proxy and an in-app browser that duplicate what MetaMask already does better. This feature turns the embedded wallet into the network's account layer. Every wallet becomes two threshold keys held by five attestor nodes in five regions with a three-of-five quorum: a secp256k1 key for the EVM address it already has, and an Ed25519 key that is its LayerX identity, did:layerx followed by the public key, bound one-to-one to the address through the addr precompile. No process ever reassembles a key; there is no export route. Each attestor verifies the signed-in user's token itself, decodes the transaction, typed data or kernel activity itself, and applies the account's policy itself, so the gateway that fronts them holds no key and cannot sign alone. The existing gateway keeps its public routes and its Supabase-backed user-to-wallet plane, loses the managed funded lane and the treasury, and gains the unified account: on provisioning it creates both keys, funds and sends the binding, and answers with the address, the DID and the main account id. A one-time ceremony moves every existing key into shares by dealer split, validated against the original public key on every node, rehearsed against a restored copy until every address matches, and only then run live. The wallet SDK becomes an EIP-1193 provider that dapps, wagmi and the network's own web journeys use unchanged, with paxeer_signCustody for custody hand-offs, typed modules for the exchange, bridge, launchpad, fee token and web data precompiles, and clients for the shared endpoint's px_ joins, the kernel's lx_ reads and the human service's intent plan and submit. The app keeps only embedded custody and MetaMask, and reads and writes through the shared endpoint so one login shows one account, one asset list, one history and one status ladder across both networks. Where the kernel is not yet anchored on the chain, the wallet says so and refuses to invent state."

# Decisions locked before implementation begins. They bind every task in this
# feature; where they touch the human control plane or the beta contract they
# defer to spec/layerx-beta, which stays normative, except where a line below
# names the departure.
[decision]
code_quality        = "A+ on every changed path: real code paths, real types, real fixtures. No stub, mock or fake test double on a production path, no placeholder implementation, no TODO, FIXME or 'for now' comment, no dead branch left behind to be cleaned up later. A test exercises the module it names through its public interface with data shaped like production data; a test that would need a fake to pass is a signal that the implementation is wrong, not that the test needs a double. Cross-language integration tests spawn the real daemon or the real service they integrate with."
no_weakening        = "Inherited from workflow.kvx and restated because this feature moves user keys: no assertion is relaxed, no bound loosened, no type widened, no silent fallback added, no test skipped, deleted or marked pending, no lint rule disabled on a file this feature owns, and no continue-on-error added to a workflow. Where the code and a check disagree, both stay exactly as written and the conflict is recorded in spec/paxeer-x-wallet/qualification.kvx."
test_ratio          = "One to one. Every task's touches list names its test files explicitly, and every production file a task changes is accompanied by a test file that changes or is added in the same task and that exercises it: a Go *_test.go in the same package, a TypeScript *.test.ts or *.test.tsx beside the source or under a tests directory the package already uses, a Rust #[cfg(test)] module or tests/ file. Shell scripts have their own test scripts. Deployment definitions, schema files, environment examples and Markdown need no test file."
testing_allowance   = "Testing time is bounded on purpose. Every task's verify_cmd is one command wrapped in `timeout 20m`, run from the repository root. A task gets one build of its declared targets and one verify_cmd run, then at most two task-scoped repair cycles, each followed by exactly one rerun. Aggregate suites, the lint matrix and the live rehearsal run once, in wave 5, never per task and never per rebase. A task whose verify_cmd exceeds its timeout stops and reports implemented-not-qualified with the exact command, exit code and log path; that is an acceptable outcome and is never dressed up as a pass."
naming              = "The product is Paxeer X Network. LayerX names the kernel domain only. The wallet is the Paxeer X wallet; its packages carry the paxeer scope the imported code already uses. The coin is Paxeer, symbol PAX, 18 decimals; the second coin is Sidiora, symbol SID, 6 decimals. No file, comment, commit message or log line introduced by this feature carries a date, a hostname, an IP address, a port of an internal host, an internal URL, a person's name, or the name of an agent or a working branch."
generated_files     = "CLAUDE.md, AGENTS.md, .github/copilot-instructions.md, .codify/agent-context.md and the requirements.md, design.md and tasks.md mirrors under spec/*/ are generated and off limits: edit spec/workflow.kvx or this file and regenerate."
production_safety   = "No task reads, writes or commits a .env file, a key, a share, a token or any secret; credentials enter through environment variable names and secret file paths documented in human/wallet/deploy/env and set on the platform out of band. The current wallet host is read only for every task: the source import copies code, never configuration. The live migration ceremony, the DNS cutover of the wallet endpoint, the destruction of the old master key and the shutdown of the old service are operator steps that run only on explicit owner approval and are not tasks in this feature; the ceremony tool and the rehearsal are."
custody_model       = "Every wallet is two threshold keys, a secp256k1 key for its EVM address and an Ed25519 key for its LayerX identity, each shared three-of-five across five attestor nodes (library threshold parameter two). No node, gateway, database or backup ever holds a whole key or enough shares to make one; keygen is distributed, import is a dealer split validated against the original public key on every node, and the dealer's memory is the only place a whole key exists during the ceremony. There is no route that exports, reveals or reconstructs a key. Self-custody is MetaMask or another injected wallet through the same SDK interface."
attestor_authority  = "An attestor signs only what it has verified itself: the signed-in user's Supabase token against the project's JWKS with issuer, audience, expiry and subject checks, or an agent's Ed25519 request signature against the agent's registered key; the full transaction, typed data, message or kernel activity decoded from bytes it received, never a bare digest it cannot recompute; and the account's policy, versioned and evaluated locally. The gateway relays sessions and never sees a share. A compromised gateway can deny service and cannot sign."
unified_account     = "The Ed25519 key is an independent FROST key generated by the attestors; it is never derived from the EVM key, because threshold ECDSA signatures are not deterministic and the documented derivation from an EIP-712 signature cannot be recomputed under sharing. The DID is did:layerx followed by the 64 lowercase hex characters of the public key; the main account is agent:<did>:main and its id is the chain's DeriveAccountID. The binding is the addr precompile's bindLayerX, sent from the wallet's EVM address with the Ed25519 signature over the LX:PAXEER-BIND:v1 message, strictly one-to-one; the gateway refuses to provision an account that is not bound or whose binding names another DID. Existing wallets are bound by a backfill that runs after the ceremony."
account_setup_gas   = "The binding transaction is paid by a setup top-up: the gateway's sponsor account sends the exact gas the binding needs to the new address before the binding, capped by configuration, recorded in the audit table, and never repeated for an address that is already bound. No user is asked to hold PAX to exist."
identity_plane      = "Supabase Auth stays the application identity plane: the providers already configured, the user id as the owner key of every wallet row, and Supabase account recovery as recovery. Step-up for designated operations is a fresh second factor bound to the operation digest, WebAuthn where the project offers it and time-based codes otherwise; this feature records that social sign-in replaces the passkey-first credential of spec/layerx-platform req.3.ac_1 for wallets provisioned here, and changes nothing else in that plane."
agents              = "Agents keep their own Ed25519 keys; an agent's DID is did:layerx of that key, and its EVM wallet is bound to it by the same precompile with the agent's own signature. Every agent request that can move value is signed end to end by the agent's key over a canonical request digest with a nonce and an expiry, verified by the attestors against their replica of the registered principals; the gateway-minted agent token authorises reads only. A human claims an agent through an authenticated route; nothing binds an owner from a label."
funded_lane         = "The managed funded lane is removed: routes, treasury evaluator, tier tables and the fund and sweep paths that bypass caps. The funded wallets are not migrated; the ceremony tool re-encrypts their rows into an archive under a fresh operator-held passphrase, out of the live path, and the live tables drop them after the archive is verified."
shared_router       = "The wallet's only RPC base is the hosted endpoint: eth_ methods for the chain, lx_ methods for the kernel, px_ joins for identity, balances, assets, capabilities and unified history. Balances of assets outside the custody map come from eth_ calls through the same base. Per-transaction status comes from the explorer's status endpoint. The user interface speaks one ladder, instant, sealed and final, and every other vocabulary is mapped to it at the edge."
kernel_dependency   = "The kernel side of the network is not yet anchored on the chain. Every LayerX-side operation in this feature - kernel account activation, custody credit, kernel sends, 402 draws, intent submission - is built and tested against the real services in process, and at run time is offered only when the endpoint reports the kernel reachable and the anchor precompile reports a finalised checkpoint; otherwise the wallet shows the kernel as unavailable with the reason. The binding, the identity and every chain-side operation work today."
attestor_topology   = "Five attestor applications, one machine each, in five regions on at least two continents, each with its own volume, its own node key, its own secrets and its own encrypted backup to object storage; peer traffic over mutual TLS inside the private network; the import endpoint enabled only during a ceremony window; refresh of every share on a fixed cadence and on any suspected compromise; a lost node is replaced by add-share followed by refresh, proven by test before any node exists."
attestor_api        = "One versioned JSON contract over mutual TLS, recorded in human/wallet/schema/attestor-api/v1.kvx with golden vectors: keys.generate (key id, curve, participants), keys.import (operator only, per node share and public key), keys.refresh, keys.addshare, sign (key id, request kind and bytes, context, authorisation, participants, session id), health. A sign request carries one of evm_tx, eip712, personal_message, eth_sign_digest, lx_activity, lx_bind or lx_grant; eth_sign_digest is accepted only for the sponsored batch and EIP-7702 authorisation constructions and only when the attestor recomputes the digest from the supplied fields. The gateway posts the same request to every participant; participants run the session over the peer transport; the response carries the signature, the recovery id where the curve has one, and the audit sequence."
migration_invariant = "Every existing standard and agent wallet keeps its address. The rehearsal against a restored copy must import, refresh, test-sign and recover every address before the live ceremony is scheduled; a single mismatch stops the rehearsal and is recorded, never worked around."
publication         = "A qualified task is published immediately: one commit per task from the repository root describing the change honestly and naming the gates that actually ran, landed on the feature branch and merged to main by the integrator before the next wave starts. Several tasks are never batched into one commit and a finished task is never left unmerged."

[design]
overview = "Five waves. Wave 1 builds sixteen parts with disjoint paths so they run in parallel: the attestor's share store, its secp256k1 and Ed25519 signing wrappers, its dealer import and refresh, its peer transport, its chain-side and kernel-side decoders and policy, its authentication and audit; the import of the gateway, SDK and demo into human/wallet as one workspace and of the app into human/apps/wallet with every secret scrubbed; the gates under tools/wallet; the deployment definitions; and three kernel-side repairs the wallet depends on - the identity provider accepting the wallet's identity assertion, the human service executing a submitted plan instead of echoing it, and the hosted endpoint degrading honestly when the kernel is unreachable. Wave 2 assembles: the attestor daemon with its API and a five-node in-process end-to-end test; the gateway's keyless signing core, nonce store and RPC pool; the removal of the funded lane and the agent consent repair; the SDK provider and its Paxeer X and LayerX modules; the ceremony tool; the app's removal of every non-embedded surface; and the kernel-side signing policy. Wave 3 integrates against real processes: unified account provisioning, gateway-to-attestor tests that spawn the daemon, the rehearsal pipeline, the human service's attestor-backed custody, the attestor network and the hosted endpoint deployed, the app on the SDK provider, and the agent lane helpers. Wave 4 completes: the gateway deployed in shadow beside the old service with a fresh end-to-end account on the chain, the app's unified account and Paxeer X surfaces, release engineering, the human service end to end, runbooks and the operator checklist, the load test and the security review. Wave 5 runs the merged gate and the rehearsal against the restored copy once each and records what ran. The attestor API contract in [decision] attestor_api is fixed before wave 1 so the Go daemon, the TypeScript gateway and the Rust custody adapter code to the same shapes; wave 2 writes the schema file and golden vectors from the implementation and every later client test decodes those vectors."

[tasks]
heading = "Implementation Plan: Paxeer X Network Wallet"

# --------------------------------------------------------------------------
# REQUIREMENTS
# --------------------------------------------------------------------------

[req.1]
title = "Threshold Custody Daemon"
story = "As the operator of the embedded wallet, I want every wallet key held as threshold shares across independent nodes, so that no host, process, database or backup can sign or leak a key on its own."
ac_1 = "THE attestor daemon under human/wallet/attestor SHALL generate secp256k1 keys by distributed key generation across five participants with threshold three (library threshold parameter two) using the CGGMP implementation of the vendored library, SHALL produce Ethereum signatures with low s and a recovery id, and a test SHALL recover the signing address from a signature over a real EIP-1559 transaction digest produced by five in-process participants."
ac_2 = "THE daemon SHALL generate Ed25519 keys by distributed key generation and sign with FROST, and every signature SHALL verify under the standard library's Ed25519 verifier and under the chain's strict verifier in layerxproof/verify with the same public key, proven by a test that signs the LX:PAXEER-BIND:v1 message and a receipt-domain digest."
ac_3 = "THE daemon SHALL import an existing key by dealer split: given a whole key held only in the dealer's memory, five shares SHALL be derived, each node SHALL validate its share against the original public key during the refresh that follows, and the refreshed shares SHALL sign a message whose signature recovers the original address; a share that does not match the public key SHALL be refused by every node."
ac_4 = "THE daemon SHALL refresh all shares of a key without changing the public key, for both curves, and SHALL add a share for a new participant followed by a refresh, proven by a test that removes one participant, adds a replacement and signs with a quorum that includes the replacement."
ac_5 = "THE share store SHALL encrypt every share at rest under a per-node key supplied by file path or environment variable name, with the key id, curve, public key, refresh epoch and participant set as authenticated associated data, SHALL refuse to start when the node key is absent, and SHALL never log, return or serialise a share."
ac_6 = "THE peer transport SHALL carry protocol messages between participants over mutual TLS with per-session ordering and replay refusal, SHALL bind every message to its session id and round, and a test SHALL run a full signing session across five participants on distinct listeners with certificates generated in the test."
ac_7 = "THE daemon SHALL expose keys.generate, keys.import, keys.refresh, keys.addshare, sign and health exactly as [decision] attestor_api describes, SHALL enable keys.import only when a ceremony flag is set at start and only for the operator identity, and SHALL record every request in a hash-chained audit log whose head is served by health."
ac_8 = "A five-node in-process end-to-end test SHALL import a known secp256k1 key and a known Ed25519 key, refresh both, sign an EVM transaction, a typed-data digest, a binding message and an activity envelope, verify each signature, and assert the audit chain of every node covers every request."

[req.2]
title = "Policy-Bound Signing and Authentication"
story = "As a person whose wallet is held for them, I want every signature to be gated by my own login and by rules the signers apply themselves, so that neither a stolen gateway nor a stolen token alone can move my funds."
ac_1 = "EACH attestor SHALL verify a Supabase access token against the project's JWKS with issuer, audience, expiry, not-before and subject checks, SHALL cache and rotate keys by key id, SHALL refuse a token whose subject does not own the key id being signed for, and SHALL refuse to sign when the JWKS cannot be fetched and no cached key matches."
ac_2 = "EACH attestor SHALL verify an agent request by the agent's Ed25519 signature over a canonical digest of method, key id, request bytes, nonce and expiry, against the agent's registered public key replicated to the node, SHALL refuse a replayed nonce and an expired request, and SHALL refuse a request whose principal is frozen."
ac_3 = "EACH attestor SHALL decode an EVM transaction of legacy, access-list, dynamic-fee and set-code type from its bytes, SHALL pin the chain id to the configured chain, SHALL decode calldata to the network's precompiles with the ABI files under precompiles/, and SHALL evaluate per-account policy locally: per-transaction and rolling value caps per asset, request rate, destination and selector rules, and refusal of any transaction whose fields it cannot decode."
ac_4 = "EACH attestor SHALL hash EIP-712 typed data itself from the supplied domain, types and message, SHALL accept a personal message only with the EIP-191 prefix applied by the attestor, and SHALL accept a bare digest only for the sponsored batch construction and the EIP-7702 authorisation construction, recomputed from the supplied fields, and for nothing else."
ac_5 = "EACH attestor SHALL decode a kernel activity envelope from its canonical bytes, SHALL match it against the human service's disclosure fields supplied with the request, SHALL enforce allowed modules, operations, amounts and destinations per account, SHALL accept a binding message only for the account's own address and current nonce, and SHALL accept a 402 grant or receive preimage only within the account's caps."
ac_6 = "THE policy SHALL be versioned per account with a default set in configuration, SHALL be evaluated identically by every node from the same inputs, and SHALL fail closed: an unknown request kind, an unknown policy version, a missing field or a decode error refuses the request with a typed reason that is logged and returned."
ac_7 = "THE decoders SHALL be validated against the repository's golden vectors: the agent API goldens under agent/schema/agent-api/golden for activity envelopes and the binding vectors under layerxproof/testvectors and layerxproof/testdata for the binding message, and a vector the decoder cannot round-trip SHALL fail the test."

[req.3]
title = "Attestor Network Operations"
story = "As the operator, I want the attestor nodes deployed, backed up and observable as independent machines in independent regions, so that the loss of any two of them costs nothing and the compromise of any two reveals nothing."
ac_1 = "THE deployment definitions under human/wallet/deploy SHALL describe five attestor applications, one machine each, in five regions on at least two continents, each with a persistent volume, its own secrets named in the environment documentation, health checks bound to the daemon's health endpoint, and private-network-only peer ports; a check script SHALL validate the definitions without contacting the platform."
ac_2 = "EACH node SHALL back up its encrypted share store to object storage on a schedule and after every keygen, import, refresh and add-share, under the node's own backup key, and a restore test SHALL bring a node back from its backup and sign with the quorum."
ac_3 = "THE health endpoint SHALL report node id, region, share count, refresh epoch, audit head, reachability of every peer and readiness, and the gateway SHALL choose a signing quorum by health and measured latency and SHALL refuse to sign when fewer than three healthy nodes are reachable."
ac_4 = "THE network SHALL be deployed from the definitions with the daemon image built from the repository, a test key SHALL be generated and signed with across three regions, and the record of that run - image digest, regions, health of every node, signature verification - SHALL be committed to the qualification log without any hostname, address or secret."
ac_5 = "A load test tool under human/wallet/attestor SHALL drive concurrent signing sessions against a configured network for a bounded duration, SHALL report throughput, latency percentiles and refusals, and one run against the deployed network SHALL be recorded in the qualification log."

[req.4]
title = "Migration Ceremony"
story = "As the operator of the existing service, I want every current wallet moved into shares by a rehearsed, verifiable procedure, so that no user loses an address and no whole key survives the move."
ac_1 = "THE ceremony tool under human/wallet/ceremony SHALL read the existing wallet rows from a database connection, decrypt each key envelope with the master key supplied only through an environment variable name, verify the decrypted key derives the stored address, and refuse to continue on any mismatch; the tool SHALL hold keys only in memory and SHALL never write a key, a share or the master key to disk, a log or a temporary file."
ac_2 = "THE tool SHALL split each key into five shares by a degree-two polynomial for both curves, SHALL deliver each share to its node over mutual TLS through keys.import, SHALL trigger keys.refresh on every node, SHALL request a test signature from three nodes, SHALL recover the address from that signature, and SHALL mark the wallet migrated only when the recovered address equals the stored address."
ac_3 = "THE tool SHALL run in rehearsal mode against a restored copy of the database and five in-process or locally deployed nodes, SHALL produce a report counting wallets read, verified, imported, refreshed, test-signed and matched, and SHALL exit non-zero unless every wallet matched."
ac_4 = "THE tool SHALL re-encrypt the funded wallets' rows into an archive file under a fresh passphrase supplied through an environment variable name, SHALL verify the archive decrypts to the same rows, and SHALL exclude those wallets from migration; the live tables drop them only after the archive verifies."
ac_5 = "THE rehearsal SHALL be executed once in wave 5 against a restored copy of the production backup, and its report SHALL be recorded in the qualification log with counts only; the live ceremony, master key destruction and endpoint cutover remain operator steps outside this feature's tasks."

[req.5]
title = "Wallet Gateway Without Keys"
story = "As a developer of an app on the network, I want the wallet API I already integrate to keep working while the keys behind it move to the attestors, so that nothing I shipped breaks and the service becomes safer without a migration on my side."
ac_1 = "THE gateway, SDK and demo SHALL be imported into human/wallet as one pnpm workspace with their existing tests passing, every secret, environment file and credential removed, an environment example that names variables only, and a secret scan over the imported tree that passes."
ac_2 = "THE gateway SHALL keep the public routes under /v1/wallet, /v1/agent and /v1/agents with their request and response shapes, SHALL sign through the attestor API for every wallet flagged migrated and through the legacy envelope path only for wallets not yet migrated, and SHALL flip a wallet to the attestor path atomically with the ceremony's migrated mark."
ac_3 = "THE gateway SHALL allocate transaction nonces through a shared store with a per-address lock that holds across worker processes and instances, SHALL broadcast through a pool of RPC endpoints with health checks and failover, and SHALL estimate gas and simulate before requesting a signature."
ac_4 = "THE gateway SHALL remove the funded routes, the treasury evaluator, the tier tables and the fund and sweep paths, SHALL refuse a request that names a funded wallet, and SHALL keep no treasury key in any configuration."
ac_5 = "THE gateway SHALL bind an agent to a human owner only through an authenticated claim route, SHALL accept a value-moving agent request only with the agent's end-to-end signature that the attestors also verify, and SHALL scope the gateway-minted agent token to read routes."
ac_6 = "THE gateway SHALL rate-limit per client and per account at the HTTP layer, SHALL record every signing request, refusal and broadcast with the attestor audit sequence in its own audit table, and SHALL expose readiness that reports the attestor quorum, the nonce store, the RPC pool and the identity provider."
ac_7 = "END-TO-END tests SHALL spawn the real attestor daemon built from the repository, provision a wallet, sign and verify a transaction, a message and typed data, refuse a request with an invalid token, and refuse a transaction outside policy."

[req.6]
title = "Unified Account Provisioning"
story = "As a person signing up, I want one account that exists on both networks the moment I sign in, so that I never learn there are two."
ac_1 = "WHEN a wallet is provisioned THE gateway SHALL request a secp256k1 key and an Ed25519 key from the attestors, SHALL derive the address, the DID as did:layerx plus the public key hex, and the main account id exactly as the chain's DeriveAccountID, and SHALL store all three with the wallet row."
ac_2 = "WHEN both keys exist THE gateway SHALL send the setup top-up from the sponsor account for the exact binding gas within the configured cap, SHALL request the Ed25519 signature over the LX:PAXEER-BIND:v1 message for the current binding nonce, SHALL build and sign the bindLayerX transaction from the wallet's address, SHALL broadcast it, and SHALL confirm through the precompile's getUnifiedAccount that the address is bound to the DID before reporting the account active."
ac_3 = "THE provisioning SHALL be idempotent and resumable: a retry after any step completes the remaining steps without a second key, a second top-up or a second binding, and a binding that already names a different DID SHALL be refused and recorded."
ac_4 = "THE /v1/wallet/me response SHALL carry the address, the DID, the main account id, the binding state and the kernel availability state, and an existing client that reads only the address SHALL keep working."
ac_5 = "A backfill command SHALL provision the Ed25519 key and the binding for every migrated wallet that lacks them, in bounded batches with a resumable cursor, SHALL use the agent's own key for agent wallets where the agent has registered it, and SHALL report per-wallet outcomes without secrets."
ac_6 = "THE agent provisioning SHALL derive an agent's DID from the Ed25519 public key the agent registered, SHALL require the agent's own signature over the binding message, and SHALL refuse to bind an agent wallet to any other key."

[req.7]
title = "Shared Endpoint Client and Reads"
story = "As a user, I want one balance, one history and one status for everything I do, so that the network reads as one place."
ac_1 = "THE SDK SHALL talk to one RPC base, the hosted endpoint, SHALL route eth_ methods to the chain, lx_ methods to the kernel and px_ methods to the joins through that base, and SHALL batch mixed calls in one JSON-RPC batch."
ac_2 = "THE SDK SHALL resolve the account with px_resolveAccount on sign-in, SHALL read joined balances with px_getBalances and complete them with eth_getBalance and ERC-20 calls for assets outside the custody map, SHALL surface the join limit, and SHALL read history with px_getUnifiedHistory by cursor."
ac_3 = "THE SDK SHALL map the explorer's per-transaction status, the human service's journey states and the anchor states to one ladder - instant, sealed, final - with the source of each rung, and the app SHALL show that ladder and nothing else."
ac_4 = "THE SDK SHALL plan a value movement with the human service's intent plan operation, SHALL present the legs, domains, fees per leg, total fee and signers, SHALL submit with the plan digest and bindings, and SHALL track progress through the journey operation."
ac_5 = "WHEN the endpoint reports the kernel unreachable or the anchor precompile reports no finalised checkpoint THE SDK SHALL expose a kernel availability state with the reason, and every kernel-side operation SHALL refuse with that state instead of timing out or inventing a result."

[req.8]
title = "Kernel-Side Custody Plane"
story = "As the network, I want the human service to sign kernel activities for embedded accounts through the same attestors and under the same login, so that one custody plane serves both networks."
ac_1 = "THE identity provider under human/crates/layerx-human-identity-provider SHALL accept the wallet's identity assertion - a Supabase access token verified against a configured JWKS - as a login principal, SHALL open or create the application account mapped to that subject and to the wallet's DID, and SHALL keep the passkey path unchanged for accounts that use it."
ac_2 = "THE human service's custody signer SHALL have an attestor-backed implementation in human/crates/layerx-human-kms that signs an activity's preimage through the attestor sign operation with the request kind lx_activity, the disclosure fields and the user's assertion, SHALL refuse when the quorum refuses, and SHALL be tested against the real daemon spawned from the repository."
ac_3 = "THE human service's intent submit operation SHALL verify the signed digest and every leg binding against the re-planned plan, SHALL create a journey and drive its legs through the existing movement journeys, SHALL return the intent submission shape the contract declares, and the TypeScript SDK's submit decoder SHALL accept the live response."
ac_4 = "AN end-to-end test SHALL sign in with a wallet assertion, plan a kernel send, submit it, and observe the journey reach a receipt-verified state against the human service and the daemon in process."

[req.9]
title = "Wallet SDK"
story = "As a dapp developer, I want to integrate the embedded wallet like any injected wallet and reach the network's own surfaces through typed calls, so that one integration covers every user."
ac_1 = "THE SDK SHALL provide an EIP-1193 provider announced through EIP-6963 and installed as window.paxeer, SHALL implement eth_requestAccounts, eth_accounts, eth_chainId, eth_sendTransaction, eth_signTypedData_v4, personal_sign and paxeer_signCustody, and SHALL implement eth_sign only for the two digest constructions the attestors accept, passing their fields, not a digest."
ac_2 = "THE SDK SHALL discover injected wallets through EIP-6963 and present the embedded provider and every injected provider through one interface, so an app treats both custody modes identically."
ac_3 = "THE SDK SHALL ship typed modules for the exchange, bridge, launchpad, fee token and web data precompiles, reusing the ABI builders under agent/sdk/typescript, and for the gas station's quote and submit with the sponsored batch signature."
ac_4 = "THE SDK SHALL ship the shared endpoint client, the kernel read client, the human service intent and journey client and the status ladder of req.7, with response decoders validated against the schema goldens under human/schema and the attestor schema goldens."
ac_5 = "THE SDK SHALL ship agent lane helpers that sign requests end to end with an Ed25519 key and derive the agent's DID, with tests against the gateway's verification."
ac_6 = "THE SDK SHALL be published from human/wallet/sdk with a changelog, typed errors, and a demo under human/wallet/demo that exercises sign-in, provisioning, a transaction, typed data, a custody hand-off and a kernel plan."

[req.10]
title = "Wallet App on Embedded Custody"
story = "As a user of the app, I want one clear way to hold my account and every network surface in one place, so that the app is the network's front door and not a browser."
ac_1 = "THE app SHALL be committed under human/apps/wallet with every secret, test key and credential removed and a secret scan passing, before any other change to it."
ac_2 = "THE app SHALL remove the self-custody vault, the PIN flow, the seed import and backup screens, the same-origin dapp proxy, the in-app browser and browser plane, and the ramp screen, and SHALL keep MetaMask and other injected wallets through the SDK's EIP-6963 discovery."
ac_3 = "THE app SHALL sign in through the gateway's identity flow, provision through the gateway, and sign every transaction, message and typed data through the SDK provider, with no key material in the bundle."
ac_4 = "THE app SHALL show the unified account: address, DID, binding state, one asset list with joined balances, one history, the status ladder per transaction, a custody deposit flow, and kernel-side plans with the kernel availability state."
ac_5 = "THE app SHALL expose the exchange, bridge, launchpad, fee token choice and web data surfaces through the SDK modules, and the fee choice SHALL label every fee's denomination."
ac_6 = "THE app SHALL carry its native projects, environment configuration and release tests in the repository, and its tests SHALL run under vitest and its end-to-end configuration under Playwright."

[req.11]
title = "Fees and Payments Across Both Networks"
story = "As a user, I want to know what I pay and in what, whichever route my action takes."
ac_1 = "THE SDK and the app SHALL offer PAX gas, SID through the gas station's sponsored batch, and SID through the fee token precompile's preference, SHALL label each fee's denomination, and SHALL show the LayerX fee per leg separately from chain gas."
ac_2 = "THE attestor policy SHALL treat the sponsored batch digest and the EIP-7702 authorisation as distinct request kinds with their own caps, and the gateway SHALL relay sponsored batches through the gas station's submit operation."
ac_3 = "402LXP payments SHALL draw from the kernel account under budget and allowance caps shown in the app, and contract calls to the web data precompile SHALL show the PAX value they carry."

[req.12]
title = "Shared Endpoint Deployment"
story = "As the operator, I want the shared endpoint running and truthful, so that the wallet has one base to talk to."
ac_1 = "THE hosted endpoint under platform/hosted/gateway SHALL start with the kernel backends unconfigured or unreachable, SHALL serve eth_ relay and the px_ joins that depend on chain state alone, SHALL answer kernel-dependent methods with a typed unavailable error naming the backend, and SHALL report per-backend readiness."
ac_2 = "THE deployment definitions under human/wallet/deploy SHALL describe the endpoint's application with its environment variable names and health check, and the endpoint SHALL be deployed from the repository image with px_resolveAccount and eth_chainId answering against the chain; the record is committed to the qualification log without hosts."

[req.13]
title = "Release Gates, Runbooks and Review"
story = "As the owner, I want one bounded gate, a rehearsal record and an operations record before anything live changes."
ac_1 = "THE repository SHALL carry tools/wallet/gate-test.sh and tools/wallet/gate-lint.sh, each bounded by a budget from the environment with a documented default, each with a check mode, running the Go, TypeScript and Rust suites and lints this feature owns, and tools/wallet/scan-secrets.sh that fails on key-shaped, token-shaped or connection-string-shaped content."
ac_2 = "THE runbooks under human/wallet/docs SHALL cover node loss and replacement, refresh cadence, backup restore, identity provider outage, RPC pool failure, and the operator cutover checklist with its approval gates, without hosts or secrets."
ac_3 = "A security review document under human/wallet/docs SHALL record the delta review of the vendored threshold library since its published audit, the daemon's trust boundaries, and every open finding with severity."
ac_4 = "THE merged gate SHALL run once on the merged feature tip in wave 5 with its evidence recorded, and the rehearsal SHALL run once with counts recorded; no task reruns either."

# --------------------------------------------------------------------------
# WAVE 1 - FOUNDATIONS
# --------------------------------------------------------------------------

[task.1]
section = "Wave 1 - Foundations"
title = "Build the parts with disjoint paths"
status = "pending"

[task.1.1]
title = "Create the attestor module with its configuration and encrypted share store"
status = "done"
wave = 1
requires = []
do_1 = "Create the Go module human/wallet/attestor with go.mod naming the module path under the repository module namespace, a Makefile-free layout (cmd/attestor, internal/), and internal/config that loads listen addresses, node id, region, peer list, node key path, ceremony flag, chain id, identity provider JWKS URL and policy defaults from environment variable names documented in human/wallet/deploy/env, refusing to start when the node key is absent."
do_2 = "Implement internal/store with a share record (key id, curve, public key, refresh epoch, participant set, ciphertext) persisted in an embedded key-value file under the data directory, encrypted with AES-256-GCM under the node key with the record's metadata as authenticated associated data, with Put, Get, List and Delete that never return plaintext outside a scoped closure and never log it."
do_3 = "Implement internal/store/backup that writes an encrypted snapshot of the store under a separate backup key and restores it, so req.3.ac_2 can build on it."
do_4 = "Add internal/config/config_test.go and internal/store/store_test.go covering refusal without a node key, round trip of both curves, tampered associated data refused, snapshot and restore, and that no share bytes appear in any error string or log line."
verify_cmd = "timeout 20m sh -c 'cd human/wallet/attestor && go test -count=1 ./internal/config/... ./internal/store/...'"
symbols = ["Config","Load","Store","ShareRecord","Snapshot","Restore"]
touches = ["human/wallet/attestor/go.mod","human/wallet/attestor/internal/config/config.go","human/wallet/attestor/internal/config/config_test.go","human/wallet/attestor/internal/store/store.go","human/wallet/attestor/internal/store/backup.go","human/wallet/attestor/internal/store/store_test.go","human/wallet/deploy/env"]
reqs = ["1.5","3.2"]
revision = "9787d3728aa4ebf2769a51d109b1551fbddb9eb0"
command = "timeout 20m sh -c 'cd human/wallet/attestor && go test -count=1 ./internal/config/... ./internal/store/...'"
exit_code = 0
log_path = ".logs/verify.log"

[task.1.2]
title = "Wrap threshold ECDSA on secp256k1 with Ethereum signature shape"
status = "pending"
wave = 1
requires = []
do_1 = "Add human/wallet/attestor/internal/tss/ecdsa wrapping the vendored library's CGGMP distributed key generation and four-round signing for secp256k1 with threshold three of five (library parameter two), exposing Keygen, Sign and the persisted share shape (share, Paillier key, partial public keys, Pedersen parameters, Birkhoff parameters) as typed values."
do_2 = "Normalise every signature to low s and compute the recovery id by recovering the public key, so the output is a 65-byte Ethereum signature; refuse to return a signature whose recovered address does not match the key."
do_3 = "Add an in-package in-memory peer manager in the test file so five participants run in one process, and tests covering keygen, signing of a real EIP-1559 transaction digest with address recovery through go-ethereum's crypto package, low-s normalisation, and a participant dropping out below threshold failing the session."
verify_cmd = "timeout 20m sh -c 'cd human/wallet/attestor && go test -count=1 ./internal/tss/ecdsa/...'"
symbols = ["Keygen","Sign","KeyShare","EthereumSignature"]
touches = ["human/wallet/attestor/internal/tss/ecdsa/ecdsa.go","human/wallet/attestor/internal/tss/ecdsa/share.go","human/wallet/attestor/internal/tss/ecdsa/ecdsa_test.go"]
reqs = ["1.1"]

