[task.4.1]
title = "Run the gateway in shadow against the live attestors with a fresh account on the chain"
status = "pending"
wave = 4
requires = ["3.1","3.2","3.5"]
do_1 = "Deploy the gateway from human/wallet/deploy/gateway.toml beside the existing service under a platform-issued name, pointed at the deployed attestors, the identity provider and the RPC pool, with the sponsor account funded out of band; sign in with a fresh test identity, provision, observe both keys, the top-up and the binding on the chain, sign and send a minimal transaction, sign a message, and confirm getUnifiedAccount reports the binding."
do_2 = "Extend tools/wallet/check-live.sh with a gateway mode that checks readiness and /v1/wallet/me for a configured test identity, and record the run in the qualification log with the transaction hash and no hosts or secrets."
verify_cmd = "timeout 20m sh -c 'tools/wallet/check-live.sh gateway'"
symbols = ["check-live"]
touches = ["tools/wallet/check-live.sh","tools/wallet/check-live.test.sh","spec/paxeer-x-wallet/qualification.kvx"]
reqs = ["6.2","5.6"]

[task.4.2]
title = "Show the unified account and the kernel surfaces in the app"
status = "pending"
wave = 4
requires = ["3.6","2.6"]
do_1 = "In human/apps/wallet add the unified account view (address, DID, binding state), one asset list with joined balances completed by chain calls, one history with cursor paging, the status ladder per transaction, a custody deposit flow through the custody precompile, and kernel plans through the human service client with the kernel availability state shown and every kernel action disabled with its reason when unavailable."
do_2 = "Add tests for each view against recorded endpoint responses and the unavailable state."
verify_cmd = "timeout 20m sh -c 'pnpm --dir human/apps/wallet exec vitest run src/account'"
symbols = ["AccountView","AssetList","HistoryView","StatusLadder","DepositFlow","KernelPlan"]
touches = ["human/apps/wallet/src/account/","human/apps/wallet/src/app/"]
reqs = ["10.4","7.2","7.3","7.4","7.5"]

[task.4.3]
title = "Add the Paxeer X surfaces and the fee choice to the app"
status = "pending"
wave = 4
requires = ["3.6","2.5"]
do_1 = "In human/apps/wallet add the exchange, bridge, launchpad, fee token and web data surfaces through the SDK modules, the fee choice labelling PAX gas, SID sponsored and SID native with denominations, the LayerX fee per leg shown separately, and 402 draws shown with their caps."
do_2 = "Add tests for each surface's transaction construction and the fee labels."
verify_cmd = "timeout 20m sh -c 'pnpm --dir human/apps/wallet exec vitest run src/surfaces'"
symbols = ["ExchangeView","BridgeView","LaunchpadView","FeeChoice","WebDataView"]
touches = ["human/apps/wallet/src/surfaces/","human/apps/wallet/src/app/"]
reqs = ["10.5","11.1","11.3"]

[task.4.4]
title = "Carry the app's native projects, configuration and release tests in the repository"
status = "pending"
wave = 4
requires = ["3.6"]
do_1 = "Add the iOS and Android native projects generated for the app, the environment configuration by variable name, the release build scripts, and a Playwright suite over the remaining surfaces against the SDK's in-test gateway, keeping every secret out."
do_2 = "Add a scripts/release-check.sh that validates the native projects exist, the configuration names resolve and the Playwright suite runs in check mode."
verify_cmd = "timeout 20m sh -c 'human/apps/wallet/scripts/release-check.sh'"
symbols = ["release-check"]
touches = ["human/apps/wallet/ios/","human/apps/wallet/android/","human/apps/wallet/scripts/release-check.sh","human/apps/wallet/playwright.wallet-app.config.ts","human/apps/wallet/e2e/"]
reqs = ["10.6"]

[task.4.5]
title = "Write the runbooks and the operator cutover checklist"
status = "pending"
wave = 4
requires = ["3.3","3.5"]
do_1 = "Add human/wallet/docs/runbooks covering node loss and replacement by add-share and refresh, refresh cadence, backup restore, identity provider outage, RPC pool failure and gateway rollback, each with the exact commands from the repository's tools and no hosts or secrets."
do_2 = "Add human/wallet/docs/cutover.md: the operator checklist from rehearsal record through live ceremony, funded archive verification, wallet flag flip, endpoint cutover, old service read-only, master key destruction and old service shutdown, each step naming its approval gate and its rollback."
verify_cmd = "timeout 20m sh -c 'tools/wallet/scan-secrets.sh human/wallet/docs'"
symbols = ["runbooks"]
touches = ["human/wallet/docs/runbooks/","human/wallet/docs/cutover.md"]
reqs = ["13.2","4.5"]

[task.4.6]
title = "Prove the human service end to end on the wallet identity and the attestor custody"
status = "pending"
wave = 4
requires = ["3.4","1.14","1.13"]
do_1 = "Add a human service integration test that spawns the real attestor daemon, signs in with a wallet assertion minted from an in-test JWKS, opens the account, plans a kernel send, submits it with the attestor-backed signer, and observes the journey reach a receipt-verified state against the crate's in-process kernel test support."
do_2 = "Wire the attestor-backed signer and the assertion principal into the service's production component construction behind configuration, refusing to start when configured but unreachable."
verify_cmd = "timeout 20m sh -c 'cd human && cargo test -p layerx-human-service wallet_identity_e2e'"
symbols = ["wallet_identity_e2e"]
touches = ["human/crates/layerx-human-service/src/server/production_components.rs","human/crates/layerx-human-service/tests/wallet_identity_e2e.rs"]
reqs = ["8.4","8.1","8.2"]

[task.4.7]
title = "Load-test the deployed attestor network once"
status = "pending"
wave = 4
requires = ["3.5"]
do_1 = "Add human/wallet/attestor/cmd/loadtest driving concurrent signing sessions of both curves against a configured network for a bounded duration with a configured concurrency, reporting throughput, latency percentiles and refusals as JSON."
do_2 = "Add loadtest_test.go running the tool against five in-process daemons for a short bound, and run it once against the deployed network, recording the summary in the qualification log."
verify_cmd = "timeout 20m sh -c 'cd human/wallet/attestor && go test -count=1 ./cmd/loadtest/...'"
symbols = ["loadtest","Summary"]
touches = ["human/wallet/attestor/cmd/loadtest/main.go","human/wallet/attestor/cmd/loadtest/loadtest_test.go","spec/paxeer-x-wallet/qualification.kvx"]
reqs = ["3.5"]

[task.4.8]
title = "Record the security review of the library delta and the daemon"
status = "pending"
wave = 4
requires = ["2.1"]
do_1 = "Add human/wallet/docs/security-review.md recording the review of every change to the vendored threshold library's CGGMP, FROST, refresh and Birkhoff code since its published audit, the daemon's trust boundaries (gateway, attestor, identity provider, operator, dealer), the policy fail-closed paths, and every open finding with severity and owner action."
do_2 = "Where the review finds a defect in the daemon, fix it in this task with a test; where it finds one in the library, record it and pin the dependency version in go.mod with the reason."
verify_cmd = "timeout 20m sh -c 'tools/wallet/scan-secrets.sh human/wallet/docs && cd human/wallet/attestor && go vet ./...'"
symbols = ["security-review"]
touches = ["human/wallet/docs/security-review.md","human/wallet/attestor/go.mod"]
reqs = ["13.3"]

