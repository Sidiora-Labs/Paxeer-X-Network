[observation.3.1.2]
task = "3.1"
file = "human/wallet/attestor/cmd/attestor/main.go"
symbol = "Agents"
observed = "The daemon wires no agent verifier and accepts no operator authorisation for lx_bind or evm_tx, and no gateway route in this task's files accepts an agent's binding signature, so a backfill can only generate and store identities and leaves standard wallets awaiting their owner and agent wallets awaiting a signature."
assumption = "The owner's next authenticated provision completes a backfilled standard wallet and provisionAccount completes an agent wallet once the agent route that carries its signature is added."
severity = "note"

