# qualification.kvx - Paxeer X Network wallet executed-evidence ledger.
#
# Two record shapes live here. Both are append-only. No record is edited or
# removed once written; a rerun appends a new record beside the old one.
#
# [observation.<task>.<n>]  - the shape every feature uses (workflow.kvx
#   [qualification_log]): an assumption, an unrelated or pre-existing failure,
#   a cross-task contradiction, a missing external interface, or a repair that
#   would require weakening a check. Written once, never re-investigated and
#   never re-run. Keys: task, file, symbol, observed, assumption, severity
#   (blocker | suspect | assumption | note). At most six lines per entry.
#
# [gate.<wave>.<n>]  - a gate that actually ran on a merged revision: the
#   wave gates of wave 5, the deployment records of tasks 3.5, 3.7 and 4.1,
#   the load-test summary of 4.7 and the rehearsal counts of 5.2. Keys:
#   revision, command, exit_code, log_path, observed. Never a hostname, an
#   address, a secret or a person's name.

[observation.1.3.1]
task = "1.3"
file = "human/wallet/attestor/internal/tss/eddsa/eddsa.go"
symbol = "Threshold"
observed = "The library's threshold parameter is the number of shares needed to sign (dkg draws a polynomial of degree threshold-1), so parameter two would be two of five, not three of five as [decision] custody_model and req.1.ac_1 state."
assumption = "Three of five is the binding property, so the FROST wrapper passes library threshold three; task 1.2 and the decision text carry the same mapping and should be checked against it."
severity = "suspect"

[observation.1.13.1]
task = "1.13"
file = "human/crates/layerx-human-identity-provider/tests/client.rs"
symbol = "original_client_provisions_resolves_and_replays_assertion_devices"
observed = "The verify_cmd filter 'assertion' also selects this pre-existing test, which fails with ClockError Unavailable because RuntimeClock::from_environment needs a runtime clock supervisor that the gate environment does not provide; all 11 tests in tests/assertion.rs passed before it ran; main.rs is outside this task's touches, so the assertion section is read by AssertionConfig::from_environment but not yet wired into the serve command."
assumption = "The gate needs LAYERX_RUNTIME_CLOCK_SOCKET, _PID and _UID from a live clock supervisor to exit 0; wiring the verifier into serve and the wire protocol belongs to the human service task that consumes the mapping."
severity = "suspect"

[observation.1.7.1]
task = "1.7"
file = "agent/schema/agent-api/golden"
symbol = "DecodeActivity"
observed = "The agent API goldens carry request and response shapes only and no byte-level activity envelope or signature preimage, so req.2.ac_7 cannot be met from them."
assumption = "Byte-level vectors are generated by agent/crates/layerx-wire/tests/wallet_vectors.rs through the crate's own encoder and the Go decoder is checked against that file."
severity = "note"

[observation.1.7.2]
task = "1.7"
file = "layerxproof/codec/state.go"
symbol = "DeriveAccountID"
observed = "The chain's DeriveAccountID refuses agent:<did>:asset:<hex64> names with ErrAccountIdentity while the Rust wire crate derives them under protocol 3, so the two cannot be compared for the asset subaccount form."
assumption = "AccountID follows the Rust derivation; the test pins the chain's refusal for asset names so any later chain support fails it and forces the comparison."
severity = "suspect"

[observation.1.12.1]
task = "1.12"
file = "human/wallet/deploy/endpoint.toml"
symbol = "tls_config"
observed = "The hosted endpoint always terminates TLS itself on its listener, while the platform http_service forwards plain HTTP to internal_port after terminating TLS at the edge."
assumption = "The endpoint deployment task adds a plain-HTTP listener mode behind the platform proxy or switches the definition to TLS passthrough; the health check already speaks https to the machine."
severity = "suspect"

[observation.1.12.2]
task = "1.12"
file = "human/wallet/attestor/Dockerfile"
symbol = "attestor"
observed = "The daemon runs as the distroless non-root user while the platform mounts the attestor_data volume at /data owned by root, and the daemon's API is mutual TLS while the platform health check presents no client certificate."
assumption = "The daemon task serves /health without a client certificate and the network deployment task makes /data writable for the non-root user before the first keygen."
severity = "suspect"

[observation.1.2.1]
task = "1.2"
file = "human/wallet/attestor/internal/tss/ecdsa/ecdsa.go"
symbol = "Threshold"
observed = "The vendored CGGMP library treats its threshold argument as the number of signers required (random polynomial of degree threshold-1, sign refuses fewer Birkhoff parameters than threshold), so library parameter two would make any two of five shares sign."
assumption = "Three of five is the custody property, so the wrapper passes library threshold three (polynomial degree two) and a test proves two signers are refused; req.1 ac_1, decision custody_model and sibling tasks that say library parameter two need the same reading."
severity = "suspect"

[observation.1.13.2]
task = "1.13"
file = "tools/runtime/run-with-clock.sh"
symbol = "original_client_provisions_resolves_and_replays_assertion_devices"
observed = "The unchanged verify_cmd exits 0 at a3c183a4273cc952708065eb6aa600210606b83e under the repository's clock wrapper: 11 assertion tests and the client test pass."
assumption = "The runtime clock supervisor wrapper is the required environment for this crate's tests, as observation 1.13.1 assumed."
severity = "note"

[observation.1.14.1]
task = "1.14"
file = "human/crates/layerx-human-service/src/journeys/intent_submit.rs"
symbol = "IntentShape"
observed = "Intent submit executes plans made only of kernel send and budget legs, or exactly a custody deposit followed by its credit; withdrawal plans and a deposit followed by further kernel legs are refused as unsupported because no existing movement journey chains them."
assumption = "Withdrawal and chained deposit execution through intent submit is follow-up work; the golden sequence numbering is illustrative, while the service requires Paxeer legs to consume no account sequence."
severity = "note"

[observation.1.4.1]
task = "1.4"
file = "human/wallet/attestor/internal/tss/dealer/dealer.go"
symbol = "Threshold"
observed = "The library's threshold argument is the signer count (polynomial degree threshold-1, ValidatePublicKey and FeldmanVerify use threshold-1), so three-of-five on a degree-two polynomial is library threshold 3, not the parameter two named in [decision] custody_model and req.1."
assumption = "dealer.Threshold is 3 and is passed unchanged to refresh, add-share and both signers; tasks 1.2 and 1.3 should use the same value."
severity = "suspect"

[observation.1.16.1]
task = "1.16"
file = "human/apps/wallet/scripts/scan-secrets.sh"
symbol = "scan-secrets"
observed = "The scanner reports local artefacts present on disk even when git ignores them, so the tsconfig.tsbuildinfo left by the app's type-check fails the verify scan until it is removed."
assumption = "Gates that run type-check before the scan remove tsconfig.tsbuildinfo first; the scan stays strict on the working tree."

[observation.2.5.1]
task = "2.5"
file = "human/wallet/sdk/src/modules/gas-station.ts"
symbol = "gasStation.submit"
observed = "The gateway has no sponsored submit route; the module posts SponsoredSubmitRequest (types.ts) to /v1/wallet/sponsored/submit and passes eth_sign the SponsoredBatchConstruction object as its second parameter."
assumption = "The gateway relay task adds that route with that body, and the provider task accepts that construction shape for eth_sign."
severity = "suspect"

[observation.2.5.2]
task = "2.5"
file = "precompiles/feetoken/abi.json"
symbol = "gasStation.quote"
observed = "The fee token precompile exposes no rate, no decimals and no events; the rate lives in the EVM module params (base units per Paxeer coin) and SID decimals come from the agent SDK constant."
assumption = "Callers pass the governed rate string to quote, which applies the keeper's ceiling conversion; a rate read through the shared endpoint is follow-up work."
severity = "note"

[observation.2.5.3]
task = "2.5"
file = "human/wallet/sdk/package.json"
symbol = "build:agent-sdk"
observed = "The agent SDK is linked with the link protocol and exports only built output, so the SDK's test, typecheck and build scripts first run npm ci and the agent SDK build; its x402 draw module imports node:sqlite, which vitest 2 cannot load, so the SDK moved to vitest 3."
assumption = "The merged gate has npm registry access or a warm npm cache for the agent SDK's pinned dependencies."

[observation.2.2.1]
task = "2.2"
file = "human/wallet/gateway/src/chainReads.ts"
symbol = "HYPERPAXEER_RPC_URL"
observed = "Balance and chain reads in src/chainReads.ts and src/chain.ts still use the single HYPERPAXEER_RPC_URL client; only the signing routes and nonce store go through RpcPool."
assumption = "Routing the remaining read paths and the readiness report through the pool belongs to a later task that owns those files."
severity = "note"

[observation.3.7.1]
task = "3.7"
file = "platform/hosted/gateway/src/main.rs"
symbol = "config"
observed = "With every kernel backend URL unset, config still refuses startup unless LAYERX_GATEWAY_CLIENT_IDENTITY_PKCS12 and its password file, the four LAYERX_GATEWAY_SEQUENCER_ files, LAYERX_GATEWAY_KEY_PROVISIONING_KEY_FILE and LAYERX_GATEWAY_MODULE_REGISTRY_FILE are present and valid, so chain-only mode cannot start without kernel-side secrets and the deployment was not attempted."
assumption = "The endpoint needs a change that makes those inputs optional when LAYERX_GATEWAY_COMPONENT_URL is unset (as configured_kernel already does for the backend URLs and tokens), or an owner decision to issue them; tools/wallet/check-live.sh endpoint is ready for the deployment that follows."
severity = "blocker"

[observation.2.8.1]
task = "2.8"
file = "human/apps/wallet/src"
symbol = "EIP-6963"
observed = "The app had no injected-wallet path through EIP-6963 to keep; the only provider injection lived in the removed in-app dApp browser."
assumption = "The EIP-6963 injected-wallet path arrives with the SDK provider task and is wired into the app there."
severity = "suspect"

[observation.2.8.2]
task = "2.8"
file = "human/apps/wallet/src/components/onboarding/Onboarding.tsx"
symbol = "funded-tier-picker"
observed = "The funded-tier-picker step imports FundedTierPicker but renders nothing, so a funded session without a funded account shows a blank screen."
assumption = "Pre-existing; left unchanged because the funded lane belongs to another task."
severity = "suspect"

[observation.2.8.3]
task = "2.8"
file = "human/apps/wallet/src/domains/shell/index.ts"
symbol = "ROUTE_POLICIES.pns"
observed = "The name-service screen was reachable only in self-custody; with self-custody removed its route policy now admits embedded custody so the kept screen stays reachable from Discover."
assumption = "The name-service registration flow signs through the embedded signer; any signing method the embedded API lacks surfaces as a typed error on that screen."
severity = "note"

[observation.2.8.4]
task = "2.8"
file = "human/apps/wallet/src/platform/storage/repositories.ts"
symbol = "parseCustodyChoice"
observed = "A stored custody choice of self-custody from an earlier install would fail closed as corrupt once the kind is removed."
assumption = "The retired value is read as no choice so earlier self-custody installs land on the welcome screen; any other unknown value still fails closed."
severity = "note"

[observation.2.4.1]
task = "2.4"
file = "human/wallet/sdk/src/provider.ts"
symbol = "PaxeerProvider"
observed = "The gateway has no user routes for typed data, restricted digests or custody bytes, so the provider defines POST /v1/wallet/sign-typed-data {typedData}, /v1/wallet/sign-digest {construction} and /v1/wallet/sign-custody {custody}, each answering {signature, address}, recorded in sdk/test/fixtures/gateway."
assumption = "The gateway's attestor signing task adds these three routes with exactly these request and response shapes."
severity = "suspect"

[observation.2.4.2]
task = "2.4"
file = "human/wallet/sdk/src/modules/gas-station.ts"
symbol = "gasStation.sign"
observed = "The gas station module calls eth_sign with params [from, construction] and no digest, while PaxeerProvider requires [address, digest, construction] and refuses a missing or mismatched digest, so the module's sign path is refused by the embedded provider."
assumption = "One side aligns on a single eth_sign parameter order; the provider keeps recomputing the digest from the fields and forwarding only the fields."

[observation.2.7.1]
task = "2.7"
file = "human/wallet/ceremony/internal/attestor/client.go"
symbol = "ImportRequest"
observed = "The attestor API schema human/wallet/schema/attestor-api/v1.kvx and the daemon are written by task 2.1 in the same wave, so the ceremony client's paths (/v1/keys.import, /v1/keys.refresh, /v1/sign), field names and key ids (wallet:<id>:secp256k1, wallet:<id>:ed25519) are coded from [decision] attestor_api alone."
assumption = "Task 2.1 or wave 3 aligns the daemon and the client to the schema file and its golden vectors; the ceremony tests decode those vectors once they exist."
severity = "suspect"

[observation.3.9.1]
task = "3.9"
file = "platform/hosted/internal/src/producer.rs"
symbol = "Client::from_environment"
observed = "With the kernel-side inputs absent the endpoint still refuses startup with producer requires mTLS and bearer credentials unless LAYERX_EVENTS_PAYMENT_ and LAYERX_EVENTS_WEBHOOKS_ upstream URL, CA, token file and client identity with its password are set."
assumption = "The chain-only deployment supplies the event producer inputs, or a later task makes the producer optional; this task left the producer unchanged because it lives outside the gateway crate."
severity = "medium"

[observation.2.3.1]
task = "2.3"
file = "human/wallet/gateway/src/schemas/tx.ts"
symbol = "ProvisionFundedBody"
observed = "The funded provision body schema outlives the removed lane because test/schemas.injection.test.ts exercises it and that test belongs to a kept module."
assumption = "The schema and its injection test are removed together by whichever task retires the schema module's funded shapes."
severity = "note"

[observation.2.3.2]
task = "2.3"
file = "human/wallet/sdk/src/index.ts"
symbol = "funded"
observed = "The SDK client, its types and client test, the demo's funded account panel and the workspace README still call or describe the removed /v1/funded routes, which now answer 404."
assumption = "The SDK tasks of this wave own those files and drop the funded surface there."
severity = "suspect"

[observation.3.8.1]
task = "3.8"
file = "human/wallet/gateway/src/auth/did.ts"
symbol = "parseDid"
observed = "The gateway registers and verifies agents only under did:matrix:<label>:<16 hex> and has no did:layerx derivation, so agentDid (did:layerx plus 64 hex, matching lxwire and the bind vectors) cannot be the X-Agent-Key the gateway accepts."
assumption = "signAgentRequest and buildClaim take the registered key id as given and the tests sign with the gateway's did:matrix form; moving the gateway to did:layerx principals belongs to a gateway task."
severity = "medium"

[observation.3.6.1]
task = "3.6"
file = "human/wallet/sdk/src/index.ts"
symbol = "@paxeer/wallet"
observed = "The SDK root index re-exports modules that import @sidiora/layerx-sdk from source, which pulls node:sqlite, node:child_process, http, https and ws into the app's type check and bundle graph, so the app aliases that package to its source and carries its runtime dependencies."
assumption = "The SDK gains a browser-safe entry point without the agent modules; until then the app resolves both packages from source through tsconfig paths, the vitest aliases and the Next webpack aliases."
severity = "suspect"

[observation.3.6.2]
task = "3.6"
file = "human/apps/wallet/src/platform/storage/repositories.ts"
symbol = "parseCustodyChoice"
observed = "A stored custody choice of funded, left by the retired funded tier, is read as no choice, so those users land on the welcome screen."
assumption = "The funded tier stays retired, following the same precedent as observation 2.8.4."
severity = "info"
