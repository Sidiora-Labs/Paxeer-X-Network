[observation.3.5.1]
task = "3.5"
file = "human/wallet/attestor/cmd/attestor/main.go"
symbol = "APITLSConfig"
observed = "The API listener is built with the operator CA as its only client CA, so the gateway's client certificate must chain to the operator CA, and the peer transport's identify then also classes that certificate as an operator identity entitled to keys.import during a ceremony window."
assumption = "The gateway and operator identities were issued from the operator CA so the network answers at all; a later daemon task gives the API listener a separate gateway client CA and restricts keys.import to the operator identity."
severity = "suspect"

[observation.3.5.2]
task = "3.5"
file = "human/wallet/attestor/cmd/attestor/main.go"
symbol = "server.Options.Agents"
observed = "run never sets server.Options.Agents, so a sign request with agent headers always answers no agent verifier is configured, and the only principal the deployed nodes honour for sign is an identity-provider user token whose subject owns the key."
assumption = "Signing across regions needs either the agent verifier wired into the daemon with a registered agent key or a real identity-provider user; keys.generate was proven on both curves across all five nodes and the signing half of the deployment proof waits on one of those."
severity = "blocker"

[observation.3.5.3]
