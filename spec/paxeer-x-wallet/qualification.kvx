severity = "note"

[observation.3.1.1]
task = "3.1"
file = "human/wallet/gateway/src/attestor/client.ts"
symbol = "AttestorClient"
observed = "The gateway attestor client probes /v1/health and posts sign bodies with bytes, context, authorisation and participants, where the daemon serves /health and takes kind-specific fields and signers, so it cannot sign against the real daemon."
assumption = "Provisioning talks to the daemon through its own schema-conformant client in src/provision/bind.ts and leaves client.ts to the task that aligns it."
