symbol = "TCPPeerProbe"
observed = "The first verify run right after the deployment reported each node reaching only the peers whose health had already been read, because the first private-network contact between two machines outlasted the probe's two-second dial timeout; once every pair had been contacted all five nodes reached all four peers."
