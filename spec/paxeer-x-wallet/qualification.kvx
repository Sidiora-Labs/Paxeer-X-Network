# qualification.kvx - Paxeer X Network wallet executed-evidence ledger.
#
# Two record shapes live here. Both are append-only. No record is edited or
# removed once written; a rerun appends a new record beside the old one.
#
# [observation.<task>.<n>]  - the shape every feature uses (workflow.kvx
#   [qualification_log]): an assumption, an unrelated or pre-existing failure,
#   a cross-task contradiction, a missing external interface, or a repair that
#   would require weakening a check. Written once, never re-investigated and
#   never re-run. Keys: task, file, symbol, observed, assumption, severity
#   (blocker | suspect | assumption | note). At most six lines per entry.
#
# [gate.<wave>.<n>]  - a gate that actually ran on a merged revision: the
#   wave gates of wave 5, the deployment records of tasks 3.5, 3.7 and 4.1,
#   the load-test summary of 4.7 and the rehearsal counts of 5.2. Keys:
#   revision, command, exit_code, log_path, observed. Never a hostname, an
#   address, a secret or a person's name.

[observation.1.3.1]
task = "1.3"
file = "human/wallet/attestor/internal/tss/eddsa/eddsa.go"
symbol = "Threshold"
observed = "The library's threshold parameter is the number of shares needed to sign (dkg draws a polynomial of degree threshold-1), so parameter two would be two of five, not three of five as [decision] custody_model and req.1.ac_1 state."
assumption = "Three of five is the binding property, so the FROST wrapper passes library threshold three; task 1.2 and the decision text carry the same mapping and should be checked against it."
severity = "suspect"

[observation.1.13.1]
task = "1.13"
file = "human/crates/layerx-human-identity-provider/tests/client.rs"
symbol = "original_client_provisions_resolves_and_replays_assertion_devices"
observed = "The verify_cmd filter 'assertion' also selects this pre-existing test, which fails with ClockError Unavailable because RuntimeClock::from_environment needs a runtime clock supervisor that the gate environment does not provide; all 11 tests in tests/assertion.rs passed before it ran; main.rs is outside this task's touches, so the assertion section is read by AssertionConfig::from_environment but not yet wired into the serve command."
assumption = "The gate needs LAYERX_RUNTIME_CLOCK_SOCKET, _PID and _UID from a live clock supervisor to exit 0; wiring the verifier into serve and the wire protocol belongs to the human service task that consumes the mapping."
severity = "suspect"

[observation.1.7.1]
task = "1.7"
file = "agent/schema/agent-api/golden"
symbol = "DecodeActivity"
observed = "The agent API goldens carry request and response shapes only and no byte-level activity envelope or signature preimage, so req.2.ac_7 cannot be met from them."
assumption = "Byte-level vectors are generated by agent/crates/layerx-wire/tests/wallet_vectors.rs through the crate's own encoder and the Go decoder is checked against that file."
severity = "note"

[observation.1.7.2]
task = "1.7"
file = "layerxproof/codec/state.go"
symbol = "DeriveAccountID"
observed = "The chain's DeriveAccountID refuses agent:<did>:asset:<hex64> names with ErrAccountIdentity while the Rust wire crate derives them under protocol 3, so the two cannot be compared for the asset subaccount form."
assumption = "AccountID follows the Rust derivation; the test pins the chain's refusal for asset names so any later chain support fails it and forces the comparison."
severity = "suspect"

[observation.1.12.1]
task = "1.12"
file = "human/wallet/deploy/endpoint.toml"
symbol = "tls_config"
observed = "The hosted endpoint always terminates TLS itself on its listener, while the platform http_service forwards plain HTTP to internal_port after terminating TLS at the edge."
assumption = "The endpoint deployment task adds a plain-HTTP listener mode behind the platform proxy or switches the definition to TLS passthrough; the health check already speaks https to the machine."
severity = "suspect"

[observation.1.12.2]
task = "1.12"
file = "human/wallet/attestor/Dockerfile"
symbol = "attestor"
observed = "The daemon runs as the distroless non-root user while the platform mounts the attestor_data volume at /data owned by root, and the daemon's API is mutual TLS while the platform health check presents no client certificate."
assumption = "The daemon task serves /health without a client certificate and the network deployment task makes /data writable for the non-root user before the first keygen."
severity = "suspect"

[observation.1.2.1]
task = "1.2"
file = "human/wallet/attestor/internal/tss/ecdsa/ecdsa.go"
symbol = "Threshold"
observed = "The vendored CGGMP library treats its threshold argument as the number of signers required (random polynomial of degree threshold-1, sign refuses fewer Birkhoff parameters than threshold), so library parameter two would make any two of five shares sign."
assumption = "Three of five is the custody property, so the wrapper passes library threshold three (polynomial degree two) and a test proves two signers are refused; req.1 ac_1, decision custody_model and sibling tasks that say library parameter two need the same reading."
severity = "suspect"

[observation.1.13.2]
task = "1.13"
file = "tools/runtime/run-with-clock.sh"
symbol = "original_client_provisions_resolves_and_replays_assertion_devices"
observed = "The unchanged verify_cmd exits 0 at a3c183a4273cc952708065eb6aa600210606b83e under the repository's clock wrapper: 11 assertion tests and the client test pass."
assumption = "The runtime clock supervisor wrapper is the required environment for this crate's tests, as observation 1.13.1 assumed."
severity = "note"

[observation.1.14.1]
task = "1.14"
file = "human/crates/layerx-human-service/src/journeys/intent_submit.rs"
symbol = "IntentShape"
observed = "Intent submit executes plans made only of kernel send and budget legs, or exactly a custody deposit followed by its credit; withdrawal plans and a deposit followed by further kernel legs are refused as unsupported because no existing movement journey chains them."
assumption = "Withdrawal and chained deposit execution through intent submit is follow-up work; the golden sequence numbering is illustrative, while the service requires Paxeer legs to consume no account sequence."
severity = "note"

[observation.1.4.1]
task = "1.4"
file = "human/wallet/attestor/internal/tss/dealer/dealer.go"
symbol = "Threshold"
observed = "The library's threshold argument is the signer count (polynomial degree threshold-1, ValidatePublicKey and FeldmanVerify use threshold-1), so three-of-five on a degree-two polynomial is library threshold 3, not the parameter two named in [decision] custody_model and req.1."
assumption = "dealer.Threshold is 3 and is passed unchanged to refresh, add-share and both signers; tasks 1.2 and 1.3 should use the same value."
severity = "suspect"

[observation.1.16.1]
task = "1.16"
file = "human/apps/wallet/scripts/scan-secrets.sh"
symbol = "scan-secrets"
observed = "The scanner reports local artefacts present on disk even when git ignores them, so the tsconfig.tsbuildinfo left by the app's type-check fails the verify scan until it is removed."
assumption = "Gates that run type-check before the scan remove tsconfig.tsbuildinfo first; the scan stays strict on the working tree."

[observation.2.5.1]
task = "2.5"
file = "human/wallet/sdk/src/modules/gas-station.ts"
symbol = "gasStation.submit"
observed = "The gateway has no sponsored submit route; the module posts SponsoredSubmitRequest (types.ts) to /v1/wallet/sponsored/submit and passes eth_sign the SponsoredBatchConstruction object as its second parameter."
assumption = "The gateway relay task adds that route with that body, and the provider task accepts that construction shape for eth_sign."
severity = "suspect"

[observation.2.5.2]
task = "2.5"
file = "precompiles/feetoken/abi.json"
symbol = "gasStation.quote"
observed = "The fee token precompile exposes no rate, no decimals and no events; the rate lives in the EVM module params (base units per Paxeer coin) and SID decimals come from the agent SDK constant."
assumption = "Callers pass the governed rate string to quote, which applies the keeper's ceiling conversion; a rate read through the shared endpoint is follow-up work."
severity = "note"

[observation.2.5.3]
task = "2.5"
file = "human/wallet/sdk/package.json"
symbol = "build:agent-sdk"
observed = "The agent SDK is linked with the link protocol and exports only built output, so the SDK's test, typecheck and build scripts first run npm ci and the agent SDK build; its x402 draw module imports node:sqlite, which vitest 2 cannot load, so the SDK moved to vitest 3."
assumption = "The merged gate has npm registry access or a warm npm cache for the agent SDK's pinned dependencies."
severity = "note"
