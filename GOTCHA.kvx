observed = "Kubelet cannot authenticate to the mTLS-only webhook API. Use the existing health-only listener for probes while preserving all API authentication, and provide distinct identity tokens per caller role."

[gotcha.769]
title = "Task section identifiers"
observed = "Task16.4 already existed for registry readiness; maintenance producer creation refused before mutation. Select an unused task identifier and preserve the existing task."

[gotcha.770]
title = "Qualification source immutability"
observed = "A native recording build started against a mutable worktree and was stopped at exit143. Use a complete pinned tracked candidate with environment paths excluded before materialization."

[gotcha.771]
title = "Published source preimages"
observed = "Shared source worktree baselines predated already-published per-file changes. Validate actual file preimages against an explicit published base before any intake; never overwrite independent owner changes."

[gotcha.772]
title = "Cargo artifact hardlinks"
observed = "Cargo canonical executable shared a hardlink; genuine benchmark artifact capture refused its nlink. Copy verified bytes through safe descriptors into a private immutable single-link file, preserving the original nlink assertion."

[gotcha.773]
title = "Real wallet fixture adapters"
observed = "Path.open does not accept opener and the browser launcher needs the actual Playwright package executable. Use supported real library interfaces without changing wallet or browser assertions."

[gotcha.774]
title = "Anvil genesis identity"
observed = "Distinct chain IDs alone produced identical genuine Anvil genesis hashes. Select explicit distinct supported genesis timestamps and retain independent-chain assertions."

[gotcha.775]
title = "Emulator current maintenance evidence"
observed = "The emulator retains activity receipts before maintenance but lacked sealed evidence for the later root. Implement genuine maintenance batch evidence and verify that authority; never relabel an old activity receipt as current."

[gotcha.776]
title = "Registry publication authority"
observed = "The actual configured npm registry returned404 for @sidiora/layerx-express@0.1.0. Record missing publication; do not substitute a local package or invent registry provenance."

[gotcha.777]
title = "Build lock deadlines"
observed = "A final native build reached its cap while awaiting the shared build lock. Record exit124 and verification UNRUN; lock waiting is not compiler success."

[gotcha.778]
title = "Executable shim identity"
observed = "Resolving the Cargo executable symlink changed argv0 to rustup and refused before compilation. Preserve the actual shim entrypoint while checking its executable target; exact repair published separately."

[gotcha.779]
title = "Credential-safe candidate materialization"
observed = "Ordinary checkout ignored one sparse exclusion setup and materialized four task-owned tracked environment paths. Values were never read or hashed; remove only accidental private copies and use filtered checkout-index input before materialization."

[gotcha.780]
title = "Native maintenance digest contract"
observed = "Native authority identifies canonical maintenance receipts with raw SHA256 while ordinary receipts retain their domain digest. The unified gateway used the ordinary domain for both; task16.6 corrected the typed consumer and passed genuine captured-evidence cases."

[gotcha.781]
title = "Native proof fixture shadowing"
observed = "Two test-local Native bindings shadowed the real native fixture function, causing E0618. Keep all fixture assertions and use explicit function qualification in the dedicated compiler task."

[gotcha.782]
title = "Source handoff schema"
observed = "A repair manifest omitted base_revision and intake stopped before copying. Bind the exact published preimage, standardize the complete manifest, and preserve the original handoff."

[gotcha.783]
title = "Qualification window consumption"
observed = "Helper delivery, formatting publication and complete candidate preparation consumed most of several thirty-minute task windows. Freeze fully formatted source early, publish promptly, and reuse warm isolated caches; timeout or unrun checks remain unqualified."

[gotcha.784]
title = "Candidate refusal control flow"
observed = "A private build wrapper continued to wait on its build lock after candidate admission refused. The owner cancelled it before compilation; future wrappers must stop immediately on nonzero candidate creation."

[gotcha.785]
title = "Preserved proof negative-case disagreement"
observed = "After exact fixture-call compiler repair, eleven proof cases passed and two untouched negative cases failed at header bounds and maintenance-link error classification. Preserve assertions, record raw failures, and do not treat subset success as full qualification."

[gotcha.786]
title = "Cold candidate Git status"
observed = "Candidate admission retained its twenty-second Git-status bound. A cold large checkout exceeded that bound and returned a generic refusal; read-only status warmup then admission within the unchanged bound succeeded. Never loosen the bound or treat refusal as compiler evidence."

[gotcha.787]
title = "Provider Docker runtime for isolated CI"
observed = "The provider-default haishare Docker runtime rejected a CPU-only CI container. An isolated CI Docker daemon using runc passed; the provider default and production runtime configuration remained unchanged."

[gotcha.788]
title = "Cargo package and library names"
observed = "The gateway dependency uses the layerx-programs-registry package through its layerx-programs alias. Naming the dependency after only the Rust library causes Cargo resolution failure; bind the actual package and preserve the lockfile owner."

[gotcha.789]
title = "Execution terminal version boundaries"
observed = "Runtime guest ABI3/4 evidence conflicted with frozen execution-v4 ABI2 decoders. The owner approved a distinct execution-v5 domain for ABI3/4. Keep all legacy domains and malformed old-profile refusals intact."

[gotcha.790]
title = "Published source preimages"
observed = "Frozen source manifests must bind the actual previously published preimage. The v5 runtime retained the existing Market test module; intake refused its obsolete base until exact current preimages were recorded."

[gotcha.791]
title = "Immutable candidate mainline identity"
observed = "Candidate creation and verification must use the same exact PAXEER_X_MAINLINE revision. A moving main reference caused admission refusal before behavior; preserve the validator and bind both stages to the actual published source."

[gotcha.792]
title = "Native proof fixture authority"
observed = "The current executed-v4 native capture carries required TransferAuthority evidence. An obsolete executed-v3 fixture was correctly refused; use genuine current capture rather than weakening the proof requirement."

[gotcha.793]
title = "Market event capability fixture"
observed = "The genuine Market fixture caller requires EmitEvent authority. Add the actual grant to authorized positive setup and retain a separate real missing-grant refusal case; never bypass production authorization."

[gotcha.794]
title = "Idle agent activation"
observed = "Sending a message to a completed agent does not start its next turn. Delayed activation left Swift and .NET builds unrun at the approved cutoff; use followup_task when dispatching new work to an idle agent."

[gotcha.795]
title = "Corpus outcome and byte-type identity"
observed = "Successful native settlement transfers do not establish standalone settlement-failure coverage. Preserve all required outcome families. TypeScript canonical fixtures must use their declared Uint8Array type when deep equality checks the decoded value."

[gotcha.796]
title = "Private qualification log tracking"
observed = "The existing feature qualification log is local and absent from HEAD. Preserve its private tracking state while appending exact findings; do not force-add the historical log merely because task metadata is published."

[gotcha.797]
title = "Native test module and selector identity"
observed = "The complete v5 producer build exposed missing EXECUTION_V4/V5 imports only inside source_vectors. Repair1 imported existing constants and selected the actual source_vectors tests; all four build stages and the twelve-case focused gate then passed."

[gotcha.798]
title = "Short callback truncation fixture"
observed = "The genuine callback terminal is 84 bytes. TypeScript subarray(0,105) leaves those bytes unchanged, so the retained malformed-input rejection assertion fails. The exact proposed correction always removes bytes; exhausted repair allowance keeps it unapplied pending owner approval."

[gotcha.799]
title = "Explicit v5 asset authority binding"
observed = "The .NET v5 mutation case exposed an absent receipt Asset equality with independently authorized batch Asset. The scoped repair adds equality only for protocol3 ABI3/4 Program CALL, preserving the generic legacy Program exception and every assertion."

[gotcha.800]
title = "Producer and repaired consumer revision"
observed = "A retained genuine corpus does not satisfy a newer repaired consumer test that explicitly requires published candidate revision equality. Never reinterpret that environment binding, relabel the corpus or alter the assertion; capture genuine matching provenance under an authorized continuation."

[gotcha.801]
title = "Swift container build mountpoint"
observed = "A read-only source container refused before compilation because the ignored .build mountpoint did not exist. Creating only that private mountpoint allowed the original bounded build; retain initialization125 separately from the successful compiler result."

[gotcha.802]
title = "Root-required CI build outputs"
observed = "Native CI builds requiring root left build and .lane-target owned by root and prevented later runner checkouts. The published wrapper waits for build completion, restores the actual checkout owner on exit, and preserves the primary failure code; the scoped helper refuses unsafe links and unrelated paths."

[gotcha.803]
title = "CI host SSH identity"
observed = "The owner supplied an ubuntu SSH login for the dedicated CI worker. A root login failed; use the explicitly provided login and retain actual worker service UID ownership rather than guessing an account."

[gotcha.804]
title = "Codify subcommand help parsing"
observed = "cg spec claim --help was parsed as a task claim instead of help. Use cg help; do not treat a malformed help invocation as task admission."

[gotcha.805]
title = "JVM generated operation catalogue"
observed = "The actual generated Kotlin client exposes OperationCatalog.agent rather than the obsolete helper called by the probe. The scoped source correction uses the real catalogue; the retained assertions and closed operation set stay unchanged."

[gotcha.806]
title = "JVM v5 receipt asset authority"
observed = "The JVM v5 native mutation case requires exact equality between the receipt Asset and independently authorized batch Asset. The scoped explicit-v5 verifier now enforces that equality while retaining the generic legacy Program exception."

[gotcha.807]
title = "Cargo executable preparation"
observed = "A qualification launcher without the actual Cargo directory in PATH failed before any compiler started. Record that preparation failure separately and use the verified Cargo executable for the single admitted compiler pass."

[gotcha.808]
title = "Hosted registry public TLS API"
observed = "ureq 3.4.0 defines its key-kind enum in a private module without re-exporting it. Parse the same zeroized OpenSSL PKCS8 material through public PrivateKey::from_pem; retain exact key-kind, certificate equality and TLS validation. WireError provides Debug rather than Display."

[gotcha.809]
title = "Funded custody fixture producer gap"
observed = "The multiasset credit entrypoint and start_funded_multiasset_cluster consume an existing protected fixture. They do not provision genuine native Comet125 custody at 0x1013. A random Solidity vault or an Anvil balance cannot substitute for the missing real four-asset bootstrap producer."

[gotcha.810]
title = "Remote compiler export provenance"
observed = "A scoped compiler-input export is not a full immutable qualification candidate. Preserve its exact input hashes and bind it to the full admitted candidate, the retained compiler output and the genuine native corpus without relabeling revisions."

[gotcha.811]
title = "Canonical test helper shadowing"
observed = "The budget codec test bound a byte vector named canonical and then attempted to call the function of that name. Explicit self::canonical resolves the actual helper and preserves every vector and assertion; the fourteen-case focused test passed."

[gotcha.812]
title = "MCP compiler owner types"
observed = "The MCP field checker requires a Field reference, and Did exposes bytes rather than an as_str method. Pass the existing reference and require strict UTF8 for the exact stored textual identity; invalid encoding retains the existing alias refusal."

[gotcha.813]
title = "Authenticated event fixture enrollment"
observed = "The real event Service::open now consumes a signed enrollment snapshot instead of an in-memory principal map. The TLS fixture must publish the actual MAC-bound snapshot with private file modes and refresh against the genuine upstream before listening."

[gotcha.814]
title = "Human kit composition"
observed = "The UI gate rejects direct component-library imports and raw screen-level controls. Use existing kit components while preserving GET form identities and disabled options through the real selection primitive; do not silence the gate."

[gotcha.815]
title = "Dedicated Android toolchain prerequisites"
observed = "The pinned Swift action verified its archive signature but failed on storage exhaustion on the prior runner. Dedicated routing removed that cause and exposed the missing standard file utility. Preserve the pinned toolchain and all downstream artifact checks while supplying actual prerequisites."

[gotcha.816]
title = "Published vendor checksum coverage"
observed = "Two published Wasmi changes left eight per-file hashes stale while the upstream package digest remained correct. Bind each correction to its actual source commit, inventory the remaining package once, and retain the original failure before the bounded corrected verifier run."

[gotcha.817]
title = "Fresh beta CI evidence inputs"
observed = "Specification consolidation removed beta input files from clean checkouts. Recovered historical logs lack the later typed source authority and cannot be relabeled as current passes. The input producer captures a genuine current candidate command and keeps historical bytes separate."

[gotcha.818]
title = "Source inspection and fixture names"
observed = "The strict source observer refuses tracked sensitive-looking names, including public test certificates, while full candidates omit environment paths before materialization. Preserve the existing refusal until an explicit versioned profile is approved; do not invent clean-tree evidence or read credential values."

[gotcha.819]
title = "Frozen source intake shape"
observed = "Source intake requires complete status, worktree, base revision and a path/hash list. Normalize a worker map or complete-frozen label only from its explicit whole-source declaration and verified bytes before publication; metadata-shape failures do not count as compiler or test attempts."

