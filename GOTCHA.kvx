[gotcha.580]
text = "Enumerating downstream dependencies must summarize dependency readiness before display; release tasks repeat the full dependency closure and can overflow a tool response."

[gotcha.581]
text = "Capability ABI and storage historical single-file paths resolve to current module directories; no duplicate abi.rs or storage.rs should be introduced."

[gotcha.582]
text = "Agent SDK transport source lives under agent/sdk/typescript; discover exact paths before searching platform SDK globs."

[gotcha.583]
text = "Native program interface proofs do not contain registry source-publication status. Join the genuine registry observation to the authenticated program/version/codehash/head; do not infer unpublished from an absent native field. Deployment and current-head receipts are distinct identities."

[gotcha.584]
text = "Attestor activity signing requires retained original approved disclosure and approval binding; daemon ApprovalHold metadata and canonical bytes cannot manufacture that consent."

[gotcha.585]
text = "A dependency-ready task can still be refused admission because another in-progress task lists a shared path. Record the refusal; do not assume a private disjoint file lease overrides the Codify claim."

[gotcha.586]
text = "Qualification log paths can be absent in the current feature directory; discover the current evidence location before reading a historical path."

[gotcha.587]
text = "A completed implementation on a retained branch may never have reached main. Match the current paths and original source identity before crediting implementation or recovering its missing files."

[gotcha.588]
text = "Use the exact handoff filename supplied by a worker; a manifest may contain its complete result without a separate result.json."

