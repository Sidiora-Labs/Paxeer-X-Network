# GOTCHA.kvx - the repository's gotcha ledger.
#
# Every session reads this file before touching the tree. Every gotcha or
# small error met while working here is appended as one entry, so the next
# session starts already knowing it. Append-only; never rewrite history.
# When a gotcha stops being true, add resolved = "<what changed>" to it.
#
# Format: sectioned KV using the portable .kvx convention. String values are
# ALWAYS double-quoted. One key = value per line.
#   [gotcha.<n>]
#   area    = "build | test | git | spec | go | rust | node | chain | ops | tooling"
#   symptom = "what you see"
#   cause   = "why it happens"
#   do      = "what to do instead"
#
# Never write a hostname, an IP address, a secret, a credential, a person's
# name, a date, or the name of a model, an agent, a lane or a branch here.

[meta]
name    = "LayerX repository gotchas"
kind    = "gotcha-ledger"
version = "0.1.0"
status  = "active"
read_at = "session start, before the first edit"

[gotcha.1]
area    = "git"
symptom = "A commit command prints nothing for minutes after the commit has already been recorded."
cause   = "The post-commit hook runs cg git-sync, which hangs when several worktrees commit at once."
do      = "Check git log -1; if the commit is there, kill the post-commit process and carry on. Never re-run the commit for the same change."

[gotcha.2]
area    = "git"
symptom = "The advisory cg check pre-commit hook stalls when many worktrees commit in parallel."
cause   = "The hook indexes the tree and serialises on a shared lock."
do      = "Commit with --no-verify while a fleet is running; the hook is advisory, not a gate."

[gotcha.3]
area    = "go"
symptom = "Rebasing a Go task onto its feature branch conflicts on go.mod and go.sum."
cause   = "Parallel tasks each add their own require lines to the same module in the same wave."
do      = "Resolve as the union of both sides with identical pinned versions, then run a read-only go list ./... over the merged module; never drop a sibling's require."

[gotcha.4]
area    = "go"
symptom = "Types from go-ethereum do not line up between the root module and a nested module."
cause   = "The root go.mod replaces go-ethereum with the pax-geth fork; nested modules pin upstream go-ethereum without that replace."
do      = "Do not import root packages that expose geth types from a nested module; talk to the chain over JSON-RPC and ABI JSON instead, or add the same replace to the nested module on purpose."

[gotcha.5]
area    = "rust"
symptom = "cargo test -p <crate> <filter> exits 0 and the gate passes although nothing ran."
cause   = "A filter that matches no test name runs zero tests and still succeeds."
do      = "Name every test for the verify filter (prefix it with the filter word) and read the log: a run with 0 tests is a failure, not a pass."

[gotcha.6]
area    = "build"
symptom = "Parallel checkouts of the human or platform Rust workspaces fill the disk and rebuild from scratch each time."
cause   = "Each workspace target directory is 10 to 15 GB; every worktree gets its own by default."
do      = "Export CARGO_TARGET_DIR to one shared directory per workspace. Cargo serialises on the directory lock; waiting several minutes for the lock is normal."

[gotcha.7]
area    = "ops"
symptom = "Disk usage climbs to 95 percent with many worktrees present."
cause   = "Each worktree checkout costs about 1.5 GB before any build output."
do      = "Remove worktrees whose branches are already merged and clean (git worktree remove); keep the branches. Do not remove a worktree that a running agent uses."

[gotcha.8]
area    = "spec"
symptom = "cg spec lint prints many warnings for a new feature."
cause   = "Warnings name touches paths that do not exist yet; they are expected before the tasks run."
do      = "Zero errors is the pass criterion. Pass -f <feature> when the feature is not the active one in workflow.kvx."

[gotcha.9]
area    = "spec"
symptom = "A rebase conflicts on spec/<feature>/requirements.md, design.md or tasks.md."
cause   = "The markdown files are generated mirrors of spec.kvx and every task re-renders them."
do      = "Take the feature side of the mirrors, keep only your own task block in spec.kvx, then run cg spec render and commit the result."

[gotcha.10]
area    = "test"
symptom = "Verify logs vanish or clutter the tree."
cause   = "/.logs/ and *.log are gitignored at the repository root; anywhere else they show up as untracked files."
do      = "Write gate output to .logs/verify.log under the checkout root and record that path as the evidence log path."

[gotcha.11]
area    = "node"
symptom = "pnpm install --frozen-lockfile fails for an application that carries a package-lock.json."
cause   = "The repository standard is pnpm; an npm lockfile is not accepted by pnpm."
do      = "Run pnpm import once to derive pnpm-lock.yaml, delete package-lock.json, and commit the pnpm lockfile."

[gotcha.12]
area    = "chain"
symptom = "The public mainnet RPC hostname answers 400 plain HTTP request was sent to HTTPS port on /evm and 502 on /."
cause   = "The edge in front of it is misconfigured for its upstream scheme."
do      = "Do not point tests, tools or defaults at it until the edge is fixed; use a node RPC you control and keep the hostname behind a configuration variable."
resolved = "That hostname is not the public RPC. The documented endpoints are the sixteen numbered hosts in docs/site/docs/reference/public-rpc.md; all answer chain id 125, individual nodes can trail the head by thousands of blocks, so pool several and compare eth_blockNumber."

[gotcha.13]
area    = "chain"
symptom = "eth_getLogs over tens of thousands of blocks against a full node never returns."
cause   = "The node scans the range synchronously and the request outlives the client timeout."
do      = "Query in ranges of a few thousand blocks and walk forward; use the explorer database for history."

[gotcha.14]
area    = "chain"
symptom = "Kernel-dependent lx_ and px_ methods of the hosted endpoint have no live backend; the anchor precompile reports no finalised height."
cause   = "The kernel is not anchored on mainnet and the hosted endpoint is not deployed."
do      = "Build and test against chain state alone; kernel-dependent paths must answer a typed unavailable error, never hang or fake data."

[gotcha.15]
area    = "tooling"
symptom = "A dispatch call for a background worker reports an internal error although the worker started."
cause   = "The dispatch result can be lost while the worker itself keeps running."
do      = "Before dispatching again, check git worktree list and the branch tips for the task; a duplicate worker corrupts the lane."

[gotcha.16]
area    = "ops"
symptom = "du over the whole home directory exceeds the shell timeout."
cause   = "Hundreds of gigabytes of worktrees, build caches and module caches sit under it."
do      = "Measure one directory at a time or run the measurement in the background and read the output file."

[gotcha.17]
area    = "ops"
symptom = "SSH to a remote host resets during key exchange or closes right after connecting."
cause   = "The host's sshd connection slots are exhausted by unauthenticated login attempts."
do      = "Retry in a short loop with a few seconds between attempts; harden the host's sshd (rate limiting, key-only auth, a firewall allowlist) before relying on it."

[gotcha.18]
area    = "test"
symptom = "A worker's verify command passed before its rebase, and the rebase changed only lockfiles or go.mod."
cause   = "The task gate ran at an earlier revision than the one that landed on the feature branch."
do      = "Record the revision the gate actually ran at. A lockfile-only rebase does not require a rerun; the merged wave gate covers it."

[gotcha.19]
area    = "go"
symptom = "A threshold wrapper built on the alice library lets fewer signers than intended produce a valid signature."
cause   = "The library's threshold parameter is the number of shares needed to sign (3 for three-of-five), not the polynomial degree of 2."
do      = "Pass the signer count as the threshold and keep a test that proves one signer fewer cannot complete a signing session."

[gotcha.20]
area    = "rust"
symptom = "cargo test for a human or platform crate exits 101 with ClockError Unavailable before any test runs."
cause   = "Those crates require the runtime clock supervisor; a bare cargo test has no clock to attach to."
do      = "Run the test command through tools/runtime/run-with-clock.sh with LAYERX_RUNTIME_CLOCK_BIN pointing at a built layerx-runtime-clock binary, and record that wrapped command as the gate."

[gotcha.21]
area    = "git"
symptom = "The fast-forward merge of a task branch into its feature branch is refused again and again while a wave runs."
cause    = "Sibling tasks land between the rebase and the merge; any work in between reopens the window."
do      = "Rebase and fast-forward back to back with nothing in between, up to ten attempts; a rebase that only moved lockfiles or spec mirrors does not require a verify rerun."

[gotcha.22]
area    = "go"
symptom = "A nested module's go.mod lists the same require twice, once in the block and once standalone."
cause   = "Parallel tasks each added the root module require and the union resolution kept both; go tolerates the duplicate."
do      = "Collapse it to one line inside the require block in the next task that touches go.mod; do not open a task for it."

[gotcha.23]
area    = "go"
symptom = "A new module beside another module fails to compile with use of internal package not allowed."
cause   = "Go permits an import of a path containing internal only from the tree rooted at its parent, and a sibling module is outside that tree."
do      = "Expose an exported package with thin aliases in the owning module and depend on it through a require plus a relative replace; never copy the internal code."

[gotcha.24]
area    = "test"
symptom = "A long Go protocol test is killed after ten minutes with panic: test timed out."
cause   = "go test applies a ten-minute default timeout per package binary; serial multi-party sessions exceed it."
do      = "Run participants concurrently inside the test and keep the verify command's outer timeout as the only budget; never raise -timeout to hide a slow test."

[gotcha.25]
area    = "git"
symptom = "Merging a branch that tracks an imported application is refused because untracked working tree files would be overwritten."
cause   = "The original, unscrubbed copy of the application still sits untracked in the main working tree, and it can carry credentials."
do      = "Move the untracked copy outside the repository before merging and never add it; the tracked copy on the branch is the scrubbed one."

[gotcha.26]
area    = "git"
symptom = "A rebase onto a busy feature branch stalls after each replayed commit, and rebase --continue stalls too."
cause   = "The post-commit hook runs on every commit a rebase replays and hangs the same way it does after a plain commit."
do      = "Run the rebase in the background and poll the rebase state; stop only the hook process whose working directory is your lane. Never wrap rebase --continue in timeout: it kills the rebase after its commit has landed and the next reset --soft moves HEAD off that commit."

[gotcha.27]
area    = "git"
symptom = "Two lanes that both appended to the end of qualification.kvx conflict on rebase, and after the resolution the feature's last entry has lost its severity line."
cause   = "The conflict hunk starts inside the previous entry, so its trailing line ends up outside the marked block."
do      = "After resolving, read the entry before the hunk and restore its severity line; keep the feature's entries first and yours after them."

[gotcha.28]
area    = "git"
symptom = "rebase --autostash conflicts on qualification.kvx and leaves an autostash entry in the repository's shared stash list."
cause   = "Every worktree shares one stash list, and an autostash that fails to reapply stays there."
do      = "Commit with the helper before rebasing so nothing is stashed; never run a bare git stash in a lane."

[gotcha.29]
area    = "node"
symptom = "An application test fails at import with Missing specifier ./ed25519 in @noble/curves although the package's own tests pass."
cause   = "The package pins the dependency at one major and the consuming application dedupes it to a later major whose exports carry only .js-suffixed subpaths."
do      = "Import such subpaths with the .js suffix (for example @noble/curves/ed25519.js and @noble/hashes/sha2.js); it resolves under both majors."

[gotcha.30]
area    = "node"
symptom = "A package test script called with a trailing -- and a name runs every test file instead of the named one."
cause   = "The script already invokes vitest run, and the literal -- reaches vitest as an argument that matches nothing, so no filter applies."
do      = "Pass the filter as a plain positional argument without --, or run vitest directly with the file path; read the log to confirm which files ran."

[gotcha.31]
area    = "node"
symptom = "A vitest file under the jsdom environment cannot resolve fixture paths built from import.meta.url."
cause   = "Under jsdom import.meta.url is not a file: URL."
do      = "Build fixture paths from __dirname in those files."

[gotcha.32]
area    = "node"
symptom = "A tsconfig paths alias to a package inside the workspace compiles it without its type declarations."
cause   = "A paths mapping to source bypasses the package's @types resolution."
do      = "Map the types in the same tsconfig or reference the package's declaration file explicitly."

[gotcha.33]
area    = "ops"
symptom = "A platform machine is destroyed about two seconds after creation with no log line at all."
cause   = "A [[files]] mapping in the definition names a secret that is not set on the application, and init gives up before the process starts."
do      = "Set every mapped secret before the first deploy, or remove the mapping; read the machine's init events, not the application logs."

[gotcha.34]
area    = "ops"
symptom = "flyctl deploy reports the dockerfile named in [build] as not found although the path exists at the repository root."
cause   = "flyctl resolves the [build] dockerfile path relative to the configuration file's directory, not the working directory."
do      = "Build the image with docker from the right context and deploy with --image; flyctl scale count needs -y in a non-interactive shell."

[gotcha.35]
area    = "go"
symptom = "A threshold session over a custom transport hangs or refuses messages although every participant's own messages were delivered."
cause   = "The library's echo broadcast sends relays from detached goroutines after the participant's own send returns, and a hash-only relay message reports IsValid false."
do      = "Admit marked relays where the protocol needs them, count the expected relays in the transport flush before returning, and never judge a relay by IsValid alone."

[gotcha.36]
area    = "test"
symptom = "An application test that waits for a final state settles at once on the loading state and asserts against it."
cause   = "The loading state renders the same data marker as one of the final states, so the wait matches early."
do      = "Give the loading state its own marker and let the wait target the final marker only; do not accept the loading text in an assertion."

[gotcha.37]
area    = "test"
symptom = "The wallet application's visual-system acceptance test fails on a source file that never sets a colour."
cause   = "The test rejects any string literal starting with the word border, whatever follows it."
do      = "Keep border values in the theme tokens and avoid string literals beginning with that word in application sources."

[gotcha.38]
area    = "attestor"
symptom = "Every add-share through the daemon failed with the refresh participant-set error although the protocol tests passed."
cause   = "refresh.AddShare requires each contributor's peer list to hold only bundle members, while the daemon session also lists the new participant."
do      = "Keep the new participant in the transport session and give contributors a network whose PeerIDs leave it out."

[gotcha.39]
area    = "attestor"
symptom = "The daemon refuses a well-formed EVM transaction request with a decode error although the same bytes sign fine elsewhere."
cause   = "The evm_tx kind accepts only a typed transaction serialised with zero r, s and yParity; a serialisation carrying a signature or the legacy chain-id fields is rejected."
do      = "Serialise the unsigned typed transaction with empty signature fields before submitting it; do not send the signed form back."

[gotcha.40]
area    = "test"
symptom = "A test that starts several local daemons reports a ninety-second readiness timeout on one of them."
cause   = "The free ports were reserved one at a time and released before the processes bound them, so two daemons raced for one port and the loser exited."
do      = "Reserve every port together and hold them until each process has started, and watch each process for early exit so a bind failure is reported as such."

[gotcha.41]
area    = "ops"
symptom = "An internal-only application receives public addresses on its first deploy."
cause   = "The platform allocates public IPs to any application whose definition declares services unless the deploy is told not to."
do      = "Deploy internal applications with --no-public-ips and release any address that was allocated before that flag was used."

[gotcha.42]
area    = "ops"
symptom = "A liveness check across the private network fails right after a deploy and passes unchanged a minute later."
cause   = "The first private-network contact between freshly placed machines takes longer than a two-second dial."
do      = "Give the first probe a longer dial or one retry after a pause before concluding the peer is down; never treat one immediate failure as a verdict."

[gotcha.43]
area    = "go"
symptom = "Adding one module raises a shared dependency and go mod tidy shrinks go.sum by half, and a sibling branch's go.sum then conflicts on merge."
cause   = "Tidy prunes every entry the new graph no longer needs, so two branches that both tidied disagree on most of the file."
do      = "On such a conflict take one side whole, run go mod tidy once on the merged tree and commit the result; never hand-merge go.sum."

[gotcha.44]
area    = "attestor"
symptom = "A test that greps the audit log for a peer id or subject found nothing although the entry was written."
cause   = "audit.Log stores only the SHA-256 of Entry.Subject; kind, key id, decision, reason and session id are the only plaintext fields."
do      = "Put anything a test or operator must read back, such as silent peer ids, in Reason, and keep secrets out of it."

[gotcha.45]
area    = "attestor"
symptom = "Adding an agent expiry upper bound failed the existing tampered-expiry test, which expects a signature error for an expiry pushed an hour ahead."
cause   = "The new bound ran before signature verification, so a tampered expiry was reported as too far instead of as a bad signature."
do      = "Place new request bounds after the signature check and before the nonce is consumed, so tamper tests keep their error and a refused request never burns a nonce."

[gotcha.46]
area    = "attestor"
symptom = "Test identity tokens minted twice within one second are byte-identical, so a per-token replay record refuses the second signing request."
cause   = "The test minter sets only sub, iss, aud, iat and exp, and the replay record keys on the token hash."
do      = "Give every test token a random jti and mint a fresh token for each signing request."

[gotcha.47]
area    = "node"
symptom = "The wallet app release check's secret scan fails with tsconfig.tsbuildinfo: local artefact right after a clean type check."
cause   = "tsc --noEmit in human/apps/wallet writes an incremental tsconfig.tsbuildinfo, and the scan reports ignored local artefacts too."
do      = "Delete human/apps/wallet/tsconfig.tsbuildinfo after the type check and before running release-check.sh."

[gotcha.48]
area    = "node"
symptom = "A verify command that runs pnpm exec on a rebased lane reinstalls the workspace on its own and the verify log fills with installer output."
cause   = "package.json changed under the rebase, and pnpm exec installs before it runs when the lockfile and manifest disagree with node_modules."
do      = "Run pnpm install --frozen-lockfile at the workspace root right after a rebase and before the verify command."

[gotcha.49]
area    = "attestor"
symptom = "A well-formed lx_activity request is refused by the kernel policy although the payload decodes."
cause   = "The evaluator accepts an activity only when its network is the daemon's chain id, its actor is did:layerx: followed by the key's hex, its validity window covers the present moment, and its type has a decoder."
do      = "Build kernel activities on the daemon's chain id with the signing key as actor, a window around now, and a type the daemon decodes."

[gotcha.50]
area    = "ops"
symptom = "The gateway crashes at startup against the managed database with an error about an unrecognised startup parameter."
cause   = "The attach connection string goes through a connection pooler that rejects statement_timeout in the startup packet."
do      = "Use the direct connection string where one exists, or apply the timeout with a SET after connecting instead of a startup parameter."

[gotcha.51]
area    = "node"
symptom = "The image build fails while pruning development dependencies with ERR_PNPM_NO_OFFLINE_TARBALL."
cause   = "pnpm 12 cannot prune offline when a tarball for a production dependency is missing from the store it copied."
do      = "Prune with network access or install production dependencies in a separate stage from the same lockfile."

[gotcha.52]
area    = "node"
symptom = "corepack refuses to prepare pnpm in the image build."
cause   = "The workspace has no packageManager field, so corepack has no version to prepare."
do      = "Prepare the exact pnpm version explicitly in the Dockerfile until the field is added."

[gotcha.53]
area    = "attestor"
symptom = "A test that splits the same secret twice gets a zero share the second time."
cause   = "dealer.Split wipes the big integer secret passed to it once the shares are dealt."
do      = "Give every split its own secret value; never reuse a secret after splitting it."

[gotcha.54]
area    = "rust"
symptom = "LocalSigner::public_key fails to compile as a method not found."
cause   = "The method comes from the Signer trait, which must be in scope."
do      = "Import layerx_crypto::signer::Signer where the local signer's public key is read."

[gotcha.55]
area    = "attestor"
symptom = "Pointing the daemon's client CA at the gateway CA makes every node-to-node connection fail and generate hangs until it is refused."
cause   = "ATTESTOR_TLS_CA_FILE is also the CA the nodes use to trust each other's peer transport."
do      = "Give ATTESTOR_TLS_CA_FILE a bundle holding the node CA and the gateway CA together."

[gotcha.56]
area    = "test"
symptom = "Keeping both hunks of a rebase conflict in a Go test file leaves code that does not compile."
cause   = "When both sides add tests at the end of the same file the conflict hunk splits mid-function."
do      = "Take the feature's file whole, re-add your own functions and imports, and gofmt it."

[gotcha.57]
area    = "rust"
symptom = "A vector generator crate placed beside test data fails to resolve or resolves different versions than the workspace."
cause   = "A crate outside any workspace is its own root and picks its own dependency versions."
do      = "Give it an empty [workspace] table of its own and a copy of the workspace Cargo.lock so cargo run resolves the same pinned versions."

[gotcha.58]
area    = "attestor"
symptom = "The first refresh after replacing a lost node fails with a session mismatch."
cause   = "After an add-share the replacement stored epoch zero while the survivors kept their committed epoch, and refresh names its session after the epoch."
do      = "Carry the committed epoch in the add-share request, bind it into the session, and have survivors refuse a differing epoch."

[gotcha.59]
area    = "fleet"
symptom = "A lane rebase onto the feature branch hangs indefinitely."
cause   = "The repository post-commit hook runs the sync command inside every replayed commit of a worktree rebase and can block."
do      = "Rebase lanes with the hooks path pointed at an empty directory and let the helper run the hook once on the final commit."

[gotcha.60]
area    = "fleet"
symptom = "The fast-forward merge of a finished lane into the feature branch is refused."
cause   = "Another lane moved the feature tip between the lane's rebase and its merge."
do      = "Rebase the lane once more and repeat the fast-forward; never merge with a merge commit into the feature branch."

[gotcha.61]
area    = "attestor"
symptom = "A kms test cluster refuses the kernel send authorization sign with a policy error."
cause   = "The test cluster's kernel policy listed no asset operation, and the send authorization is checked under the asset send operation of the kernel policy; the sign kind symbol is KindLXSendAuth, not a longer name."
do      = "Give test clusters a kernel policy that allows asset operation 5 and reference the kind by its spec symbol."

[gotcha.62]
area    = "fly"
symptom = "Every open flyctl proxy drops at once."
cause   = "The first flyctl logs call after an automatic flyctl upgrade shuts down the old agent and its WireGuard tunnels."
do      = "Expect the drop after an upgrade, restart the proxies, and pin one flyctl version for a long-running operator session."

[gotcha.63]
area    = "attestor"
symptom = "Health reports snapshot and replica as null right after a deploy."
cause   = "Both fields fill only after the first scheduled snapshot and the first shipping pass that follows it."
do      = "Wait one snapshot interval plus one shipping interval before judging the replica path."

[gotcha.64]
area    = "identity"
symptom = "A fresh test sign-up yields no session and password sign-in answers email_not_confirmed."
cause   = "The identity provider requires email confirmation for new users."
do      = "Use a test identity created with auto-confirm in the provider dashboard for every live proof."

[gotcha.65]
area    = "fly"
symptom = "After a deploy one machine stays stopped, and the platform proxy skips a machine that is running."
cause   = "A deploy does not start a machine that was stopped before it, and the proxy routes only to machines passing their checks."
do      = "Start the machine explicitly after the deploy and read readiness through machine exec rather than the public address."

[gotcha.66]
area    = "fly"
symptom = "A managed Postgres status call leaks the cluster password into the terminal and logs."
cause   = "The JSON status output includes the credentials."
do      = "Pipe the status output only into a jq expression that writes a mode 600 file and never run it bare."

[gotcha.67]
area    = "ceremony"
symptom = "Deliver is refused with a window or key_exists error after an attestor restart."
cause   = "The ceremony flag is read once at process start, the window id is per process, the verification signature covers only keys the same process imported, and a half-delivered wallet cannot be resumed."
do      = "Open the window with a rolling deploy, run deliver to completion without restarting any attestor, then close the window with another deploy."

[gotcha.68]
area    = "wallet-host"
symptom = "A docker ps format asking for the restart policy fails on a template field."
cause   = "The restart policy lives in the inspect output, not in the ps template."
do      = "Read the restart policy with docker inspect."

[gotcha.69]
area    = "ops"
symptom = "pkill -f exits 144 and appears to kill its caller."
cause   = "The pattern matched the shell running the pkill command itself."
do      = "Match with a bracketed first character or use pgrep against a pattern absent from the caller."

[gotcha.70]
area    = "fly"
symptom = "An ssh console call fails with an API EOF and leaves an empty output file."
cause   = "The machines API dropped the connection transiently."
do      = "Check the output file is non-empty and rerun the single call."

[gotcha.71]
area    = "fleet"
symptom = "The commit helper runs past the tool timeout inside a lane although the commit has landed."
cause   = "The repository post-commit hook starts the sync command, which never exits inside a lane worktree."
do      = "Give the helper the maximum timeout, check the log for the landed commit, and kill the hung sync process once."

[gotcha.72]
area    = "attestor"
symptom = "A test cannot reproduce the bearer-token replay refusal through the kms signer."
cause   = "The signer gives every call a fresh random session id, so no two requests are ever identical."
do      = "Send the repeated request as a raw mutual-TLS call through the test-only cluster helper."

[gotcha.73]
area    = "fly"
symptom = "A deploy by image reference hangs for more than ten minutes on a platform API call."
cause   = "Without the local-only flag the deploy resolves the image remotely and the call can stall."
do      = "Build locally and deploy with the local-only flag against the local image."

[gotcha.74]
area    = "human-service"
symptom = "A live kernel send through attestor custody is refused with account_not_owned."
cause   = "The attestors own only protocol-3 account ids while the shared intents constant selects protocol 2 by default."
do      = "Under attestor custody the service defaults to protocol 3 and refuses any other configured value; keep it that way when the intents constant changes."

[gotcha.75]
area    = "gate"
symptom = "The wallet type-check target fails on a fresh checkout with unresolved module errors in the SDK."
cause   = "The SDK links the TypeScript agent SDK whose types live in its build output, and the recursive tsc run stops at the first failing package."
do      = "Run the SDK's own build script, which builds the agent SDK first, before the type-check target."

[gotcha.76]
area    = "lint"
symptom = "Clippy reports findings in one crate, and after fixing them a different crate or the binary fails."
cause   = "Clippy stops at the first failing crate or target, and the pedantic deny level applies to every path dependency of the named packages."
do      = "Before scoping a clippy repair, expect the whole dependency chain and both library and binary to need the pedantic level; sweep mechanical classes across the chain in one pass."

[gotcha.77]
area    = "lint"
symptom = "Every remainder-based divisibility check fails clippy after a toolchain update."
cause   = "The current clippy adds the manual is_multiple_of lint under the default group."
do      = "Rewrite unsigned remainder checks with is_multiple_of; grep the chain for the pattern rather than fixing one logged crate at a time."

[gotcha.78]
area    = "gate"
symptom = "A single failing test binary or package hides every result after it."
cause   = "cargo test and the recursive pnpm run stop at the first failure by default."
do      = "Run the aggregate gate with no-fail-fast and no-bail so every target reports; the gate script now does."

[gotcha.79]
area    = "human-service"
symptom = "Nearly every test in the human crates returns clock authority Unavailable."
cause   = "The supervised clock authority service added by the intent router is required by those tests and is not provided on the host."
do      = "Provide the clock authority on every host and CI runner that tests or runs the human service; crate-filtered wallet tests that pass do not prove the rest."

[gotcha.80]
area    = "gateway-tests"
symptom = "A gateway test file fails to start its throwaway Postgres with address already in use."
cause   = "The free-port helper releases the port before pg_ctl binds it, and parallel test files race for it."
do      = "Treat one such failure as a race, check the kept temp directory log before concluding it is lost, and rerun once."

[gotcha.81]
area    = "wallet-app"
symptom = "Lint rejects assigning a hook result to a module-level variable during render, and a variable named module."
cause   = "The React hooks globals rule forbids module-variable writes during render and the Next rule forbids the module name."
do      = "Store the hook result in a local and assign it inside a layout effect; rename the variable."

[gotcha.82]
area    = "fleet"
symptom = "A lane commit message carries a stale base revision after the feature moved."
cause   = "The lane fast-forwarded after a rebase without the soft reset and second helper run."
do      = "Whenever the feature moved, finish the rebase, soft reset and helper steps before the fast-forward; rewriting after landing means rewriting the feature branch."

[gotcha.83]
area    = "repo-layout"
symptom = "A brief names the wallet app path under the wallet directory and the lane finds nothing there."
cause   = "The app lives under human/apps/wallet, not human/wallet/app."
do      = "Name human/apps/wallet in every brief that touches the app."

[gotcha.84]
area    = "flyctl"
symptom = "A value fetched with flyctl ssh console -C arrives with a first line reading No machine specified, using <id> in region ams, and a file written from it is malformed."
cause   = "flyctl prints the machine selection notice on stdout before the command output."
do      = "Pass a machine explicitly or pipe the output through tail -n1 before writing it anywhere."

[gotcha.85]
area    = "cargo/docker"
symptom = "The human service image build fails with lock file needs to be updated but --locked was passed for cmd/layerxctl."
cause   = "cmd/layerxctl/Cargo.lock predates the pinned rustls patch version the workspace depends on."
do      = "Run cargo update -w inside cmd/layerxctl, confirm only the pinned crate moves, and commit the lock before the image build."

[gotcha.86]
area    = "docker/buildkit"
symptom = "Any Cargo.lock change reruns every cargo stage of the human service image, about six minutes at eight build jobs."
cause   = "A single COPY . . precedes all five cargo build steps, so one changed file invalidates them all."
do      = "Budget a full rebuild per repair cycle, or copy manifests and locks first when restructuring the Dockerfile."

[gotcha.87]
area    = "fly"
symptom = "A runtime directory created in the image for the service user exists on the machine without a volume."
cause   = "Fly keeps the image root filesystem, including /run, on the machine."
do      = "Pre-create service directories in the image; a role that keeps no state needs no volume."

[gotcha.88]
area    = "codify"
symptom = "The guard tool reports no task in progress although a spec.kvx task is in_progress."
cause   = "The guard reads Codify claims, not spec.kvx status."
do      = "Treat the guard as advisory on kvx-driven lanes and keep the spec status as the record."

[gotcha.89]
area    = "wallet-app"
symptom = "next build on the wallet app runs Turbopack and fails with Module not found on the SDK's .js specifiers, although the config defines a webpack function."
cause   = "Next 16 defaults to Turbopack, and withSentryConfig injects a turbopack key so the guard that stops a webpack-only config never fires; Turbopack has no extension alias for externalDir sources."
do      = "Build with next build --webpack and set experimental.extensionAlias for .js to .js, .ts and .tsx, as human/apps/web does."

[gotcha.90]
area    = "wallet-app"
symptom = "Webpack reports Package path ./sha3 is not exported from @noble/hashes for an import inside ethers."
cause   = "A global resolve.modules with the app's node_modules first makes every bare import, including nested pnpm dependencies, resolve to the app's own package versions."
do      = "Scope the app-first lookup to the external SDK source directories through a module rule's resolve option and leave the global order alone."

[gotcha.91]
area    = "containers"
symptom = "A per-Dockerfile ignore file that starts with * and then lists !dir exceptions looks like it would exclude everything."
cause   = "BuildKit still walks excluded parents when a later exception has that directory as a prefix, and the last matching pattern wins."
do      = "Use the whitelist form for small root-context images and put the excludes for .git, node_modules and environment files after the exceptions."

[gotcha.92]
area    = "wallet-app"
symptom = "The wallet PWA image cannot be built from any Dockerfile: webpack stops on node:child_process, node:crypto, node:https, node:http and node:path."
cause   = "human/wallet/sdk/src/modules/index.ts re-exports the whole agent SDK index, which includes Node-only modules, into the client bundle."
do      = "Give the agent SDK a browser-safe entry or import only the browser-safe modules from the wallet SDK before expecting a wallet image build to pass."

[gotcha.93]
area    = "containers"
symptom = "docker build --check fails on a Dockerfile whose FROM is an ARG defaulting to an in-repo image, with not found from the registry."
cause   = "The check resolves base image metadata, and none of the ghcr.io/sidiora-labs beta images named in the repository are published."
do      = "Build or pull the base image under that name before linting, or pass the build argument the real pipeline passes; do not drop the file from the check."

[gotcha.94]
area    = "containers"
symptom = "docker build --check exits non-zero on Dockerfiles that build fine, reporting FromAsCasing or LegacyKeyValueFormat."
cause   = "The check treats every lint warning as a failure, and the Blockscout-lineage Dockerfiles use lowercase as after FROM and the ENV key value form."
do      = "Write FROM ... AS and ENV key=value when a Dockerfile joins a linted directory; neither change alters the image."

[gotcha.95]
area    = "containers"
symptom = "The same Dockerfile path is right in one referrer and wrong in the next after a move."
cause   = "Compose resolves dockerfile relative to the build context, docker/build-push-action resolves file relative to the checkout, flyctl resolves build.dockerfile relative to the fly.toml directory, and the CLI resolves --file relative to the working directory."
do      = "Check which base each referrer uses before rewriting the path: context-relative for compose, repository-relative for the workflows and the CLI, and remember the flyctl rule from gotcha.34."

[gotcha.96]
area    = "agent-sdk"
symptom = "npm install --package-lock-only inside agent/sdk/typescript reports up to date and leaves the SDK's own package-lock.json unchanged while the repository root package-lock.json changes."
cause   = "The root package.json lists agent/sdk/typescript as a workspace, so npm treats the repository root as the project and records the new dependency there; the container build runs npm ci against the SDK's own lock."
do      = "Run npm install --prefix agent/sdk/typescript --workspaces=false --package-lock-only for the SDK lock and keep the root lock change too, both must carry the dependency."

[gotcha.97]
area    = "wallet-app"
symptom = "next build compiles the wallet app and then stops in the TypeScript step with Route src/app/api/token-metadata/route.ts does not match the required types of a Next.js Route, naming a helper function."
cause   = "Next 16 checks that a route module exports only the route fields, and the module exported its parser beside GET; the failure was never reached while webpack stopped earlier on the agent SDK's node imports."
do      = "Keep helpers in route modules module-local or in a sibling module; expect the next gate in the chain to surface once an earlier build failure is fixed."

[gotcha.98]
area    = "agent-sdk"
symptom = "A module that must run in the browser uses node:crypto for ECDH, HKDF and AES-GCM and Buffer for hex and latin1."
cause   = "The xweb api envelope was written against Node primitives although its callers include the wallet SDK's browser bundle."
do      = "Use @noble/curves secp256k1 getSharedSecret with the compressed output's x coordinate, @noble/hashes hkdf and randomBytes, @noble/ciphers gcm, and plain loops for hex and latin1; the byte layout matches Node's computeSecret, hkdfSync and createCipheriv with a 16-byte tag."

[gotcha.99]
area    = "spec-tooling"
symptom = "cg spec new takes whatever follows it as the feature name, flags included, creates spec/<that>/ with a template spec.kvx and three rendered mirrors, switches active_feature in spec/workflow.kvx, re-renders every pointer file and the other features' tasks.md mirrors, and leaves spec/workflow.kvx.lock behind."
cause   = "The subcommand has no argument validation and its render step is global, not scoped to the new feature."
do      = "Pass exactly one plain feature name; afterwards delete spec/workflow.kvx.lock and keep the re-rendered pointer files; to undo a wrong name delete the created directory and the lock file and check out the rewritten pointer files and mirrors."

[gotcha.100]
area    = "spec-tooling"
symptom = "cg spec lint --help does not print help; it lints the active feature and reports clean."
cause   = "The lint subcommand treats unknown flags as absent and defaults to the active feature."
do      = "Use cg spec lint -f <feature>; read the usage from spec/workflow.kvx and the fleet protocol instead of --help."

[gotcha.101]
area    = "spec-tooling"
symptom = "cg spec start leaves spec/<feature>/spec.kvx.lock behind as an untracked file that .gitignore does not cover, so git add -A would commit it."
cause   = "The spec commands take a lock beside the feature file and do not remove it on exit."
do      = "Delete spec/<feature>/spec.kvx.lock before staging a lane commit; never commit it."

[gotcha.102]
area    = "spec-tooling"
symptom = "cg spec done runs the task's verify_cmd itself, so the gate runs a second time at the same revision right after the agent's own run."
cause   = "The done command re-executes verify_cmd before its graph checks instead of reading the recorded evidence."
do      = "Expect that second run inside cg spec done, record the agent's own run as the evidence, and never launch a third run."

[gotcha.103]
area    = "tooling"
symptom = "The qualification format step has no shell formatter: shfmt is not installed on the build box."
cause   = "Only shellcheck ships with the box; the tab-indented style of the scripts under tools/ came from shfmt runs elsewhere."
do      = "Indent shell scripts with tabs by hand after the neighbouring script and run shellcheck -s bash as the lint; do not install a formatter inside a task."

[gotcha.104]
area    = "spec-tooling"
symptom = "cg spec done without --force refuses a shell-only task with symbol <function> not defined in the graph although the function exists and the verify_cmd passed."
cause   = "The code graph stores shell scripts as full text only and defines no symbols for bash functions, so every symbols entry naming a shell function fails the graph check."
do      = "Record the refusal once in the qualification log, set the task to implemented with cg spec implemented, and let the feature manager rule on the graph gate; never force."

[gotcha.105]
area    = "spec-tooling"
symptom = "cg sync and cg index exit 124 under a timeout while a fleet runs, and cg spec done reports the graph refresh skipped because the database is busy."
cause   = "Every worktree shares one graph database and one indexing gate, and any cg process in another lane holds it."
do      = "Do not wait on the index inside a task; run the verify_cmd yourself, record it, and let the graph catch up after the commit."

[gotcha.106]
area    = "spec-tooling"
symptom = "A shell-only task whose verify_cmd passed cannot be closed with a plain cg spec done."
cause   = "The graph indexes no shell functions, so the symbol check refuses every symbols entry naming one."
do      = "After the gate passed and its gate record is in the qualification log, close the task with cg spec done <id> -f <feature> --force; this is the ruled exception to the no-force rule, for shell-only tasks only."

[gotcha.107]
area    = "spec-tooling"
symptom = "A verify_cmd built on git grep -e <host> keeps failing after every host is gone because it also matches identifiers that spell the host with a dash, slash or colon in place of the dot."
cause   = "git grep defaults to basic regular expressions, where an unescaped dot is a wildcard; package names, Java packages and config filenames that share the host's words collide."
do      = "Write host probes with git grep -F, or escape every dot, and check what a proposed pattern already matches before it goes into a spec."

[gotcha.108]
area    = "shell"
symptom = "sed -i 's#old#new#g' aborts with unknown option to s when the pattern itself contains a hash comment line."
cause   = "The delimiter character appears inside the pattern text."
do      = "Pick a delimiter absent from both sides, or do multi-line literal edits with a short Python str.replace that asserts the needle occurs exactly once."

[gotcha.109]
area    = "platform-hosted"
symptom = "Splitting the developer plane onto separate dashboard, API and webhook hostnames in the kubernetes manifest breaks the beta contract check and the dashboard web UI."
cause   = "tools/ci/beta-contract-check.sh accepts exactly one webhooks Ingress host, and the dashboard web fetches /v1/dashboard same-origin from its own host."
do      = "Keep one host in the webhooks manifest Ingress; serve the split names at the bare-host edge instead."

[gotcha.110]
area    = "spec-tooling"
symptom = "cg spec start leaves an empty spec/<feature>/spec.kvx.lock behind, which git add -A would commit."
cause   = "The lock file is created for the status write and not removed afterwards."
do      = "Delete spec/<feature>/spec.kvx.lock before any add-all commit."

[gotcha.111]
area    = "spec-tooling"
symptom = "cg spec done fails a verify_cmd that passes when run by hand: sh reports a syntax error on an unexpected parenthesis and the task is refused with exit 2."
cause   = "The kvx reader keeps the backslash escapes of the verify_cmd string, so escaped double quotes and escaped dots reach sh literally."
do      = "Run the verify_cmd yourself after unescaping the kvx string, record the run as a gate entry, and set the status by hand when the only refusal is this quoting defect."

[gotcha.112]
area    = "identity-provider"
symptom = "A new LXIP operation whose handler returns an io::Error that is not InvalidData stops the whole provider listener instead of answering the peer."
cause   = "wire::serve maps only InvalidData to status 1 and propagates every other error kind out of Server::run, which is how durable-state failures are meant to halt the process."
do      = "Turn service-side faults the peer must survive, such as an unreachable key set or a disabled principal, into a typed status inside the handler; leave persistence errors propagating."

[gotcha.113]
area    = "identity-provider-tests"
symptom = "Counting JWKS fetches after reopening the assertion state reports one hit more than the wire calls made."
cause   = "Every State reopen installs a fresh AssertionVerifier with an empty key cache, so the first library call after reopen fetches the key set again."
do      = "Assert the fetch count before reopening the state, or expect one extra hit per reopen."

[gotcha.114]
area    = "spec-tooling"
symptom = "cg spec done without --force runs for many minutes at full CPU with no output while other lanes work the same feature, and never returns."
cause   = "The done subcommand re-indexes against the shared code graph in the main checkout and contends on its index lock with every other lane's spec tooling."
do      = "Bound the call with timeout; when it expires, kill it, set the task status line to done by hand only after the verify_cmd genuinely passed, delete spec/<feature>/spec.kvx.lock, and say so in the commit message so the manager can re-run the tool."

[gotcha.115]
area    = "ops-shell"
symptom = "Piping a script into a remote shell with ssh -n ... bash -s returns exit 0 and prints nothing on every host."
cause   = "The -n flag redirects the ssh client's stdin from /dev/null, so bash -s on the far side reads an empty script."
do      = "Drop -n when the remote command reads its script from stdin; keep -n only for commands that take no input."

[gotcha.116]
area    = "ops-shell"
symptom = "A per-host survey that greps journalctl --since over a time window overruns its timeout on hosts with large journals while the fast hosts answer at once."
cause    = "A time-window query walks the whole journal index; the survey pays that on every host."
do      = "Bound journal reads with -n <lines> -o cat into one variable and grep that, and keep the per-host timeout well under the caller's cap."

[gotcha.117]
area    = "bringup-probe"
symptom = "A probe that asks sixteen public RPC names for eth_blockNumber one after another reports the synced names as lagging by ten to thirty blocks."
cause   = "Each request takes a fraction of a second and the chain advances several blocks a second, so names asked first fall behind names asked last by more than the ten-block window."
do      = "Ask every name at once in background jobs into per-name files, wait, then compare the answers against the highest one."

[gotcha.118]
area    = "chain"
symptom = "A full node reports catching_up false while its head trails the public head by tens of thousands of blocks and its latest block time is hours old."
cause   = "Once block sync hands over to consensus the flag never returns to true; a node that then falls behind is fed old blocks by its peers at about chain speed and never closes the gap."
do      = "Judge sync by the gap to the highest public answer and by the latest block time against the clock, never by catching_up alone; restart the node so block sync refills the gap while the pruned peers still hold those blocks, and treat a gap approaching their retention window as urgent."

[gotcha.119]
area    = "tooling"
symptom = "hpx setup looks interactive: it prompts for the node type, moniker, public address and a confirmation."
cause   = "The type menu reads the terminal only when HPX_TYPE is unset; the other prompts read stdin and take their defaults on an empty line, and the script does not set -e."
do      = "Run HPX_TYPE=fullnode hpx setup with stdin from /dev/null for a non-interactive install with the default moniker and detected address."

[gotcha.120]
area    = "chain"
symptom = "jq over the node's /status with .result.sync_info prints nulls, and jq tonumber rejects EVM quantities such as 0x19afc7d."
cause   = "The fork's CometBFT status answers the document at the top level without a result wrapper, and jq parses decimal only."
do      = "Read .sync_info directly and convert quantities in bash with $((16#${q#0x}))."

[gotcha.121]
area    = "tooling"
symptom = "shellcheck reports SC2016 on a single-quoted command string that is sent to a remote shell."
cause   = "The expansions inside it are meant for the remote shell, which shellcheck cannot know."
do      = "Keep the single quotes and put a shellcheck disable=SC2016 directive on the line above, as the probe does for its remote inspection."

[gotcha.122]
area    = "test"
symptom = "A probe loop that feeds a while-read from a here-string stops after its first iteration under the test's ssh stand-in although the real ssh runs every iteration."
cause   = "The stand-in ignored the -n flag and piped its stdin through tee, so it consumed the rest of the here-string that the loop was reading."
do      = "Make every ssh stand-in honour -n by redirecting its stdin from /dev/null before running the command; the code under test may rely on that documented ssh behaviour."

[gotcha.123]
area    = "test"
symptom = "An assertion on the exact number of days a fresh certificate has left fails one run and passes the next."
cause   = "Whole-day arithmetic on notAfter minus now reads one day less as soon as a second has elapsed since signing."
do      = "Assert a prefix of the day count or a range, never the exact number, for material signed inside the same test run."

[gotcha.124]
area    = "tooling"
symptom = "After merging two lanes that each extended the same shell probe, shellcheck reports a variable used as an array and later assigned a string, although each lane's file passed on its own."
cause   = "Both lanes added a top-level variable of the same name at different points of the shared file, and git merged the two definitions without conflict because they sit in different hunks."
do      = "When a lane adds a top-level variable to a shared script, grep the feature branch for that name before merging and reconcile to one definition; a clean textual merge is not a clean shell file."

[gotcha.125]
area    = "build"
symptom = "With CARGO_TARGET_DIR exported the layerxctl target fails at the cp step and the node test cannot find its probe binary."
cause   = "make layerxctl copies from cmd/layerxctl/target/release and node-test.sh runs its probe from platform/hosted/node/tests/probe/target/release, both fixed in-tree paths."
do      = "Do not export CARGO_TARGET_DIR for platform-test-node; let the shared-target advice of entry 6 apply to the workspaces that honour it."

[gotcha.126]
area    = "chain"
symptom = "eth_getCode of the registry, custody and anchor precompiles returns 0x although they answer calls."
cause   = "Native precompiles have no bytecode at their address."
do      = "Prove a precompile with eth_call of one of its views (threshold(), depositCount(), layerXBindNonce(address)) encoded from its ABI under precompiles/, never with a code-size check."

[gotcha.127]
area    = "chain"
symptom = "eth_syncing on the chain's JSON-RPC fails with error -32000 not supported, and the latest block timestamp is hours behind a synchronised clock while advancing in real time."
cause   = "The EVM RPC omits eth_syncing and the block timestamps do not track UTC on this chain."
do      = "Test that a node follows the chain by reading eth_blockNumber twice a few seconds apart; do not gate on eth_syncing or on block age."

[gotcha.128]
area    = "spec-tooling"
symptom = "cg spec start leaves an empty untracked spec/<feature>/spec.kvx.lock that git add -A would commit."
cause   = "The lock file is neither removed by the tool nor listed in .gitignore."
do      = "Delete spec/<feature>/spec.kvx.lock before the commit."

[gotcha.129]
area    = "spec-tooling"
symptom = "cg spec implemented refuses a task whose touches list names a file that needed no change, and a second call can hang on the tool's lock while other checkouts run cg."
cause   = "The tool requires a worktree or tagged-commit change for every touched file, and its lock is shared across checkouts."
do      = "Record why the file needed no change in qualification.kvx, leave the status in_progress and say so in the report; kill a hung call and remove spec/<feature>/spec.kvx.lock before the commit."

[gotcha.130]
area    = "chain"
symptom = "A public JSON-RPC name whose head advances at chain speed was still tens of thousands of blocks behind the tip, so a settlement test against it ran on stale state."
cause   = "A lagging full node receives blocks at production rate and stays behind by a constant; head advancement cannot tell it from the tip and the RPC exposes no eth_syncing."
do      = "Point LAYERX_NODE_PAXEER_RPC_URL at a name the fleet probe measured at lag zero before the run; keep the head-advance assertion as the in-band check."

[gotcha.131]
area    = "ops"
symptom = "The registry serving host's own paxd binary and its dead full-node home are months older than the fleet, and publishing from them would ship a pre-fork binary."
cause   = "That host stopped being a node long ago while the fleet was upgraded in place by staging paxd.next files on each node; nothing copied the live binary back."
do      = "Read the live binary from a synced full node (hash the running unit's exe), verify it against the rollout record's sha256, and pass it as SRC_BIN; the six native libraries still come from the repository and the configuration from the host's config directory, as the publisher says."

[gotcha.132]
area    = "ops"
symptom = "hpx/hosting/deploy.sh run from a lane derives a registry revision that has no published release asset, so its download fails."
cause   = "It takes the last commit touching hpx/registry and the registry workflow, and a lane or merge commit can touch the workflow without producing a release."
do      = "Pass HPX_SOURCE_REVISION as the sha of the latest hpx-registry-<sha> release whose hpx/registry tree equals the lane's (an empty git diff between the two)."

[gotcha.133]
area    = "ops"
symptom = "nginx on the edge host is failed, and every deploy script that runs nginx -t or systemctl reload nginx fails."
cause   = "A retired testnet TLS vhost still enabled points proxy_ssl_trusted_certificate at a build directory that no longer exists, and reload refuses an inactive unit."
do      = "Unlink the retired vhost symlink from sites-enabled (file kept), confirm nginx -t, start nginx, then run the deploy script; when the permission system refuses those writes, record and report them instead."

[gotcha.134]
area    = "tooling"
symptom = "Running a repository publish or deploy script on the local box, or unlinking an nginx site there, is refused by the permission system as a production deploy or a shared-resource change."
cause   = "The classifier judges the outcome, not the host, so the local host writes of a deploy task are refused the same way as remote ones."
do      = "Do the code and probe part, run the verify once, record the refused commands as observations, set the task implemented and report; never route the refused step through another tool, session or host."

[gotcha.135]
area    = "human-service tests"
symptom = "Every test in a new integration file failed at fixture start with a 503 unavailable before any request was sent."
cause   = "ProvisionedAccounts::new refuses an empty account set with unavailable, so an IdentityServices stand-in built from an empty iterator never constructs."
do      = "Give the fixture at least one ProvisionedAccount for the principal the test admits, even when the services under test never touch passkeys."

[gotcha.136]
area    = "human-service exports"
symptom = "The library built with private_interfaces warnings, then the integration test failed to compile with 'type IdentityDispatchError is private' on the first call into the exported identity client."
cause   = "Exporting a client whose methods return Result<_, E> while E stays pub(crate) compiles inside the crate but leaves integration tests unable to name the result type."
do      = "When a crate-private client becomes a public export, make its error type pub and export it alongside in the same change."

[gotcha.137]
area    = "test"
symptom = "A blocksync test that tries to make the node's distance to its peer shrink by lowering the peer's height through SetPeerRange evicts the peer instead, and the pool's maximum peer height never goes down."
cause   = "SetPeerRange treats a base or height below the peer's previous report as a misbehaving peer and removes it; the maximum peer height only drops when the highest peer leaves."
do      = "Drive a shrinking distance by advancing the node's own height faster than the peer's height; never lower a peer's reported height in a test."

[gotcha.138]
area    = "consensus"
symptom = "A unit test that expects the lag self-remediation to restart on a constant or growing distance never sees the restart when it scripts a single check."
cause   = "The first check after the consensus handoff has no previous distance to compare against, so it only records the distance; the earliest restart is on the second check."
do      = "Script at least two checks for a restart-expected case, and judge a node's lag by the distance to the highest peer between two checks, never by whether its own height advanced."

[gotcha.139]
area    = "ops-shell"
symptom = "A tar stream built with the same exclude list as an rsync copy still carries the snapshots directory."
cause   = "rsync reads --exclude=snapshots/ as a directory match, while tar matches the pattern against path components and a trailing slash never matches."
do      = "Write shared exclude lists without a trailing slash; --exclude=snapshots excludes the directory under both tools."

[gotcha.140]
area    = "test"
symptom = "Every case of a probe fixture test fails on its no-destination check although the output names no fixture host."
cause   = "The check greps for (up|down|hang)- followed by a letter, and the node config key restart-cooldown-seconds matches it through cooldown-s."
do      = "Anchor the fixture-host pattern with a word boundary, \\b(up|down|hang)-, and keep fixture host prefixes out of real key names."

[gotcha.141]
area    = "spec-tooling"
symptom = "cg spec done re-runs a passing verify_cmd and then refuses a Rust task with symbol <name> not defined in the graph, where the symbols entry names the integration test target or a fixture function inside it."
cause   = "The graph checks run against the last completed index, which has not seen a file added by the task, and a test target name is never a symbol at all; under a busy graph the checks are not retried before the refusal."
do      = "Name only graph-defined library symbols in a task's symbols entry, never a test target or a test-local function; when the refusal is only this, record it, set the status by hand after the genuine pass and say so in the commit line, and do not retry, since each retry runs the verify again."

[gotcha.142]
area    = "human-service tests"
symptom = "An integration test that proves the components loader has to set the whole LAYERX_HUMAN_ environment, and two such tests in one binary would race on the process-global variables."
cause   = "The loader reads only the process environment, cargo runs the tests of one binary on parallel threads, and env::set_var and remove_var are visible to every thread."
do      = "Keep every environment-touching step of one loader proof inside one test function, set the variables right before from_environment and remove them at the end; let sibling tests in that binary read no environment."

[gotcha.143]
area    = "spec-tooling"
symptom = "cg spec done refuses a task whose verify_cmd it just reran to exit 0 with symbol not defined in the graph, and the symbol named in the task does not exist under that type."
cause   = "The symbols line was written from the type that owns the components, while the environment loader is a method of the configuration type, and the graph check is exact."
do      = "Check every symbols entry against the real definition before starting the task; correct a mis-named symbol inside your own task block, record the refusal once, and set the status by hand after the genuine pass."

[gotcha.144]
area    = "kernel"
symptom = "An LNI balance read of a freshly bootstrapped agent main account is refused with -208 LXP_ERR_UNKNOWN_ACCOUNT_NAMESPACE although the name and the derived id are canonical."
cause   = "The daemon returns that code for any id absent from the kernel account registry; a fresh genesis holds only the three system accounts and a main account is opened by its first credit or a sponsored onboarding, never by identity registration."
do      = "Treat -208 on a read as account-not-yet-opened before suspecting the derivation; compare the name hash on both sides only after listing the DID's accounts through the kind-3 read."

[gotcha.145]
area    = "build"
symptom = "The node test failed at its first line on a clean build directory because build/bin/layerx-genesis-build was missing, although the same verify command had passed elsewhere."
cause   = "platform-test-node listed only layerxctl and layerx-handover as prerequisites; a build directory that already carried the genesis builder hid the gap."
do      = "Keep every binary node-test.sh requires in the platform-test-node prerequisite list; when a gate passes on one checkout and fails on another, diff build/bin before suspecting the code."

[gotcha.146]
area    = "kernel"
symptom = "A signed SEND from a freshly bootstrapped treasury identity is refused at admission with class 4 result -602 FeeUnpayable, never acknowledged."
cause   = "The sequencer resolves the fee payer through agent:<did>:main, which does not exist before its first credit, so the fee balance is zero and admission stops before sequencing."
do      = "Fund or credit the main account before asserting an acknowledged submission; on a fresh genesis assert the typed refusal, as the core boundary test does."

[gotcha.147]
area    = "genesis"
symptom = "The bootstrap's treasury balance option looks like a genesis allocation knob, but any non-zero value is refused and the value only lands in node.env and treasury.json."
cause   = "The genesis manifest account record carries no name or authority key and its validation admits only the system accounts at balance zero, so the builder has nothing to allocate to."
do      = "Treat the option as documentation of the genesis zero; fund a main account through a credit activity after genesis, or extend the manifest record, builder request, validation, materialisation and supply seed together before allowing a non-zero value."

[gotcha.148]
area    = "tooling"
symptom = "The custody credit fixture pipeline behind the daemon onboarding tests cannot start on a box whose default python3 lacks eth_account, although forge, cast, go and paxd are all present."
cause   = "withdraw-custody.py and the custody chain helper import eth_account and cryptography directly and the Makefile's BRIDGE_PYTHON defaults to python3 with no venv."
do      = "Before dispatching any task that reuses the first-credit path, run python3 -c 'import eth_account, cryptography' under the BRIDGE_PYTHON the gate will use and name that interpreter in the prompt."

[gotcha.149]
area    = "tooling"
symptom = "The custody fixture's local chain refuses to start with 'init-chain: paxd lacks the loopback RPC bind setting; rebuild the current source'."
cause   = "The paxd on PATH is an installed release build without the loopback RPC bind setting that init-chain.sh requires."
do      = "Make the test target depend on paxeer-build and pass PAXD naming build/paxd, as the human and agent test targets already do."

[gotcha.150]
area    = "client"
symptom = "A probe read over the LNI fails with AuthorityRangeMismatch although the handshake, network id and sequencer key are right."
cause   = "The client compares the signed batch header's response authorization (sequencer id, key, first and last batch) with the read context's SequencerAuthorization, which a context built as (key, key, 1, latest sealed batch) does not match; batch 0 has no header, so no read carries evidence before the first seal."
do      = "Wait for a sealed batch, fetch its header with batch_header and build the authorization from its sequencer id and batch range in every read helper of the probe at once, since each helper builds its own context."

[gotcha.151]
area    = "tests"
symptom = "Running withdraw-custody.py in its default mode leaves evidence files under qual-logs/set1 that git add -A would commit."
cause   = "The script's default evidence directory is qual-logs/set1 at the repository root and no ignore rule covers it."
do      = "Run it with --export into the test's temporary work directory, or clear qual-logs before committing."

[gotcha.152]
area    = "tests"
symptom = "A first credit signed by sign-credit is admissible for only five minutes after it is signed."
cause   = "sign-credit sets not_before to the signing wall clock and not_after five minutes later, and the daemon admits against its own wall clock."
do      = "Export the credit in the same test run right before the supervisors start and submit it as soon as the node answers; never cache a signed credit across runs."

[gotcha.153]
area    = "tooling"
symptom = "shellcheck on the node test script exits 1 on the base revision."
cause   = "Two pre-existing SC2015 info findings (A && B || C used as if-then-else) sit in the script."
do      = "Compare shellcheck findings on that script against the base revision before treating a non-zero exit as a regression."

[gotcha.154]
area    = "client"
symptom = "A probe read over a raw LNI transport cannot reuse the header-derived authorization of a Client read, because Client keeps its transport private and does not expose every read."
cause   = "Client::batch_header wraps batch::lookup on its own transport, while reads Client lacks (the DID account listing) run on a separately handshaken Uds transport."
do      = "Build the authorization in one helper that takes the header fetch as a closure: client.batch_header for Client reads, batch::lookup on the raw transport for the others."

[gotcha.155]
area    = "kernel"
symptom = "Right after an acknowledged submission, a repeated layerxctl submit fails before sending with state read CoreRefusal class 4 result -903 LXP_ERR_PROJECTION_STALE."
cause   = "Preparation reads answer only when the receipt authority and the program feed have scanned through the kernel head, which holds again only once the admitted activity is sealed; -903 is the retriable pending answer."
do      = "Wait, bounded, until a preparation read (layerxctl read-state) answers before resubmitting; treat -903 as pending, as the registry's head classifier does."

[gotcha.156]
area    = "tests"
symptom = "An inode comparison meant to prove a reset re-created a file fails although the supervisor log shows the bootstrap re-ran with a new genesis state root."
cause   = "The reset clears the data directory before the bootstrap writes the new file, and ext4 hands the freed inode number straight to the new file."
do      = "Hold the old file open across the reset so its inode stays allocated; do not hard-link it, since the daemon's artifact loaders refuse a file whose link count is not one."

[gotcha.157]
area    = "tests"
symptom = "Right after a supervisor reset the node test finds the checkpoint directory non-empty."
cause   = "The reset replies only once the restarted sequencer is ready, and that daemon writes initialized-genesis.lxg, the prepared-batch group files, da-bodies.log, its admission log and da/ at startup."
do      = "Do not read directory emptiness after a reset as proof of a missed discard; compare the pre-reset files' identities instead, once that assertion change is ruled."

[gotcha.158]
area    = "tests"
symptom = "An inode comparison meant to prove a reset replaced a directory can pass or fail by chance."
cause   = "Once the old directory is removed ext4 may reuse its inode number for the recreated directory, just as it does for files."
do      = "Hold an fd on the old directory across the reset (exec {FD}<dir) before comparing inode numbers, then close it."

[gotcha.159]
area    = "gateway tests"
symptom = "A local single-threaded TLS upstream that loops on keep-alive requests stalls the gateway's next connection for its read timeout."
cause   = "The listener thread stays inside one kept-alive connection while the gateway opens a fresh one that waits unaccepted in the backlog."
do      = "Serve one request per accepted connection in test upstreams, as tests/support/payment_events.rs does."

[gotcha.160]
area    = "gateway tests"
symptom = "Including tests/support/payment_events.rs for its TLS listener pulls its own payment test and its RedisProcess and helper imports into the new test binary."
cause   = "The support file holds a #[test] and takes command, fs, path, Duration, RedisProcess and TcpListener from its parent module."
do      = "Keep a new gateway integration test self-contained with its own small TLS upstream rather than including that support file."

[gotcha.161]
area    = "docs"
symptom = "Removing a retired host from platform/docs/beta-environment.md or platform/docs/content/beta.md makes tools/ci/beta-contract-check.sh fail."
cause   = "The contract check requires both pages to repeat the endpoint literals of platform/hosted/testnet/src/lib.rs, .github/workflows/platform.yml and the testnet deployment, including the faucet claims origin and the status host."
do      = "Change a beta contract hostname only together with its sources and the contract's contradictions table, or get a ruling first; never edit the pages alone."

[gotcha.162]
area    = "docs"
symptom = "A literal 'no FAUCET_URL' docs check also hits LAYERX_FAUCET_URL, which the private-network faucet pages and the disposable-cluster env file legitimately document."
cause   = "The retired public variable is a suffix of the private cluster's variable."
do      = "Match FAUCET_URL as a whole identifier (git grep -w); treat LAYERX_FAUCET_URL on a private-network page as allowed."

[gotcha.163]
area    = "explorer-ops"
symptom = "The public RPC name serving the lowest first block was not the archive node but a frozen pruned node."
cause   = "A pruned node that stopped following the head keeps its retain window below its own stale head, which can sit under the archive's state-sync start."
do      = "Identify the archive as the name the explorer is configured with, or the lowest first block among names within ten blocks of the head; never the lowest first block overall."

[gotcha.164]
area    = "ops"
symptom = "Reading the explorer's Railway variables, setting its RPC variables and writing production RPC names into a repo README were each refused by the permission system."
cause   = "The classifier treats variable reads as credential materialization, variable sets as a production deploy and production names in repo files as sensitive detail."
do      = "Attempt each once, write the ordered commands with placeholders into the private handoff, keep repo docs names-only, and report implemented, not qualified."

[gotcha.165]
area    = "spec"
symptom = "The explorer task names ETH_CALL_URL, which the backend never reads."
cause   = "The spec shortened ETHEREUM_JSONRPC_ETH_CALL_URL, the name config_helper.exs reads."
do      = "Check each variable name against explorer/backend/config/config_helper.exs before setting it."

[gotcha.166]
area    = "tooling"
symptom = "Writing a test file through a bash heredoc is refused by the session's removal safety check when the file's content holds rm \"$dir/$name/...\"."
cause   = "The check scans the whole command text, heredoc bodies included, and treats an rm target built from possibly empty variables as a root removal."
do      = "Write every rm target in scripts as \"${dir:?}/${name:?}/...\" so an empty variable stops the shell; that form also passes the check."

[gotcha.167]
area    = "tooling"
symptom = "The qualification step 'format touched files' cannot run for shell scripts on the build box."
cause   = "shfmt is not installed and the repository pins no shell formatter."
do      = "Keep the existing tab style by hand, run bash -n on every touched script as the format step, and say so in the gate record."

[gotcha.168]
area    = "test"
symptom = "A test that runs another fixture test inside it can hand the inner test its own PATH stand-ins as the real tools."
cause   = "The inner test records command -v curl (and rsync, sha256sum, df) as the real binaries before prepending its own stand-ins."
do      = "Save PATH before installing stand-ins and run the nested test with PATH set back to that saved value."

[gotcha.169]
area    = "platform"
symptom = "platform-hosted-topology-check fails the node StatefulSet on an env value whose configMapKeyRef is marked optional: true."
cause   = "The topology checker resolves every configMapKeyRef against the manifest's ConfigMap data and does not honour the optional flag."
do      = "When adding an optional configMapKeyRef to a manifest, also add the key to the ConfigMap or run the topology check before handing the task over; never relax the checker inside an unrelated task."

[gotcha.170]
area    = "spec"
symptom = "A task's do lines name abort points from an older readiness report that are already closed at the task's base revision."
cause   = "The readiness report predates later lanes that fixed most of its items, and the task text was carried forward unchanged."
do      = "Check each listed abort point against the current code before editing; record the ones already closed in qualification.kvx instead of re-editing their files."

[gotcha.171]
area    = "human"
symptom = "The movement provider's probe cannot reach a healthy answer from a plain local chain emulator when the provider runs from its environment."
cause   = "The environment-configured provider requires at least two pinned-TLS origins on distinct hosts with agreement two and a configured execution authority before it answers Ready."
do      = "In a binary-level test, front the local chain with TLS listeners on two loopback addresses (127.0.0.1 and 127.0.0.2) under one CA-signed certificate carrying both IP SANs, pass that CA as PAXEER_CA_DER, and give every file the provider reads mode 0600 and a single link."

[gotcha.172]
area    = "tests"
symptom = "A gate that must replay a recorded fixture captured from the live chain cannot be qualified by a worker that has no route to the chain's JSON-RPC."
cause   = "Workers may not read production endpoints, and a hand-written fixture would be a fake."
do      = "Ship the capture mode with the test, record the missing capture as an observation, and dispatch the capture step to someone with loopback access to a synced node before the rerun."

[gotcha.173]
area    = "tests"
symptom = "The lxp_test_daemon_finality_authority binary looks free to rewrite, but its prepare and emit modes feed the handover, guarantor and availability chain scripts."
cause   = "Several tests/daemon Python drivers call that binary directly with their own arguments."
do      = "Add new modes beside the existing ones and grep tests/daemon for the binary's name before changing its command line."

[gotcha.174]
area    = "bringup-probe"
symptom = "A placement probe that compares a public name's DNS answer with the host map needs a resolver it can fake in the fixture test without the network."
cause   = "check-live.sh has no DNS helper; getent is the only resolver it can call, and the fixture destinations are not addresses."
do      = "Resolve with getent ahosts, compare against the destination with any user@ prefix stripped, and put a getent stand-in on the test PATH that maps apiN to fixture destinations."

[gotcha.175]
area    = "tools"
symptom = "tools/bringup/docs-names.sh stopped with 'cannot read the router' after the spec renamed the router, and 'sh docs-names.sh' fails on set -o pipefail."
cause   = "The script compared the parsed allowed list against a literal router name, and it is a bash script run through dash when invoked with sh."
do      = "Derive every checked name from the spec key that holds it, and run the bringup scripts through their shebang or bash."

[gotcha.176]
area    = "names"
symptom = "Renaming developers.paxeer.network before api.developers.paxeer.network yields api.dev.paxeer.network instead of api-dev.paxeer.network."
cause   = "The rename gate matches substrings, so longer names that contain a shorter old name are rewritten by the shorter rule first."
do      = "Apply the rewrite rules longest name first in one sed pass."

[gotcha.177]
area    = "ops-shell"
symptom = "A probe that treats curl exit 7 with 'refused' in its error text as a closed port fails on ports that are genuinely refused with a tcp reset."
cause   = "Current curl prints 'Could not connect to server' for a refusal and an unreachable host alike, both as exit 7."
do      = "Tell a refusal from an unreachable host with a bare connect through bash's /dev/tcp under timeout, whose error carries the system's 'Connection refused' text."

[gotcha.178]
area    = "ops-shell"
symptom = "A sed range from a shell function's first line to the next line starting with } stops inside the function."
cause   = "A here-document inside the function (an nft ruleset, for one) holds its own closing brace at column zero."
do      = "Extract such functions up to a marker comment that follows them, or source the script behind a guard instead of cutting it with sed."

[gotcha.179]
area    = "tests"
symptom = "A Python readiness poll hangs forever instead of timing out while the service it polls is healthy."
cause   = "The assertion message was built eagerly with process.stderr.read(), which blocks until the child closes stderr, so the loop never reached its deadline."
do      = "Read a child's piped stderr only after poll() reports it exited; never inside an always-evaluated assertion message."

[gotcha.180]
area    = "fly"
symptom = "A service started under setpriv as its own uid exits with Permission denied reading its TLS key although the key directory was chowned to that uid."
cause   = "tools/bringup/ca.sh creates the certificate root on the volume through flyctl ssh console as root under umask 077, so the parent directory is root 0700 and the service uid cannot traverse it."
do      = "In the app's root init, chown the service's own certificate directory and chmod 0711 its parent before dropping privileges."

[gotcha.181]
area    = "fly"
symptom = "A machine that crash-looped before a fixed redeploy stays stopped after the redeploy and every probe reports started=0."
cause   = "The crash loop hits the max restart count of ten, and a deploy does not start a machine that was stopped before it (gotcha 65)."
do      = "After redeploying a fix over a crash loop, run flyctl machine start on the machine and read its log for the listening line before probing."

[gotcha.182]
area    = "fly"
symptom = "A non-root image cannot read files that ca.sh wrote to its volume, and fly.toml offers no way to run the machine's process as root."
cause   = "Fly init honours the image USER, while ca.sh writes key material as root through ssh console."
do      = "Give the Dockerfile a separate fly target without USER whose root init prepares the volume and execs the binary under setpriv, and keep the default last stage unchanged for other runtimes."

[gotcha.183]
area    = "tests"
symptom = "Once layerxd binds its finality authority at startup, every test that launches the sequencer with invented settlement and registry addresses and an unused RPC port exits with result -3."
cause   = "The bind requires both pins to be the anchor precompile and a loopback JSON-RPC that answers the chain id, threshold and finalized-checkpoint calls."
do      = "Point those tests at LAYERX_NODE_PAXEER_RPC_URL served by a replay of tests/daemon/fixtures/finality-authority/rpc.json with its chain id, and drop the invented pins."

[gotcha.184]
area    = "tests"
symptom = "The real-node authority test fails on a /readyz field count right after the sequencer starts."
cause   = "readiness() gained protocol_network_id, but the test still asserts three fields; the failure stayed hidden while the sequencer could not start."
do      = "Treat it as a recorded code-versus-assertion conflict awaiting a ruling, not as a finality-authority failure."

[gotcha.185]
area    = "tests"
symptom = "The real-node authority test fails in stages: after one stale assertion is fixed, the gateway's authorized-batch lookup returns 503 receipt_source_unavailable."
cause   = "The sequencer did not start in this test for a long time, so several later checks were never run; layerxd's LNI now refuses the authority's lookup with -105 (malformed envelope)."
do      = "Expect more hidden failures further down this test; record each one with its line and result code instead of reading it as a finality-authority failure."

[gotcha.186]
area    = "platform"
symptom = "Fixing the first failure of the topology check exposes a second, unrelated failure in its regression suite."
cause   = "topology-check.sh runs topology-regressions.py only after the main check passes, so any main-check failure hides staleness in the regression suite's named edge lists."
do      = "When a manifest gains an env edge, add it to the matching named edge list in topology-regressions.py in the same change, and expect a first green main check to surface regression-suite drift."

[gotcha.187]
area    = "human"
symptom = "A provider probe test fails with only 'provider exited before binding' and no reason."
cause   = "The test spawns the provider binary without surfacing its stderr when the child exits before its socket appears."
do      = "When a spawned provider exits early in a binary-level test, include the child's exit status and captured stderr in the panic message so one run is enough to diagnose it."

[gotcha.188]
area    = "nginx"
symptom = "nginx -t refuses a split_clients block whose body is an include line with invalid percent value include."
cause   = "split_clients parses every line of its block as a percent and a value and does not honour include inside the block."
do      = "Render the whole split_clients block into the included file and include that file at http level; an empty block is accepted and leaves the variable empty."

[gotcha.189]
area    = "nginx"
symptom = "An nginx listen [::]:PORT line in a container answers only IPv6 clients."
cause   = "nginx sets ipv6only=on for an IPv6 wildcard listen by default."
do      = "Write listen [::]:PORT ipv6only=off when one line must accept both families, as the Fly proxy and a local IPv4 check need."

[gotcha.190]
area    = "containers"
symptom = "Alpine's nginx package serves its own default page on port 80 beside a new vhost, and files fetched with ADD from a URL land with mode 0600, unreadable to the nginx workers."
cause   = "The package ships /etc/nginx/http.d/default.conf, and remote ADD sources get owner-only permissions."
do      = "Remove http.d/default.conf in the image and fetch checksum-bound files with curl and sha256sum -c in a build stage, copying them in with COPY --from, as docker/hpx-registry/Dockerfile does for the landing fonts."

[gotcha.191]
area    = "bringup-probe"
symptom = "A check that a public name has moved to a Fly app cannot rely on DNS when the name keeps resolving to the edge host and the edge proxies it to the app."
cause   = "Behind an edge proxy the record never changes, so a CNAME or address check cannot tell the edge-local service from the proxied app."
do      = "Compare the name's answer with the app's answer at its fly.dev name and require the fly-request-id header the Fly edge adds, which nginx passes through from its upstream."

[gotcha.192]
area    = "nginx"
symptom = "Copying an apiN site file from one RPC node onto another node that serves its own apiN name would fail nginx -t."
cause   = "Each apiN site file carries the two http-level map blocks for the upgrade and backend variables, and a second definition of the same map variable is a duplicate."
do      = "Copy only the server blocks of the moved name and rely on the maps the node's own site already defines, after checking both maps are identical; install it in sites-available and enable it only once its certificate exists."

[gotcha.193]
area    = "rust-tests"
symptom = "cargo test -p layerx-crypto fails to compile the account-derivation tests with ed25519::Error not implementing std::error::Error, while a workspace-wide build compiles them."
cause   = "Built alone the crate enables ed25519-dalek without std, so k256's signature error type lacks the StdError impl that `?` into Box<dyn Error> needs; other workspace members turn std on through feature unification."
do      = "In tests of that crate convert k256 signing errors with .map_err(|error| error.to_string())? instead of a bare ?, and qualify crate tests with -p so a unification-only pass is caught."

[gotcha.194]
area    = "tooling"
symptom = "git grep -x fails with unknown switch although grep -x matches whole lines."
cause   = "git grep has no whole-line flag."
do      = "Anchor the pattern with -E '^...$' in git grep."

[gotcha.195]
area    = "nginx"
symptom = "nginx -V lists the stream and ssl_preread modules, yet a stream block fails to load on the edge."
cause   = "The distribution builds stream as a dynamic module that ships in a separate package, and modules-enabled is empty until that package is installed."
do      = "Check modules-enabled for ngx_stream_module before rendering a stream block, and install the distribution's stream module package first."

[gotcha.196]
area    = "nginx"
symptom = "A stream server cannot send a PROXY header to the loopback HTTP listener for one SNI and raw bytes to the passthrough app for another."
cause   = "proxy_protocol is a per-server switch and takes no variable."
do      = "Send every connection with the PROXY header to loopback, and give the passthrough names an inner loopback stream server that accepts the header and forwards the raw TLS without it."

[gotcha.197]
area    = "tests"
symptom = "The movement provider exits 1 at startup with only its generic refusal line when a test passes a repeated-byte PAXEER_CHECKPOINT_AUTHORITY such as 0x5a5a…."
cause   = "DepositProofVerifier::new decodes the value as an Ed25519 verifying key and refuses bytes that are not a curve point, and main collapses every startup error into one line."
do      = "Give fixtures a real verifying key from ed25519_dalek::SigningKey::from_bytes on a random seed, and trace the child with strace -f when the refusal line gives no reason."

[gotcha.198]
area    = "platform"
symptom = "The topology regression suite fails with a named-but-absent edge after two lanes merge in either order."
cause   = "One lane named a manifest edge in topology-regressions.py while another lane replaced that manifest variable, and neither saw the other's change."
do      = "After merging a lane that edits a manifest env edge, rerun the topology check on the merged revision before closing tasks that depend on it."

[gotcha.199]
area    = "platform"
symptom = "A topology regression entry for an env edge cannot be renamed when the manifest variable changes from one URL to a JSON list of URLs."
cause   = "topology-check.sh matches each env value against one scheme-anchored URL pattern, so a JSON array yields no edge, and a public host would be offcluster rather than ok."
do      = "Before renaming a named edge, confirm check() emits it on the merged manifest; a list-valued or public-host variable needs a checker change or a ruling, not a renamed line."

[gotcha.200]
area    = "lni"
symptom = "A hosted service's receipt lookup is refused with class 1, result -105 (malformed envelope) although its selector is well formed for LNI minor 5."
cause   = "At LNI minor 6 the daemon requires a trailing wait byte on every receipt-lookup selector (0 immediate, 1 published, 2 durable), and a caller that echoes the node's interface version but builds a minor-5 selector omits it."
do      = "When a caller echoes the node's interface version, build the selector for that version: append 0 for an immediate lookup at minor 6 or later, as platform/hosted/core and the SDK client's receipt lookup do."

[gotcha.201]
area    = "platform"
symptom = "A regression suite that compares only rows labelled ok cannot name an edge the topology checker labels offcluster."
cause   = "named() filtered rows by one exact status, so a listed public-host edge was named but absent even once the checker emitted it."
do      = "Compare resolved lists against the set of statuses that count as resolved (ok and offcluster) and keep the per-policy refusal counts on that same set."

[gotcha.202]
area    = "nginx"
symptom = "A Fly app behind the edge nginx hashes every client to the same split_clients bucket."
cause   = "Fly-Client-IP is the address that reached the Fly proxy, which behind the edge is the edge host for every client; the real client arrives in the edge's X-Real-IP."
do      = "Key split_clients on a map of $http_x_real_ip that falls back to $http_fly_client_ip when the header is absent."

[gotcha.203]
area    = "cg"
symptom = "cg spec start on a task already marked implemented exits 1 and leaves the status unchanged."
cause   = "start only moves pending tasks; an implemented task expects done or --force."
do      = "For a follow-up cycle on an implemented task, set its status line to in_progress by hand and back to implemented at the end."

[gotcha.204]
area    = "node"
symptom = "The human web e2e unit tests look unrunnable in a fresh checkout because human/apps/web has no node_modules."
cause   = "The package test script lists many files, some importing installed packages, while harness.test.ts imports only node builtins and a local .ts module."
do      = "Run node --test e2e/harness.test.ts directly from human/apps/web; Node 22 strips the TypeScript types itself, no install needed."

[gotcha.205]
area    = "ci"
symptom = "The runner canary dispatched while CI_LINUX_RUNNER is unset runs on a hosted runner and fails at its lld step, and the API reports an empty runner name for that job."
cause   = "The routing expression falls back to the hosted image, which lacks ld.lld, and completed hosted jobs carry no runnerName in the jobs listing."
do      = "Read a hosted canary failure as the variable being unset, not as a runner image fault; judge the Fly runner only from a run whose job names a fly- runner."

[gotcha.206]
area = "nginx"
symptom = "Registering an HTTP proxy name reports protocol options redefined on existing shared TLS listeners, although the reload and live gate succeed."
cause = "Enabled TLS sites declare different protocol options on the shared listen socket."
do = "Record the warnings and preserve unrelated sites; qualify the registered name with its declared live gate and scope any listener repair separately."

[gotcha.207]
area    = "check-live"
symptom = "A live authenticated plan with the golden intent.plan request body is refused although the bearer is admitted."
cause   = "The golden body is a schema fixture: its asset_id is a placeholder the planner refuses unless it equals the principal's balance asset, its destination is a fixture account and its deadline has already passed."
do      = "Take the golden body and set asset_id, destination.account and a deadline ahead of now at run time from named inputs; never send the fixture body to a live service expecting a plan."

[gotcha.208]
area    = "spec-tooling"
symptom = "cg spec implemented refuses a task whose touched data file changed in the worktree, reporting no matching change, while the graph database is busy with another lane's index."
cause   = "With the refresh skipped the check reads the last completed index, which knows nothing of uncommitted edits to files it does not parse."
do      = "Treat the refusal like gotcha 104: record it, set the status line by hand, remove any spec.kvx.lock and let the manager re-run the tool after the merge."

[gotcha.209]
area    = "spec"
symptom = "cg spec start refuses a task with unmet requires even when it is dispatched deliberately ahead of them for its build side."
cause   = "start enforces the requires graph and has no override for build-side work against a parallel lane."
do      = "Set the status line to in_progress by hand, delete spec.kvx.lock, and record the refusal as an observation."

[gotcha.210]
area    = "bringup"
symptom = "A check-live function with set -u dies with 'unbound variable' when an array declared by name only is empty."
cause   = "local -a name declares without assigning, and bash before 5.2 treats \"${!name[@]}\" of an unset array as unbound."
do      = "Declare arrays as local -a name=() in check-live functions."

[gotcha.211]
area    = "bringup"
symptom = "A script piped to sh -s with data appended after it can lose the data to a cat inside the script."
cause   = "The shell reads its script from stdin in blocks, so trailing bytes may already be consumed before cat runs."
do      = "Embed the data in the script as a quoted variable instead of appending it to stdin."

[gotcha.212]
area    = "rpc"
symptom = "The public RPC names answer a request whose Host header is a loopback address and port."
cause   = "Their nginx serves by SNI and does not reject an unmatched Host header."
do      = "A loopback socat hop to port 443 with the name as SNI needs no vhost change for a boundary that sends Host 127.0.0.1:PORT."

[gotcha.213]
area    = "bringup-probe"
symptom = "A live probe needs a daemon's bearer inside a Fly machine, but no task has fixed the file path the bearer is materialised to."
cause   = "The daemon takes the bearer as an environment variable and the init that sets it is written by another task."
do      = "Read the running daemon's own /proc/<pid>/environ inside the machine (found by its exe name) and keep the bearer in a 0600 temporary file there; never pass it through the ssh console input or the local command line."

[gotcha.214]
area    = "test"
symptom = "A fixture test needs a running process that a probe finds by its executable name and whose environment it reads."
cause   = "The probe matches /proc/<pid>/exe, which a shell function or alias cannot fake."
do      = "Copy sleep under the expected executable name, start it with the environment the probe reads, and kill it in the test's cleanup trap."

[gotcha.215]
area = "fly"
symptom = "The machine-list prerequisite exits one before an application has been created."
cause = "The CLI treats an absent application as an error, while the deployment script creates it when absent."
do = "Retain the diagnostic in a private log and distinguish an explicit app-not-found result from authentication or API errors before proceeding through the approved deployment script."

[gotcha.216]
area    = "bringup"
symptom = "A read-only comparison of a public RPC name's resolution against the host-map roles exits 1 before it compares anything."
cause   = "The comparison read the scalar role list of the host map with array syntax, so the roles came back empty."
do      = "Read the roles the way tools/bringup/check-live.sh reads them, read -r -a from the scalar role list, before comparing a name against them."

[gotcha.217]
area    = "chain"
symptom = "A script that must list every asset of the custody precompile's asset map over JSON-RPC finds no view that enumerates it."
cause   = "The layerxcustody precompile answers getAsset, assetByPointer and nativeAssetId only, and the module registers no query route; the map is keyed by id, pointer and denom."
do      = "Get the pointer list from an authoritative source and look each one up with assetByPointer, PAX through nativeAssetId; never treat a hand-kept list as the complete map without a ruling."

[gotcha.218]
area    = "kernel"
symptom = "A task says layerxctl read-state shows balances and that the loopback replica serves the batch document carrying an activity, and neither is true."
cause   = "layerxctl read-state answers only the actor's account sequence, state root and epoch; the authority replica serves only batch evidence by batch id and receipt digest; balances and receipt lookups live in the node test probe, and the activities[] batch document is the relay archive's /v1/history/batches/N."
do      = "Before writing a value-loop probe, pick the real read path (probe balance, LNI receipt lookup, relay archive history) and get it into the task text; do not grep a layerxctl output for a balance."

[gotcha.219]
area    = "registry"
symptom = "A registry deployed with only its listener, builder and kernel variables exits at startup before /healthz answers."
cause   = "Its program outbox builds the event producer client with the mandatory from_environment, not from_environment_if_configured, so the program and webhooks upstream groups are required at start."
do      = "Configure the LAYERX_EVENTS_PROGRAM_UPSTREAM_* and LAYERX_EVENTS_WEBHOOKS_UPSTREAM_* groups, with reachable mTLS upstreams, before the first registry deploy."

[gotcha.220]
area    = "spec-tooling"
symptom = "cg spec start on a build-side lane exits 1 with unmet requires and leaves the task pending."
cause   = "start checks that every required task is done, and build-side lanes are cut before their prerequisites land."
do      = "Set the status line to in_progress by hand, never with --force, and delete spec/<feature>/spec.kvx.lock."

[gotcha.221]
area    = "agent"
symptom = "layerx-mcp exits with the binding document declares no protocol socket against the binding the full-mode daemon published."
cause   = "The daemon's binding publisher writes only the base keys, while the binary requires a listener section and a web-scoped session also requires a web section plus an attached web payer that no served path attaches."
do      = "Plan the listener and web sections and the production web payer before promising an MCP socket or the web tools; the stdio CLI ignores listener but still refuses web scopes."

[gotcha.222]
area    = "agentd"
symptom = "Tenant control cannot be applied to a request that arrives on the program listener with only the daemon program bearer."
cause   = "tenant::resolve needs a session Token authenticated from a full SessionCredential (tenant, session id, token id, generation); the program bearer names no session, and MCP authorizes in-process from its binding's session token file instead of over HTTP."
do      = "Before building an HTTP route that must run under tenant control, fix how the caller presents its session credential and which tenant::Surface it maps to; the SDK transports send a single Authorization header."

[gotcha.223]
area    = "bringup"
symptom = "Dropping a role from the check-live host map breaks the hosts timeout case and the one-ssh-per-destination count, not only the fixture lines."
cause   = "The hang fixture put its only hanging destination on the dropped role, and the harness counts the distinct ssh destinations of the good map."
do      = "Move the hanging destination to a remaining single-destination role and recount the good map's destinations when a role leaves the map."

[gotcha.224]
area    = "test"
symptom = "A sync-fleet fixture case that makes a remote step fail by removing a host file fails the harness's no-destination check."
cause   = "The ssh stand-in rewrites shared paths under the fixture host's own directory, so the remote command's error text carries the fixture destination."
do      = "Fail remote steps in fixtures through a stand-in switch (the systemctl or scp stand-in exiting non-zero for a listed destination) rather than a missing file."

[gotcha.225]
area    = "tooling"
symptom = "A command line of the form cd <lane> && mkdir ... && ( long build ) & ran every later command of the same call in the previous directory, so shellcheck and check-deploy read the main checkout."
cause   = "The trailing & backgrounds the whole && list, cd included, in a subshell."
do      = "Put cd on its own line, or background only the build subshell, before running gates in a lane."

[gotcha.226]
area    = "bringup"
symptom = "A Fly toml [env] entry carrying the node asset id or replica id fails tools/wallet/check-deploy.sh env-no-secrets."
cause   = "The rule refuses any value of 64 hex characters, which also matches public 32-byte ids."
do      = "Keep public 32-byte ids of a pod ConfigMap in the app's init or config file, not in [env]."

[gotcha.227]
area    = "bringup"
symptom = "check-live.test kernel-app cases resolved the real app name instead of the fx- fixture app."
cause   = "The default checker reads tomls from the real repository root; only the fixture copy reads the fixture tree."
do      = "Run cases that read a fixture toml with CHECK_LIVE_TEST_PROGRAM=\"$fx_checker\"."

[gotcha.228]
area    = "gas-station"
symptom = "A /quote for an account that has never used the paymaster answers 503 instead of a quote."
cause   = "The station eth_calls nonce() and usedQuoteNonces on the account itself; an undelegated account returns empty code, which reads as malformed."
do      = "Delegate the account to the paymaster with an EIP-7702 authorization before its first quote, and check eth_getCode equals 0xef0100 followed by the paymaster."

[gotcha.229]
area    = "gas-station"
symptom = "A health check or edge probe of the gas station gets 404 on every GET path."
cause   = "The service routes only POST /quote and POST /submit."
do      = "Use a tcp check on the Fly app and probe the station with a POST; do not give it an http check path."

[gotcha.230]
area    = "gas-station"
symptom = "The station refuses its configuration when max_rate_age is set to a paymaster refresh interval of more than five minutes."
cause   = "The station config bounds max_rate_age to 1..300 seconds, independent of the contract's maximumAge."
do      = "Keep the owner's setRate refresh interval at most 300 seconds, or change the station bound in its own task first."

[gotcha.231]
area    = "bringup"
symptom = "A port copied from a Kubernetes manifest's upstream URL collides with another listener once the pod's containers share one Fly machine."
cause   = "Manifest URLs carry Service ports that map to distinct pods or containerPorts; in the one-machine kernel app core already holds 9443 and the first Paxeer boundary holds 9447."
do      = "Take every in-machine port from docker/kernel/init.sh and the kernel toml, and treat a Service port in a manifest URL as unfixed until the spec names it."

[gotcha.232]
area    = "bringup"
symptom = "A probe that splits openssl s_client -showcerts output into one file per certificate gets an unreadable second certificate."
cause   = "The awk split kept printing the text between certificates after close(), and a print to a closed file reopens and truncates it."
do      = "Print only between BEGIN and END CERTIFICATE lines with an in-certificate flag, and close the file at the END line."

[gotcha.233]
area    = "bringup"
symptom = "A check-live subcommand exits with 'unbound variable' at the very end after all its lines printed."
cause   = "An EXIT trap set inside a function with a single-quoted reference to a local variable runs after the function's locals are gone, and set -u trips on it."
do      = "Expand the path into the trap when it is set (double quotes, shellcheck SC2064 disabled) as the other probes of the file do."

[gotcha.234]
area    = "bridge"
symptom = "A task that pairs the bridge relayer with layerx-mirror-signer in one machine cannot configure the signer for the relayer's keys."
cause   = "layerx-mirror-signer binds exactly one secp256k1 handle and one ed25519 handle to the mirror policy domains, while the relayer signs under five LayerX/bridge domains with an attestor handle distinct from every submitter handle."
do      = "Read the relayer's policy domain constants in src/signer.rs against the signer's key set before writing the image or app; the bridge key set needs a ruled signer mode first."

[gotcha.235]
area    = "fly"
symptom = "A Fly app's [[files]] entry mounts garbage instead of the JSON or key text set as its secret."
cause   = "A [[files]] entry with secret_name decodes the secret's value as base64."
do      = "Import every file-mounted secret as NAME=<base64 -w0 of the file> through secrets import --stage."

[gotcha.236]
area    = "bringup"
symptom = "A check-live harness case that wants a checklist failure passes the fixture record check instead."
cause   = "The fixture checklist matched a substring (match) that the failing record's value (mismatch) also contained."
do      = "Pick fixture marker words that no failing fixture value contains."

[gotcha.237]
area    = "bringup"
symptom = "A check-live subcommand exits 2 with no output in the harness fixture tree."
cause   = "It read an optional spec value with sed from a file the fixture tree does not carry, and under set -euo pipefail the failed read ended the script before any check line printed."
do      = "Guard an optional read with an explicit fallback such as || name=\"\" so an absent file falls through to the next source."

[gotcha.238]
area    = "bringup"
symptom = "A service image build fails at the runtime stage COPY of its own init under docker/<service>/."
cause   = "The image's Dockerfile.dockerignore excludes the whole docker tree, so the init it copies is not in the build context."
do      = "Add an exception line for that file after the docker exclusion, and declare util-linux in a runtime stage that drops privileges with setpriv instead of relying on the base image."

[gotcha.239]
area    = "tooling"
symptom = "A script that inserts shell test text through python3 - <<'PY' ends early with a Python syntax error, and the rest of the inserted text runs as shell commands."
cause   = "The inserted text itself carried a heredoc ending in a PY line, which closed the outer heredoc."
do      = "Write text that holds its own heredocs to a scratch file first and insert it from there, or give the outer heredoc a delimiter the text cannot contain."

[gotcha.240]
area    = "bringup"
symptom = "An x402 round trip against the interop gateway would fail to reach the public router URL once the gateway's outbound CA points at the internal CA."
cause   = "It looked as if LAYERX_INTEROP_OUTBOUND_CA_DER replaced the trust store, but the service adds that one DER to native-tls on top of the system roots."
do      = "Point the interop outbound CA at the internal CA DER alone: it verifies the receipt authority and Redis, while the router's public chain verifies through the image's ca-certificates bundle."

[gotcha.241]
area    = "ramp"
symptom = "A PEM bundle given to a native-tls client verifies only the upstreams under its first root."
cause   = "native_tls Certificate::from_pem parses only the first certificate of the file."
do      = "Load a CA file with Certificate::stack_from_pem and add every root to the connector."

[gotcha.242]
area    = "fly"
symptom = "A service dropped to its uid cannot open its config under a /run directory the root init created."
cause   = "mkdir -p under umask 077 leaves the parent directory root 0700, so the service uid cannot traverse it."
do      = "chmod 0711 each parent directory the init creates before dropping privileges."

[gotcha.243]
area    = "bringup"
symptom = "The kernel-app harness cases of check-live.test.sh report init status=absent once and pass on the next run."
cause   = "Several lanes run the harness at the same moment and the loaded box pushes the stand-in ssh console past its five-second bound."
do      = "Treat a lone kernel-app init=absent failure under concurrent harness runs like the ca_issue /dev/shm cases: record it, rerun once."

[gotcha.244]
area    = "bringup"
symptom = "Adding a row to the ca.sh service table fails ca_issue_every_service and any case that expects that app's toml to be absent from the fixture repository."
cause   = "The harness pins the row count and creates a fixture toml for every row's app."
do      = "Raise the pinned count with the row and take the fixture toml aside in a toml-absent case instead of assuming it is missing."

[gotcha.245]
area    = "bringup"
symptom = "Probe cases that find a stand-in process by executable name under /proc pass alone and fail when several copies of check-live.test.sh run at once."
cause   = "Each copy starts its own layerx-event-source or agentd stand-in, and every copy's /proc scan sees the other copies' processes with their environment."
do      = "Run the harness alone before reading those cases, or give a new stand-in an executable name no other case uses; a flyctl machine run one-off also skips fly.toml [env], so pass the static env with --env from the toml."

[gotcha.246]
area    = "bringup"
symptom = "cg spec start refuses a task whose requires are not done yet although the wave builds against the design blocks."
cause   = "cg checks the requires list before it moves a task to in_progress."
do      = "Set the status to in_progress by hand in spec.kvx and remove spec.kvx.lock, as the build-side wave rule allows."

[gotcha.247]
area    = "bringup"
symptom = "A Fly app with two process groups needs a plain listener in one group and a TLS listener in the other, but the service refuses the plain mode when any TLS variable is set."
cause   = "Fly [env] is shared by every process group, and the plain listener rejects the TLS certificate variables."
do      = "Set the per-group listener variables in a small init that the group's process command names, and keep them out of [env]."

[gotcha.248]
area    = "bringup"
symptom = "A new ca.sh row fails check-live ca and the every-service count of check-live.test.sh."
cause   = "check_ca wants a [[files]] entry that mounts <PREFIX>_CERT in the row's toml, and the harness pins the number of rows."
do      = "Mount <PREFIX>_CERT in the toml with the row and raise the pinned row count in the same change."

[gotcha.249]
area    = "gateway"
symptom = "A plan leaves LAYERX_GATEWAY_PROGRAM_REGISTRY_URL unset in kernel mode expecting program_registry to report not_configured, but the gateway would refuse to start."
cause   = "configured_kernel requires the registry URL and its token file whenever LAYERX_GATEWAY_COMPONENT_URL is set; not_configured appears only when the whole kernel is unset."
do      = "Treat the registry as mandatory in kernel mode until the gateway makes it optional; readiness is 200 only when every configured backend is ready."

[gotcha.250]
area    = "flyctl"
symptom = "JSON read from a Fly machine through flyctl ssh console fails to parse although the command printed valid JSON."
cause   = "flyctl writes its machine-selection notice to stdout ahead of the command's output when no machine is named."
do      = "Keep only the last line of the output (tail -n 1), as the identity check does, and print the JSON without a trailing newline or on one line."

[gotcha.251]
area    = "check-live"
symptom = "After a merge of check-live.test.sh most cases fail with head=none or empty answers although no probe changed."
cause   = "A merge dropped the closing exit 0 and fi of one curl stand-in block, so the heredoc stand-in no longer parses and every curl call fails."
do      = "After resolving a merge of the harness, run bash -n over each heredoc stand-in (ssh, flyctl, curl, node, getent) before the full harness."

[gotcha.252]
area    = "bringup"
symptom = "A new check-live subcommand needs its own curl answers in the harness, but lanes may only append cases at the end of check-live.test.sh."
cause   = "The harness's curl stand-in is written once near the top and answers every https URL with its own fixtures."
do      = "Write a second curl stand-in in a directory of its own in the appended cases that answers the new paths and execs the harness's stand-in for everything else, and run those cases with that directory first on PATH."

[gotcha.253]
area    = "bringup"
symptom = "A Dockerfile COPY of an init script under docker/ fails with file not found although the file is in the tree."
cause   = "The per-Dockerfile .dockerignore excludes the whole docker directory, so only paths it re-includes with a ! line reach the build context."
do      = "Add a !docker/<image>/<file> line to that Dockerfile's .dockerignore for every file under docker/ the image copies."

[gotcha.254]
area    = "bringup"
symptom = "A harness curl wrapper case sees its next @@ marker line glued to a JSON body and the sed parse finds nothing."
cause   = "The wrapper ignored -o and wrote the body to standard output, which real curl sends to the -o file."
do      = "Honour -o (and -w) in every curl stand-in exactly as real curl does before asserting on marker lines."

[gotcha.255]
area    = "bringup"
symptom = "A whole block of live-check harness cases fails at once with head=none or transport-style lines."
cause   = "A merge left a branch of the shared curl stand-in without its closing lines, so the stand-in script is a bash syntax error and every curl through it fails."
do      = "Run bash -n on the extracted stand-in heredoc after resolving a harness merge before reading individual case failures."

[gotcha.256]
area    = "test"
symptom = "Every check-live harness case that asks a public name over https fails with head=none or empty answers at once, across unrelated subcommands."
cause   = "A merge dropped the closing lines of one branch of the heredoc curl stand-in, so the stub is a shell syntax error and every stubbed curl call exits 2."
do      = "Extract the stand-in between its heredoc lines and run bash -n on it before chasing a subcommand; restore the lines from the lane revision that added the branch."

[gotcha.257]
area    = "test"
symptom = "A sync-fleet harness count of report lines ending in the rollout sha256 finds one more line than hosts rolled."
cause   = "The report's first line want sha256=<sha> also matches a pattern of a space, sha256= and the hash."
do      = "Anchor report-line counts on ^RPC_HOSTS as the existing record case does."

[gotcha.258]
area    = "bringup"
symptom = "A harness case that expects a failing make target to report the recipe's own exit code sees exit 2 instead."
cause   = "make exits 2 whenever any recipe fails, whatever code the recipe itself returned."
do      = "Expect exit 2 from a failed make target in check-live lines and harness cases; read the target's log for the recipe's own code."

[gotcha.259]
area    = "bringup"
symptom = "The interop and ramp conformance make targets look like live probes but interop-test-mandates and interop-test-visa-tap run only the crates' local vectors and interop-test-ramps-sandbox drives the ramp, not the gateway."
cause   = "The targets are cargo test runs of layerx-ap2 and layerx-visa-tap and platform/ramps/sandbox-journey.sh; only GET /v1/adapters of the gateway reports the pinned suites and adapter readiness."
do      = "Pair each target with the gateway's /v1/adapters entry for its adapter, comparing the served conformance pins against render.py first_party_suite of the checkout."

[gotcha.260]
area    = "bringup"
symptom = "A task hunts for a platform/deploy tree to find the node bootstrap and loses time."
cause   = "There is no platform/deploy tree; the node bootstrap is platform/hosted/node/bootstrap.sh beside supervisor.sh and the pod definition."
do      = "Open platform/hosted/node/ directly for the bootstrap, the supervisor and the genesis inputs."

[gotcha.261]
area    = "bringup"
symptom = "A kernel genesis that reads its asset records from the custody precompile finds nothing to read."
cause   = "The custody precompile has no enumeration view and an unregistered asset answers bytes32 zero from nativeAssetId and assetByPointer instead of reverting."
do      = "Treat a zero asset id as an absent record and refuse with the exact call; register assets through MsgSetAsset before generating the genesis."

[gotcha.262]
area    = "bringup"
symptom = "A remote /proc/$pid/cmdline read reports the kernel boot line instead of a process."
cause   = "With an empty pid the path collapses to /proc//cmdline, which is /proc/cmdline."
do      = "Default the pid (/proc/${p:-0}/cmdline) so an absent process reads as absent."

[gotcha.263]
area    = "bringup"
symptom = "A check-live read through fly_ssh reports every machine value absent in the harness although the fixture files are in place."
cause   = "The fly_ssh call left stdin open, so the flyctl stand-in's tee (and a real ssh console) waited on it until the timeout, and the timeout status discarded the answer; a merge had also dropped the exit and fi closing the gas block of the curl stand-in, so every curl call inside the harness failed to parse."
do      = "Give every fly_ssh call that sends no script </dev/null, and run bash -n on the harness stand-ins after a merge."

[gotcha.264]
area    = "bringup"
symptom = "The edge check prints route=unknown for the router name and the edge harness cases fail although the router manifest looks complete."
cause   = "A merge duplicated a key and a [[files]] entry in a fly manifest; tomllib refuses the whole file with Cannot overwrite a value, so the check reads no route."
do      = "After a merge that touches a fly manifest, parse every tracked toml with python3 tomllib and drop the duplicated second copies."

[gotcha.265]
area    = "bringup"
symptom = "Two check-live harness runs on one box fail cases at random, the flyctl and curl stand-ins and the CA cases among them."
cause   = "Concurrent runs on one box share host state the stand-ins and the CA cases rely on and disturb each other."
do      = "The harness takes flock on /run/lock/check-live-harness for its whole run; a second run waits instead of racing, so never bypass the lock."

[gotcha.266]
area    = "bringup"
symptom = "A Fly command under the check-live harness tests the real box instead of the fixture machine, for example test -d /data or a path under /var/lib."
cause   = "The flyctl ssh console stand-in rewrites only the prefixes it knows, each with its trailing slash, so /data without a slash and any unlisted root reach the real filesystem."
do      = "Write machine paths with the trailing slash (/data/, cd /data/) and add a rewrite line to the stand-in for each new machine root a command reads; never match processes by an exe path outside a rewritten root, or the harness can signal real processes on the box."

[gotcha.267]
area    = "fly"
symptom = "A second [processes] entry in fly.toml meant to run beside a service on its volume starts on a machine of its own without that volume."
cause   = "Fly gives every process group its own machines, and a volume attaches to exactly one machine."
do      = "Run a helper that must share a service's volume as a second process under the machine's init (start both, wait -n, stop the other, exit with the status) instead of as a process group."

[gotcha.268]
area    = "contracts"
symptom = "forge build --config-path foundry.paxeer.toml panics with the config-path must be a path to a foundry.toml file."
cause   = "forge accepts --config-path only for a file named foundry.toml; contracts/lib is also absent until contracts/bootstrap-libs.sh fetches the pinned libraries."
do      = "Run bash contracts/bootstrap-libs.sh, then build and create from the repository root with FOUNDRY_CONFIG=foundry.paxeer.toml."

[gotcha.269]
area    = "gas-station"
symptom = "A u128 field added to a journal record serialises but every journal reopen fails with Corrupt."
cause   = "Entry is an internally tagged serde enum, which buffers fields through serde's Content and cannot carry a u128 number."
do      = "Put #[serde(with = \"crate::tx::fee_amount\")] on every u128 journal field so it travels as a decimal string, as Fees does."

[gotcha.270]
area    = "go"
symptom = "buf generate --path layerxcustody/x.proto or --path api/layerxcustody/x.proto with no input fails with no .proto files were targeted."
cause   = "buf.gen.yaml v2 lists its own inputs, and --path does not match against them."
do      = "Generate one file with buf generate . --path api/<module>/<file>.proto after building protoc-gen-gocosmos into build/proto/gocosmos as scripts/protoc.sh does, copy only the gocosmos output pb.go into the module and remove build/proto."

[gotcha.271]
area    = "go"
symptom = "go build ./cmd/... prints matched no packages and exits 0, so it builds nothing Go."
cause   = "cmd/ holds the C and Rust daemons; the chain binary lives under daemon/paxd and the app under node/."
do      = "Build the chain with go build ./daemon/paxd or ./node/... when the task touches the app wiring."

[gotcha.272]
area    = "bringup"
symptom = "A check that asserts which runner ran a workflow job always reads runner none, even when the expected runner completed the job."
cause   = "gh run view --json jobs exports no runner field (only completedAt, conclusion, databaseId, name, startedAt, status, steps, url), so a runnerName select never matches."
do      = "Read the jobs with gh api repos/{owner}/{repo}/actions/runs/<run>/jobs and use .jobs[].runner_name when a check must assert which runner ran a job."

[gotcha.273]
area    = "check-live"
symptom = "A probe inferred a public name from a platform variable of a service that was never part of the system it checks."
cause   = "The fallback read a variable from a hosting platform assumed to run the legacy service, and nobody confirmed where that service actually ran."
do      = "Take a public name only from the spec's decision value and fail with the value unset; never add a platform-read fallback without the owner confirming where the service runs."

[gotcha.274]
area    = "bringup"
symptom = "A check-live harness run inside a capped tool call ends with exit 143 and an empty log, never having run a case."
cause   = "The harness waits on its flock while another lane's run holds it, and the caller's timeout kills it during the wait."
do      = "Run the harness in the background or with no outer timeout shorter than a full queued run; an empty log with exit 143 is no gate result."

[gotcha.275]
area    = "spec-tooling"
symptom = "cg spec start refuses a task with unmet requires and exits 1, although the worker was told to build it against the spec before its prerequisites land."
cause   = "start checks that every requires task is done and offers only --force."
do      = "Set the status line to in_progress by hand, record the refusal once in the qualification log, and do not force."

[gotcha.276]
area    = "test"
symptom = "The flyctl stand-in of check-live.test.sh exits 98 on a call that passes --json, so a new probe that lists machines reads nothing."
cause   = "The stand-in parses only the flags earlier probes used and treats any other flag as an error."
do      = "Teach the stand-in the new flag and subcommand in the same change that adds the probe, answering from a fixture file."

[gotcha.277]
area    = "test"
symptom = "After a merge, fixture cases that wrote machine JSON to a file named by CHECK_LIVE_TEST_MACHINES made other flyctl cases read a path instead of JSON."
cause   = "The feature's flyctl stand-in prints CHECK_LIVE_TEST_MACHINES as the JSON itself and falls back to the app's machines.json only when the variable is empty."
do      = "Export the JSON inline for the cases that need it and unset it afterwards; never export CHECK_LIVE_TEST_MACHINES as a file path."

[gotcha.278]
area    = "kernel-init"
symptom = "A boundary that runs as the node's second uid cannot read the sequencer seed to derive the sequencer public key it must present."
cause   = "The seed is 0600 to the node uid; the pod used to mount the public key from a secret instead."
do      = "Derive the public key in the root prepare step of docker/kernel/init.sh into the run directory, the same way kernel-genesis.sh derives it."

[gotcha.279]
area    = "test"
symptom = "A single check-live.test.sh run hung in check_live_hosts_timeout until an outer timeout killed it, after eleven passing cases."
cause   = "Not investigated under the one-try rule; the case drives a hanging ssh stand-in under CHECK_LIVE_TEST_TIMEOUT=1."
do      = "Bound the harness with an outer timeout and read the last ok line in the log to locate the hanging case before blaming the change under test."

[gotcha.280]
area    = "check-live"
symptom = "Wrapping tools/bringup/check-live.test.sh in another lock on the same lock file hangs and no case runs."
cause   = "The harness takes its own exclusive lock on that file, so an outer lock on it deadlocks the run."
do      = "Run the harness without an outer lock on its lock file; it serialises itself."

[gotcha.281]
area    = "spec"
symptom = "cg spec <subcommand> --help reports an unknown task instead of printing help."
cause   = "The task subcommands read --help as a task id."
do      = "Use cg spec --help for the subcommand list and never pass --help to a task subcommand."

[gotcha.282]
area    = "spec"
symptom = "Reopening an implemented task is refused."
cause   = "cg spec start moves an implemented task back to in_progress only with --force."
do      = "Reopen with cg spec start --force; completion is never forced."

[gotcha.283]
area    = "bringup"
symptom = "A scan for a symbol under a guessed path exits 2 and the result is taken as absence."
cause   = "The guessed file does not exist, so the scan proves nothing about the symbol."
do      = "Discover the real file names with git ls-files before scanning a tree for a symbol."

[gotcha.284]
area    = "bringup"
symptom = "A deploy handoff written under the repository ends up staged with the task's change."
cause   = "Handoffs carry operator detail that belongs to the private operations record, not to the tracked tree."
do      = "Write deploy handoffs in the private operations directory beside the checkout, never under the repository."

[gotcha.285]
area    = "check-live"
symptom = "check-live.sh ci reports fail canary with branch=none and dispatches nothing."
cause   = "The gate resolves the default branch with gh repo view, which reads the repository from the checkout's git remotes; a source snapshot without git metadata has none."
do      = "Run the CI live gate from a git checkout that has the origin remote."

[gotcha.286]
area    = "spec"
symptom = "cg spec lint rejects a requires cycle after a dependency was added to make a gate's order explicit."
cause   = "The requires followed which gate could pass first instead of where the task's commands run; a step that runs inside another task's machine depends on that task."
do      = "Make requires follow where commands run, and record a gate that cannot pass before a later step as a qualification observation, never as a reversed requires."

[gotcha.287]
area    = "bringup"
symptom = "A value loop on the live kernel is told to fund its accounts through the node test's first-credit path, and that path cannot run against a genesis already built."
cause   = "The first custody credit is admitted only when its custody profile was passed to bootstrap as --custody-profile at genesis build time; the node test builds its genesis with it, the kernel genesis script does not."
do      = "Decide the opening credit before the live genesis is built, and pass its custody profile to that genesis; check any funding plan against the bootstrap arguments it needs."

[gotcha.288]
area    = "spec-tooling"
symptom = "cg spec start refuses a task because another in-progress task also claims tools/bringup/check-live.sh."
cause   = "Most bring-up tasks touch the shared probe, and start refuses overlapping touches without --force."
do      = "Set the status line to in_progress by hand, never with --force, delete spec.kvx.lock, and record the refusal as an observation."

[gotcha.289]
area    = "bringup"
symptom = "A script piped into a fixture machine through the harness's flyctl stand-in reads and writes the live paths of this box instead of the fixture tree."
cause   = "The stand-in rewrites /data/, /run/layerx/ and /run/secrets/ only in the --command string, never in the script it feeds on stdin."
do      = "Pass the roots as environment assignments inside the --command string (for example LAYERX_KERNEL_DATA=/data/layerx/) and have the piped script read them, so the stand-in rewrites them."

[gotcha.290]
area    = "shell"
symptom = "A background job started as `cd lane && ( build ) &` leaves the next command running in the old directory, so a gate runs the main checkout's script and writes its log there."
cause   = "The whole && list becomes the background job, so the cd happens only in that subshell."
do      = "Put the cd on its own line or use absolute paths for the foreground command after any backgrounded list."

[gotcha.291]
area    = "bringup"
symptom = "The kernel image cannot run layerx-custody-proof although the genesis profile and the opening credit both need it inside the machine."
cause   = "It is a Go binary whose source trees the kernel image's dockerignore excludes, and the image's build stage is Rust and C only."
do      = "Add a pinned Go build stage and the dockerignore exceptions for its trees before relying on custody proofs inside the kernel machine."

[gotcha.292]
area    = "fleet"
symptom = "A full public monorepo archive streamed over ssh can exceed a short staging timeout even with ample destination space."
cause   = "The stream is bounded by the timeout, not by destination space, and a pipeline hides the producer's exit code."
do      = "Preserve both the producer's and the receiver's exit codes, and prefer an exact-commit fetch into an existing public git base for a separately authorized recovery."

[gotcha.293]
area    = "fleet"
symptom = "Checks of HEAD or index activity in a linked worktree read the wrong place."
cause   = "A linked worktree's .git is a file."
do      = "Resolve the real git directory with git rev-parse --absolute-git-dir before checking HEAD or index activity."

[gotcha.294]
area    = "fleet"
symptom = "A worktree looks safe to delete because git status is clean."
cause   = "A clean git status omits ignored files; evidence logs, credentials and artifacts live there."
do      = "Never justify deleting a whole worktree by a clean status."

[gotcha.295]
area    = "fleet"
symptom = "A dry run changed state."
cause   = "It fetched, pruned or mutated something."
do      = "A dry run must not fetch, prune or mutate anything; it lists only."

[gotcha.296]
area    = "fleet"
symptom = "A merge chain on a nearly full box runs out of disk partway."
cause   = "The fixture harness uses about a quarter of a gigabyte of transient disk per run."
do      = "Guard free space before each merge, not only before the first."

[gotcha.297]
area    = "fleet"
symptom = "Two lanes that each append a whole function or case block at the same insertion point conflict with an empty base."
cause   = "Both lanes add at the same point, so the merge cannot order the blocks."
do      = "Keep both blocks in feature-then-lane order and change nothing else, and prove the added-only shape from the index stages (:1 base, :2 ours, :3 theirs) without touching the tree."

[gotcha.298]
area    = "bringup"
symptom = "A service whose wait list starts with another service's runtime output reports a plain wait before the genesis."
cause   = "The wait label comes from the first absent path, and only genesis outputs read as waiting-genesis."
do      = "Every layerxd-dependent service lists the genesis outputs first so the kernel-app gate reads waiting-genesis."

[gotcha.299]
area    = "bringup"
symptom = "A service that needs material produced by a later deploy step exits, and the deploy order cannot be completed."
cause   = "The service treats absent upstream material as a fatal error at start."
do      = "Wait for the material and report that state on the readiness route, never exit."

[gotcha.300]
area    = "bringup"
symptom = "A quiesce-then-export tool that refuses leaves the quiesced processes stopped."
cause   = "The refusal path exits without resuming what the quiesce step stopped."
do      = "Every refusal line in a handoff names the resume step."

[gotcha.301]
area    = "spec"
symptom = "A spec task whose machine needs [[files]] secrets cannot be cut over in order."
cause   = "The task does not require the tasks that produce those secrets, and the platform refuses a machine whose [[files]] secret is missing."
do      = "Make the task require every task producing its [[files]] secrets."

[gotcha.302]
area    = "spec-tooling"
symptom = "cg spec done refuses a task with symbol <name> not defined in the graph although the verify passed and the function exists in a file the task touched."
cause   = "The graph refresh is skipped while another indexer holds the database, so the last completed index has not seen a function the task added to an existing file."
do      = "Treat it as gotcha 141: set the status by hand after the genuine pass, say so in the commit line, and do not retry."

[gotcha.303]
area    = "spec-tooling"
symptom = "The graph check of a task symbol named run passes while pointing at a function in an unrelated crate."
cause   = "The check matches the bare symbol name anywhere in the graph, not inside the task's touched files."
do      = "Do not read a passing symbol check as proof the task's own function exists; confirm it in the touched file."

[gotcha.304]
area    = "rust"
symptom = "A server that must answer readiness before its state exists cannot hand the state to the handler it already passed to http::serve."
cause   = "http::serve takes ownership of one handler closure and blocks for the life of the process."
do      = "Give the closure an Arc<OnceLock<T>> filled by a worker thread and answer a waiting state while it is empty; no second listener and no lock on the hot path."

[gotcha.305]
area    = "bringup"
symptom = "A task's check-live.sh verify_cmd exits 2 with check-live: BRINGUP_HOSTS_FILE is unset before any check runs."
cause   = "The spec's verify_cmd omits the private host map, which check-live.sh requires for every subcommand."
do      = "Run the verify_cmd with BRINGUP_HOSTS_FILE pointing at the operator's private host map; never print or commit its contents."

[gotcha.306]
area    = "check-live"
symptom = "A check-live gate run without BRINGUP_HOSTS_FILE exits 2 before any Fly check, even for a subcommand that reads no host."
cause   = "Every subcommand except explorer loads the private host map first."
do      = "Run Fly-only gates with BRINGUP_HOSTS_FILE pointing at the private host map as the other gate records do."

[gotcha.307]
area    = "test"
symptom = "A check-live probe that calls flyctl apps list or flyctl secrets list reads nothing from the harness's flyctl stand-in."
cause   = "The stand-in refuses any call without an fx- app before it looks at the subcommand, and answers only the subcommands earlier probes used."
do      = "Answer apps list before the app gate and add secrets list beside ips list, both from the fixture directories, in the change that adds the probe."

[gotcha.308]
area    = "test"
symptom = "A harness case cannot assert that a probe never prints a secret value with the shared expect helper, which only checks lines that must appear."
cause   = "expect has no absence assertion besides its no-destination pattern."
do      = "Start every fixture secret value with up- so a printed value matches the no-destination pattern and fails the case."

[gotcha.309]
area    = "bringup-probe"
symptom = "A probe of passkey registration options cannot run on a fresh service without an account, and the registration begin route takes only an account id."
cause   = "passkey.register.begin needs the account id from account.create, which requires an email and a display name and is idempotent under its key."
do      = "Create the probe account under an idempotency key derived from a fixed probe address so every run converges on one account, then decode the base64url ceremony and read rp.id."

[gotcha.310]
area    = "human-components"
symptom = "An attestor node table of Fly .internal names is refused by the human components loader."
cause   = "LAYERX_HUMAN_ATTESTOR_NODES entries are parsed as socket addresses, not host names."
do      = "Resolve each .internal name to its private address in the root prepare step and hand the table to the role as id=[address]:port pairs."

[gotcha.311]
area    = "spec-workflow"
symptom = "cg spec start refuses a task that is already in progress with a message about another task."
cause   = "The start command refuses when another in-progress task claims one of the task's touched files."
do      = "Leave the status as recorded and continue; never pass --force to override the overlap."

[gotcha.312]
area    = "bringup-probe"
symptom = "The human check exits 2 with BRINGUP_HOSTS_FILE is unset before any check runs."
cause   = "The check-live dispatch loads the private hosts file for every subcommand except explorer, including those that read only public names."
do      = "Export BRINGUP_HOSTS_FILE with the private hosts file before running any check-live subcommand other than explorer."

[gotcha.313]
area    = "fly-deploy"
symptom = "A Fly [[files]] guest file staged from a raw PEM secret is unusable."
cause   = "A [[files]] secret_name value must be staged base64-encoded."
do      = "Stage every [[files]] secret value base64-encoded and correct any handoff that says otherwise before execution."

[gotcha.314]
area    = "kernel-init"
symptom = "A kernel launch list that starts the human gateway alone leaves required pod roles unlaunched."
cause   = "The eager producer constructor belongs to the separate components binary, not to the gateway proxy."
do      = "The task that launches the gateway also launches the components and the other pod roles it depends on."

[gotcha.315]
area    = "test"
symptom = "A combined find --help marker assertion refuses although GNU find and Python are present."
cause   = "One combined marker check fails on output shape rather than on a missing feature."
do      = "Stop at the first failed record and keep it; never claim an unsupported feature."

[gotcha.316]
area    = "spec-workflow"
symptom = "A Codify records command with --force runs past thirty minutes and, stopped by SIGTERM, leaves no exit code."
cause   = "The records command spawns trace children that can run long."
do      = "Keep the runtime gate's exit 0 as its own record, distinct from the records command."

[gotcha.317]
area    = "spec-workflow"
symptom = "cg spec implemented runs past a two-minute timeout and is terminated without changing the task status."
cause   = "The records command can run long in a lane with a large spec."
do      = "Set the status to implemented in spec.kvx by hand, then render once, and say so in the report."

[gotcha.318]
area    = "human-material"
symptom = "A search for the sequencer trust history across human/crates and platform finds only readers and test fixtures."
cause   = "The one writer of the LayerX/sequencer-trust-history/v1 encoding is encode_trust_history in platform/hosted/tests/beta-cluster.sh; the kernel and registry inits only wait on the file."
do      = "Search for the encoding header and encode_trust_history, not the path, before naming a producer."

[gotcha.319]
area    = "bringup-ca"
symptom = "A client row added to ca.sh services for the wallet attestors fails check-live ca with chain=untrusted even when the issue succeeded."
cause   = "The attestors admit keys.generate and sign only from the gateway CA in ATTESTOR_TLS_CA, while check_ca verifies every row against the internal CA."
do      = "Issue attestor client rows under LAYERX_ATTESTOR_CA_DIR and verify them against that CA, never the internal CA."

[gotcha.320]
area    = "bringup-ca"
symptom = "A per-row CA rule in check-live ca drifts from ca.sh when the attestor row names are copied into the checker."
cause   = "ca.sh holds the attestor row list as the attestor_services variable, not as a column of the services table."
do      = "Read attestor_services out of ca.sh in the checker, and pass LAYERX_ATTESTOR_CA_DIR to every check-live ca run, since an unset directory fails the attestor row."

[gotcha.321]
area    = "human-material"
symptom = "A trust history projected root:4020 0440 looks unreadable to the security provider, whose readers refuse any group or other permission bit."
cause   = "from_protected_history refuses mode & 0o077 and Store::open's protected_read wants 0600 owned by the reader, but the human entrypoint copies trust-history into /run/human-private/security as 0600 under the role's uid before the provider starts."
do      = "Check the provider's path against the entrypoint's private copy, not the projected material, before changing the history's mode."

[gotcha.322]
area    = "human-entrypoint"
symptom = "A POSIX sh loop over /run/human-material/journal/* under set -e fails test -s on the literal pattern when the directory is empty."
cause   = "sh leaves an unmatched glob as the pattern itself, so the loop body runs once on a path that does not exist."
do      = "Guard each iteration with [ -e \"$record\" ] || continue and check the directory itself with test -d before the loop."

[gotcha.597]
area = "builder"
symptom = "Migrated source checkout may have no Rust toolchain despite retained build artifacts."
do = "Provision the exact repository toolchain before qualification; retained artifacts are not build evidence."


[gotcha.598]
area = "spec"
symptom = "A task claim can reserve unchanged caller files and collide with another task."
do = "Map ownership to the actual changed producer and transport modules while retaining all caller acceptance cases, then use a normal claim."


[gotcha.601]
area = "events"
symptom = "Producer readiness harness used a webhook upstream variable group differing from the served producer."
do = "Use the exact events webhook upstream group while retaining real delivery and readiness assertions."

[gotcha.599]
area = "node"
symptom = "Wallet SDK has no standalone npm lockfile and belongs to a pnpm workspace."
do = "Use the locked wallet workspace and build the SDK directly without recursively rebuilding the root SDK."


[gotcha.600]
area = "node"
symptom = "Connected conformance imports the agent integration package outside its original declared dependencies."
do = "Declare the workspace dependency and update the matching lockfile entry without changing package versions."

[gotcha.604]
area = "wallet"
symptom = "Capability session changes cannot be represented honestly by an address-only account mismatch refusal."
do = "Declare the precise session-change refusal through the approved contract while preserving rejection predicates and error code."

[gotcha.602]
area = "rust"
symptom = "Human workspace parsing fails when the explorer-index manifest declares the same verifier dependency twice."
do = "Retain one identical genuine dependency declaration and preserve its path and version."

[gotcha.603]
area = "rust"
symptom = "Current local dependency edges can differ from retained Cargo locks after integration."
do = "Use actual Cargo metadata to reconcile local edges and compare complete external lock records; retain every external version, source and checksum."

[gotcha.608]
area = "rust"
symptom = "native-tls handshake errors require the custom deadline stream to implement Debug for Display formatting."
do = "Provide the real stream's Debug trait while retaining original handshake error text and deadline enforcement."

[gotcha.610]
area = "builder"
symptom = "Migrated native TLS build artifacts may reach linking on a host without OpenSSL development libraries."
do = "Restore the genuine supported build libraries without replacing TLS or changing service configuration."

[gotcha.619]
area = "replay"
symptom = "Execution-prestate version1 authenticates only universal state, Programs state and accounts, not complete Oracle and Web inputs."
do = "Preserve its closed decoder and refuse post-state substitution; any portable replay producer needs an explicit versioned prestate contract."

[gotcha.611]
area = "schema"
symptom = "An approved Agent schema integration can leave its committed Rust consumer version stale."
do = "Use the canonical source-bound standalone generator and preserve compatibility, baseline and drift assertions."

[gotcha.612]
area = "rust"
symptom = "Durable store values expose bytes through their closed public accessor, not a public field."
do = "Use bytes() and preserve borrowed decoding and owned retained snapshots."

[gotcha.613]
area = "native"
symptom = "Integrated Program owners must use the genuine hex codec, explicit stale-read variants and the existing authorization kind catalogue."
do = "Map every actual variant to its unique canonical tag while retaining legacy tags, encodings and all monetary checks."

[gotcha.615]
area = "schema"
symptom = "Canonical Agent operation regeneration exposes missing exhaustive PolicyDryRun authorization and owner mappings."
do = "Preserve the failed build and repair limit; resolve the actual authenticated session owner rather than treating referenced objects as absent."

[gotcha.614]
area = "jvm"
symptom = "A generator patch anchored in java_type instead of record_source can leave a local undefined name."
do = "Change the exact schema scalar predicate and regenerate canonical JVM declarations before qualification."

[gotcha.616]
area = "builder"
symptom = "Canonical SDK generation invokes the genuine Go formatter and fails when gofmt is absent from PATH."
do = "Provision the pinned verified Go distribution and provide its bin directory to the canonical generator."

[gotcha.617]
area = "builder"
symptom = "A release filename with a sha256 suffix may return an HTML page instead of a distribution digest."
do = "Verify the retained archive digest and size against exact official release JSON metadata before extraction."

[gotcha.621]
area = "rust"
symptom = "Arc::clone type inference can select a trait-object reference before coercing the concrete shared runtime clock."
do = "Clone the same concrete Arc through its receiver so the existing argument coercion applies without changing the clock or trait."

[gotcha.622]
area = "paths"
symptom = "Historical hosted Dockerfile locations can differ from current monorepo docker packaging."
do = "Resolve to actual tracked Dockerfiles and retain conforming packaging; do not create duplicate old paths."

[gotcha.623]
area = "lni"
symptom = "The native negotiated LNI session explicitly refuses a second NodeInfo request."
do = "Use an existing authenticated read with a genuine nonzero selector to prove persistent-session liveness while preserving authentic receipts and journal state."

[gotcha.620]
area = "codify"
symptom = "A low-level task lease can be registered without changing the task status in the feature source."
do = "Reconcile the owned task status explicitly while keeping unqualified work in_progress."

[gotcha.627]
title = "Ramp responses and replay must match actual durable rebalance semantics"
observed = "The retained sandbox required own-account Paxeer domain and custody labels plus original-key replay; reference responses omitted these fields and duplicate keys always conflicted."
rule = "Preserve original identifiers and reject changed terms; uncertain transfers reconcile without rebroadcast."

[gotcha.628]
title = "SDK consumers must use canonical public type and artifact error owners"
observed = "Human, explorer and ramp builds hit SDK imports from error instead of public verify/idempotency owners; complete artifact decoding returns a record-context error."
rule = "Correct real SDK owners without weakening verification or flattening detailed artifact refusals."

[gotcha.624]
area = "human"
symptom = "Finite JSON stream pages and notification deliveries without journal events cannot fulfil the no-polling stream contract."
do = "Wire a genuine durable notification producer and explicit versioned push transport; retain current JSON operations and all session authorization rules."

[gotcha.629]
title = "Generator isolation prevents blocking the admitted source projection"
observed = "The Human API generator waited for the explorer target lock; its waiting process was stopped before compiler work, then the same bounded recipe compiled and rendered in an isolated target."
rule = "Use separate standalone generator targets and record lock waits separately from actual compilation."

[gotcha.630]
title = "Standalone explorer readiness needs live source availability and real trust files"
observed = "Retained completeness could survive a lost node; startup required an unavailable authority probe, and the fixture supplied unused head values instead of actual genesis/finality trust."
rule = "Bind authenticated serving after genuine node handshake, preserve authority refusals, and clear completeness on source loss."

[gotcha.625]
title = "Codify migrated graph inspection needs known commands and bounded projections"
observed = "spec_claim_status is absent and cg spec start --help treats help as a task; cg state emitted a large migrated snapshot. Lease timestamps were read from the existing graph attempts and leases tables without modifying the rebuilding graph."
