{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "docker/wallet-pwa/Dockerfile"
    },
    "deploy": {
        "healthcheckPath": "/wallet/api/health?mode=liveness",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
    }
}
