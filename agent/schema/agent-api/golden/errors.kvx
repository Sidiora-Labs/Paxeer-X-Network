[module]
name = "errors"
contract_major = 2
compatibility = "additive_only"

[type.ApiError]
required = ["class","protocol_result_code","retriability","request_id","reason"]

[type.ErrorClass]
variants = ["TransportFailure","Deadline","ProtocolIncompatibility","UnavailableCapability","CoreRejection","VerificationFailure","PolicyRefusal","CapabilityRefusal","BudgetRefusal","RateLimit","IdempotencyConflict","InternalFault"]
UnavailableCapability.semantics = "A required node capability was not in the negotiated intersection. The layer does not emulate it."

[type.Retriability]
variants = ["Terminal","Retriable"]

[error.LXP_IDEMPOTENT_REPLAY]
class = "CoreRejection"
protocol_result_code = -302
retriability = "Terminal"
reason = "idempotent_replay"
original_result = "Read the first result through resultByIdempotency(bytes32 didId,bytes32 idempotencyKey); never resubmit at a new nonce."

[error.receipt_key_unknown]
class = "VerificationFailure"
protocol_result_code = null
retriability = "Terminal"
reason = "receipt_key_unknown"
condition = "Receipt key identifier is absent from the pinned ReceiptKeys list or the receipt height is outside its entry's inclusive range."

[type.Rung]
variants = ["Submitted","Receipted","Committed"]
wire_names = ["submitted","receipted","committed"]
ordering = "declaration_order"
Submitted.semantics = "Send issued with exact raw signed bytes and transaction hash; no verified sequencer receipt. Timeout and transport loss stay submitted, never success."
Receipted.semantics = "Canonical sequencer receipt passes every pinned-key, height, transaction, field and sequence check. Status 1 executes; status 0 reverts and is never success."
Committed.semantics = "Landing receipt has a non-null block hash and matching status, gas and logs at a height greater than or equal to the signed receipt height; the block sequence covers the receipt and its Comet commit verifies with more than two-thirds voting power."

[type.VerificationStatus]
variants = ["Achieved","Unverified"]
Achieved.required = ["rung"]
Achieved.rung = "Rung"
Unverified.required = ["requested","achieved","reason"]
Unverified.requested = "Rung"
Unverified.achieved = "Rung"

[response.success]
envelope = "ApiSuccess"
required = ["request_id","value","verification_status"]
rule = "Every successful operation uses this envelope. Verification status is never omitted and a shortfall is never silently downgraded."

[mutation.agent.register]
envelope = "IdempotentMutation"
[mutation.session.open]
envelope = "IdempotentMutation"
[mutation.session.refresh]
envelope = "IdempotentMutation"
[mutation.session.close]
envelope = "IdempotentMutation"
[mutation.capability.create]
envelope = "IdempotentMutation"
[mutation.capability.attenuate]
envelope = "IdempotentMutation"
[mutation.capability.revoke]
envelope = "IdempotentMutation"
[mutation.budget.create]
envelope = "IdempotentMutation"
[mutation.budget.fund]
envelope = "IdempotentMutation"
[mutation.budget.revoke]
envelope = "IdempotentMutation"
[mutation.prepare]
envelope = "IdempotentMutation"
[mutation.sign]
envelope = "IdempotentMutation"
[mutation.submit]
envelope = "IdempotentMutation"
[mutation.subscription.create]
envelope = "IdempotentMutation"
[mutation.subscription.acknowledge]
envelope = "IdempotentMutation"
[mutation.subscription.pause]
envelope = "IdempotentMutation"
[mutation.subscription.resume]
envelope = "IdempotentMutation"
[mutation.subscription.delete]
envelope = "IdempotentMutation"

[type.IdempotentMutation]
required = ["request_id","key","body_digest","operation"]
repeat_same_body = "return_original_result"
repeat_different_body = "IdempotencyConflict"
