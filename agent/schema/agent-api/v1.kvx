[transport.agent_http.operation.read.proof_bundle]
request = "Exactly target and requested_verification_level. target is lowercase hex canonical native PB1: version u16be 1, kind 1 Activity or 3 Receipt plus nonzero activity_id32 (35 bytes); kind 2 AccountState adds nonzero account_id32 (67 bytes). No authority overrides or unknown fields."
response = "VerifiedRead<ProofBundle>: exact target, exactly one lowercase-hex LXPB1 record, achieved_verification_level and Freshness. Record <=262144 bytes, complete JSON body <=1048576 bytes. LXPB1 variant 1 Activity, 2 Account, 3 Receipt, 4 MaintainedAccount; nonempty u32be-counted canonical_value and native_proof, variant 4 additionally original activity_receipt and activity_receipt_sp1."
verification = "Activity/Receipt cap BatchIncluded; Account/MaintainedAccount cap StateProven. Requested level cannot exceed achieved level. Envelope Achieved status equals response level. Native proof authority remains mandatory; framing alone is not verification."
ownership = "Bound authenticated subject, retained tenant/principal-owned signed outbox activity, signed actor equal authenticated agent, fresh subject account and asset, verified stored receipt. AccountState selector equals the bound account."
access = "read"
operation_class = "Read"
surface = "Contract"
idempotency_key = "absent"
disposition = "served_adapter_arm"

