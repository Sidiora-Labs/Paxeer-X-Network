[schema]
name = "LayerX Agent API"
major = 1
minor = 9
node_interface_major = 1
source_of_truth = "This schema and the schema files it includes define the daemon contract and every SDK surface. Generated output is never authoritative."
compatibility = "Within one major version a release may only add sections or keys. Removing or changing an existing declaration requires a new major version."
includes = ["identity.kvx","write.kvx","read.kvx","stream.kvx","errors.kvx","approval.kvx","programs.kvx"]

[encoding]
request = "contract_major:u16be contract_minor:u16be request_id:u64be operation:utf8 payload:canonical-map"
response = "contract_major:u16be contract_minor:u16be request_id:u64be result_code:u32be payload:canonical-map"
integer_boundary = "Consensus-critical integers are encoded as fixed-width unsigned integers in Rust and decimal strings in dynamic-language SDKs."

[scalar.Amount]
rust = "u128"
typescript = "bigint"
python = "int"
wire = "decimal_string"
consensus_integer = true

[scalar.Sequence]
rust = "u64"
typescript = "bigint"
python = "int"
wire = "decimal_string"
consensus_integer = true

[scalar.BudgetLimit]
rust = "u128"
typescript = "bigint"
python = "int"
wire = "decimal_string"
consensus_integer = true

[scalar.TimestampSeconds]
rust = "u64"
typescript = "bigint"
python = "int"
wire = "decimal_string"
consensus_integer = true

[type.SettlementDomain]
variants = ["Paxeer"]
sole_domain = "Paxeer is the sole valid settlement domain in this contract version. The custody and withdrawal guarantee remains Paxeer exclusively and no other venue is a place funds live."
reservation = "Every custody-boundary claim and receipt shape names its settlement domain through this vocabulary, so adding a settlement domain later is an additive schema change by construction: a new variant appended to this list with every existing declaration untouched."
one_ledger = "One identity, one balance system and one canonical order are preserved unchanged by this vocabulary."

[record.ContractVersion]
fields = ["major:u16","minor:u16"]

[record.VersionRequest]
fields = ["request_id:Sequence","supported:ContractVersion"]

[record.VersionResponse]
fields = ["request_id:Sequence","contract:ContractVersion","node_interface_major:u16"]

[golden.request.version]
encoded_hex = "00010000000000000000000700000000010000"

[golden.response.version]
encoded_hex = "0001000000000000000000070000000000000100000001"

[golden.request.version_1_1]
encoded_hex = "00010001000000000000000700000000010001"

[golden.response.version_1_1]
encoded_hex = "0001000100000000000000070000000000000100010001"

[compatibility.matrix]
sdk = "0.1.x"
contract = "1.x"
node_interface = "1.x"
daemon = "0.1.x"

[compatibility.history.1_1]
classification = "additive_only"
baseline = "golden/v1.kvx@1.0"
change = "Adds approval.kvx without changing any contract 1.0 declaration."

[compatibility.history.1_2]
classification = "additive_only"
baseline = "golden/v1.kvx@1.1"
change = "Adds the receipt-verified Programs operation family and its bounded canonical call contract."

[compatibility.feature.programs]
introduced_contract = "1.2"
classification = "additive_only"

[compatibility.feature.approval]
introduced_contract = "1.1"
classification = "additive_only"

[compatibility.feature.settlement_domain]
introduced_contract = "1.1"
classification = "additive_only"
note = "Reserves the settlement-domain claim vocabulary with Paxeer as the sole valid domain and tags every custody-boundary claim and receipt shape. Adding a settlement domain is an additive change by construction: a new SettlementDomain variant is appended and no contract 1.x declaration changes."

[transport.agent_http]
version = 1
external_route = "POST /v1/agent/rpc on the unified gateway, rewritten exactly to POST /rpc on the agent daemon RPC listener"
native_routes_unchanged = "The native JSON-RPC /rpc and /rpc/schema routes and every Programs route keep their existing distinct contracts."
content_type = "application/json"
max_body_bytes = 1048576
max_header_bytes = 16384
framing = "Exactly one canonical decimal Content-Length; Transfer-Encoding is rejected."
encoding = "UTF-8 JSON object; duplicate keys, unknown keys, trailing bytes, truncated or non-UTF-8 input are rejected"
listener = "Dedicated agent RPC mutual-TLS listener; a verified gateway client certificate is required; no plaintext fallback."
authorities = "Gateway API-key admission and the tenant session credential are two distinct authorities. No header-supplied principal is accepted; program bearer or LayerX-Key possession never authorizes catalogue writes."

[record.AgentHttpEnvelope]
fields = ["version:u8","request_id:Sequence","operation:utf8","request:canonical-map","credential:AgentHttpCredential?","idempotency_key:hex32?"]
credential = "Required for every operation except the bootstrap operations agent.register and session.open, where it is null and the existing bootstrap authority of the owner decides."
version = "Exactly 1; any other value is rejected as ProtocolIncompatibility."
operation = "Exactly one generated catalogue operation name; an unknown name is rejected as ProtocolIncompatibility."
idempotency_key = "Lowercase 64-hex non-zero key, required for every mutating catalogue operation and absent or null for every non-mutating operation; a violation is IdempotencyConflict."
request = "The operation request object of the named catalogue operation."

[record.AgentHttpCredential]
fields = ["tenant:utf8","session_id:hex32","token_id:hex32","generation:Sequence"]
tenant = "Non-empty UTF-8, at most 255 bytes, no NUL."
session_id = "Lowercase 64-hex, 32 bytes."
token_id = "Lowercase 64-hex, 32 bytes."
generation = "Canonical decimal string of a u64: no sign, no leading zero except the single digit 0, no whitespace."
authority = "The daemon authenticates these exact coordinates; the agent is taken only from the authenticated token. A tenant or agent coordinate inside the request that differs from the authenticated principal is PolicyRefusal. A LayerX-Tenant, LayerX-Agent or Authorization header reaching the daemon is PolicyRefusal."

[record.AgentHttpSuccess]
fields = ["request_id:Sequence","value:canonical-map","verification_status:VerificationStatus"]
verification_status = "Either {state:\"achieved\",level:L} or {state:\"unverified\",requested:L,achieved:L,reason:ReasonCode} with achieved strictly below requested; L is one of Unverified, SequencerSigned, BatchIncluded, StateProven, CheckpointFinalised, SettlementAnchored. An unverified status that violates the ordering is refused as VerificationFailure verification.inconsistent."

[record.AgentHttpError]
fields = ["class:ErrorClass","protocol_result_code:i32?","retriability:Retriability","request_id:Sequence","reason:utf8"]
request_id = "The envelope request_id when it was parsed, otherwise 0."

[transport.agent_http.semantics]
retired = "faucet.claim returns UnavailableCapability with reason unavailable_capability.faucet.claim and Terminal retriability."
ambiguity = "A mutating request whose outcome is not known to the client is Unknown and is never resent automatically; a repeat with the same idempotency key and body returns the original result, a different body under the same key is IdempotencyConflict."

body_digest = "Internal and derived server side only: for operations executed through the durable store it is SHA-256 over the domain LXP/agent/request/v1 followed by one NUL byte and the exact canonical request bytes of the selected owner typed operation. It is never supplied by the caller, never a raw JSON hash, and token_id and request_id are not inputs. The public envelope carries only idempotency_key. Existing Human prepare, submit and owner-install digests are unchanged. Same key with the same digest replays the recorded outcome; same key with a different digest is IdempotencyConflict."

[compatibility.history.1_3]
classification = "additive_only"
baseline = "golden/v1.kvx@1.2"
change = "Adds the version 1 Agent HTTP operation envelope transport and its session credential binding without changing any contract 1.2 declaration."

[compatibility.feature.agent_http]
introduced_contract = "1.3"
classification = "additive_only"

[transport.agent_http.idempotency]
rule = "idempotency_key is required if and only if Operation::mutating() is true for the named operation; a missing key on a mutating operation or a key on a non-mutating operation is IdempotencyConflict envelope.idempotency_key."
keyed_execution = "prepare and submit carry the key in the owner mutation envelope directly; every other mutating operation is executed through the durable idempotency store only when canonical request bytes are defined for it, otherwise it is UnavailableCapability idempotency.unsupported_operation."

[transport.agent_http.dispositions]
served_dispatcher_arm = "Decoded into the owner typed request and executed by an arm of the daemon dispatcher."
served_adapter_arm = "Decoded into the owner typed request and executed by a named owner adapter arm that the daemon dispatcher routes the operation to."
refused_pending_bootstrap_artifact = "A bootstrap operation with a null credential; refused until the authenticated bootstrap artifact exists. Never served."
unmatched_by_ruling = "Deliberately given no arm. Never served."
retired = "Refused before dispatch as UnavailableCapability unavailable_capability.faucet.claim, Terminal."
not_served_no_arm = "A catalogue operation with no dispatcher or adapter arm in this contract revision. Never served."
surface = "Subscribe class operations use the Subscription caller surface, Export class operations the Export surface, every other operation the Contract surface."

[transport.agent_http.operation.agent.register]
request = "The request object of this catalogue operation; the daemon declares no typed decoder for it in this contract revision."
access = "mutation"
operation_class = "none"
surface = "Contract"
idempotency_key = "required"
disposition = "refused_pending_bootstrap_artifact"

[transport.agent_http.operation.approval.approve]
request = "ApprovalDecisionRequest"
access = "mutation"
operation_class = "Approve"
surface = "Contract"
idempotency_key = "required"
disposition = "served_adapter_arm"

[transport.agent_http.operation.approval.get]
request = "ApprovalGetRequest"
access = "read"
operation_class = "Approve"
surface = "Contract"
idempotency_key = "absent"
disposition = "served_dispatcher_arm"

[transport.agent_http.operation.approval.list]
request = "ApprovalListRequest"
access = "read"
operation_class = "Approve"
surface = "Contract"
idempotency_key = "absent"
disposition = "served_dispatcher_arm"

[transport.agent_http.operation.approval.reject]
request = "ApprovalDecisionRequest"
access = "mutation"
operation_class = "Approve"
surface = "Contract"
idempotency_key = "required"
disposition = "served_adapter_arm"

[transport.agent_http.operation.availability.fetch]
request = "AvailabilityWire, deny_unknown_fields, decoded by the availability_fetch adapter into AvailabilityRequest: optional tenant, optional agent, selector, requested_verification_level (kebab-case level), maximum_bytes (decimal_string u64), maximum_chunks (decimal_string u32), deadline (decimal_string u64 seconds)."
access = "read"
operation_class = "Read"
surface = "Contract"
idempotency_key = "absent"
disposition = "served_adapter_arm"

[transport.agent_http.operation.budget.create]

owner_request = "MutationEnvelope<SignedBudgetMutation<BudgetCreate>>"
response = "AuthorityResponse<BudgetRecord>"
phase_b_dependency = "Served only once the dispatcher arm, the adapter decoding the signed-authorization carrier and the owner create method over the versioned core budget codecs and the durable daemon limit registry exist."
request = "BudgetCreateWire, deny_unknown_fields: tenant, agent_did, asset, limit (decimal_string u128), enforcement (ProtocolBudget or DaemonLimit), expiry (decimal_string u64 seconds), optional purpose (TextV1 text label, checked by equality against the signed identity purpose by the owner budget_create), and optional authorization, the signed-authorization carrier {preparation_ref, signature, optional signer_public_key}."
access = "mutation"
operation_class = "Write"
surface = "Contract"
idempotency_key = "required"
disposition = "served_adapter_arm"

[transport.agent_http.operation.budget.fund]

owner_request = "MutationEnvelope<SignedBudgetMutation<BudgetFund>>"
response = "AuthorityResponse<BudgetRecord>"
phase_b_dependency = "Served only once the dispatcher arm, the adapter decoding the signed-authorization carrier and the optional enforcement assertion, and the owner fund method over the versioned core fund codec and the verified budget state exist."
request = "BudgetFundWire, deny_unknown_fields: tenant, agent_did, budget_id, amount (decimal_string u128), enforcement (ProtocolBudget or DaemonLimit), and optional authorization, the signed-authorization carrier BudgetAuthorizationWire {preparation_ref, signature, optional signer_public_key}."
access = "mutation"
operation_class = "Write"
surface = "Contract"
idempotency_key = "required"
disposition = "served_adapter_arm"

