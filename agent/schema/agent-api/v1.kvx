disposition = "served_adapter_arm"

[transport.agent_http.errors]
classes = "Every error is one ErrorClass variant from errors.kvx: TransportFailure, Deadline, ProtocolIncompatibility, UnavailableCapability, CoreRejection, VerificationFailure, PolicyRefusal, CapabilityRefusal, BudgetRefusal, RateLimit, IdempotencyConflict, InternalFault."
transport_ambiguity = "A mutating request whose outcome the client cannot know is reported to the caller as Unknown."
"envelope.oversized" = "ProtocolIncompatibility Terminal. Body above max_body_bytes."
"envelope.malformed" = "ProtocolIncompatibility Terminal. Body is not one well-formed envelope object."
"envelope.unknown_field" = "ProtocolIncompatibility Terminal. Envelope or request object carries an unknown key."
"envelope.version" = "ProtocolIncompatibility Terminal. Envelope version other than 1."
"envelope.unknown_operation" = "ProtocolIncompatibility Terminal. Operation is not a catalogue operation name."
"envelope.noncanonical_integer" = "ProtocolIncompatibility Terminal. An integer string is not canonical decimal."
"envelope.credential" = "ProtocolIncompatibility Terminal. Credential missing or a credential coordinate is malformed."
"refused_pending_bootstrap_artifact" = "PolicyRefusal Terminal. agent.register or session.open before the authenticated bootstrap artifact exists."
"unmatched_by_ruling" = "UnavailableCapability Terminal. program.interface or read.proof_bundle, deliberately given no arm."
"envelope.idempotency_key" = "IdempotencyConflict Terminal. Idempotency key presence violates the idempotency rule or the key is malformed."
"envelope.coordinate_mismatch" = "PolicyRefusal Terminal. A request tenant or agent coordinate differs from the authenticated principal."
"envelope.header_principal" = "PolicyRefusal Terminal. A LayerX-Tenant, LayerX-Agent or Authorization header reached the daemon."
"envelope.peer_unmapped" = "PolicyRefusal Terminal. The authenticated principal maps to no owner peer."
"unavailable_capability.faucet.claim" = "UnavailableCapability Terminal. The retired faucet.claim operation."
"idempotency.unsupported_operation" = "UnavailableCapability Terminal. A keyed mutation without defined canonical request bytes."
"idempotency.body_changed" = "IdempotencyConflict Terminal. Same idempotency key with a different body digest."
"outcome.unknown" = "TransportFailure Terminal. Mutation outcome is Unknown; never resent automatically."
"session.scope_denied" = "CapabilityRefusal Terminal. Session scope does not admit the operation surface."
"session.expired" = "PolicyRefusal Terminal. Session expired."
"session.revoked" = "PolicyRefusal Terminal. Session revoked."
"session.invalid_request" = "ProtocolIncompatibility Terminal. Session authorization request is invalid."
"session.not_authorized" = "PolicyRefusal Terminal. Session authority does not authorize the credential."
"owner.degraded" = "UnavailableCapability Retriable. Owner is not Healthy."
"owner.unavailable" = "InternalFault Retriable. Owner unavailable at the daemon; the dispatcher maps an owner Unavailable error to UnavailableCapability Retriable with this reason."
"owner.refused" = "PolicyRefusal Terminal. Owner refused the typed operation."

"policy.legacy_project_payload" = "PolicyRefusal Terminal. A project request carries the earlier policy dry-run payload; it is never read as a fee request."
"policy.intent_binding_missing" = "PolicyRefusal Terminal. A LegacyPolicyDryRun canonical_intent carries raw canonical unsigned activity bytes whose typed semantics or retained purpose binding does not exist."
"budget.not_found" = "BudgetRefusal Terminal. The authenticated budget lookup names no budget of this tenant and agent."
"capability.expiry" = "CapabilityRefusal Terminal. Owner refused the typed operation: core protocol time is at or past the capability not_after."
"capability.activity_type" = "CapabilityRefusal Terminal. Owner refused the typed operation: the capability does not admit the activity type."
"capability.counterparty" = "CapabilityRefusal Terminal. Owner refused the typed operation: the capability does not admit the counterparty."
"capability.asset" = "CapabilityRefusal Terminal. Owner refused the typed operation: the capability does not admit the asset."
"capability.amount" = "CapabilityRefusal Terminal. Owner refused the typed operation: the amount exceeds the capability ceiling."
"capability.rate" = "CapabilityRefusal Terminal. Owner refused the typed operation: the capability rate window is exhausted."
"capability.purpose" = "CapabilityRefusal Terminal. Owner refused the typed operation: the capability does not admit the purpose."
"owner.response_malformed" = "InternalFault Terminal. Owner response did not decode."
"verification.inconsistent" = "VerificationFailure Terminal. Verification status violates the level ordering."

[compatibility.history.1_4]
classification = "additive_only"
baseline = "golden/v1.kvx@1.3"
change = "Adds the Agent HTTP per-operation disposition table, the emitted error reason list and the idempotency rule without changing any contract 1.3 declaration."

[compatibility.history.1_5]
classification = "additive_only"
baseline = "golden/v1.kvx@1.4"
change = "Marks the Agent HTTP operations that the daemon dispatcher now routes to owner adapter arms as served_adapter_arm."

[compatibility.history.1_6]
classification = "additive_only"
baseline = "golden/v1.kvx@1.5"
change = "Marks budget.list, read.batch, read.history, read.module_state, session.close, session.refresh, wait, sign, subscription.create, subscription.list, subscription.pause, subscription.resume, subscription.delete, subscription.health and subscription.acknowledge as served_adapter_arm: the daemon dispatcher routes each to a named owner adapter arm. Source compatibility statement only."
owner_body_incomplete = ["sign","subscription.create","subscription.list","subscription.health","read.history"]
adapter_arm_scope = "served_adapter_arm asserts only that a dispatch arm and adapter exist; it does not assert a completed real owner, working behaviour or qualification."

[compatibility.history.1_7]
classification = "additive_only"
baseline = "golden/v1.kvx@1.6"
change = "Declares the subscription.create mutation envelope and creation identity, permit-bound subscription.list and subscription.health, the read.history cursor text, page limit bound and kind byte table, and the sign response shape. Adds keys only; no existing declaration or disposition changes. Source compatibility statement only."

[compatibility.history.1_8]
classification = "additive_only"
baseline = "golden/v1.kvx@1.7"
change = "Declares CapabilityRecord, CapabilityRecords, CapabilityState and AuthorityDescription, the capability.create, attenuate and revoke mutation envelopes, identities and replay rules, permit-bound capability.list, and the owner request and response of the four capability Agent HTTP rows. Adds keys only; no existing declaration or disposition changes. Source compatibility statement only."
capability_disposition = "capability.create, capability.attenuate, capability.list and capability.revoke stay not_served_no_arm: no owner adapter or owner body exists in this contract revision."
capability_refusal_reasons = "Adds the emitted error reasons capability.expiry, capability.activity_type, capability.counterparty, capability.asset, capability.amount, capability.rate and capability.purpose, each CapabilityRefusal Terminal: the dispatcher maps an owner capability refusal to the existing CapabilityRefusal class with the refused dimension as the reason. No new error class; owner.refused and owner.unavailable unchanged."

[compatibility.history.1_9]
classification = "additive_only"
baseline = "golden/v1.kvx@1.8"
change = "Declares the fee projection request and result of project, the separate policy.dry_run catalogue operation and its local result, the budget authorization carrier, BudgetRecord and BudgetRecords, the offline export fact grammar, record encodings and level rule, the freshness wire form, the optional prepare capability_id and the kind 5 interface limitation. Adds keys, sections and one catalogue operation; no existing declaration or disposition changes. Source compatibility statement only."
new_operation = "policy.dry_run, budget.state"
dispositions = "project, export.offline, program.discover, budget.state and policy.dry_run are served_adapter_arm. budget.create, budget.fund and budget.revoke stay not_served_no_arm: their dispatcher arms, adapters and owner methods are not in this contract revision."
capability_binding = "prepare serves the nine-field request and accepts an optional capability_id, decoded and bound by the daemon capability binding."
sdk_policy_dry_run = "The SDK envelope transport policy_dry_run method names policy.dry_run with the typed request and preserves the policy dry-run semantics. A Project request carrying the earlier policy payload is refused as policy.legacy_project_payload, never reinterpreted."
legacy_project_reason = "Adds the emitted error reason policy.legacy_project_payload, PolicyRefusal Terminal. No new error class."
legacy_policy = "policy.dry_run accepts the second request shape LegacyPolicyDryRun with the PolicyIntent grammar and adds the emitted error reason policy.intent_binding_missing, PolicyRefusal Terminal. Typed request and response unchanged."
budget_state = "Adds the catalogue operation budget.state, BudgetTarget to AuthorityResponse<BudgetState>, served_adapter_arm, and the emitted error reason budget.not_found, BudgetRefusal Terminal. No new error class."

[compatibility.feature.agent_http_operations]
introduced_contract = "1.4"
classification = "additive_only"
