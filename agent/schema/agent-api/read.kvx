[module]
name = "read"
contract_major = 1
compatibility = "additive_only"

[type.VerifiedRead]
required = ["value","achieved_verification_level","freshness"]
value_constraint = "core_produced_only"

[type.Freshness]
required = ["chain_head","latest_sealed_batch","latest_finalised_checkpoint","value_sequence","relative_to"]
chain_head = "decimal_string"
value_sequence = "decimal_string"
latest_sealed_batch = "non-empty text"
latest_finalised_checkpoint = "non-empty text"
relative_to = "An object with exactly one key, batch or checkpoint, whose value is the non-empty reference text."

[operation.read.balance]
request_required = ["account","asset","requested_verification_level"]
response = "VerifiedRead<BalanceValue>"

[operation.read.account]
request_required = ["account","requested_verification_level"]
response = "VerifiedRead<AccountValue>"

[operation.read.module_state]
request_required = ["module","key","requested_verification_level"]
response = "VerifiedRead<ModuleStateValue>"

[operation.read.history]
request_required = ["range","cursor","page_limit","requested_verification_level"]
response = "VerifiedRead<HistoryValue>"
cursor_text = "112 lowercase hex characters: big-endian next_sequence, end_sequence and observed head_sequence u64 values followed by the 32-byte observed checkpoint; any other text is refused as malformed."
page_limit_encoding = "canonical_decimal_string"
page_limit_bound = "A page_limit above 65535 is refused as malformed; it is never clamped."
response_required = ["items","cursor"]
response_cursor = "112-hex cursor text or null; its head sequence and checkpoint come from the returned page cursor, never from a second head read."

[operation.read.batch]
request_required = ["batch","requested_verification_level"]
response = "VerifiedRead<BatchValue>"

[operation.read.checkpoint]
request_required = ["checkpoint","requested_verification_level"]
response = "VerifiedRead<CheckpointValue>"

[operation.read.proof_bundle]
request_required = ["target","requested_verification_level"]
response = "VerifiedRead<ProofBundle>"
request_type = "ReadRequest<CanonicalBytes>; target must decode as ProofBundleTarget"
target = "Lowercase hex of the existing native PB1 selector: u16be version 1, kind byte, activity_id bytes32, and account_id bytes32 only for kind 2. Kind 1 Activity and kind 3 Receipt are exactly 35 bytes; kind 2 AccountState is exactly 67 bytes. Zero IDs, unknown versions or kinds, extra fields, uppercase hex, whitespace, 0x prefixes and trailing bytes are refused."
response_required = ["target","proofs"]
response_target = "Exact canonical PB1 bytes from the request, encoded as lowercase hex."
response_proofs = "Exactly one lowercase-hex LXPB1 ProofBundleRecord. Native Account and MaintainedAccount remain distinct variants; none is flattened into an inclusion proof."
requested_verification_level = "The existing Level enum. Activity and Receipt achieve BatchIncluded; Account and MaintainedAccount achieve StateProven. A requested level above the variant's achieved level is refused. CheckpointFinalised and SettlementAnchored are not claimed by PB1 evidence."
ownership = "The owner requires an actual ReadProofBundle OperationPermit, revalidates its full session/token/generation boundary before and after acquisition, and matches the bound subject to its tenant and agent. The authenticated and authority-authorized subject must own the tenant's retained activity index and signed outbox entry. Their idempotency key and activity ID must agree, and the signed actor must equal the subject owner. The stored verified receipt must name the same activity and idempotency key. Missing records or another principal are refused; public knowledge of an activity ID grants no access."
asset_binding = "The subject's fresh authority balance context must bind its canonical account and asset. The native activity must match retained bytes and the native receipt must match stored verified bytes. The receipt asset must equal the nonzero subject asset. Account targets must additionally equal the bound account, and the verified canonical account asset must match. Assetless activity receipts and activities of another subject actor are refused by this proposal."
authority = "Acquisition uses the existing native Client proof_bundle verifier with its authenticated handshake sequencer key and configured network and protocol. Requests cannot supply an authority, key, header, proof or trust override. Existing current-key or historical-key refusals are preserved. A returned SH1 key is evidence, never an independent trust anchor."
head_binding = "Activity, receipt and any account evidence must carry the same signed header in the captured native network and protocol. Its batch and last sequence may not exceed the captured head, and it must contain the activity receipt sequence. AccountState answers require that header's batch and last sequence to equal the captured head. A second authenticated native observation must have unchanged network, protocol, sequencer authority key, head sequence, sealed batch and checkpoint, otherwise no response is served."
freshness_rule = "Freshness carries the captured head sequence, sealed batch and checkpoint identifier; relative_to is the verified evidence batch. value_sequence is the activity receipt sequence for Activity or Receipt, and the verified header last sequence for either account variant. A checkpoint identifier is a freshness coordinate, not checkpoint proof."
size_bound = "One framed record is at most 262144 bytes; oversized evidence is refused, never truncated or split. Lowercase hex plus the fixed response fields must also obey the unchanged 1048576-byte JSON transport limit."

[type.ProofBundleTarget]
variants = ["Activity","AccountState","Receipt"]
encoding = "The existing native PB1 selector, without a new selector language. Rust ProofBundleTarget decodes and canonically re-encodes these exact bytes."

[type.ProofBundleRecord]
magic = "Five ASCII bytes LXPB1; the final byte identifies framing version 1."
variant = "u8: Activity=1, Account=2, Receipt=3, MaintainedAccount=4; unknown variants are refused."
fields = "After magic and variant: canonical_value:counted_bytes, native_proof:counted_bytes. MaintainedAccount alone then carries activity_receipt:counted_bytes and activity_receipt_sp1:counted_bytes. Each counted_bytes is nonzero u32be byte length followed by exactly that many bytes."
canonical_value = "Exact native canonical signed activity, account value or protocol receipt according to the variant."
native_proof = "Activity and Receipt preserve native version:u16be=1, kind:u8, activity_id:bytes32, SP1, SH1. Both account variants preserve exact NP1 bytes, including its Activity or Maintenance evidence kind and signed header."
sp1 = "Native SP1: leaf_index:u32be, leaf_count:u32be, depth:u8, then depth 32-byte siblings. This is not the separate version-prefixed public Merkle encoding."
sh1 = "Native SH1: version:u16be=1, sequencer_id:bytes32, public_key:bytes32, first_batch:u64be, last_batch:u64be, canonical_header:u32be length plus bytes, signature:bytes64."
maintenance = "The extra receipt is the genuine activity receipt linked by the native verifier to the maintenance transition in NP1, with its retained SP1 inclusion proof. No maintenance receipt is substituted for that activity receipt."
validation = "Decode requires the known magic, exact variant fields, nonempty bounded counted fields and no trailing bytes. ProofBundle::record checks exactly one record and target-to-variant agreement. ProofBundle::check_response additionally requires the exact requested target, the precise variant level and satisfaction of the requested level. These framing and response-consistency checks are not cryptographic verification."
consumer_verification = "Consumers must retain the distinction between all four variants, compare returned PB1 target to requested bytes, check claimed level against requested level, and use independent native authority and domain context when verifying evidence. A response key or claimed level alone is never sufficient proof."


[operation.availability.fetch]
request_required = ["selector","requested_verification_level","maximum_bytes","maximum_chunks","deadline"]
response = "VerifiedRead<AvailabilityReport>"
response_required = ["completion","classes","providers"]
provider_isolation = "A complete result names one provider. Partial reports remain provider attributed and bytes are never merged across providers."

[operation.export.offline]
request_required = ["fact_set","requested_verification_level"]
response = "VerifiedRead<OfflineExport>"
response_required = ["facts","receipts","proofs","certificates","headers"]
settlement_domain = "Paxeer"
verification_environment = "layerx-proof_without_daemon_or_network"
request_type = "ReadRequest<FactRef[]>"
fact_set = "FactRef[] of 1 through 16 unique references in request order"
requested_verification_level = "One of Unverified, SequencerSigned, BatchIncluded, StateProven, CheckpointFinalised, SettlementAnchored. It is honoured: an achieved level below it is refused, never downgraded."
response_shape = "VerifiedRead object with value, achieved_verification_level and freshness; value holds facts, receipts, proofs, certificates and headers. The envelope verification_status is achieved at the same level."
facts = "Exactly the requested fact references in request order."
receipts = "lowercase hex of canonical LXRF version 1 receipt records"
headers = "lowercase hex of canonical LXHD version 1 signed header records"
proofs = "lowercase hex of canonical LXIP version 1 inclusion records or LXAS version 1 account-state records"
certificates = "lowercase hex of canonical LXCP version 1 checkpoint records with their full availability chunks"
record_rule = "Each record decodes only when its magic, version and tags are known, nothing trails it, every bound holds and its canonical re-encoding equals the received bytes."
binding = "Every requested fact binds exactly one primary record. Dependency records may be shared by several facts. Every record must be consumed by a requested fact; an orphan or duplicate record is refused. There is no partial success."
level_rule = "The achieved level is computed per requested fact from verified evidence links, and the response level is the minimum over the requested facts. receipt and activity facts reach BatchIncluded, state facts StateProven and checkpoint facts CheckpointFinalised. A receipt, activity or state fact reaches CheckpointFinalised only when a verified checkpoint record certifies the exact same header bytes. StateProven is never given to a receipt or activity fact."
settlement_anchored = "A request for SettlementAnchored is refused: no authenticated offline Paxeer finality proof exists in this contract revision."
freshness_rule = "Freshness names the captured head and finality coordinates and the batch or checkpoint the evidence is relative to; facts relative to unrelated snapshots are not presented as one common root."
size_bound = "The complete JSON response stays within the 1048576 byte transport body bound; a larger export is refused, never truncated."
offline_verification = "Decode the buckets into the complete offline artifact with an independent offline trust context made of the module registry, the signed authority history, the settlement domain and the trusted checkpoint membership, then run the pure complete verifier at the requested level. The response level is not trusted; a verified level below it is refused."
legacy_verifier = "The earlier receipt-and-proof offline verifier remains available and covers only its own export shape."

[operation.project]
response = "ProjectionResult"
forbidden_response = "VerifiedRead"
semantics = "An estimate is never core-produced, never receipt-shaped and never an executed outcome."
request = "FeeProjectionRequest"
request_required = ["protocol_activity_type","canonical_bytes","execution_units","storage_units"]
response_value = "ProjectionResult<FeeProjection>"
response_required = ["projected","rationale","observed_freshness"]
verification_status = "Always achieved at Unverified: a projection claims no verification level."
producer = "The node fee estimate over one captured authenticated head; the estimate snapshot sequence must equal the captured head chain sequence, otherwise the projection is refused. Head and checkpoint coordinates are those of the captured observation, not part of an atomic native fee answer."
legacy_policy_payload = "A request object of the earlier policy dry-run shape, context and canonical_intent, is refused as PolicyRefusal policy.legacy_project_payload. It is never read as a fee request; policy evaluation is policy.dry_run."

[type.HistoryItem]
required = ["global_sequence","kind","achieved_verification_level","canonical","proof"]
global_sequence = "decimal_string"
canonical = "lowercase_hex"
proof = "lowercase hex or null"

[type.HistoryKind]
variants = ["Activity","Receipt","Event"]
wire_byte = ["Activity:1","Receipt:2","Event:3"]
exhaustive = "Any other kind byte is refused; there is no default kind."

[type.FactRef]
grammar = ["receipt:<activity_id>","activity:<activity_id>","state:<activity_id>:<account_id>","checkpoint:<activity_id>:<batch>"]
activity_id = "64 lowercase hex characters, not all zero"
account_id = "64 lowercase hex characters, not all zero"
batch = "canonical decimal u64 with checked overflow; 0 is refused and never means latest"
maximum_bytes = "135"
refused = "Whitespace, uppercase hex, a 0x prefix, an unknown kind, extra fields, trailing bytes and duplicate references are refused."
parser = "One shared strict parser used by the daemon and every SDK."
ownership = "The activity_id of every kind is the tenant ownership anchor; a state reference is additionally bound to the subject account."

[type.FeeProjectionRequest]
required = ["protocol_activity_type","canonical_bytes","execution_units","storage_units"]
protocol_activity_type = "decimal_string u32: full protocol module and ordinal"
canonical_bytes = "decimal_string 0 through 1048576 inclusive, the native activity size bound; zero is accepted; a larger value is refused, never clamped"
execution_units = "decimal_string u64"
storage_units = "decimal_string u64"

[type.FeeProjection]
required = ["request","parameter_version","fee","canonical_schedule","snapshot_sequence","snapshot_state_root"]
request = "The FeeProjectionRequest exactly as sent."
parameter_version = "decimal_string u32, nonzero"
fee = "decimal_string u128, exact"
canonical_schedule = "lowercase hex of the canonical fee schedule bytes"
snapshot_sequence = "decimal_string u64: the committed snapshot the estimate answered from, equal to observed_freshness.chain_head and observed_freshness.value_sequence"
snapshot_state_root = "64 lowercase hex characters, nonzero: committed-snapshot provenance, not cryptographic verification and not an executed receipt"

[type.ProjectionResult]
required = ["projected","rationale","observed_freshness"]
rationale = "non-empty text"
constraint = "Never core-produced, never VerifiedRead and never an executed outcome."
