# /etc/layerx/kernel.env (0600 root) of the kernel box, read by
# docker/kernel/layerx-kernel.service (systemd and docker --env-file).
# Values are unquoted; an empty value counts as unset.

LAYERX_KERNEL_IMAGE=ghcr.io/sidiora-labs/layerx-kernel:<12-hex sha>

# Both profiles.
LAYERX_KERNEL_PROFILE=native
LAYERX_NODE_NETWORK_ID=125
LAYERX_KERNEL_PAXEER_RPC_NAMES=api1.mainnet-beta.paxeer.network api12.mainnet-beta.paxeer.network
LAYERX_TLS_DIR=/data/tls
LAYERX_CA_CERT_FILE=/etc/layerx/trust/ca.crt

# Kernel bearers from tools/bringup/mint-secrets.sh; unset ones are generated on the volume.
LAYERX_KERNEL_PROGRAM_TOKEN=
LAYERX_KERNEL_REPLICA_TOKEN=
LAYERX_KERNEL_BACKEND_ADMIN_TOKEN=
LAYERX_KERNEL_GATEWAY_COMPONENT_TOKEN=
LAYERX_KERNEL_GATEWAY_AUTHORITY_TOKEN=
LAYERX_KERNEL_WEBHOOKS_COMPONENT_TOKEN=
LAYERX_KERNEL_WEBHOOKS_AUTHORITY_TOKEN=

# Program registry bearers (index.paxeer.network); native generates unset ones on the volume.
LAYERX_REGISTRY_NODE_AUTHORIZATION=
LAYERX_REGISTRY_RECEIPT_AUTHORITY_AUTHORIZATION=

# Mirror signer and publisher inputs, base64; both wait while unset.
LAYERX_KERNEL_MIRROR_ETHEREUM_KEY=
LAYERX_KERNEL_MIRROR_SOLANA_KEYPAIR=
LAYERX_KERNEL_MIRROR_CONFIG=
LAYERX_KERNEL_MIRROR_RPC_CREDENTIALS=

# Full profile only.
LAYERX_NODE_NETWORK_NAME=
LAYERX_KERNEL_AGENTD_RPC_PEER=
LAYERX_KERNEL_AGENTD_RPC_DAEMON_SEQUENCES=
LAYERX_KERNEL_AGENTD_RPC_PROTOCOL_SEQUENCES=
LAYERX_KERNEL_AGENTD_RPC_LISTEN=[::]:9454
LAYERX_HUMAN_EVM_GAS_LIMIT=
LAYERX_HUMAN_EVM_MAX_FEE_PER_GAS=
LAYERX_HUMAN_EVM_MAX_PRIORITY_FEE_PER_GAS=
LAYERX_HUMAN_ATTESTOR_NODES=attestor-1.example:8443,attestor-2.example:8443,attestor-3.example:8443,attestor-4.example:8443,attestor-5.example:8443
#LAYERX_HUMAN_IDENTITY_PROVIDER_BINDING_TENANT=<must equal the policy bundle tenant when set>
#LAYERX_HUMAN_KMS_REGISTRY_SOURCE=/data/layerx/keys/human-kms/module-registry.json

# Oracle feeder (full profile); lni_socket in the config is replaced by layerxd's socket.
LAYERX_FEEDER_CONFIG=/data/layerx/oracle-feeder/feeder.json
LAYERX_FEEDER_ORACLE_KEY_FILE=/data/layerx/keys/oracle-feeder/oracle.key
LAYERX_FEEDER_READYZ_ADDR=127.0.0.1:9458

# Human service (full profile).
LAYERX_HUMAN_LISTENER=plain
LAYERX_HUMAN_BIND=[::]:8080
LAYERX_HUMAN_COMPONENT_SOCKET=/run/layerx/human/components.sock
LAYERX_HUMAN_WEB_ORIGIN=https://app.paxportwallet.com,https://paxportwallet.com,https://www.paxportwallet.com,https://paxport-production.up.railway.app
LAYERX_HUMAN_REQUESTS_PER_MINUTE=240
LAYERX_HUMAN_MAX_PRINCIPALS=100000
LAYERX_HUMAN_MAX_HEADER_BYTES=32768
LAYERX_HUMAN_MAX_BODY_BYTES=1048576
LAYERX_HUMAN_MAX_CONNECTIONS=1024
LAYERX_HUMAN_IO_DEADLINE_SECONDS=15
LAYERX_HUMAN_RP_ID=paxportwallet.com

# Event producers: Railway services internal-journeys, internal-approvals and
# webhooks-ingress through their Railway TCP proxies; tokens bind-mounted from
# /etc/layerx/kernel-secrets to /run/secrets.
LAYERX_EVENTS_JOURNEY_UPSTREAM_URL=https://<internal-journeys>.proxy.rlwy.net:<port>
LAYERX_EVENTS_JOURNEY_UPSTREAM_CA_DER=/data/tls/human-event-client/ca.der
LAYERX_EVENTS_JOURNEY_UPSTREAM_TOKEN_FILE=/run/secrets/events-journey-token
LAYERX_EVENTS_JOURNEY_UPSTREAM_CLIENT_IDENTITY_PKCS12=/data/tls/human-event-client/identity.p12
LAYERX_EVENTS_JOURNEY_UPSTREAM_CLIENT_IDENTITY_PASSWORD_FILE=/data/tls/human-event-client/password
LAYERX_EVENTS_APPROVAL_UPSTREAM_URL=https://<internal-approvals>.proxy.rlwy.net:<port>
LAYERX_EVENTS_APPROVAL_UPSTREAM_CA_DER=/data/tls/human-event-client/ca.der
LAYERX_EVENTS_APPROVAL_UPSTREAM_TOKEN_FILE=/run/secrets/events-approval-token
LAYERX_EVENTS_APPROVAL_UPSTREAM_CLIENT_IDENTITY_PKCS12=/data/tls/human-event-client/identity.p12
LAYERX_EVENTS_APPROVAL_UPSTREAM_CLIENT_IDENTITY_PASSWORD_FILE=/data/tls/human-event-client/password
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_URL=https://<webhooks-ingress>.proxy.rlwy.net:<port>
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_CA_DER=/data/tls/human-event-client/ca.der
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_TOKEN_FILE=/run/secrets/events-webhooks-token
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_CLIENT_IDENTITY_PKCS12=/data/tls/human-event-client/identity.p12
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_CLIENT_IDENTITY_PASSWORD_FILE=/data/tls/human-event-client/password
