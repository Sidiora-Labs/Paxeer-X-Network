[Unit]
Description=LayerX program registry
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=exec
EnvironmentFile=/etc/layerx/registry.env
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/layerx/registry
ExecStartPre=-/usr/bin/docker rm -f layerx-registry
ExecStartPre=/usr/bin/docker pull ${LAYERX_REGISTRY_IMAGE}
ExecStartPre=/usr/bin/docker run --rm --name layerx-registry-material --env-file /etc/layerx/registry.env -v /var/lib/layerx/registry:/data ${LAYERX_REGISTRY_IMAGE} --prepare-material
ExecStart=/usr/bin/docker run --rm --name layerx-registry --privileged --cgroupns=private --stop-timeout 30 --env-file /etc/layerx/registry.env -v /var/lib/layerx/registry:/data -p 9420:9420 -p 127.0.0.1:9421:9421 --health-cmd "curl -fsS http://127.0.0.1:9421/healthz" --health-interval 10s --health-timeout 9s --health-start-period 120s ${LAYERX_REGISTRY_IMAGE}
ExecStop=/usr/bin/docker stop -t 30 layerx-registry
Restart=always
RestartSec=5
TimeoutStartSec=2100
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
