LAYERX_REGISTRY_IMAGE=ghcr.io/sidiora-labs/platform-registry:<12-hex sha>
LAYERX_REGISTRY_LISTEN=[::]:9420
LAYERX_REGISTRY_HEALTH_LISTEN=[::]:9421
LAYERX_REGISTRY_TLS_CERT_DER=/data/tls/registry/cert.der
LAYERX_REGISTRY_TLS_KEY_DER=/data/tls/registry/key.der
LAYERX_REGISTRY_CLIENT_CA_DER=/data/tls/registry/ca.der
LAYERX_REGISTRY_OUTBOUND_CA_DER=/data/tls/registry/ca.der
LAYERX_REGISTRY_STATE=/data/state
LAYERX_REGISTRY_JOURNAL=/data/journal
LAYERX_REGISTRY_REQUEST_TOKEN_FILE=/data/tokens/request
LAYERX_REGISTRY_PUBLICATION_TOKEN_FILE=/data/tokens/publication
LAYERX_REGISTRY_BUILDER_ENVIRONMENT_ROOT=/data/builder/rootfs
LAYERX_REGISTRY_BUILDER_ENTRYPOINT=/bin/layerx-build
LAYERX_REGISTRY_BUILDER_ISOLATION_RUNTIME=/usr/bin/bwrap
LAYERX_REGISTRY_BUILDER_JOB_SUPERVISOR=/usr/bin/layerx-cgroup-exec
LAYERX_REGISTRY_HOST_CGROUP_MOUNT=/run/layerx/host-cgroup
LAYERX_REGISTRY_BUILD_ROOT=/data/builds
LAYERX_REGISTRY_BUILD_QUOTA_BYTES=5368709120
LAYERX_REGISTRY_BUILD_QUOTA_INODES=65536
LAYERX_REGISTRY_BUILD_MEMORY_BYTES=2147483648
LAYERX_REGISTRY_BUILD_PROCESS_LIMIT=64
LAYERX_REGISTRY_BUILD_FILE_SIZE_BYTES=67108864
LAYERX_REGISTRY_REQUEST_TIMEOUT_SECONDS=1800
LAYERX_REGISTRY_BUILD_TIMEOUT_SECONDS=1800
LAYERX_REGISTRY_MAX_CONNECTIONS=128
LAYERX_REGISTRY_MAX_BUILDS=4
LAYERX_REGISTRY_NODE_ENDPOINT=https://kernel.paxeer.network:9446
LAYERX_REGISTRY_RECEIPT_AUTHORITY_ENDPOINT=https://kernel.paxeer.network:9445
LAYERX_REGISTRY_SEQUENCER_TRUST_HISTORY=/data/kernel/trust-history
LAYERX_REGISTRY_IDENTITY_URL=https://<identity tcp proxy>.proxy.rlwy.net:<port>
LAYERX_REGISTRY_IDENTITY_CA_DER=/data/tls/registry/ca.der
LAYERX_REGISTRY_IDENTITY_TOKEN_FILE=/run/layerx/secrets/identity-token
LAYERX_REGISTRY_IDENTITY_CLIENT_IDENTITY_PKCS12=/data/tls/registry-event-client/identity.p12
LAYERX_REGISTRY_IDENTITY_CLIENT_IDENTITY_PASSWORD_FILE=/data/tls/registry-event-client/password
LAYERX_EVENTS_PROGRAM_UPSTREAM_URL=https://<internal-programs tcp proxy>.proxy.rlwy.net:<port>
LAYERX_EVENTS_PROGRAM_UPSTREAM_CA_DER=/data/tls/registry/ca.der
LAYERX_EVENTS_PROGRAM_UPSTREAM_TOKEN_FILE=/run/layerx/secrets/program-events-token
LAYERX_EVENTS_PROGRAM_UPSTREAM_CLIENT_IDENTITY_PKCS12=/data/tls/registry-event-client/identity.p12
LAYERX_EVENTS_PROGRAM_UPSTREAM_CLIENT_IDENTITY_PASSWORD_FILE=/data/tls/registry-event-client/password
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_URL=https://<webhooks-ingress tcp proxy>.proxy.rlwy.net:<port>
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_CA_DER=/data/tls/registry/ca.der
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_TOKEN_FILE=/run/layerx/secrets/webhooks-events-token
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_CLIENT_IDENTITY_PKCS12=/data/tls/registry-event-client/identity.p12
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_CLIENT_IDENTITY_PASSWORD_FILE=/data/tls/registry-event-client/password
LAYERX_REGISTRY_NODE_AUTHORIZATION=
LAYERX_REGISTRY_RECEIPT_AUTHORITY_AUTHORIZATION=
REGISTRY_IDENTITY_TOKEN=
REGISTRY_PROGRAM_EVENTS_TOKEN=
REGISTRY_WEBHOOKS_EVENTS_TOKEN=
REGISTRY_REQUEST_TOKEN=
REGISTRY_PUBLICATION_TOKEN=
