# Railway service identity (project layerx, environment beta); one replica, volume at /data.
LAYERX_IDENTITY_LISTEN=[::]:9443
LAYERX_IDENTITY_HEALTH_ADDR=[::]:8080
LAYERX_IDENTITY_TLS_CERT_DER=/data/tls/identity/cert.der
LAYERX_IDENTITY_TLS_KEY_DER=/data/tls/identity/key.der
LAYERX_IDENTITY_STATE_DIR=/data/identity
LAYERX_IDENTITY_SERVICE_TOKENS_DIR=/data/service-tokens
LAYERX_IDENTITY_STORE_KEY_FILE=/data/store/key
LAYERX_IDENTITY_SESSION_TTL_SECONDS=86400
# Optional (unset = off): DER path of the internal CA; set to require client certificates.
# LAYERX_IDENTITY_CLIENT_CA_DER=
# Optional signup settings.
# LAYERX_IDENTITY_SIGNUP_PER_IP_PER_HOUR=
# LAYERX_IDENTITY_SIGNUP_PER_EMAIL_PER_HOUR=
# LAYERX_IDENTITY_SIGNUP_DAILY_CAP=
# LAYERX_IDENTITY_SIGNUP_TOKEN_TTL_SECONDS=
# LAYERX_IDENTITY_DISPOSABLE_DOMAINS_FILE=
# LAYERX_IDENTITY_SIGNUP_OUTBOX_DIR=
# LAYERX_IDENTITY_SMTP_URL=
# LAYERX_IDENTITY_SMTP_FROM=
# Service tokens (tools/bringup/mint-secrets.sh); each is generated on the volume when unset.
IDENTITY_GATEWAY_TOKEN=
IDENTITY_REGISTRY_TOKEN=
IDENTITY_WEBHOOKS_TOKEN=
IDENTITY_DASHBOARD_TOKEN=
IDENTITY_FAUCET_TOKEN=
IDENTITY_TESTNET_TOKEN=
IDENTITY_RAMP_TOKEN=
IDENTITY_PROVISIONING_TOKEN=
IDENTITY_REGISTRAR_TOKEN=
