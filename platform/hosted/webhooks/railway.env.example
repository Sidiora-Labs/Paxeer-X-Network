# Railway project layerx, environment beta: two services from
# docker/platform-webhooks/Dockerfile, webhooks-public and webhooks-ingress.
# platform/hosted/webhooks/env-init.sh sets the role's listener, health listener and
# credential paths from LAYERX_ROLE. Every file row is an env var holding base64,
# written by layerx-env-files to the path shown before the init runs; values are
# the base64 lines tools/bringup/mint-secrets.sh and tools/bringup/ca.sh print.
# PORT, when set, moves the plain GET /healthz listener; it never moves the TLS listener.

# both services
LAYERX_FILES_OWNER=65532:65532
LAYERX_WEBHOOKS_REDIS_URL=rediss://redis-internal.railway.internal:6379
LAYERX_WEBHOOKS_KMS_URL=https://internal-kms.railway.internal:9443
LAYERX_WEBHOOKS_IDENTITY_URL=https://identity.railway.internal:9443
LAYERX_WEBHOOKS_AUTHORITY_URL=https://kernel.paxeer.network:9445
LAYERX_WEBHOOKS_COMPONENT_URL=https://kernel.paxeer.network:9446
LAYERX_WEBHOOKS_JOURNEY_SOURCE_URL=https://internal-journeys.railway.internal:9443
LAYERX_WEBHOOKS_PAYMENT_SOURCE_URL=https://internal-payments.railway.internal:9443
LAYERX_WEBHOOKS_APPROVAL_SOURCE_URL=https://internal-approvals.railway.internal:9443
LAYERX_WEBHOOKS_PROGRAM_SOURCE_URL=https://internal-programs.railway.internal:9443
LAYERX_WEBHOOKS_LXP_WIRE_VERSION=3
LAYERX_WEBHOOKS_DISPATCH_INTERVAL_SECONDS=1
LAYERX_WEBHOOKS_DISPATCH_BUDGET=64
LAYERX_WEBHOOKS_LEASE_SECONDS=120
LAYERX_WEBHOOKS_RETENTION_EVENTS=10000
LAYERX_WEBHOOKS_KEY_OVERLAP_SECONDS=86400
LAYERX_WEBHOOKS_INTERNAL_CA_DER=/run/layerx/ca/internal.der
LAYERX_WEBHOOKS_PUBLIC_CA_DER=/run/layerx/ca/public.der
LAYERX_WEBHOOKS_CLIENT_IDENTITY_PKCS12=/run/layerx/client/identity.p12
LAYERX_WEBHOOKS_CLIENT_IDENTITY_PASSWORD_FILE=/run/layerx/client/password
LAYERX_WEBHOOKS_REDIS_USERNAME_FILE=/run/layerx/redis/username
LAYERX_WEBHOOKS_REDIS_PASSWORD_FILE=/run/layerx/redis/password
LAYERX_WEBHOOKS_KMS_TOKEN_FILE=/run/layerx/tokens/kms
LAYERX_WEBHOOKS_CURSOR_KEY_FILE=/run/layerx/keys/cursor
# /run/layerx/tls/server.der and server-key.der: ca.sh issue developer
WEBHOOKS_INGRESS_TLS_CERT_DER=
WEBHOOKS_INGRESS_TLS_KEY_DER=
# /run/layerx/client/identity.p12 and password: ca.sh issue developer-client
WEBHOOKS_CLIENT_P12=
WEBHOOKS_CLIENT_PASSWORD=
# /run/layerx/ca/internal.der and /run/layerx/ca/public.der
WEBHOOKS_CLIENT_CA_DER=
WEBHOOKS_PUBLIC_CA=
# /run/layerx/redis/username and password
WEBHOOKS_REDIS_USERNAME=
WEBHOOKS_REDIS_PASSWORD=
# /run/layerx/tokens/kms and /run/layerx/keys/cursor
WEBHOOKS_KMS_TOKEN=
WEBHOOKS_CURSOR_KEY=
# Not set: WEBHOOKS_INGRESS_TLS_CERT (server.pem) and WEBHOOKS_CLIENT_CERT (client
# cert.pem) duplicate in PEM the certificates the binary reads from server.der and
# identity.p12; no code path reads a PEM file.

# service webhooks-public (https://webhooks-public.railway.internal:9444)
LAYERX_ROLE=public
LAYERX_HEALTH_ADDR=[::]:9442
PORT=9442
# /run/layerx/tokens/identity
WEBHOOKS_IDENTITY_TOKEN=

# service webhooks-ingress (https://webhooks-ingress.railway.internal:9443; the kernel
# box reaches it through the Railway TCP proxy, so its server cert carries that
# proxy name from LAYERX_EXTRA_SANS_<ROW>)
LAYERX_ROLE=ingress
LAYERX_HEALTH_ADDR=[::]:8080
PORT=8080
# The deployment network name the receipt authority echoes in every answer: the kernel
# box's LAYERX_NODE_NETWORK_NAME (docker/kernel/init.sh exports it as
# LAYERX_AUTHORITY_NETWORK_ID), which is also the router's LAYERX_GATEWAY_NETWORK_ID.
# It is a deploy input, not a genesis value, and not the protocol network id 125.
LAYERX_WEBHOOKS_NETWORK_ID=${{router.LAYERX_GATEWAY_NETWORK_ID}}
# /run/layerx/tokens/{component,authority,journey,payment,approval,program,source-trigger,operator}
WEBHOOKS_COMPONENT_TOKEN=
WEBHOOKS_AUTHORITY_TOKEN=
WEBHOOKS_JOURNEY_SOURCE_TOKEN=
WEBHOOKS_PAYMENT_SOURCE_TOKEN=
WEBHOOKS_APPROVAL_SOURCE_TOKEN=
WEBHOOKS_PROGRAM_SOURCE_TOKEN=
WEBHOOKS_SOURCE_TRIGGER_TOKEN=
WEBHOOKS_OPERATOR_TOKEN=
# /run/layerx/keys/{sequencer,sequencer-id,sequencer-first-batch,sequencer-last-batch}:
# the kernel genesis sequencer public key and id and the node's batch range
WEBHOOKS_SEQUENCER_PUBLIC_KEY=
WEBHOOKS_SEQUENCER_ID=
WEBHOOKS_SEQUENCER_FIRST_BATCH=
WEBHOOKS_SEQUENCER_LAST_BATCH=
