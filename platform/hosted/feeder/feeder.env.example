# Oracle feeder on the kernel box (image built from platform/hosted/feeder/Dockerfile,
# context = repository root). It submits over the kernel's LNI unix socket on
# the same box, so the socket is bind-mounted into the container. The oracle
# key file is mode 0600 under keys/.
LAYERX_FEEDER_CONFIG=/data/feeder.json
LAYERX_FEEDER_ORACLE_KEY_FILE=/data/keys/oracle.key
LAYERX_FEEDER_STATE_DIR=/data/state
# Kernel LNI socket; replaces lni_socket of the config file when set.
LAYERX_FEEDER_LNI_SOCKET=/run/layerx/node/layerxd.lni.sock
# Plain listener: GET /healthz (process up) and GET /readyz (last round fresh).
LAYERX_HEALTH_ADDR=[::]:8080
