# Railway service "router" (project layerx, environment beta), image docker/platform-gateway/Dockerfile.
# Healthcheck path /livez. Listen is [::]:$PORT when PORT is set and LAYERX_GATEWAY_LISTEN is unset, else [::]:9443.
LAYERX_ROLE=router
LAYERX_GATEWAY_LISTENER=plain
LAYERX_GATEWAY_LISTEN=[::]:9443
LAYERX_GATEWAY_NETWORK_ID=
LAYERX_GATEWAY_PROTOCOL_NETWORK_ID=125
LAYERX_GATEWAY_LXP_WIRE_VERSION=3
LAYERX_GATEWAY_IDEMPOTENCY_SECONDS=604800

# Public origin and explorer upstreams (beta defaults). Unset PUBLIC_HOST disables the UI and explorer mounts.
LAYERX_GATEWAY_PUBLIC_HOST=api-mainnet-beta.paxeer.network
LAYERX_GATEWAY_EXPLORER_FRONTEND_URL=https://explorer-frontend-production-6eef.up.railway.app
LAYERX_GATEWAY_EXPLORER_BACKEND_URL=https://explorer-backend-production-6fc2.up.railway.app

# Comma list of CIDRs whose X-Forwarded-For is trusted (edge and Railway proxy). Unset: the socket peer is the client.
# LAYERX_GATEWAY_TRUSTED_PROXIES=100.64.0.0/10,fd00::/8

LAYERX_GATEWAY_REDIS_URL=rediss://redis-router.railway.internal:6379
LAYERX_GATEWAY_REDIS_USERNAME_FILE=/run/secrets/redis-username
LAYERX_GATEWAY_REDIS_PASSWORD_FILE=/run/secrets/redis-password
LAYERX_GATEWAY_OUTBOUND_CA_DER=/run/secrets/ca.crt.der
LAYERX_GATEWAY_ROUTE_BINDINGS_FILE=/run/secrets/route-bindings.json
# LAYERX_GATEWAY_UI_BINDINGS_FILE=/run/secrets/ui-bindings.json
# LAYERX_GATEWAY_HPX_INGRESS_FILE=/run/secrets/hpx-ingress.json

LAYERX_GATEWAY_COMPONENT_URL=https://kernel.paxeer.network:9446
LAYERX_GATEWAY_AUTHORITY_URL=https://kernel.paxeer.network:9445
LAYERX_GATEWAY_PUBLIC_CORE_URL=https://kernel.paxeer.network:9443
LAYERX_GATEWAY_IDENTITY_URL=https://identity.railway.internal:9443
LAYERX_GATEWAY_PROGRAM_REGISTRY_URL=https://index.paxeer.network:9420
LAYERX_GATEWAY_PAXEER_RPC_URLS=["https://api1.mainnet-beta.paxeer.network","https://api12.mainnet-beta.paxeer.network"]
LAYERX_GATEWAY_CLIENT_IDENTITY_PKCS12=/run/secrets/client.p12
LAYERX_GATEWAY_CLIENT_IDENTITY_PASSWORD_FILE=/run/secrets/client-password
LAYERX_GATEWAY_COMPONENT_TOKEN_FILE=/run/secrets/component-token
LAYERX_GATEWAY_AUTHORITY_TOKEN_FILE=/run/secrets/authority-token
LAYERX_GATEWAY_IDENTITY_TOKEN_FILE=/run/secrets/identity-token
LAYERX_GATEWAY_IDENTITY_PROVISIONING_TOKEN_FILE=/run/secrets/identity-provisioning-token
LAYERX_GATEWAY_PROGRAM_REGISTRY_TOKEN_FILE=/run/secrets/program-registry-token
LAYERX_GATEWAY_SEQUENCER_PUBLIC_KEY_FILE=/run/secrets/sequencer-public-key
LAYERX_GATEWAY_SEQUENCER_ID_FILE=/run/secrets/sequencer-id
LAYERX_GATEWAY_SEQUENCER_FIRST_BATCH_FILE=/run/secrets/sequencer-first-batch
LAYERX_GATEWAY_SEQUENCER_LAST_BATCH_FILE=/run/secrets/sequencer-last-batch
LAYERX_GATEWAY_KEY_PROVISIONING_KEY_FILE=/run/secrets/key-provisioning-key
LAYERX_GATEWAY_MODULE_REGISTRY_FILE=/run/secrets/module-registry.json

LAYERX_EVENTS_PAYMENT_UPSTREAM_URL=https://internal-payments.railway.internal:9443
LAYERX_EVENTS_PAYMENT_UPSTREAM_CA_DER=/run/secrets/ca.crt.der
LAYERX_EVENTS_PAYMENT_UPSTREAM_TOKEN_FILE=/run/secrets/events-payment-token
LAYERX_EVENTS_PAYMENT_UPSTREAM_CLIENT_IDENTITY_PKCS12=/run/secrets/events-client.p12
LAYERX_EVENTS_PAYMENT_UPSTREAM_CLIENT_IDENTITY_PASSWORD_FILE=/run/secrets/events-client-password
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_URL=https://webhooks-ingress.railway.internal
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_CA_DER=/run/secrets/ca.crt.der
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_TOKEN_FILE=/run/secrets/events-webhooks-token
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_CLIENT_IDENTITY_PKCS12=/run/secrets/events-client.p12
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_CLIENT_IDENTITY_PASSWORD_FILE=/run/secrets/events-client-password

# File secrets: base64 values, materialised by layerx-env-files from /etc/layerx/files.tsv.
ENDPOINT_ROUTE_BINDINGS=
ENDPOINT_OUTBOUND_CA=
ENDPOINT_REDIS_USERNAME=
ENDPOINT_REDIS_PASSWORD=
ENDPOINT_CLIENT_P12=
ENDPOINT_CLIENT_PASSWORD=
ENDPOINT_CLIENT_CERT=
ENDPOINT_COMPONENT_TOKEN=
ENDPOINT_AUTHORITY_TOKEN=
ENDPOINT_IDENTITY_TOKEN=
ENDPOINT_IDENTITY_PROVISIONING_TOKEN=
ENDPOINT_PROGRAM_REGISTRY_TOKEN=
ENDPOINT_SEQUENCER_PUBLIC_KEY=
ENDPOINT_SEQUENCER_ID=
ENDPOINT_SEQUENCER_FIRST_BATCH=
ENDPOINT_SEQUENCER_LAST_BATCH=
ENDPOINT_KEY_PROVISIONING_KEY=
ENDPOINT_MODULE_REGISTRY=
ENDPOINT_EVENTS_PAYMENT_TOKEN=
ENDPOINT_EVENTS_WEBHOOKS_TOKEN=
