# rollout-launchpad.kvx — rollout manifest read by tools/rollout/rollout.sh via ROLLOUT_MANIFEST.
#
# Same format as deploy/rollout.kvx. Every row is target "railway-image": the
# Railway service railway_service of project sidiora-launch is pointed at
# ghcr.io/sidiora-labs/<image>@<digest> from the --digests map and redeployed.
# health is an HTTP path on $PORT or tcp:<port>. order is the wave.
# Stock services (Postgres, Redis, minio, clamav, nats*) are not listed.

[meta]
name = "Launchpad rollout manifest"
kind = "rollout-manifest"
environment = "production"

[service.api]
target = "railway-image"
image = "kindlelaunch-core-api"
railway_service = "api"
health = "/health/ready"
order = 1

[service.indexer]
target = "railway-image"
image = "kindlelaunch-core-indexer"
railway_service = "indexer"
health = "/health/ready"
order = 1

[service.charts]
target = "railway-image"
image = "kindlelaunch-core-trading-charts"
railway_service = "charts"
health = "/health/ready"
order = 2

[service.ranking]
target = "railway-image"
image = "kindlelaunch-core-ranking-algo"
railway_service = "ranking"
health = "/health/ready"
order = 2

[service.stats]
target = "railway-image"
image = "kindlelaunch-core-stats-workers"
railway_service = "stats"
health = "/health/ready"
order = 2

[service.pnl]
target = "railway-image"
image = "kindlelaunch-core-pnl-tracker"
railway_service = "pnl"
health = "/health/ready"
order = 2

[service.user]
target = "railway-image"
image = "kindlelaunch-media-user"
railway_service = "user"
health = "/health/ready"
order = 2

[service.metadata]
target = "railway-image"
image = "kindlelaunch-media-metadata"
railway_service = "metadata"
health = "/health/ready"
order = 2

[service.social]
target = "railway-image"
image = "kindlelaunch-media-social"
railway_service = "social"
health = "/health/ready"
order = 2

[service.livestream]
target = "railway-image"
image = "kindlelaunch-media-livestream"
railway_service = "livestream"
health = "/health/ready"
order = 2

[service.gateway]
target = "railway-image"
image = "kindlelaunch-media-gateway"
railway_service = "gateway"
health = "/health/ready"
order = 3

[service.web]
target = "railway-image"
image = "kindlelaunch-web"
railway_service = "web"
health = "/"
order = 4
