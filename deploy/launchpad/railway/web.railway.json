{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/launchpad/Dockerfile.web",
    "watchPatterns": [
      "/launchpad/client/**",
      "/services/launchpad/security/control/cap-admission.ts",
      "/deploy/launchpad/Dockerfile.web"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
