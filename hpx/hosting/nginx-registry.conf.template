# The hpx registry vhost of hpx/hosting/nginx.conf for the container of
# docker/hpx-registry: the edge terminates TLS and forwards to this plain
# listener on PORT, the registry listens on HPX_ADDR, and the client address
# is the rightmost X-Forwarded-For hop outside LAYERX_TRUSTED_PROXIES. The
# entrypoint substitutes both placeholders at start.
limit_req_zone $binary_remote_addr zone=hpx_register:10m rate=10r/m;

upstream hpx_registry {
    server ${HPX_ADDR};
    keepalive 16;
}

server {
    listen [::]:${PORT} ipv6only=off default_server;
    server_name node.hyperpaxeer.com;

    include /etc/nginx/hpx-real-ip.conf;

    client_max_body_size 64k;

    location = / {
        root /var/www/hpx;
        try_files /index.html =404;
    }

    location = /paxeer-logo.png {
        root /var/www/hpx;
        try_files $uri =404;
        expires 30d;
    }

    location ~ ^/fonts/(?:LTWave-(?:Light|Regular|Medium|Bold)|LTWaveMono-(?:Regular|Medium))\.otf$ {
        root /var/www/hpx;
        try_files $uri =404;
        default_type font/otf;
        expires 30d;
    }

    location /fonts/ {
        return 404;
    }

    location = /api/register {
        limit_req zone=hpx_register burst=5 nodelay;
        proxy_pass http://hpx_registry;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://hpx_registry;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 10m;
        send_timeout 10m;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;

    access_log /dev/stdout;
    error_log /dev/stderr;
}
